            chatBlur: true,
            chatDim: 0.35,
            bubbleRadius: 18,
            fontSize: 16,
            chatDensity: 'comfortable',
            iconGradient: 'from-pink-500 to-purple-700'
          },
          {
            id: 'sunset-horizon',
            name: 'Sunset Horizon',
            description: 'Warm evening dusk gradient with playful doodles',
            baseMode: 'dark',
            accent: '#f43f5e',
            accentRgb: '244, 63, 94',
            nameColor: '#f43f5e',
            userBubbleBg: 'linear-gradient(135deg, #be123c 0%, #e11d48 100%)',
            charBubbleBg: '#1a0b12',
            chatWallpaper: 'linear-gradient(180deg, #2b0c1b 0%, #150811 50%, #090307 100%)',
            chatPatternId: 'telegram-doodles',
            chatPatternOpacity: 0.16,
            chatBlur: false,
            chatDim: 0.20,
            bubbleRadius: 16,
            fontSize: 16,
            chatDensity: 'comfortable',
            iconGradient: 'from-rose-500 to-amber-600'
          },
          {
            id: 'glacier-arctic',
            name: 'Glacier Arctic',
            description: 'Oceanic blue with crisp hexagonal mesh',
            baseMode: 'dark',
            accent: '#0284c7',
            accentRgb: '2, 132, 199',
            nameColor: '#06b6d4',
            userBubbleBg: 'linear-gradient(135deg, #0284c7 0%, #06b6d4 100%)',
            charBubbleBg: '#081320',
            chatWallpaper: 'linear-gradient(180deg, #040e1d 0%, #081d38 50%, #02070e 100%)',
            chatPatternId: 'hex-mesh',
            chatPatternOpacity: 0.20,
            chatBlur: false,
            chatDim: 0.15,
            bubbleRadius: 14,
            fontSize: 16,
            chatDensity: 'comfortable',
            iconGradient: 'from-sky-500 to-cyan-600'
          },
          {
            id: 'crimson-dynasty',
            name: 'Crimson Dynasty',
            description: 'Deep royal crimson with velvet textures',
            baseMode: 'dark',
            accent: '#e11d48',
            accentRgb: '225, 29, 72',
            nameColor: '#f43f5e',
            userBubbleBg: 'linear-gradient(135deg, #881337 0%, #be123c 100%)',
            charBubbleBg: '#1c0a10',
            chatWallpaper: 'linear-gradient(180deg, #240710 0%, #130408 50%, #070103 100%)',
            chatPatternId: 'telegram-doodles',
            chatPatternOpacity: 0.15,
            chatBlur: false,
            chatDim: 0.25,
            bubbleRadius: 16,
            fontSize: 16,
            chatDensity: 'comfortable',
            iconGradient: 'from-red-600 to-rose-900'
          },
          {
            id: 'telegram-day',
            name: 'Telegram Day',
            description: 'Clean crisp light mode for daylight reading',
            baseMode: 'day',
            accent: '#0284c7',
            accentRgb: '2, 132, 199',
            nameColor: '#0284c7',
            userBubbleBg: 'linear-gradient(135deg, #0284c7 0%, #38bdf8 100%)',
            charBubbleBg: '#ffffff',
            chatWallpaper: 'linear-gradient(to bottom, #e2e8f0, #cbd5e1, #94a3b8)',
            chatPatternId: 'telegram-doodles',
            chatPatternOpacity: 0.15,
            chatBlur: false,
            chatDim: 0.05,
            bubbleRadius: 16,
            fontSize: 16,
            chatDensity: 'comfortable',
            iconGradient: 'from-sky-400 to-blue-600'
          }
        ];

        const DEFAULT_THEME = {
          baseMode: 'dark',
          accent: '#9333ea',
          accentRgb: '147, 51, 234',
          nameColor: '#a855f7',
          userBubbleBg: 'linear-gradient(135deg, #9333ea 0%, #6366f1 100%)',
          charBubbleBg: '#101426',
          chatWallpaper: 'linear-gradient(to bottom, #090a12, #0e1122, #07080f)',
          chatPatternId: 'telegram-doodles',
          chatPatternOpacity: 0.18,
          chatBlur: false,
          chatDim: 0.20,
          bubbleRadius: 16,
          fontSize: 16,
          chatDensity: 'comfortable',
          soundEnabled: true
        };

        function hexToRgb(hex) {
          let clean = hex.replace('#', '').trim();
          if (clean.length === 3) {
            clean = clean.split('').map(c => c + c).join('');
          }
          const num = parseInt(clean, 16);
          if (isNaN(num) || clean.length !== 6) return '147, 51, 234';
          const r = (num >> 16) & 255;
          const g = (num >> 8) & 255;
          const b = num & 255;
          return `${r}, ${g}, ${b}`;
        }

        // ==========================================
        // TELEGRAM WEB AUDIO SYNTHESIZER
        // ==========================================
        let audioCtx = null;
        function getAudioContext() {
          if (typeof window === 'undefined') return null;
          if (!audioCtx) {
            const AudioContextClass = window.AudioContext || window.webkitAudioContext;
            if (AudioContextClass) {
              audioCtx = new AudioContextClass();
            }
          }
          if (audioCtx && audioCtx.state === 'suspended') {
            audioCtx.resume().catch(() => {});
          }
          return audioCtx;
        }

        function isSoundEnabled() {
          if (typeof localStorage === 'undefined') return true;
          return localStorage.getItem('aetheria_chat_sound') !== 'false';
        }

        function setSoundEnabled(enabled) {
          if (typeof localStorage === 'undefined') return;
          localStorage.setItem('aetheria_chat_sound', enabled ? 'true' : 'false');
          window.dispatchEvent(new CustomEvent('aetheria-sound-changed', { detail: { enabled } }));
        }

        function playSendSound() {
          if (!isSoundEnabled()) return;
          try {
            const ctx = getAudioContext();
            if (!ctx) return;
            const now = ctx.currentTime;
            
            // Telegram outgoing pop: quick upward chirp with snappy exponential decay
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();

            osc.type = 'sine';
            osc.frequency.setValueAtTime(580, now);
            osc.frequency.exponentialRampToValueAtTime(880, now + 0.045);

            gain.gain.setValueAtTime(0.24, now);
            gain.gain.exponentialRampToValueAtTime(0.001, now + 0.08);

            osc.connect(gain);
            gain.connect(ctx.destination);

            osc.start(now);
            osc.stop(now + 0.085);
          } catch(e) {
            // Ignore audio context autoplay policy blocks
          }
        }

        function playReceiveSound() {
          if (!isSoundEnabled()) return;
          try {
            const ctx = getAudioContext();
            if (!ctx) return;
            const now = ctx.currentTime;

            // Telegram incoming notification: pleasant dual chime
            const osc1 = ctx.createOscillator();
            const gain1 = ctx.createGain();
            osc1.type = 'sine';
            osc1.frequency.setValueAtTime(523.25, now); // C5

            gain1.gain.setValueAtTime(0.18, now);
            gain1.gain.exponentialRampToValueAtTime(0.001, now + 0.12);

            osc1.connect(gain1);
            gain1.connect(ctx.destination);
            osc1.start(now);
            osc1.stop(now + 0.125);

            // Second tone slightly delayed
            const osc2 = ctx.createOscillator();
            const gain2 = ctx.createGain();
            osc2.type = 'sine';
            osc2.frequency.setValueAtTime(783.99, now + 0.045); // G5

            gain2.gain.setValueAtTime(0.001, now);
            gain2.gain.setValueAtTime(0.22, now + 0.045);
            gain2.gain.exponentialRampToValueAtTime(0.001, now + 0.15);

            osc2.connect(gain2);
            gain2.connect(ctx.destination);
            osc2.start(now + 0.045);
            osc2.stop(now + 0.155);
          } catch(e) {
            // Ignore audio policy
          }
        }

        // ==========================================
        // CUSTOM USER THEMES STORE (STEP 4)
        // ==========================================
        function getCustomThemes() {
          try {
            const stored = localStorage.getItem('aetheria_custom_saved_themes');
            if (stored) return JSON.parse(stored);
          } catch(e) {}
          return [];
        }

        function saveCustomTheme(name, themeData) {
          try {
            const list = getCustomThemes();
            const id = 'custom-' + Date.now();
            const newTheme = {
              id,
              name: name || 'My Custom Theme',
              description: 'Created by you',
              isCustom: true,
              ...themeData
            };
            list.unshift(newTheme);
            localStorage.setItem('aetheria_custom_saved_themes', JSON.stringify(list));
            window.dispatchEvent(new CustomEvent('aetheria-custom-themes-updated', { detail: list }));
            return newTheme;
          } catch(e) {
            console.error(e);
            return null;
          }
        }

        function deleteCustomTheme(id) {
          try {
            let list = getCustomThemes();
            list = list.filter(t => t.id !== id);
            localStorage.setItem('aetheria_custom_saved_themes', JSON.stringify(list));
            window.dispatchEvent(new CustomEvent('aetheria-custom-themes-updated', { detail: list }));
            return true;
          } catch(e) {
            return false;
          }
        }

        function getActiveCharId() {
          if (typeof window === 'undefined') return null;
          const path = window.location.pathname;
          const match = path.match(/\/chat\/([^\/]+)/);
          return match ? match[1] : null;
        }

        function getSettings(charId = null) {
          if (typeof localStorage === 'undefined') return { ...DEFAULT_THEME };
          const targetChar = charId || getActiveCharId();
          if (targetChar) {
            const charKey = `aetheria_theme_char_${targetChar}`;
            const charSaved = localStorage.getItem(charKey);
            if (charSaved) {
              try {
                return { ...DEFAULT_THEME, ...JSON.parse(charSaved), isCharOverride: true, charId: targetChar };
              } catch (e) {}
            }
          }
          const globalSaved = localStorage.getItem('aetheria_theme_global');
          if (globalSaved) {
            try {
              return { ...DEFAULT_THEME, ...JSON.parse(globalSaved), isCharOverride: false };
            } catch (e) {}
          }
          return { ...DEFAULT_THEME, isCharOverride: false };
        }

        function saveSettings(settings, charId = null) {
          if (typeof localStorage === 'undefined') return;
          const targetChar = charId !== undefined ? charId : getActiveCharId();
          if (targetChar) {
            localStorage.setItem(`aetheria_theme_char_${targetChar}`, JSON.stringify(settings));
          } else {
            localStorage.setItem('aetheria_theme_global', JSON.stringify(settings));
          }
          applyThemeToDOM(settings);
          window.dispatchEvent(new CustomEvent('aetheria-theme-changed', { detail: settings }));
        }

        function hasCharSettings(charId) {
          if (!charId || typeof localStorage === 'undefined') return false;
          return !!localStorage.getItem(`aetheria_theme_char_${charId}`);
        }

        function removeCharSettings(charId) {
          if (!charId || typeof localStorage === 'undefined') return;
          localStorage.removeItem(`aetheria_theme_char_${charId}`);
          const fallback = getSettings(null);
          applyThemeToDOM(fallback);
          window.dispatchEvent(new CustomEvent('aetheria-theme-changed', { detail: fallback }));
        }

        function applyThemeToDOM(theme) {
          if (!theme) return;
          const root = document.documentElement;
          
          // Base Mode (Dark, AMOLED, Day)
          const baseMode = theme.baseMode || 'dark';
          root.setAttribute('data-theme-base', baseMode);
          if (baseMode === 'amoled') {
            root.style.setProperty('--theme-base-bg', '#000000');
            root.style.setProperty('--theme-bubble-char-bg', '#09090b');
            root.style.setProperty('--theme-bubble-char-border', 'rgba(255, 255, 255, 0.08)');
            root.style.setProperty('--theme-bubble-char-text', '#f1f5f9');
          } else if (baseMode === 'day') {
            root.style.setProperty('--theme-base-bg', '#f8fafc');
            root.style.setProperty('--theme-bubble-char-bg', '#ffffff');
            root.style.setProperty('--theme-bubble-char-border', '#e2e8f0');
            root.style.setProperty('--theme-bubble-char-text', '#0f172a');
          } else {
            root.style.setProperty('--theme-base-bg', '#090a12');
            root.style.setProperty('--theme-bubble-char-bg', theme.charBubbleBg || '#101426');
            root.style.setProperty('--theme-bubble-char-border', 'rgba(255, 255, 255, 0.08)');
            root.style.setProperty('--theme-bubble-char-text', '#f1f5f9');
          }

          // Accent colors
          const accent = theme.accent || '#9333ea';
          const rgb = theme.accentRgb || hexToRgb(accent);
          root.style.setProperty('--theme-accent', accent);
          root.style.setProperty('--theme-accent-rgb', rgb);
          root.style.setProperty('--theme-accent-hover', accent);
          root.style.setProperty('--theme-accent-subtle', 'rgba(' + rgb + ', 0.15)');
          root.style.setProperty('--theme-accent-border', 'rgba(' + rgb + ', 0.35)');
          root.style.setProperty('--theme-accent-glow', 'rgba(' + rgb + ', 0.45)');

          // Update Tailwind v4 CSS variables at root
          root.style.setProperty('--color-purple-50', 'rgba(' + rgb + ', 0.05)');
          root.style.setProperty('--color-purple-100', 'rgba(' + rgb + ', 0.1)');
          root.style.setProperty('--color-purple-200', 'rgba(' + rgb + ', 0.25)');
          root.style.setProperty('--color-purple-300', 'rgba(' + rgb + ', 0.5)');
          root.style.setProperty('--color-purple-400', accent);
          root.style.setProperty('--color-purple-500', accent);
          root.style.setProperty('--color-purple-600', accent);
          root.style.setProperty('--color-purple-700', accent);
          root.style.setProperty('--color-purple-800', 'rgba(' + rgb + ', 0.8)');
          root.style.setProperty('--color-purple-900', 'rgba(' + rgb + ', 0.9)');
          root.style.setProperty('--color-purple-950', 'rgba(' + rgb + ', 0.95)');
          root.style.setProperty('--accent-purple', accent);

          // Telegram Name Color
          const nameColor = theme.nameColor || accent;
          root.style.setProperty('--theme-name-color', nameColor);
          root.style.setProperty('--theme-char-name-color', nameColor);

          // Geometry
          const radius = theme.bubbleRadius !== undefined ? theme.bubbleRadius : 16;
          root.style.setProperty('--theme-bubble-radius', radius + 'px');

          const fontSize = theme.fontSize || 16;
          root.style.setProperty('--theme-msg-font-size', fontSize + 'px');
          root.style.setProperty('--theme-msg-line-height', String(theme.lineHeight || 1.6));

          // User Bubble Background
          if (theme.userBubbleBg) {
            root.style.setProperty('--theme-bubble-user-bg', theme.userBubbleBg);
          }

          // Live dynamic CSS block with clean, 100% standard CSS rules
          if (typeof document !== 'undefined') {
            try {
              let styleTag = document.getElementById('aetheria-live-theme-injector');
              if (!styleTag) {
                styleTag = document.createElement('style');
                styleTag.id = 'aetheria-live-theme-injector';
                document.head.appendChild(styleTag);
              }

              const cssRules = [
                ':root {',
                '  --theme-accent: ' + accent + ' !important;',
                '  --theme-accent-rgb: ' + rgb + ' !important;',
                '  --color-purple-400: ' + accent + ' !important;',
                '  --color-purple-500: ' + accent + ' !important;',
                '  --color-purple-600: ' + accent + ' !important;',
                '  --accent-purple: ' + accent + ' !important;',
                '}',
                '.tg-accent-text, [class*="text-purple-"], [class*="text-[#8E9DFE]"], [class*="text-[#7385FF]"] {',
                '  color: ' + accent + ' !important;',
                '}',
                '.tg-accent-bg, [class*="bg-purple-600"], [class*="bg-purple-500"], [class*="bg-[#7385FF]"] {',
                '  background-color: ' + accent + ' !important;',
                '}',
                '[class*="bg-purple-600/"], [class*="bg-purple-500/"], [class*="bg-purple-950/"], [class*="bg-[#29233B]"], .tg-accent-subtle-bg {',
                '  background-color: rgba(' + rgb + ', 0.18) !important;',
                '}',
                '.tg-accent-border, [class*="border-purple-"], [class*="border-[#6B7CFF]"] {',
                '  border-color: ' + accent + ' !important;',
                '}',
                '[class*="border-purple-400/"], [class*="border-purple-500/"], .tg-accent-subtle-border {',
                '  border-color: rgba(' + rgb + ', 0.35) !important;',
                '}',
                '[class*="ring-purple-"] {',
                '  --tw-ring-color: ' + accent + ' !important;',
                '}',
                '[class*="from-purple-"] {',
                '  --tw-gradient-from: ' + accent + ' var(--tw-gradient-from-position, ) !important;',
                '  --tw-gradient-to: rgba(' + rgb + ', 0) var(--tw-gradient-to-position, ) !important;',
                '  --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to) !important;',
                '}',
                '[class*="to-purple-"] {',
                '  --tw-gradient-to: ' + accent + ' var(--tw-gradient-to-position, ) !important;',
                '}',
                '.tg-slider::-webkit-slider-thumb {',
                '  background: ' + accent + ' !important;',
                '  box-shadow: 0 2px 10px rgba(' + rgb + ', 0.5) !important;',
                '}',
                '.tg-slider::-moz-range-thumb {',
                '  background: ' + accent + ' !important;',
                '  box-shadow: 0 2px 10px rgba(' + rgb + ', 0.5) !important;',
                '}',
                '.tg-theme-mockup-card[data-active="true"] {',
                '  border-color: ' + accent + ' !important;',
                '  box-shadow: 0 0 16px rgba(' + rgb + ', 0.45) !important;',
                '}',
                '#tg-name-color-pill, .tg-name-pill {',
                '  color: ' + nameColor + ' !important;',
                '  background-color: rgba(' + rgb + ', 0.18) !important;',
                '  border-color: rgba(' + rgb + ', 0.35) !important;',
                '}',
                '#tg-preview-char-name, [data-telegram-name-color] {',
                '  color: ' + nameColor + ' !important;',
                '}',
                '.tg-quote-line, #tg-preview-reply-box {',
                '  border-left-color: ' + nameColor + ' !important;',
                '}',
                (baseMode === 'day' ? [
                  'body { background-color: #f8fafc !important; color: #0f172a !important; }',
                  'header, nav[class*="fixed bottom-0"], .nav-mobile-bottom { background-color: rgba(255, 255, 255, 0.94) !important; border-color: #e2e8f0 !important; }',
                  '.glass-panel, [class*="bg-[#1D212C]"] { background-color: #ffffff !important; border-color: #e2e8f0 !important; color: #0f172a !important; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05) !important; }',
                  '.text-slate-200, .text-slate-300, .text-white { color: #0f172a !important; }',
                  '[class*="text-[#8A96B2]"], .text-slate-400 { color: #64748b !important; }',
                  '[class*="divide-[#2A3040]"] > * + * { border-color: #e2e8f0 !important; }'
                ].join('\n') : baseMode === 'amoled' ? [
                  'body { background-color: #000000 !important; }',
                  'header, nav[class*="fixed bottom-0"], .nav-mobile-bottom { background-color: #000000 !important; border-color: #1a1a1e !important; }',
                  '.glass-panel, [class*="bg-[#1D212C]"] { background-color: #050507 !important; border-color: #1a1a1e !important; }'
                ].join('\n') : 'body { background-color: #07080d !important; }')
              ].join('\n');

              styleTag.textContent = cssRules;

              // Update sliders track fill
              document.querySelectorAll('.tg-slider').forEach(function(slider) {
                const min = parseFloat(slider.min) || 0;
                const max = parseFloat(slider.max) || 100;
                const val = parseFloat(slider.value) || 0;
                const pct = ((val - min) / (max - min)) * 100;
                slider.style.background = 'linear-gradient(to right, ' + accent + ' 0%, ' + accent + ' ' + pct + '%, #343A4A ' + pct + '%, #343A4A 100%)';
              });

              // Update active theme card
              const curPreset = theme.presetId || '';
              document.querySelectorAll('.tg-theme-mockup-card').forEach(function(c) {
                const tid = c.getAttribute('data-theme-id');
                const isMatch = (tid === curPreset) || (curPreset === 'aetheria-purple' && tid === 'arcade-retro') || (curPreset === 'glacier-arctic' && tid === 'cyan-palette');
                if (isMatch) {
                  c.setAttribute('data-active', 'true');
                  c.classList.add('active');
                  c.style.borderColor = accent;
                  c.style.boxShadow = '0 0 16px rgba(' + rgb + ', 0.45)';
                } else {
                  c.removeAttribute('data-active');
                  c.classList.remove('active');
                  c.style.borderColor = 'transparent';
                  c.style.boxShadow = 'none';
                }
              });

              // Update preview bubbles
              document.querySelectorAll('#tg-preview-outgoing-bubble, #chat-preview-outgoing-bubble').forEach(function(b) {
                if (theme.userBubbleBg) b.style.background = theme.userBubbleBg;
              });
            } catch(e) {}
          }

          // Blur & Dim
          const blurVal = theme.chatBlur ? '14px' : '0px';
          root.style.setProperty('--theme-chat-blur', blurVal);

          const dimVal = theme.chatDim !== undefined ? theme.chatDim : 0.20;
          root.style.setProperty('--theme-chat-dim', String(dimVal));
        }

        function exportTheme() {
          const settings = getSettings();
          return JSON.stringify(settings, null, 2);
        }

        function importTheme(jsonString, charId = null) {
          try {
            const parsed = JSON.parse(jsonString);
            saveSettings(parsed, charId);
            return true;
          } catch (e) {
            console.error('Invalid theme JSON', e);
            return false;
          }
        }

        function resetToDefault(charId = null) {
          if (charId) {
            removeCharSettings(charId);
          } else {
            if (typeof localStorage !== 'undefined') {
              localStorage.removeItem('aetheria_theme_global');
            }
            applyThemeToDOM(DEFAULT_THEME);
            window.dispatchEvent(new CustomEvent('aetheria-theme-changed', { detail: DEFAULT_THEME }));
          }
        }

        // Run immediately on page load to prevent FOUC
        try {
          const initial = getSettings();
          applyThemeToDOM(initial);
        } catch(e) {}

        window.AetheriaTheme = {
          DEFAULT_THEME,
          PRESETS: THEME_PRESETS,
          BUBBLE_GRADIENTS: BUBBLE_GRADIENTS,
          NAME_COLORS: NAME_COLORS,
          BASE_MODES: BASE_MODES,
          WALLPAPERS: WALLPAPERS,
          DOODLE_PATTERNS: DOODLE_PATTERNS,
          hexToRgb,
          getActiveCharId,
          getSettings,
          saveSettings,
          hasCharSettings,
          removeCharSettings,
          getCustomThemes,
          saveCustomTheme,
          deleteCustomTheme,
          exportTheme,
          importTheme,
          resetToDefault,
          apply: applyThemeToDOM,
          isSoundEnabled,
          setSoundEnabled,
          playSendSound,
          playReceiveSound
        };
      })();
    </script>
</head>
  <body class={`bg-[#07080d] text-slate-100 selection:bg-purple-500/30 selection:text-purple-200 antialiased overflow-x-hidden w-full max-w-[100vw] ${noScroll ? 'h-[100dvh] max-h-[100dvh] overflow-hidden' : 'min-h-screen'}`}>
    <div class={`relative w-full ${noScroll ? 'h-[100dvh] max-h-[100dvh] overflow-hidden flex flex-col' : 'min-h-screen flex flex-col justify-between'}`}>
      <!-- Ambient background neon lighting -->
      <div class="fixed top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-[450px] bg-gradient-to-b from-purple-900/10 via-indigo-950/5 to-transparent blur-[120px] pointer-events-none -z-10"></div>
      
      <slot />
    </div>
  </body>
</html>
