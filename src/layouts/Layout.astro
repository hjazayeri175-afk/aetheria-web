        function hexToRgb(hex) {
          if (!hex) return '147, 51, 234';
          let c = hex.replace('#', '').trim();
          if (c.length === 3) c = c.split('').map(x => x + x).join('');
          if (c.length !== 6) return '147, 51, 234';
          const r = parseInt(c.slice(0, 2), 16);
          const g = parseInt(c.slice(2, 4), 16);
          const b = parseInt(c.slice(4, 6), 16);
          return isNaN(r) || isNaN(g) || isNaN(b) ? '147, 51, 234' : `${r}, ${g}, ${b}`;
        }

        function getActiveCharId() {
          try {
            const m = window.location.pathname.match(/\/chat\/([^\/\?#]+)/);
            return m && m[1] ? m[1] : null;
          } catch(e) {
            return null;
          }
        }

        function getSettings(charId = null) {
          try {
            const targetChar = charId || getActiveCharId();
            if (targetChar) {
              const charKey = 'aetheria_theme_char_' + targetChar;
              const charSaved = localStorage.getItem(charKey);
              if (charSaved) {
                const parsed = JSON.parse(charSaved);
                return { ...DEFAULT_THEME, ...parsed, _isCharSpecific: true, _charId: targetChar };
              }
            }
            const saved = localStorage.getItem('aetheria_theme_settings');
            if (saved) {
              const parsed = JSON.parse(saved);
              return { ...DEFAULT_THEME, ...parsed, _isCharSpecific: false };
            }
          } catch (e) {
            console.warn('AetheriaTheme: failed to load settings', e);
          }
          return { ...DEFAULT_THEME, _isCharSpecific: false };
        }

        function hasCharSettings(charId) {
          if (!charId) return false;
          try {
            return !!localStorage.getItem('aetheria_theme_char_' + charId);
          } catch(e) {
            return false;
          }
        }

        function removeCharSettings(charId) {
          if (!charId) return;
          try {
            localStorage.removeItem('aetheria_theme_char_' + charId);
            const globalSettings = getSettings(null);
            applyThemeToDOM(globalSettings);
            window.dispatchEvent(new CustomEvent('aetheria-theme-change', { detail: globalSettings }));
          } catch(e) {
            console.error(e);
          }
        }

        function saveSettings(partial, charId = null) {
          try {
            const targetChar = charId !== undefined ? charId : getActiveCharId();
            const current = getSettings(targetChar);
            const merged = { ...current, ...partial };

            if (targetChar) {
              const cleanData = { ...merged };
              delete cleanData._isCharSpecific;
              delete cleanData._charId;
              localStorage.setItem('aetheria_theme_char_' + targetChar, JSON.stringify(cleanData));
              merged._isCharSpecific = true;
              merged._charId = targetChar;
            } else {
              const cleanData = { ...merged };
              delete cleanData._isCharSpecific;
              delete cleanData._charId;
              localStorage.setItem('aetheria_theme_settings', JSON.stringify(cleanData));
              merged._isCharSpecific = false;
            }

            applyThemeToDOM(merged);
            window.dispatchEvent(new CustomEvent('aetheria-theme-change', { detail: merged }));
            return merged;
          } catch (e) {
            console.error('AetheriaTheme: failed to save', e);
            return null;
          }
        }

        function exportTheme(charId = null) {
          try {
            const theme = getSettings(charId);
            const payload = {
              version: 3,
              name: theme.name || 'Aetheria Custom Theme',
              date: new Date().toISOString(),
              settings: {
                themeId: theme.themeId,
                accent: theme.accent,
                accentRgb: theme.accentRgb,
                bubbleRadius: theme.bubbleRadius,
                fontSize: theme.fontSize,
                chatDensity: theme.chatDensity,
                userBubbleBg: theme.userBubbleBg,
                charBubbleBg: theme.charBubbleBg,
                chatWallpaper: theme.chatWallpaper,
                chatWallpaperId: theme.chatWallpaperId,
                chatPatternId: theme.chatPatternId,
                chatPatternOpacity: theme.chatPatternOpacity,
                chatBlur: theme.chatBlur,
                chatDim: theme.chatDim
              }
            };
            return btoa(unescape(encodeURIComponent(JSON.stringify(payload))));
          } catch(e) {
            console.error('Export theme failed', e);
            return null;
          }
        }

        function importTheme(codeStr, charId = null) {
          try {
            let jsonStr = '';
            try {
              jsonStr = decodeURIComponent(escape(atob(codeStr.trim())));
            } catch(e) {
              jsonStr = codeStr.trim();
            }
            const data = JSON.parse(jsonStr);
            const imported = data.settings || data;
            if (!imported || (!imported.accent && !imported.userBubbleBg && !imported.chatWallpaper)) {
              throw new Error('Invalid theme format');
            }
            return saveSettings(imported, charId);
          } catch(e) {
            console.error('Import theme failed', e);
            return null;
          }
        }

        function resetToDefault(charId = null) {
          try {
            if (charId) {
              localStorage.removeItem('aetheria_theme_char_' + charId);
            } else {
              localStorage.removeItem('aetheria_theme_settings');
            }
            const def = { ...DEFAULT_THEME };
            applyThemeToDOM(def);
            window.dispatchEvent(new CustomEvent('aetheria-theme-change', { detail: def }));
            return def;
          } catch(e) {
            console.error(e);
            return null;
          }
        }

        function applyThemeToDOM(theme) {
          if (!theme) return;
          const root = document.documentElement;
          const accent = theme.accent || '#9333ea';
          const rgb = theme.accentRgb || hexToRgb(accent);

          root.style.setProperty('--theme-accent', accent);
          root.style.setProperty('--theme-accent-rgb', rgb);
          root.style.setProperty('--theme-accent-hover', accent);
          root.style.setProperty('--theme-accent-glow', `rgba(${rgb}, 0.35)`);
          root.style.setProperty('--theme-accent-border', `rgba(${rgb}, 0.4)`);
          root.style.setProperty('--theme-accent-subtle', `rgba(${rgb}, 0.15)`);
          root.style.setProperty('--theme-purple-400', accent);
          root.style.setProperty('--theme-purple-500', accent);
          root.style.setProperty('--theme-purple-600', accent);
          root.style.setProperty('--theme-purple-700', accent);

          const radius = theme.bubbleRadius !== undefined ? theme.bubbleRadius : 16;
          root.style.setProperty('--theme-bubble-radius', `${radius}px`);

          const fontSize = theme.fontSize !== undefined ? theme.fontSize : 16;
          root.style.setProperty('--theme-msg-font-size', `${fontSize}px`);

          if (theme.userBubbleBg) {
            root.style.setProperty('--theme-bubble-user-bg', theme.userBubbleBg);
          }
          if (theme.charBubbleBg) {
            root.style.setProperty('--theme-bubble-char-bg', theme.charBubbleBg);
          }

          // Density
          if (theme.chatDensity === 'compact') {
            root.setAttribute('data-chat-density', 'compact');
          } else {
            root.removeAttribute('data-chat-density');
          }

          // Chat Stream Wallpaper & Background
          const wpVal = theme.chatWallpaper || theme.chatBg || 'linear-gradient(to bottom, #090a12, #0e1122, #07080f)';
          root.style.setProperty('--theme-chat-bg', wpVal);
          root.style.setProperty('--theme-chat-wallpaper', wpVal.startsWith('http') || wpVal.startsWith('data:') ? `url("${wpVal}")` : wpVal);

          // Blur & Dimmer
          const blurVal = theme.chatBlur ? 'blur(12px)' : 'none';
          root.style.setProperty('--theme-chat-blur', blurVal);

          const dimVal = theme.chatDim !== undefined ? theme.chatDim : 0.20;
          root.style.setProperty('--theme-chat-dim', dimVal.toString());

          // Doodle Pattern
          const patId = theme.chatPatternId || (theme.id ? ('pattern-' + theme.id.replace('-mode', '').replace('-corner', '').replace('-luxury', '')) : 'pattern-gamer');
          const patObj = DOODLE_PATTERNS[patId] || DOODLE_PATTERNS['pattern-gamer'] || DOODLE_PATTERNS['none'];
          const patOpacity = theme.chatPatternOpacity !== undefined ? theme.chatPatternOpacity : 0.16;

          root.style.setProperty('--theme-chat-pattern', patObj.pattern);
          root.style.setProperty('--theme-chat-pattern-size', patObj.patternSize);
          root.style.setProperty('--theme-chat-pattern-opacity', patOpacity.toString());

          const overlayLayer = document.getElementById('chat-wallpaper-overlay');
          if (overlayLayer) {
            overlayLayer.style.backgroundImage = patObj.pattern || 'none';
            overlayLayer.style.backgroundSize = patObj.patternSize || 'auto';
            overlayLayer.style.opacity = patOpacity.toString();
          }

          // Direct DOM live updates for active chat container
          const imgLayer = document.getElementById('chat-wallpaper-image-layer');
          if (imgLayer) {
            if (wpVal.startsWith('http') || wpVal.startsWith('data:')) {
              imgLayer.style.backgroundImage = `url("${wpVal}")`;
              imgLayer.style.backgroundSize = 'cover';
              imgLayer.style.backgroundPosition = 'center';
            } else {
              imgLayer.style.background = wpVal;
              imgLayer.style.backgroundSize = '';
              imgLayer.style.backgroundPosition = '';
            }
            imgLayer.style.filter = blurVal;
          }

          const dimLayer = document.getElementById('chat-wallpaper-dimmer');
          if (dimLayer) {
            dimLayer.style.opacity = dimVal.toString();
          }

          const overlay = document.getElementById('chat-wallpaper-overlay');
          if (overlay) {
            overlay.style.backgroundImage = patObj.pattern;
            overlay.style.backgroundSize = patObj.patternSize;
            overlay.style.opacity = patOpacity.toString();
          }

          const chatMessages = document.getElementById('chat-messages-container');
          if (chatMessages) {
            chatMessages.style.setProperty('--theme-bubble-radius', `${radius}px`);
            chatMessages.style.setProperty('--theme-msg-font-size', `${fontSize}px`);
            if (theme.userBubbleBg) chatMessages.style.setProperty('--theme-bubble-user-bg', theme.userBubbleBg);
            if (theme.charBubbleBg) chatMessages.style.setProperty('--theme-bubble-char-bg', theme.charBubbleBg);
          }
        }

        // Apply immediately on first paint
        const initialTheme = getSettings();
        applyThemeToDOM(initialTheme);
        try {
          if (localStorage.getItem('aetheria_reduce_motion') === 'true') {
            document.documentElement.classList.add('reduce-motion');
          }
        } catch(e) {}

        // Cross-tab sync
        window.addEventListener('storage', function(e) {
          if (e.key === 'aetheria_theme_settings' || (e.key && e.key.startsWith('aetheria_theme_char_'))) {
            applyThemeToDOM(getSettings());
          }
        });

        window.AetheriaTheme = {
          DEFAULT_THEME,
          PRESETS: THEME_PRESETS,
          BUBBLE_GRADIENTS: BUBBLE_GRADIENTS,
          WALLPAPERS: WALLPAPERS,
          DOODLE_PATTERNS: DOODLE_PATTERNS,
          hexToRgb,
          getActiveCharId,
          getSettings,
          saveSettings,
          hasCharSettings,
          removeCharSettings,
          exportTheme,
          importTheme,
          resetToDefault,
          apply: applyThemeToDOM
        };
      })();

      // Native IndexedDB Engine: Unlimited Local Storage & Lossless High-Fidelity Images
      (function() {
        const DB_NAME = 'aetheria_vault';
        const DB_VERSION = 1;
        let dbInstance = null;

        function openDB() {
          if (dbInstance) return Promise.resolve(dbInstance);
          return new Promise((resolve) => {
            if (typeof indexedDB === 'undefined') return resolve(null);
            try {
              const req = indexedDB.open(DB_NAME, DB_VERSION);
              req.onupgradeneeded = () => {
                const db = req.result;
                if (!db.objectStoreNames.contains('characters')) {
                  db.createObjectStore('characters', { keyPath: 'id' });
                }
              };
              req.onsuccess = () => {
                dbInstance = req.result;
                resolve(dbInstance);
              };
              req.onerror = () => resolve(null);
            } catch (err) {
              resolve(null);
            }
          });
        }

        async function saveCharacter(character) {
          if (!character || !character.id) return false;
          const db = await openDB();
          if (db) {
            try {
              await new Promise((resolve, reject) => {
                const tx = db.transaction('characters', 'readwrite');
                tx.objectStore('characters').put(character);
                tx.oncomplete = () => resolve(true);
                tx.onerror = () => reject(tx.error);
              });
            } catch (e) {
              console.warn('IDB put error:', e);
            }
          }
          // Mirror in localStorage safely
          try {
            const raw = localStorage.getItem('aetheria_custom_characters');
            let list = raw ? JSON.parse(raw) : [];
            if (!Array.isArray(list)) list = [];
            const idx = list.findIndex(c => c && c.id === character.id);
            if (idx !== -1) list[idx] = character;
            else list.push(character);
            localStorage.setItem('aetheria_custom_characters', JSON.stringify(list));
          } catch (lsErr) {
            try {
              const raw = localStorage.getItem('aetheria_custom_characters');
              let list = raw ? JSON.parse(raw) : [];
              const safeChar = { ...character };
              if (safeChar.avatarUrl && safeChar.avatarUrl.length > 50000) {
                safeChar.avatarUrl = '/avatars/asian_woman.webp';
              }
              const idx = list.findIndex(c => c && c.id === safeChar.id);
              if (idx !== -1) list[idx] = safeChar;
              else list.push(safeChar);
              localStorage.setItem('aetheria_custom_characters', JSON.stringify(list));
            } catch (e2) {}
          }
          return true;
        }

        async function getCharacter(id) {
          if (!id) return null;
          const db = await openDB();
          if (db) {
            try {
              const char = await new Promise((resolve) => {
                const tx = db.transaction('characters', 'readonly');
                const req = tx.objectStore('characters').get(id);
                req.onsuccess = () => resolve(req.result || null);
                req.onerror = () => resolve(null);
              });
              if (char) return char;
            } catch (e) {}
          }
          try {
            const raw = localStorage.getItem('aetheria_custom_characters');
            const list = raw ? JSON.parse(raw) : [];
            const normId = id.toLowerCase().trim();
            return list.find(c => c && (c.id === id || c.id?.toLowerCase() === normId || (c.name && c.name.toLowerCase() === normId))) || null;
          } catch (e) {
            return null;
          }
        }

        async function getAllCharacters() {
          const db = await openDB();
          let idbList = [];
          if (db) {
            try {
              idbList = await new Promise((resolve) => {
                const tx = db.transaction('characters', 'readonly');
                const req = tx.objectStore('characters').getAll();
                req.onsuccess = () => resolve(req.result || []);
                req.onerror = () => resolve([]);
              });
            } catch (e) {}
          }

          try {
            const raw = localStorage.getItem('aetheria_custom_characters');
            const lsList = raw ? JSON.parse(raw) : [];
            if (Array.isArray(lsList)) {
              lsList.forEach(lsChar => {
                if (lsChar && lsChar.id && !idbList.some(c => c.id === lsChar.id)) {
                  idbList.push(lsChar);
                  if (db) saveCharacter(lsChar);
                }
              });
            }
          } catch (e) {}

          return idbList;
        }

        async function deleteCharacter(id) {
          if (!id) return false;
          const db = await openDB();
          if (db) {
            try {
              await new Promise((resolve) => {
                const tx = db.transaction('characters', 'readwrite');
                tx.objectStore('characters').delete(id);
                tx.oncomplete = () => resolve(true);
                tx.onerror = () => resolve(false);
              });
            } catch (e) {}
          }
          try {
            const raw = localStorage.getItem('aetheria_custom_characters');
            let list = raw ? JSON.parse(raw) : [];
            if (Array.isArray(list)) {
              list = list.filter(c => c && c.id !== id && c.id?.toLowerCase() !== id.toLowerCase());
              localStorage.setItem('aetheria_custom_characters', JSON.stringify(list));
            }
          } catch (e) {}
          return true;
        }

        window.AetheriaDB = {
          saveCharacter,
          getCharacter,
          getAllCharacters,
          deleteCharacter
        };

        // Global sleek dark-mode confirm dialog
        window.showConfirmModal = function({
          title = 'Delete Character',
          message = 'Are you sure you want to delete this character?',
          confirmText = 'Delete',
          cancelText = 'Cancel',
          danger = true
        } = {}) {
          return new Promise((resolve) => {
            const modal = document.getElementById('aetheria-confirm-modal');
            const dialog = document.getElementById('aetheria-confirm-dialog');
            const titleEl = document.getElementById('confirm-modal-title');
            const msgEl = document.getElementById('confirm-modal-msg');
            const cancelBtn = document.getElementById('confirm-modal-cancel');
            const okBtn = document.getElementById('confirm-modal-ok');
            const glow = document.getElementById('confirm-glow');
            const iconBox = document.getElementById('confirm-icon-box');

            if (!modal || !dialog || !okBtn || !cancelBtn) {
              return resolve(window.confirm(message));
            }

            if (titleEl) titleEl.textContent = title;
            if (msgEl) msgEl.textContent = message;
            if (cancelBtn) cancelBtn.textContent = cancelText;
            if (okBtn) {
              okBtn.textContent = confirmText;
              if (danger) {
                okBtn.className = 'w-full py-2.5 sm:py-3 rounded-2xl bg-gradient-to-r from-rose-600 to-rose-700 hover:from-rose-500 hover:to-rose-600 active:scale-95 text-xs sm:text-sm font-semibold text-white shadow-lg shadow-rose-950/60 transition duration-200 cursor-pointer';
                if (glow) glow.className = 'absolute -top-12 left-1/2 -translate-x-1/2 w-32 h-32 bg-rose-600/25 rounded-full blur-3xl pointer-events-none';
                if (iconBox) iconBox.className = 'w-12 h-12 rounded-2xl bg-rose-500/10 border border-rose-500/25 flex items-center justify-center mb-3 text-rose-400 shadow-inner';
              } else {
                okBtn.className = 'w-full py-2.5 sm:py-3 rounded-2xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 active:scale-95 text-xs sm:text-sm font-semibold text-white shadow-lg shadow-purple-950/60 transition duration-200 cursor-pointer';
                if (glow) glow.className = 'absolute -top-12 left-1/2 -translate-x-1/2 w-32 h-32 bg-purple-600/20 rounded-full blur-3xl pointer-events-none';
                if (iconBox) iconBox.className = 'w-12 h-12 rounded-2xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center mb-3 text-purple-400 shadow-inner';
              }
            }

            function cleanup(result) {
              modal.classList.remove('opacity-100', 'pointer-events-auto');
              modal.classList.add('opacity-0', 'pointer-events-none');
              dialog.classList.remove('scale-100');
              dialog.classList.add('scale-95');

              cancelBtn.removeEventListener('click', onCancel);
              okBtn.removeEventListener('click', onOk);
              modal.removeEventListener('click', onBackdrop);
              document.removeEventListener('keydown', onKey);

              resolve(result);
            }

            function onCancel() { cleanup(false); }
            function onOk() { cleanup(true); }
            function onBackdrop(e) {
              if (e.target === modal) cleanup(false);
            }
            function onKey(e) {
              if (e.key === 'Escape') cleanup(false);
            }

            cancelBtn.addEventListener('click', onCancel);
            okBtn.addEventListener('click', onOk);
            modal.addEventListener('click', onBackdrop);
            document.addEventListener('keydown', onKey);

            modal.classList.remove('opacity-0', 'pointer-events-none');
            modal.classList.add('opacity-100', 'pointer-events-auto');
            dialog.classList.remove('scale-95');
            dialog.classList.add('scale-100');
          });
        };
      })();
    </script>
</head>
  <body class={`bg-[#07080d] text-slate-100 selection:bg-purple-500/30 selection:text-purple-200 antialiased overflow-x-hidden w-full max-w-[100vw] ${noScroll ? 'h-[100dvh] max-h-[100dvh] overflow-hidden' : 'min-h-screen'}`}>
    <div class={`relative w-full ${noScroll ? 'h-[100dvh] max-h-[100dvh] overflow-hidden flex flex-col' : 'min-h-screen flex flex-col justify-between'}`}>
      <!-- Ambient background neon lighting -->
      <div class="fixed top-0 left-1/2 -translate-x-1/2 w-full max-w-7xl h-[450px] bg-gradient-to-b from-purple-900/10 via-indigo-950/5 to-transparent blur-[120px] pointer-events-none -z-10"></div>
      
      <slot />

      <!-- Sleek Dark-Themed Global Confirm Dialog Modal -->
      <div 
        id="aetheria-confirm-modal" 
        class="fixed inset-0 z-[100] flex items-center justify-center p-4 bg-black/80 backdrop-blur-md opacity-0 pointer-events-none transition-all duration-200 select-none"
        role="dialog"
        aria-modal="true"
      >
        <div 
          id="aetheria-confirm-dialog" 
          class="relative w-full max-w-[340px] sm:max-w-sm rounded-3xl bg-[#0c0f1e] border border-white/[0.1] shadow-2xl shadow-black/95 p-6 flex flex-col items-center text-center transform scale-95 transition-all duration-200"
        >
          <!-- Glow Backdrop -->
          <div id="confirm-glow" class="absolute -top-12 left-1/2 -translate-x-1/2 w-32 h-32 bg-rose-600/25 rounded-full blur-3xl pointer-events-none"></div>

          <!-- Icon -->
          <div id="confirm-icon-box" class="w-12 h-12 rounded-2xl bg-rose-500/10 border border-rose-500/25 flex items-center justify-center mb-3 text-rose-400 shadow-inner">
            <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
          </div>

          <!-- Title -->
          <h3 id="confirm-modal-title" class="text-base sm:text-lg font-bold text-white tracking-tight">
            Delete Character
          </h3>

          <!-- Message -->
          <p id="confirm-modal-msg" class="text-xs sm:text-sm text-slate-300/90 mt-2 leading-relaxed px-1">
            Are you sure you want to delete this character?
          </p>

          <p class="text-[11px] text-rose-400/80 font-medium mt-1.5">
            This action cannot be undone.
          </p>

          <!-- Actions -->
          <div class="grid grid-cols-2 gap-3 w-full mt-6">
            <button 
              id="confirm-modal-cancel" 
              type="button" 
              class="w-full py-2.5 sm:py-3 rounded-2xl bg-white/[0.05] hover:bg-white/[0.1] active:scale-95 border border-white/10 text-xs sm:text-sm font-semibold text-slate-300 hover:text-white transition duration-200 cursor-pointer"
            >
              Cancel
            </button>
            <button 
              id="confirm-modal-ok" 
              type="button" 
              class="w-full py-2.5 sm:py-3 rounded-2xl bg-gradient-to-r from-rose-600 to-rose-700 hover:from-rose-500 hover:to-rose-600 active:scale-95 text-xs sm:text-sm font-semibold text-white shadow-lg shadow-rose-950/60 transition duration-200 cursor-pointer"
            >
              Delete
            </button>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
