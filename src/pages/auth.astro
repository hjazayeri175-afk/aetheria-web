---
import Layout from '../layouts/Layout.astro';
import { 
  Sparkles, 
  ArrowLeft, 
  KeyRound, 
  Mail, 
  User, 
  ShieldCheck, 
  Lock, 
  Eye, 
  EyeOff, 
  Star, 
  CheckCircle2, 
  AlertCircle,
  HelpCircle
} from '@lucide/astro';
---

<Layout title="Account & Cloud Sync • Aetheria AI">
  <div class="min-h-screen bg-[#050713] text-slate-100 flex flex-col justify-between relative overflow-hidden selection:bg-purple-500/30">
    <!-- Ambient Cyber Glows -->
    <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[700px] h-[400px] bg-gradient-to-b from-purple-600/20 via-cyan-500/10 to-transparent blur-[120px] pointer-events-none"></div>
    <div class="absolute -bottom-40 -left-40 w-[500px] h-[500px] bg-purple-900/15 blur-[140px] pointer-events-none"></div>

    <!-- Top Navigation Header -->
    <header class="relative z-10 p-4 sm:p-6 max-w-7xl mx-auto w-full flex items-center justify-between">
      <a 
        href="/" 
        class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/10 text-xs sm:text-sm font-medium text-slate-300 hover:text-white transition group"
      >
        <ArrowLeft class="w-4 h-4 group-hover:-translate-x-1 transition duration-200" />
        <span>Return to Aetheria</span>
      </a>

      <div class="flex items-center gap-2">
        <div class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></div>
        <span class="text-xs text-slate-400 font-mono">Edge Cloud Active</span>
      </div>
    </header>

    <!-- Main Auth Hub -->
    <main class="relative z-10 flex-1 flex items-center justify-center p-4 sm:p-6">
      <div class="w-full max-w-md bg-[#0a0d1f]/90 border border-white/[0.1] rounded-3xl p-6 sm:p-8 backdrop-blur-2xl shadow-2xl shadow-purple-950/50">
        
        <!-- Brand Header -->
        <div class="text-center mb-6">
          <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-purple-600 via-indigo-600 to-cyan-500 flex items-center justify-center mx-auto mb-3 shadow-lg shadow-purple-900/40">
            <Sparkles class="w-6 h-6 text-white" />
          </div>
          <h1 id="auth-main-title" class="text-xl sm:text-2xl font-black tracking-tight text-white">
            Welcome to Aetheria
          </h1>
          <p id="auth-main-desc" class="text-xs sm:text-sm text-slate-400 mt-1">
            Sign in to sync all stories, characters & stars across devices
          </p>
        </div>

        <!-- Mode Switcher Tabs -->
        <div class="flex p-1 rounded-2xl bg-white/[0.04] border border-white/[0.08] mb-6 text-xs font-semibold">
          <button 
            id="tab-btn-signin" 
            type="button" 
            class="flex-1 py-2 rounded-xl bg-purple-600 text-white shadow transition cursor-pointer"
          >
            Sign In
          </button>
          <button 
            id="tab-btn-signup" 
            type="button" 
            class="flex-1 py-2 rounded-xl text-slate-400 hover:text-white transition cursor-pointer"
          >
            Create Account
          </button>
          <button 
            id="tab-btn-forgot" 
            type="button" 
            class="flex-1 py-2 rounded-xl text-slate-400 hover:text-white transition cursor-pointer"
          >
            Reset
          </button>
        </div>

        <!-- Social Fast Auth Buttons (Google & Microsoft) -->
        <div id="social-auth-section" class="space-y-2.5 mb-6">
          <button 
            type="button" 
            id="btn-google-auth" 
            class="w-full flex items-center justify-center gap-3 px-4 py-2.5 rounded-2xl bg-white hover:bg-slate-100 text-slate-900 font-semibold text-xs sm:text-sm transition duration-200 cursor-pointer shadow active:scale-98"
          >
            <svg class="w-4 h-4" viewBox="0 0 24 24">
              <path fill="#EA4335" d="M12 5c1.6 0 3 .6 4.1 1.6l3.1-3.1C17.3 1.7 14.8 1 12 1 7.4 1 3.5 3.6 1.6 7.4l3.7 2.9C6.2 7.3 8.9 5 12 5z"/>
              <path fill="#4285F4" d="M23.5 12.3c0-.8-.1-1.7-.2-2.3H12v4.6h6.5c-.3 1.5-1.1 2.8-2.4 3.7l3.7 2.9c2.2-2 3.7-5 3.7-8.9z"/>
              <path fill="#FBBC05" d="M5.3 14.7c-.2-.7-.4-1.5-.4-2.7s.2-2 .4-2.7L1.6 6.4C.6 8.3 0 10.6 0 12s.6 3.7 1.6 5.6l3.7-2.9z"/>
              <path fill="#34A853" d="M12 23c3.2 0 6-1.1 8-3l-3.7-2.9c-1.1.7-2.5 1.2-4.3 1.2-3.1 0-5.8-2.3-6.7-5.3L1.6 15.9C3.5 19.7 7.4 23 12 23z"/>
            </svg>
            <span>Continue with Google</span>
          </button>

          <button 
            type="button" 
            id="btn-microsoft-auth" 
            class="w-full flex items-center justify-center gap-3 px-4 py-2.5 rounded-2xl bg-[#1f2438] hover:bg-[#282f48] border border-white/10 text-white font-semibold text-xs sm:text-sm transition duration-200 cursor-pointer shadow active:scale-98"
          >
            <svg class="w-4 h-4" viewBox="0 0 23 23">
              <rect x="1" y="1" width="10" height="10" fill="#f25022"/>
              <rect x="12" y="1" width="10" height="10" fill="#7fba00"/>
              <rect x="1" y="12" width="10" height="10" fill="#00a4ef"/>
              <rect x="12" y="12" width="10" height="10" fill="#ffb900"/>
            </svg>
            <span>Continue with Microsoft</span>
          </button>

          <div class="relative flex py-2 items-center">
            <div class="flex-grow border-t border-white/[0.08]"></div>
            <span class="flex-shrink mx-3 text-[11px] text-slate-500 font-mono">OR EMAIL</span>
            <div class="flex-grow border-t border-white/[0.08]"></div>
          </div>
        </div>

        <!-- Dynamic Notice Banners -->
        <div id="auth-alert-error" class="hidden mb-4 p-3 rounded-2xl bg-rose-500/10 border border-rose-500/30 text-rose-300 text-xs flex items-center gap-2">
          <AlertCircle class="w-4 h-4 shrink-0 text-rose-400" />
          <span id="auth-error-msg" class="leading-relaxed">Error message</span>
        </div>

        <div id="auth-alert-success" class="hidden mb-4 p-3 rounded-2xl bg-emerald-500/10 border border-emerald-500/30 text-emerald-300 text-xs flex items-center gap-2">
          <CheckCircle2 class="w-4 h-4 shrink-0 text-emerald-400" />
          <span id="auth-success-msg" class="leading-relaxed">Success message</span>
        </div>

        <!-- Form Elements -->
        <form id="auth-form" class="space-y-4">
          <!-- Display Name (Only in Sign Up) -->
          <div id="field-group-name" class="hidden space-y-1.5">
            <label class="block text-xs font-semibold text-slate-300">Your Story Persona / Display Name</label>
            <div class="relative">
              <User class="w-4 h-4 text-slate-500 absolute left-3.5 top-1/2 -translate-y-1/2" />
              <input 
                id="input-name" 
                type="text" 
                placeholder="e.g. Wanderer, Nightshade" 
                class="w-full bg-[#050713] border border-white/10 rounded-2xl pl-10 pr-4 py-2.5 text-xs text-white placeholder-slate-600 focus:outline-none focus:border-purple-500 transition" 
              />
            </div>
          </div>

          <!-- Email -->
          <div class="space-y-1.5">
            <label class="block text-xs font-semibold text-slate-300">Email Address</label>
            <div class="relative">
              <Mail class="w-4 h-4 text-slate-500 absolute left-3.5 top-1/2 -translate-y-1/2" />
              <input 
                id="input-email" 
                type="email" 
                required 
                placeholder="you@example.com" 
                class="w-full bg-[#050713] border border-white/10 rounded-2xl pl-10 pr-4 py-2.5 text-xs text-white placeholder-slate-600 focus:outline-none focus:border-purple-500 transition" 
              />
            </div>
          </div>

          <!-- Password (Hidden in Forgot step 1) -->
          <div id="field-group-password" class="space-y-1.5">
            <div class="flex items-center justify-between">
              <label id="label-password" class="block text-xs font-semibold text-slate-300">Password</label>
              <button 
                id="link-forgot-inline" 
                type="button" 
                class="text-[11px] text-purple-400 hover:text-purple-300 transition"
              >
                Forgot?
              </button>
            </div>
            <div class="relative">
              <Lock class="w-4 h-4 text-slate-500 absolute left-3.5 top-1/2 -translate-y-1/2" />
              <input 
                id="input-password" 
                type="password" 
                required 
                placeholder="At least 6 characters" 
                class="w-full bg-[#050713] border border-white/10 rounded-2xl pl-10 pr-10 py-2.5 text-xs text-white placeholder-slate-600 focus:outline-none focus:border-purple-500 transition" 
              />
              <button 
                type="button" 
                id="toggle-pwd-btn" 
                class="absolute right-3.5 top-1/2 -translate-y-1/2 text-slate-500 hover:text-slate-300 transition"
              >
                <Eye class="w-4 h-4" />
              </button>
            </div>
          </div>

          <!-- 6-digit Reset Code (Only in Forgot step 2) -->
          <div id="field-group-reset-code" class="hidden space-y-1.5">
            <label class="block text-xs font-semibold text-slate-300">6-Digit Reset Code</label>
            <div class="relative">
              <KeyRound class="w-4 h-4 text-slate-500 absolute left-3.5 top-1/2 -translate-y-1/2" />
              <input 
                id="input-reset-code" 
                type="text" 
                maxlength="6"
                placeholder="123456" 
                class="w-full bg-[#050713] border border-white/10 rounded-2xl pl-10 pr-4 py-2.5 text-xs text-white placeholder-slate-600 font-mono tracking-widest focus:outline-none focus:border-purple-500 transition" 
              />
            </div>
          </div>

          <!-- Submit Button -->
          <button 
            id="auth-submit-btn" 
            type="submit" 
            class="w-full py-3 rounded-2xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-bold text-xs sm:text-sm transition duration-200 cursor-pointer shadow-lg shadow-purple-900/30 active:scale-98 flex items-center justify-center gap-2"
          >
            <span id="btn-text">Sign In</span>
          </button>
        </form>

        <!-- Perks Note -->
        <div class="mt-6 pt-5 border-t border-white/[0.08] text-center space-y-2">
          <div class="flex items-center justify-center gap-4 text-[11px] text-slate-400">
            <span class="flex items-center gap-1 text-amber-300">
              <Star class="w-3 h-3 fill-amber-300" />
              <span>10 Free Stars</span>
            </span>
            <span class="text-slate-600">•</span>
            <span class="flex items-center gap-1 text-purple-300">
              <ShieldCheck class="w-3 h-3" />
              <span>Cloud Sync</span>
            </span>
            <span class="text-slate-600">•</span>
            <span class="text-cyan-300">Anti-Clear Cache</span>
          </div>
          <p class="text-[10px] text-slate-500">
            Your conversations and unlockables are safely protected in cloud edge storage.
          </p>
        </div>

      </div>
    </main>

    <!-- Footer -->
    <footer class="relative z-10 p-4 text-center text-[11px] text-slate-500">
      Aetheria AI • Private, Living Stories & Infinite Worlds
    </footer>
  </div>

  <script>
    // Auth Mode State
    let currentMode = 'signin'; // 'signin' | 'signup' | 'forgot' | 'reset-code'

    const tabSignIn = document.getElementById('tab-btn-signin');
    const tabSignUp = document.getElementById('tab-btn-signup');
    const tabForgot = document.getElementById('tab-btn-forgot');
    const linkForgotInline = document.getElementById('link-forgot-inline');

    const authTitle = document.getElementById('auth-main-title');
    const authDesc = document.getElementById('auth-main-desc');
    const authForm = document.getElementById('auth-form');
    const submitBtn = document.getElementById('auth-submit-btn');
    const btnText = document.getElementById('btn-text');

    const socialAuthSection = document.getElementById('social-auth-section');
    const fieldName = document.getElementById('field-group-name');
    const fieldPassword = document.getElementById('field-group-password');
    const fieldResetCode = document.getElementById('field-group-reset-code');
    const labelPassword = document.getElementById('label-password');

    const inputName = document.getElementById('input-name');
    const inputEmail = document.getElementById('input-email');
    const inputPassword = document.getElementById('input-password');
    const inputResetCode = document.getElementById('input-reset-code');
    const togglePwdBtn = document.getElementById('toggle-pwd-btn');

    const alertError = document.getElementById('auth-alert-error');
    const alertSuccess = document.getElementById('auth-alert-success');
    const errorMsg = document.getElementById('auth-error-msg');
    const successMsg = document.getElementById('auth-success-msg');

    const btnGoogle = document.getElementById('btn-google-auth');
    const btnMicrosoft = document.getElementById('btn-microsoft-auth');

    function showError(msg) {
      if (alertError && errorMsg) {
        errorMsg.textContent = msg;
        alertError.classList.remove('hidden');
        alertSuccess?.classList.add('hidden');
      }
    }

    function showSuccess(msg) {
      if (alertSuccess && successMsg) {
        successMsg.textContent = msg;
        alertSuccess.classList.remove('hidden');
        alertError?.classList.add('hidden');
      }
    }

    function clearAlerts() {
      alertError?.classList.add('hidden');
      alertSuccess?.classList.add('hidden');
    }

    function setMode(mode) {
      currentMode = mode;
      clearAlerts();

      // Reset tabs styling
      const activeClass = ['bg-purple-600', 'text-white', 'shadow'];
      const inactiveClass = ['text-slate-400'];

      [tabSignIn, tabSignUp, tabForgot].forEach(btn => {
        btn?.classList.remove(...activeClass);
        btn?.classList.add(...inactiveClass);
      });

      if (mode === 'signin') {
        tabSignIn?.classList.add(...activeClass);
        tabSignIn?.classList.remove(...inactiveClass);
        authTitle.textContent = 'Welcome Back';
        authDesc.textContent = 'Sign in to access your characters and cloud chat history';
        btnText.textContent = 'Sign In';
        socialAuthSection?.classList.remove('hidden');
        fieldName?.classList.add('hidden');
        fieldPassword?.classList.remove('hidden');
        fieldResetCode?.classList.add('hidden');
        labelPassword.textContent = 'Password';
      } else if (mode === 'signup') {
        tabSignUp?.classList.add(...activeClass);
        tabSignUp?.classList.remove(...inactiveClass);
        authTitle.textContent = 'Create Free Account';
        authDesc.textContent = 'Get 10 Free Stars & automatic cross-device chat sync';
        btnText.textContent = 'Claim 10 Stars & Sign Up';
        socialAuthSection?.classList.remove('hidden');
        fieldName?.classList.remove('hidden');
        fieldPassword?.classList.remove('hidden');
        fieldResetCode?.classList.add('hidden');
        labelPassword.textContent = 'Create Password';
      } else if (mode === 'forgot') {
        tabForgot?.classList.add(...activeClass);
        tabForgot?.classList.remove(...inactiveClass);
        authTitle.textContent = 'Reset Password';
        authDesc.textContent = 'Enter your email to request a 6-digit recovery code';
        btnText.textContent = 'Generate Reset Code';
        socialAuthSection?.classList.add('hidden');
        fieldName?.classList.add('hidden');
        fieldPassword?.classList.add('hidden');
        fieldResetCode?.classList.add('hidden');
      } else if (mode === 'reset-code') {
        tabForgot?.classList.add(...activeClass);
        authTitle.textContent = 'Set New Password';
        authDesc.textContent = 'Enter the 6-digit code and your new password';
        btnText.textContent = 'Update Password & Sign In';
        socialAuthSection?.classList.add('hidden');
        fieldName?.classList.add('hidden');
        fieldPassword?.classList.remove('hidden');
        fieldResetCode?.classList.remove('hidden');
        labelPassword.textContent = 'New Password';
      }
    }

    tabSignIn?.addEventListener('click', () => setMode('signin'));
    tabSignUp?.addEventListener('click', () => setMode('signup'));
    tabForgot?.addEventListener('click', () => setMode('forgot'));
    linkForgotInline?.addEventListener('click', () => setMode('forgot'));

    // Toggle Password visibility
    togglePwdBtn?.addEventListener('click', () => {
      if (inputPassword.type === 'password') {
        inputPassword.type = 'text';
      } else {
        inputPassword.type = 'password';
      }
    });

    // Handle Form Submit
    authForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearAlerts();

      const email = inputEmail.value.trim();
      const password = inputPassword.value;
      const displayName = inputName?.value.trim() || '';
      const resetCode = inputResetCode?.value.trim() || '';

      submitBtn.disabled = true;
      submitBtn.classList.add('opacity-70');
      const originalText = btnText.textContent;
      btnText.textContent = 'Connecting...';

      try {
        if (currentMode === 'signin') {
          const res = await fetch('/api/auth/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password })
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Failed to sign in');

          // Store auth data
          localStorage.setItem('aetheria_auth_token', data.token);
          localStorage.setItem('aetheria_user', JSON.stringify(data.user));
          window.dispatchEvent(new CustomEvent('aetheria_auth_changed'));

          showSuccess('Welcome back! Redirecting to Aetheria...');
          setTimeout(() => {
            const urlParams = new URLSearchParams(window.location.search);
            window.location.href = urlParams.get('redirect') || '/';
          }, 800);

        } else if (currentMode === 'signup') {
          const res = await fetch('/api/auth/register', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, password, displayName })
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Failed to create account');

          localStorage.setItem('aetheria_auth_token', data.token);
          localStorage.setItem('aetheria_user', JSON.stringify(data.user));
          window.dispatchEvent(new CustomEvent('aetheria_auth_changed'));

          showSuccess('Account created with 10 Free Stars! Redirecting...');
          setTimeout(() => {
            const urlParams = new URLSearchParams(window.location.search);
            window.location.href = urlParams.get('redirect') || '/';
          }, 800);

        } else if (currentMode === 'forgot') {
          const res = await fetch('/api/auth/forgot-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email })
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Failed to generate reset code');

          if (data.resetCode) {
            showSuccess(`Reset code generated: ${data.resetCode} (Valid for 15 minutes)`);
            inputResetCode.value = data.resetCode;
          } else {
            showSuccess('If an account exists, a code was generated.');
          }
          setMode('reset-code');

        } else if (currentMode === 'reset-code') {
          const res = await fetch('/api/auth/reset-password', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email, code: resetCode, newPassword: password })
          });
          const data = await res.json();
          if (!res.ok) throw new Error(data.error || 'Failed to reset password');

          showSuccess('Password updated successfully! Please sign in with your new password.');
          setTimeout(() => {
            setMode('signin');
          }, 1200);
        }
      } catch (err) {
        showError(err.message || 'An error occurred during authentication.');
      } finally {
        submitBtn.disabled = false;
        submitBtn.classList.remove('opacity-70');
        btnText.textContent = originalText;
      }
    });

    // Social Auth Handler (Google & Microsoft)
    async function handleSocialAuth(provider) {
      clearAlerts();
      btnText.textContent = `Connecting to ${provider}...`;
      try {
        // Fast edge profile simulation or direct OAuth
        const mockPrompt = prompt(`Sign in with ${provider.toUpperCase()}:\nPlease enter your email address:`);
        if (!mockPrompt || !mockPrompt.includes('@')) {
          showError('Valid email is required for social sign in.');
          return;
        }

        const email = mockPrompt.trim().toLowerCase();
        const displayName = email.split('@')[0];
        const providerUserId = `${provider}_${btoa(email).slice(0, 16)}`;

        const res = await fetch('/api/auth/social', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            provider,
            email,
            displayName,
            providerUserId
          })
        });

        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Social sign in failed');

        localStorage.setItem('aetheria_auth_token', data.token);
        localStorage.setItem('aetheria_user', JSON.stringify(data.user));
        window.dispatchEvent(new CustomEvent('aetheria_auth_changed'));

        showSuccess(`Authenticated via ${provider}! Redirecting...`);
        setTimeout(() => {
          const urlParams = new URLSearchParams(window.location.search);
          window.location.href = urlParams.get('redirect') || '/';
        }, 800);
      } catch (err) {
        showError(err.message || 'Failed to connect via social provider.');
      } finally {
        btnText.textContent = currentMode === 'signin' ? 'Sign In' : 'Sign Up';
      }
    }

    btnGoogle?.addEventListener('click', () => handleSocialAuth('google'));
    btnMicrosoft?.addEventListener('click', () => handleSocialAuth('microsoft'));
  </script>
</Layout>
