      if (!savedChar || !savedChar.id) {
        throw new Error('Failed to generate valid character record');
      }

      showToast(`"${savedChar.name}" saved! Launching chat...`);

      // Direct navigation to custom chat route with trailing slash to prevent 307
      const targetUrl = `/chat/custom/?charId=${encodeURIComponent(savedChar.id)}`;
      window.location.href = targetUrl;
    } catch (err: any) {
      console.error('Character Save & Launch failed:', err);
      showToast('Error: ' + (err?.message || 'Could not save character'));
