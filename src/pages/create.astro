  // ================= SAVE TO LOCAL STORAGE =================
  function saveCharacterData() {
    // 1. Resolve character name & title with smart defaults
    let charName = nameInput?.value?.trim() || '';
    if (!charName) {
      const currentAvatar = avatarInput?.value || '';
      const matchedPreset = AVATAR_PRESETS.find(p => p.url === currentAvatar);
      charName = matchedPreset?.name || 'Aiko';
      if (nameInput) nameInput.value = charName;
    }

    let charTitle = titleInput?.value?.trim() || '';
    if (!charTitle) {
      charTitle = 'Companion';
      if (titleInput) titleInput.value = charTitle;
    }

    // 2. Generate bulletproof ID supporting Unicode / Persian / Arabic
    const editId = new URLSearchParams(window.location.search).get('edit');
    let cleanId = editId ? editId.trim() : (
      charName.toLowerCase().trim()
        .replace(/[^\p{L}\p{N}]+/gu, '-')
        .replace(/^-+|-+$/g, '')
    );
    if (!cleanId || cleanId === '-') {
      cleanId = 'custom-' + Date.now().toString(36);
    }

    // 5. Safe LocalStorage commit
    let existing = [];
    try {
      const raw = localStorage.getItem('aetheria_custom_characters');
      existing = raw ? JSON.parse(raw) : [];
      if (!Array.isArray(existing)) existing = [];
    } catch (e) {
      existing = [];
    }

    // If creating new (not editing) and ID exists, make unique so it doesn't overwrite
    if (!editId && existing.some((c: any) => c && c.id === cleanId)) {
      cleanId = `${cleanId}-${Date.now().toString(36).slice(-4)}`;
    }

    // 3. Ensure engaging greeting exists
    let greetingText = greetingInput?.value?.trim() || '';
    if (!greetingText) {
      const isPersian = /[\u0600-\u06FF]/.test(charName);
      if (isPersian) {
        greetingText = `*با لبخندی آرام و نگاهی گرم به شما نزدیک می‌شود.* "سلام! من ${charName} هستم. خوشحالم که اینجایی؛ دوست داری صحبت‌مون رو از کجا شروع کنیم؟"`;
      } else {
        greetingText = `*Looks at you with a gentle, engaging smile.* "Hello there. I'm ${charName}. What would you like to explore together today?"`;
      }
      if (greetingInput) greetingInput.value = greetingText;
    }

    // 4. Ensure personality exists
    let personalityText = personalityInput?.value?.trim() || '';
    if (!personalityText) {
      personalityText = 'Warm, observant, empathetic, and attentive conversational partner';
      if (personalityInput) personalityInput.value = personalityText;
    }

    const characterData = {
      id: cleanId,
      name: charName,
      title: charTitle,
      category: catInput?.value || 'Sci-Fi',
      avatarUrl: avatarInput?.value || AVATAR_PRESETS[0].url,
      greeting: greetingText,
      personality: personalityText,
      tags: tagsInput?.value ? tagsInput.value.split(',').map(t => t.trim()).filter(Boolean) : ['Companion', 'RPG'],
      description: loreInput?.value?.trim() || '',
      scenario: scenarioInput?.value?.trim() || '',
      appearance: appearanceInput?.value?.trim() || '',
      speechStyle: speechInput?.value?.trim() || '',
      mesExample: mesExampleInput?.value?.trim() || '',
      systemPrompt: sysPromptInput?.value?.trim() || 'Portray the character with atmospheric consistency.',
      alternateGreetings: altGreetingInput?.value ? altGreetingInput.value.split('<START>').map(s => s.trim()).filter(Boolean) : [],
      alternate_greetings: altGreetingInput?.value ? altGreetingInput.value.split('<START>').map(s => s.trim()).filter(Boolean) : [],
      starterPrompts: [
        starter1?.value?.trim(), 
        starter2?.value?.trim(), 
        starter3?.value?.trim()
      ].filter(Boolean),
      lorebook: {
        name: loreBookName?.value?.trim() || 'Aetheria Lorebook',
        description: loreBookDesc?.value?.trim() || 'World Info Book',
        entries: Array.isArray(loreEntries) ? loreEntries.map((en, idx) => ({
          ...en,
          keys: Array.isArray(en?.keys) ? en.keys : (typeof en?.keys === 'string' ? en.keys.split(',').map((k: string) => k.trim()).filter(Boolean) : [])
        })) : []
      },
      rating: '5.0',
