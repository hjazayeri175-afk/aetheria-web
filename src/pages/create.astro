---
import Layout from '../layouts/Layout.astro';
import { 
  ArrowLeft, 
  Sparkles, 
  ShieldCheck, 
  Upload, 
  Download, 
  Save, 
  Eye, 
  MessageSquare, 
  Check, 
  Info,
  Wand2, 
  Trash2, 
  FileText, 
  Settings2, 
  Image as ImageIcon, 
  BookOpen, 
  Sliders,
  Globe,
  Plus,
  Database,
  Copy,
  RefreshCw,
  AlertCircle,
  ExternalLink
} from '@lucide/astro';

const PRESET_AVATARS = [
  { url: 'https://images.unsplash.com/photo-1578632767115-351597cf2477?w=800&auto=format&fit=crop&q=80', label: 'Lyra Vance / Cyberpunk' },
  { url: 'https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=800&auto=format&fit=crop&q=80', label: 'Seraphina / Victorian' },
  { url: 'https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=800&auto=format&fit=crop&q=80', label: 'Kaelen / Scholar' },
  { url: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=800&auto=format&fit=crop&q=80', label: 'Marcus / Tactical' },
  { url: 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=800&auto=format&fit=crop&q=80', label: 'Nexus-07 / Synth' },
  { url: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=800&auto=format&fit=crop&q=80', label: 'Morrigan / Occult' },
  { url: 'https://images.unsplash.com/photo-1492562080023-ab3db95bfbce?w=800&auto=format&fit=crop&q=80', label: 'Solon / Mentor' },
  { url: 'https://images.unsplash.com/photo-1517841905240-472988babdf9?w=800&auto=format&fit=crop&q=80', label: 'Hana / Barista' },
];
---

<Layout title="Character Creation Studio | Aetheria AI (Tavern V2 Spec)">
  <div class="min-h-screen bg-[#04060d] text-slate-100 flex flex-col">
    
    <!-- Top Sticky Sub-Header -->
    <header class="sticky top-0 z-30 h-16 border-b border-white/[0.08] bg-[#070913]/90 backdrop-blur-xl px-4 sm:px-6 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a 
          href="/" 
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/[0.05] hover:bg-white/[0.1] border border-white/[0.1] text-xs font-medium text-slate-300 hover:text-white transition"
        >
          <ArrowLeft class="w-4 h-4 text-purple-400" />
          <span class="hidden sm:inline">Back to Hub</span>
        </a>
        <div class="h-4 w-px bg-white/10 hidden sm:block"></div>
        <div>
          <h1 class="text-xs sm:text-sm font-bold text-white flex items-center gap-2">
            <span>Character Studio</span>
            <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-purple-950/80 text-purple-300 border border-purple-500/30">
              Tavern V2 Spec
            </span>
          </h1>
          <p class="text-[10px] text-slate-400 hidden sm:block">
            Universal roleplay card architect & lorebook editor
          </p>
        </div>
      </div>

      <!-- Quick Action Controls -->
      <div class="flex items-center gap-2">
        <input 
          id="card-file-input" 
          type="file" 
          accept=".png,.json,image/png,application/json" 
          class="hidden" 
        />
        
        <button 
          id="trigger-import-btn"
          type="button" 
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/[0.05] hover:bg-white/[0.1] border border-white/[0.1] text-xs font-semibold text-slate-200 hover:text-white transition cursor-pointer"
          title="Import from Tavern PNG or JSON card"
        >
          <Upload class="w-3.5 h-3.5 text-cyan-400" />
          <span class="hidden sm:inline">Import Card</span>
        </button>

        <button 
          id="export-tavern-btn"
          type="button" 
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/[0.05] hover:bg-white/[0.1] border border-white/[0.1] text-xs font-semibold text-slate-200 hover:text-white transition cursor-pointer"
          title="Download Tavern V2 JSON Card"
        >
          <Download class="w-3.5 h-3.5 text-purple-400" />
          <span class="hidden sm:inline">Export V2</span>
        </button>

        <button 
          id="save-character-btn"
          type="button" 
          class="flex items-center gap-1.5 px-4 py-1.5 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-xs font-semibold text-white shadow-md shadow-purple-900/30 transition cursor-pointer active:scale-95"
        >
          <Save class="w-3.5 h-3.5" />
          <span>Save Persona</span>
        </button>
      </div>
    </header>

    <!-- Main Studio Grid -->
    <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8 grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8">
      
      <!-- Left Column: 4-Tab Architect with Live Token Counter & Lorebook (7 cols on large screens) -->
      <div class="lg:col-span-7 space-y-5">
        
        <!-- ================= TOKEN BUDGET & CONTEXT HEALTH HUD ================= -->
        <div class="p-3.5 sm:p-4 rounded-2xl bg-[#090b17] border border-white/[0.08] shadow-lg">
          <div class="flex items-center justify-between border-b border-white/[0.06] pb-2.5 mb-3">
            <div class="flex items-center gap-2">
              <Sparkles class="w-4 h-4 text-purple-400" />
              <span class="text-xs font-bold text-white tracking-wide uppercase">Context Memory & Token Budget</span>
            </div>
            <div class="flex items-center gap-1.5">
              <span id="token-health-badge" class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-950/60 border border-emerald-500/40 text-emerald-300">
                Optimal
              </span>
            </div>
          </div>

          <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 text-center">
            <!-- Permanent Tokens -->
            <div class="p-2 rounded-xl bg-white/[0.02] border border-white/[0.05]">
              <span class="block text-[10px] text-slate-400 font-medium">Permanent Tokens</span>
              <span id="hud-perm-tokens" class="text-sm font-bold text-purple-300 font-mono">~0</span>
              <span class="block text-[9px] text-slate-500">Sent every turn</span>
            </div>

            <!-- Dynamic Tokens -->
            <div class="p-2 rounded-xl bg-white/[0.02] border border-white/[0.05]">
              <span class="block text-[10px] text-slate-400 font-medium">Greeting & Examples</span>
              <span id="hud-dyn-tokens" class="text-sm font-bold text-cyan-300 font-mono">~0</span>
              <span class="block text-[9px] text-slate-500">First message weight</span>
            </div>

            <!-- Lorebook Weight -->
            <div class="p-2 rounded-xl bg-white/[0.02] border border-white/[0.05]">
              <span class="block text-[10px] text-slate-400 font-medium">World Info (Lore)</span>
              <span id="hud-lore-tokens" class="text-sm font-bold text-amber-300 font-mono">~0</span>
              <span class="block text-[9px] text-slate-500">Active entries</span>
            </div>

            <!-- Total Card Weight -->
            <div class="p-2 rounded-xl bg-white/[0.02] border border-white/[0.05]">
              <span class="block text-[10px] text-slate-400 font-medium">Total Tokens</span>
              <span id="hud-total-tokens" class="text-sm font-bold text-white font-mono">~0 / 4096</span>
              <span class="block text-[9px] text-slate-500">Base weight</span>
            </div>
          </div>
        </div>

        <!-- ================= CHUB.AI & REMOTE CARD QUICK IMPORT ================= -->
        <div class="p-3.5 sm:p-4 rounded-2xl bg-[#090e1f] border border-cyan-500/20 shadow-md">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-bold text-cyan-300 flex items-center gap-1.5">
              <Globe class="w-3.5 h-3.5 text-cyan-400" />
              <span>Import via Chub.ai or Remote Card URL</span>
            </span>
            <span class="text-[10px] text-slate-400 hidden sm:inline">Chub URL, PNG, or JSON link</span>
          </div>
          
          <div class="flex flex-col sm:flex-row gap-2">
            <div class="relative flex-1">
              <input 
                id="remote-url-input"
                type="text"
                placeholder="https://chub.ai/characters/username/char-name or direct .png / .json URL..."
                class="w-full px-3.5 py-2 rounded-xl bg-white/[0.04] border border-white/10 focus:border-cyan-400/60 text-xs text-white placeholder:text-slate-500 outline-none transition"
              />
            </div>
            <button 
              id="fetch-remote-card-btn"
              type="button"
              class="px-4 py-2 rounded-xl bg-cyan-600/30 hover:bg-cyan-600/50 border border-cyan-500/40 text-xs font-bold text-cyan-200 hover:text-white flex items-center justify-center gap-1.5 transition cursor-pointer active:scale-95 shrink-0 shadow-sm shadow-cyan-900/40"
            >
              <RefreshCw id="fetch-spinner-icon" class="w-3.5 h-3.5" />
              <span id="fetch-btn-label">Fetch & Populate</span>
            </button>
          </div>

          <!-- Status indicator -->
          <div id="remote-fetch-status" class="hidden mt-2 p-2 rounded-lg bg-black/40 border border-white/10 text-[11px] flex items-center gap-2">
            <span id="remote-status-dot" class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
            <span id="remote-status-text" class="text-slate-300">Ready</span>
          </div>
        </div>

        <!-- ================= 4-TAB NAVIGATION ================= -->
        <div class="flex items-center p-1 rounded-2xl bg-[#0a0d1c] border border-white/[0.08] shadow-inner gap-1 overflow-x-auto">
          <button 
            type="button"
            class="tab-btn active flex-1 py-2 px-2.5 rounded-xl text-xs font-semibold flex items-center justify-center gap-1.5 transition cursor-pointer bg-purple-600/30 text-purple-200 border border-purple-500/40 shadow-sm shrink-0"
            data-tab="tab-identity"
          >
            <ImageIcon class="w-3.5 h-3.5 text-purple-400" />
            <span>1. Identity</span>
          </button>
          <button 
            type="button"
            class="tab-btn flex-1 py-2 px-2.5 rounded-xl text-xs font-semibold flex items-center justify-center gap-1.5 transition cursor-pointer text-slate-400 hover:text-slate-200 hover:bg-white/[0.04] shrink-0"
            data-tab="tab-persona"
          >
            <BookOpen class="w-3.5 h-3.5 text-cyan-400" />
            <span>2. Persona & Lore</span>
          </button>
          <button 
            type="button"
            class="tab-btn flex-1 py-2 px-2.5 rounded-xl text-xs font-semibold flex items-center justify-center gap-1.5 transition cursor-pointer text-slate-400 hover:text-slate-200 hover:bg-white/[0.04] shrink-0"
            data-tab="tab-lorebook"
          >
            <Database class="w-3.5 h-3.5 text-amber-400" />
            <span>3. World Info</span>
          </button>
          <button 
            type="button"
            class="tab-btn flex-1 py-2 px-2.5 rounded-xl text-xs font-semibold flex items-center justify-center gap-1.5 transition cursor-pointer text-slate-400 hover:text-slate-200 hover:bg-white/[0.04] shrink-0"
            data-tab="tab-advanced"
          >
            <Sliders class="w-3.5 h-3.5 text-emerald-400" />
            <span>4. Dialogue & Rules</span>
          </button>
        </div>

        <!-- ================= TAB 1: IDENTITY, AVATAR & DROPZONE ================= -->
        <div id="tab-identity" class="tab-pane space-y-5">
          
          <!-- Dropzone: Ingest Real Tavern PNG Card or JSON -->
          <div 
            id="drop-zone"
            class="group relative border-2 border-dashed border-purple-500/30 hover:border-purple-500/70 rounded-2xl sm:rounded-3xl p-5 text-center bg-purple-950/10 hover:bg-purple-950/20 transition-all duration-300 cursor-pointer"
          >
            <div class="flex flex-col items-center justify-center space-y-2">
              <div class="w-10 h-10 rounded-2xl bg-purple-600/20 border border-purple-500/30 flex items-center justify-center text-purple-300 group-hover:scale-110 transition-transform">
                <Upload class="w-5 h-5 text-cyan-400 animate-pulse" />
              </div>
              <h3 class="text-xs sm:text-sm font-bold text-white tracking-wide">
                Drag & Drop Real Tavern PNG Card or JSON
              </h3>
              <p class="text-[11px] text-slate-400 max-w-sm">
                Drop any Character Card (<code class="text-purple-300 font-mono">.png</code> or <code class="text-cyan-300 font-mono">.json</code>) from SillyTavern or Chub.ai to automatically parse all 4 tabs and World Info!
              </p>
              <span class="inline-block mt-0.5 text-[11px] font-semibold text-purple-400 group-hover:text-purple-300 underline underline-offset-4">
                Or browse files from your computer
              </span>
            </div>
          </div>

          <!-- Names and Basic Meta -->
          <div class="p-5 sm:p-6 rounded-2xl sm:rounded-3xl bg-[#090b17] border border-white/[0.08] shadow-lg space-y-4">
            <div class="flex items-center justify-between border-b border-white/[0.06] pb-3">
              <h2 class="text-xs sm:text-sm font-bold text-white uppercase tracking-wider flex items-center gap-2">
                <span class="w-5 h-5 rounded-full bg-purple-600/30 text-purple-400 flex items-center justify-center text-xs font-bold">1</span>
                <span>Basic Identity & Role</span>
              </h2>
              <span class="text-[10px] text-slate-500">Core Metadata</span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <div class="flex items-center justify-between mb-1.5">
                  <label for="char-name" class="text-xs font-semibold text-slate-300">Character Name</label>
                  <span id="tok-name" class="text-[10px] font-mono text-slate-500">~2 tok</span>
                </div>
                <input 
                  id="char-name" 
                  type="text" 
                  placeholder="e.g. Aurelia Vance" 
                  class="w-full px-3.5 py-2.5 rounded-xl bg-white/[0.04] border border-white/10 focus:border-purple-500/60 text-xs sm:text-sm text-white outline-none transition"
                  value="Aurelia Vance"
                />
              </div>
              <div>
                <div class="flex items-center justify-between mb-1.5">
                  <label for="char-title" class="text-xs font-semibold text-slate-300">Title / Archetype Tagline</label>
                  <span id="tok-title" class="text-[10px] font-mono text-slate-500">~5 tok</span>
                </div>
                <input 
                  id="char-title" 
                  type="text" 
                  placeholder="e.g. Quantum Cryptographer & Archival Scribe" 
                  class="w-full px-3.5 py-2.5 rounded-xl bg-white/[0.04] border border-white/10 focus:border-purple-500/60 text-xs sm:text-sm text-white outline-none transition"
                  value="Quantum Cryptographer & Archival Scribe"
                />
              </div>
            </div>

            <!-- Category Selection -->
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="char-category" class="block text-xs font-semibold text-slate-300 mb-1.5">Primary Category</label>
                <select 
                  id="char-category" 
                  class="w-full px-3.5 py-2.5 rounded-xl bg-[#0d1020] border border-white/10 focus:border-purple-500/60 text-xs sm:text-sm text-white outline-none transition"
                >
                  <option value="Sci-Fi">Sci-Fi & Cyberpunk</option>
                  <option value="Fantasy">Fantasy & RPG</option>
                  <option value="Mystery">Mystery & Detective</option>
                  <option value="Philosophy">Philosophy & Mentors</option>
                  <option value="Slice of Life">Slice of Life & Cafe</option>
                  <option value="Anime & Manga">Anime & Manga</option>
                  <option value="Supernatural">Supernatural & Occult</option>
                </select>
              </div>

              <div>
                <label for="char-tags" class="block text-xs font-semibold text-slate-300 mb-1.5">Tags (Comma-separated)</label>
                <input 
                  id="char-tags" 
                  type="text" 
                  placeholder="Cyberpunk, Hacker, Scribe, Cryptography" 
                  class="w-full px-3.5 py-2.5 rounded-xl bg-white/[0.04] border border-white/10 text-xs sm:text-sm text-white outline-none transition"
                  value="Cyberpunk, Hacker, Scribe, Cryptography"
                />
              </div>
            </div>

            <!-- Avatar Image Selection & Local Upload -->
            <div>
              <div class="flex items-center justify-between mb-2">
                <label class="text-xs font-semibold text-slate-300">Avatar Portrait</label>
                <label for="custom-avatar-file" class="text-[11px] font-semibold text-purple-400 hover:text-purple-300 cursor-pointer flex items-center gap-1">
                  <Upload class="w-3 h-3" />
                  <span>Upload from Computer</span>
                </label>
                <input id="custom-avatar-file" type="file" accept="image/*" class="hidden" />
              </div>

              <!-- Preset Avatars -->
              <div class="grid grid-cols-4 sm:grid-cols-8 gap-2 mb-3">
                {PRESET_AVATARS.map((preset) => (
                  <button
                    type="button"
                    class="preset-avatar-btn relative aspect-square rounded-xl overflow-hidden border-2 border-white/10 hover:border-purple-500 focus:border-purple-500 transition cursor-pointer"
                    data-url={preset.url}
                    title={preset.label}
                  >
                    <img src={preset.url} alt={preset.label} class="w-full h-full object-cover" />
                  </button>
                ))}
              </div>

              <input 
                id="char-avatar-url" 
                type="text" 
                placeholder="Or paste image URL / Base64..." 
                class="w-full px-3.5 py-2 rounded-xl bg-white/[0.04] border border-white/10 text-xs text-white placeholder:text-slate-500 outline-none"
                value={PRESET_AVATARS[0].url}
              />
            </div>

            <!-- Physical Appearance & Visuals -->
            <div>
              <div class="flex items-center justify-between mb-1.5">
                <label for="char-appearance" class="text-xs font-semibold text-slate-300">
                  Physical Appearance & Physiology
                </label>
                <span id="tok-appearance" class="text-[10px] font-mono text-purple-400">~24 tok</span>
              </div>
              <textarea 
                id="char-appearance" 
                rows="2" 
                class="w-full px-3.5 py-2.5 rounded-xl bg-white/[0.04] border border-white/10 text-xs sm:text-sm text-white outline-none leading-relaxed resize-none"
                placeholder="Visual details for roleplay description: Height, eyes, cybernetics, clothing, tattoos..."
              >Silver short hair, ocular cyber-implant with azure HUD telemetry, draped in dark cryptographic coat with insulated fibre-optic wiring.</textarea>
            </div>

            <!-- SFW Standard Certification -->
            <div class="p-3.5 rounded-xl bg-emerald-950/20 border border-emerald-500/20 flex items-start gap-2.5">
              <input 
                id="char-sfw-cert" 
                type="checkbox" 
                checked 
                class="mt-0.5 rounded text-emerald-500 focus:ring-emerald-500 bg-white/10 border-white/20"
              />
              <label for="char-sfw-cert" class="text-[11px] text-slate-300 cursor-pointer">
                <span class="font-semibold text-emerald-300 block">SFW Standard Certification</span>
                I certify this character portrays an adult (18+) and adheres to wholesome storytelling, mystery, and companion standards.
              </label>
            </div>
          </div>
        </div>

        <!-- ================= TAB 2: PERSONA, LORE & SCENARIO ================= -->
        <div id="tab-persona" class="tab-pane hidden space-y-5">
          <div class="p-5 sm:p-6 rounded-2xl sm:rounded-3xl bg-[#090b17] border border-white/[0.08] shadow-lg space-y-4">
            <div class="flex items-center justify-between border-b border-white/[0.06] pb-3">
              <h2 class="text-xs sm:text-sm font-bold text-white uppercase tracking-wider flex items-center gap-2">
                <span class="w-5 h-5 rounded-full bg-cyan-600/30 text-cyan-400 flex items-center justify-center text-xs font-bold">2</span>
                <span>Persona, Psychology & World Lore</span>
              </h2>
              <span class="text-[10px] text-slate-500">Depth & Motivation</span>
            </div>

            <!-- Personality Traits Pills / Summary -->
            <div>
              <div class="flex items-center justify-between mb-1.5">
                <label for="char-personality" class="text-xs font-semibold text-slate-300">
                  Personality Summary & Behavioral Traits
                </label>
                <div class="flex items-center gap-2">
                  <span class="text-[10px] text-purple-400">Quick-click archetypes:</span>
                  <span id="tok-personality" class="text-[10px] font-mono text-cyan-400">~28 tok</span>
                </div>
              </div>
              <div class="flex flex-wrap gap-1.5 mb-2.5">
                {['Analytical', 'Cynical', 'Enigmatic', 'Protective', 'Stoic', 'Witty', 'Empathetic', 'Rebellious', 'Formal'].map((trait) => (
                  <button 
                    type="button" 
                    class="trait-chip px-2.5 py-1 rounded-lg bg-white/[0.04] hover:bg-purple-900/30 border border-white/[0.08] hover:border-purple-500/40 text-[11px] text-slate-300 hover:text-white transition cursor-pointer"
                    data-trait={trait}
                  >
                    +{trait}
                  </button>
                ))}
              </div>
              <textarea 
                id="char-personality" 
                rows="3" 
                class="w-full px-3.5 py-2.5 rounded-xl bg-white/[0.04] border border-white/10 focus:border-cyan-500/60 text-xs sm:text-sm text-white outline-none leading-relaxed resize-none"
                placeholder="Personality attributes, psychological profile, tone of voice..."
              >Analytical, observant, quietly sardonic towards authoritarian megacorps. Deeply loyal once trust is earned; values ancient literary knowledge above synthetic data streams.</textarea>
            </div>

            <!-- Backstory Lore -->
            <div>
              <div class="flex items-center justify-between mb-1.5">
                <label for="char-lore" class="text-xs font-semibold text-slate-300">
                  Backstory Lore & History
                </label>
                <span id="tok-lore" class="text-[10px] font-mono text-cyan-400">~45 tok</span>
              </div>
              <textarea 
                id="char-lore" 
                rows="4" 
                class="w-full px-3.5 py-2.5 rounded-xl bg-white/[0.04] border border-white/10 focus:border-cyan-500/60 text-xs sm:text-sm text-white outline-none leading-relaxed resize-none"
                placeholder="Origin, past encounters, motivations, secrets..."
              >Former senior cipher archivist for the Obsidian Cartel. After uncovering a classified wipe order targeting non-synthetic humanities archives, she extracted seven quantum storage crystals and vanished into the lower neon districts. Now operates an encrypted sanctuary for seekers of lost truths.</textarea>
            </div>

            <!-- Scenario & Setting -->
            <div>
              <div class="flex items-center justify-between mb-1.5">
                <label for="char-scenario" class="text-xs font-semibold text-slate-300">
                  Encounter Scenario & Setting
                </label>
                <span id="tok-scenario" class="text-[10px] font-mono text-cyan-400">~26 tok</span>
              </div>
              <textarea 
                id="char-scenario" 
                rows="3" 
                class="w-full px-3.5 py-2.5 rounded-xl bg-white/[0.04] border border-white/10 focus:border-cyan-500/60 text-xs sm:text-sm text-white outline-none leading-relaxed resize-none"
                placeholder="Where does the scene take place? How does the user enter?"
              >A hidden subterranean data haven beneath the rainy neon alleys of Sector 4. The user has tracked an encrypted radio pulse and walked into her chamber uninvited.</textarea>
            </div>

            <!-- Speech Style / Quirks -->
            <div>
              <div class="flex items-center justify-between mb-1.5">
                <label for="char-speech" class="text-xs font-semibold text-slate-300">
                  Speech Style & Dialect Quirks
                </label>
