  // ================= TAVERN PNG CHUNK & JSON PARSER =================
  async function parsePngChunks(arrayBuffer: ArrayBuffer) {
    const bytes = new Uint8Array(arrayBuffer);
    const textDecoderLatin1 = new TextDecoder('latin1');
    const textDecoderUtf8 = new TextDecoder('utf-8');
    let pos = 8; // skip 8-byte PNG signature

    const candidateKeywords = ['chara', 'character', 'ccv3', 'tavern', 'card'];

    while (pos < bytes.length) {
      if (pos + 8 > bytes.length) break;
      const len = ((bytes[pos] * 16777216) + (bytes[pos + 1] << 16) + (bytes[pos + 2] << 8) + bytes[pos + 3]) >>> 0;
      pos += 4;
      const type = textDecoderLatin1.decode(bytes.subarray(pos, pos + 4));
      pos += 4;

      if (pos + len > bytes.length) break;
      const data = bytes.subarray(pos, pos + len);

      if (type === 'tEXt' || type === 'zTXt' || type === 'iTXt') {
        const nullIdx = data.indexOf(0);
        if (nullIdx !== -1) {
          const keyword = textDecoderLatin1.decode(data.subarray(0, nullIdx)).toLowerCase().trim();
          if (candidateKeywords.includes(keyword)) {
            let jsonPayload = '';

            if (type === 'tEXt') {
              const rawData = data.subarray(nullIdx + 1);
              jsonPayload = textDecoderLatin1.decode(rawData);
            } else if (type === 'zTXt') {
              // zTXt: keyword + null + compression_method(1 byte) + compressed_data
              const compressedBytes = data.subarray(nullIdx + 2);
              try {
                const ds = new DecompressionStream('deflate');
                const writer = ds.writable.getWriter();
                writer.write(compressedBytes);
                writer.close();
                jsonPayload = await new Response(ds.readable).text();
              } catch (zErr) {
                console.warn('zTXt decompression failed:', zErr);
              }
            } else if (type === 'iTXt') {
              // iTXt: keyword + null + comp_flag(1 byte) + comp_method(1 byte) + lang + null + trans_key + null + text
              const compFlag = data[nullIdx + 1];
              let subPos = nullIdx + 3;
              while (subPos < data.length && data[subPos] !== 0) subPos++;
              subPos++;
              while (subPos < data.length && data[subPos] !== 0) subPos++;
              subPos++;
              const rawData = data.subarray(subPos);

              if (compFlag === 1) {
                try {
                  const ds = new DecompressionStream('deflate');
                  const writer = ds.writable.getWriter();
                  writer.write(rawData);
                  writer.close();
                  jsonPayload = await new Response(ds.readable).text();
                } catch(iErr) {
                  console.warn('iTXt decompression failed:', iErr);
                }
              } else {
                jsonPayload = textDecoderUtf8.decode(rawData);
              }
            }

            if (jsonPayload) {
              try {
                const binaryStr = atob(jsonPayload.trim());
                const rawBytes = new Uint8Array(binaryStr.length);
                for (let i = 0; i < binaryStr.length; i++) rawBytes[i] = binaryStr.charCodeAt(i);
                const decodedStr = textDecoderUtf8.decode(rawBytes);
                return JSON.parse(decodedStr);
              } catch {
                try {
                  return JSON.parse(jsonPayload.trim());
                } catch(e) {}
              }
            }
          }
        }
      }

      pos += len + 4; // skip data + 4 bytes CRC
    }
    return null;
  }

  function populateFromCardData(cardData: any, imageBase64?: string) {
    if (!cardData) return;

    let root = cardData;
    if (typeof root === 'string') {
      try { root = JSON.parse(root); } catch(e) {}
    }

    const d = root.data || root.character || root.definition || root;

    // 1. Name & Title
    const charName = d.name || d.char_name || d.character_name || root.name || root.char_name || '';
    const charTitle = d.title || d.creator_notes || d.personality_summary || d.short_description || 'Companion';

    if (charName && nameInput) {
      nameInput.value = charName;
      nameInput.dispatchEvent(new Event('input', { bubbles: true }));
    }
    if (charTitle && titleInput) {
      titleInput.value = charTitle;
      titleInput.dispatchEvent(new Event('input', { bubbles: true }));
    }

    // 2. Personality
    const charPersonality = d.personality || d.char_persona || d.persona || root.personality || '';
    if (charPersonality && personalityInput) {
      personalityInput.value = charPersonality;
      personalityInput.dispatchEvent(new Event('input', { bubbles: true }));
    }

    // 3. Description / Backstory / Lore
    const charDesc = d.description || d.char_desc || d.summary || d.bio || root.description || '';
    if (charDesc) {
      if (loreInput) {
        loreInput.value = charDesc;
        loreInput.dispatchEvent(new Event('input', { bubbles: true }));
      }
      if (appearanceInput && !appearanceInput.value) {
        appearanceInput.value = charDesc;
        appearanceInput.dispatchEvent(new Event('input', { bubbles: true }));
      }
    }

    // 4. Scenario
    const charScenario = d.scenario || d.world_scenario || root.scenario || '';
    if (charScenario && scenarioInput) {
      scenarioInput.value = charScenario;
      scenarioInput.dispatchEvent(new Event('input', { bubbles: true }));
    }

    // 5. Greeting / First Message
    const charGreeting = d.first_mes || d.greeting || d.char_greeting || d.initial_message || d.first_message || root.first_mes || '';
    if (charGreeting && greetingInput) {
      greetingInput.value = charGreeting;
      greetingInput.dispatchEvent(new Event('input', { bubbles: true }));
    }

    // 6. Dialogue Examples
    const charMesExample = d.mes_example || d.example_dialogue || d.examples || root.mes_example || '';
    if (charMesExample && mesExampleInput) {
      mesExampleInput.value = charMesExample;
      mesExampleInput.dispatchEvent(new Event('input', { bubbles: true }));
    }

    // 7. System Prompt
    const charSysPrompt = d.system_prompt || d.system_instruction || d.main_prompt || root.system_prompt || '';
    if (charSysPrompt && sysPromptInput) {
      sysPromptInput.value = charSysPrompt;
      sysPromptInput.dispatchEvent(new Event('input', { bubbles: true }));
    }

    // 8. Alternate Greetings
    const altGreetings = d.alternate_greetings || d.alt_greetings || d.alternateGreetings || root.alternate_greetings || [];
    if (Array.isArray(altGreetings) && altGreetings.length > 0 && altGreetingInput) {
      altGreetingInput.value = altGreetings.join('\n<START>\n');
      altGreetingInput.dispatchEvent(new Event('input', { bubbles: true }));
    }

    // 9. Tags
    const tags = d.tags || root.tags || [];
    if (Array.isArray(tags) && tags.length > 0 && tagsInput) {
      tagsInput.value = tags.join(', ');
      tagsInput.dispatchEvent(new Event('input', { bubbles: true }));
    }

    // 10. Lorebook / World Info
    const book = d.character_book || root.character_book || d.lorebook || root.lorebook;
    if (book) {
      if (book.name && loreBookName) loreBookName.value = book.name;
      if (book.description && loreBookDesc) loreBookDesc.value = book.description;
      if (Array.isArray(book.entries) && book.entries.length > 0) {
        loreEntries = book.entries.map((en: any, i: number) => ({
          id: 'card-entry-' + i + '-' + Date.now(),
          comment: en.comment || en.name || `Lore ${i + 1}`,
          keys: Array.isArray(en.keys) ? en.keys.join(', ') : (en.keys || ''),
          content: en.content || '',
          constant: Boolean(en.constant)
        }));
        renderLoreEntries();
      }
    }

    // 11. Avatar Image
    const avatarSrc = imageBase64 || d.avatar || d.avatar_url || root.avatar || root.avatar_url;
    if (avatarSrc && avatarInput) {
      avatarInput.value = avatarSrc;
      presetBtns.forEach(b => {
        b.className = 'preset-avatar-btn relative aspect-square rounded-xl overflow-hidden border-2 border-white/10 hover:border-purple-500/60 transition cursor-pointer';
      });
    }

    updateAllCalculations();
    showToast(`Loaded character: "${charName || 'Custom Character'}"! Populated all 4 steps & preview.`);
    importDrawer?.classList.add('hidden');
  }

  async function handleFile(file: File) {
    if (!file) return;

    if (cardFileInput) cardFileInput.value = '';

    const fileName = (file.name || '').toLowerCase();
    const fileType = (file.type || '').toLowerCase();

    // 1. JSON Card
    if (fileName.endsWith('.json') || fileType.includes('json')) {
      try {
        const text = await file.text();
        const json = JSON.parse(text);
        populateFromCardData(json);
      } catch (err: any) {
        console.error('JSON parse error:', err);
        showToast('Could not parse JSON character card: ' + err.message);
      }
      return;
    }

    // 2. Image File (PNG, WebP, etc.)
    if (fileType.startsWith('image/') || fileName.endsWith('.png') || fileName.endsWith('.webp')) {
      try {
        const buffer = await file.arrayBuffer();
        const parsed = await parsePngChunks(buffer);

        // Convert image buffer to base64 DataURL for avatar
        const dataUrl = await new Promise<string>((resolve) => {
          const reader = new FileReader();
          reader.onload = (e) => resolve(e.target?.result as string);
          reader.readAsDataURL(file);
        });

        const compressedDataUrl = await compressImageToThumbnail(dataUrl);

        if (parsed) {
          populateFromCardData(parsed, compressedDataUrl);
        } else {
          // No embedded Tavern metadata found, but load as avatar
          if (avatarInput) avatarInput.value = compressedDataUrl;
          presetBtns.forEach(b => {
            b.className = 'preset-avatar-btn relative aspect-square rounded-xl overflow-hidden border-2 border-white/10 hover:border-purple-500/60 transition cursor-pointer';
          });
          updateAllCalculations();
          showToast('Image loaded and optimized as Avatar! (No Tavern metadata chunk detected)');
        }
      } catch (err: any) {
        console.error('Image card parse error:', err);
        showToast('Error reading image file: ' + err.message);
      }
    }
  }

  // ================= CHUB.AI & REMOTE CARD FETCHER =================
  function setFetchStatus(state: 'loading' | 'success' | 'error', message: string) {
    if (!remoteFetchStatus || !remoteStatusDot || !remoteStatusText) return;
    remoteFetchStatus.classList.remove('hidden');
    remoteStatusText.textContent = message;

    if (state === 'loading') {
      remoteStatusDot.className = 'w-2 h-2 rounded-full bg-cyan-400 animate-ping';
      if (fetchSpinnerIcon) fetchSpinnerIcon.classList.add('animate-spin');
      if (fetchBtnLabel) fetchBtnLabel.textContent = 'Fetching...';
    } else if (state === 'success') {
      remoteStatusDot.className = 'w-2 h-2 rounded-full bg-emerald-400';
      if (fetchSpinnerIcon) fetchSpinnerIcon.classList.remove('animate-spin');
      if (fetchBtnLabel) fetchBtnLabel.textContent = 'Fetch & Auto-Fill All Steps';
    } else {
      remoteStatusDot.className = 'w-2 h-2 rounded-full bg-rose-400';
      if (fetchSpinnerIcon) fetchSpinnerIcon.classList.remove('animate-spin');
      if (fetchBtnLabel) fetchBtnLabel.textContent = 'Fetch & Auto-Fill All Steps';
    }
  }

  async function fetchRemoteCard() {
    const rawInput = remoteUrlInput?.value.trim();
    if (!rawInput) {
      showToast('Please enter a Chub URL, character identifier, or direct card URL.');
      return;
    }

    setFetchStatus('loading', 'Resolving card location...');

    try {
      let targetUrl = rawInput;

      // Check if it's a Chub URL or identifier (e.g. username/character-slug)
      const chubMatch1 = rawInput.match(/(?:chub\.ai|characterhub\.org)\/characters\/([^\/\?#]+)\/([^\/\?#]+)/);
      const chubMatch2 = rawInput.match(/^([a-zA-Z0-9_\-\.]+)\/([a-zA-Z0-9_\-\.]+)$/);

      if (chubMatch1) {
        targetUrl = `https://avatars.charhub.io/avatars/${chubMatch1[1]}/${chubMatch1[2]}/chara_card_v2.png`;
      } else if (chubMatch2) {
        targetUrl = `https://avatars.charhub.io/avatars/${chubMatch2[1]}/${chubMatch2[2]}/chara_card_v2.png`;
      }

      setFetchStatus('loading', `Downloading card...`);

      const resp = await fetch(targetUrl);
      if (!resp.ok) {
        throw new Error(`HTTP ${resp.status}: Could not retrieve card`);
      }

      const contentType = resp.headers.get('content-type') || '';
      
      if (contentType.includes('application/json') || targetUrl.endsWith('.json')) {
        const json = await resp.json();
        populateFromCardData(json);
        setFetchStatus('success', 'Card JSON downloaded and populated successfully!');
        return;
      }

      // Treat as PNG card
      const buffer = await resp.arrayBuffer();
      const parsed = await parsePngChunks(buffer);

      // Convert buffer to DataURL for avatar
      const bytes = new Uint8Array(buffer);
      let binary = '';
      const chunkSize = 8192;
      for (let i = 0; i < bytes.length; i += chunkSize) {
        binary += String.fromCharCode.apply(null, bytes.subarray(i, i + chunkSize) as unknown as number[]);
      }
      const dataUrl = 'data:image/png;base64,' + btoa(binary);

      if (parsed) {
        populateFromCardData(parsed, dataUrl);
        setFetchStatus('success', `Decoded Tavern V2 Card ("${parsed.data?.name || parsed.name || 'Character'}") successfully!`);
      } else {
        if (avatarInput) avatarInput.value = dataUrl;
        updateAllCalculations();
        setFetchStatus('success', 'Image loaded as Avatar (No embedded Tavern metadata detected).');
      }

    } catch (err: any) {
      console.error(err);
      setFetchStatus('error', `Failed: ${err.message || 'CORS or Network Error'}`);
    }
  }

