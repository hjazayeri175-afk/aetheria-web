            </button>
          </div>
        </div>

        <div>
          <label class="block text-[10px] font-medium text-slate-400 mb-1">Activation Trigger Keys (Comma-separated)</label>
          <input 
            type="text" 
            class="entry-keys-input w-full px-2.5 py-1.5 rounded-lg bg-black/40 border border-white/10 text-xs text-white outline-none" 
            value="${entry.keys.replace(/"/g, '&quot;')}" 
            placeholder="e.g. cartel, obsidian, cipher" 
          />
        </div>

        <div>
          <label class="block text-[10px] font-medium text-slate-400 mb-1">Lore Knowledge & Definition</label>
          <textarea 
            rows="2" 
            class="entry-content-input w-full px-2.5 py-1.5 rounded-lg bg-black/40 border border-white/10 text-xs text-slate-200 outline-none resize-none leading-relaxed" 
            placeholder="Injected when trigger keys appear in dialogue..."
          >${entry.content}</textarea>
        </div>

        <div class="flex items-center justify-between pt-1">
          <label class="flex items-center gap-1.5 text-[10px] text-slate-400 cursor-pointer">
            <input type="checkbox" class="entry-constant-chk rounded text-amber-500 bg-white/10 border-white/20" ${entry.constant ? 'checked' : ''} />
            <span>Always Active (Constant memory, bypasses keyword filter)</span>
          </label>
        </div>
      `;

      // Event bindings for this entry
      const titleInp = entryDiv.querySelector('.entry-title-input') as HTMLInputElement;
      const keysInp = entryDiv.querySelector('.entry-keys-input') as HTMLInputElement;
      const contentInp = entryDiv.querySelector('.entry-content-input') as HTMLTextAreaElement;
      const constChk = entryDiv.querySelector('.entry-constant-chk') as HTMLInputElement;
      const delBtn = entryDiv.querySelector('.delete-entry-btn') as HTMLButtonElement;

      titleInp?.addEventListener('input', () => { entry.comment = titleInp.value; updateAllCalculations(); });
      keysInp?.addEventListener('input', () => { entry.keys = keysInp.value; updateAllCalculations(); });
      contentInp?.addEventListener('input', () => { entry.content = contentInp.value; updateAllCalculations(); });
      constChk?.addEventListener('change', () => { entry.constant = constChk.checked; updateAllCalculations(); });
      delBtn?.addEventListener('click', () => {
        loreEntries = loreEntries.filter(e => e.id !== entry.id);
        renderLoreEntries();
      });

      loreEntriesList.appendChild(entryDiv);
    });

    updateAllCalculations();
  }

  addLoreEntryBtn?.addEventListener('click', () => {
    const newEntry: LoreEntry = {
      id: 'entry-' + Date.now(),
      comment: 'New Lore Entry',
      keys: 'keyword1, keyword2',
      content: 'Detailed world facts or background information injected when mentioned.',
      constant: false
    };
    loreEntries.push(newEntry);
    renderLoreEntries();
  });

  // Standalone lorebook import
  importLorebookBtn?.addEventListener('click', () => lorebookFileInput?.click());
  lorebookFileInput?.addEventListener('change', (e: Event) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = (re) => {
        try {
          const json = JSON.parse(re.target?.result as string);
          const entries = json.entries || json.character_book?.entries || [];
          if (Array.isArray(entries) && entries.length > 0) {
            loreEntries = entries.map((en: any, i: number) => ({
              id: 'imp-' + i + '-' + Date.now(),
              comment: en.comment || en.name || `Lore Entry ${i + 1}`,
              keys: Array.isArray(en.keys) ? en.keys.join(', ') : (en.keys || ''),
              content: en.content || '',
              constant: Boolean(en.constant)
            }));
            if (json.name && loreBookName) loreBookName.value = json.name;
            if (json.description && loreBookDesc) loreBookDesc.value = json.description;
            renderLoreEntries();
            showToast(`Imported ${entries.length} Lorebook entries!`);
          } else {
            showToast('No entries found in Lorebook JSON.');
          }
        } catch (err) {
          showToast('Invalid Lorebook JSON format.');
        }
      };
      reader.readAsText(file);
    }
  });

  // ================= TOAST NOTIFICATION =================
  function showToast(msg: string) {
    if (toastText && statusToast) {
      toastText.textContent = msg;
      statusToast.classList.remove('hidden');
      setTimeout(() => {
        statusToast.classList.add('hidden');
      }, 4000);
    }
  }

  // ================= CALCULATION & PREVIEW SYNC =================
  function updateAllCalculations() {
    // 1. Calculate individual badge tokens
    const tokName = estimateTokens(nameInput?.value || '');
    const tokTitle = estimateTokens(titleInput?.value || '');
    const tokApp = estimateTokens(appearanceInput?.value || '');
    const tokPers = estimateTokens(personalityInput?.value || '');
    const tokLore = estimateTokens(loreInput?.value || '');
    const tokScen = estimateTokens(scenarioInput?.value || '');
    const tokSpeech = estimateTokens(speechInput?.value || '');
    const tokGreet = estimateTokens(greetingInput?.value || '');
    const tokAltGreet = estimateTokens(altGreetingInput?.value || '');
    const tokMesEx = estimateTokens(mesExampleInput?.value || '');
    const tokSys = estimateTokens(sysPromptInput?.value || '');

    // Update mini badges
    const setBadge = (id: string, count: number) => {
      const el = document.getElementById(id);
      if (el) el.textContent = `~${count} tok`;
    };
    setBadge('tok-name', tokName);
    setBadge('tok-title', tokTitle);
    setBadge('tok-appearance', tokApp);
    setBadge('tok-personality', tokPers);
    setBadge('tok-lore', tokLore);
    setBadge('tok-scenario', tokScen);
    setBadge('tok-speech', tokSpeech);
    setBadge('tok-greeting', tokGreet);
    setBadge('tok-alt-greeting', tokAltGreet);
    setBadge('tok-mes-example', tokMesEx);
    setBadge('tok-system-prompt', tokSys);

    // Lorebook total tokens
    let loreTokens = 0;
    loreEntries.forEach(en => {
      loreTokens += estimateTokens(en.content);
    });

    // Permanent Tokens: System Prompt + Personality + Backstory + Appearance + Scenario + Lorebook
    const permanentTokens = tokSys + tokPers + tokLore + tokApp + tokScen + tokSpeech + loreTokens;
    // Dynamic Tokens: Greeting + Alt Greeting + Examples
    const dynamicTokens = tokGreet + tokAltGreet + tokMesEx;
    const totalTokens = permanentTokens + dynamicTokens;

    if (hudPermTokens) hudPermTokens.textContent = `~${permanentTokens}`;
    if (hudDynTokens) hudDynTokens.textContent = `~${dynamicTokens}`;
    if (hudLoreTokens) hudLoreTokens.textContent = `~${loreTokens}`;
    if (hudTotalTokens) hudTotalTokens.textContent = `~${totalTokens} / 4096`;
    if (previewTokenSummary) previewTokenSummary.textContent = `~${totalTokens} tok`;

    // Health badge
    if (tokenHealthBadge) {
      if (permanentTokens < 1000) {
        tokenHealthBadge.textContent = 'Optimal (<1k tok)';
        tokenHealthBadge.className = 'px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-950/60 border border-emerald-500/40 text-emerald-300';
      } else if (permanentTokens < 1800) {
        tokenHealthBadge.textContent = 'Standard (1k-1.8k)';
        tokenHealthBadge.className = 'px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-950/60 border border-amber-500/40 text-amber-300';
      } else {
        tokenHealthBadge.textContent = 'Heavy (>1.8k)';
        tokenHealthBadge.className = 'px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-950/60 border border-rose-500/40 text-rose-300';
      }
    }

    // 2. Update Card Preview
    if (previewName && nameInput) previewName.textContent = nameInput.value || 'Unnamed Persona';
    if (previewTitle && titleInput) previewTitle.textContent = titleInput.value || 'Roleplay Companion';
    if (previewCat && catInput) previewCat.textContent = catInput.value;
    if (previewImg && avatarInput) previewImg.src = avatarInput.value;
    if (previewSnippet && greetingInput) previewSnippet.textContent = greetingInput.value || 'No opening dialogue set.';
    
    if (previewTags && tagsInput) {
      const tags = tagsInput.value.split(',').map(t => t.trim()).filter(Boolean);
      previewTags.innerHTML = tags.slice(0, 3).map(t => `<span class="px-1.5 py-0.5 rounded bg-white/[0.08] text-[9px] text-slate-300">#${t}</span>`).join('');
    }

    // 3. Update Raw JSON Inspector
    updateRawJsonViewer();
  }

  function generateTavernCardObject() {
    return {
      spec: 'chara_card_v2',
      spec_version: '2.0',
      data: {
        name: nameInput?.value || 'Unnamed Persona',
        description: loreInput?.value || '',
        personality: personalityInput?.value || '',
        scenario: scenarioInput?.value || '',
        first_mes: greetingInput?.value || '',
        mes_example: mesExampleInput?.value || '',
        creator_notes: 'Created via Aetheria AI Character Studio. Strict SFW standard.',
        system_prompt: sysPromptInput?.value || 'Portray the character with atmospheric consistency.',
        post_history_instructions: '',
        alternate_greetings: altGreetingInput?.value.split('<START>').map(s => s.trim()).filter(Boolean) || [],
        character_book: {
          name: loreBookName?.value || 'Aetheria Lorebook',
          description: loreBookDesc?.value || 'World Info Book',
          scan_depth: 100,
          token_budget: 1000,
          recursive_scanning: false,
          entries: loreEntries.map((en, idx) => ({
            id: idx + 1,
            keys: en.keys.split(',').map(k => k.trim()).filter(Boolean),
            content: en.content,
            comment: en.comment,
            enabled: true,
            insertion_order: 100 + idx,
            constant: en.constant,
            case_sensitive: false
          }))
        },
        tags: tagsInput?.value.split(',').map(t => t.trim()).filter(Boolean) || [],
        creator: 'Aetheria Creator',
        character_version: '2.0'
      }
    };
  }

  function updateRawJsonViewer() {
    if (rawJsonCode && !rawJsonPanel?.classList.contains('hidden')) {
      const card = generateTavernCardObject();
      rawJsonCode.textContent = JSON.stringify(card, null, 2);
    }
  }

  // Toggle Raw JSON inspector
  toggleRawJsonBtn?.addEventListener('click', () => {
    if (rawJsonPanel) {
      const isHidden = rawJsonPanel.classList.toggle('hidden');
      if (jsonToggleArrow) jsonToggleArrow.textContent = isHidden ? '▼ Expand' : '▲ Collapse';
      if (!isHidden) updateRawJsonViewer();
    }
  });

  // Copy raw JSON
  copyRawJsonBtn?.addEventListener('click', () => {
    const card = generateTavernCardObject();
    navigator.clipboard.writeText(JSON.stringify(card, null, 2)).then(() => {
      if (copyBtnText) copyBtnText.textContent = 'Copied!';
      setTimeout(() => { if (copyBtnText) copyBtnText.textContent = 'Copy JSON'; }, 2000);
      showToast('Raw Tavern V2 JSON copied to clipboard!');
    });
  });

  // Bind live updates to all inputs
  [nameInput, titleInput, catInput, avatarInput, appearanceInput, personalityInput, loreInput, scenarioInput, greetingInput, altGreetingInput, mesExampleInput, sysPromptInput, tagsInput, loreBookName, loreBookDesc].forEach(el => {
    el?.addEventListener('input', updateAllCalculations);
  });

  // Trait chips toggle
  traitChips.forEach(chip => {
    chip.addEventListener('click', () => {
      const trait = chip.getAttribute('data-trait');
      if (trait && personalityInput) {
        if (!personalityInput.value.includes(trait)) {
          personalityInput.value = personalityInput.value ? `${personalityInput.value}, ${trait}` : trait;
          updateAllCalculations();
        }
      }
    });
  });

  // Preset avatar click
  presetBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const url = btn.getAttribute('data-url');
      if (url && avatarInput) {
        avatarInput.value = url;
        updateAllCalculations();
      }
    });
  });

  // Custom local avatar upload from device
  customAvatarFile?.addEventListener('change', (e: Event) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) {
      const reader = new FileReader();
      reader.onload = (re) => {
        const base64Url = re.target?.result as string;
        if (avatarInput) avatarInput.value = base64Url;
        updateAllCalculations();
        showToast('Avatar image loaded from your device!');
      };
      reader.readAsDataURL(file);
    }
  });

  // ================= TAVERN PNG CHUNK & JSON PARSER =================
  function parsePngChunks(arrayBuffer: ArrayBuffer) {
    const bytes = new Uint8Array(arrayBuffer);
    const textDecoder = new TextDecoder('latin1');
    let pos = 8;
    while (pos < bytes.length) {
      const len = (bytes[pos] << 24) | (bytes[pos + 1] << 16) | (bytes[pos + 2] << 8) | bytes[pos + 3];
      pos += 4;
      const type = textDecoder.decode(bytes.subarray(pos, pos + 4));
      pos += 4;
      if (type === 'tEXt') {
        const data = bytes.subarray(pos, pos + len);
        const nullIdx = data.indexOf(0);
        if (nullIdx !== -1) {
          const keyword = textDecoder.decode(data.subarray(0, nullIdx));
          if (keyword.toLowerCase() === 'chara') {
            const raw = textDecoder.decode(data.subarray(nullIdx + 1));
            // Base64 decode to UTF-8
            const binaryStr = atob(raw);
            const rawBytes = new Uint8Array(binaryStr.length);
            for (let i = 0; i < binaryStr.length; i++) rawBytes[i] = binaryStr.charCodeAt(i);
            const jsonStr = new TextDecoder('utf-8').decode(rawBytes);
            return JSON.parse(jsonStr);
          }
        }
      }
      pos += len + 4; // skip data + CRC
    }
    return null;
  }

  function populateFromCardData(cardData: any, imageBase64?: string) {
    // Standardize Tavern V2 vs V1
    const d = cardData.data || cardData;
    
    if (d.name && nameInput) nameInput.value = d.name;
    if (d.personality && personalityInput) personalityInput.value = d.personality;
    if (d.description) {
      if (loreInput) loreInput.value = d.description;
      if (appearanceInput && !appearanceInput.value) appearanceInput.value = d.description;
    }
    if (d.scenario && scenarioInput) scenarioInput.value = d.scenario;
    if (d.first_mes && greetingInput) greetingInput.value = d.first_mes;
    if (d.mes_example && mesExampleInput) mesExampleInput.value = d.mes_example;
    if (d.system_prompt && sysPromptInput) sysPromptInput.value = d.system_prompt;
    
    if (d.alternate_greetings && Array.isArray(d.alternate_greetings) && altGreetingInput) {
      altGreetingInput.value = d.alternate_greetings.join('\n<START>\n');
    }

    if (d.tags && Array.isArray(d.tags) && tagsInput) {
      tagsInput.value = d.tags.join(', ');
    }

    // Populate Character Book (World Info / Lorebook)
    const book = d.character_book || cardData.character_book || d.lorebook || cardData.lorebook;
    if (book) {
      if (book.name && loreBookName) loreBookName.value = book.name;
      if (book.description && loreBookDesc) loreBookDesc.value = book.description;
      if (Array.isArray(book.entries) && book.entries.length > 0) {
        loreEntries = book.entries.map((en: any, i: number) => ({
          id: 'card-entry-' + i + '-' + Date.now(),
          comment: en.comment || en.name || `Lore ${i + 1}`,
          keys: Array.isArray(en.keys) ? en.keys.join(', ') : (en.keys || ''),
          content: en.content || '',
          constant: Boolean(en.constant)
        }));
        renderLoreEntries();
      }
    }

    if (imageBase64 && avatarInput) {
      avatarInput.value = imageBase64;
    }

    updateAllCalculations();
    showToast(`Loaded character: "${d.name || 'Custom Character'}"! Populated all 4 tabs & Lorebook.`);
  }

  function handleFile(file: File) {
    if (!file) return;

    if (file.name.endsWith('.json') || file.type === 'application/json') {
      const reader = new FileReader();
      reader.onload = (e) => {
        try {
          const json = JSON.parse(e.target?.result as string);
          populateFromCardData(json);
        } catch (err) {
          alert('Could not parse JSON character card file.');
        }
      };
      reader.readAsText(file);
      return;
    }

    // PNG File (Tavern Character Card)
    if (file.type === 'image/png' || file.name.endsWith('.png')) {
      const bufferReader = new FileReader();
      bufferReader.onload = (e) => {
        try {
          const buffer = e.target?.result as ArrayBuffer;
          const parsed = parsePngChunks(buffer);

          // Read data URL for avatar
          const dataUrlReader = new FileReader();
          dataUrlReader.onload = (de) => {
            const dataUrl = de.target?.result as string;
            if (parsed) {
              populateFromCardData(parsed, dataUrl);
            } else {
              if (avatarInput) avatarInput.value = dataUrl;
              updateAllCalculations();
              showToast('Image loaded as Avatar! (No Tavern metadata chunk detected)');
            }
          };
          dataUrlReader.readAsDataURL(file);

        } catch (err) {
          console.error(err);
          showToast('Error parsing PNG metadata. Check console.');
        }
      };
      bufferReader.readAsArrayBuffer(file);
    }
  }

  // ================= CHUB.AI & REMOTE CARD FETCHER =================
  function setFetchStatus(state: 'loading' | 'success' | 'error', message: string) {
    if (!remoteFetchStatus || !remoteStatusDot || !remoteStatusText) return;
    remoteFetchStatus.classList.remove('hidden');
    remoteStatusText.textContent = message;

    if (state === 'loading') {
      remoteStatusDot.className = 'w-2 h-2 rounded-full bg-cyan-400 animate-ping';
      if (fetchSpinnerIcon) fetchSpinnerIcon.classList.add('animate-spin');
      if (fetchBtnLabel) fetchBtnLabel.textContent = 'Fetching...';
    } else if (state === 'success') {
      remoteStatusDot.className = 'w-2 h-2 rounded-full bg-emerald-400';
      if (fetchSpinnerIcon) fetchSpinnerIcon.classList.remove('animate-spin');
      if (fetchBtnLabel) fetchBtnLabel.textContent = 'Fetch & Populate';
    } else {
      remoteStatusDot.className = 'w-2 h-2 rounded-full bg-rose-400';
      if (fetchSpinnerIcon) fetchSpinnerIcon.classList.remove('animate-spin');
      if (fetchBtnLabel) fetchBtnLabel.textContent = 'Fetch & Populate';
    }
  }

  async function fetchRemoteCard() {
    const rawInput = remoteUrlInput?.value.trim();
    if (!rawInput) {
      alert('Please enter a Chub URL, character identifier, or direct card URL.');
      return;
    }

    setFetchStatus('loading', 'Resolving card location...');

    try {
      let targetUrl = rawInput;

      // Check if it's a Chub URL or identifier (e.g. username/character-slug)
      const chubMatch1 = rawInput.match(/(?:chub\.ai|characterhub\.org)\/characters\/([^\/\?#]+)\/([^\/\?#]+)/);
      const chubMatch2 = rawInput.match(/^([a-zA-Z0-9_\-\.]+)\/([a-zA-Z0-9_\-\.]+)$/);

      if (chubMatch1) {
        targetUrl = `https://avatars.charhub.io/avatars/${chubMatch1[1]}/${chubMatch1[2]}/chara_card_v2.png`;
      } else if (chubMatch2) {
        targetUrl = `https://avatars.charhub.io/avatars/${chubMatch2[1]}/${chubMatch2[2]}/chara_card_v2.png`;
      }

      setFetchStatus('loading', `Downloading card from ${new URL(targetUrl).hostname}...`);

      const resp = await fetch(targetUrl);
      if (!resp.ok) {
        throw new Error(`HTTP ${resp.status}: Could not retrieve card`);
      }

      const contentType = resp.headers.get('content-type') || '';
      
      if (contentType.includes('application/json') || targetUrl.endsWith('.json')) {
        const json = await resp.json();
        populateFromCardData(json);
        setFetchStatus('success', 'Card JSON downloaded and populated successfully!');
        return;
      }

      // Treat as PNG card
      const buffer = await resp.arrayBuffer();
      const parsed = parsePngChunks(buffer);

      // Convert buffer to DataURL for avatar
      const bytes = new Uint8Array(buffer);
      let binary = '';
      const chunkSize = 8192;
      for (let i = 0; i < bytes.length; i += chunkSize) {
        binary += String.fromCharCode.apply(null, bytes.subarray(i, i + chunkSize) as unknown as number[]);
      }
      const dataUrl = 'data:image/png;base64,' + btoa(binary);

      if (parsed) {
        populateFromCardData(parsed, dataUrl);
        setFetchStatus('success', `Decoded Tavern V2 Card ("${parsed.data?.name || 'Character'}") successfully!`);
      } else {
        if (avatarInput) avatarInput.value = dataUrl;
        updateAllCalculations();
        setFetchStatus('success', 'Image loaded as Avatar (No embedded Tavern metadata detected).');
      }

    } catch (err: any) {
      console.error(err);
      setFetchStatus('error', `Failed: ${err.message || 'CORS or Network Error'}`);
    }
  }

  fetchRemoteCardBtn?.addEventListener('click', fetchRemoteCard);
  remoteUrlInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') fetchRemoteCard();
  });

  // Bind Dropzone & Card Input
  triggerImportBtn?.addEventListener('click', () => cardFileInput?.click());
  dropZone?.addEventListener('click', () => cardFileInput?.click());
  
  cardFileInput?.addEventListener('change', (e: Event) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) handleFile(file);
  });

  dropZone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    dropZone.classList.add('border-cyan-400', 'bg-purple-950/30');
  });

  dropZone?.addEventListener('dragleave', () => {
    dropZone.classList.remove('border-cyan-400', 'bg-purple-950/30');
  });

  dropZone?.addEventListener('drop', (e) => {
    e.preventDefault();
    dropZone.classList.remove('border-cyan-400', 'bg-purple-950/30');
    const file = e.dataTransfer?.files?.[0];
    if (file) handleFile(file);
  });

  // ================= SAVE TO LOCAL STORAGE =================
  saveBtn?.addEventListener('click', () => {
    const characterData = {
      id: (nameInput.value || 'custom-character').toLowerCase().replace(/[^a-z0-9]+/g, '-'),
      name: nameInput.value || 'Unnamed Persona',
      title: titleInput.value || 'Companion',
      category: catInput.value,
      avatarUrl: avatarInput.value,
      greeting: greetingInput.value,
      personality: personalityInput.value,
      tags: tagsInput.value.split(',').map(t => t.trim()).filter(Boolean),
      description: loreInput.value,
      scenario: scenarioInput.value,
      appearance: appearanceInput.value,
      speechStyle: speechInput.value,
      mesExample: mesExampleInput.value,
      systemPrompt: sysPromptInput.value,
      alternateGreetings: altGreetingInput.value.split('<START>').map(s => s.trim()).filter(Boolean),
      starterPrompts: [starter1.value, starter2.value, starter3.value].filter(Boolean),
      lorebook: {
        name: loreBookName.value,
        description: loreBookDesc.value,
        entries: loreEntries
      },
      rating: '5.0',
      chatsCount: '1',
      isCustom: true
    };

    const existing = JSON.parse(localStorage.getItem('aetheria_custom_characters') || '[]');
    const idx = existing.findIndex((c: any) => c.id === characterData.id);
    if (idx !== -1) {
      existing[idx] = characterData;
    } else {
      existing.push(characterData);
    }
    localStorage.setItem('aetheria_custom_characters', JSON.stringify(existing));

    showToast(`"${characterData.name}" saved! Available in your local hub.`);
  });

  // ================= EXPORT TAVERN CARD V2 (JSON) =================
  exportBtn?.addEventListener('click', () => {
    const tavernCardV2 = generateTavernCardObject();
    const blob = new Blob([JSON.stringify(tavernCardV2, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${(nameInput.value || 'character').toLowerCase().replace(/[^a-z0-9]+/g, '-')}-card.json`;
    a.click();
    URL.revokeObjectURL(url);

    showToast('Tavern V2 Card JSON exported with World Info!');
  });

  // Initial render
  renderLoreEntries();
  updateAllCalculations();
</script>
