---
import Layout from '../layouts/Layout.astro';
import { 
  ArrowLeft, 
  Sparkles, 
  ShieldCheck, 
  Upload, 
  Download, 
  Save, 
  Eye, 
  EyeOff,
  Check, 
  Info, 
  Trash2, 
  FileText, 
  Image as ImageIcon, 
  BookOpen, 
  Sliders, 
  Globe, 
  Plus, 
  Database, 
  Copy, 
  RefreshCw, 
  AlertCircle, 
  ChevronRight, 
  ChevronLeft,
  X,
  HelpCircle
} from '@lucide/astro';

const PRESET_AVATARS = [
  { url: '/avatars/asian_woman.webp', label: 'Asian / Japanese Woman (Studio Neon)', name: 'Aiko' },
  { url: '/avatars/western_woman.webp', label: 'Western / Caucasian Woman (Coral Amber)', name: 'Elena' },
  { url: '/avatars/black_woman.webp', label: 'Black Woman (Radiant Magenta)', name: 'Amara' },
  { url: '/avatars/white_man.webp', label: 'White / Caucasian Man (Golden Studio)', name: 'Julian' },
  { url: '/avatars/black_man.webp', label: 'Black Man (Emerald Cyan)', name: 'Darius' },
  { url: '/avatars/anime_girl.webp', label: 'Anime Girl (Painterly Cyberpunk Concept Art)', name: 'Kira' },
  { url: '/avatars/anime_androgynous.webp', label: 'Anime Androgynous / Boy (Painterly Cyberpunk Concept Art)', name: 'Ren' },
  { url: '/avatars/abstract_ai.webp', label: 'Abstract AI / Intelligent Entity (Neural Core)', name: 'Nexus Core' },
];
---

<Layout title="Character Studio | Aetheria AI (Tavern V2 Spec)">
  <div class="min-h-screen bg-[#04060d] text-slate-100 flex flex-col pb-24 lg:pb-12">
    
    <!-- Top Sticky Header -->
    <header class="sticky top-0 z-40 h-16 border-b border-white/[0.08] bg-[#070913]/95 backdrop-blur-xl px-4 sm:px-6 flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a 
          href="/library" 
          id="create-back-btn"
          class="flex items-center justify-center w-9 h-9 rounded-xl bg-white/[0.05] hover:bg-white/[0.1] border border-white/[0.1] text-slate-300 hover:text-white transition"
          title="Back to Chats Library"
        >
          <ArrowLeft class="w-4 h-4 text-[var(--theme-accent,#c084fc)]" />
        </a>
        <div>
          <h1 class="text-sm sm:text-base font-bold text-white flex items-center gap-2">
            <span>Character Studio</span>
            <span class="px-2 py-0.5 rounded-full text-[10px] font-semibold bg-purple-950/80 text-purple-300 border border-purple-500/30">
              V2 Spec
            </span>
          </h1>
          <p class="text-[11px] text-slate-400 hidden sm:block">Clean slate character architect & token manager</p>
        </div>
      </div>

      <!-- Quick Action Buttons -->
      <div class="flex items-center gap-2">
        <input 
          id="card-file-input" 
          type="file" 
          accept=".png,.webp,.json,image/png,image/webp,application/json" 
          class="hidden" 
        />
        
        <button 
          id="toggle-import-panel-btn"
          type="button" 
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-cyan-950/40 hover:bg-cyan-900/50 border border-cyan-500/30 text-xs font-semibold text-cyan-200 transition cursor-pointer"
          title="Import card from file or Chub link"
        >
          <Upload class="w-3.5 h-3.5" />
          <span class="hidden sm:inline">Import Card</span>
        </button>

        <button 
          id="export-tavern-btn"
          type="button" 
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/[0.05] hover:bg-white/[0.1] border border-white/[0.1] text-xs font-semibold text-slate-200 transition cursor-pointer"
          title="Download Tavern V2 JSON Card"
        >
          <Download class="w-3.5 h-3.5 text-purple-400" />
          <span class="hidden sm:inline">Export</span>
        </button>

        <!-- Mobile Preview Trigger -->
        <button 
          id="mobile-open-preview-btn"
          type="button" 
          class="lg:hidden flex items-center justify-center w-9 h-9 rounded-xl bg-purple-600/20 border border-purple-500/40 text-purple-300"
          title="View Card Preview"
        >
          <Eye class="w-4 h-4" />
        </button>
      </div>
    </header>

    <!-- Main Content Container -->
    <div class="max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 pt-4 sm:pt-6">
      
      <!-- ================= COMPACT FLOATING TOKEN & CONTEXT CAPSULE ================= -->
      <div class="mb-4 sm:mb-6 p-2.5 sm:p-3 rounded-2xl bg-[#090b17]/90 border border-white/[0.08] backdrop-blur-md flex flex-wrap items-center justify-between gap-2 shadow-sm">
        <div class="flex items-center gap-2">
          <Sparkles class="w-4 h-4 text-purple-400 shrink-0" />
          <span class="text-xs font-bold text-white tracking-wide">Context Footprint:</span>
          <span id="hud-total-tokens" class="text-xs font-mono font-bold text-purple-300">~0 / 4096 tok</span>
          <span id="token-health-badge" class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-950/60 border border-emerald-500/40 text-emerald-300">
            Optimal (&lt;1k)
          </span>
        </div>
        <div class="flex items-center gap-3 text-[11px] text-slate-400 font-mono">
          <span>Perm: <strong id="hud-perm-tokens" class="text-slate-200">~0</strong></span>
          <span class="text-slate-600">•</span>
          <span>Dyn: <strong id="hud-dyn-tokens" class="text-slate-200">~0</strong></span>
          <span class="text-slate-600">•</span>
          <span>Lore: <strong id="hud-lore-tokens" class="text-amber-300">~0</strong></span>
        </div>
      </div>

      <!-- ================= COLLAPSIBLE IMPORT DRAWER (CHUB & FILE) ================= -->
      <div id="import-drawer" class="hidden mb-6 p-4 sm:p-5 rounded-2xl sm:rounded-3xl bg-[#090e1f] border border-cyan-500/30 shadow-xl transition-all">
        <div class="flex items-center justify-between border-b border-white/[0.08] pb-3 mb-4">
          <div class="flex items-center gap-2">
            <Globe class="w-4 h-4 text-cyan-400" />
            <h3 class="text-xs sm:text-sm font-bold text-white">Import Card from Chub.ai or Real Tavern PNG/JSON</h3>
          </div>
          <button id="close-import-drawer-btn" class="p-1 rounded-lg text-slate-400 hover:text-white transition">
            <X class="w-4 h-4" />
          </button>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <!-- Method 1: Chub URL -->
          <div class="p-3.5 rounded-xl bg-black/40 border border-white/5 space-y-2.5">
            <span class="text-xs font-semibold text-cyan-300 flex items-center gap-1.5">
              <span>Method A: Chub.ai URL or Direct Link</span>
            </span>
            <input 
              id="remote-url-input"
              type="text"
              placeholder="e.g. https://chub.ai/characters/author/slug or username/slug..."
              class="w-full px-3.5 py-2.5 rounded-xl bg-white/[0.04] border border-white/10 focus:border-cyan-400/60 text-xs sm:text-sm text-white placeholder:text-slate-500 outline-none"
            />
            <button 
              id="fetch-remote-card-btn"
              type="button"
              class="w-full py-2.5 rounded-xl bg-cyan-600/30 hover:bg-cyan-600/50 border border-cyan-500/40 text-xs font-bold text-cyan-200 hover:text-white flex items-center justify-center gap-1.5 transition cursor-pointer active:scale-95"
            >
              <RefreshCw id="fetch-spinner-icon" class="w-3.5 h-3.5" />
              <span id="fetch-btn-label">Fetch & Auto-Fill All Steps</span>
            </button>
            <div id="remote-fetch-status" class="hidden text-[11px] text-slate-300 flex items-center gap-1.5">
              <span id="remote-status-dot" class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
              <span id="remote-status-text">Fetching...</span>
            </div>
          </div>

          <!-- Method 2: Local File Dropzone -->
          <div 
            id="drop-zone"
            class="p-4 rounded-xl border-2 border-dashed border-purple-500/30 hover:border-purple-500/70 bg-purple-950/10 hover:bg-purple-950/20 text-center transition cursor-pointer flex flex-col items-center justify-center space-y-1.5"
          >
            <Upload class="w-5 h-5 text-purple-400" />
            <span class="text-xs font-bold text-white">Method B: Drop PNG or JSON File</span>
            <span class="text-[11px] text-slate-400">Click or drag Tavern card from PC or phone</span>
          </div>
        </div>
      </div>

      <!-- ================= STEP WIZARD PROGRESS BAR (STEPPER) ================= -->
      <div class="mb-6">
        <!-- Desktop / Tablet Stepper (Horizontal) -->
        <div class="hidden sm:grid sm:grid-cols-4 gap-2">
          
          <button 
            type="button" 
            class="step-tab-btn active text-left p-3 rounded-2xl border transition-all cursor-pointer bg-purple-950/30 border-purple-500/50 text-white shadow-md shadow-purple-950/30"
            data-step="1"
          >
            <div class="flex items-center gap-2 mb-1">
              <span class="step-num w-5 h-5 rounded-full bg-purple-600 text-white flex items-center justify-center text-xs font-bold">1</span>
              <span class="text-xs font-bold">Identity & Card</span>
            </div>
            <p class="text-[10px] text-slate-400 line-clamp-1">Name, portrait, archetype, genre</p>
          </button>

          <button 
            type="button" 
            class="step-tab-btn text-left p-3 rounded-2xl border transition-all cursor-pointer bg-white/[0.02] border-white/[0.06] text-slate-400 hover:text-slate-200 hover:bg-white/[0.04]"
            data-step="2"
          >
            <div class="flex items-center gap-2 mb-1">
              <span class="step-num w-5 h-5 rounded-full bg-white/10 text-slate-300 flex items-center justify-center text-xs font-bold">2</span>
              <span class="text-xs font-bold">Persona & Lore</span>
            </div>
            <p class="text-[10px] text-slate-400 line-clamp-1">Personality, backstory, setting</p>
          </button>

          <button 
            type="button" 
            class="step-tab-btn text-left p-3 rounded-2xl border transition-all cursor-pointer bg-white/[0.02] border-white/[0.06] text-slate-400 hover:text-slate-200 hover:bg-white/[0.04]"
            data-step="3"
          >
            <div class="flex items-center gap-2 mb-1">
              <span class="step-num w-5 h-5 rounded-full bg-white/10 text-slate-300 flex items-center justify-center text-xs font-bold">3</span>
              <span class="text-xs font-bold">World Info</span>
            </div>
            <p class="text-[10px] text-slate-400 line-clamp-1">Lorebook & dynamic keywords</p>
          </button>

          <button 
            type="button" 
            class="step-tab-btn text-left p-3 rounded-2xl border transition-all cursor-pointer bg-white/[0.02] border-white/[0.06] text-slate-400 hover:text-slate-200 hover:bg-white/[0.04]"
            data-step="4"
          >
            <div class="flex items-center gap-2 mb-1">
              <span class="step-num w-5 h-5 rounded-full bg-white/10 text-slate-300 flex items-center justify-center text-xs font-bold">4</span>
              <span class="text-xs font-bold">Dialogue & Rules</span>
            </div>
            <p class="text-[10px] text-slate-400 line-clamp-1">Greeting, few-shot examples, prompt</p>
          </button>

        </div>

        <!-- Mobile Stepper (Slim Card with Step Counter & Bar) -->
        <div class="sm:hidden p-3.5 rounded-2xl bg-[#090b17] border border-white/[0.08]">
          <div class="flex items-center justify-between mb-2">
            <span id="mobile-step-title" class="text-xs font-bold text-white flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-purple-600 text-white flex items-center justify-center text-xs font-bold">1</span>
              <span>Identity & Avatar</span>
            </span>
            <span id="mobile-step-fraction" class="text-[11px] font-mono text-purple-300">Step 1 of 4</span>
          </div>
          <!-- Progress bar track -->
          <div class="w-full h-1.5 bg-white/10 rounded-full overflow-hidden">
            <div id="mobile-step-progress-bar" class="h-full bg-gradient-to-r from-purple-500 to-indigo-500 transition-all duration-300 w-1/4"></div>
          </div>
        </div>
      </div>

      <!-- ================= 2-COLUMN LAYOUT (FORM + DESKTOP PREVIEW) ================= -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        
        <!-- Left: Form Steps (7 cols on Desktop) -->
        <div class="lg:col-span-7">
          <form id="character-form" onsubmit="return false;" class="space-y-6">

            <!-- STEP 1: IDENTITY & VISUALS -->
            <div id="step-pane-1" class="step-pane space-y-6">
              <div class="p-5 sm:p-7 rounded-3xl bg-[#080a14] border border-white/[0.08] shadow-xl space-y-5">
                
                <div class="border-b border-white/[0.06] pb-3">
                  <h2 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
                    <ImageIcon class="w-5 h-5 text-purple-400" />
                    <span>Step 1: Basic Identity & Visuals</span>
                  </h2>
                  <p class="text-xs text-slate-400 mt-1 leading-relaxed">
                    Set your character's name, role archetype, portrait, and physical appearance. Form starts clean so you can build from scratch or import anytime.
                  </p>
                </div>

                <!-- Character Name & Title -->
                <div class="space-y-4">
                  <div>
                    <div class="flex items-center justify-between mb-1.5">
                      <label for="char-name" class="text-xs sm:text-sm font-semibold text-slate-200">
                        Character Name <span class="text-purple-400">*</span>
                      </label>
                      <span id="tok-name" class="text-[11px] font-mono text-slate-500">~0 tok</span>
                    </div>
                    <input 
                      id="char-name" 
                      type="text" 
                      placeholder="e.g. Aiko Tanaka, Elena, Julian, Marcus..." 
                      class="w-full px-4 py-3 rounded-2xl bg-white/[0.04] border border-white/10 focus:border-purple-500/70 text-sm sm:text-base text-white placeholder:text-slate-500 outline-none transition"
                      value=""
                    />
                    <p class="text-[11px] text-slate-500 mt-1">The primary name &#123;&#123;user&#125;&#125; and &#123;&#123;char&#125;&#125; will refer to during conversations.</p>
                  </div>

                  <div>
                    <div class="flex items-center justify-between mb-1.5">
                      <label for="char-title" class="text-xs sm:text-sm font-semibold text-slate-200">
                        Title / Role Archetype
                      </label>
                      <span id="tok-title" class="text-[11px] font-mono text-slate-500">~0 tok</span>
                    </div>
                    <input 
                      id="char-title" 
                      type="text" 
                      placeholder="e.g. Quantum Cryptographer, Noir Detective, Astral Guardian..." 
                      class="w-full px-4 py-3 rounded-2xl bg-white/[0.04] border border-white/10 focus:border-purple-500/70 text-sm sm:text-base text-white placeholder:text-slate-500 outline-none transition"
                      value=""
                    />
                    <p class="text-[11px] text-slate-500 mt-1">A brief one-line summary displayed under the name on character cards.</p>
                  </div>
                </div>

                <!-- Category & Tags -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label for="char-category" class="block text-xs sm:text-sm font-semibold text-slate-200 mb-1.5">Category</label>
                    <select 
                      id="char-category" 
                      class="w-full px-4 py-3 rounded-2xl bg-[#0d1020] border border-white/10 focus:border-purple-500/70 text-sm text-white outline-none transition"
                    >
                      <option value="Sci-Fi">Sci-Fi & Cyberpunk</option>
                      <option value="Fantasy">Fantasy & RPG</option>
                      <option value="Mystery">Mystery & Detective</option>
                      <option value="Philosophy">Philosophy & Mentors</option>
                      <option value="Slice of Life">Slice of Life & Companion</option>
                      <option value="Anime & Manga">Anime & Manga</option>
                      <option value="Supernatural">Supernatural & Occult</option>
                    </select>
                  </div>

                  <div>
                    <label for="char-tags" class="block text-xs sm:text-sm font-semibold text-slate-200 mb-1.5">Tags (Comma-separated)</label>
                    <input 
                      id="char-tags" 
                      type="text" 
                      placeholder="e.g. Fantasy, Sci-Fi, Companion, Cyberpunk" 
                      class="w-full px-4 py-3 rounded-2xl bg-white/[0.04] border border-white/10 placeholder:text-slate-500 text-sm text-white outline-none transition"
                      value=""
                    />
                  </div>
                </div>

                <!-- Avatar Selection & Upload (Studio Lighting Presets) -->
                <div class="space-y-3 pt-2">
                  <div class="flex items-center justify-between">
                    <div>
                      <label class="text-xs sm:text-sm font-semibold text-slate-200">Avatar Presets (Studio Neon Dual-Lighting)</label>
                      <p class="text-[11px] text-slate-400">Diverse styles: Asian, Western, Black, Anime & Abstract AI</p>
                    </div>
                    <label for="custom-avatar-file" class="text-xs font-semibold text-purple-400 hover:text-purple-300 cursor-pointer flex items-center gap-1.5">
                      <Upload class="w-3.5 h-3.5" />
                      <span>Upload Image</span>
                    </label>
                    <input id="custom-avatar-file" type="file" accept="image/*" class="hidden" />
                  </div>

                  <!-- Preset Thumbnails Grid (8 Diverse Avatars) -->
                  <div class="grid grid-cols-4 sm:grid-cols-8 gap-2.5">
                    {PRESET_AVATARS.map((preset, idx) => (
                      <button
                        type="button"
                        class={`preset-avatar-btn relative aspect-square rounded-xl overflow-hidden border-2 transition cursor-pointer ${idx === 0 ? 'border-purple-500 ring-2 ring-purple-500/50 shadow-lg shadow-purple-950/60' : 'border-white/10 hover:border-purple-500/60'}`}
                        data-url={preset.url}
                        title={preset.label}
                      >
                        <img src={preset.url} alt={preset.label} class="w-full h-full object-cover transition duration-200" />
                      </button>
                    ))}
                  </div>

                  <!-- Hidden Input storing active image URL -->
                  <input id="char-avatar-url" type="hidden" value={PRESET_AVATARS[0].url} />

                  <!-- Optional Custom Image Link Toggle (Clean & Unobtrusive) -->
                  <div class="flex items-center justify-between pt-0.5">
                    <button 
                      type="button" 
                      id="toggle-url-input-btn"
                      class="text-[11px] text-slate-400 hover:text-purple-400 transition flex items-center gap-1 cursor-pointer"
                    >
                      <span>+ Paste direct image link</span>
                    </button>
                    <span class="text-[10px] text-slate-500">Supports WebP, PNG, JPG</span>
                  </div>

                  <div id="custom-url-container" class="hidden">
                    <input 
                      id="custom-url-input" 
                      type="url" 
                      placeholder="Paste direct image URL (https://...)" 
                      class="w-full px-3.5 py-2 rounded-xl bg-white/[0.04] border border-white/10 text-xs text-slate-200 placeholder:text-slate-500 outline-none focus:border-purple-500/60"
                    />
                  </div>
                </div>

                <!-- Physical Appearance Textarea (Spacious for mobile) -->
                <div>
                  <div class="flex items-center justify-between mb-1.5">
                    <label for="char-appearance" class="text-xs sm:text-sm font-semibold text-slate-200">
                      Physical Appearance & Sensory Cues
                    </label>
                    <span id="tok-appearance" class="text-[11px] font-mono text-slate-500">~0 tok</span>
                  </div>
                  <textarea 
                    id="char-appearance" 
                    rows="4" 
                    class="w-full px-4 py-3 rounded-2xl bg-white/[0.04] border border-white/10 focus:border-purple-500/70 text-sm sm:text-base text-white placeholder:text-slate-500 outline-none leading-relaxed resize-y min-h-[110px]"
                    placeholder="Describe height, eye color, hairstyle, distinct physical traits, clothing style, sensory details, and signature gear (e.g. 5'8'', silver hair tied back, piercing blue eyes, wears a dark tailored coat)..."
                  ></textarea>
                  <p class="text-[11px] text-slate-500 mt-1">Helps the AI describe physical actions, gestures, eye contact, and clothing interaction.</p>
                </div>

                <!-- Persona Certification Badge -->
                <div class="p-4 rounded-2xl bg-purple-950/20 border border-purple-500/20 flex items-start gap-3">
                  <input 
                    id="char-sfw-cert" 
                    type="checkbox" 
                    checked 
                    class="mt-1 rounded text-purple-500 focus:ring-purple-500 bg-white/10 border-white/20 w-4 h-4"
                  />
                  <label for="char-sfw-cert" class="text-xs text-slate-300 cursor-pointer">
                    <strong class="text-purple-300 block mb-0.5">Creative Persona Certification</strong>
                    I certify this persona is designed for interactive storytelling and roleplay simulation.
                  </label>
                </div>

              </div>
            </div>

            <!-- STEP 2: PERSONA, LORE & SCENARIO -->
            <div id="step-pane-2" class="step-pane hidden space-y-6">
              <div class="p-5 sm:p-7 rounded-3xl bg-[#080a14] border border-white/[0.08] shadow-xl space-y-6">
                
                <div class="border-b border-white/[0.06] pb-3">
                  <h2 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
                    <BookOpen class="w-5 h-5 text-cyan-400" />
                    <span>Step 2: Persona, Psychology & Lore</span>
                  </h2>
                  <p class="text-xs text-slate-400 mt-1 leading-relaxed">
                    Define the character's internal thoughts, behavioral patterns, origin story, and meeting setting.
                  </p>
                </div>

                <!-- Personality Summary (Spacious - 6+ lines) -->
                <div>
                  <div class="flex items-center justify-between mb-2">
                    <label for="char-personality" class="text-xs sm:text-sm font-semibold text-slate-200">
                      Personality Profile & Behavioral Traits
                    </label>
                    <span id="tok-personality" class="text-[11px] font-mono text-slate-500">~0 tok</span>
                  </div>
                  
                  <!-- Quick archetype chips -->
                  <div class="flex flex-wrap gap-1.5 mb-2.5">
                    {['Analytical', 'Cynical', 'Enigmatic', 'Protective', 'Stoic', 'Witty', 'Empathetic', 'Rebellious', 'Formal', 'Playful'].map((trait) => (
                      <button 
                        type="button" 
                        class="trait-chip px-2.5 py-1 rounded-lg bg-white/[0.04] hover:bg-cyan-900/30 border border-white/[0.08] hover:border-cyan-500/40 text-xs text-slate-300 hover:text-white transition cursor-pointer"
                        data-trait={trait}
                      >
                        +{trait}
                      </button>
                    ))}
                  </div>

                  <textarea 
                    id="char-personality" 
                    rows="6" 
                    class="w-full px-4 py-3 rounded-2xl bg-white/[0.04] border border-white/10 focus:border-cyan-500/70 text-sm sm:text-base text-white placeholder:text-slate-500 outline-none leading-relaxed resize-y min-h-[150px]"
                    placeholder="Define psychological profile, demeanor, temper, core values, quirks, and emotional triggers (e.g. Calm, analytical, guarded against strangers but deeply protective once trust is formed. Speaks with measured precision)..."
                  ></textarea>
                  <p class="text-[11px] text-slate-500 mt-1">Tip: You can use comma-separated traits or full descriptive paragraphs.</p>
                </div>

                <!-- Backstory Lore (Deep Textarea - 8+ lines) -->
                <div>
                  <div class="flex items-center justify-between mb-2">
                    <label for="char-lore" class="text-xs sm:text-sm font-semibold text-slate-200">
                      Backstory Lore & History
                    </label>
                    <span id="tok-lore" class="text-[11px] font-mono text-slate-500">~0 tok</span>
                  </div>
                  <textarea 
                    id="char-lore" 
                    rows="8" 
                    class="w-full px-4 py-3 rounded-2xl bg-white/[0.04] border border-white/10 focus:border-cyan-500/70 text-sm sm:text-base text-white placeholder:text-slate-500 outline-none leading-relaxed resize-y min-h-[180px]"
