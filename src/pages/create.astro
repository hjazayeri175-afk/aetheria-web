---
import Layout from '../layouts/Layout.astro';
import { 
  ArrowLeft, 
  Sparkles, 
  ShieldCheck, 
  Upload, 
  Download, 
  Save, 
  Eye, 
  MessageSquare, 
  Check, 
  Info,
  Wand2,
  Trash2,
  Send,
  Plus
} from '@lucide/astro';

const PRESET_AVATARS = [
  { label: 'Cyberpunk Netrunner', url: 'https://images.unsplash.com/photo-1578632767115-351597cf2477?w=800&auto=format&fit=crop&q=80' },
  { label: 'Knight of Light', url: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=800&auto=format&fit=crop&q=80' },
  { label: 'Celestial Scholar', url: 'https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=800&auto=format&fit=crop&q=80' },
  { label: 'Noir Detective', url: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=800&auto=format&fit=crop&q=80' },
  { label: 'Android Diplomat', url: 'https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?w=800&auto=format&fit=crop&q=80' },
  { label: 'Shadow Sorceress', url: 'https://images.unsplash.com/photo-1517841905240-472988babdf9?w=800&auto=format&fit=crop&q=80' },
  { label: 'Stoic Philosopher', url: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=800&auto=format&fit=crop&q=80' },
  { label: 'Tea Master & Florist', url: 'https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=800&auto=format&fit=crop&q=80' }
];
---

<Layout title="Character Studio — Craft & Export SFW AI Personas | Aetheria AI">
  <div class="min-h-screen flex flex-col bg-[#070913] text-slate-100">
    
    <!-- Top Studio Header -->
    <header class="h-16 border-b border-white/[0.08] bg-[#090b17]/95 backdrop-blur-xl px-4 sm:px-8 flex items-center justify-between sticky top-0 z-30">
      <div class="flex items-center gap-3 sm:gap-4">
        <a 
          href="/" 
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] text-slate-300 hover:text-white text-xs font-medium transition"
        >
          <ArrowLeft class="w-4 h-4 text-purple-400" />
          <span>Hub</span>
        </a>
        <div class="h-4 w-[1px] bg-white/10 hidden sm:block"></div>
        <div class="flex items-center gap-2">
          <div class="p-1.5 rounded-lg bg-purple-600/20 border border-purple-500/30 text-purple-400">
            <Wand2 class="w-4 h-4" />
          </div>
          <div>
            <h1 class="text-xs sm:text-sm font-bold text-white tracking-wide">Character Creation Studio</h1>
            <p class="text-[10px] text-slate-400 hidden sm:block">Craft, test, and export Tavern V2 compatible SFW personas</p>
          </div>
        </div>
      </div>

      <div class="flex items-center gap-2">
        <span class="hidden md:inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
          <ShieldCheck class="w-3 h-3" />
          <span>SFW Verified Standard</span>
        </span>
        <button 
          id="export-tavern-btn"
          type="button" 
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/[0.05] hover:bg-white/[0.1] border border-white/[0.1] text-xs font-semibold text-slate-200 hover:text-white transition cursor-pointer"
          title="Download Tavern V2 JSON Card"
        >
          <Download class="w-3.5 h-3.5 text-cyan-400" />
          <span>Export V2</span>
        </button>
        <button 
          id="save-character-btn"
          type="button" 
          class="flex items-center gap-1.5 px-4 py-1.5 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-xs font-semibold text-white shadow-md shadow-purple-900/30 transition cursor-pointer active:scale-95"
        >
          <Save class="w-3.5 h-3.5" />
          <span>Save Persona</span>
        </button>
      </div>
    </header>

    <!-- Main Studio Grid -->
    <main class="flex-1 max-w-7xl w-full mx-auto p-4 sm:p-6 lg:p-8 grid grid-cols-1 lg:grid-cols-12 gap-6 lg:gap-8">
      
      <!-- Left Column: Form Editor (8 cols on large screens) -->
      <div class="lg:col-span-7 space-y-6">
        
        <!-- Step 1: Core Identity -->
        <div class="p-5 sm:p-6 rounded-2xl sm:rounded-3xl bg-[#090b17] border border-white/[0.08] shadow-lg space-y-4">
          <div class="flex items-center justify-between border-b border-white/[0.06] pb-3">
            <h2 class="text-sm font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-purple-600/30 text-purple-400 flex items-center justify-center text-xs font-bold">1</span>
              <span>Identity & Archetype</span>
            </h2>
            <span class="text-[10px] text-slate-500">Public profile details</span>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div>
              <label for="char-name" class="block text-xs font-semibold text-slate-300 mb-1.5">Character Name</label>
              <input 
                id="char-name" 
                type="text" 
                placeholder="e.g. Aurelia Vance" 
                class="w-full px-3.5 py-2.5 rounded-xl bg-white/[0.04] border border-white/10 focus:border-purple-500/60 text-xs sm:text-sm text-white outline-none transition"
                value="Aurelia Vance"
              />
            </div>
            <div>
              <label for="char-title" class="block text-xs font-semibold text-slate-300 mb-1.5">Tagline / Role</label>
              <input 
                id="char-title" 
                type="text" 
                placeholder="e.g. Sub-orbital Flight Pilot" 
                class="w-full px-3.5 py-2.5 rounded-xl bg-white/[0.04] border border-white/10 focus:border-purple-500/60 text-xs sm:text-sm text-white outline-none transition"
                value="Quantum Cryptographer & Archival Scribe"
              />
            </div>
          </div>

          <!-- Category Selection -->
          <div>
            <label for="char-category" class="block text-xs font-semibold text-slate-300 mb-1.5">Category</label>
            <select 
              id="char-category" 
              class="w-full px-3.5 py-2.5 rounded-xl bg-[#0d1020] border border-white/10 focus:border-purple-500/60 text-xs sm:text-sm text-white outline-none transition"
            >
              <option value="Sci-Fi">Sci-Fi & Cyberpunk</option>
              <option value="Fantasy">Fantasy & RPG</option>
              <option value="Mystery">Mystery & Detective</option>
              <option value="Philosophy">Philosophy & Mentors</option>
              <option value="Slice of Life">Slice of Life & Cafe</option>
              <option value="Anime & Manga">Anime & Manga</option>
              <option value="Supernatural">Supernatural & Occult</option>
            </select>
          </div>

          <!-- Avatar Selector -->
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-2">Preset SFW High-Res Avatars</label>
            <div class="grid grid-cols-4 sm:grid-cols-8 gap-2 mb-3">
              {PRESET_AVATARS.map((preset, index) => (
                <button
                  type="button"
                  class="preset-avatar-btn relative aspect-square rounded-xl overflow-hidden border-2 border-white/10 hover:border-purple-500 focus:border-purple-500 transition cursor-pointer"
                  data-url={preset.url}
                  title={preset.label}
                >
                  <img src={preset.url} alt={preset.label} class="w-full h-full object-cover" />
                </button>
              ))}
            </div>
            <div class="flex items-center gap-2">
              <input 
                id="char-avatar-url" 
                type="url" 
                placeholder="Or paste custom image URL..." 
                class="flex-1 px-3.5 py-2 rounded-xl bg-white/[0.04] border border-white/10 text-xs text-white placeholder:text-slate-500 outline-none"
                value={PRESET_AVATARS[0].url}
              />
            </div>
          </div>

          <!-- SFW Compliance Checkbox -->
          <div class="p-3.5 rounded-xl bg-purple-950/20 border border-purple-500/20 flex items-start gap-2.5">
            <input 
              id="char-sfw-cert" 
              type="checkbox" 
              checked 
              class="mt-0.5 rounded text-purple-600 focus:ring-purple-500 bg-white/10 border-white/20"
            />
            <label for="char-sfw-cert" class="text-[11px] text-slate-300 cursor-pointer">
              <span class="font-semibold text-purple-300 block">SFW Standard Certification</span>
              I certify this character portrays an adult (18+) and adheres to wholesome storytelling, adventuring, and conversational companion standards.
            </label>
          </div>
        </div>

        <!-- Step 2: Persona & Lore -->
        <div class="p-5 sm:p-6 rounded-2xl sm:rounded-3xl bg-[#090b17] border border-white/[0.08] shadow-lg space-y-4">
          <div class="flex items-center justify-between border-b border-white/[0.06] pb-3">
            <h2 class="text-sm font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <span class="w-5 h-5 rounded-full bg-purple-600/30 text-purple-400 flex items-center justify-center text-xs font-bold">2</span>
              <span>Persona & Opening Greeting</span>
            </h2>
            <span class="text-[10px] text-slate-500">Behavior & Dialogue</span>
          </div>

          <!-- Opening Greeting -->
          <div>
            <div class="flex items-center justify-between mb-1.5">
              <label for="char-greeting" class="text-xs font-semibold text-slate-300">
                Opening First Message
              </label>
              <span class="text-[10px] text-slate-500 font-mono">Use *actions* for roleplay gestures</span>
            </div>
            <textarea 
              id="char-greeting" 
              rows="4" 
              class="w-full px-3.5 py-2.5 rounded-xl bg-white/[0.04] border border-white/10 focus:border-purple-500/60 text-xs sm:text-sm text-white placeholder:text-slate-500 outline-none leading-relaxed resize-none"
              placeholder="*Adjusts holo-terminal display.* Welcome to the node. What archive are you seeking to decrypt today?"
            >*Adjusts holo-terminal display, glowing neon symbols casting reflections in her optics.* Welcome to the secure node. What archive are you seeking to decrypt today?</textarea>
          </div>

          <!-- Personality & Tags -->
          <div>
            <label for="char-tags" class="block text-xs font-semibold text-slate-300 mb-1.5">
              Personality Tags (comma-separated)
            </label>
            <input 
              id="char-tags" 
              type="text" 
              placeholder="Cyberpunk, Netrunner, Analytical, Stoic, Tech" 
              class="w-full px-3.5 py-2.5 rounded-xl bg-white/[0.04] border border-white/10 text-xs sm:text-sm text-white outline-none"
              value="Cyberpunk, Netrunner, Analytical, Stoic, Tech"
            />
          </div>

          <!-- Backstory Lore -->
          <div>
            <label for="char-lore" class="block text-xs font-semibold text-slate-300 mb-1.5">
              Character Lore & System Context
            </label>
            <textarea 
              id="char-lore" 
              rows="3" 
              class="w-full px-3.5 py-2.5 rounded-xl bg-white/[0.04] border border-white/10 text-xs sm:text-sm text-white outline-none leading-relaxed resize-none"
              placeholder="Background history, scenario setup, and behavioral instructions..."
            >Former top cryptographic researcher who went rogue to preserve lost cultural archives. Sharp-witted, skeptical of megacorporations, but deeply loyal to trusted companions.</textarea>
          </div>

          <!-- Starter Prompts -->
          <div>
            <label class="block text-xs font-semibold text-slate-300 mb-1.5">
              Conversation Starter Prompts (Up to 3)
            </label>
            <div class="space-y-2">
              <input id="starter-1" type="text" class="w-full px-3 py-2 rounded-xl bg-white/[0.04] border border-white/10 text-xs text-white" value="What secrets are hidden in the archive?" />
              <input id="starter-2" type="text" class="w-full px-3 py-2 rounded-xl bg-white/[0.04] border border-white/10 text-xs text-white" value="Can you bypass corporate surveillance?" />
              <input id="starter-3" type="text" class="w-full px-3 py-2 rounded-xl bg-white/[0.04] border border-white/10 text-xs text-white" value="Why did you abandon your post?" />
            </div>
          </div>
        </div>

      </div>

      <!-- Right Column: Live Card Preview & Sandbox (5 cols on large screens) -->
      <div class="lg:col-span-5 space-y-6">
        
        <!-- Live Visual Card Preview -->
        <div class="p-5 rounded-2xl sm:rounded-3xl bg-[#090b17] border border-white/[0.08] shadow-lg sticky top-20">
          <div class="flex items-center justify-between border-b border-white/[0.06] pb-3 mb-4">
            <h3 class="text-xs font-bold text-white uppercase tracking-wider flex items-center gap-2">
              <Eye class="w-4 h-4 text-purple-400" />
              <span>Real-Time Card Preview</span>
            </h3>
            <span class="text-[10px] text-emerald-400 font-medium">● Live</span>
          </div>

          <!-- Mock Card -->
          <div class="rounded-2xl overflow-hidden bg-[#0c0e17] border border-purple-500/40 shadow-2xl shadow-purple-950/50 max-w-sm mx-auto">
            <div class="relative aspect-[3/4] w-full overflow-hidden bg-slate-900">
              <img 
                id="preview-img" 
                src={PRESET_AVATARS[0].url} 
                alt="Preview" 
                class="w-full h-full object-cover" 
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#0c0e17] via-[#0c0e17]/30 to-transparent"></div>
              
              <!-- Category Pill -->
              <div class="absolute top-3 left-3">
                <span id="preview-cat" class="px-2.5 py-1 rounded-full text-[10px] font-semibold bg-black/60 backdrop-blur-md text-purple-300 border border-purple-500/30 shadow-md">
                  Sci-Fi
                </span>
              </div>

              <!-- Rating Badge -->
              <div class="absolute top-3 right-3 flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-bold bg-black/60 backdrop-blur-md text-amber-400 border border-white/10 shadow-md">
                <span>★ 5.0</span>
              </div>

              <!-- Character Details overlay -->
              <div class="absolute bottom-3 left-3 right-3 space-y-1.5">
                <h4 id="preview-name" class="text-base font-bold text-white tracking-wide">
                  Aurelia Vance
                </h4>
                <p id="preview-title" class="text-xs text-purple-300 font-medium line-clamp-1">
                  Quantum Cryptographer & Archival Scribe
                </p>
                <div id="preview-tags" class="flex flex-wrap gap-1 pt-1">
                  <span class="px-1.5 py-0.5 rounded bg-white/[0.08] text-[9px] text-slate-300">#Cyberpunk</span>
                  <span class="px-1.5 py-0.5 rounded bg-white/[0.08] text-[9px] text-slate-300">#Netrunner</span>
                </div>
              </div>
            </div>

            <!-- Greeting Preview Snippet -->
            <div class="p-3.5 bg-[#090b14] border-t border-white/[0.06] text-xs text-slate-300">
              <p class="text-[10px] text-purple-400 uppercase font-semibold mb-1">First Message Snippet:</p>
              <p id="preview-snippet" class="text-[11px] text-slate-400 line-clamp-2 italic leading-relaxed">
                *Adjusts holo-terminal display...*
              </p>
            </div>
          </div>

          <!-- Confirmation Notification Box -->
          <div id="status-toast" class="hidden mt-4 p-3 rounded-xl bg-purple-900/40 border border-purple-500/40 text-xs text-purple-200 flex items-center gap-2">
            <Check class="w-4 h-4 text-emerald-400 shrink-0" />
            <span id="toast-text">Character saved successfully!</span>
          </div>
        </div>

      </div>

    </main>
  </div>
</Layout>

<script>
  // Elements
  const nameInput = document.getElementById('char-name') as HTMLInputElement;
  const titleInput = document.getElementById('char-title') as HTMLInputElement;
  const catInput = document.getElementById('char-category') as HTMLSelectElement;
  const avatarInput = document.getElementById('char-avatar-url') as HTMLInputElement;
  const greetingInput = document.getElementById('char-greeting') as HTMLTextAreaElement;
  const tagsInput = document.getElementById('char-tags') as HTMLInputElement;
  const loreInput = document.getElementById('char-lore') as HTMLTextAreaElement;
  const starter1 = document.getElementById('starter-1') as HTMLInputElement;
  const starter2 = document.getElementById('starter-2') as HTMLInputElement;
  const starter3 = document.getElementById('starter-3') as HTMLInputElement;

  // Preview elements
  const previewImg = document.getElementById('preview-img') as HTMLImageElement;
  const previewCat = document.getElementById('preview-cat') as HTMLElement;
  const previewName = document.getElementById('preview-name') as HTMLElement;
  const previewTitle = document.getElementById('preview-title') as HTMLElement;
  const previewTags = document.getElementById('preview-tags') as HTMLElement;
  const previewSnippet = document.getElementById('preview-snippet') as HTMLElement;
  const statusToast = document.getElementById('status-toast') as HTMLElement;
  const toastText = document.getElementById('toast-text') as HTMLElement;

  // Action buttons
  const saveBtn = document.getElementById('save-character-btn');
  const exportBtn = document.getElementById('export-tavern-btn');
  const presetBtns = document.querySelectorAll('.preset-avatar-btn');

  function updatePreview() {
    if (previewName && nameInput) previewName.textContent = nameInput.value || 'Unnamed Persona';
    if (previewTitle && titleInput) previewTitle.textContent = titleInput.value || 'No Title';
    if (previewCat && catInput) previewCat.textContent = catInput.value;
    if (previewImg && avatarInput) previewImg.src = avatarInput.value;
    if (previewSnippet && greetingInput) previewSnippet.textContent = greetingInput.value || 'No greeting set.';
    
    if (previewTags && tagsInput) {
      const tags = tagsInput.value.split(',').map(t => t.trim()).filter(Boolean);
      previewTags.innerHTML = tags.slice(0, 3).map(t => `<span class="px-1.5 py-0.5 rounded bg-white/[0.08] text-[9px] text-slate-300">#${t}</span>`).join('');
    }
  }

  // Bind live updates
  [nameInput, titleInput, catInput, avatarInput, greetingInput, tagsInput].forEach(el => {
    el?.addEventListener('input', updatePreview);
  });

  // Preset avatar click
  presetBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const url = btn.getAttribute('data-url');
      if (url && avatarInput) {
        avatarInput.value = url;
        updatePreview();
      }
    });
  });

  function showToast(msg: string) {
    if (toastText && statusToast) {
      toastText.textContent = msg;
      statusToast.classList.remove('hidden');
      setTimeout(() => {
        statusToast.classList.add('hidden');
      }, 3000);
    }
  }

  // Save Character to LocalStorage
  saveBtn?.addEventListener('click', () => {
    const characterData = {
      id: (nameInput.value || 'custom-character').toLowerCase().replace(/[^a-z0-9]+/g, '-'),
      name: nameInput.value || 'Unnamed Persona',
      title: titleInput.value || 'Companion',
      category: catInput.value,
      avatarUrl: avatarInput.value,
      greeting: greetingInput.value,
      tags: tagsInput.value.split(',').map(t => t.trim()).filter(Boolean),
      description: loreInput.value,
      starterPrompts: [starter1.value, starter2.value, starter3.value].filter(Boolean),
      rating: '5.0',
      chatsCount: '1',
      isCustom: true
    };

    const existing = JSON.parse(localStorage.getItem('aetheria_custom_characters') || '[]');
    existing.push(characterData);
    localStorage.setItem('aetheria_custom_characters', JSON.stringify(existing));

    showToast(`"${characterData.name}" saved! Available in your local hub.`);
  });

  // Export Tavern Card V2 (Community Standard JSON)
  exportBtn?.addEventListener('click', () => {
    const tavernCardV2 = {
      spec: 'chara_card_v2',
      spec_version: '2.0',
      data: {
        name: nameInput.value || 'Unnamed Persona',
        description: loreInput.value,
        personality: tagsInput.value,
        scenario: `Roleplay encounter with ${nameInput.value}`,
        first_mes: greetingInput.value,
        mes_example: '',
        creator_notes: 'Created via Aetheria AI Character Studio. Strict SFW standard.',
        system_prompt: 'Portray the character consistently. Adhere to wholesome, engaging SFW interactions.',
        post_history_instructions: '',
        alternate_greetings: [],
        character_book: null,
        tags: tagsInput.value.split(',').map(t => t.trim()).filter(Boolean),
        creator: 'Aetheria Creator',
        character_version: '1.0'
      }
    };

    const blob = new Blob([JSON.stringify(tavernCardV2, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${(nameInput.value || 'character').toLowerCase().replace(/[^a-z0-9]+/g, '-')}-card.json`;
    a.click();
    URL.revokeObjectURL(url);

    showToast('Tavern V2 Card JSON downloaded!');
  });

  // Initial preview sync
  updatePreview();
</script>
