  // ================= CALCULATION & PREVIEW SYNC =================
  function updateAllCalculations() {
    // 1. Calculate individual badge tokens
    const tokName = estimateTokens(nameInput?.value || '');
    const tokTitle = estimateTokens(titleInput?.value || '');
    const tokApp = estimateTokens(appearanceInput?.value || '');
    const tokPers = estimateTokens(personalityInput?.value || '');
    const tokLore = estimateTokens(loreInput?.value || '');
    const tokScen = estimateTokens(scenarioInput?.value || '');
    const tokSpeech = estimateTokens(speechInput?.value || '');
    const tokGreet = estimateTokens(greetingInput?.value || '');
    const tokAltGreet = estimateTokens(altGreetingInput?.value || '');
    const tokMesEx = estimateTokens(mesExampleInput?.value || '');
    const tokSys = estimateTokens(sysPromptInput?.value || '');

    // Update mini badges
    const setBadge = (id: string, count: number) => {
      const el = document.getElementById(id);
      if (el) el.textContent = `~${count} tok`;
    };
    setBadge('tok-name', tokName);
    setBadge('tok-title', tokTitle);
    setBadge('tok-appearance', tokApp);
    setBadge('tok-personality', tokPers);
    setBadge('tok-lore', tokLore);
    setBadge('tok-scenario', tokScen);
    setBadge('tok-speech', tokSpeech);
    setBadge('tok-greeting', tokGreet);
    setBadge('tok-alt-greeting', tokAltGreet);
    setBadge('tok-mes-example', tokMesEx);
    setBadge('tok-system-prompt', tokSys);

    // Lorebook total tokens
    let loreTokens = 0;
    loreEntries.forEach(en => {
      loreTokens += estimateTokens(en.content);
    });

    // Permanent Tokens: System Prompt + Personality + Backstory + Appearance + Scenario + Lorebook
    const permanentTokens = tokSys + tokPers + tokLore + tokApp + tokScen + tokSpeech + loreTokens;
    // Dynamic Tokens: Greeting + Alt Greeting + Examples
    const dynamicTokens = tokGreet + tokAltGreet + tokMesEx;
    const totalTokens = permanentTokens + dynamicTokens;

    if (hudPermTokens) hudPermTokens.textContent = `~${permanentTokens}`;
    if (hudDynTokens) hudDynTokens.textContent = `~${dynamicTokens}`;
    if (hudLoreTokens) hudLoreTokens.textContent = `~${loreTokens}`;
    if (hudTotalTokens) hudTotalTokens.textContent = `~${totalTokens} / 4096`;
    if (previewTokenSummary) previewTokenSummary.textContent = `~${totalTokens} tok`;

    // Health badge
    if (tokenHealthBadge) {
      if (permanentTokens < 1000) {
        tokenHealthBadge.textContent = 'Optimal (<1k)';
        tokenHealthBadge.className = 'px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-950/60 border border-emerald-500/40 text-emerald-300';
      } else if (permanentTokens < 1800) {
        tokenHealthBadge.textContent = 'Standard (1k-1.8k)';
        tokenHealthBadge.className = 'px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-950/60 border border-amber-500/40 text-amber-300';
      } else {
        tokenHealthBadge.textContent = 'Heavy (>1.8k)';
        tokenHealthBadge.className = 'px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-950/60 border border-rose-500/40 text-rose-300';
      }
    }

    // 2. Update Desktop & Mobile Card Previews
    const nameVal = nameInput?.value.trim() || 'Your Character Name';
    const titleVal = titleInput?.value.trim() || 'Role Archetype & Title';
    const catVal = catInput?.value || 'Sci-Fi';
    const avatarVal = avatarInput?.value || AVATAR_PRESETS[0].url;
    const greetVal = greetingInput?.value.trim() || "Type your character's opening greeting in Step 4 to preview it here...";

    if (previewName) previewName.textContent = nameVal;
    if (previewTitle) previewTitle.textContent = titleVal;
    if (previewCat) previewCat.textContent = catVal;
    if (previewImg) previewImg.src = avatarVal;
    if (previewSnippet) {
      previewSnippet.textContent = greetVal;
      if (!greetingInput?.value.trim()) {
        previewSnippet.className = 'text-[11px] text-slate-500 line-clamp-3 leading-relaxed italic';
      } else {
        previewSnippet.className = 'text-[11px] text-slate-300 line-clamp-3 leading-relaxed';
      }
    }

    // Mobile drawer sync
    if (mobilePreviewName) mobilePreviewName.textContent = nameVal;
    if (mobilePreviewTitle) mobilePreviewTitle.textContent = titleVal;
    if (mobilePreviewImg) mobilePreviewImg.src = avatarVal;
    if (mobilePreviewSnippet) {
      mobilePreviewSnippet.textContent = greetVal;
      if (!greetingInput?.value.trim()) {
        mobilePreviewSnippet.className = 'text-[11px] text-slate-500 line-clamp-3 leading-relaxed mt-1 italic';
      } else {
        mobilePreviewSnippet.className = 'text-[11px] text-slate-300 line-clamp-3 leading-relaxed mt-1';
      }
    }

    if (previewTags && tagsInput) {
      const tags = tagsInput.value.split(',').map(t => t.trim()).filter(Boolean);
      if (tags.length > 0) {
        previewTags.innerHTML = tags.slice(0, 3).map(t => `<span class="px-1.5 py-0.5 rounded bg-white/[0.08] text-[9px] text-slate-300">#${t}</span>`).join('');
      } else {
        previewTags.innerHTML = `<span class="px-1.5 py-0.5 rounded bg-white/[0.08] text-[9px] text-slate-400">#Companion</span><span class="px-1.5 py-0.5 rounded bg-white/[0.08] text-[9px] text-slate-400">#RPG</span>`;
      }
    }

    // 3. Update Raw JSON Inspector
    updateRawJsonViewer();
  }

