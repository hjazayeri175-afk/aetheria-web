        previewTags.innerHTML = tags.slice(0, 3).map(t => `<span class="px-1.5 py-0.5 rounded bg-white/[0.08] text-[9px] text-slate-300">#${t}</span>`).join('');
      } else {
        previewTags.innerHTML = `<span class="px-1.5 py-0.5 rounded bg-white/[0.08] text-[9px] text-slate-400">#Companion</span><span class="px-1.5 py-0.5 rounded bg-white/[0.08] text-[9px] text-slate-400">#RPG</span>`;
      }
    }

    // 3. Update Raw JSON Inspector
    updateRawJsonViewer();
  }

