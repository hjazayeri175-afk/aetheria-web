<script>
  // ================= STEP WIZARD LOGIC =================
  let currentStep = 1;
  const totalSteps = 4;

  const stepTitles = [
    'Identity & Card',
    'Persona & Lore',
    'World Info (Lorebook)',
    'Dialogue & Rules'
  ];

  const stepPanes = [
    document.getElementById('step-pane-1'),
    document.getElementById('step-pane-2'),
    document.getElementById('step-pane-3'),
    document.getElementById('step-pane-4')
  ];

  const desktopStepBtns = document.querySelectorAll('.step-tab-btn');
  const prevStepBtn = document.getElementById('prev-step-btn');
  const nextStepBtn = document.getElementById('next-step-btn');
  const nextBtnText = document.getElementById('next-btn-text');
  const nextBtnIcon = document.getElementById('next-btn-icon');
  
  const mobileStepTitle = document.getElementById('mobile-step-title');
  const mobileStepFraction = document.getElementById('mobile-step-fraction');
  const mobileStepProgressBar = document.getElementById('mobile-step-progress-bar');

  function updateStepUI(step: number) {
    currentStep = step;

    // 1. Show/hide panes
    stepPanes.forEach((pane, idx) => {
      if (pane) {
        if (idx + 1 === currentStep) {
          pane.classList.remove('hidden');
        } else {
          pane.classList.add('hidden');
        }
      }
    });

    // 2. Update Desktop Stepper
    desktopStepBtns.forEach((btn, idx) => {
      const stepIdx = idx + 1;
      const numSpan = btn.querySelector('.step-num') as HTMLElement;
      
      if (stepIdx === currentStep) {
        btn.className = 'step-tab-btn text-left p-3 rounded-2xl border transition-all cursor-pointer bg-purple-950/30 border-purple-500/50 text-white shadow-md shadow-purple-950/30';
        if (numSpan) numSpan.className = 'step-num w-5 h-5 rounded-full bg-purple-600 text-white flex items-center justify-center text-xs font-bold';
      } else if (stepIdx < currentStep) {
        btn.className = 'step-tab-btn text-left p-3 rounded-2xl border transition-all cursor-pointer bg-emerald-950/20 border-emerald-500/30 text-emerald-200';
        if (numSpan) {
          numSpan.className = 'step-num w-5 h-5 rounded-full bg-emerald-600 text-white flex items-center justify-center text-xs font-bold';
          numSpan.innerHTML = '✓';
        }
      } else {
        btn.className = 'step-tab-btn text-left p-3 rounded-2xl border transition-all cursor-pointer bg-white/[0.02] border-white/[0.06] text-slate-400 hover:text-slate-200 hover:bg-white/[0.04]';
        if (numSpan) {
          numSpan.className = 'step-num w-5 h-5 rounded-full bg-white/10 text-slate-300 flex items-center justify-center text-xs font-bold';
          numSpan.innerHTML = String(stepIdx);
        }
      }
    });

    // 3. Update Mobile Stepper
    if (mobileStepTitle) {
      mobileStepTitle.innerHTML = `
        <span class="w-5 h-5 rounded-full bg-purple-600 text-white flex items-center justify-center text-xs font-bold">${currentStep}</span>
        <span>${stepTitles[currentStep - 1]}</span>
      `;
    }
    if (mobileStepFraction) {
      mobileStepFraction.textContent = `Step ${currentStep} of ${totalSteps}`;
    }
    if (mobileStepProgressBar) {
      mobileStepProgressBar.style.width = `${(currentStep / totalSteps) * 100}%`;
    }

    // 4. Update Navigation Buttons
    if (prevStepBtn) {
