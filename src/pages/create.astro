    // If starterPrompts are empty, add default starter prompts
    if (characterData.starterPrompts.length === 0) {
      characterData.starterPrompts = [
        `*Looks at ${charName}* "Tell me more about yourself."`,
        `*Smiles softly* "What should we do next?"`,
        `"What are your thoughts on this?"`
      ];
    }

    const idx = existing.findIndex((c: any) => c && c.id === characterData.id);
    if (idx !== -1) {
      existing[idx] = characterData;
    } else {
      existing.push(characterData);
    }

    // Keep up to 60 characters
    if (existing.length > 60) {
      existing = existing.slice(-60);
    }

    try {
      localStorage.setItem('aetheria_custom_characters', JSON.stringify(existing));
    } catch (storageErr) {
      console.warn('LocalStorage save failed, attempting avatar compression:', storageErr);
      try {
        existing = existing.map(c => ({
          ...c,
          avatarUrl: (c.avatarUrl && c.avatarUrl.length > 60000) ? AVATAR_PRESETS[0].url : c.avatarUrl
        }));
        localStorage.setItem('aetheria_custom_characters', JSON.stringify(existing));
      } catch(e) {
        console.error('Final storage save failure:', e);
      }
    }

    return characterData;
  }

  // ================= EXPORT TAVERN CARD V2 (JSON) =================
  exportBtn?.addEventListener('click', () => {
    const tavernCardV2 = generateTavernCardObject();
    const blob = new Blob([JSON.stringify(tavernCardV2, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${(nameInput.value.trim() || 'character').toLowerCase().replace(/[^a-z0-9]+/g, '-')}-card.json`;
    a.click();
    URL.revokeObjectURL(url);

    showToast('Tavern V2 Card JSON exported with World Info!');
  });

  // Sanitize bloated legacy storage
  function sanitizeCustomCharactersStorage() {
    try {
      const raw = localStorage.getItem('aetheria_custom_characters');
      if (!raw) return;
      const list = JSON.parse(raw);
      if (!Array.isArray(list) || list.length === 0) return;

      let modified = false;
      list.forEach((c: any) => {
        if (c.avatarUrl && c.avatarUrl.startsWith('data:image') && c.avatarUrl.length > 50000) {
          compressImageToThumbnail(c.avatarUrl, 320).then(comp => {
            c.avatarUrl = comp;
            try {
              localStorage.setItem('aetheria_custom_characters', JSON.stringify(list));
            } catch(e) {}
          });
          modified = true;
        }
      });
    } catch(e) {}
  }
  sanitizeCustomCharactersStorage();

  // Initial render
  renderLoreEntries();
  updateStepUI(1);
  updateAllCalculations();
</script>
