    // ==========================================
    // POWER SAVING & PERFORMANCE CONTROLLER
    // ==========================================
    function syncPowerSavingUI() {
      const ps = (window as any).AetheriaPowerSaving;
      if (!ps) return;
      const settings = ps.getSettings();

      // Master Toggle & Banner
      const tMaster = document.getElementById('toggle-master-power-saving') as HTMLInputElement;
      const banner = document.getElementById('master-power-banner');
      const badgeMaster = document.getElementById('badge-master-status');
      const badgeStatus = document.getElementById('power-badge-status');
      const badgeDot = document.getElementById('power-badge-dot');
      const badgeText = document.getElementById('power-badge-text');
      const hubSummary = document.getElementById('hub-power-summary');
      const hubPill = document.getElementById('hub-power-pill');

      if (tMaster) tMaster.checked = Boolean(settings.master);

      if (badgeMaster) {
        if (settings.master) {
          badgeMaster.textContent = '⚡ High Efficiency';
          badgeMaster.className = 'whitespace-nowrap shrink-0 px-2.5 py-0.5 text-[11px] font-bold rounded-md bg-amber-500/20 text-amber-300 border border-amber-500/40 shadow-xs tracking-wider transition-colors';
        } else {
          badgeMaster.textContent = 'Standby';
          badgeMaster.className = 'whitespace-nowrap shrink-0 px-2.5 py-0.5 text-[11px] font-bold rounded-md bg-white/5 text-slate-400 border border-white/10 tracking-wider transition-colors';
        }
      }

      if (settings.master) {
        if (banner) banner.classList.remove('hidden');
        if (badgeStatus) {
          badgeStatus.className = 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-amber-500/15 text-amber-300 border border-amber-500/40 shadow-xs';
        }
        if (badgeDot) badgeDot.className = 'w-2 h-2 rounded-full bg-amber-400 animate-pulse';
        if (badgeText) badgeText.textContent = 'Battery Saver Active';
        if (hubSummary) hubSummary.textContent = 'Ultra-efficiency mode active (All throttled)';
        if (hubPill) {
          hubPill.textContent = 'Saver Active';
          hubPill.className = 'text-[10px] px-1.5 py-0.5 rounded-md font-bold bg-amber-500/20 text-amber-300 border border-amber-500/40';
        }
      } else {
        if (banner) banner.classList.add('hidden');
        const anyActive = settings.disable3D || settings.disableGlows || settings.deepDarkOLED || settings.freezeAvatars || settings.disableSounds || settings.pauseVoiceAutoPlay || settings.throttleBackground;
        if (badgeStatus) {
          badgeStatus.className = 'inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-xs font-bold bg-white/5 text-slate-300 border border-white/10';
        }
        if (badgeDot) badgeDot.className = anyActive ? 'w-2 h-2 rounded-full bg-cyan-400' : 'w-2 h-2 rounded-full bg-slate-400';
        if (badgeText) badgeText.textContent = anyActive ? 'Custom Profile' : 'Standard Performance';
        if (hubSummary) hubSummary.textContent = anyActive ? 'Custom power optimizations enabled' : 'Balanced (Full 3D & visual effects)';
        if (hubPill) {
          hubPill.textContent = anyActive ? 'Custom' : 'Balanced';
          hubPill.className = anyActive 
            ? 'text-[10px] px-1.5 py-0.5 rounded-md font-bold bg-purple-500/20 text-purple-300 border border-purple-500/30'
            : 'text-[10px] px-1.5 py-0.5 rounded-md font-bold bg-white/5 text-slate-400 border border-white/10';
        }
      }

      // Sub-toggles
      const subToggles: { id: string; key: string; badgeId: string; activeText: string; inactiveText: string }[] = [
        { id: 'toggle-disable-3d', key: 'disable3D', badgeId: 'badge-3d-status', activeText: '2D Flat', inactiveText: '3D Active' },
        { id: 'toggle-disable-glows', key: 'disableGlows', badgeId: 'badge-glows-status', activeText: 'FX Muted', inactiveText: 'FX On' },
        { id: 'toggle-deep-dark-oled', key: 'deepDarkOLED', badgeId: 'badge-oled-status', activeText: 'Pure #000000', inactiveText: 'Default Theme' },
        { id: 'toggle-freeze-avatars', key: 'freezeAvatars', badgeId: 'badge-avatars-status', activeText: 'Frozen', inactiveText: 'Animated' },
        { id: 'toggle-disable-sounds', key: 'disableSounds', badgeId: 'badge-sounds-status', activeText: 'Muted', inactiveText: 'Sounds On' },
        { id: 'toggle-pause-voice-autoplay', key: 'pauseVoiceAutoPlay', badgeId: 'badge-voice-status', activeText: 'Manual Tap', inactiveText: 'Auto-Play' },
        { id: 'toggle-throttle-background', key: 'throttleBackground', badgeId: 'badge-throttle-status', activeText: 'Throttled', inactiveText: 'Normal' }
      ];

      subToggles.forEach(item => {
        const toggleEl = document.getElementById(item.id) as HTMLInputElement;
        const badgeEl = document.getElementById(item.badgeId);
        const isChecked = Boolean(settings[item.key]);

        if (toggleEl) {
          toggleEl.checked = isChecked;
        }

        if (badgeEl) {
          badgeEl.textContent = isChecked ? item.activeText : item.inactiveText;
          if (isChecked) {
            badgeEl.className = 'whitespace-nowrap shrink-0 px-2.5 py-0.5 text-[11px] rounded-md font-bold bg-amber-500/20 text-amber-300 border border-amber-500/40 shadow-xs transition-colors';
