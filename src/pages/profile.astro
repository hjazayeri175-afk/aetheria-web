        const btnRemoveBadge = document.getElementById('btn-remove-badge');
        const inputBadgeSearch = document.getElementById('input-badge-search') as HTMLInputElement | null;
        const btnClearBadgeSearch = document.getElementById('btn-clear-badge-search');
        const gridBadgesDisplay = document.getElementById('grid-badges-display');
        const badgePickerCount = document.getElementById('badge-picker-count');
        const wrapperBadgePickerContainer = document.getElementById('wrapper-badge-picker-container');

        // 8 Solids (Row 1)
        const SOLID_COLORS = [
          { id: 'deep-blue', name: 'Deep Blue', value: '#2563eb' },
          { id: 'forest-green', name: 'Forest Green', value: '#16a34a' },
          { id: 'amber', name: 'Amber', value: '#f59e0b' },
          { id: 'coral', name: 'Coral', value: '#f97316' },
          { id: 'purple', name: 'Purple', value: '#a855f7' },
          { id: 'cyan', name: 'Cyan', value: '#06b6d4' },
          { id: 'ruby-red', name: 'Ruby Red', value: '#e11d48' },
          { id: 'muted-slate', name: 'Muted Slate', value: '#94a3b8' }
        ];

        // 8 Dual Gradients with 45-deg diagonal split swatch (Row 2)
        const GRADIENT_COLORS = [
          { id: 'cyan-blue', name: 'Cyan / Blue', value: 'linear-gradient(135deg, #06b6d4 0%, #3b82f6 100%)', split: 'linear-gradient(135deg, #06b6d4 0%, #06b6d4 50%, #3b82f6 50%, #3b82f6 100%)' },
          { id: 'lime-green', name: 'Lime / Green', value: 'linear-gradient(135deg, #84cc16 0%, #10b981 100%)', split: 'linear-gradient(135deg, #84cc16 0%, #84cc16 50%, #10b981 50%, #10b981 100%)' },
