    // Verify & Continue Button
    document.getElementById('btn-verify-geo-otp')?.addEventListener('click', async () => {
      const modal = document.getElementById('geo-shift-challenge-modal');
      const otpInput = document.getElementById('geo-otp-code-input') as HTMLInputElement;
      const statusMsg = document.getElementById('geo-otp-status-msg');
      const trustCb = document.getElementById('cb-trust-geo-location') as HTMLInputElement;
      const newCountry = modal?.dataset.newCountry || 'FI';

      const code = (otpInput?.value || '').trim();
      if (code.length !== 6) {
        if (statusMsg) {
          statusMsg.innerHTML = '<span class="text-rose-400 font-medium">Please enter a valid 6-digit code.</span>';
        }
        return;
      }

      if (statusMsg) {
        statusMsg.innerHTML = '<span class="text-slate-300 animate-pulse">Verifying step-up challenge...</span>';
      }

      const token = localStorage.getItem('aetheria_auth_token');
      const headers: Record<string, string> = { 'Content-Type': 'application/json' };
      if (token) headers['Authorization'] = `Bearer ${token}`;

      try {
        const res = await fetch('/api/security/verify-geo-otp', {
          method: 'POST',
          headers,
          body: JSON.stringify({
            code,
            trustLocation: trustCb ? trustCb.checked : true,
            countryToTrust: newCountry
          })
        });
        const data = await res.json().catch(() => ({}));

        if (res.ok && data.success) {
          modal?.classList.add('hidden');
          showToast('Identity verified! Location added to trusted shield.', 'success');
          if (data.trustedCountries) {
            updateTrustedCountriesBadge(data.trustedCountries);
          }
          await loadDevicesAndSecurity();
        } else {
          if (statusMsg) {
            statusMsg.innerHTML = `<span class="text-rose-400 font-medium">${data.message || 'Invalid or expired code. Please retry.'}</span>`;
          }
        }
      } catch (err) {
        if (statusMsg) {
          statusMsg.innerHTML = '<span class="text-rose-400 font-medium">Network error verifying code.</span>';
