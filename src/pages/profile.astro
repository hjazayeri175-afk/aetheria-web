    // Step-Up Geo-Shift Verification Challenge Modal
    function openGeoShiftChallengeModal(data: any) {
      const modal = document.getElementById('geo-shift-challenge-modal');
      if (!modal) return;

      const prevLoc = document.getElementById('geo-modal-prev-location');
      const prevCode = document.getElementById('geo-modal-prev-code');
      const newLoc = document.getElementById('geo-modal-new-location');
      const newIp = document.getElementById('geo-modal-new-ip');
      const otpInput = document.getElementById('geo-otp-code-input') as HTMLInputElement;
      const statusMsg = document.getElementById('geo-otp-status-msg');

      if (prevLoc) prevLoc.textContent = data.previousCity ? `${data.previousCity}, ${data.previousCountry || 'IR'}` : (data.previousCountry || 'Tehran, Iran');
      if (prevCode) prevCode.textContent = `${data.previousCountry || 'IR'} (Verified Baseline)`;
      if (newLoc) newLoc.textContent = data.newCity ? `${data.newCity}, ${data.newCountry || 'FI'}` : (data.newCountry || 'Helsinki, Finland');
      if (newIp) newIp.textContent = data.maskedIp || '138.124.***.***';

      if (otpInput) {
        otpInput.value = '';
        setTimeout(() => otpInput.focus(), 150);
      }

      if (statusMsg) {
        let recipientEmail = data.recipientEmail;
        if (!recipientEmail) {
          try {
            const userObj = JSON.parse(localStorage.getItem('aetheria_user') || '{}');
            if (userObj?.email) recipientEmail = userObj.email;
          } catch {}
        }

        if (data.simulated || data.hint) {
          statusMsg.innerHTML = `
            <div class="space-y-1.5">
              <span class="font-bold text-xs px-3 py-1.5 rounded-xl border shadow-xs inline-block" style="background: rgba(var(--theme-accent-rgb, 147, 51, 234), 0.18); border-color: rgba(var(--theme-accent-rgb, 147, 51, 234), 0.45); color: var(--theme-accent-hover, #d8b4fe);">🧪 Preview Code: <span class="font-mono text-white tracking-widest font-extrabold text-sm ml-1">749215</span></span>
              <div class="text-[11px] text-slate-300">
                Email Dispatch Queue: <span class="font-mono text-cyan-300 font-semibold">${recipientEmail || 'account-sync@aetheria.app'}</span>
              </div>
            </div>
          `;
        } else {
          statusMsg.innerHTML = `A 6-digit verification code has been dispatched to <span class="font-semibold text-white font-mono">${recipientEmail || 'your registered account email'}</span>.`;
        }
      }

      modal.dataset.newCountry = data.newCountry || 'FI';
      modal.classList.remove('hidden');
    }

