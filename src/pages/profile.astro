        }
      }
    }

    // Battery Telemetry Diagnostics Reader
    async function initBatteryDiagnostics() {
      const pctEl = document.getElementById('battery-level-pct');
      const gaugeEl = document.getElementById('battery-gauge-bar');
      const stateEl = document.getElementById('battery-state-text');
      const chargingEl = document.getElementById('battery-charging-text');

      if (!pctEl || !gaugeEl) return;

      if ('getBattery' in navigator) {
        try {
          const battery: any = await (navigator as any).getBattery();
          function updateBatteryTelemetry() {
            // Phase 5 Background Throttling: If tab is hidden and throttled, skip DOM rendering
            if ((window as any).AetheriaPowerSaving?.isBackgroundThrottled?.()) return;
            const level = Math.round(battery.level * 100);
            pctEl.textContent = `${level}%`;
            gaugeEl.style.width = `${Math.max(5, level)}%`;

            if (level <= 20) {
              gaugeEl.className = 'h-full bg-gradient-to-r from-red-500 to-amber-500 transition-all duration-500';
              pctEl.className = 'text-xs font-mono font-bold text-red-300 bg-red-500/10 px-2 py-0.5 rounded-lg border border-red-500/30';
            } else {
              gaugeEl.className = 'h-full bg-gradient-to-r from-amber-500 to-emerald-400 transition-all duration-500';
              pctEl.className = 'text-xs font-mono font-bold text-amber-300 bg-amber-500/10 px-2 py-0.5 rounded-lg border border-amber-500/30';
            }

            if (battery.charging) {
              if (stateEl) stateEl.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-ping"></span> Status: AC Connected (Charging ⚡)';
              if (chargingEl) chargingEl.textContent = 'Fast Charge Active';
            } else {
              if (stateEl) stateEl.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Status: Operating on Battery';
              if (chargingEl) chargingEl.textContent = `${level}% Remaining`;
            }

            // Auto-saver trigger: check if armed, unplugged and level <= 20%
            const isAutoArmed = localStorage.getItem('aetheria_auto_low_battery') !== 'false';
            if (isAutoArmed && battery.level <= 0.20 && !battery.charging) {
              const ps = (window as any).AetheriaPowerSaving;
              if (ps && !ps.getSettings().master) {
                ps.setSetting('master', true);
                syncPowerSavingUI();
                render3DCarousel();
                showToast('⚡ Low battery (≤20%): Master Power Saving auto-engaged', 'warning');
              }
            }
          }

          updateBatteryTelemetry();
          battery.addEventListener('levelchange', updateBatteryTelemetry);
          battery.addEventListener('chargingchange', updateBatteryTelemetry);
          window.addEventListener('aetheria:visibility-throttle', (e: any) => {
            if (!e.detail?.hidden) {
              updateBatteryTelemetry();
            }
          });
        } catch {
          fallbackBatteryTelemetry();
        }
      } else {
        fallbackBatteryTelemetry();
      }

      function fallbackBatteryTelemetry() {
        if (pctEl) pctEl.textContent = 'Optimal';
        if (gaugeEl) gaugeEl.style.width = '100%';
        if (stateEl) stateEl.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Status: System Hardware Managed';
        if (chargingEl) chargingEl.textContent = 'Hardware Tuned';
      }
    }

    // Attach Power Saving Event Listeners
    document.getElementById('toggle-master-power-saving')?.addEventListener('change', (e) => {
      const isChecked = (e.target as HTMLInputElement).checked;
      const ps = (window as any).AetheriaPowerSaving;
      if (ps) {
        ps.setSetting('master', isChecked);
        syncPowerSavingUI();
        render3DCarousel();
        showToast(
          isChecked ? '⚡ Master Power Saving Mode Activated' : 'Power Saving Mode Deactivated',
          isChecked ? 'success' : 'info'
        );
      }
    });

    document.getElementById('toggle-auto-low-battery')?.addEventListener('change', (e) => {
      const isChecked = (e.target as HTMLInputElement).checked;
      localStorage.setItem('aetheria_auto_low_battery', isChecked ? 'true' : 'false');
      syncPowerSavingUI();
      showToast(
        isChecked ? 'Auto-enable on low battery (≤20%) armed' : 'Auto-enable on low battery disabled',
        'info'
      );
      if (isChecked && 'getBattery' in navigator) {
        (navigator as any).getBattery().then((battery: any) => {
          if (battery.level <= 0.20 && !battery.charging) {
            const ps = (window as any).AetheriaPowerSaving;
            if (ps && !ps.getSettings().master) {
              ps.setSetting('master', true);
              syncPowerSavingUI();
              render3DCarousel();
              showToast('⚡ Low battery detected: Master Power Saving activated', 'warning');
            }
          }
        }).catch(() => {});
      }
    });

    const subToggleKeys: [string, string][] = [
      ['toggle-disable-3d', 'disable3D'],
      ['toggle-disable-glows', 'disableGlows'],
      ['toggle-deep-dark-oled', 'deepDarkOLED'],
      ['toggle-freeze-avatars', 'freezeAvatars'],
      ['toggle-disable-sounds', 'disableSounds'],
      ['toggle-pause-voice-autoplay', 'pauseVoiceAutoPlay'],
      ['toggle-throttle-background', 'throttleBackground']
    ];

    subToggleKeys.forEach(([id, key]) => {
      document.getElementById(id)?.addEventListener('change', (e) => {
        const isChecked = (e.target as HTMLInputElement).checked;
        const ps = (window as any).AetheriaPowerSaving;
        if (ps) {
          ps.setSetting(key, isChecked);
          syncPowerSavingUI();
          if (key === 'disable3D') render3DCarousel();
          showToast(`Updated performance setting: ${key}`, 'info');
        }
      });
    });

    document.getElementById('btn-reset-power-settings')?.addEventListener('click', () => {
      const ps = (window as any).AetheriaPowerSaving;
      if (ps) {
        ps.saveSettings({
          master: false,
          disable3D: false,
          disableGlows: false,
          deepDarkOLED: false,
          freezeAvatars: false,
          disableSounds: false,
          pauseVoiceAutoPlay: false,
          throttleBackground: false
        });
        syncPowerSavingUI();
        render3DCarousel();
        showToast('Restored High Performance defaults', 'success');
      }
    });

    // Initialize telemetry and UI on page load
    syncPowerSavingUI();
    initBatteryDiagnostics();

    // Listen for reactive power saving changes across tabs & components
    window.addEventListener('aetheria:power-saving-change', () => {
      syncPowerSavingUI();
      render3DCarousel();
    });

    // ==========================================
    // DEVICES & SECURITY SESSIONS MANAGEMENT
    // ==========================================
    let cachedSecurityLogs: any[] = [];

    function maskIpAddress(ip: string): string {
      if (!ip || ip === '127.0.0.1' || ip === 'Unknown IP') return '127.0.0.1';
      const parts = ip.split('.');
      if (parts.length === 4) {
        return `${parts[0]}.${parts[1]}.***.***`;
      }
      const v6 = ip.split(':');
      if (v6.length > 2) {
        return `${v6[0]}:${v6[1]}:****:****`;
      }
      return ip;
    }

    function formatRelativeTime(timestampSec: number): string {
      if (!timestampSec) return 'Just now';
      const now = Math.floor(Date.now() / 1000);
      const diff = Math.max(0, now - timestampSec);
      if (diff < 60) return 'Just now';
      if (diff < 3600) return `${Math.floor(diff / 60)}m ago`;
      if (diff < 86400) return `${Math.floor(diff / 3600)}h ago`;
      const date = new Date(timestampSec * 1000);
      return date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' });
    }

    function getDeviceIconSvg(deviceType: string): string {
      if (deviceType === 'mobile') {
        return `<svg class="w-5 h-5 text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><rect x="5" y="2" width="14" height="20" rx="2" ry="2" stroke-width="2"/><line x1="12" y1="18" x2="12.01" y2="18" stroke-width="2"/></svg>`;
      }
      if (deviceType === 'tablet') {
        return `<svg class="w-5 h-5 text-purple-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><rect x="4" y="2" width="16" height="20" rx="2" ry="2" stroke-width="2"/><line x1="12" y1="18" x2="12.01" y2="18" stroke-width="2"/></svg>`;
      }
      return `<svg class="w-5 h-5 text-cyan-400" fill="none" viewBox="0 0 24 24" stroke="currentColor"><rect x="2" y="3" width="20" height="14" rx="2" ry="2" stroke-width="2"/><line x1="8" y1="21" x2="16" y2="21" stroke-width="2"/><line x1="12" y1="17" x2="12" y2="21" stroke-width="2"/></svg>`;
    }

    async function loadDevicesAndSecurity() {
      const summaryCountEl = document.getElementById('devices-summary-count');
      const currentContainer = document.getElementById('current-device-container');
      const otherContainer = document.getElementById('other-sessions-container');
      const logsTimeline = document.getElementById('security-logs-timeline');
      const hubSubtitle = document.getElementById('hub-devices-subtitle');

      const token = localStorage.getItem('aetheria_auth_token');
      const headers: Record<string, string> = {};
      if (token) headers['Authorization'] = `Bearer ${token}`;

      try {
        // 1. Fetch Sessions
        const res = await fetch('/api/sessions', { headers });
        const data = await res.json().catch(() => ({}));
        const sessions = data.sessions || [];

        // Update counts
        const count = sessions.length;
        if (summaryCountEl) {
          const isDayMode = document.documentElement.getAttribute('data-base-mode') === 'day' || document.documentElement.classList.contains('day-mode');
          summaryCountEl.innerHTML = `<span class="${isDayMode ? 'text-slate-900 font-bold' : 'text-white'}">${count} Active Session${count === 1 ? '' : 's'}</span> <span class="${isDayMode ? 'text-slate-400' : 'text-white/30'}">•</span> <span class="text-emerald-500 font-medium">Cloudflare Global Edge</span>`;
        }
        if (hubSubtitle) {
          hubSubtitle.textContent = `${count} session${count === 1 ? '' : 's'} • Hardware secure`;
        }

        // Separate current session from other sessions
        const currentSession = sessions.find((s: any) => s.isCurrent) || sessions[0];
        const otherSessions = sessions.filter((s: any) => !s.isCurrent && s.id !== currentSession?.id);

        // 3-Layer Smart Device Resolution
        const clientUa = navigator.userAgent;
        const resolvedHardware = resolveFriendlyDeviceName({
          userAgent: clientUa,
          browser: currentSession?.browser,
          platform: currentSession?.os
        });

        // Check stored alias first, else marketing name
        const savedFriendlyName = localStorage.getItem('aetheria_custom_device_name');
        let clientModelName = savedFriendlyName || currentSession?.deviceName || resolvedHardware.marketingName;

        // Subtitle badge text with factory build code preserved as secondary metadata
        let secondaryBadge = resolvedHardware.subtitleBadge;
        if (currentSession?.subtitleBadge) {
          secondaryBadge = currentSession.subtitleBadge;
        } else if (resolvedHardware.rawModelCode) {
          secondaryBadge = resolvedHardware.isKnownMarketingModel
            ? `Android (${resolvedHardware.rawModelCode})`
            : `Android (Model: ${resolvedHardware.rawModelCode})`;
        }

        // Render Current Device
        if (currentContainer && currentSession) {
          const maskedIp = maskIpAddress(currentSession.ip);
          const iconSvg = getDeviceIconSvg(currentSession.deviceType);
          const locationDisplay = currentSession.city 
            ? `${currentSession.city}${currentSession.country ? ', ' + currentSession.country : ''}`
            : (currentSession.country || 'Cloudflare Edge');

          currentContainer.innerHTML = `
            <div class="space-y-3">
              <div class="flex items-start gap-3.5">
                <div class="w-11 h-11 rounded-2xl bg-emerald-500/15 border border-emerald-500/30 flex items-center justify-center text-emerald-400 shrink-0 shadow-lg">
                  ${iconSvg}
                </div>
                <div class="space-y-1 min-w-0 flex-1">
                  <div class="flex items-center gap-2 flex-wrap">
                    <span id="current-device-display-name" class="text-sm font-bold text-white tracking-wide truncate">${clientModelName}</span>
                    <span class="text-[11px] font-semibold text-emerald-300 bg-emerald-500/10 px-2 py-0.5 rounded-full border border-emerald-500/20 shrink-0">
                      This Device • ${String(currentSession.deviceType || 'device').toUpperCase()}
                    </span>
                  </div>
                  <div id="current-device-secondary-meta" class="text-xs text-slate-300 flex items-center gap-1.5 flex-wrap">
                    <span>${currentSession.browser || 'Web Browser'}</span>
                    <span class="text-white/20">•</span>
                    <span class="text-slate-300 font-medium">${secondaryBadge || currentSession.os || 'Active OS'}</span>
                  </div>
                  <div class="flex items-center gap-3 text-[11px] text-slate-400 flex-wrap pt-0.5">
                    <span class="flex items-center gap-1 text-slate-300">
                      <svg class="w-3 h-3 text-emerald-400 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                      ${locationDisplay}
                    </span>
                    <span class="text-white/20">•</span>
                    <span class="font-mono text-slate-400">${maskedIp}</span>
                  </div>
                </div>
              </div>

              <!-- Metadata Footer Row: Session started + Rename Device -->
              <div class="flex items-center justify-between pt-3 mt-3 border-t border-white/10 text-xs">
                <span class="flex items-center gap-1.5 text-slate-200 text-xs font-normal">
                  <svg class="w-3.5 h-3.5 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><circle cx="12" cy="12" r="10" stroke-width="2"/><polyline points="12 6 12 12 16 14" stroke-width="2"/></svg>
                  Session started: <span class="text-white font-bold">${formatRelativeTime(currentSession.createdAt || (Date.now() / 1000 - 3600))}</span>
                </span>
                <button 
                  type="button" 
                  id="btn-rename-device"
                  class="flex items-center gap-1.5 text-xs font-bold transition cursor-pointer py-1.5 px-3 rounded-xl active:scale-95 border shadow-xs"
                  style="background: rgba(var(--theme-accent-rgb, 147, 51, 234), 0.12); border-color: rgba(var(--theme-accent-rgb, 147, 51, 234), 0.35); color: var(--theme-accent-hover, #67e8f9);"
                  title="Set friendly name for this hardware"
                >
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"/></svg>
                  <span>Rename Device</span>
                </button>
              </div>
            </div>
          `;

          // Bind Rename Device action
          document.getElementById('btn-rename-device')?.addEventListener('click', () => {
            const currentAlias = localStorage.getItem('aetheria_custom_device_name') || clientModelName;
            const custom = prompt('Enter a friendly name for this device (e.g. My POCO Phone, Workstation):', currentAlias);
            if (custom !== null) {
              const trimmed = custom.trim();
              if (trimmed) {
                localStorage.setItem('aetheria_custom_device_name', trimmed);
                const nameEl = document.getElementById('current-device-display-name');
                if (nameEl) nameEl.textContent = trimmed;
                showToast(`Device alias updated to "${trimmed}"`, 'success');
              } else {
                localStorage.removeItem('aetheria_custom_device_name');
                const nameEl = document.getElementById('current-device-display-name');
                if (nameEl) nameEl.textContent = currentSession?.deviceName || resolvedHardware.marketingName;
                showToast('Device alias reset to default hardware name', 'info');
              }
            }
          });

          // Layer 1 — High-Entropy Client Hints API (Frontend)
          if ((navigator as any).userAgentData?.getHighEntropyValues) {
            (navigator as any).userAgentData.getHighEntropyValues(['model', 'platform', 'platformVersion']).then((data: any) => {
              if (data?.model && data.model !== 'K') {
                const hintResolved = resolveFriendlyDeviceName({
                  userAgent: clientUa,
                  modelCode: data.model,
                  platform: data.platform
                });

                if (!localStorage.getItem('aetheria_custom_device_name')) {
                  const devSpan = document.getElementById('current-device-display-name');
                  if (devSpan) devSpan.textContent = hintResolved.marketingName;

                  const secMeta = document.getElementById('current-device-secondary-meta');
                  if (secMeta) {
                    secMeta.innerHTML = `
                      <span>${currentSession?.browser || 'Web Browser'}</span>
                      <span class="text-white/20">•</span>
                      <span class="text-slate-300 font-medium">${hintResolved.subtitleBadge}</span>
                    `;
                  }
                }

                // Sync high-entropy hints to backend session
                fetch('/api/devices/sync-client-hints', {
                  method: 'POST',
                  headers: { 'Content-Type': 'application/json', ...headers },
                  body: JSON.stringify({ model: data.model, platform: data.platform })
                }).catch(() => {});
              }
            }).catch(() => {});
          }
        }

        // Update terminate others button availability
        const termBtn = document.getElementById('btn-terminate-other-sessions');
        if (termBtn) {
          if (otherSessions.length === 0) {
            termBtn.classList.add('opacity-40', 'cursor-not-allowed');
          } else {
            termBtn.classList.remove('opacity-40', 'cursor-not-allowed');
          }
        }

        // Render Other Sessions
        if (otherContainer) {
          if (otherSessions.length === 0) {
            otherContainer.innerHTML = `
              <div class="rounded-3xl bg-[#101422]/70 border border-white/10 p-6 text-center space-y-1.5 shadow-lg">
                <div class="text-xs font-bold text-white">No other connected devices</div>
                <div class="text-xs text-slate-300 font-normal">Your account is currently only authenticated on this hardware.</div>
              </div>
            `;
          } else {
            otherContainer.innerHTML = otherSessions.map((s: any) => {
              const maskedIp = maskIpAddress(s.ip);
              const iconSvg = getDeviceIconSvg(s.deviceType);
              const timeFormatted = formatRelativeTime(s.lastActiveAt || s.createdAt);
              return `
                <div class="rounded-3xl bg-[#101422]/90 border border-white/10 hover:border-white/20 p-4 sm:p-5 shadow-xl transition flex flex-col sm:flex-row sm:items-center justify-between gap-4">
                  <div class="flex items-start gap-3.5">
                    <div class="w-10 h-10 rounded-2xl bg-white/[0.04] border border-white/[0.08] flex items-center justify-center text-slate-200 shrink-0 shadow-inner">
                      ${iconSvg}
                    </div>
                    <div class="space-y-1">
                      <div class="flex items-center gap-2 flex-wrap">
                        <span class="text-sm font-bold text-white tracking-wide">${s.deviceName || 'Connected Device'}</span>
                        <span class="text-[10px] font-bold text-slate-300 bg-white/10 px-2 py-0.5 rounded-full border border-white/15 uppercase tracking-wider">
                          ${s.deviceType || 'client'}
                        </span>
                      </div>
                      <div class="text-xs text-slate-200 flex items-center gap-1.5 flex-wrap">
                        <span>${s.browser || 'Web Browser'}</span>
                        <span class="text-white/20">•</span>
                        <span class="font-medium text-slate-200">${s.subtitleBadge || s.os || 'OS'}</span>
                      </div>
                      <div class="flex items-center gap-3 text-xs text-slate-300 flex-wrap pt-0.5 font-normal">
                        <span class="flex items-center gap-1 text-slate-200 font-medium">
                          <svg class="w-3.5 h-3.5 text-slate-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
                          ${s.city || 'Cloudflare Edge'}${s.country ? ', ' + s.country : ''}
                        </span>
                        <span class="text-white/20">•</span>
                        <span class="font-mono text-slate-200 font-medium">${maskedIp}</span>
                        <span class="text-white/20">•</span>
                        <span class="text-slate-300">Active ${timeFormatted}</span>
                      </div>
                    </div>
                  </div>

                  <div class="flex items-center justify-end pt-2 sm:pt-0 border-t sm:border-t-0 border-white/10">
                    <button 
                      type="button" 
                      class="btn-revoke-session px-3 py-1.5 rounded-xl bg-rose-500/10 hover:bg-rose-500/20 active:scale-95 text-rose-300 border border-rose-500/25 text-xs font-semibold transition cursor-pointer flex items-center gap-1.5 group"
                      data-session-id="${s.id}"
                      data-device-name="${s.deviceName || 'Device'}"
                    >
                      <svg class="w-3.5 h-3.5 text-rose-400 group-hover:scale-110 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1"/></svg>
                      <span>Revoke Access</span>
                    </button>
                  </div>
                </div>
              `;
            }).join('');

            // Bind click listeners for individual revoke buttons
            otherContainer.querySelectorAll('.btn-revoke-session').forEach(btn => {
              btn.addEventListener('click', async (e) => {
                const target = e.currentTarget as HTMLElement;
                const sessionId = target.getAttribute('data-session-id');
                const devName = target.getAttribute('data-device-name') || 'this device';
                if (!sessionId) return;

                const confirmed = await showConfirm(
                  'Disconnect Device?',
                  `Are you sure you want to revoke access for "${devName}"? The session token will be immediately destroyed and the device signed out.`
                );
                if (!confirmed) return;

                try {
                  const res = await fetch(`/api/sessions/${sessionId}`, {
                    method: 'DELETE',
                    headers
                  });
                  const json = await res.json().catch(() => ({}));
                  if (json.success) {
                    showToast('Device has been disconnected successfully.', 'success');
                    await loadDevicesAndSecurity();
                  } else {
                    showToast(json.error || 'Failed to revoke device', 'error');
                  }
                } catch (err) {
                  showToast('Network error while revoking session', 'error');
                }
              });
            });
          }
        }

        // 2. Fetch Security Settings & Check Browser Push Status
        const settingsRes = await fetch('/api/security/settings', { headers });
        const settingsData = await settingsRes.json().catch(() => ({}));
        if (settingsData.settings) {
          const tLogin = document.getElementById('toggle-new-login-alert') as HTMLInputElement;
          const tAnomaly = document.getElementById('toggle-ip-anomaly-shield') as HTMLInputElement;
          if (tLogin) tLogin.checked = settingsData.settings.alertNewLogin !== false;
          if (tAnomaly) tAnomaly.checked = settingsData.settings.alertIpAnomaly !== false;

          const policyCard = document.getElementById('geo-shift-policy-card');
          if (policyCard) {
            policyCard.style.display = tAnomaly?.checked ? 'block' : 'none';
          }
          const policy = settingsData.settings.geoShiftPolicy || 'alert_only';
          updateGeoPolicyUI(policy);
          if (settingsData.settings.trustedCountries) {
            updateTrustedCountriesBadge(settingsData.settings.trustedCountries);
          }
          updateShieldStatusBadges();
          updateAccountEmailChannelUI(settingsData.settings.userEmail);
        } else {
          updateShieldStatusBadges();
          updateAccountEmailChannelUI();
        }
        updatePushNotificationBadge();

        // 3. Fetch Security Logs
        const logsRes = await fetch('/api/security/logs', { headers });
        const logsData = await logsRes.json().catch(() => ({}));
        cachedSecurityLogs = logsData.logs || [];

        // Update count badge
        const countBadge = document.getElementById('security-logs-count-badge');
        if (countBadge) {
          countBadge.textContent = `${cachedSecurityLogs.length} event${cachedSecurityLogs.length === 1 ? '' : 's'}`;
        }

        if (logsTimeline) {
          if (cachedSecurityLogs.length === 0) {
            logsTimeline.innerHTML = `
              <div class="text-xs text-slate-500 py-3 text-center">No recent security events recorded.</div>
            `;
          } else {
            logsTimeline.innerHTML = cachedSecurityLogs.slice(0, 15).map((log: any) => {
              let badgeColor = 'bg-emerald-500/10 text-emerald-400 border-emerald-500/20';
              let badgeText = 'Login Success';
              if (log.event_type === 'session_revoked') {
                badgeColor = 'bg-rose-500/10 text-rose-400 border-rose-500/20';
                badgeText = 'Session Revoked';
              } else if (log.event_type === 'others_revoked') {
                badgeColor = 'bg-amber-500/10 text-amber-400 border-amber-500/20';
                badgeText = 'Others Terminated';
              } else if (log.event_type === 'ip_anomaly_detected' || log.event_type === 'geo_shift_detected') {
                badgeColor = 'bg-orange-500/15 text-orange-400 border-orange-500/30';
                badgeText = 'IP Geo-Shift Flagged';
              } else if (log.event_type === 'geo_shift_challenge') {
                badgeColor = 'bg-rose-500/20 text-rose-300 border-rose-500/30';
                badgeText = 'Geo Challenge Issued';
              } else if (log.event_type === 'geo_verification_success' || log.event_type === 'geo_shift_verified') {
                badgeColor = 'bg-cyan-500/20 text-cyan-300 border-cyan-500/30';
                badgeText = 'Geo OTP Verified';
              } else if (log.event_type === 'security_check') {
                badgeColor = 'bg-cyan-500/10 text-cyan-400 border-cyan-500/20';
                badgeText = 'Security Audit';
              }

              const maskedIp = maskIpAddress(log.ip);
              const timeFormatted = formatRelativeTime(log.created_at);

              return `
                <div class="p-3.5 rounded-2xl bg-white/[0.03] border border-white/10 hover:border-white/20 flex items-center justify-between gap-3 text-xs transition shadow-xs">
                  <div class="space-y-1">
                    <div class="flex items-center gap-2">
                      <span class="px-2.5 py-0.5 rounded-full text-[10px] font-bold border tracking-wide ${badgeColor}">
                        ${badgeText}
                      </span>
                      <span class="font-bold text-white">${log.device_name || 'Web Client'}</span>
                      <span class="text-slate-300 text-xs hidden sm:inline font-normal">(${log.browser || 'Browser'})</span>
                    </div>
                    <div class="text-xs text-slate-300 flex items-center gap-2 font-normal">
                      <span class="text-slate-200 font-medium">${log.city || 'Edge'}${log.country ? ', ' + log.country : ''}</span>
                      <span class="text-white/20">•</span>
                      <span class="font-mono text-slate-200 font-medium">${maskedIp}</span>
                    </div>
                  </div>
                  <div class="text-right shrink-0">
                    <span class="text-xs text-slate-200 font-semibold">${timeFormatted}</span>
                  </div>
                </div>
              `;
            }).join('');
          }
        }
      } catch (e) {
        console.error('Error loading devices & security:', e);
      }
    }

    // Helper: Push Notification UI & Permission Request
    function updatePushNotificationBadge() {
      const pushLabel = document.getElementById('push-channel-label');
      const pushBtn = document.getElementById('btn-channel-browser-push');
      if (!pushLabel || !pushBtn) return;

      if (!('Notification' in window)) {
        pushLabel.textContent = 'Browser Push: Unsupported';
        pushBtn.className = 'flex items-center gap-1.5 px-2.5 py-1 rounded-xl text-[11px] font-medium border bg-white/[0.03] text-slate-400 border-white/[0.08] cursor-default';
        return;
      }

      if (Notification.permission === 'granted') {
        pushLabel.textContent = 'Browser Push: Enabled';
        pushBtn.className = 'flex items-center gap-1.5 px-2.5 py-1 rounded-xl text-[11px] font-medium transition cursor-pointer border bg-emerald-500/10 text-emerald-300 border-emerald-500/20 hover:bg-emerald-500/20 active:scale-95';
      } else if (Notification.permission === 'denied') {
        pushLabel.textContent = 'Browser Push: Blocked';
        pushBtn.className = 'flex items-center gap-1.5 px-2.5 py-1 rounded-xl text-[11px] font-medium transition cursor-pointer border bg-rose-500/10 text-rose-300 border-rose-500/20 hover:bg-rose-500/20 active:scale-95';
      } else {
        pushLabel.textContent = 'Browser Push: Tap to Enable';
        pushBtn.className = 'flex items-center gap-1.5 px-2.5 py-1 rounded-xl text-[11px] font-medium transition cursor-pointer border bg-amber-500/10 text-amber-300 border-amber-500/20 hover:bg-amber-500/20 active:scale-95';
      }
    }

    document.getElementById('btn-channel-browser-push')?.addEventListener('click', async () => {
      if (!('Notification' in window)) {
        showToast('Push notifications are not supported in this browser.', 'info');
        return;
      }
      if (Notification.permission === 'granted') {
        showToast('Browser push notifications are currently active for this hardware.', 'info');
        return;
      }
      if (Notification.permission === 'denied') {
        showToast('Notifications are blocked by browser permissions. Please enable in site settings.', 'info');
        return;
      }
      try {
        const permission = await Notification.requestPermission();
        updatePushNotificationBadge();
        if (permission === 'granted') {
          showToast('Browser push notifications enabled for login alerts!', 'success');
        } else {
          showToast('Notification permission was not granted.', 'info');
        }
      } catch {
        showToast('Unable to request notification permission.', 'error');
      }
    });

