        const tabNameColors = document.getElementById('tab-toggle-name-colors');
        const tabAvatarBorder = document.getElementById('tab-toggle-avatar-border');
        const viewTabName = document.getElementById('view-tab-name');
        const viewTabAvatar = document.getElementById('view-tab-avatar');

        const gridColorMatrix = document.getElementById('grid-color-matrix');
        const borderEffectsGrid = document.getElementById('border-effects-grid');
        const gridGlowColors = document.getElementById('grid-border-glow-colors');
