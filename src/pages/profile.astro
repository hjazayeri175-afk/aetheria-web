      });

      // Auto Low Battery Toggle sync
      const autoSaverEl = document.getElementById('toggle-auto-low-battery') as HTMLInputElement;
      const autoSaverBadge = document.getElementById('badge-auto-battery');
      const isAutoSaverArmed = localStorage.getItem('aetheria_auto_low_battery') !== 'false';
      if (autoSaverEl) autoSaverEl.checked = isAutoSaverArmed;
      if (autoSaverBadge) {
