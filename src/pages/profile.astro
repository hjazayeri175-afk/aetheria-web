---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import BottomNav from '../components/BottomNav.astro';
import { 
  User, 
  Sparkles, 
  Save, 
  Trash, 
  Plus, 
  Check, 
  Eye, 
  EyeOff,
  Camera,
  Settings,
  Shield,
  Download,
  Upload,
  LogOut,
  LogIn,
  ChevronDown,
  Palette,
  RotateCcw,
  Copy,
  ArrowLeft,
  Key,
  Cpu,
  Mic,
  Database,
  Smartphone,
  Zap,
  Globe,
  Image,
  Sun,
  ChevronRight,
  ChevronLeft,
  Volume2,
  MessageSquare,
  Pencil,
  WandSparkles
} from '@lucide/astro';
---

<Layout title="Settings - Aetheria" activeNav="persona">
  <Header />

  <main class="min-h-screen bg-[#07080d] text-slate-100 pb-28 pt-6 sm:pt-8 px-3 sm:px-4">
    <div class="max-w-xl mx-auto">

      <!-- ========================================== -->
      <!-- VIEW 1: TELEGRAM SETTINGS HUB (MAIN MENU)  -->
      <!-- ========================================== -->
      <div id="view-hub" class="space-y-4">
        
        <!-- Telegram Profile Header Card -->
        <div class="rounded-3xl bg-[#141824] border border-white/[0.06] p-5 shadow-xl relative overflow-hidden">
          <div class="absolute -right-12 -top-12 w-44 h-44 rounded-full bg-purple-500/10 blur-3xl pointer-events-none"></div>
          
          <div class="flex items-center gap-4 relative z-10">
            <!-- User Avatar with Camera / Edit badge -->
            <div class="relative group cursor-pointer" id="hub-avatar-trigger" title="Edit active persona">
              <div class="w-16 h-16 sm:w-18 sm:h-18 rounded-full overflow-hidden border-2 border-purple-500/40 bg-purple-950/40 flex items-center justify-center shadow-lg shadow-purple-950/50">
                <img id="hub-avatar-img" src="" alt="Avatar" class="w-full h-full object-cover hidden" />
                <div id="hub-avatar-placeholder" class="flex items-center justify-center text-purple-300 font-bold text-xl sm:text-2xl">
                  H
                </div>
              </div>
              <div class="absolute -bottom-1 -right-1 w-6 h-6 rounded-full bg-purple-600 border-2 border-[#141824] flex items-center justify-center text-white shadow-sm">
                <Camera class="w-3 h-3" />
              </div>
            </div>

            <!-- User Info -->
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <h1 id="hub-user-name" class="text-lg sm:text-xl font-bold text-white truncate">Hossein</h1>
                <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/15 text-emerald-400 border border-emerald-500/30">
                  Online
                </span>
              </div>
              <p id="hub-user-handle" class="text-xs text-[#8e98a8] mt-0.5 truncate">@hossein • Active Persona</p>
              <div class="flex items-center gap-2 mt-2">
                <span id="hub-persona-status-badge" class="text-[11px] font-medium text-purple-300 bg-purple-500/15 px-2.5 py-0.5 rounded-lg border border-purple-500/20">
                  4 Personas Configured
                </span>
              </div>
            </div>
          </div>
        </div>

        <!-- Section Label -->
        <div class="px-2 pt-1 text-xs font-bold uppercase tracking-wider text-[#8e98a8]">
          Settings
        </div>

        <!-- Telegram 9-Item Settings Menu (Exact 1:1 Parity) -->
        <div class="rounded-3xl bg-[#141824] border border-white/[0.06] p-1.5 sm:p-2 space-y-0.5 shadow-2xl">
          
          <!-- 1. My Personas -->
          <button 
            type="button" 
            id="hub-item-personas"
            class="w-full px-3.5 py-3 rounded-2xl flex items-center gap-3.5 hover:bg-white/[0.05] active:bg-white/[0.08] transition text-left cursor-pointer group"
          >
            <div class="w-10 h-10 rounded-2xl bg-[#0284c7] flex items-center justify-center text-white shrink-0 shadow-md">
              <User class="w-5 h-5 stroke-[2.2]" />
            </div>
            <div class="min-w-0 flex-1">
              <div class="text-[15px] font-semibold text-white tracking-wide">My Personas</div>
              <div id="hub-persona-subtitle" class="text-[13px] text-[#8e98a8] truncate">Active: Hossein • Switch & Edit Profiles</div>
            </div>
            <span id="hub-personas-count-pill" class="text-xs font-semibold px-2 py-0.5 rounded-full bg-white/[0.08] text-slate-300">
              4
            </span>
          </button>

          <!-- 2. Chat Settings -->
          <button 
            type="button" 
            id="hub-item-appearance"
            class="w-full px-3.5 py-3 rounded-2xl flex items-center gap-3.5 hover:bg-white/[0.05] active:bg-white/[0.08] transition text-left cursor-pointer group"
          >
            <div class="w-10 h-10 rounded-2xl bg-[#d97706] flex items-center justify-center text-white shrink-0 shadow-md">
              <Palette class="w-5 h-5 stroke-[2.2]" />
            </div>
            <div class="min-w-0 flex-1">
              <div class="text-[15px] font-semibold text-white tracking-wide">Chat Settings</div>
              <div class="text-[13px] text-[#8e98a8] truncate">Themes, Wallpapers, Message text size</div>
            </div>
          </button>

          <!-- 3. AI Engine & Models -->
          <button 
            type="button" 
            id="hub-item-ai"
            class="w-full px-3.5 py-3 rounded-2xl flex items-center gap-3.5 hover:bg-white/[0.05] active:bg-white/[0.08] transition text-left cursor-pointer group"
          >
            <div class="w-10 h-10 rounded-2xl bg-[#2563eb] flex items-center justify-center text-white shrink-0 shadow-md">
              <Cpu class="w-5 h-5 stroke-[2.2]" />
            </div>
            <div class="min-w-0 flex-1">
              <div class="text-[15px] font-semibold text-white tracking-wide">AI Engine & Models</div>
              <div class="text-[13px] text-[#8e98a8] truncate">custom-proxy • qwen3.8-max • Parameters</div>
            </div>
          </button>

          <!-- 4. Privacy & Security -->
          <button 
            type="button" 
            id="hub-item-privacy"
            class="w-full px-3.5 py-3 rounded-2xl flex items-center gap-3.5 hover:bg-white/[0.05] active:bg-white/[0.08] transition text-left cursor-pointer group"
          >
            <div class="w-10 h-10 rounded-2xl bg-[#16a34a] flex items-center justify-center text-white shrink-0 shadow-md">
              <Key class="w-5 h-5 stroke-[2.2]" />
            </div>
            <div class="min-w-0 flex-1">
              <div class="text-[15px] font-semibold text-white tracking-wide">Privacy & Security</div>
              <div class="text-[13px] text-[#8e98a8] truncate">Local storage, API tokens, safe mode</div>
            </div>
          </button>

          <!-- 5. Voice & Speech -->
          <button 
            type="button" 
            id="hub-item-voice"
            class="w-full px-3.5 py-3 rounded-2xl flex items-center gap-3.5 hover:bg-white/[0.05] active:bg-white/[0.08] transition text-left cursor-pointer group"
          >
            <div class="w-10 h-10 rounded-2xl bg-[#e11d48] flex items-center justify-center text-white shrink-0 shadow-md">
              <Mic class="w-5 h-5 stroke-[2.2]" />
            </div>
            <div class="min-w-0 flex-1">
              <div class="text-[15px] font-semibold text-white tracking-wide">Voice & Speech</div>
              <div class="text-[13px] text-[#8e98a8] truncate">Cloudflare Workers AI, ElevenLabs, Whisper</div>
            </div>
          </button>

          <!-- 6. Data and Storage -->
          <button 
            type="button" 
            id="hub-item-data"
            class="w-full px-3.5 py-3 rounded-2xl flex items-center gap-3.5 hover:bg-white/[0.05] active:bg-white/[0.08] transition text-left cursor-pointer group"
          >
            <div class="w-10 h-10 rounded-2xl bg-[#3b82f6] flex items-center justify-center text-white shrink-0 shadow-md">
              <Database class="w-5 h-5 stroke-[2.2]" />
            </div>
            <div class="min-w-0 flex-1">
              <div class="text-[15px] font-semibold text-white tracking-wide">Data and Storage</div>
              <div class="text-[13px] text-[#8e98a8] truncate">Backup export, import, cache reset</div>
            </div>
          </button>

          <!-- 7. Devices -->
          <button 
            type="button" 
            id="hub-item-devices"
            class="w-full px-3.5 py-3 rounded-2xl flex items-center gap-3.5 hover:bg-white/[0.05] active:bg-white/[0.08] transition text-left cursor-pointer group"
          >
            <div class="w-10 h-10 rounded-2xl bg-[#0d9488] flex items-center justify-center text-white shrink-0 shadow-md">
              <Smartphone class="w-5 h-5 stroke-[2.2]" />
            </div>
            <div class="min-w-0 flex-1">
              <div class="text-[15px] font-semibold text-white tracking-wide">Devices</div>
              <div class="text-[13px] text-[#8e98a8] truncate">Active Web Session • Cloudflare Workers Edge</div>
            </div>
          </button>

          <!-- 8. Power Saving -->
          <button 
            type="button" 
            id="hub-item-power"
            class="w-full px-3.5 py-3 rounded-2xl flex items-center gap-3.5 hover:bg-white/[0.05] active:bg-white/[0.08] transition text-left cursor-pointer group"
          >
            <div class="w-10 h-10 rounded-2xl bg-[#ea580c] flex items-center justify-center text-white shrink-0 shadow-md">
              <Zap class="w-5 h-5 stroke-[2.2]" />
            </div>
            <div class="min-w-0 flex-1">
              <div class="text-[15px] font-semibold text-white tracking-wide">Power Saving</div>
              <div class="text-[13px] text-[#8e98a8] truncate">Animations, vector doodles, sound effects</div>
            </div>
          </button>

          <!-- 9. Language -->
          <button 
            type="button" 
            id="hub-item-language"
            class="w-full px-3.5 py-3 rounded-2xl flex items-center gap-3.5 hover:bg-white/[0.05] active:bg-white/[0.08] transition text-left cursor-pointer group"
          >
            <div class="w-10 h-10 rounded-2xl bg-[#8b5cf6] flex items-center justify-center text-white shrink-0 shadow-md">
              <Globe class="w-5 h-5 stroke-[2.2]" />
            </div>
            <div class="min-w-0 flex-1">
              <div class="text-[15px] font-semibold text-white tracking-wide">Language</div>
              <div class="text-[13px] text-[#8e98a8] truncate">English</div>
            </div>
          </button>

        </div>

      </div>

      <!-- ========================================== -->
      <!-- VIEW 2: PERSONAS (3D Coverflow Experience) -->
      <!-- ========================================== -->
      <div id="view-personas" class="hidden space-y-4 pt-2 sm:pt-3">
        
        <!-- Header Bar: Back to Settings + Persona Counter (Clean & Minimal) -->
        <div class="flex items-center justify-between pb-1 border-b border-white/[0.06]">
          <button 
            type="button" 
            id="btn-back-from-personas"
            class="flex items-center gap-2 text-white/90 hover:text-white font-medium text-sm py-1.5 px-2 rounded-xl hover:bg-white/[0.05] transition cursor-pointer"
          >
            <ArrowLeft class="w-5 h-5" />
            <span>Settings</span>
          </button>

          <span id="personas-count-badge" class="px-2.5 py-1 rounded-full bg-purple-500/10 border border-purple-500/30 text-purple-300 text-[11px] font-semibold">
            1 Persona
          </span>
        </div>

        <div>
          <h1 class="text-xl font-bold text-white tracking-tight">Personas</h1>
          <p class="text-xs text-stone-300 mt-0.5">Customize how characters perceive you in chat with 3D cards</p>
        </div>

        <!-- Master Enable / Disable Toggle -->
        <div class="flex items-center justify-between p-3.5 sm:p-4 rounded-2xl bg-[#0c0e18]/90 border border-purple-500/20 transition">
          <div class="flex items-center gap-3">
            <div id="persona-toggle-icon" class="w-9 h-9 rounded-xl bg-purple-500/15 border border-purple-500/30 flex items-center justify-center text-purple-300 transition shrink-0">
              <User class="w-4 h-4" />
            </div>
            <div class="min-w-0">
              <p class="text-xs font-semibold text-white">Enable Persona in Chats</p>
              <p id="persona-toggle-status" class="text-[11px] text-stone-400 truncate">Active in chats • Characters will use your persona</p>
            </div>
          </div>
          <label class="relative inline-flex items-center cursor-pointer shrink-0">
            <input type="checkbox" id="persona-master-toggle" class="sr-only peer" checked>
            <div class="w-11 h-6 bg-stone-800/80 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-[var(--theme-accent,#9333ea)]"></div>
          </label>
        </div>

        <!-- 3D CAROUSEL CONTROLS BAR -->
        <div id="carousel-controls-bar" class="flex items-center justify-between px-1 pt-3 text-xs text-slate-400 transition-opacity duration-200">
          <div class="flex items-center gap-2">
            <span class="font-medium text-stone-300">Swipe or tap cards</span>
            <span class="text-[10px] text-purple-300/90 bg-purple-500/10 px-2 py-0.5 rounded-full border border-purple-500/25 font-mono">3D Coverflow</span>
          </div>
          <!-- Arrow Navigation -->
          <div class="flex items-center gap-1.5">
            <button 
              type="button" 
              id="carousel-btn-prev" 
              class="w-7 h-7 rounded-lg bg-stone-900/60 hover:bg-purple-500/20 active:scale-90 border border-purple-500/30 flex items-center justify-center text-purple-200 transition cursor-pointer"
              title="Previous persona"
            >
              <ChevronLeft class="w-4 h-4" />
            </button>
            <span id="carousel-page-indicator" class="text-[11px] font-mono text-purple-300 min-w-[36px] text-center">1 / 1</span>
            <button 
              type="button" 
              id="carousel-btn-next" 
              class="w-7 h-7 rounded-lg bg-stone-900/60 hover:bg-purple-500/20 active:scale-90 border border-purple-500/30 flex items-center justify-center text-purple-200 transition cursor-pointer"
              title="Next persona"
            >
              <ChevronRight class="w-4 h-4" />
            </button>
          </div>
        </div>

        <!-- 3D CAROUSEL STAGE CONTAINER -->
        <div 
          id="persona-carousel-stage" 
          class="relative w-full h-[560px] sm:h-[600px] perspective-1200 flex items-center justify-center overflow-hidden select-none touch-pan-y"
        >
          <!-- CARDS WRAPPER (Populated dynamically by JavaScript) -->
          <div id="persona-cards-wrapper" class="relative w-full h-full flex items-center justify-center preserve-3d">
            <!-- Dynamically populated with 3D Coverflow Persona Cards -->
          </div>
        </div>

        <!-- Dots Indicator -->
        <div id="carousel-dots" class="flex items-center justify-center gap-1.5 pt-0.5 pb-2">
          <!-- Populated by JS -->
        </div>

        <!-- Hidden Global File Input for Persona Avatar Uploads -->
        <input type="file" id="avatar-file-input" accept="image/png,image/jpeg,image/webp,image/gif" class="hidden" />

      </div>

      <!-- ========================================== -->
      <!-- VIEW 3: CHAT APPEARANCE SUB-PAGE          -->
      <!-- ========================================== -->
      <div id="view-appearance" class="hidden space-y-4">
        
        <!-- Header with Back Button -->
        <div class="flex items-center justify-between pb-1">
          <button 
            type="button" 
            id="btn-back-from-appearance"
            class="flex items-center gap-2 text-white/90 hover:text-white font-medium text-sm py-1.5 px-2 rounded-xl hover:bg-white/[0.05] transition cursor-pointer"
          >
            <ArrowLeft class="w-5 h-5" />
            <span>Settings</span>
          </button>
          <span class="text-sm font-semibold text-white/80">Chat Settings</span>
          <div class="w-8"></div>
        </div>

        <!-- Card 1: Text Sizing, Live Preview & Action Rows (Change Wallpaper / Name Color) -->
        <div class="rounded-3xl bg-[#1e2336] p-4 border border-white/[0.08] shadow-xl space-y-4">
          <!-- Message text size header & slider (Telegram-fidelity filled progress + notch dots) -->
          <div class="space-y-3">
            <div class="flex items-center justify-between px-0.5">
              <span class="text-sm font-semibold text-[#8E9AB6]">Message text size</span>
              <span id="profile-font-val" class="text-sm font-bold text-[#8E9AB6]">16</span>
            </div>
            <div class="relative w-full py-1.5 flex items-center">
              <!-- Discrete Step Notch Dots (11 steps: 12 to 22) -->
              <div class="absolute inset-x-2 top-1/2 -translate-y-1/2 flex justify-between pointer-events-none z-0 px-0.5">
                <span class="w-1 h-1 rounded-full bg-white/20"></span>
                <span class="w-1 h-1 rounded-full bg-white/20"></span>
                <span class="w-1 h-1 rounded-full bg-white/20"></span>
                <span class="w-1 h-1 rounded-full bg-white/20"></span>
                <span class="w-1 h-1 rounded-full bg-white/20"></span>
                <span class="w-1 h-1 rounded-full bg-white/20"></span>
                <span class="w-1 h-1 rounded-full bg-white/20"></span>
                <span class="w-1 h-1 rounded-full bg-white/20"></span>
                <span class="w-1 h-1 rounded-full bg-white/20"></span>
                <span class="w-1 h-1 rounded-full bg-white/20"></span>
                <span class="w-1 h-1 rounded-full bg-white/20"></span>
              </div>
              <input 
                type="range" 
                id="profile-font-slider" 
                min="12" 
                max="22" 
                step="1" 
                value="16" 
                class="telegram-slider relative z-10 w-full" 
              />
            </div>
          </div>

          <!-- Live Chat Preview Box (Pure Black & Clean Bubbles) -->
          <div id="profile-preview-viewport" class="relative rounded-2xl overflow-hidden border border-white/10 flex flex-col justify-end p-3.5 select-none shadow-inner min-h-[195px]" style="background-color: #000000;">
            <div id="profile-preview-image" class="absolute inset-0 bg-cover bg-center transition-all duration-300"></div>
            <div id="profile-preview-dimmer" class="absolute inset-0 bg-black transition-opacity pointer-events-none" style="opacity: 0.20;"></div>
            <div id="profile-preview-pattern" class="absolute inset-0 pointer-events-none transition-opacity" style="opacity: 0.18;"></div>

            <div class="relative z-10 space-y-2.5">
              <!-- Incoming Message (Left Bubble) -->
              <div class="flex justify-start">
                <div id="profile-preview-char-bubble" class="max-w-[85%] rounded-2xl rounded-bl-xs p-3 text-white shadow-md border border-white/10 transition-all duration-200" style="background: #181d2c;">
                  <!-- Reply Bar -->
                  <div class="pl-2 border-l-2 border-purple-400 bg-white/[0.04] rounded-xs py-0.5 px-1.5 mb-1.5 text-xs">
                    <div class="font-bold text-[11px]" id="profile-preview-char-name" style="color: #a855f7;">Hossein</div>
                    <div class="text-[11px] text-slate-300">Good morning! 👋</div>
                  </div>
                  <!-- Main Text -->
                  <div id="profile-preview-char-msg-text" class="text-white font-normal leading-relaxed transition-all duration-100" style="font-size: 16px;">Do you know what time it is?</div>
                  <!-- Timestamp -->
                  <div class="text-[10px] text-slate-400 text-right mt-1">13:24</div>
                </div>
              </div>

              <!-- Outgoing Message (Right Bubble) -->
              <div class="flex justify-end">
                <div id="profile-preview-user-bubble" class="max-w-[82%] rounded-2xl rounded-br-xs px-3.5 py-2.5 text-white shadow-md leading-relaxed transition-all duration-200" style="background: linear-gradient(135deg, #a855f7 0%, #6366f1 100%);">
                  <div id="profile-preview-user-msg-text" class="font-normal transition-all duration-100" style="font-size: 16px;">It's morning in Tokyo 😎</div>
                  <div class="text-[10px] text-white/70 flex items-center justify-end gap-1 mt-0.5">
                    <span>13:39</span>
                    <span>✓✓</span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Action Rows Inside Card 1 -->
          <div class="space-y-1 pt-1">
            <!-- Row 1: Change Chat Wallpaper -->
            <button 
              type="button" 
              id="btn-toggle-wallpaper-drawer" 
              class="w-full flex items-center justify-between py-2 px-1 text-left cursor-pointer group transition"
            >
              <div class="flex items-center gap-3">
                <Image class="w-5 h-5 text-[#8E9AB6] group-hover:text-white transition-colors" />
                <span class="text-sm font-medium text-[#8E9AB6] group-hover:text-white transition-colors">Change Chat Wallpaper</span>
              </div>
              <ChevronRight class="w-4 h-4 text-[#8E9AB6] group-hover:text-white transition-transform" id="chevron-wallpaper" />
            </button>

            <!-- Expandable Wallpaper Drawer -->
            <div id="drawer-wallpaper" class="hidden pt-2 pb-1 space-y-3 border-t border-white/[0.04]">
              <div id="profile-wallpapers-grid" class="grid grid-cols-3 sm:grid-cols-6 gap-2"></div>
              <div class="flex items-center gap-2 pt-1">
                <input type="file" id="profile-photo-file" accept="image/*" class="hidden" />
                <button type="button" id="profile-photo-btn" class="flex-1 py-2 px-3 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] text-xs font-semibold text-slate-300 hover:text-white transition flex items-center justify-center gap-2 cursor-pointer">
                  <Upload class="w-4 h-4" />
                  <span>Upload Custom Wallpaper</span>
                </button>
              </div>
            </div>

            <!-- Row 2: Change Name Color -->
            <div class="border-t border-white/[0.06] pt-1">
              <button 
                type="button" 
                id="btn-toggle-name-color-drawer" 
                class="w-full flex items-center justify-between py-2 px-1 text-left cursor-pointer group transition"
              >
                <div class="flex items-center gap-3">
                  <Palette class="w-5 h-5 text-[#8E9AB6] group-hover:text-white transition-colors" />
                  <span class="text-sm font-medium text-[#8E9AB6] group-hover:text-white transition-colors">Change Name Color</span>
                </div>
                <div class="flex items-center gap-2">
                  <div id="profile-name-pill" class="px-2.5 py-0.5 rounded-full bg-white/[0.06] text-xs font-bold" style="color: #a855f7;">
                    Hossein
                  </div>
                  <ChevronRight class="w-4 h-4 text-[#8E9AB6] group-hover:text-white transition-transform" id="chevron-name-color" />
                </div>
              </button>

              <!-- Expandable Name Color Palette -->
              <div id="drawer-name-color" class="hidden pt-2 pb-1 border-t border-white/[0.04]">
                <div id="profile-name-color-palette" class="grid grid-cols-6 sm:grid-cols-9 gap-2"></div>
                <span id="profile-name-color-hex" class="hidden"></span>
              </div>
            </div>
          </div>
        </div>

        <!-- Card 2: Color Themes & Display Modes -->
        <div class="rounded-3xl bg-[#1e2336] p-4 border border-white/[0.08] shadow-xl space-y-4">
          <div class="flex items-center justify-between px-0.5">
            <span class="text-sm font-semibold text-[#8E9AB6]">Color theme</span>
            <div class="flex items-center gap-1.5">
              <button 
                type="button" 
                id="btn-prev-theme" 
                class="w-7 h-7 rounded-full bg-white/[0.05] hover:bg-white/[0.12] text-slate-400 hover:text-white flex items-center justify-center transition cursor-pointer"
                title="Previous Theme"
              >
                <ChevronLeft class="w-4 h-4" />
              </button>
              <button 
