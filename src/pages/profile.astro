---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import BottomNav from '../components/BottomNav.astro';
import { 
  User, 
  Sparkles, 
  ShieldCheck, 
  Save, 
  Upload, 
  Download, 
  Trash2, 
  Plus, 
  RotateCcw, 
  Check, 
  Copy, 
  Eye, 
  Sliders, 
  MessageSquare, 
  ArrowLeft, 
  ExternalLink,
  Bot,
  Cloud,
  CloudUpload,
  CloudDownload,
  ChevronRight,
  Smartphone,
  Laptop,
  RefreshCw
} from '@lucide/astro';
---

<Layout title="User Persona & Identity Studio — Aetheria AI">
  <Header />

  <main class="flex-1 max-w-5xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10 pb-28 sm:pb-12 space-y-8">
    
    <!-- Top Nav / Breadcrumbs -->
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a 
          href="/" 
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] text-slate-300 hover:text-white text-xs font-medium transition"
        >
          <ArrowLeft class="w-3.5 h-3.5 text-purple-400" />
          <span>Hub</span>
        </a>
        <span class="text-slate-600">/</span>
        <span class="text-xs font-semibold text-purple-300">User Identity & Persona</span>
      </div>

      <div class="flex items-center gap-2">
        <a 
          href="/create" 
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-purple-600/20 hover:bg-purple-600/30 border border-purple-500/30 text-purple-300 hover:text-purple-200 text-xs font-medium transition"
        >
          <Plus class="w-3.5 h-3.5" />
          <span class="hidden sm:inline">Create Character</span>
        </a>
      </div>
    </div>

    <!-- Hero Header -->
    <div class="relative overflow-hidden rounded-3xl border border-white/[0.08] bg-gradient-to-b from-purple-950/20 via-[#0a0d1a] to-[#070913] p-6 sm:p-8">
      <div class="absolute -right-20 -top-20 w-80 h-80 bg-purple-600/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/20 text-xs font-medium text-purple-300 mb-3">
            <User class="w-3.5 h-3.5 text-purple-400" />
            <span>Tavern V2 & Janitor Compatible Persona Engine</span>
          </div>
          <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">
            User Persona & Identity
          </h1>
          <p class="text-xs sm:text-sm text-slate-400 mt-2 max-w-2xl leading-relaxed">
            Configure how characters perceive and address you. Your persona name seamlessly substitutes the 
            <code class="px-1.5 py-0.5 rounded bg-white/10 text-cyan-300 font-mono text-xs">{"{{user}}"}</code> 
            macro across all roleplay dialogues, system prompts, and memory contexts.
          </p>
        </div>

        <!-- Quick Storage Status -->
        <div class="bg-black/40 border border-white/10 rounded-2xl p-4 shrink-0 min-w-[200px] text-xs space-y-2">
          <div class="flex items-center justify-between text-slate-400">
            <span>Storage Mode:</span>
            <span class="text-emerald-400 font-semibold flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              Local & Private
            </span>
          </div>
          <div class="flex items-center justify-between text-slate-400">
            <span>Custom Personas:</span>
            <span id="persona-count-badge" class="text-white font-mono font-bold">1</span>
          </div>
          <div class="flex items-center justify-between text-slate-400">
            <span>Custom Characters:</span>
            <span id="char-count-badge" class="text-white font-mono font-bold">0</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Multi-Persona Switcher Tabs -->
    <div class="p-4 rounded-2xl bg-[#090b17] border border-white/[0.08] flex items-center justify-between gap-3 overflow-x-auto">
      <div class="flex items-center gap-2" id="persona-tabs-container">
        <!-- Rendered dynamically -->
      </div>
      <button 
        id="add-persona-btn"
        type="button" 
        class="shrink-0 flex items-center gap-1.5 px-3 py-2 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/10 text-xs font-semibold text-slate-300 hover:text-white transition cursor-pointer"
      >
        <Plus class="w-3.5 h-3.5 text-purple-400" />
        <span>New Persona</span>
      </button>
    </div>

    <!-- Main Persona Form -->
    <form id="persona-form" class="space-y-6">
      
      <!-- Section 1: Appearance & Avatar -->
      <div class="p-6 rounded-3xl bg-[#080a14] border border-white/[0.08] shadow-xl space-y-6">
        <div class="border-b border-white/[0.06] pb-3 flex items-center justify-between">
          <h2 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
            <Eye class="w-5 h-5 text-purple-400" />
            <span>1. Visual Avatar & Profile Picture</span>
          </h2>
          <span class="text-xs text-slate-400">Shown in chat dialogue bubbles</span>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-12 gap-6 items-center">
          <!-- Active Avatar Display -->
          <div class="md:col-span-4 flex flex-col items-center justify-center p-6 rounded-2xl bg-[#0c0e17] border border-purple-500/30 space-y-3">
            <div class="relative w-28 h-28 rounded-full overflow-hidden ring-4 ring-purple-500/40 shadow-xl shadow-purple-950/50 bg-[#070913] flex items-center justify-center">
              <img 
                id="persona-avatar-preview" 
                src="" 
                alt="Active Persona" 
                class="w-full h-full object-cover transition duration-200 hidden" 
              />
              <div id="persona-avatar-placeholder" class="w-full h-full flex flex-col items-center justify-center text-purple-400 bg-gradient-to-tr from-purple-950/60 to-slate-900">
                <User class="w-12 h-12 stroke-[1.5]" />
              </div>
            </div>
            <div class="text-center">
              <h3 id="preview-persona-name" class="text-sm font-bold text-white">Traveler</h3>
              <p id="preview-persona-pronouns" class="text-xs text-purple-400">They/Them</p>
            </div>
          </div>

          <!-- Direct Image Upload Dropzone -->
          <div class="md:col-span-8 space-y-4">
            <!-- Hidden file input -->
            <input 
              type="file" 
              id="persona-avatar-file-input" 
              accept="image/png, image/jpeg, image/webp, image/gif" 
              class="hidden" 
            />

            <!-- Drag & Drop Zone -->
            <div 
              id="persona-avatar-dropzone" 
              class="p-6 rounded-2xl border-2 border-dashed border-white/15 hover:border-purple-500/60 bg-white/[0.02] hover:bg-purple-950/10 transition-all flex flex-col items-center justify-center text-center gap-3 cursor-pointer group"
            >
              <div class="w-12 h-12 rounded-2xl bg-purple-500/10 border border-purple-500/20 group-hover:scale-110 group-hover:border-purple-500/40 flex items-center justify-center text-purple-400 transition">
                <Upload class="w-6 h-6" />
              </div>
              <div class="space-y-1">
                <p class="text-sm font-semibold text-white group-hover:text-purple-300 transition">
                  Click to upload avatar or drag & drop image
                </p>
                <p class="text-xs text-slate-400">
                  Supports PNG, JPG, WebP, GIF (Max 5MB) — Saved locally in browser storage
                </p>
              </div>
            </div>

            <!-- Action Controls -->
            <div class="flex flex-wrap items-center justify-between gap-3 pt-1">
              <div class="flex items-center gap-2">
                <button 
                  type="button" 
                  id="persona-avatar-browse-btn" 
                  class="px-4 py-2 rounded-xl bg-purple-600/20 hover:bg-purple-600/30 border border-purple-500/30 text-purple-300 hover:text-purple-200 text-xs font-semibold flex items-center gap-2 transition cursor-pointer"
                >
                  <Upload class="w-3.5 h-3.5" />
                  <span>Choose Image File</span>
                </button>
                <button 
                  type="button" 
                  id="persona-avatar-remove-btn" 
                  class="px-3.5 py-2 rounded-xl bg-white/[0.04] hover:bg-red-500/20 border border-white/10 hover:border-red-500/30 text-slate-400 hover:text-red-300 text-xs font-semibold flex items-center gap-1.5 transition cursor-pointer"
                  title="Remove avatar and restore default silhouette"
                >
                  <Trash2 class="w-3.5 h-3.5" />
                  <span>Remove Photo</span>
                </button>
              </div>

              <!-- Collapsible for optional direct web image URL (clean, no raw link shown by default) -->
              <details class="text-xs text-slate-400 group/url">
                <summary class="cursor-pointer hover:text-purple-300 transition list-none flex items-center gap-1">
                  <span>Or use external image URL</span>
                  <ChevronRight class="w-3 h-3 group-open/url:rotate-90 transition-transform" />
                </summary>
                <div class="mt-2 flex items-center gap-2">
                  <input 
                    id="persona-avatar-url" 
                    type="url" 
                    placeholder="https://example.com/avatar.jpg" 
                    class="w-64 px-3 py-1.5 rounded-lg bg-white/[0.04] border border-white/10 text-xs text-white placeholder:text-slate-500 outline-none focus:border-purple-500/70"
                  />
                  <button 
                    type="button" 
                    id="persona-avatar-url-apply-btn" 
                    class="px-2.5 py-1.5 rounded-lg bg-white/[0.08] hover:bg-white/[0.15] text-xs text-slate-200 transition cursor-pointer"
                  >
                    Apply
                  </button>
                </div>
              </details>
            </div>
          </div>
        </div>
      </div>

      <!-- Section 2: Identity & Pronouns -->
      <div class="p-6 rounded-3xl bg-[#080a14] border border-white/[0.08] shadow-xl space-y-6">
        <div class="border-b border-white/[0.06] pb-3">
          <h2 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
            <User class="w-5 h-5 text-cyan-400" />
            <span>2. Identity & Macro Replacement</span>
          </h2>
          <p class="text-xs text-slate-400 mt-1">
            Replaces <code class="text-cyan-300">{"{{user}}"}</code> in all greetings, starters, and dialogues.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <!-- Display Name -->
          <div>
            <label for="persona-name" class="block text-xs sm:text-sm font-semibold text-slate-200 mb-1.5">
              Display Name <span class="text-cyan-400 font-mono">({"{{user}}"})</span> <span class="text-rose-400">*</span>
            </label>
            <input 
              id="persona-name" 
              type="text" 
              placeholder="e.g. Jason, Ren, Alex, Traveler" 
              class="w-full px-4 py-3 rounded-2xl bg-white/[0.04] border border-white/10 focus:border-cyan-500/70 text-sm text-white placeholder:text-slate-500 outline-none"
              value="Traveler" 
              required
            />
          </div>

          <!-- Pronouns -->
          <div>
            <label for="persona-pronouns" class="block text-xs sm:text-sm font-semibold text-slate-200 mb-1.5">
              Pronouns
            </label>
            <input 
              id="persona-pronouns" 
              type="text" 
              placeholder="e.g. He/Him, She/Her, They/Them" 
              class="w-full px-4 py-3 rounded-2xl bg-white/[0.04] border border-white/10 focus:border-cyan-500/70 text-sm text-white placeholder:text-slate-500 outline-none"
              value="They/Them" 
            />
          </div>
        </div>

        <!-- Role Archetype / Title -->
        <div>
          <label for="persona-title" class="block text-xs sm:text-sm font-semibold text-slate-200 mb-1.5">
            Archetype / Title
          </label>
          <input 
            id="persona-title" 
            type="text" 
            placeholder="e.g. Rogue Netrunner, Arcane Scholar, Wandering Detective" 
            class="w-full px-4 py-3 rounded-2xl bg-white/[0.04] border border-white/10 focus:border-cyan-500/70 text-sm text-white placeholder:text-slate-500 outline-none"
            value="Explorer of the Nexus" 
          />
        </div>
      </div>

      <!-- Section 3: Persona Description & Appearance -->
      <div class="p-6 rounded-3xl bg-[#080a14] border border-white/[0.08] shadow-xl space-y-6">
        <div class="border-b border-white/[0.06] pb-3 flex items-center justify-between">
          <div>
            <h2 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
              <Sliders class="w-5 h-5 text-emerald-400" />
              <span>3. Persona Description & Sensory Traits</span>
            </h2>
            <p class="text-xs text-slate-400 mt-1">
              Passed to the LLM system prompt so characters know your appearance, traits, and background.
            </p>
          </div>
          <span id="tok-persona-desc" class="text-xs font-mono text-emerald-400 bg-emerald-950/40 px-2.5 py-1 rounded-full border border-emerald-500/30">
            ~0 tok
          </span>
        </div>

        <!-- Persona Description Textarea -->
        <div>
          <textarea 
            id="persona-desc" 
            rows="6" 
            class="w-full px-4 py-3.5 rounded-2xl bg-white/[0.04] border border-white/10 focus:border-emerald-500/70 text-sm sm:text-base text-white placeholder:text-slate-500 outline-none leading-relaxed resize-y min-h-[140px]"
            placeholder="Describe your persona's physical appearance, clothing, demeanor, background, or equipment.&#10;&#10;Example:&#10;Tall build with dark hair and a cybernetic optical scanner over the left eye. Wears a weathered longcoat lined with thermal shielding. Speaks with calm deliberation and prefers subtle diplomacy before drawing weapons."
          ></textarea>
          <p class="text-[11px] text-slate-500 mt-1.5">
            This context allows the AI to react to what you wear, your species, or your physical stature naturally.
          </p>
        </div>
      </div>

      <!-- Section 4: Global AI Guardrails & Directives -->
      <div class="p-6 rounded-3xl bg-[#080a14] border border-white/[0.08] shadow-xl space-y-6">
        <div class="border-b border-white/[0.06] pb-3 flex items-center justify-between">
          <div>
            <h2 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
              <ShieldCheck class="w-5 h-5 text-amber-400" />
              <span>4. Global Guardrails & Instructions</span>
            </h2>
            <p class="text-xs text-slate-400 mt-1">
              Instructions injected into the system prompt for <strong>every character</strong> you chat with.
            </p>
          </div>
          <span id="tok-persona-notes" class="text-xs font-mono text-amber-400 bg-amber-950/40 px-2.5 py-1 rounded-full border border-amber-500/30">
            ~0 tok
          </span>
        </div>

        <!-- Global Instructions Textarea -->
        <div>
          <textarea 
            id="persona-notes" 
            rows="4" 
            class="w-full px-4 py-3.5 rounded-2xl bg-white/[0.04] border border-white/10 focus:border-amber-500/70 text-sm sm:text-base text-white placeholder:text-slate-500 outline-none leading-relaxed resize-y min-h-[110px]"
            placeholder="Global behavior preferences across all characters.&#10;&#10;Example:&#10;Never narrate, speak, or assume actions for &#123;&#123;user&#125;&#125;. Maintain atmospheric immersion. Format sensory actions in *asterisks* and spoken dialogue in quotation marks."
          ></textarea>
        </div>
      </div>

      <!-- Section 5: Data Backup, Import & Vault -->
      <div class="p-6 rounded-3xl bg-[#080a14] border border-white/[0.08] shadow-xl space-y-5">
        <div class="border-b border-white/[0.06] pb-3">
          <h2 class="text-base sm:text-lg font-bold text-white flex items-center gap-2">
            <Download class="w-5 h-5 text-indigo-400" />
            <span>5. Storage, Backup & Data Migration</span>
          </h2>
          <p class="text-xs text-slate-400 mt-1">
            All your personas, custom characters, and chat settings reside in your browser's private storage.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
          <!-- Backup Export -->
          <button 
            type="button" 
            id="export-backup-btn"
            class="p-4 rounded-2xl bg-white/[0.03] hover:bg-white/[0.06] border border-white/10 text-left transition cursor-pointer flex flex-col justify-between gap-3 group"
          >
            <div class="flex items-center justify-between">
              <Download class="w-5 h-5 text-cyan-400 group-hover:scale-110 transition" />
              <span class="text-[10px] text-slate-500 font-mono">.json</span>
            </div>
            <div>
              <h4 class="text-xs font-bold text-white">Export Full Backup</h4>
              <p class="text-[11px] text-slate-400 mt-0.5">Download all personas & custom characters</p>
            </div>
          </button>

          <!-- Backup Import -->
          <label 
            class="p-4 rounded-2xl bg-white/[0.03] hover:bg-white/[0.06] border border-white/10 text-left transition cursor-pointer flex flex-col justify-between gap-3 group"
          >
            <div class="flex items-center justify-between">
              <Upload class="w-5 h-5 text-purple-400 group-hover:scale-110 transition" />
              <span class="text-[10px] text-slate-500 font-mono">Restore</span>
            </div>
            <div>
              <h4 class="text-xs font-bold text-white">Import Backup File</h4>
              <p class="text-[11px] text-slate-400 mt-0.5">Restore data from previous JSON file</p>
            </div>
            <input id="import-backup-file" type="file" accept=".json" class="hidden" />
          </label>

          <!-- Reset / Clear -->
          <button 
            type="button" 
            id="clear-cache-btn"
            class="p-4 rounded-2xl bg-rose-950/20 hover:bg-rose-950/40 border border-rose-500/20 text-left transition cursor-pointer flex flex-col justify-between gap-3 group"
          >
            <div class="flex items-center justify-between">
              <Trash2 class="w-5 h-5 text-rose-400 group-hover:scale-110 transition" />
              <span class="text-[10px] text-rose-400 font-mono">Reset</span>
            </div>
            <div>
              <h4 class="text-xs font-bold text-rose-200">Clear Local Cache</h4>
              <p class="text-[11px] text-rose-400/80 mt-0.5">Erase custom data from this device</p>
            </div>
          </button>
        </div>
      </div>

      <!-- Section 5: Multi-Device Sync & Cloud Vault Hub (Part 5) -->
      <div class="p-6 rounded-3xl bg-[#080a14] border border-cyan-500/20 shadow-xl space-y-6">
        <div class="border-b border-white/[0.06] pb-3 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <Cloud class="w-5 h-5 text-cyan-400" />
            <h3 class="text-base sm:text-lg font-bold text-white">5. Multi-Device Sync & Cloud Vault</h3>
          </div>
          <span class="text-xs px-2.5 py-0.5 rounded-full bg-cyan-500/10 text-cyan-300 border border-cyan-500/20 font-mono">
            Zero-Server E2E
          </span>
        </div>

        <p class="text-xs text-slate-400 leading-relaxed max-w-3xl">
          Instantly transfer all your data (User Personas, Custom Characters, Saved Settings, and Stories) between your Mobile phone and Desktop without sending any private data to external servers.
        </p>

        <!-- Method 1: Instant Device-to-Device Transfer Code -->
        <div class="p-4 sm:p-5 rounded-2xl bg-[#0c0f22] border border-cyan-500/30 space-y-4">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <Smartphone class="w-4 h-4 text-cyan-400" />
              <span class="text-xs font-bold text-white">Quick Device Transfer Code</span>
            </div>
            <span class="text-[10px] text-slate-400 font-mono">Instant P2P Sync</span>
          </div>

          <p class="text-[11px] text-slate-300">
            Generate a compressed sync token to copy on your PC and paste on your mobile device, or vice-versa.
          </p>

          <div class="space-y-2">
            <div class="flex items-center gap-2">
              <button 
                type="button" 
                id="generate-sync-token-btn"
                class="flex items-center gap-1.5 px-4 py-2 rounded-xl bg-cyan-600 hover:bg-cyan-500 text-white text-xs font-bold transition shadow-sm cursor-pointer active:scale-95"
              >
                <CloudUpload class="w-3.5 h-3.5" />
                <span>Generate Transfer Code 📲</span>
              </button>

              <button 
                type="button" 
                id="copy-sync-token-btn"
                class="hidden flex items-center gap-1.5 px-3 py-2 rounded-xl bg-white/[0.06] hover:bg-white/[0.1] text-cyan-300 text-xs font-semibold transition cursor-pointer"
              >
                <Copy class="w-3.5 h-3.5" />
                <span>Copy Code</span>
              </button>
            </div>

            <textarea 
              id="sync-token-box" 
              rows="2" 
              placeholder="Your generated sync token will appear here. Or paste a token from another device to import..."
              class="w-full p-2.5 rounded-xl bg-black/50 border border-white/10 text-slate-300 text-[11px] font-mono outline-none focus:border-cyan-500/50 resize-y"
            ></textarea>

            <button 
              type="button" 
              id="apply-sync-token-btn"
              class="flex items-center gap-1.5 px-4 py-2 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold transition shadow-sm cursor-pointer active:scale-95"
            >
              <CloudDownload class="w-3.5 h-3.5" />
              <span>Apply & Merge Sync Code 🚀</span>
            </button>
          </div>
        </div>

        <!-- Method 2: Encrypted Single-File Vault -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <button 
            type="button" 
            id="export-full-vault-btn"
            class="p-4 rounded-2xl bg-white/[0.03] hover:bg-white/[0.06] border border-cyan-500/20 text-left transition cursor-pointer flex flex-col justify-between gap-3 group"
          >
            <div class="flex items-center justify-between">
              <Download class="w-5 h-5 text-cyan-400 group-hover:scale-110 transition" />
              <span class="text-[10px] text-cyan-400 font-mono">.aetheria-vault</span>
            </div>
            <div>
              <h4 class="text-xs font-bold text-white">Export Full Encrypted Vault</h4>
              <p class="text-[11px] text-slate-400 mt-0.5">Complete bundle of all chats, branches, personas & lore</p>
            </div>
          </button>

          <label 
            class="p-4 rounded-2xl bg-white/[0.03] hover:bg-white/[0.06] border border-cyan-500/20 text-left transition cursor-pointer flex flex-col justify-between gap-3 group"
          >
            <div class="flex items-center justify-between">
              <Upload class="w-5 h-5 text-cyan-400 group-hover:scale-110 transition" />
              <span class="text-[10px] text-cyan-400 font-mono">Restore</span>
            </div>
            <div>
              <h4 class="text-xs font-bold text-white">Import Encrypted Vault</h4>
              <p class="text-[11px] text-slate-400 mt-0.5">Restore or merge complete workspace on new device</p>
            </div>
            <input id="import-full-vault-input" type="file" accept=".json,.aetheria-vault" class="hidden" />
          </label>
        </div>

      </div>

      <!-- Bottom Sticky Save Bar -->
      <div class="sticky bottom-4 z-40 p-4 rounded-3xl bg-[#090b17]/95 backdrop-blur-2xl border border-white/10 shadow-2xl flex items-center justify-between gap-3">
        <div class="hidden sm:flex items-center gap-2 text-xs text-slate-400">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>Ready to synchronize with active session</span>
        </div>

        <div class="flex items-center gap-2.5 w-full sm:w-auto justify-end">
          <button 
            type="button" 
            id="reset-form-btn"
            class="px-4 py-3 rounded-2xl bg-white/[0.05] hover:bg-white/[0.1] border border-white/10 text-xs font-semibold text-slate-300 hover:text-white transition cursor-pointer"
          >
            Reset Fields
          </button>

          <button 
            type="submit" 
            id="save-persona-btn"
            class="flex-1 sm:flex-initial px-7 py-3 rounded-2xl bg-gradient-to-r from-emerald-600 via-teal-600 to-emerald-600 hover:from-emerald-500 hover:to-teal-500 text-xs sm:text-sm font-bold text-white shadow-lg shadow-emerald-950/50 flex items-center justify-center gap-2 transition cursor-pointer active:scale-95"
          >
            <Save class="w-4 h-4" />
            <span>Save Persona</span>
          </button>
        </div>
      </div>

    </form>

    <!-- Toast Notification -->
    <div id="status-toast" class="fixed bottom-6 right-6 z-50 hidden p-3.5 rounded-2xl bg-emerald-950/90 border border-emerald-500/50 text-xs text-emerald-100 flex items-center gap-2.5 shadow-2xl backdrop-blur-xl">
      <Check class="w-4 h-4 text-emerald-400 shrink-0" />
      <span id="toast-text">Persona saved successfully!</span>
    </div>

  </main>

  <BottomNav />
</Layout>

<script>
  // ================= STORAGE CONSTANTS =================
  const STORAGE_KEY_PERSONAS = 'aetheria_saved_personas';
  const STORAGE_KEY_ACTIVE = 'aetheria_user_persona';
  const STORAGE_KEY_CUSTOM_CHARS = 'aetheria_custom_characters';

  interface UserPersona {
    id: string;
    name: string;
    pronouns: string;
    title: string;
    avatar: string;
    bio: string;
    globalNotes: string;
  }

  const DEFAULT_PERSONA: UserPersona = {
    id: 'default',
    name: 'Traveler',
    pronouns: 'They/Them',
    title: 'Explorer of the Nexus',
    avatar: '',
    bio: 'A resilient traveler walking the neon-drenched frontiers of the Aetheria nexus. Observant, curious, and quick to adapt to unpredictable environments.',
    globalNotes: 'Never speak, narrate, or assume actions for {{user}}. Maintain atmospheric immersion. Format sensory actions in *asterisks* and spoken dialogue in quotes.'
  };

  // Form DOM elements
  const form = document.getElementById('persona-form') as HTMLFormElement;
  const nameInput = document.getElementById('persona-name') as HTMLInputElement;
  const pronounsInput = document.getElementById('persona-pronouns') as HTMLInputElement;
  const titleInput = document.getElementById('persona-title') as HTMLInputElement;
  const avatarInput = document.getElementById('persona-avatar-url') as HTMLInputElement;
  const descInput = document.getElementById('persona-desc') as HTMLTextAreaElement;
  const notesInput = document.getElementById('persona-notes') as HTMLTextAreaElement;

  const avatarPreview = document.getElementById('persona-avatar-preview') as HTMLImageElement;
  const avatarPlaceholder = document.getElementById('persona-avatar-placeholder');
  const avatarFileInput = document.getElementById('persona-avatar-file-input') as HTMLInputElement;
  const avatarDropzone = document.getElementById('persona-avatar-dropzone');
  const avatarBrowseBtn = document.getElementById('persona-avatar-browse-btn');
  const avatarRemoveBtn = document.getElementById('persona-avatar-remove-btn');
  const avatarUrlApplyBtn = document.getElementById('persona-avatar-url-apply-btn');
  const previewName = document.getElementById('preview-persona-name') as HTMLElement;
  const previewPronouns = document.getElementById('preview-persona-pronouns') as HTMLElement;

  let currentAvatarData = '';

  const tokDesc = document.getElementById('tok-persona-desc') as HTMLElement;
  const tokNotes = document.getElementById('tok-persona-notes') as HTMLElement;

  const personaTabsContainer = document.getElementById('persona-tabs-container') as HTMLElement;
  const addPersonaBtn = document.getElementById('add-persona-btn');
  const exportBackupBtn = document.getElementById('export-backup-btn');
  const importBackupFile = document.getElementById('import-backup-file') as HTMLInputElement;
  const clearCacheBtn = document.getElementById('clear-cache-btn');
  const resetFormBtn = document.getElementById('reset-form-btn');
  const toast = document.getElementById('status-toast') as HTMLElement;
  const toastText = document.getElementById('toast-text') as HTMLElement;

  const personaCountBadge = document.getElementById('persona-count-badge') as HTMLElement;
  const charCountBadge = document.getElementById('char-count-badge') as HTMLElement;

  let personas: UserPersona[] = [];
  let activeId = 'default';

  function showToast(msg: string) {
    if (!toast || !toastText) return;
    toastText.textContent = msg;
    toast.classList.remove('hidden');
    setTimeout(() => {
      toast.classList.add('hidden');
    }, 3500);
  }

    // Modern Glassmorphic Dialog Modal
  function showConfirmModal({
    title = 'Confirm Action',
    message = 'Are you sure you want to proceed?',
    confirmText = 'Confirm',
    cancelText = 'Cancel',
    type = 'default',
    icon = ''
  }: {
    title?: string;
    message?: string;
    confirmText?: string;
    cancelText?: string;
    type?: string;
    icon?: string;
  } = {}): Promise<boolean> {
    return new Promise((resolve) => {
      const isDanger = type === 'danger';
      const isWarning = type === 'warning';
      const iconDisplay = icon || (isDanger ? '🗑️' : isWarning ? '⚠️' : '✨');

      const backdrop = document.createElement('div');
      backdrop.className = 'fixed inset-0 z-[10000] flex items-center justify-center p-4 bg-black/75 backdrop-blur-md transition-opacity duration-200 opacity-0';
      
      const modal = document.createElement('div');
      modal.className = 'w-full max-w-sm rounded-3xl bg-[#0d1124]/95 border border-purple-500/30 p-5 sm:p-6 shadow-2xl shadow-purple-950/80 transform scale-95 transition-all duration-200 text-left';

      const cancelBtnHtml = cancelText ? `
        <button id="modal-btn-cancel" type="button" class="px-4 py-2 rounded-xl text-xs font-medium text-slate-300 hover:text-white bg-white/5 hover:bg-white/10 border border-white/10 transition-all cursor-pointer">
          ${cancelText}
        </button>
      ` : '';

      const confirmBtnClass = isDanger
        ? 'bg-rose-600 hover:bg-rose-500 text-white shadow-lg shadow-rose-900/40 border border-rose-500/40'
        : 'bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white shadow-lg shadow-purple-900/40 border border-purple-500/40';

      modal.innerHTML = `
        <div class="flex items-start gap-3.5">
          <div class="w-10 h-10 rounded-2xl flex items-center justify-center shrink-0 text-xl ${
            isDanger ? 'bg-rose-500/15 border border-rose-500/30 text-rose-400' : isWarning ? 'bg-amber-500/15 border border-amber-500/30 text-amber-400' : 'bg-purple-500/15 border border-purple-500/30 text-purple-300'
          }">
            ${iconDisplay}
          </div>
          <div class="flex-1 min-w-0">
            <h3 class="text-sm font-bold text-white tracking-wide">${title}</h3>
            <p class="mt-1.5 text-xs text-slate-300 leading-relaxed">${message}</p>
          </div>
        </div>
        <div class="mt-6 flex items-center justify-end gap-2.5">
          ${cancelBtnHtml}
          <button id="modal-btn-confirm" type="button" class="px-4 py-2 rounded-xl text-xs font-semibold shadow-lg transition-all cursor-pointer ${confirmBtnClass}">
            ${confirmText}
          </button>
        </div>
      `;

      backdrop.appendChild(modal);
      document.body.appendChild(backdrop);

      requestAnimationFrame(() => {
        backdrop.classList.remove('opacity-0');
        modal.classList.remove('scale-95');
      });

      const cleanup = (confirmed: boolean) => {
        backdrop.classList.add('opacity-0');
        modal.classList.add('scale-95');
        setTimeout(() => backdrop.remove(), 200);
        window.removeEventListener('keydown', onKeyDown);
        resolve(confirmed);
      };

      const confirmBtn = modal.querySelector('#modal-btn-confirm') as HTMLButtonElement | null;
      const cancelBtn = modal.querySelector('#modal-btn-cancel') as HTMLButtonElement | null;
      if (confirmBtn) confirmBtn.onclick = () => cleanup(true);
      if (cancelBtn) cancelBtn.onclick = () => cleanup(false);
      backdrop.onclick = (e) => {
        if (e.target === backdrop) cleanup(false);
      };

      const onKeyDown = (e: KeyboardEvent) => {
        if (e.key === 'Escape') cleanup(false);
        else if (e.key === 'Enter') cleanup(true);
      };
      window.addEventListener('keydown', onKeyDown);
    });
  }

  function showAlertModal(message: string, title = 'System Notice', icon = 'ℹ️') {
    return showConfirmModal({
      title,
      message,
      confirmText: 'Got It',
      cancelText: '',
      type: 'info',
      icon
    });
  }

  function countTokens(text: string): number {
    return Math.ceil(text.trim().length / 4);
  }

  function updateTokenCounters() {
    if (tokDesc) tokDesc.textContent = `~${countTokens(descInput.value)} tok`;
    if (tokNotes) tokNotes.textContent = `~${countTokens(notesInput.value)} tok`;
  }

  function updateAvatarDisplay(url: string) {
    if (url && url.trim()) {
      avatarPreview.src = url;
      avatarPreview.classList.remove('hidden');
      avatarPlaceholder?.classList.add('hidden');
    } else {
      avatarPreview.src = '';
      avatarPreview.classList.add('hidden');
      avatarPlaceholder?.classList.remove('hidden');
    }
  }

  function processAvatarFile(file: File) {
    if (!file || !file.type.startsWith('image/')) {
      showToast('Please select a valid image file (PNG, JPG, WebP, GIF).');
      return;
    }
    if (file.size > 8 * 1024 * 1024) {
      showToast('File size is too large (Max 8MB).');
      return;
    }

    const reader = new FileReader();
    reader.onload = (e) => {
      const img = new Image();
      img.onload = () => {
        const canvas = document.createElement('canvas');
        const maxSize = 400;
        let width = img.width;
        let height = img.height;
        if (width > height) {
          if (width > maxSize) {
            height = Math.round((height * maxSize) / width);
            width = maxSize;
          }
        } else {
          if (height > maxSize) {
            width = Math.round((width * maxSize) / height);
            height = maxSize;
          }
        }
        canvas.width = width;
        canvas.height = height;
        const ctx = canvas.getContext('2d');
        if (ctx) {
          ctx.drawImage(img, 0, 0, width, height);
          const compressedDataUrl = canvas.toDataURL('image/webp', 0.85);
          currentAvatarData = compressedDataUrl;
          if (avatarInput) avatarInput.value = '';
          updateAvatarDisplay(compressedDataUrl);
          showToast('Avatar image loaded! Click "Save Persona" to apply.');
        }
      };
      img.src = e.target?.result as string;
    };
    reader.readAsDataURL(file);
  }

  function updatePreview() {
    if (previewName) previewName.textContent = nameInput.value.trim() || 'Traveler';
    if (previewPronouns) previewPronouns.textContent = pronounsInput.value.trim() || 'They/Them';
  }

  function loadPersonasFromStorage() {
    try {
      const saved = localStorage.getItem(STORAGE_KEY_PERSONAS);
      if (saved) {
        personas = JSON.parse(saved);
        personas.forEach(p => {
          if (p.avatar && p.avatar.startsWith('/avatars/')) p.avatar = '';
        });
      } else {
        // Fallback to active single persona if exists
        const single = localStorage.getItem(STORAGE_KEY_ACTIVE);
        if (single) {
          const parsed = JSON.parse(single);
          if (parsed.avatar && parsed.avatar.startsWith('/avatars/')) parsed.avatar = '';
          personas = [{ ...DEFAULT_PERSONA, ...parsed, id: 'default' }];
        } else {
          personas = [{ ...DEFAULT_PERSONA }];
        }
      }

      const active = localStorage.getItem(STORAGE_KEY_ACTIVE);
      if (active) {
        const parsed = JSON.parse(active);
        activeId = parsed.id || personas[0]?.id || 'default';
      } else {
        activeId = personas[0]?.id || 'default';
      }
    } catch {
      personas = [{ ...DEFAULT_PERSONA }];
      activeId = 'default';
    }

    renderTabs();
    populateFormWithActive();
    updateBadges();
  }

  function updateBadges() {
    if (personaCountBadge) personaCountBadge.textContent = String(personas.length);
    if (charCountBadge) {
      try {
        const customChars = JSON.parse(localStorage.getItem(STORAGE_KEY_CUSTOM_CHARS) || '[]');
        charCountBadge.textContent = String(customChars.length);
      } catch {
        charCountBadge.textContent = '0';
      }
    }
  }

  function renderTabs() {
    if (!personaTabsContainer) return;
    personaTabsContainer.innerHTML = '';

    personas.forEach(p => {
      const isActive = p.id === activeId;
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = `flex items-center gap-2 px-3.5 py-1.5 rounded-xl text-xs font-semibold transition cursor-pointer ${
        isActive 
          ? 'bg-purple-600 text-white shadow-md shadow-purple-900/40 ring-1 ring-purple-400/50' 
          : 'bg-white/[0.04] text-slate-400 hover:text-white hover:bg-white/[0.08]'
      }`;
      btn.innerHTML = `
        <span class="w-1.5 h-1.5 rounded-full ${isActive ? 'bg-cyan-300 animate-pulse' : 'bg-slate-500'}"></span>
        <span>${p.name || 'Unnamed'}</span>
      `;
      btn.addEventListener('click', () => {
        saveCurrentFormToActiveInMemory();
        activeId = p.id;
        renderTabs();
        populateFormWithActive();
      });
      personaTabsContainer.appendChild(btn);
    });
  }

  function populateFormWithActive() {
    const active = personas.find(p => p.id === activeId) || personas[0] || DEFAULT_PERSONA;
    nameInput.value = active.name || '';
    pronounsInput.value = active.pronouns || '';
    titleInput.value = active.title || '';

    // Purge legacy preset avatar paths if found
    let av = active.avatar || '';
    if (av.startsWith('/avatars/')) {
      av = '';
    }
    currentAvatarData = av;
    avatarInput.value = av.startsWith('http') ? av : '';
    updateAvatarDisplay(currentAvatarData);

    descInput.value = active.bio || '';
    notesInput.value = active.globalNotes || '';

    updatePreview();
    updateTokenCounters();
  }

  function saveCurrentFormToActiveInMemory() {
    const current: UserPersona = {
      id: activeId,
      name: nameInput.value.trim() || 'Traveler',
      pronouns: pronounsInput.value.trim() || 'They/Them',
      title: titleInput.value.trim() || 'Explorer',
      avatar: currentAvatarData || avatarInput.value.trim() || '',
      bio: descInput.value.trim(),
      globalNotes: notesInput.value.trim()
    };

    const idx = personas.findIndex(p => p.id === activeId);
    if (idx !== -1) {
      personas[idx] = current;
    } else {
      personas.push(current);
    }
    return current;
  }

  function saveAllToStorage() {
    const active = saveCurrentFormToActiveInMemory();
    localStorage.setItem(STORAGE_KEY_PERSONAS, JSON.stringify(personas));
    localStorage.setItem(STORAGE_KEY_ACTIVE, JSON.stringify(active));
    renderTabs();
    updateBadges();
    showToast(`Persona "${active.name}" saved! Activated for all chats.`);
  }

  // File upload and avatar listeners
  avatarBrowseBtn?.addEventListener('click', () => avatarFileInput?.click());
  avatarDropzone?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('button')) return;
    avatarFileInput?.click();
  });
  avatarFileInput?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) processAvatarFile(file);
  });

  avatarDropzone?.addEventListener('dragover', (e) => {
    e.preventDefault();
    avatarDropzone.classList.add('border-purple-500', 'bg-purple-950/20');
  });
  avatarDropzone?.addEventListener('dragleave', () => {
    avatarDropzone.classList.remove('border-purple-500', 'bg-purple-950/20');
  });
  avatarDropzone?.addEventListener('drop', (e) => {
    e.preventDefault();
    avatarDropzone.classList.remove('border-purple-500', 'bg-purple-950/20');
    const file = e.dataTransfer?.files?.[0];
    if (file) processAvatarFile(file);
  });

  avatarRemoveBtn?.addEventListener('click', () => {
    currentAvatarData = '';
    if (avatarInput) avatarInput.value = '';
    updateAvatarDisplay('');
    showToast('Avatar removed. Restored default silhouette.');
  });

  avatarUrlApplyBtn?.addEventListener('click', () => {
    const url = avatarInput.value.trim();
    if (url) {
      currentAvatarData = url;
      updateAvatarDisplay(url);
      showToast('Custom avatar URL applied! Click "Save Persona".');
    }
  });

  // Inputs live change
  [nameInput, pronounsInput, titleInput, avatarInput].forEach(inp => {
    inp?.addEventListener('input', updatePreview);
  });
  descInput?.addEventListener('input', updateTokenCounters);
  notesInput?.addEventListener('input', updateTokenCounters);

  // Form submit
  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    saveAllToStorage();
  });

  // Add new persona
  addPersonaBtn?.addEventListener('click', () => {
    saveCurrentFormToActiveInMemory();
    const newId = 'persona_' + Date.now();
    const newPersona: UserPersona = {
      ...DEFAULT_PERSONA,
      id: newId,
      name: `Persona ${personas.length + 1}`,
      title: 'New Roleplay Persona'
    };
    personas.push(newPersona);
    activeId = newId;
    renderTabs();
    populateFormWithActive();
    showToast('New persona profile created. Customize and save!');
  });

  // Reset Form
  resetFormBtn?.addEventListener('click', async () => {
    const confirmed = await showConfirmModal({
      title: 'Reset Persona',
      message: 'Reset this persona form to saved profile defaults?',
      confirmText: 'Reset Form',
      cancelText: 'Cancel',
      icon: '🔄',
      type: 'warning'
    });
    if (confirmed) {
      populateFormWithActive();
      showToast('Form reset to saved profile.');
    }
  });

  // Export Full Backup
  exportBackupBtn?.addEventListener('click', () => {
    saveCurrentFormToActiveInMemory();
    const backupData = {
      timestamp: new Date().toISOString(),
      version: '1.0',
      activePersona: personas.find(p => p.id === activeId) || personas[0],
      personas: personas,
      customCharacters: JSON.parse(localStorage.getItem(STORAGE_KEY_CUSTOM_CHARS) || '[]'),
      apiSettings: {
        provider: localStorage.getItem('aetheria_text_provider'),
        model: localStorage.getItem('aetheria_text_model'),
        temp: localStorage.getItem('aetheria_text_temp'),
        tokens: localStorage.getItem('aetheria_text_tokens')
      }
    };

    const blob = new Blob([JSON.stringify(backupData, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `aetheria_backup_${new Date().toISOString().slice(0, 10)}.json`;
    a.click();
    URL.revokeObjectURL(url);
    showToast('Aetheria complete backup exported successfully!');
  });

  // Import Backup File
  importBackupFile?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = (event) => {
      try {
        const data = JSON.parse(event.target?.result as string);
        if (data.personas && Array.isArray(data.personas)) {
          personas = data.personas;
          localStorage.setItem(STORAGE_KEY_PERSONAS, JSON.stringify(personas));
        }
        if (data.activePersona) {
          activeId = data.activePersona.id || personas[0]?.id || 'default';
          localStorage.setItem(STORAGE_KEY_ACTIVE, JSON.stringify(data.activePersona));
        }
        if (data.customCharacters && Array.isArray(data.customCharacters)) {
          localStorage.setItem(STORAGE_KEY_CUSTOM_CHARS, JSON.stringify(data.customCharacters));
        }
        renderTabs();
        populateFormWithActive();
        updateBadges();
        showToast('Backup restored successfully! All data loaded.');
      } catch (err) {
        showToast('Invalid JSON backup file format.');
      }
    };
    reader.readAsText(file);
  });

  // Clear Local Cache
  clearCacheBtn?.addEventListener('click', async () => {
    const confirmed = await showConfirmModal({
      title: 'Clear Local Cache',
      message: 'Are you sure you want to clear all local personas and custom characters? This action cannot be undone unless you have a backup.',
      confirmText: 'Clear All Data',
      cancelText: 'Cancel',
      icon: '🗑️',
      type: 'danger'
    });
    if (confirmed) {
      localStorage.removeItem(STORAGE_KEY_PERSONAS);
      localStorage.removeItem(STORAGE_KEY_ACTIVE);
      localStorage.removeItem(STORAGE_KEY_CUSTOM_CHARS);
      personas = [{ ...DEFAULT_PERSONA }];
      activeId = 'default';
      renderTabs();
      populateFormWithActive();
      updateBadges();
      showToast('Local cache cleared. Restored factory state.');
    }
  });

  // ==========================================
  // PART 5: MULTI-DEVICE SYNC & CLOUD VAULT
  // ==========================================
  const generateSyncBtn = document.getElementById('generate-sync-token-btn');
  const copySyncBtn = document.getElementById('copy-sync-token-btn');
  const applySyncBtn = document.getElementById('apply-sync-token-btn');
  const syncTokenBox = document.getElementById('sync-token-box') as HTMLTextAreaElement | null;
  const exportFullVaultBtn = document.getElementById('export-full-vault-btn');
  const importFullVaultInput = document.getElementById('import-full-vault-input') as HTMLInputElement | null;

  function gatherFullVaultPayload() {
    const payload: Record<string, any> = {
      version: '1.0.0',
      exportedAt: new Date().toISOString(),
      keys: {}
    };

    for (let i = 0; i < localStorage.length; i++) {
      const key = localStorage.key(i);
      if (key && key.startsWith('aetheria_')) {
        try {
          payload.keys[key] = JSON.parse(localStorage.getItem(key) || 'null');
        } catch {
          payload.keys[key] = localStorage.getItem(key);
        }
      }
    }
    return payload;
  }

  function applyFullVaultPayload(payload: any) {
    if (!payload || !payload.keys || typeof payload.keys !== 'object') {
      throw new Error('Invalid vault payload format.');
    }

    let importedCount = 0;
    Object.keys(payload.keys).forEach(k => {
      const val = payload.keys[k];
      if (val !== undefined && val !== null) {
        if (typeof val === 'object') {
          localStorage.setItem(k, JSON.stringify(val));
        } else {
          localStorage.setItem(k, String(val));
        }
        importedCount++;
      }
    });

    loadPersonasFromStorage();
    return importedCount;
  }

  // Generate Transfer Code
  generateSyncBtn?.addEventListener('click', () => {
    try {
      const payload = gatherFullVaultPayload();
      const rawStr = JSON.stringify(payload);
      const encoded = btoa(encodeURIComponent(rawStr).replace(/%([0-9A-F]{2})/g, (_, p1) => String.fromCharCode(parseInt(p1, 16))));
      
      if (syncTokenBox) {
        syncTokenBox.value = encoded;
      }
      copySyncBtn?.classList.remove('hidden');
      showToast('Transfer code generated! Ready to copy.');
    } catch (err: any) {
      showToast('Failed to generate code: ' + err.message);
    }
  });

  // Copy Transfer Code
  copySyncBtn?.addEventListener('click', () => {
    if (syncTokenBox && syncTokenBox.value) {
      navigator.clipboard.writeText(syncTokenBox.value).then(() => {
        showToast('Transfer code copied to clipboard!');
      });
    }
  });

  // Apply Transfer Code
  applySyncBtn?.addEventListener('click', () => {
    const code = syncTokenBox?.value.trim();
    if (!code) {
      showToast('Please paste a transfer code into the box first.');
      return;
    }

    try {
      const decodedStr = decodeURIComponent(Array.prototype.map.call(atob(code), (c: string) => {
        return '%' + ('00' + c.charCodeAt(0).toString(16)).slice(-2);
      }).join(''));

      const payload = JSON.parse(decodedStr);
      const count = applyFullVaultPayload(payload);
      showToast(`Successfully synchronized ${count} workspace keys!`);
    } catch (err: any) {
      showToast('Failed to apply sync token: ' + err.message);
    }
  });

  // Export Full Vault File
  exportFullVaultBtn?.addEventListener('click', () => {
    const payload = gatherFullVaultPayload();
    const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `aetheria_vault_${new Date().toISOString().slice(0, 10)}.aetheria-vault`;
    a.click();
    URL.revokeObjectURL(url);
    showToast('Encrypted vault exported successfully!');
  });

  // Import Full Vault File
  importFullVaultInput?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = (event) => {
      try {
        const payload = JSON.parse(event.target?.result as string);
        const count = applyFullVaultPayload(payload);
        showToast(`Workspace restored! Merged ${count} data records.`);
      } catch (err: any) {
        showToast('Failed to import vault: ' + err.message);
      }
    };
    reader.readAsText(file);
  });

  // Initial load
  loadPersonasFromStorage();
</script>
