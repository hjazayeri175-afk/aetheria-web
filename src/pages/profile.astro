              tabAvatarBorder.className = 'whitespace-nowrap text-xs font-semibold flex-1 py-2 px-3 rounded-xl flex items-center justify-center gap-2 transition-all cursor-pointer text-slate-400 hover:text-white';
            } else {
              tabAvatarBorder.className = 'whitespace-nowrap text-xs font-semibold flex-1 py-2 px-3 rounded-xl flex items-center justify-center gap-2 transition-all cursor-pointer bg-purple-600 text-white shadow-sm';
              tabNameColors.className = 'whitespace-nowrap text-xs font-semibold flex-1 py-2 px-3 rounded-xl flex items-center justify-center gap-2 transition-all cursor-pointer text-slate-400 hover:text-white';
            }
          }

          if (viewTabName && viewTabAvatar) {
            const previewChatCard = document.getElementById('preview-chat-card');
            if (isName) {
              viewTabName.classList.remove('hidden');
              viewTabAvatar.classList.add('hidden');
              if (previewChatCard) previewChatCard.classList.remove('hidden');
            } else {
              viewTabName.classList.add('hidden');
              viewTabAvatar.classList.remove('hidden');
              if (previewChatCard) previewChatCard.classList.add('hidden');
              renderBorderEffects();
              renderGlowColors();
              updateLivePreview();
            }
          }
        }

        tabNameColors?.addEventListener('click', () => switchTab('name'));
        tabAvatarBorder?.addEventListener('click', () => switchTab('avatar'));

        function applyNameToElement(el: HTMLElement | null, text: string, color: string) {
          if (!el) return;
          const isGrad = color && color.includes('gradient');
          if (isGrad) {
            el.style.backgroundImage = color;
            el.style.webkitBackgroundClip = 'text';
            el.style.backgroundClip = 'text';
            el.style.webkitTextFillColor = 'transparent';
            el.style.color = 'transparent';
          } else {
            el.style.backgroundImage = 'none';
            el.style.webkitBackgroundClip = '';
            el.style.backgroundClip = '';
            el.style.webkitTextFillColor = '';
            el.style.color = color || '#a855f7';
          }
          el.textContent = text || 'Hossein';
        }

        // Reusable Discord-Style Avatar Decoration Overlay Engine
        // Reusable Discord-Grade Illustrated & Animated Avatar Decoration Engine
        function renderDecorationOverlayHtml(decoId: string, glowColor: string, customUrl?: string) {
          if (!decoId || decoId === 'none') return '';
          if (decoId === 'custom') {
            if (customUrl) {
              return `<img src="${customUrl}" alt="Custom Decoration" class="w-full h-full object-contain pointer-events-none select-none" draggable="false" />`;
            }
            return `
              <div class="w-full h-full rounded-full border-2 border-dashed border-pink-400/60 flex items-center justify-center text-pink-400 text-sm font-bold bg-pink-500/10">
                🔗
              </div>
            `;
          }

          // Legacy alias mapping
          let normalized = decoId;
          if (decoId === 'glow' || decoId === 'dual-gradient' || decoId === 'dynamic-sparkle' || decoId === 'royal-crown') normalized = 'starlight-tiara';
          else if (decoId === 'plasma-vortex') normalized = 'cosmic-fire';
          else if (decoId === 'sakura-drift') normalized = 'sakura-garland';
          else if (decoId === 'solar-flare') normalized = 'kitsune-flame';
          else if (decoId === 'emerald-pulse' || decoId === 'cyber-spin') normalized = 'cyber-oni';
          else if (decoId === 'void-eclipse') normalized = 'abyssal-blade';

          const deco = OFFICIAL_DECORATIONS[normalized];
          if (deco) {
            return `<img src="${deco.asset}" alt="${deco.title}" class="w-full h-full object-contain pointer-events-none select-none" draggable="false" />`;
          }
          return '';
        }

        // Discord Layering Architecture: Base Avatar 100% circle + Centered 122% Overlay
        function renderDecoratedAvatarHtml(opts: { src?: string; initial?: string; decoration?: string; glowColor?: string; size?: number; customUrl?: string; useThumb?: boolean }) {
          const size = opts.size || 56;
          const deco = opts.decoration || 'none';
          const src = opts.src || '';
          const initial = (opts.initial || 'H').charAt(0).toUpperCase();
          const overlaySize = Math.round(size * 1.22);
          const overlayOffset = Math.round((size - overlaySize) / 2);

          let overlayHtml = '';
          if (deco !== 'none') {
            if (opts.customUrl) {
              overlayHtml = `<img src="${opts.customUrl}" alt="Deco" class="w-full h-full object-contain pointer-events-none select-none" draggable="false" />`;
            } else if (OFFICIAL_DECORATIONS[deco]) {
              const assetUrl = opts.useThumb ? OFFICIAL_DECORATIONS[deco].thumb : OFFICIAL_DECORATIONS[deco].asset;
              overlayHtml = `<img src="${assetUrl}" alt="${OFFICIAL_DECORATIONS[deco].title}" class="w-full h-full object-contain pointer-events-none select-none" draggable="false" loading="lazy" />`;
            }
          }

          const avatarContent = src
            ? `<img src="${src}" alt="Avatar" class="w-full h-full rounded-full object-cover" onerror="this.style.display='none'" />`
            : `<span class="text-white font-bold select-none" style="font-size: ${Math.round(size * 0.42)}px;">${initial}</span>`;

          return `
            <div class="relative inline-flex items-center justify-center shrink-0 select-none overflow-visible" style="width: ${size}px; height: ${size}px;">
              <!-- 1. Clipped Circular Avatar Base -->
              <div class="w-full h-full rounded-full overflow-hidden relative z-10 flex items-center justify-center bg-gradient-to-tr from-purple-600 to-indigo-600 shadow-inner deco-tile-base border border-white/10">
                ${avatarContent}
              </div>

              <!-- 2. Discord-Grade Official Overlay (122% scale centered over circle) -->
              ${overlayHtml ? `
                <div class="absolute pointer-events-none z-20 flex items-center justify-center overflow-visible" style="width: ${overlaySize}px; height: ${overlaySize}px; top: ${overlayOffset}px; left: ${overlayOffset}px;">
                  ${overlayHtml}
                </div>
              ` : ''}
            </div>
          `;
        }

        // Live Preview Updater
        function updateLivePreview() {
          const active = personas.find(p => p.isActive) || personas[0] || { name: 'Hossein' };
          const userName = active.name || 'Hossein';

          // 1. Pinned Preview Avatar & Name (in Chat Bubble Card)
          const previewName = document.getElementById('preview-user-name');
          const previewBadge = document.getElementById('preview-user-badge');
          applyNameToElement(previewName, userName, draftNameColor);
          if (previewBadge) {
            previewBadge.innerHTML = renderBadgeHtml(draftNameIcon, 'w-4 h-4 inline-block object-contain align-middle ml-1 shrink-0');
          }

          // 2. Chat Bubble Sender Name & Badge
          const bubbleName = document.getElementById('preview-bubble-name');
          const bubbleBadge = document.getElementById('preview-bubble-badge');
          applyNameToElement(bubbleName, userName, draftNameColor);
          if (bubbleBadge) {
            bubbleBadge.innerHTML = renderBadgeHtml(draftNameIcon, 'w-3.5 h-3.5 inline-block object-contain align-middle ml-1 shrink-0');
          }

          // 3. Compact Avatar in Chat Preview Card
          const avatarContainer = document.getElementById('preview-avatar-container');
          const decoLayer = document.getElementById('preview-avatar-deco-layer');
          const avatarImg = document.getElementById('preview-avatar-img') as HTMLImageElement;
          const avatarInitial = document.getElementById('preview-avatar-initial');

          if (avatarContainer) {
            avatarContainer.style.setProperty('--avatar-glow-color', draftGlowColor);
            avatarContainer.style.setProperty('--avatar-border-color', draftGlowColor);
          }
          if (decoLayer) {
            decoLayer.innerHTML = renderDecorationOverlayHtml(draftBorderEffect, draftGlowColor, draftCustomDecoUrl);
          }

          if (avatarImg && avatarInitial) {
            if (active.avatar) {
              avatarImg.src = active.avatar;
              avatarImg.classList.remove('hidden');
              avatarInitial.classList.add('hidden');
            } else {
              avatarImg.src = '';
              avatarImg.classList.add('hidden');
              avatarInitial.classList.remove('hidden');
              avatarInitial.textContent = (userName || 'H').charAt(0).toUpperCase();
            }
          }

          // 4. Large 100px Hero Showcase Stage in Avatar & Border Tab
          const heroContainer = document.getElementById('hero-avatar-container');
          const heroDecoLayer = document.getElementById('hero-avatar-deco-layer');
          const heroAvatarImg = document.getElementById('hero-avatar-img') as HTMLImageElement;
          const heroAvatarInitial = document.getElementById('hero-avatar-initial');
          const heroUserName = document.getElementById('hero-user-name');
          const heroUserBadge = document.getElementById('hero-user-badge');
          const heroDecoTitle = document.getElementById('hero-deco-title');

          if (heroDecoLayer) {
            heroDecoLayer.innerHTML = renderDecorationOverlayHtml(draftBorderEffect, draftGlowColor, draftCustomDecoUrl);
          }
          if (heroAvatarImg && heroAvatarInitial) {
            if (active.avatar) {
              heroAvatarImg.src = active.avatar;
              heroAvatarImg.classList.remove('hidden');
              heroAvatarInitial.classList.add('hidden');
              heroAvatarImg.onerror = () => {
                heroAvatarImg.classList.add('hidden');
                heroAvatarInitial.classList.remove('hidden');
              };
            } else {
              heroAvatarImg.src = '';
              heroAvatarImg.classList.add('hidden');
              heroAvatarInitial.classList.remove('hidden');
              heroAvatarInitial.textContent = (userName || 'H').charAt(0).toUpperCase();
            }
          }
          if (heroUserName) {
            let contrastColor = draftNameColor;
            if (contrastColor && !contrastColor.includes('gradient')) {
              try {
                const clean = contrastColor.replace('#', '');
                if (clean.length === 6) {
                  const r = parseInt(clean.substring(0, 2), 16);
                  const g = parseInt(clean.substring(2, 4), 16);
                  const b = parseInt(clean.substring(4, 6), 16);
                  const lum = (0.299 * r + 0.587 * g + 0.114 * b) / 255;
                  if (lum < 0.42) {
                    contrastColor = '#f8fafc'; // Ensure bright contrast on dark showcase stage!
                  }
                }
              } catch (e) {}
            }
            applyNameToElement(heroUserName, userName, contrastColor || '#f8fafc');
            heroUserName.style.textShadow = '0 2px 8px rgba(0,0,0,0.8)';
          }
          if (heroUserBadge) {
            heroUserBadge.innerHTML = renderBadgeHtml(draftNameIcon, 'w-4 h-4 inline-block object-contain align-middle ml-1 shrink-0');
          }
          if (heroDecoTitle) {
            const selectedPreset = BORDER_EFFECTS.find(d => d.id === draftBorderEffect);
            heroDecoTitle.textContent = selectedPreset ? selectedPreset.name : 'None';
          }

          // 5. Update Swatch Buttons (Telegram-Style 8x2 Matrix)
          document.querySelectorAll('.swatch-trigger-btn').forEach((btn: any) => {
            const val = btn.dataset.value;
            const isSelected = (val === draftNameColor);
            const check = btn.querySelector('.swatch-check');
            if (isSelected) {
              btn.className = 'swatch-trigger-btn relative w-8 h-8 rounded-full cursor-pointer transition-all active:scale-90 flex items-center justify-center shadow-md select-none ring-2 ring-offset-2 ring-offset-[var(--card-bg-offset,#11141d)] ring-cyan-400 scale-110 z-10';
              check?.classList.remove('hidden');
              check?.classList.add('flex');
            } else {
              btn.className = 'swatch-trigger-btn relative w-8 h-8 rounded-full cursor-pointer transition-all active:scale-90 flex items-center justify-center shadow-md select-none hover:scale-105';
              check?.classList.add('hidden');
              check?.classList.remove('flex');
            }
          });

          // 6. Update Status Toggle Switch & Remove Badge Button
          if (toggleBadges) {
            toggleBadges.checked = !!draftNameIcon;
          }
          if (btnRemoveBadge) {
            if (draftNameIcon) {
              btnRemoveBadge.classList.remove('hidden');
            } else {
              btnRemoveBadge.classList.add('hidden');
            }
          }

          // 7. Update Avatar Decoration Tiles in 4x3 Grid (overflow-visible)
          document.querySelectorAll('.avatar-deco-tile').forEach((tile: any) => {
            const decoId = tile.dataset.deco;
            const isSelected = (decoId === draftBorderEffect);
            const check = tile.querySelector('.deco-check-badge');
            if (isSelected) {
              tile.className = 'avatar-deco-tile relative w-[70px] h-[70px] rounded-2xl flex items-center justify-center cursor-pointer transition-all duration-200 active:scale-95 select-none ring-2 ring-pink-500 bg-pink-500/15 shadow-lg shadow-pink-500/20 scale-105 z-10 overflow-visible';
              check?.classList.remove('hidden');
            } else {
              tile.className = 'avatar-deco-tile relative w-[70px] h-[70px] rounded-2xl flex items-center justify-center cursor-pointer transition-all duration-200 active:scale-95 select-none bg-white/[0.03] hover:bg-white/[0.07] border border-white/10 overflow-visible';
              check?.classList.add('hidden');
            }
            const avatarInner = tile.querySelector('.select-none[style*="--avatar-glow-color"]');
            if (avatarInner) {
              avatarInner.style.setProperty('--avatar-glow-color', draftGlowColor);
              avatarInner.style.setProperty('--avatar-border-color', draftGlowColor);
            }
          });

          // 8. Update Glow Color 8-dot strip
          document.querySelectorAll('.glow-color-dot').forEach((btn: any) => {
            const val = btn.dataset.value;
            const isSelected = (val === draftGlowColor);
            const check = btn.querySelector('.glow-check');
            if (isSelected) {
              btn.className = 'glow-color-dot relative w-8 h-8 rounded-full cursor-pointer transition-all active:scale-90 flex items-center justify-center shadow-md select-none ring-2 ring-offset-2 ring-offset-[var(--card-bg-offset,#11141d)] ring-cyan-400 scale-110 z-10';
              check?.classList.remove('hidden');
              check?.classList.add('flex');
            } else {
              btn.className = 'glow-color-dot relative w-8 h-8 rounded-full cursor-pointer transition-all active:scale-90 flex items-center justify-center shadow-md select-none hover:scale-105';
              check?.classList.add('hidden');
              check?.classList.remove('flex');
            }
          });
        }

        // Render Color Matrix (Row 1: 8 Solids, Row 2: 8 Dual Gradients)
        if (gridColorMatrix) {
          const all16 = [
            ...SOLID_COLORS.map(c => ({ ...c, isGrad: false })),
            ...GRADIENT_COLORS.map(g => ({ ...g, isGrad: true }))
          ];
          gridColorMatrix.innerHTML = all16.map(item => `
            <button 
              type="button" 
              class="swatch-trigger-btn relative w-8 h-8 rounded-full cursor-pointer transition-all active:scale-90 flex items-center justify-center shadow-md select-none hover:scale-105"
              data-value="${item.value}"
              title="${item.name}"
              style="background: ${(item as any).split || item.value};"
            >
              <span class="swatch-check hidden text-white text-[11px] font-bold drop-shadow-[0_1px_2px_rgba(0,0,0,0.8)] select-none pointer-events-none">✓</span>
            </button>
          `).join('');

          gridColorMatrix.querySelectorAll('.swatch-trigger-btn').forEach((btn: any) => {
            btn.addEventListener('click', () => {
              draftNameColor = btn.dataset.value;
              updateLivePreview();
            });
          });
        }

        // Render Badges in the 8-column grid
        function renderBadges(badgesToRender: any[]) {
          if (!gridBadgesDisplay) return;

          if (badgesToRender.length === 0) {
            gridBadgesDisplay.innerHTML = `
              <div class="col-span-8 py-6 text-center text-xs text-slate-400">
                <span>No badges found. Try another search term!</span>
              </div>
            `;
            if (badgePickerCount) badgePickerCount.textContent = '0 badges';
            return;
          }

          gridBadgesDisplay.innerHTML = badgesToRender.map(b => {
            const isSelected = (b.url === draftNameIcon);
            return `
              <button 
                type="button" 
                class="badge-item-btn relative w-9 h-9 rounded-xl ${isSelected ? 'bg-cyan-500/20 border border-cyan-400 ring-2 ring-cyan-400/50 scale-105 shadow-sm z-10' : 'bg-white/[0.04] hover:bg-white/[0.1] border border-white/[0.08]'} flex items-center justify-center p-1.5 transition-all duration-150 active:scale-95 cursor-pointer select-none"
                data-url="${b.url}"
                data-name="${b.name}"
                title="${b.name}"
              >
                <img src="${b.url}" alt="" class="w-6 h-6 object-contain pointer-events-none" loading="lazy" draggable="false" />
              </button>
            `;
          }).join('');

          if (badgePickerCount) {
            badgePickerCount.textContent = `Showing ${badgesToRender.length} badges`;
          }

          gridBadgesDisplay.querySelectorAll('.badge-item-btn').forEach((btn: any) => {
            btn.addEventListener('click', () => {
              const url = btn.dataset.url;
              if (draftNameIcon === url) {
                draftNameIcon = '';
              } else {
                draftNameIcon = url;
              }
              updateLivePreview();
            });
          });
        }

        function filterBadges() {
          const query = inputBadgeSearch?.value.trim().toLowerCase() || '';
          if (btnClearBadgeSearch) {
            if (query) btnClearBadgeSearch.classList.remove('hidden');
            else btnClearBadgeSearch.classList.add('hidden');
          }

          let matched = BADGE_LIBRARY;
          if (query) {
            matched = BADGE_LIBRARY.filter(b => b.name.toLowerCase().includes(query) || b.id.toLowerCase().includes(query));
          } else {
            matched = BADGE_LIBRARY.filter(b => b.cat === activeBadgeCategory);
          }

          renderBadges(matched);

          // If query is present and user typed >= 2 characters, debounced live query to Iconify
          if (query && query.length >= 2) {
            clearTimeout(liveSearchDebounceTimer);
            liveSearchDebounceTimer = setTimeout(async () => {
              try {
                const res = await fetch(`https://api.iconify.design/search?query=${encodeURIComponent(query)}&prefixes=fluent-emoji-flat,solar,lucide&limit=40`);
                if (res.ok) {
                  const data = await res.json();
                  if (data && Array.isArray(data.icons) && data.icons.length > 0) {
                    const onlineBadges = data.icons.map((iconSlug: string) => {
                      const parts = iconSlug.split(':');
                      const prefix = parts[0];
                      const name = parts[1] || '';
                      let url = `https://api.iconify.design/${prefix}/${name}.svg`;
                      if (prefix === 'solar' || prefix === 'lucide') {
                        url += '?color=%2322d3ee';
                      }
                      return {
                        id: iconSlug,
                        cat: 'search',
                        name: name.replace(/-/g, ' '),
                        url
                      };
                    });

                    // Merge without duplicates
                    const existingUrls = new Set(matched.map(m => m.url));
                    const newOnes = onlineBadges.filter((b: any) => !existingUrls.has(b.url));
                    if (newOnes.length > 0) {
                      renderBadges([...matched, ...newOnes]);
                    }
                  }
                }
              } catch (e) {
                // Ignore offline or search errors gracefully
              }
            }, 350);
          }
        }

        inputBadgeSearch?.addEventListener('input', filterBadges);

        btnClearBadgeSearch?.addEventListener('click', () => {
          if (inputBadgeSearch) {
            inputBadgeSearch.value = '';
            filterBadges();
            inputBadgeSearch.focus();
          }
        });

        // Category Pills Handlers
        document.querySelectorAll('.badge-cat-pill').forEach((pill: any) => {
          pill.addEventListener('click', () => {
            activeBadgeCategory = pill.dataset.cat || 'popular';
            document.querySelectorAll('.badge-cat-pill').forEach((p: any) => {
              if (p === pill) {
                p.className = 'badge-cat-pill whitespace-nowrap px-3 py-1.5 rounded-xl font-medium text-xs transition cursor-pointer bg-purple-600 text-white shadow-sm';
              } else {
                p.className = 'badge-cat-pill whitespace-nowrap px-3 py-1.5 rounded-xl font-medium text-xs transition cursor-pointer text-slate-400 hover:text-white hover:bg-white/[0.05]';
              }
            });
            if (inputBadgeSearch) inputBadgeSearch.value = '';
            filterBadges();
          });
        });

        // Remove Badge Button
        btnRemoveBadge?.addEventListener('click', () => {
          draftNameIcon = '';
          updateLivePreview();
        });

        // Toggle Badges Switch
        toggleBadges?.addEventListener('change', () => {
          if (!toggleBadges.checked) {
            draftNameIcon = '';
          } else if (!draftNameIcon) {
            draftNameIcon = BADGE_LIBRARY[0].url; // Default to first animated fire
          }
          updateLivePreview();
        });

        // Render Sleek Visual Grid of Official Discord Avatar Decorations (Fast static thumbnails)
        function renderBorderEffects() {
          if (!borderEffectsGrid) return;
          const active = personas.find(p => p.isActive) || personas[0] || { name: 'Hossein' };

          borderEffectsGrid.innerHTML = BORDER_EFFECTS.map(deco => {
            const isSelected = (deco.id === draftBorderEffect);
            return `
              <div 
                class="avatar-deco-tile relative w-[72px] h-[78px] rounded-2xl flex flex-col items-center justify-center cursor-pointer transition-all duration-200 active:scale-95 select-none overflow-visible p-1.5 ${isSelected ? 'ring-2 ring-purple-500 bg-purple-500/15 shadow-lg shadow-purple-500/20 scale-105 z-10' : 'bg-white/[0.03] hover:bg-white/[0.07] border border-white/10'}"
                data-deco="${deco.id}"
                title="${deco.name}"
              >
                <div class="relative w-[48px] h-[48px] flex items-center justify-center overflow-visible">
                  ${renderDecoratedAvatarHtml({
                    src: active.avatar,
                    initial: active.name,
                    decoration: deco.id,
                    glowColor: draftGlowColor,
                    size: 44,
                    customUrl: draftCustomDecoUrl,
                    useThumb: true
                  })}
                </div>
                <span class="deco-tile-name text-[9px] font-semibold truncate max-w-[66px] text-center mt-1 text-slate-300 pointer-events-none">${deco.name}</span>
                <div class="deco-check-badge absolute -top-1 -right-1 w-4 h-4 rounded-full bg-purple-500 text-white flex items-center justify-center text-[10px] font-bold shadow-md shadow-purple-500/50 ${isSelected ? '' : 'hidden'}">
                  ✓
                </div>
              </div>
            `;
