    async function updateSecuritySettings() {
      const tLogin = document.getElementById('toggle-new-login-alert') as HTMLInputElement;
      const tAnomaly = document.getElementById('toggle-ip-anomaly-shield') as HTMLInputElement;
      const alertNewLogin = tLogin ? tLogin.checked : true;
      const alertIpAnomaly = tAnomaly ? tAnomaly.checked : true;

      // Update badge status immediately for instant feedback
      updateShieldStatusBadges();

      const channelsContainer = document.getElementById('alert-channels-container');
      if (channelsContainer) {
        if (alertNewLogin) {
          channelsContainer.classList.remove('opacity-40', 'pointer-events-none');
