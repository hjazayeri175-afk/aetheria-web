---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import BottomNav from '../components/BottomNav.astro';
import { 
  User, 
  Sparkles, 
  Save, 
  Trash2, 
  Plus, 
  Check, 
  Eye, 
  EyeOff,
  Camera,
  Settings,
  Shield,
  Download,
  Upload,
  LogOut,
  LogIn,
  ChevronDown,
  Palette,
  RotateCcw,
  Copy,
  SlidersHorizontal,
  Volume2,
  VolumeX
} from '@lucide/astro';
---

<Layout title="Profile & Personas | Aetheria">
  <Header />

  <main class="min-h-screen bg-[#060813] text-slate-100 pb-28 pt-4 sm:pt-8 px-4">
    <div class="max-w-xl mx-auto">
      
      <!-- Top Navigation Tabs -->
      <div class="flex items-center gap-1 p-1 rounded-2xl bg-white/[0.04] border border-white/[0.08] mb-8">
        <button 
          id="tab-btn-personas" 
          type="button" 
          class="flex-1 py-2.5 px-4 rounded-xl text-sm font-semibold transition cursor-pointer bg-purple-600 text-white shadow-lg shadow-purple-900/40"
        >
          Personas
        </button>
        <button 
          id="tab-btn-settings" 
          type="button" 
          class="flex-1 py-2.5 px-4 rounded-xl text-sm font-semibold transition cursor-pointer text-slate-400 hover:text-white hover:bg-white/[0.04]"
        >
          Settings
        </button>
      </div>

      <!-- ========================================== -->
      <!-- TAB 1: PERSONAS (Clean, Simple, User-first) -->
      <!-- ========================================== -->
      <div id="tab-view-personas" class="space-y-6">
        
        <!-- Header & Action -->
        <div class="flex items-center justify-between">
          <div>
            <h1 class="text-xl font-bold text-white tracking-tight">Personas</h1>
            <p class="text-xs text-slate-400 mt-0.5">Customize how characters perceive you in chat</p>
          </div>
          <button 
            type="button" 
            id="btn-new-persona"
            class="px-3.5 py-1.5 rounded-xl bg-purple-600/20 hover:bg-purple-600/30 border border-purple-500/40 text-purple-300 hover:text-white text-xs font-semibold flex items-center gap-1.5 transition active:scale-95 cursor-pointer shadow-sm"
          >
            <Plus class="w-3.5 h-3.5" />
            <span>New Persona</span>
          </button>
        </div>

        <!-- Master Enable / Disable Toggle -->
        <div class="flex items-center justify-between p-4 rounded-2xl bg-white/[0.02] border border-white/[0.08] transition">
          <div class="flex items-center gap-3">
            <div id="persona-toggle-icon" class="w-9 h-9 rounded-xl bg-purple-600/20 border border-purple-500/30 flex items-center justify-center text-purple-300 transition">
              <User class="w-4 h-4" />
            </div>
            <div>
              <p class="text-xs font-semibold text-white">Enable Persona in Chats</p>
              <p id="persona-toggle-status" class="text-[11px] text-slate-400 transition">Active in chats • Characters will use your persona</p>
            </div>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="persona-master-toggle" class="sr-only peer" checked>
            <div class="w-11 h-6 bg-white/10 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-purple-600"></div>
          </label>
        </div>

        <!-- Modern Persona Carousel Bar -->
        <div class="space-y-2">
          <div class="flex items-center justify-between text-xs text-slate-400 px-1">
            <span>Your Personas</span>
            <span id="personas-count-label" class="text-[11px] text-purple-400 font-medium">1 persona</span>
          </div>
          <div id="personas-pill-list" class="flex items-center gap-2.5 overflow-x-auto pb-2 pt-0.5 no-scrollbar scroll-smooth">
            <!-- Populated by JS -->
          </div>
        </div>

        <!-- Persona Editor Card -->
        <!-- Appearance & Global Theming Engine (Step 4: Telegram Suite - Themes, Name Colors, Audio & AMOLED) -->
        <div class="rounded-3xl bg-white/[0.02] border border-white/[0.08] p-5 sm:p-7 space-y-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 border-b border-white/[0.06] gap-3">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 rounded-2xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-400">
                <Palette class="w-5 h-5" />
              </div>
              <div>
                <h2 class="text-base font-bold text-white flex items-center gap-2">
                  Chat Appearance & Theming
                  <span class="px-2 py-0.5 rounded-full bg-purple-500/20 border border-purple-500/30 text-[10px] font-mono text-purple-300 font-normal">Telegram Suite</span>
                </h2>
                <p class="text-xs text-slate-400">Wallpapers, Cohesive Themes, Telegram Name Colors & Sound Effects</p>
              </div>
            </div>

            <!-- Base Mode Segmented Control (Day / Dark / AMOLED) -->
            <div class="flex items-center p-1 rounded-xl bg-white/[0.04] border border-white/[0.08] self-start sm:self-auto" id="profile-base-mode-group">
              <button type="button" data-mode="dark" class="profile-mode-btn px-2.5 py-1 rounded-lg text-xs font-medium text-slate-300 hover:text-white transition flex items-center gap-1.5 cursor-pointer">
                <span>🌙</span>
                <span>Dark</span>
              </button>
              <button type="button" data-mode="amoled" class="profile-mode-btn px-2.5 py-1 rounded-lg text-xs font-medium text-slate-300 hover:text-white transition flex items-center gap-1.5 cursor-pointer">
                <span>⚡</span>
                <span>AMOLED</span>
              </button>
              <button type="button" data-mode="day" class="profile-mode-btn px-2.5 py-1 rounded-lg text-xs font-medium text-slate-300 hover:text-white transition flex items-center gap-1.5 cursor-pointer">
                <span>☀️</span>
                <span>Day</span>
              </button>
            </div>
          </div>

          <!-- Pinned Live Preview Card -->
          <div class="space-y-2">
            <div class="flex items-center justify-between text-xs font-semibold text-slate-400 uppercase tracking-wider">
              <span class="flex items-center gap-1.5 text-purple-300">
                <Sparkles class="w-3.5 h-3.5 text-purple-400" />
                <span>Live Interactive Preview</span>
              </span>
              <span class="text-[10px] font-mono text-slate-500">global preview</span>
            </div>

            <div id="profile-preview-viewport" class="relative h-44 sm:h-48 rounded-2xl overflow-hidden border border-white/10 flex flex-col justify-end p-4 select-none shadow-inner">
              <div id="profile-preview-image" class="absolute inset-0 transition-all duration-300" style="background: linear-gradient(to bottom, #090a12, #0e1122, #07080f);"></div>
              <div id="profile-preview-dimmer" class="absolute inset-0 bg-black/20 pointer-events-none transition-opacity duration-200"></div>
              <div id="profile-preview-pattern" class="absolute inset-0 pointer-events-none transition-opacity duration-300" style="background-image: none; opacity: 0.18;"></div>

              <div class="relative z-10 space-y-2.5 max-w-full">
                <!-- Character message -->
                <div class="flex items-start gap-2.5 max-w-[85%]">
                  <div class="w-7 h-7 rounded-full bg-purple-600/40 border border-purple-500/40 flex items-center justify-center text-purple-200 text-xs font-bold shrink-0 mt-0.5">
                    A
                  </div>
                  <div class="space-y-1 min-w-0">
                    <span id="profile-preview-char-name" class="text-[11px] font-semibold text-purple-300 block truncate transition-colors duration-200">Aetheria AI</span>
                    <div id="profile-preview-char-bubble" class="px-3.5 py-2 rounded-2xl rounded-tl-xs shadow-md transition-all duration-200" style="background: #101426; border: 1px solid rgba(255, 255, 255, 0.08); font-size: 15px; color: #f1f5f9;">
                      <p class="leading-relaxed">Step 4 complete: Telegram name colors, AMOLED mode and real-time audio pop effects! ✨</p>
                      <span class="text-[9px] text-slate-400 mt-1 block">10:42 PM</span>
                    </div>
                  </div>
                </div>

                <!-- User message -->
                <div class="flex items-end justify-end max-w-[85%] ml-auto">
                  <div id="profile-preview-user-bubble" class="px-3.5 py-2 rounded-2xl rounded-tr-xs shadow-lg transition-all duration-200 text-white" style="background: linear-gradient(135deg, #9333ea, #6366f1); font-size: 15px;">
                    <p class="leading-relaxed">This feels exactly like modern Telegram desktop! 🚀</p>
                    <div class="text-[9px] text-white/70 mt-1 flex items-center justify-end gap-1">
                      <span>10:43 PM</span>
                      <svg class="w-3 h-3 text-cyan-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Section 1: Custom Themes Studio (STEP 4) -->
          <div class="p-4 rounded-2xl bg-white/[0.02] border border-white/[0.06] space-y-3">
            <div class="flex items-center justify-between">
              <div>
                <h3 class="text-xs font-bold text-white flex items-center gap-2">
                  <span>🎨 Custom Theme Creator</span>
                  <span class="px-2 py-0.5 rounded-full bg-cyan-500/20 text-cyan-300 text-[10px] font-mono">Create Your Own</span>
                </h3>
                <p class="text-[11px] text-slate-400 mt-0.5">Save current appearance settings as a reusable personal theme</p>
              </div>
              <button type="button" id="profile-btn-toggle-custom-form" class="px-3 py-1.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white text-xs font-semibold flex items-center gap-1.5 transition cursor-pointer">
                <Plus class="w-3.5 h-3.5" />
                <span>New Theme</span>
              </button>
            </div>

            <!-- Creation Box -->
            <div id="profile-custom-theme-form" class="hidden pt-3 border-t border-white/[0.06] space-y-2.5">
              <div class="flex flex-col sm:flex-row gap-2">
                <input 
                  type="text" 
                  id="profile-custom-theme-name" 
                  placeholder="Enter theme name (e.g. Midnight Cyber, Velvet Rose)..." 
                  class="flex-1 px-3.5 py-2 rounded-xl bg-black/40 border border-white/10 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-purple-500 transition"
                />
                <div class="flex items-center gap-2">
                  <button type="button" id="profile-btn-save-custom" class="px-4 py-2 rounded-xl bg-purple-600 hover:bg-purple-500 text-white text-xs font-bold transition cursor-pointer flex items-center gap-1.5">
                    <Check class="w-3.5 h-3.5" />
                    <span>Save</span>
                  </button>
                  <button type="button" id="profile-btn-cancel-custom" class="px-3 py-2 rounded-xl bg-white/5 hover:bg-white/10 text-slate-300 text-xs transition cursor-pointer">
                    Cancel
                  </button>
                </div>
              </div>
            </div>

            <!-- User Saved Themes List -->
            <div id="profile-custom-themes-container" class="hidden space-y-2 pt-2">
              <span class="text-[11px] font-semibold text-purple-300 uppercase tracking-wider block">My Saved Themes</span>
              <div id="profile-custom-themes-grid" class="grid grid-cols-2 sm:grid-cols-3 gap-2.5"></div>
            </div>
          </div>

          <!-- Section 2: 8 Telegram Cohesive Theme Presets -->
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-slate-300 uppercase tracking-wider">Telegram Theme Presets</span>
              <span class="text-[11px] text-slate-400">8 curated cohesive themes</span>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="profile-presets-grid"></div>
          </div>

          <!-- Section 3: Telegram 7 Name Colors (STEP 4) -->
          <div class="p-4 rounded-2xl bg-white/[0.02] border border-white/[0.06] space-y-3">
            <div class="flex items-center justify-between">
              <div>
                <span class="text-xs font-bold text-slate-300 uppercase tracking-wider block">Telegram Name & Reply Color</span>
                <p class="text-[11px] text-slate-400 mt-0.5">Colors applied to user name, character title and quotes</p>
              </div>
              <div class="flex items-center gap-2">
                <input type="color" id="profile-custom-name-color" value="#a855f7" class="w-7 h-7 rounded-lg bg-transparent border-0 cursor-pointer" title="Pick custom name color" />
                <span id="profile-name-color-hex" class="text-xs font-mono text-purple-300 font-bold uppercase">#A855F7</span>
              </div>
            </div>
            
            <div class="grid grid-cols-4 sm:grid-cols-7 gap-2" id="profile-name-color-palette"></div>
          </div>

          <!-- Section 4: Sliders (Font Size & Radius) -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <div class="p-3.5 rounded-2xl bg-white/[0.02] border border-white/[0.06] space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-slate-200">Message Text Size</span>
                <span id="profile-font-val" class="px-2 py-0.5 rounded bg-purple-500/20 text-xs font-mono text-purple-300 font-bold">16px</span>
              </div>
              <input type="range" id="profile-font-slider" min="13" max="22" step="1" value="16" class="w-full h-1.5 bg-white/10 rounded-lg appearance-none cursor-pointer accent-purple-500" />
            </div>

            <div class="p-3.5 rounded-2xl bg-white/[0.02] border border-white/[0.06] space-y-2">
              <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-slate-200">Bubble Corner Roundness</span>
                <span id="profile-radius-val" class="px-2 py-0.5 rounded bg-purple-500/20 text-xs font-mono text-purple-300 font-bold">16px</span>
              </div>
              <input type="range" id="profile-radius-slider" min="0" max="24" step="2" value="16" class="w-full h-1.5 bg-white/10 rounded-lg appearance-none cursor-pointer accent-purple-500" />
            </div>
          </div>

          <!-- Section 5: Outgoing Bubble Gradients -->
          <div class="p-4 rounded-2xl bg-white/[0.02] border border-white/[0.06] space-y-3.5">
            <div class="flex items-center justify-between">
              <span class="text-xs font-bold text-slate-300 uppercase tracking-wider">Outgoing Message Gradient</span>
              <span class="text-[10px] text-slate-400">8 Preset Telegram Gradients</span>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2" id="profile-bubble-gradient-presets"></div>

            <!-- Custom 2-Color Gradient Builder -->
            <div class="pt-3 border-t border-white/[0.06] space-y-2">
              <span class="text-xs font-medium text-slate-300 block">Custom 2-Color Gradient Builder</span>
              <div class="flex items-center gap-3">
                <div class="flex items-center gap-2 p-2 rounded-xl bg-white/[0.02] border border-white/[0.06] flex-1">
                  <span class="text-[11px] text-slate-400">From:</span>
                  <input type="color" id="profile-gradient-color-a" value="#9333ea" class="w-7 h-7 rounded-lg bg-transparent border-0 cursor-pointer" />
                  <span id="profile-gradient-val-a" class="text-xs font-mono text-slate-300 uppercase">#9333EA</span>
                </div>
                <div class="flex items-center gap-2 p-2 rounded-xl bg-white/[0.02] border border-white/[0.06] flex-1">
                  <span class="text-[11px] text-slate-400">To:</span>
                  <input type="color" id="profile-gradient-color-b" value="#6366f1" class="w-7 h-7 rounded-lg bg-transparent border-0 cursor-pointer" />
                  <span id="profile-gradient-val-b" class="text-xs font-mono text-slate-300 uppercase">#6366F1</span>
                </div>
                <button type="button" id="profile-apply-custom-gradient" class="px-3.5 py-2.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white text-xs font-semibold cursor-pointer transition">
                  Apply
                </button>
              </div>
            </div>
          </div>

          <!-- Section 6: Wallpaper, Doodles, Blur & Dimmer -->
          <div class="p-4 rounded-2xl bg-white/[0.02] border border-white/[0.06] space-y-4">
            <span class="text-xs font-bold text-slate-300 uppercase tracking-wider block">Wallpaper, Doodles & Effects</span>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div class="flex items-center justify-between p-3 rounded-xl bg-white/[0.02] border border-white/[0.06]">
                <div class="space-y-0.5">
                  <span class="text-xs font-medium text-slate-200 block">Blur Wallpaper</span>
                  <span class="text-[10px] text-slate-400">14px Gaussian blur</span>
                </div>
                <button type="button" id="profile-blur-toggle" class="px-3 py-1.5 rounded-lg border text-xs font-semibold transition cursor-pointer bg-white/5 border-white/10 text-slate-300">
                  Off
                </button>
              </div>

              <div class="p-3 rounded-xl bg-white/[0.02] border border-white/[0.06] space-y-2">
                <div class="flex items-center justify-between">
                  <span class="text-xs font-medium text-slate-200">Darkness Dimmer</span>
                  <span id="profile-dim-val" class="text-xs font-mono text-purple-400 font-bold">20%</span>
                </div>
                <input type="range" id="profile-dim-slider" min="0" max="70" step="5" value="20" class="w-full h-1.5 bg-white/10 rounded-lg appearance-none cursor-pointer accent-purple-500" />
              </div>
            </div>

            <div class="space-y-2 pt-2 border-t border-white/[0.06]">
              <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-slate-200">Vector Doodle Patterns</span>
                <span id="profile-pattern-opacity-val" class="text-xs font-mono text-purple-400 font-bold">18%</span>
              </div>
              <div class="grid grid-cols-3 sm:grid-cols-6 gap-2" id="profile-doodle-pills"></div>
              <input type="range" id="profile-pattern-opacity-slider" min="5" max="50" step="1" value="18" class="w-full h-1 bg-white/10 rounded-lg appearance-none cursor-pointer accent-purple-500" />
            </div>

            <!-- Custom Photo Wallpaper -->
            <div class="pt-2 border-t border-white/[0.06] space-y-2.5">
              <span class="text-xs font-medium text-slate-200 block">Custom Photo Wallpaper</span>
              <div class="flex flex-col sm:flex-row items-center gap-3">
                <input type="file" id="profile-photo-file" accept="image/*" class="hidden" />
                <button type="button" id="profile-photo-btn" class="w-full sm:w-auto px-4 py-2 rounded-xl bg-purple-600 hover:bg-purple-500 text-white text-xs font-semibold flex items-center justify-center gap-2 transition cursor-pointer">
                  <Upload class="w-4 h-4" />
                  <span>Choose Photo</span>
                </button>
                <span class="text-xs text-slate-500 font-mono">or</span>
                <div class="flex items-center gap-2 w-full sm:flex-1">
                  <input type="text" id="profile-photo-url-input" placeholder="Paste direct image URL..." class="w-full px-3 py-1.5 rounded-xl bg-white/[0.04] border border-white/10 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-purple-500" />
                  <button type="button" id="profile-photo-url-apply" class="px-3 py-1.5 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-medium cursor-pointer transition">
                    Apply
                  </button>
                </div>
              </div>
            </div>

            <!-- Wallpaper Gallery -->
            <div class="space-y-2.5 pt-2 border-t border-white/[0.06]">
              <span class="text-xs font-medium text-slate-200 block">Wallpaper Gallery</span>
              <div class="grid grid-cols-2 sm:grid-cols-3 gap-2.5" id="profile-wallpapers-grid"></div>
            </div>
          </div>

          <!-- Section 7: Telegram Sound & Chat Extras (STEP 4) -->
          <div class="p-4 rounded-2xl bg-white/[0.02] border border-white/[0.06] space-y-3.5">
            <div class="flex items-center justify-between">
              <div>
                <span class="text-xs font-bold text-slate-300 uppercase tracking-wider block">Telegram Message Sounds</span>
                <p class="text-[11px] text-slate-400 mt-0.5">Synthesized audio pops on message send & incoming character replies</p>
              </div>
              <button type="button" id="profile-sound-toggle" class="px-3.5 py-1.5 rounded-xl border text-xs font-semibold transition cursor-pointer bg-purple-500/20 border-purple-500/30 text-purple-300">
                Enabled
              </button>
            </div>
            
            <div class="flex items-center gap-2.5 pt-2 border-t border-white/[0.06]">
              <button type="button" id="profile-sound-test-send" class="flex-1 px-3 py-2 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] text-xs font-medium text-slate-200 hover:text-white transition flex items-center justify-center gap-2 cursor-pointer">
                <span>🎵</span>
                <span>Test Send Pop</span>
              </button>
              <button type="button" id="profile-sound-test-receive" class="flex-1 px-3 py-2 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] text-xs font-medium text-slate-200 hover:text-white transition flex items-center justify-center gap-2 cursor-pointer">
                <span>🔔</span>
                <span>Test Receive Chime</span>
              </button>
            </div>
          </div>

          <!-- Section 8: Chat Density & Send Key & Backup -->
          <div class="p-4 rounded-2xl bg-white/[0.02] border border-white/[0.06] space-y-3">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- Chat Density -->
              <div class="space-y-1.5">
                <span class="text-xs font-bold text-slate-300 uppercase tracking-wider block">Chat Density</span>
                <div class="grid grid-cols-2 gap-2">
                  <label class="flex items-center gap-2 p-2.5 rounded-xl bg-white/[0.02] border border-white/[0.06] cursor-pointer hover:bg-white/[0.04]">
                    <input type="radio" name="profile-density-radio" value="comfortable" id="profile-density-comfortable" class="w-4 h-4 text-purple-600" />
                    <span class="text-xs text-white">Comfortable</span>
                  </label>
                  <label class="flex items-center gap-2 p-2.5 rounded-xl bg-white/[0.02] border border-white/[0.06] cursor-pointer hover:bg-white/[0.04]">
                    <input type="radio" name="profile-density-radio" value="compact" id="profile-density-compact" class="w-4 h-4 text-purple-600" />
                    <span class="text-xs text-white">Compact</span>
                  </label>
                </div>
              </div>

              <!-- Send Key -->
              <div class="space-y-1.5">
                <span class="text-xs font-bold text-slate-300 uppercase tracking-wider block">Send Shortcut</span>
                <div class="grid grid-cols-2 gap-2">
                  <label class="flex items-center gap-2 p-2.5 rounded-xl bg-white/[0.02] border border-white/[0.06] cursor-pointer hover:bg-white/[0.04]">
                    <input type="radio" name="profile-send-radio" value="enter" id="profile-send-enter" class="w-4 h-4 text-purple-600" />
                    <span class="text-xs text-white">Enter</span>
                  </label>
                  <label class="flex items-center gap-2 p-2.5 rounded-xl bg-white/[0.02] border border-white/[0.06] cursor-pointer hover:bg-white/[0.04]">
                    <input type="radio" name="profile-send-radio" value="ctrl_enter" id="profile-send-ctrl-enter" class="w-4 h-4 text-purple-600" />
                    <span class="text-xs text-white">Ctrl+Enter</span>
                  </label>
                </div>
              </div>
            </div>

            <!-- Backup & Reset -->
            <div class="pt-3 border-t border-white/[0.06] flex flex-wrap items-center gap-2">
              <button type="button" id="profile-export-btn" class="px-3.5 py-2 rounded-xl bg-white/5 hover:bg-white/10 text-white text-xs font-medium flex items-center gap-2 transition cursor-pointer">
                <Copy class="w-3.5 h-3.5 text-slate-400" />
                <span>Copy Theme JSON</span>
              </button>
              <button type="button" id="profile-import-btn" class="px-3.5 py-2 rounded-xl bg-white/5 hover:bg-white/10 text-white text-xs font-medium flex items-center gap-2 transition cursor-pointer">
                <Upload class="w-3.5 h-3.5 text-slate-400" />
                <span>Import Theme Code</span>
              </button>
              <button type="button" id="profile-reset-factory-btn" class="px-3.5 py-2 rounded-xl bg-rose-500/10 hover:bg-rose-500/20 text-rose-300 text-xs font-medium flex items-center gap-2 transition cursor-pointer ml-auto">
                <RotateCcw class="w-3.5 h-3.5" />
                <span>Reset to Default</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Data & Backup Section -->
        <div class="rounded-3xl bg-white/[0.02] border border-white/[0.08] p-5 sm:p-6 space-y-4">
          <h2 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Data & Backup</h2>

          <div class="flex items-center gap-3">
            <button 
              type="button" 
              id="btn-export-backup"
              class="flex-1 py-2.5 px-3 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/10 text-xs font-medium text-slate-200 hover:text-white transition flex items-center justify-center gap-2 cursor-pointer"
            >
              <Download class="w-3.5 h-3.5" />
              <span>Export Backup</span>
            </button>
            <label 
              class="flex-1 py-2.5 px-3 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/10 text-xs font-medium text-slate-200 hover:text-white transition flex items-center justify-center gap-2 cursor-pointer"
            >
              <Upload class="w-3.5 h-3.5" />
              <span>Restore Backup</span>
              <input type="file" id="backup-file-input" accept=".json" class="hidden" />
            </label>
          </div>

          <div class="pt-2 border-t border-white/5 flex justify-end">
            <button 
              type="button" 
              id="btn-clear-cache"
              class="text-xs text-red-400/80 hover:text-red-300 transition py-1 px-2 rounded-lg hover:bg-red-500/10 cursor-pointer"
            >
              Clear Local Cache
            </button>
          </div>
        </div>

      </div>

    </div>
  </main>

  <BottomNav />

  <!-- Toast Notification Container -->
  <div id="toast-container" class="fixed bottom-20 left-1/2 -translate-x-1/2 z-50 flex flex-col gap-2 pointer-events-none"></div>

  <!-- Custom Confirmation Modal Container -->
  <div id="modal-container" class="fixed inset-0 z-[10000] hidden items-center justify-center p-4 bg-black/75 backdrop-blur-md"></div>
</Layout>

<script>
  interface Persona {
    id: string;
    name: string;
    age?: string;
    pronouns?: string;
    avatar?: string;
    bio?: string;
    directives?: string;
    isDefault?: boolean;
  }

  const STORAGE_KEY_PERSONAS = 'aetheria_saved_personas';
  const STORAGE_KEY_ACTIVE = 'aetheria_user_persona';

  let personas: Persona[] = [];
  let currentPersonaId = '';

  // Helpers: Toast & Modal
  function showToast(message: string, type: 'success' | 'info' | 'warning' = 'info') {
    const container = document.getElementById('toast-container');
    if (!container) return;

    const toast = document.createElement('div');
    const colorClass = type === 'success' 
      ? 'border-emerald-500/40 text-emerald-300 bg-emerald-950/80' 
      : type === 'warning'
      ? 'border-amber-500/40 text-amber-300 bg-amber-950/80'
      : 'border-purple-500/40 text-purple-200 bg-[#0e1224]/90';

    toast.className = `px-4 py-2 rounded-2xl border ${colorClass} backdrop-blur-lg text-xs font-semibold shadow-xl transition-all duration-300 opacity-0 translate-y-2 pointer-events-auto`;
    toast.textContent = message;

    container.appendChild(toast);
    requestAnimationFrame(() => {
      toast.classList.remove('opacity-0', 'translate-y-2');
    });

    setTimeout(() => {
      toast.classList.add('opacity-0', 'translate-y-2');
      setTimeout(() => toast.remove(), 300);
    }, 2500);
  }

  function showConfirm(title: string, message: string): Promise<boolean> {
    return new Promise((resolve) => {
      const container = document.getElementById('modal-container');
      if (!container) {
        resolve(false);
        return;
      }

      container.innerHTML = `
        <div class="w-full max-w-sm rounded-3xl bg-[#0e1224]/95 border border-white/10 p-6 shadow-2xl text-left">
          <h3 class="text-sm font-bold text-white mb-2">${title}</h3>
          <p class="text-xs text-slate-300 leading-relaxed mb-5">${message}</p>
          <div class="flex items-center justify-end gap-2">
            <button id="modal-cancel-btn" type="button" class="px-3.5 py-1.5 rounded-xl bg-white/5 hover:bg-white/10 text-xs text-slate-300 transition cursor-pointer">
              Cancel
            </button>
            <button id="modal-confirm-btn" type="button" class="px-4 py-1.5 rounded-xl bg-red-600 hover:bg-red-500 text-xs font-semibold text-white transition cursor-pointer">
              Confirm
            </button>
          </div>
        </div>
      `;

      container.classList.remove('hidden');
      container.classList.add('flex');

      const cleanup = (val: boolean) => {
        container.classList.add('hidden');
        container.classList.remove('flex');
        container.innerHTML = '';
        resolve(val);
      };

      container.querySelector('#modal-cancel-btn')?.addEventListener('click', () => cleanup(false));
      container.querySelector('#modal-confirm-btn')?.addEventListener('click', () => cleanup(true));
    });
  }

  // Initial Load & Migration
  function loadPersonas() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY_PERSONAS);
      if (raw) {
        personas = JSON.parse(raw);
      }
    } catch {}

    if (!Array.isArray(personas) || personas.length === 0) {
      // Migrate from old single persona if present
      let initialName = '';
      let initialBio = '';
      let initialAvatar = '';
      try {
        const oldRaw = localStorage.getItem(STORAGE_KEY_ACTIVE);
        if (oldRaw) {
          const old = JSON.parse(oldRaw);
          if (old.name && old.name !== 'Traveler') initialName = old.name;
          initialBio = old.bio || old.description || '';
          initialAvatar = old.avatar || '';
        }
      } catch {}

      personas = [{
        id: 'p_' + Date.now(),
        name: initialName,
        age: '',
        pronouns: '',
        avatar: initialAvatar,
        bio: initialBio,
        directives: '',
        isDefault: true
      }];
      savePersonas();
    }

    // Ensure at least one default persona exists
    if (!personas.some(p => p.isDefault)) {
      personas[0].isDefault = true;
    }

    // Determine current persona from default
    const activePersona = personas.find(p => p.isDefault) || personas[0];
    currentPersonaId = activePersona.id;
  }

  function savePersonas() {
    localStorage.setItem(STORAGE_KEY_PERSONAS, JSON.stringify(personas));
    // Keep active persona synced
    const active = personas.find(p => p.isDefault) || personas.find(p => p.id === currentPersonaId) || personas[0];
    if (active) {
      localStorage.setItem(STORAGE_KEY_ACTIVE, JSON.stringify(active));
    }
  }

  // Render Carousel List
  function renderPillList() {
    const list = document.getElementById('personas-pill-list');
    const countLabel = document.getElementById('personas-count-label');
    if (!list) return;

    if (countLabel) {
      countLabel.textContent = `${personas.length} ${personas.length === 1 ? 'persona' : 'personas'}`;
    }

    const itemsHtml = personas.map(p => {
      const isSelected = p.id === currentPersonaId;
      const displayName = p.name.trim() || 'Untitled';
      const ageText = p.age ? `${p.age}` : (p.pronouns ? `${p.pronouns}` : 'No details');
      return `
        <button 
          type="button" 
          class="persona-pill group relative flex items-center gap-3 py-2 px-3.5 rounded-2xl border text-left shrink-0 transition-all duration-200 cursor-pointer ${
            isSelected 
              ? 'bg-purple-600/20 border-purple-500/60 text-white shadow-lg shadow-purple-950/40 ring-1 ring-purple-500/40' 
              : 'bg-white/[0.03] border-white/5 text-slate-400 hover:text-slate-200 hover:bg-white/[0.06] hover:border-white/10'
          }"
          data-id="${p.id}"
        >
          <div class="relative w-8 h-8 rounded-full overflow-hidden bg-purple-950/40 border ${isSelected ? 'border-purple-400' : 'border-white/10'} shrink-0 flex items-center justify-center">
            ${p.avatar ? `<img src="${p.avatar}" class="w-full h-full object-cover" />` : `<span class="text-xs font-bold text-purple-300">${(displayName.charAt(0) || 'U').toUpperCase()}</span>`}
          </div>
          <div class="min-w-0 pr-1">
            <p class="persona-pill-name text-xs font-bold truncate max-w-[90px] sm:max-w-[120px] leading-tight">${displayName}</p>
            <p class="text-[10px] text-slate-500 truncate leading-tight mt-0.5">${ageText}</p>
          </div>
          ${p.isDefault ? '<span class="ml-1 text-[9px] px-1.5 py-0.5 rounded-full bg-purple-500/30 text-purple-200 font-semibold border border-purple-400/20 shrink-0">Active</span>' : ''}
        </button>
      `;
    }).join('');

    const addBtnHtml = `
      <button 
        type="button" 
        id="btn-add-persona-carousel"
        class="flex items-center gap-2 py-2 px-3.5 rounded-2xl border border-dashed border-white/15 bg-white/[0.01] hover:bg-white/[0.05] text-slate-400 hover:text-purple-300 text-xs font-semibold shrink-0 transition cursor-pointer"
        title="Create new persona"
      >
        <span class="w-6 h-6 rounded-full bg-white/5 flex items-center justify-center text-slate-300 font-bold text-xs">+</span>
        <span>Add</span>
      </button>
    `;

    list.innerHTML = itemsHtml + addBtnHtml;

    list.querySelectorAll('.persona-pill').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id');
        if (id) {
          currentPersonaId = id;
          // Instantly activate the selected persona!
          personas.forEach(x => {
            x.isDefault = (x.id === currentPersonaId);
          });
          savePersonas();
          renderPillList();
          fillForm();
          const p = personas.find(x => x.id === currentPersonaId);
          showToast(`Active persona: ${p?.name || 'Persona'}`, 'success');
        }
      });
    });

    document.getElementById('btn-add-persona-carousel')?.addEventListener('click', () => {
      document.getElementById('btn-new-persona')?.click();
    });
  }

  function fillForm() {
    const p = personas.find(x => x.id === currentPersonaId) || personas[0];
    if (!p) return;

    const nameInput = document.getElementById('persona-name') as HTMLInputElement;
    const ageInput = document.getElementById('persona-age') as HTMLInputElement;
    const pronounsInput = document.getElementById('persona-pronouns') as HTMLInputElement;
    const aboutInput = document.getElementById('persona-about') as HTMLTextAreaElement;
    const directivesInput = document.getElementById('persona-directives') as HTMLTextAreaElement;
    const avatarImg = document.getElementById('persona-avatar-img') as HTMLImageElement;
    const avatarPlaceholder = document.getElementById('persona-avatar-placeholder');
    const removeBtn = document.getElementById('btn-remove-avatar');
    const defaultBtn = document.getElementById('btn-set-default');
    const deleteBtn = document.getElementById('btn-delete-persona');

    if (nameInput) nameInput.value = p.name || '';
    if (ageInput) ageInput.value = p.age || '';
    if (pronounsInput) pronounsInput.value = p.pronouns || '';
    if (aboutInput) aboutInput.value = p.bio || '';
    if (directivesInput) directivesInput.value = p.directives || '';

    if (avatarImg && avatarPlaceholder && removeBtn) {
      if (p.avatar) {
        avatarImg.src = p.avatar;
        avatarImg.classList.remove('hidden');
        avatarPlaceholder.classList.add('hidden');
        removeBtn.classList.remove('hidden');
      } else {
        avatarImg.src = '';
        avatarImg.classList.add('hidden');
        avatarPlaceholder.classList.remove('hidden');
        removeBtn.classList.add('hidden');
      }
    }

    const isGlobalEnabled = (localStorage.getItem('aetheria_persona_enabled') !== 'false');
    const statusBadge = document.getElementById('persona-status-badge');
    const statusBadgeText = document.getElementById('persona-status-badge-text');

    if (statusBadge && statusBadgeText) {
      if (isGlobalEnabled) {
        statusBadge.className = 'px-3 py-1.5 rounded-xl bg-purple-500/15 border border-purple-500/30 text-purple-300 text-xs font-semibold flex items-center gap-1.5 select-none';
        statusBadgeText.textContent = 'Active for Chat';
      } else {
        statusBadge.className = 'px-3 py-1.5 rounded-xl bg-white/5 border border-white/10 text-slate-500 text-xs font-medium flex items-center gap-1.5 select-none';
        statusBadgeText.textContent = 'Paused (Chats Off)';
      }
    }

    if (deleteBtn) {
      deleteBtn.style.display = (personas.length > 1) ? 'flex' : 'none';
    }
  }

  // Setup Event Handlers
  document.addEventListener('DOMContentLoaded', () => {
    loadPersonas();
    renderPillList();
    fillForm();

    // Master Persona Enable/Disable Toggle
    const masterToggle = document.getElementById('persona-master-toggle') as HTMLInputElement;
    const toggleStatus = document.getElementById('persona-toggle-status');
    const toggleIcon = document.getElementById('persona-toggle-icon');

    function updateToggleUI(enabled: boolean) {
      if (toggleStatus) {
        toggleStatus.textContent = enabled 
          ? 'Active in chats • Characters will use your persona' 
          : 'Disabled • Characters interact using their default scenario';
      }
      if (toggleIcon) {
        if (enabled) {
          toggleIcon.className = 'w-9 h-9 rounded-xl bg-purple-600/20 border border-purple-500/30 flex items-center justify-center text-purple-300 transition';
        } else {
          toggleIcon.className = 'w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-slate-500 transition';
        }
      }
    }

    const isInitiallyEnabled = (localStorage.getItem('aetheria_persona_enabled') !== 'false');
    if (masterToggle) {
      masterToggle.checked = isInitiallyEnabled;
      updateToggleUI(isInitiallyEnabled);

      masterToggle.addEventListener('change', () => {
        const isEnabled = masterToggle.checked;
        localStorage.setItem('aetheria_persona_enabled', isEnabled ? 'true' : 'false');
        updateToggleUI(isEnabled);
        fillForm();
        showToast(isEnabled ? 'Personas enabled in chats' : 'Personas disabled. Using scenario default', isEnabled ? 'success' : 'info');
      });
    }

    // Tab Switcher
    const tabPersonas = document.getElementById('tab-btn-personas');
    const tabSettings = document.getElementById('tab-btn-settings');
    const viewPersonas = document.getElementById('tab-view-personas');
    const viewSettings = document.getElementById('tab-view-settings');

    tabPersonas?.addEventListener('click', () => {
      tabPersonas.className = 'flex-1 py-2.5 px-4 rounded-xl text-sm font-semibold transition cursor-pointer bg-purple-600 text-white shadow-lg shadow-purple-900/40';
      tabSettings!.className = 'flex-1 py-2.5 px-4 rounded-xl text-sm font-semibold transition cursor-pointer text-slate-400 hover:text-white hover:bg-white/[0.04]';
      viewPersonas?.classList.remove('hidden');
      viewSettings?.classList.add('hidden');
    });

    tabSettings?.addEventListener('click', () => {
      tabSettings.className = 'flex-1 py-2.5 px-4 rounded-xl text-sm font-semibold transition cursor-pointer bg-purple-600 text-white shadow-lg shadow-purple-900/40';
      tabPersonas!.className = 'flex-1 py-2.5 px-4 rounded-xl text-sm font-semibold transition cursor-pointer text-slate-400 hover:text-white hover:bg-white/[0.04]';
      viewSettings?.classList.remove('hidden');
      viewPersonas?.classList.add('hidden');
    });

    // Avatar Click Zone
    const avatarZone = document.getElementById('avatar-click-zone');
    const fileInput = document.getElementById('avatar-file-input') as HTMLInputElement;

    avatarZone?.addEventListener('click', () => {
      fileInput?.click();
    });

    fileInput?.addEventListener('change', () => {
      const file = fileInput.files?.[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = (e) => {
        const dataUrl = e.target?.result as string;
        const p = personas.find(x => x.id === currentPersonaId);
        if (p) {
          p.avatar = dataUrl;
          savePersonas();
          fillForm();
          renderPillList();
          showToast('Photo updated', 'success');
        }
      };
      reader.readAsDataURL(file);
    });

    // Remove Photo
    document.getElementById('btn-remove-avatar')?.addEventListener('click', (e) => {
      e.stopPropagation();
      const p = personas.find(x => x.id === currentPersonaId);
      if (p) {
        p.avatar = '';
        savePersonas();
        fillForm();
        renderPillList();
        showToast('Photo removed');
      }
    });

    // Live update card title as user types
    const nameInput = document.getElementById('persona-name') as HTMLInputElement;
    nameInput?.addEventListener('input', () => {
      const p = personas.find(x => x.id === currentPersonaId);
      if (p) {
        p.name = nameInput.value;
        const pillText = document.querySelector(`.persona-pill[data-id="${p.id}"] .persona-pill-name`);
        if (pillText) {
          pillText.textContent = nameInput.value.trim() || 'Untitled';
        }
      }
    });

    // New Persona
    document.getElementById('btn-new-persona')?.addEventListener('click', () => {
      // Deactivate others
      personas.forEach(x => { x.isDefault = false; });
      const newP: Persona = {
        id: 'p_' + Date.now(),
        name: '',
        age: '',
        pronouns: '',
        avatar: '',
        bio: '',
        directives: '',
        isDefault: true // Immediately active!
      };
      personas.push(newP);
      currentPersonaId = newP.id;
      savePersonas();
      renderPillList();
      fillForm();
      const nInput = document.getElementById('persona-name') as HTMLInputElement;
      nInput?.focus();
      showToast('New persona created & active', 'success');
    });

    // Save Persona
    document.getElementById('btn-save-persona')?.addEventListener('click', () => {
      const p = personas.find(x => x.id === currentPersonaId);
      if (!p) return;

      const nameInp = document.getElementById('persona-name') as HTMLInputElement;
      const ageInput = document.getElementById('persona-age') as HTMLInputElement;
      const pronounsInput = document.getElementById('persona-pronouns') as HTMLInputElement;
      const aboutInput = document.getElementById('persona-about') as HTMLTextAreaElement;
      const directivesInput = document.getElementById('persona-directives') as HTMLTextAreaElement;

      p.name = nameInp?.value.trim() || '';
      p.age = ageInput?.value.trim() || '';
      p.pronouns = pronounsInput?.value.trim() || '';
      p.bio = aboutInput?.value.trim() || '';
      p.directives = directivesInput?.value.trim() || '';

      // Ensure active
      personas.forEach(x => { x.isDefault = (x.id === currentPersonaId); });

      savePersonas();
      renderPillList();
      fillForm();
      showToast('Persona saved', 'success');
    });

    // Delete Persona
    document.getElementById('btn-delete-persona')?.addEventListener('click', async () => {
      if (personas.length <= 1) return;
      const p = personas.find(x => x.id === currentPersonaId);
      const ok = await showConfirm('Delete Persona', `Delete "${p?.name || 'this persona'}"?`);
      if (!ok) return;

      personas = personas.filter(x => x.id !== currentPersonaId);
      if (!personas.some(x => x.isDefault)) {
        personas[0].isDefault = true;
      }
      currentPersonaId = personas[0].id;
      savePersonas();
      renderPillList();
      fillForm();
      showToast('Persona deleted');
    });

    // NSFW Mode Options
    const nsfwButtons = document.querySelectorAll('.nsfw-opt-btn');
    const currentNsfw = localStorage.getItem('aetheria_nsfw_mode') || 'show';

    function updateNsfwButtons(mode: string) {
      nsfwButtons.forEach(btn => {
        const bMode = btn.getAttribute('data-mode');
        if (bMode === mode) {
          btn.className = 'nsfw-opt-btn py-2.5 px-2 rounded-xl border border-purple-500/60 bg-purple-600/20 text-white font-semibold text-center transition cursor-pointer text-xs';
        } else {
          btn.className = 'nsfw-opt-btn py-2.5 px-2 rounded-xl border border-white/5 bg-white/[0.02] text-slate-400 hover:text-white font-medium text-center transition cursor-pointer text-xs';
        }
      });
    }

    updateNsfwButtons(currentNsfw);

    nsfwButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const mode = btn.getAttribute('data-mode') || 'show';
        localStorage.setItem('aetheria_nsfw_mode', mode);
        updateNsfwButtons(mode);
        showToast('Preference saved', 'success');
      });
    });

    // Check Auth State
    fetch('/api/auth/me')
      .then(res => res.json())
      .then((data: any) => {
        if (data.authenticated && data.user) {
          const nameLabel = document.getElementById('account-name-label');
          const emailLabel = document.getElementById('account-email-label');
          const avatarPill = document.getElementById('account-avatar-pill');
          const actionBox = document.getElementById('account-action-container');

          if (nameLabel) nameLabel.textContent = data.user.name || 'User';
          if (emailLabel) emailLabel.textContent = data.user.email || '';
          if (avatarPill) avatarPill.textContent = (data.user.name || 'U').charAt(0).toUpperCase();

          if (actionBox) {
            actionBox.innerHTML = `
              <button id="btn-logout" type="button" class="px-3.5 py-1.5 rounded-xl bg-white/5 hover:bg-white/10 text-xs font-semibold text-slate-300 hover:text-white transition cursor-pointer">
                Sign Out
              </button>
            `;
            document.getElementById('btn-logout')?.addEventListener('click', async () => {
              await fetch('/api/auth/logout', { method: 'POST' });
              window.location.reload();
            });
          }
        }
      })
      .catch(() => {});

    // Export Backup
    document.getElementById('btn-export-backup')?.addEventListener('click', () => {
      const backupData: Record<string, any> = {};
      for (let i = 0; i < localStorage.length; i++) {
        const key = localStorage.key(i);
        if (key && key.startsWith('aetheria_')) {
          backupData[key] = localStorage.getItem(key);
        }
      }
      const blob = new Blob([JSON.stringify(backupData, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `aetheria_backup_${new Date().toISOString().slice(0,10)}.json`;
      a.click();
      URL.revokeObjectURL(url);
      showToast('Backup downloaded', 'success');
    });

    // Restore Backup
    document.getElementById('backup-file-input')?.addEventListener('change', (e: any) => {
      const file = e.target?.files?.[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = (event) => {
        try {
          const data = JSON.parse(event.target?.result as string);
          Object.keys(data).forEach(k => {
            if (k.startsWith('aetheria_')) {
              localStorage.setItem(k, data[k]);
            }
          });
          showToast('Backup restored successfully!', 'success');
          setTimeout(() => window.location.reload(), 800);
        } catch {
          showToast('Invalid backup file', 'warning');
        }
      };
      reader.readAsText(file);
    });

    // Clear Cache
    document.getElementById('btn-clear-cache')?.addEventListener('click', async () => {
      const ok = await showConfirm('Clear Local Cache', 'Reset local data? Characters and personas saved only locally will be cleared.');
      if (!ok) return;

      Object.keys(localStorage).forEach(k => {
        if (k.startsWith('aetheria_')) localStorage.removeItem(k);
      });
      window.location.reload();
    });

    // ==========================================
    // PROFILE CHAT APPEARANCE & THEME CONTROLLER (STEP 2 ENGINE)
    // ==========================================
    function initProfileThemeSection() {
    let settings = { ...(window.AetheriaTheme?.getSettings?.(null) || {}) };

    const previewViewport = document.getElementById('profile-preview-viewport');
    const previewImage = document.getElementById('profile-preview-image');
    const previewDimmer = document.getElementById('profile-preview-dimmer');
    const previewPattern = document.getElementById('profile-preview-pattern');
    const previewCharBubble = document.getElementById('profile-preview-char-bubble');
    const previewUserBubble = document.getElementById('profile-preview-user-bubble');
    const previewCharName = document.getElementById('profile-preview-char-name');

    const baseModeButtons = document.querySelectorAll('#profile-base-mode-group .profile-mode-btn');

    const fontSlider = document.getElementById('profile-font-slider');
    const fontVal = document.getElementById('profile-font-val');
    const radiusSlider = document.getElementById('profile-radius-slider');
    const radiusVal = document.getElementById('profile-radius-val');

    const blurToggle = document.getElementById('profile-blur-toggle');
    const dimSlider = document.getElementById('profile-dim-slider');
    const dimVal = document.getElementById('profile-dim-val');
    const patternOpacitySlider = document.getElementById('profile-pattern-opacity-slider');
    const patternOpacityVal = document.getElementById('profile-pattern-opacity-val');

    const photoFileInput = document.getElementById('profile-photo-file');
    const photoBtn = document.getElementById('profile-photo-btn');
    const photoUrlInput = document.getElementById('profile-photo-url-input');
    const photoUrlApply = document.getElementById('profile-photo-url-apply');

    const gradColorA = document.getElementById('profile-gradient-color-a');
    const gradValA = document.getElementById('profile-gradient-val-a');
    const gradColorB = document.getElementById('profile-gradient-color-b');
    const gradValB = document.getElementById('profile-gradient-val-b');
    const applyGradBtn = document.getElementById('profile-apply-custom-gradient');

    const nameColorPalette = document.getElementById('profile-name-color-palette');
    const customNameColorInput = document.getElementById('profile-custom-name-color');
    const nameColorHex = document.getElementById('profile-name-color-hex');

    const soundToggle = document.getElementById('profile-sound-toggle');
    const soundTestSend = document.getElementById('profile-sound-test-send');
    const soundTestReceive = document.getElementById('profile-sound-test-receive');

    const densityComfortable = document.getElementById('profile-density-comfortable');
    const densityCompact = document.getElementById('profile-density-compact');
    const sendEnter = document.getElementById('profile-send-enter');
    const sendCtrlEnter = document.getElementById('profile-send-ctrl-enter');

    const exportBtn = document.getElementById('profile-export-btn');
    const importBtn = document.getElementById('profile-import-btn');
    const resetFactoryBtn = document.getElementById('profile-reset-factory-btn');

    const btnToggleCustomForm = document.getElementById('profile-btn-toggle-custom-form');
    const customThemeForm = document.getElementById('profile-custom-theme-form');
    const customThemeNameInput = document.getElementById('profile-custom-theme-name');
    const btnSaveCustomTheme = document.getElementById('profile-btn-save-custom');
    const btnCancelCustomTheme = document.getElementById('profile-btn-cancel-custom');
    const customThemesContainer = document.getElementById('profile-custom-themes-container');
    const customThemesGrid = document.getElementById('profile-custom-themes-grid');

    function updateLivePreview() {
      if (!previewViewport) return;

      const baseMode = settings.baseMode || 'dark';

      if (baseMode === 'amoled') {
        previewViewport.style.backgroundColor = '#000000';
        if (previewCharBubble) {
          previewCharBubble.style.background = '#09090b';
          previewCharBubble.style.borderColor = 'rgba(255, 255, 255, 0.08)';
          previewCharBubble.style.color = '#f1f5f9';
        }
      } else if (baseMode === 'day') {
        previewViewport.style.backgroundColor = '#e2e8f0';
        if (previewCharBubble) {
          previewCharBubble.style.background = '#ffffff';
          previewCharBubble.style.borderColor = '#cbd5e1';
          previewCharBubble.style.color = '#0f172a';
        }
      } else {
        previewViewport.style.backgroundColor = '#090a12';
        if (previewCharBubble) {
          previewCharBubble.style.background = settings.charBubbleBg || '#101426';
          previewCharBubble.style.borderColor = 'rgba(255, 255, 255, 0.08)';
          previewCharBubble.style.color = '#f1f5f9';
        }
      }

      if (previewImage) {
        previewImage.style.background = settings.chatWallpaper || 'linear-gradient(to bottom, #090a12, #0e1122, #07080f)';
        previewImage.style.filter = settings.chatBlur ? 'blur(14px)' : 'none';
        previewImage.style.transform = settings.chatBlur ? 'scale(1.08)' : 'none';
      }

      if (previewDimmer) {
        previewDimmer.style.opacity = String(settings.chatDim !== undefined ? settings.chatDim : 0.20);
      }

      if (previewPattern) {
        const patId = settings.chatPatternId || 'telegram-doodles';
        const patObj = window.AetheriaTheme?.DOODLE_PATTERNS?.[patId];
        if (patObj && patObj.pattern !== 'none') {
          previewPattern.style.backgroundImage = patObj.pattern;
          previewPattern.style.backgroundSize = patObj.patternSize;
          previewPattern.style.opacity = String(settings.chatPatternOpacity !== undefined ? settings.chatPatternOpacity : 0.18);
        } else {
          previewPattern.style.backgroundImage = 'none';
          previewPattern.style.opacity = '0';
        }
      }

      const nameColor = settings.nameColor || '#a855f7';
      if (previewCharName) previewCharName.style.color = nameColor;

      const radius = settings.bubbleRadius !== undefined ? settings.bubbleRadius : 16;
      const fontSize = settings.fontSize !== undefined ? settings.fontSize : 16;

      if (previewCharBubble) {
        previewCharBubble.style.borderRadius = `${radius}px`;
        previewCharBubble.style.fontSize = `${fontSize}px`;
      }
      if (previewUserBubble) {
        previewUserBubble.style.borderRadius = `${radius}px`;
        previewUserBubble.style.fontSize = `${fontSize}px`;
        if (settings.userBubbleBg) previewUserBubble.style.background = settings.userBubbleBg;
      }

      baseModeButtons.forEach(btn => {
        if (btn.dataset.mode === baseMode) {
          btn.classList.add('bg-purple-600', 'text-white');
          btn.classList.remove('text-slate-300');
        } else {
          btn.classList.remove('bg-purple-600', 'text-white');
          btn.classList.add('text-slate-300');
        }
      });
    }

    baseModeButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        settings.baseMode = btn.dataset.mode;
        if (settings.baseMode === 'amoled') {
          settings.chatWallpaper = '#000000';
          settings.chatPatternId = 'none';
        } else if (settings.baseMode === 'day') {
          settings.chatWallpaper = 'linear-gradient(to bottom, #e2e8f0, #cbd5e1, #94a3b8)';
        }
        updateLivePreview();
        saveAndApply();
      });
    });

    function saveAndApply() {
      window.AetheriaTheme?.saveSettings?.(settings, null);
      window.AetheriaTheme?.apply?.(settings);
    }

    function renderPresets() {
      const grid = document.getElementById('profile-presets-grid');
      if (!grid) return;
      const presets = window.AetheriaTheme?.PRESETS || [];

      grid.innerHTML = presets.map(p => `
        <div class="preset-card p-3 rounded-2xl bg-white/[0.02] border border-white/[0.08] hover:border-purple-500/50 hover:bg-white/[0.04] transition cursor-pointer group flex items-center justify-between" data-preset-id="${p.id}">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br ${p.iconGradient || 'from-purple-600 to-indigo-600'} p-0.5 shadow-md flex items-center justify-center text-white shrink-0">
              <span class="text-xs font-bold font-mono">TG</span>
            </div>
            <div>
              <div class="flex items-center gap-1.5">
                <span class="text-xs font-bold text-white group-hover:text-purple-300 transition">${p.name}</span>
                <span class="text-[9px] px-1.5 py-0.2 rounded bg-white/10 text-slate-300 uppercase font-mono">${p.baseMode || 'dark'}</span>
              </div>
              <p class="text-[11px] text-slate-400 truncate max-w-[170px] sm:max-w-[210px]">${p.description}</p>
            </div>
          </div>
          <div class="w-6 h-6 rounded-full border border-white/20 flex items-center justify-center text-transparent preset-indicator shrink-0">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </div>
        </div>
      `).join('');

      grid.querySelectorAll('.preset-card').forEach(card => {
        card.addEventListener('click', () => {
          const found = presets.find(p => p.id === card.dataset.presetId);
          if (!found) return;
          settings = { ...settings, ...found };
          syncInputs();
          updateLivePreview();
          saveAndApply();
        });
      });
    }

    function renderCustomThemes() {
      if (!customThemesContainer || !customThemesGrid) return;
      const list = window.AetheriaTheme?.getCustomThemes?.() || [];

      if (list.length === 0) {
        customThemesContainer.classList.add('hidden');
        return;
      }

      customThemesContainer.classList.remove('hidden');
      customThemesGrid.innerHTML = list.map(t => `
        <div class="p-2.5 rounded-xl bg-white/[0.03] border border-purple-500/20 hover:border-purple-500/60 transition group flex flex-col justify-between" data-custom-id="${t.id}">
          <div class="flex items-center justify-between gap-1 mb-2">
            <span class="text-xs font-bold text-white truncate max-w-[110px]">${escapeHtml(t.name)}</span>
            <button type="button" class="delete-custom-btn text-slate-500 hover:text-rose-400 p-1 rounded transition cursor-pointer" data-delete-id="${t.id}" title="Delete Theme">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            </button>
          </div>
          <div class="flex items-center gap-1.5 mb-2">
            <div class="w-4 h-4 rounded-full" style="background: ${t.accent || '#9333ea'};" title="Accent"></div>
            <div class="w-4 h-4 rounded-full" style="background: ${t.nameColor || '#a855f7'};" title="Name"></div>
            <div class="flex-1 h-3 rounded-full opacity-80" style="background: ${t.userBubbleBg || 'linear-gradient(135deg, #9333ea, #6366f1)'};" title="Bubble"></div>
          </div>
          <button type="button" class="apply-custom-btn w-full py-1 rounded-lg bg-purple-600/30 hover:bg-purple-600 text-purple-200 hover:text-white text-[10px] font-bold transition cursor-pointer text-center">
            Apply Theme
          </button>
        </div>
      `).join('');

      customThemesGrid.querySelectorAll('.apply-custom-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const card = e.target.closest('[data-custom-id]');
          const found = list.find(item => item.id === card?.dataset.customId);
          if (found) {
            settings = { ...settings, ...found };
            syncInputs();
            updateLivePreview();
            saveAndApply();
          }
        });
      });

      customThemesGrid.querySelectorAll('.delete-custom-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const id = btn.dataset.deleteId;
          if (confirm('Delete this custom theme?')) {
            window.AetheriaTheme?.deleteCustomTheme?.(id);
            renderCustomThemes();
          }
        });
      });
    }

    btnToggleCustomForm?.addEventListener('click', () => {
      customThemeForm?.classList.toggle('hidden');
      if (!customThemeForm?.classList.contains('hidden')) customThemeNameInput?.focus();
    });

    btnCancelCustomTheme?.addEventListener('click', () => {
      customThemeForm?.classList.add('hidden');
      if (customThemeNameInput) customThemeNameInput.value = '';
    });

    btnSaveCustomTheme?.addEventListener('click', () => {
      const name = customThemeNameInput ? customThemeNameInput.value.trim() : '';
      if (!name) {
        alert('Please enter a theme name');
        return;
      }
      window.AetheriaTheme?.saveCustomTheme?.(name, settings);
      if (customThemeNameInput) customThemeNameInput.value = '';
      customThemeForm?.classList.add('hidden');
      renderCustomThemes();
    });

    function renderNameColors() {
      if (!nameColorPalette) return;
      const colors = window.AetheriaTheme?.NAME_COLORS || [];

      nameColorPalette.innerHTML = colors.map(nc => `
        <button type="button" class="name-color-pill p-2 rounded-xl bg-white/[0.02] border border-white/[0.08] hover:border-white/30 flex flex-col items-center gap-1.5 transition cursor-pointer" data-color="${nc.hex}" title="${nc.name}">
          <div class="w-6 h-6 rounded-full shadow-md flex items-center justify-center text-white" style="background: ${nc.hex};">
            <svg class="w-3 h-3 text-white opacity-0 name-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </div>
          <span class="text-[10px] text-slate-400 font-mono truncate max-w-[50px]">${nc.name.split(' ')[0]}</span>
        </button>
      `).join('');

      nameColorPalette.querySelectorAll('.name-color-pill').forEach(pill => {
        pill.addEventListener('click', () => {
          const col = pill.dataset.color;
          settings.nameColor = col;
          if (customNameColorInput) customNameColorInput.value = col;
          if (nameColorHex) nameColorHex.textContent = col.toUpperCase();
          updateNameColorSelection();
          updateLivePreview();
          saveAndApply();
        });
      });
    }

    function updateNameColorSelection() {
      const activeColor = (settings.nameColor || '#a855f7').toLowerCase();
      nameColorPalette?.querySelectorAll('.name-color-pill').forEach(pill => {
        const isMatch = (pill.dataset.color || '').toLowerCase() === activeColor;
        const check = pill.querySelector('.name-check');
        if (isMatch) {
          pill.classList.add('border-purple-500', 'bg-purple-500/10');
          if (check) check.classList.remove('opacity-0');
        } else {
          pill.classList.remove('border-purple-500', 'bg-purple-500/10');
          if (check) check.classList.add('opacity-0');
        }
      });
    }

    customNameColorInput?.addEventListener('input', (e) => {
      settings.nameColor = e.target.value;
      if (nameColorHex) nameColorHex.textContent = e.target.value.toUpperCase();
      updateNameColorSelection();
      updateLivePreview();
      saveAndApply();
    });

    function renderGradientPresets() {
      const container = document.getElementById('profile-bubble-gradient-presets');
      if (!container) return;
      const grads = window.AetheriaTheme?.BUBBLE_GRADIENTS || [];

      container.innerHTML = grads.map(g => `
        <button type="button" class="grad-pill p-2 rounded-xl bg-white/[0.02] border border-white/[0.06] hover:border-purple-500/50 flex items-center gap-2 transition cursor-pointer text-left" data-grad-css="${escapeHtml(g.css)}" data-grad-from="${g.from}" data-grad-to="${g.to}">
          <div class="w-5 h-5 rounded-lg shadow-inner shrink-0" style="background: ${g.css};"></div>
          <span class="text-xs text-slate-300 truncate font-medium">${g.name}</span>
        </button>
      `).join('');

      container.querySelectorAll('.grad-pill').forEach(pill => {
        pill.addEventListener('click', () => {
          settings.userBubbleBg = pill.dataset.gradCss;
          if (gradColorA) gradColorA.value = pill.dataset.gradFrom;
          if (gradValA) gradValA.textContent = pill.dataset.gradFrom.toUpperCase();
          if (gradColorB) gradColorB.value = pill.dataset.gradTo;
          if (gradValB) gradValB.textContent = pill.dataset.gradTo.toUpperCase();
          updateLivePreview();
          saveAndApply();
        });
      });
    }

    applyGradBtn?.addEventListener('click', () => {
      const from = gradColorA?.value || '#9333ea';
      const to = gradColorB?.value || '#6366f1';
      settings.userBubbleBg = `linear-gradient(135deg, ${from} 0%, ${to} 100%)`;
      updateLivePreview();
      saveAndApply();
    });

    function renderDoodlePills() {
      const container = document.getElementById('profile-doodle-pills');
      if (!container) return;
      const patterns = window.AetheriaTheme?.DOODLE_PATTERNS || {};

      container.innerHTML = Object.values(patterns).map(p => `
        <button type="button" class="pattern-pill p-2 rounded-xl bg-white/[0.02] border border-white/[0.06] hover:border-purple-500/40 text-[11px] font-medium text-slate-300 hover:text-white transition cursor-pointer flex flex-col items-center gap-1" data-pattern-id="${p.id}">
          <span class="truncate max-w-full">${p.name}</span>
        </button>
      `).join('');

      container.querySelectorAll('.pattern-pill').forEach(pill => {
        pill.addEventListener('click', () => {
          settings.chatPatternId = pill.dataset.patternId;
          updateDoodleSelection();
          updateLivePreview();
          saveAndApply();
        });
      });
    }

    function updateDoodleSelection() {
      const activePat = settings.chatPatternId || 'telegram-doodles';
      document.querySelectorAll('#profile-doodle-pills .pattern-pill').forEach(pill => {
        if (pill.dataset.patternId === activePat) {
          pill.classList.add('border-purple-500', 'bg-purple-500/20', 'text-white');
          pill.classList.remove('border-white/[0.06]', 'text-slate-300');
        } else {
          pill.classList.remove('border-purple-500', 'bg-purple-500/20', 'text-white');
          pill.classList.add('border-white/[0.06]', 'text-slate-300');
        }
      });
    }

    function renderWallpapers() {
      const grid = document.getElementById('profile-wallpapers-grid');
      if (!grid) return;
      const wallpapers = window.AetheriaTheme?.WALLPAPERS || [];

      grid.innerHTML = wallpapers.map(w => `
        <div class="wallpaper-card relative h-20 rounded-xl overflow-hidden border border-white/10 hover:border-purple-500 transition cursor-pointer group select-none shadow-sm" data-wallpaper-css="${escapeHtml(w.cssValue)}">
          <div class="absolute inset-0" style="background: ${w.thumb.startsWith('http') ? `url('${w.thumb}') center/cover` : w.thumb};"></div>
          <div class="absolute inset-0 bg-black/40 group-hover:bg-black/10 transition"></div>
          <span class="absolute bottom-1.5 left-2 text-[10px] font-medium text-white truncate max-w-[80%] drop-shadow">${w.name}</span>
        </div>
      `).join('');

      grid.querySelectorAll('.wallpaper-card').forEach(card => {
        card.addEventListener('click', () => {
          settings.chatWallpaper = card.dataset.wallpaperCss;
          updateLivePreview();
          saveAndApply();
        });
      });
    }

    // Sliders
    fontSlider?.addEventListener('input', (e) => {
      const val = parseInt(e.target.value, 10);
      settings.fontSize = val;
      if (fontVal) fontVal.textContent = `${val}px`;
      updateLivePreview();
      saveAndApply();
    });

    radiusSlider?.addEventListener('input', (e) => {
      const val = parseInt(e.target.value, 10);
      settings.bubbleRadius = val;
      if (radiusVal) radiusVal.textContent = `${val}px`;
      updateLivePreview();
      saveAndApply();
    });

    blurToggle?.addEventListener('click', () => {
      settings.chatBlur = !settings.chatBlur;
      if (blurToggle) {
        blurToggle.textContent = settings.chatBlur ? 'On' : 'Off';
        blurToggle.className = settings.chatBlur
          ? 'px-3 py-1.5 rounded-lg border text-xs font-semibold transition cursor-pointer bg-purple-500/20 border-purple-500/30 text-purple-300'
          : 'px-3 py-1.5 rounded-lg border text-xs font-semibold transition cursor-pointer bg-white/5 border-white/10 text-slate-300';
      }
      updateLivePreview();
      saveAndApply();
    });

    dimSlider?.addEventListener('input', (e) => {
      const val = parseInt(e.target.value, 10);
      settings.chatDim = val / 100;
      if (dimVal) dimVal.textContent = `${val}%`;
      updateLivePreview();
      saveAndApply();
    });

    patternOpacitySlider?.addEventListener('input', (e) => {
      const val = parseInt(e.target.value, 10);
      settings.chatPatternOpacity = val / 100;
      if (patternOpacityVal) patternOpacityVal.textContent = `${val}%`;
      updateLivePreview();
      saveAndApply();
    });

    // Sound
    function syncSound() {
      const enabled = window.AetheriaTheme?.isSoundEnabled?.() !== false;
      if (soundToggle) {
        soundToggle.textContent = enabled ? 'Enabled' : 'Muted';
        soundToggle.className = enabled
          ? 'px-3.5 py-1.5 rounded-xl border text-xs font-semibold transition cursor-pointer bg-purple-500/20 border-purple-500/30 text-purple-300'
          : 'px-3.5 py-1.5 rounded-xl border text-xs font-semibold transition cursor-pointer bg-white/5 border-white/10 text-slate-400';
      }
    }

    soundToggle?.addEventListener('click', () => {
      const current = window.AetheriaTheme?.isSoundEnabled?.() !== false;
      window.AetheriaTheme?.setSoundEnabled?.(!current);
      syncSound();
    });

    soundTestSend?.addEventListener('click', () => window.AetheriaTheme?.playSendSound?.());
    soundTestReceive?.addEventListener('click', () => window.AetheriaTheme?.playReceiveSound?.());

    // Photo
    photoBtn?.addEventListener('click', () => photoFileInput?.click());
    photoFileInput?.addEventListener('change', (e) => {
      const file = e.target.files?.[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (event) => {
        settings.chatWallpaper = `url("${event.target.result}") center/cover no-repeat`;
        updateLivePreview();
        saveAndApply();
      };
      reader.readAsDataURL(file);
    });

    photoUrlApply?.addEventListener('click', () => {
      const url = photoUrlInput ? photoUrlInput.value.trim() : '';
      if (!url) return;
      settings.chatWallpaper = `url("${url}") center/cover no-repeat`;
      updateLivePreview();
      saveAndApply();
    });

    // Density & Send Key
    densityComfortable?.addEventListener('change', () => {
      settings.chatDensity = 'comfortable';
      saveAndApply();
    });
    densityCompact?.addEventListener('change', () => {
      settings.chatDensity = 'compact';
      saveAndApply();
    });

    sendEnter?.addEventListener('change', () => localStorage.setItem('aetheria_chat_send_key', 'enter'));
    sendCtrlEnter?.addEventListener('change', () => localStorage.setItem('aetheria_chat_send_key', 'ctrl_enter'));

    exportBtn?.addEventListener('click', () => {
      navigator.clipboard?.writeText?.(JSON.stringify(settings, null, 2)).then(() => alert('Theme copied!'));
    });

    importBtn?.addEventListener('click', () => {
      const raw = prompt('Paste theme JSON:');
      if (raw) {
        try {
          settings = { ...settings, ...JSON.parse(raw) };
          syncInputs();
          updateLivePreview();
          saveAndApply();
        } catch {
          alert('Invalid JSON');
        }
      }
    });

    resetFactoryBtn?.addEventListener('click', () => {
      if (confirm('Reset to defaults?')) {
        window.AetheriaTheme?.resetToDefault?.(null);
        settings = { ...(window.AetheriaTheme?.DEFAULT_THEME || {}) };
        syncInputs();
        updateLivePreview();
      }
    });

    function syncInputs() {
      if (fontSlider) fontSlider.value = settings.fontSize || 16;
      if (fontVal) fontVal.textContent = `${settings.fontSize || 16}px`;

      if (radiusSlider) radiusSlider.value = settings.bubbleRadius !== undefined ? settings.bubbleRadius : 16;
      if (radiusVal) radiusVal.textContent = `${settings.bubbleRadius !== undefined ? settings.bubbleRadius : 16}px`;

      if (blurToggle) {
        blurToggle.textContent = settings.chatBlur ? 'On' : 'Off';
        blurToggle.className = settings.chatBlur
          ? 'px-3 py-1.5 rounded-lg border text-xs font-semibold transition cursor-pointer bg-purple-500/20 border-purple-500/30 text-purple-300'
          : 'px-3 py-1.5 rounded-lg border text-xs font-semibold transition cursor-pointer bg-white/5 border-white/10 text-slate-300';
      }

      const dim = Math.round((settings.chatDim !== undefined ? settings.chatDim : 0.20) * 100);
      if (dimSlider) dimSlider.value = dim;
      if (dimVal) dimVal.textContent = `${dim}%`;

      const patOp = Math.round((settings.chatPatternOpacity !== undefined ? settings.chatPatternOpacity : 0.18) * 100);
      if (patternOpacitySlider) patternOpacitySlider.value = patOp;
      if (patternOpacityVal) patternOpacityVal.textContent = `${patOp}%`;

      if (customNameColorInput) customNameColorInput.value = settings.nameColor || '#a855f7';
      if (nameColorHex) nameColorHex.textContent = (settings.nameColor || '#a855f7').toUpperCase();

      if (settings.chatDensity === 'compact') {
        if (densityCompact) densityCompact.checked = true;
      } else {
        if (densityComfortable) densityComfortable.checked = true;
      }

      const sendPref = localStorage.getItem('aetheria_chat_send_key') || 'enter';
      if (sendPref === 'ctrl_enter') {
        if (sendCtrlEnter) sendCtrlEnter.checked = true;
      } else {
        if (sendEnter) sendEnter.checked = true;
      }

      updateDoodleSelection();
      updateNameColorSelection();
      syncSound();
    }

    renderPresets();
    renderCustomThemes();
    renderNameColors();
    renderDoodlePills();
    renderWallpapers();
    renderGradientPresets();
    syncInputs();
    updateLivePreview();
  }

    initProfileThemeSection();
  });
</script>
