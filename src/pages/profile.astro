              <!-- 4. Mock Chat Interface Container -->
              <div class="w-full rounded-2xl p-2.5 relative overflow-hidden flex flex-col justify-between h-[86px] shadow-inner" style="background: ${p.charBubbleBg}99; backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.06);">
                <!-- Floating Theme Micro-Elements -->
                <div class="absolute inset-0 pointer-events-none overflow-hidden select-none">
                  ${floatingHtml}
