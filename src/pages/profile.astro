    // Helper: Push Notification UI & Permission Request
    function updatePushNotificationBadge() {
      const pushLabel = document.getElementById('push-channel-label');
      const pushBtn = document.getElementById('btn-channel-browser-push');
      if (!pushLabel || !pushBtn) return;

      if (!('Notification' in window)) {
        pushLabel.textContent = 'Browser Push: Unsupported';
        pushBtn.className = 'flex items-center gap-1.5 px-2.5 py-1 rounded-xl text-[11px] font-medium border bg-white/[0.03] text-slate-400 border-white/[0.08] cursor-default';
        return;
      }

      if (Notification.permission === 'granted') {
        pushLabel.textContent = 'Browser Push: Enabled';
        pushBtn.className = 'flex items-center gap-1.5 px-2.5 py-1 rounded-xl text-[11px] font-medium transition cursor-pointer border bg-emerald-500/10 text-emerald-300 border-emerald-500/20 hover:bg-emerald-500/20 active:scale-95';
      } else if (Notification.permission === 'denied') {
        pushLabel.textContent = 'Browser Push: Blocked';
        pushBtn.className = 'flex items-center gap-1.5 px-2.5 py-1 rounded-xl text-[11px] font-medium transition cursor-pointer border bg-rose-500/10 text-rose-300 border-rose-500/20 hover:bg-rose-500/20 active:scale-95';
      } else {
        pushLabel.textContent = 'Browser Push: Tap to Enable';
        pushBtn.className = 'flex items-center gap-1.5 px-2.5 py-1 rounded-xl text-[11px] font-medium transition cursor-pointer border bg-amber-500/10 text-amber-300 border-amber-500/20 hover:bg-amber-500/20 active:scale-95';
      }
    }

    document.getElementById('btn-channel-browser-push')?.addEventListener('click', async () => {
      if (!('Notification' in window)) {
        showToast('Push notifications are not supported in this browser.', 'info');
        return;
      }
      if (Notification.permission === 'granted') {
        showToast('Browser push notifications are currently active for this hardware.', 'info');
        return;
      }
      if (Notification.permission === 'denied') {
        showToast('Notifications are blocked by browser permissions. Please enable in site settings.', 'info');
        return;
      }
      try {
        const permission = await Notification.requestPermission();
        updatePushNotificationBadge();
        if (permission === 'granted') {
          showToast('Browser push notifications enabled for login alerts!', 'success');
        } else {
          showToast('Notification permission was not granted.', 'info');
        }
      } catch {
        showToast('Unable to request notification permission.', 'error');
      }
    });

    // Helper: Inactive Session Expiration Selector Logic
    const sessionExpiryOptions = ['7 Days', '30 Days', '90 Days', 'Never'];
    const sessionExpiryDescriptions: Record<string, string> = {
      '7 Days': 'Dormant session tokens are automatically destroyed after 7 days of inactivity.',
      '30 Days': 'Dormant session tokens are automatically destroyed after 30 days of inactivity.',
      '90 Days': 'Dormant session tokens are automatically destroyed after 90 days of inactivity.',
      'Never': 'Persistent session tokens remain active until explicitly revoked.'
    };

    function updateSessionExpiryUI(val: string) {
      const valEl = document.getElementById('session-expiry-val');
      const descEl = document.getElementById('session-expiry-desc');
      if (valEl) valEl.textContent = val;
      if (descEl && sessionExpiryDescriptions[val]) descEl.textContent = sessionExpiryDescriptions[val];
    }

    // Initialize session expiry from localStorage
    const savedSessionExpiry = localStorage.getItem('aetheria_session_expiry') || '30 Days';
    updateSessionExpiryUI(savedSessionExpiry);

    document.getElementById('btn-session-expiry-selector')?.addEventListener('click', () => {
      const currentVal = localStorage.getItem('aetheria_session_expiry') || '30 Days';
      const currentIndex = sessionExpiryOptions.indexOf(currentVal);
      const nextIndex = (currentIndex + 1) % sessionExpiryOptions.length;
      const nextVal = sessionExpiryOptions[nextIndex];

      localStorage.setItem('aetheria_session_expiry', nextVal);
      updateSessionExpiryUI(nextVal);
      showToast(`Session expiration window set to ${nextVal}`, 'success');

      const token = localStorage.getItem('aetheria_auth_token');
      const headers: Record<string, string> = { 'Content-Type': 'application/json' };
      if (token) headers['Authorization'] = `Bearer ${token}`;
      fetch('/api/security/settings', {
        method: 'POST',
        headers,
        body: JSON.stringify({ sessionExpiry: nextVal })
      }).catch(() => {});
    });

