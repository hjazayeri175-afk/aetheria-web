  function handleBindToChat(personaId: string) {
    const p = personas.find(x => x.id === personaId);
    if (!p) return;

    const currentBindings = (p.boundChatIds || []).join(', ');
    const promptText = `Bind "${p.name || 'Persona'}" to specific character chats.\n\nCurrent bound chats: ${currentBindings || 'All chats (Unrestricted)'}\n\nEnter comma-separated Character IDs to lock to specific chats, or leave empty for All Chats:`;

    const input = window.prompt(promptText, currentBindings);
    if (input === null) return; // User cancelled

    const trimmed = input.trim();
    if (!trimmed) {
      p.boundChatIds = [];
      showToast(`"${p.name}" active in ALL chats`, 'info');
    } else {
      p.boundChatIds = trimmed.split(',').map(s => s.trim()).filter(Boolean);
      showToast(`Bound to ${p.boundChatIds.length} chat(s)`, 'success');
    }

    savePersonas();
    render3DCarousel();
  }

  function setupGestures() {
    const stage = document.getElementById('persona-carousel-stage');
    if (!stage) return;

    let startX = 0;
    let startY = 0;
    let isDown = false;

    stage.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
      isDown = true;
    }, { passive: true });

    stage.addEventListener('touchend', (e) => {
      if (!isDown) return;
      isDown = false;
      const endX = e.changedTouches[0].clientX;
      const endY = e.changedTouches[0].clientY;
      const diffX = endX - startX;
      const diffY = endY - startY;

      if (Math.abs(diffX) > 40 && Math.abs(diffX) > Math.abs(diffY)) {
        if (diffX < 0) {
          goToCard(activeCardIndex + 1);
        } else {
          goToCard(activeCardIndex - 1);
        }
      }
    }, { passive: true });

    // Desktop mouse drag
    let mouseStartX = 0;
    let isMouseDown = false;

    stage.addEventListener('mousedown', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('input, textarea, button, select, label, details')) return;
      isMouseDown = true;
      mouseStartX = e.clientX;
    });

    window.addEventListener('mouseup', (e) => {
      if (!isMouseDown) return;
      isMouseDown = false;
      const diffX = e.clientX - mouseStartX;
      if (Math.abs(diffX) > 45) {
        if (diffX < 0) {
          goToCard(activeCardIndex + 1);
        } else {
          goToCard(activeCardIndex - 1);
        }
      }
    });

    // Keyboard navigation
    window.addEventListener('keydown', (e) => {
      const personasView = document.getElementById('view-personas');
      if (!personasView || personasView.classList.contains('hidden')) return;
      const activeEl = document.activeElement;
      if (activeEl && (activeEl.tagName === 'INPUT' || activeEl.tagName === 'TEXTAREA')) return;

      if (e.key === 'ArrowRight') {
        goToCard(activeCardIndex + 1);
      } else if (e.key === 'ArrowLeft') {
        goToCard(activeCardIndex - 1);
      }
    });

    // Prev / Next button listeners
    document.getElementById('carousel-btn-prev')?.addEventListener('click', () => {
      goToCard(activeCardIndex - 1);
    });
    document.getElementById('carousel-btn-next')?.addEventListener('click', () => {
      goToCard(activeCardIndex + 1);
    });
  }

  // File input change listener for Base64 image
  const globalAvatarFileInput = document.getElementById('avatar-file-input') as HTMLInputElement;
