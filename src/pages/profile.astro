    document.getElementById('btn-clear-security-history')?.addEventListener('click', async () => {
      if (!cachedSecurityLogs || cachedSecurityLogs.length === 0) {
        showToast('No security history to clear', 'info');
        return;
      }
      const confirmed = await showConfirm(
        'Clear Security History?',
        'Are you sure you want to clear your security audit logs? All recorded authentication events will be removed from view.'
