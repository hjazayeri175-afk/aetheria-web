---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import BottomNav from '../components/BottomNav.astro';
import { 
  User, 
  Sparkles, 
  Save, 
  Trash2, 
  Plus, 
  Check, 
  Eye, 
  EyeOff,
  Camera,
  Settings,
  Shield,
  Download,
  Upload,
  LogOut,
  LogIn,
  ChevronDown
} from '@lucide/astro';
---

<Layout title="Profile & Personas | Aetheria">
  <Header />

  <main class="min-h-screen bg-[#060813] text-slate-100 pb-28 pt-4 sm:pt-8 px-4">
    <div class="max-w-xl mx-auto">
      
      <!-- Top Navigation Tabs -->
      <div class="flex items-center gap-1 p-1 rounded-2xl bg-white/[0.04] border border-white/[0.08] mb-8">
        <button 
          id="tab-btn-personas" 
          type="button" 
          class="flex-1 py-2.5 px-4 rounded-xl text-sm font-semibold transition cursor-pointer bg-purple-600 text-white shadow-lg shadow-purple-900/40"
        >
          Personas
        </button>
        <button 
          id="tab-btn-settings" 
          type="button" 
          class="flex-1 py-2.5 px-4 rounded-xl text-sm font-semibold transition cursor-pointer text-slate-400 hover:text-white hover:bg-white/[0.04]"
        >
          Settings
        </button>
      </div>

      <!-- ========================================== -->
      <!-- TAB 1: PERSONAS (Clean, Simple, User-first) -->
      <!-- ========================================== -->
      <div id="tab-view-personas" class="space-y-6">
        
        <!-- Header & Action -->
        <div class="flex items-center justify-between">
          <div>
            <h1 class="text-xl font-bold text-white tracking-tight">Personas</h1>
            <p class="text-xs text-slate-400 mt-0.5">Customize how characters perceive you in chat</p>
          </div>
          <button 
            type="button" 
            id="btn-new-persona"
            class="px-3.5 py-1.5 rounded-xl bg-purple-600/20 hover:bg-purple-600/30 border border-purple-500/40 text-purple-300 hover:text-white text-xs font-semibold flex items-center gap-1.5 transition active:scale-95 cursor-pointer shadow-sm"
          >
            <Plus class="w-3.5 h-3.5" />
            <span>New Persona</span>
          </button>
        </div>

        <!-- Master Enable / Disable Toggle -->
        <div class="flex items-center justify-between p-4 rounded-2xl bg-white/[0.02] border border-white/[0.08] transition">
          <div class="flex items-center gap-3">
            <div id="persona-toggle-icon" class="w-9 h-9 rounded-xl bg-purple-600/20 border border-purple-500/30 flex items-center justify-center text-purple-300 transition">
              <User class="w-4 h-4" />
            </div>
            <div>
              <p class="text-xs font-semibold text-white">Enable Persona in Chats</p>
              <p id="persona-toggle-status" class="text-[11px] text-slate-400 transition">Active in chats • Characters will use your persona</p>
            </div>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="persona-master-toggle" class="sr-only peer" checked>
            <div class="w-11 h-6 bg-white/10 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-purple-600"></div>
          </label>
        </div>

        <!-- Modern Persona Carousel Bar -->
        <div class="space-y-2">
          <div class="flex items-center justify-between text-xs text-slate-400 px-1">
            <span>Your Personas</span>
            <span id="personas-count-label" class="text-[11px] text-purple-400 font-medium">1 persona</span>
          </div>
          <div id="personas-pill-list" class="flex items-center gap-2.5 overflow-x-auto pb-2 pt-0.5 no-scrollbar scroll-smooth">
            <!-- Populated by JS -->
          </div>
        </div>

        <!-- Persona Editor Card -->
        <div class="rounded-3xl bg-white/[0.02] border border-white/[0.08] p-5 sm:p-7 space-y-6">
          
          <!-- Avatar + Basic Info Row -->
          <div class="flex flex-col sm:flex-row items-center sm:items-start gap-5">
            
            <!-- Click-to-Change Avatar -->
            <div class="flex flex-col items-center gap-2 shrink-0">
              <div class="relative group cursor-pointer" id="avatar-click-zone" title="Click to change photo">
                <div class="w-20 h-20 sm:w-24 sm:h-24 rounded-full overflow-hidden border-2 border-purple-500/40 bg-purple-950/30 flex items-center justify-center shadow-lg shadow-purple-950/50 transition group-hover:border-purple-400">
                  <img 
                    id="persona-avatar-img" 
                    src="" 
                    alt="Persona Avatar" 
                    class="w-full h-full object-cover hidden" 
                  />
                  <div id="persona-avatar-placeholder" class="flex flex-col items-center justify-center text-purple-400">
                    <User class="w-8 h-8 sm:w-10 sm:h-10 opacity-70" />
                  </div>
                </div>
                <!-- Camera Badge Overlay -->
                <div class="absolute inset-0 rounded-full bg-black/50 backdrop-blur-[2px] opacity-0 group-hover:opacity-100 flex flex-col items-center justify-center text-white text-[10px] font-medium transition duration-200">
                  <Camera class="w-5 h-5 mb-0.5 text-purple-300" />
                  <span>Change</span>
                </div>
              </div>

              <!-- Hidden File Input -->
              <input type="file" id="avatar-file-input" accept="image/png,image/jpeg,image/webp,image/gif" class="hidden" />

              <!-- Remove Photo Link -->
              <button 
                type="button" 
                id="btn-remove-avatar" 
                class="hidden text-[11px] text-red-400/80 hover:text-red-300 transition cursor-pointer"
              >
                Remove photo
              </button>
            </div>

            <!-- Name, Age, Pronouns -->
            <div class="flex-1 w-full space-y-3.5">
              <div>
                <label for="persona-name" class="block text-xs font-semibold text-slate-300 mb-1">
                  Name
                </label>
                <input 
                  type="text" 
                  id="persona-name" 
                  placeholder="Name" 
                  class="w-full px-3.5 py-2.5 rounded-xl bg-white/[0.04] border border-white/10 focus:border-purple-500/60 text-sm font-medium text-white placeholder:text-slate-600 outline-none transition"
                />
              </div>

              <div class="grid grid-cols-2 gap-3">
                <div>
                  <label for="persona-age" class="block text-xs font-semibold text-slate-300 mb-1">
                    Age
                  </label>
                  <input 
                    type="text" 
                    id="persona-age" 
                    placeholder="Age" 
                    class="w-full px-3.5 py-2 rounded-xl bg-white/[0.04] border border-white/10 focus:border-purple-500/60 text-sm font-medium text-white placeholder:text-slate-600 outline-none transition"
                  />
                </div>
                <div>
                  <label for="persona-pronouns" class="block text-xs font-semibold text-slate-300 mb-1">
                    Pronouns
                  </label>
                  <input 
                    type="text" 
                    id="persona-pronouns" 
                    placeholder="Pronouns" 
                    class="w-full px-3.5 py-2 rounded-xl bg-white/[0.04] border border-white/10 focus:border-purple-500/60 text-sm font-medium text-white placeholder:text-slate-600 outline-none transition"
                  />
                </div>
              </div>
            </div>
          </div>

          <!-- About You / Description -->
          <div>
            <label for="persona-about" class="block text-xs font-semibold text-slate-300 mb-1">
              About Persona
            </label>
            <textarea 
              id="persona-about" 
              rows="4" 
              placeholder="Describe your appearance, personality, or background..." 
              class="w-full px-3.5 py-2.5 rounded-xl bg-white/[0.04] border border-white/10 focus:border-purple-500/60 text-sm text-slate-200 placeholder:text-slate-600 outline-none transition resize-y leading-relaxed"
            ></textarea>
          </div>

          <!-- Optional Advanced Instructions (Collapsible, unbloated) -->
          <details class="group border border-white/5 rounded-2xl bg-white/[0.01] px-4 py-3 text-xs">
            <summary class="cursor-pointer text-slate-400 hover:text-slate-200 font-medium flex items-center justify-between select-none">
              <span>Additional instructions (optional)</span>
              <ChevronDown class="w-3.5 h-3.5 transition-transform group-open:rotate-180 opacity-60" />
            </summary>
            <div class="pt-3">
              <textarea 
                id="persona-directives" 
                rows="2" 
                placeholder="Optional formatting or instructions..." 
                class="w-full px-3 py-2 rounded-xl bg-white/[0.03] border border-white/10 focus:border-purple-500/50 text-xs text-slate-300 placeholder:text-slate-600 outline-none transition"
              ></textarea>
            </div>
          </details>

          <!-- Action Buttons -->
          <div class="flex items-center justify-between pt-2 border-t border-white/[0.06]">
            <div>
              <button 
                type="button" 
                id="btn-delete-persona" 
                class="text-xs text-red-400/80 hover:text-red-300 transition flex items-center gap-1 cursor-pointer py-1.5 px-2 rounded-lg hover:bg-red-500/10"
              >
                <Trash2 class="w-3.5 h-3.5" />
                <span>Delete</span>
              </button>
            </div>

            <div class="flex items-center gap-2.5">
              <!-- Equipped Status Badge (Non-clickable) -->
              <div 
                id="persona-status-badge" 
                class="px-3 py-1.5 rounded-xl bg-purple-500/15 border border-purple-500/30 text-purple-300 text-xs font-semibold flex items-center gap-1.5 select-none"
              >
                <Check class="w-3.5 h-3.5 text-purple-400" />
                <span id="persona-status-badge-text">Equipped</span>
              </div>

              <!-- Equip Action Button (Shown only when viewing non-active persona) -->
              <button 
                type="button" 
                id="btn-set-default" 
                class="hidden px-3.5 py-1.5 rounded-xl bg-white/[0.06] hover:bg-purple-600/30 border border-white/10 hover:border-purple-500/40 text-xs font-semibold text-slate-200 hover:text-white transition active:scale-95 cursor-pointer flex items-center gap-1.5"
              >
                <Check class="w-3.5 h-3.5 text-purple-400" />
                <span>Equip for Chat</span>
              </button>

              <button 
                type="button" 
                id="btn-save-persona" 
                class="px-4 py-2 rounded-xl bg-purple-600 hover:bg-purple-500 text-white text-xs font-semibold transition active:scale-95 cursor-pointer shadow-md shadow-purple-900/40 flex items-center gap-1.5"
              >
                <Save class="w-3.5 h-3.5" />
                <span>Save</span>
              </button>
            </div>
          </div>

        </div>

      </div>

      <!-- ========================================== -->
      <!-- TAB 2: SETTINGS (Account, Content & Backup)-->
      <!-- ========================================== -->
      <div id="tab-view-settings" class="hidden space-y-6">
        
        <div>
          <h1 class="text-xl font-bold text-white tracking-tight">Settings</h1>
          <p class="text-xs text-slate-400 mt-0.5">Manage your account and preferences</p>
        </div>

        <!-- Account Section -->
        <div class="rounded-3xl bg-white/[0.02] border border-white/[0.08] p-5 sm:p-6 space-y-4">
          <h2 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Account</h2>
          
          <div id="account-status-card" class="flex items-center justify-between p-3.5 rounded-2xl bg-white/[0.03] border border-white/5">
            <div class="flex items-center gap-3">
              <div id="account-avatar-pill" class="w-10 h-10 rounded-full bg-purple-600/30 border border-purple-500/40 flex items-center justify-center text-sm font-bold text-purple-200">
                G
              </div>
              <div>
                <p id="account-name-label" class="text-sm font-semibold text-white">Guest User</p>
                <p id="account-email-label" class="text-xs text-slate-400">Local Browser Storage</p>
              </div>
            </div>

            <div id="account-action-container">
              <a 
                href="/auth" 
                id="btn-auth-link"
                class="px-3.5 py-1.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white text-xs font-semibold transition cursor-pointer flex items-center gap-1.5"
              >
                <LogIn class="w-3.5 h-3.5" />
                <span>Sign In</span>
              </a>
            </div>
          </div>
        </div>

        <!-- Content Preferences Section -->
        <div class="rounded-3xl bg-white/[0.02] border border-white/[0.08] p-5 sm:p-6 space-y-4">
          <h2 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Content Preferences</h2>

          <div>
            <label class="block text-xs font-medium text-slate-300 mb-2">Mature Content (NSFW)</label>
            <div class="grid grid-cols-3 gap-2">
              <button 
                type="button" 
                class="nsfw-opt-btn py-2.5 px-2 rounded-xl border text-center transition cursor-pointer text-xs font-medium"
                data-mode="show"
              >
                Unrestricted
              </button>
              <button 
                type="button" 
                class="nsfw-opt-btn py-2.5 px-2 rounded-xl border text-center transition cursor-pointer text-xs font-medium"
                data-mode="blur"
              >
                Blur Images
              </button>
              <button 
                type="button" 
                class="nsfw-opt-btn py-2.5 px-2 rounded-xl border text-center transition cursor-pointer text-xs font-medium"
                data-mode="hide"
              >
                Safe Mode
              </button>
            </div>
          </div>
        </div>

        <!-- Data & Backup Section -->
        <div class="rounded-3xl bg-white/[0.02] border border-white/[0.08] p-5 sm:p-6 space-y-4">
          <h2 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Data & Backup</h2>

          <div class="flex items-center gap-3">
            <button 
              type="button" 
              id="btn-export-backup"
              class="flex-1 py-2.5 px-3 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/10 text-xs font-medium text-slate-200 hover:text-white transition flex items-center justify-center gap-2 cursor-pointer"
            >
              <Download class="w-3.5 h-3.5" />
              <span>Export Backup</span>
            </button>
            <label 
              class="flex-1 py-2.5 px-3 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/10 text-xs font-medium text-slate-200 hover:text-white transition flex items-center justify-center gap-2 cursor-pointer"
            >
              <Upload class="w-3.5 h-3.5" />
              <span>Restore Backup</span>
              <input type="file" id="backup-file-input" accept=".json" class="hidden" />
            </label>
          </div>

          <div class="pt-2 border-t border-white/5 flex justify-end">
            <button 
              type="button" 
              id="btn-clear-cache"
              class="text-xs text-red-400/80 hover:text-red-300 transition py-1 px-2 rounded-lg hover:bg-red-500/10 cursor-pointer"
            >
              Clear Local Cache
            </button>
          </div>
        </div>

      </div>

    </div>
  </main>

  <BottomNav />

  <!-- Toast Notification Container -->
  <div id="toast-container" class="fixed bottom-20 left-1/2 -translate-x-1/2 z-50 flex flex-col gap-2 pointer-events-none"></div>

  <!-- Custom Confirmation Modal Container -->
  <div id="modal-container" class="fixed inset-0 z-[10000] hidden items-center justify-center p-4 bg-black/75 backdrop-blur-md"></div>
</Layout>

<script>
  interface Persona {
    id: string;
    name: string;
    age?: string;
    pronouns?: string;
    avatar?: string;
    bio?: string;
    directives?: string;
    isDefault?: boolean;
  }

  const STORAGE_KEY_PERSONAS = 'aetheria_saved_personas';
  const STORAGE_KEY_ACTIVE = 'aetheria_user_persona';

  let personas: Persona[] = [];
  let currentPersonaId = '';

  // Helpers: Toast & Modal
  function showToast(message: string, type: 'success' | 'info' | 'warning' = 'info') {
    const container = document.getElementById('toast-container');
    if (!container) return;

    const toast = document.createElement('div');
    const colorClass = type === 'success' 
      ? 'border-emerald-500/40 text-emerald-300 bg-emerald-950/80' 
      : type === 'warning'
      ? 'border-amber-500/40 text-amber-300 bg-amber-950/80'
      : 'border-purple-500/40 text-purple-200 bg-[#0e1224]/90';

    toast.className = `px-4 py-2 rounded-2xl border ${colorClass} backdrop-blur-lg text-xs font-semibold shadow-xl transition-all duration-300 opacity-0 translate-y-2 pointer-events-auto`;
    toast.textContent = message;

    container.appendChild(toast);
    requestAnimationFrame(() => {
      toast.classList.remove('opacity-0', 'translate-y-2');
    });

    setTimeout(() => {
      toast.classList.add('opacity-0', 'translate-y-2');
      setTimeout(() => toast.remove(), 300);
    }, 2500);
  }

  function showConfirm(title: string, message: string): Promise<boolean> {
    return new Promise((resolve) => {
      const container = document.getElementById('modal-container');
      if (!container) {
        resolve(false);
        return;
      }

      container.innerHTML = `
        <div class="w-full max-w-sm rounded-3xl bg-[#0e1224]/95 border border-white/10 p-6 shadow-2xl text-left">
          <h3 class="text-sm font-bold text-white mb-2">${title}</h3>
          <p class="text-xs text-slate-300 leading-relaxed mb-5">${message}</p>
          <div class="flex items-center justify-end gap-2">
            <button id="modal-cancel-btn" type="button" class="px-3.5 py-1.5 rounded-xl bg-white/5 hover:bg-white/10 text-xs text-slate-300 transition cursor-pointer">
              Cancel
            </button>
            <button id="modal-confirm-btn" type="button" class="px-4 py-1.5 rounded-xl bg-red-600 hover:bg-red-500 text-xs font-semibold text-white transition cursor-pointer">
              Confirm
            </button>
          </div>
        </div>
      `;

      container.classList.remove('hidden');
      container.classList.add('flex');

      const cleanup = (val: boolean) => {
        container.classList.add('hidden');
        container.classList.remove('flex');
        container.innerHTML = '';
        resolve(val);
      };

      container.querySelector('#modal-cancel-btn')?.addEventListener('click', () => cleanup(false));
      container.querySelector('#modal-confirm-btn')?.addEventListener('click', () => cleanup(true));
    });
  }

  // Initial Load & Migration
  function loadPersonas() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY_PERSONAS);
      if (raw) {
        personas = JSON.parse(raw);
      }
    } catch {}

    if (!Array.isArray(personas) || personas.length === 0) {
      // Migrate from old single persona if present
      let initialName = '';
      let initialBio = '';
      let initialAvatar = '';
      try {
        const oldRaw = localStorage.getItem(STORAGE_KEY_ACTIVE);
        if (oldRaw) {
          const old = JSON.parse(oldRaw);
          if (old.name && old.name !== 'Traveler') initialName = old.name;
          initialBio = old.bio || old.description || '';
          initialAvatar = old.avatar || '';
        }
      } catch {}

      personas = [{
        id: 'p_' + Date.now(),
        name: initialName,
        age: '',
        pronouns: '',
        avatar: initialAvatar,
        bio: initialBio,
        directives: '',
        isDefault: true
      }];
      savePersonas();
    }

    // Determine current persona
    let activeId = '';
    try {
      const activeRaw = localStorage.getItem(STORAGE_KEY_ACTIVE);
      if (activeRaw) {
        const parsed = JSON.parse(activeRaw);
        activeId = parsed.id;
      }
    } catch {}

    const matched = personas.find(p => p.id === activeId);
    currentPersonaId = matched ? matched.id : personas[0].id;
  }

  function savePersonas() {
    localStorage.setItem(STORAGE_KEY_PERSONAS, JSON.stringify(personas));
    // Keep active persona synced
    const active = personas.find(p => p.id === currentPersonaId) || personas[0];
    if (active) {
      localStorage.setItem(STORAGE_KEY_ACTIVE, JSON.stringify(active));
    }
  }

  // Render Carousel List
  function renderPillList() {
    const list = document.getElementById('personas-pill-list');
    const countLabel = document.getElementById('personas-count-label');
    if (!list) return;

    if (countLabel) {
      countLabel.textContent = `${personas.length} ${personas.length === 1 ? 'persona' : 'personas'}`;
    }

    const itemsHtml = personas.map(p => {
      const isSelected = p.id === currentPersonaId;
      const displayName = p.name.trim() || 'Untitled';
      const ageText = p.age ? `${p.age}` : (p.pronouns ? `${p.pronouns}` : 'No details');
      return `
        <button 
          type="button" 
          class="persona-pill group relative flex items-center gap-3 py-2 px-3.5 rounded-2xl border text-left shrink-0 transition-all duration-200 cursor-pointer ${
            isSelected 
              ? 'bg-purple-600/20 border-purple-500/60 text-white shadow-lg shadow-purple-950/40 ring-1 ring-purple-500/40' 
              : 'bg-white/[0.03] border-white/5 text-slate-400 hover:text-slate-200 hover:bg-white/[0.06] hover:border-white/10'
          }"
          data-id="${p.id}"
        >
          <div class="relative w-8 h-8 rounded-full overflow-hidden bg-purple-950/40 border ${isSelected ? 'border-purple-400' : 'border-white/10'} shrink-0 flex items-center justify-center">
            ${p.avatar ? `<img src="${p.avatar}" class="w-full h-full object-cover" />` : `<span class="text-xs font-bold text-purple-300">${(displayName.charAt(0) || 'U').toUpperCase()}</span>`}
          </div>
          <div class="min-w-0 pr-1">
            <p class="text-xs font-bold truncate max-w-[90px] sm:max-w-[120px] leading-tight">${displayName}</p>
            <p class="text-[10px] text-slate-500 truncate leading-tight mt-0.5">${ageText}</p>
          </div>
          ${p.isDefault ? '<span class="ml-1 text-[9px] px-1.5 py-0.5 rounded-full bg-purple-500/30 text-purple-200 font-semibold border border-purple-400/20 shrink-0">Active</span>' : ''}
        </button>
      `;
    }).join('');

    const addBtnHtml = `
      <button 
        type="button" 
        id="btn-add-persona-carousel"
        class="flex items-center gap-2 py-2 px-3.5 rounded-2xl border border-dashed border-white/15 bg-white/[0.01] hover:bg-white/[0.05] text-slate-400 hover:text-purple-300 text-xs font-semibold shrink-0 transition cursor-pointer"
        title="Create new persona"
      >
        <span class="w-6 h-6 rounded-full bg-white/5 flex items-center justify-center text-slate-300 font-bold text-xs">+</span>
        <span>Add</span>
      </button>
    `;

    list.innerHTML = itemsHtml + addBtnHtml;

    list.querySelectorAll('.persona-pill').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id');
        if (id) {
          currentPersonaId = id;
          renderPillList();
          fillForm();
        }
      });
    });

    document.getElementById('btn-add-persona-carousel')?.addEventListener('click', () => {
      document.getElementById('btn-new-persona')?.click();
    });
  }

  function fillForm() {
    const p = personas.find(x => x.id === currentPersonaId) || personas[0];
    if (!p) return;

    const nameInput = document.getElementById('persona-name') as HTMLInputElement;
    const ageInput = document.getElementById('persona-age') as HTMLInputElement;
    const pronounsInput = document.getElementById('persona-pronouns') as HTMLInputElement;
    const aboutInput = document.getElementById('persona-about') as HTMLTextAreaElement;
    const directivesInput = document.getElementById('persona-directives') as HTMLTextAreaElement;
    const avatarImg = document.getElementById('persona-avatar-img') as HTMLImageElement;
    const avatarPlaceholder = document.getElementById('persona-avatar-placeholder');
    const removeBtn = document.getElementById('btn-remove-avatar');
    const defaultBtn = document.getElementById('btn-set-default');
    const deleteBtn = document.getElementById('btn-delete-persona');

    if (nameInput) nameInput.value = p.name || '';
    if (ageInput) ageInput.value = p.age || '';
    if (pronounsInput) pronounsInput.value = p.pronouns || '';
    if (aboutInput) aboutInput.value = p.bio || '';
    if (directivesInput) directivesInput.value = p.directives || '';

    if (avatarImg && avatarPlaceholder && removeBtn) {
      if (p.avatar) {
        avatarImg.src = p.avatar;
        avatarImg.classList.remove('hidden');
        avatarPlaceholder.classList.add('hidden');
        removeBtn.classList.remove('hidden');
      } else {
        avatarImg.src = '';
        avatarImg.classList.add('hidden');
        avatarPlaceholder.classList.remove('hidden');
        removeBtn.classList.add('hidden');
      }
    }

    const isGlobalEnabled = (localStorage.getItem('aetheria_persona_enabled') !== 'false');
    const statusBadge = document.getElementById('persona-status-badge');
    const statusBadgeText = document.getElementById('persona-status-badge-text');

    if (p.isDefault) {
      defaultBtn?.classList.add('hidden');
      if (statusBadge && statusBadgeText) {
        statusBadge.classList.remove('hidden');
        if (isGlobalEnabled) {
          statusBadge.className = 'px-3 py-1.5 rounded-xl bg-purple-500/15 border border-purple-500/30 text-purple-300 text-xs font-semibold flex items-center gap-1.5 select-none';
          statusBadgeText.textContent = 'Equipped';
        } else {
          statusBadge.className = 'px-3 py-1.5 rounded-xl bg-white/5 border border-white/10 text-slate-500 text-xs font-medium flex items-center gap-1.5 select-none';
          statusBadgeText.textContent = 'Paused (Chats Off)';
        }
      }
    } else {
      statusBadge?.classList.add('hidden');
      if (defaultBtn) {
        defaultBtn.classList.remove('hidden');
      }
    }

    if (deleteBtn) {
      deleteBtn.style.display = (personas.length > 1) ? 'flex' : 'none';
    }
  }

  // Setup Event Handlers
  document.addEventListener('DOMContentLoaded', () => {
    loadPersonas();
    renderPillList();
    fillForm();

    // Master Persona Enable/Disable Toggle
    const masterToggle = document.getElementById('persona-master-toggle') as HTMLInputElement;
    const toggleStatus = document.getElementById('persona-toggle-status');
    const toggleIcon = document.getElementById('persona-toggle-icon');

    function updateToggleUI(enabled: boolean) {
      if (toggleStatus) {
        toggleStatus.textContent = enabled 
          ? 'Active in chats • Characters will use your persona' 
          : 'Disabled • Characters interact using their default scenario';
      }
      if (toggleIcon) {
        if (enabled) {
          toggleIcon.className = 'w-9 h-9 rounded-xl bg-purple-600/20 border border-purple-500/30 flex items-center justify-center text-purple-300 transition';
        } else {
          toggleIcon.className = 'w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-slate-500 transition';
        }
      }
    }

    const isInitiallyEnabled = (localStorage.getItem('aetheria_persona_enabled') !== 'false');
    if (masterToggle) {
      masterToggle.checked = isInitiallyEnabled;
      updateToggleUI(isInitiallyEnabled);

      masterToggle.addEventListener('change', () => {
        const isEnabled = masterToggle.checked;
        localStorage.setItem('aetheria_persona_enabled', isEnabled ? 'true' : 'false');
        updateToggleUI(isEnabled);
        fillForm();
        showToast(isEnabled ? 'Personas enabled in chats' : 'Personas disabled. Using scenario default', isEnabled ? 'success' : 'info');
      });
    }

    // Tab Switcher
    const tabPersonas = document.getElementById('tab-btn-personas');
    const tabSettings = document.getElementById('tab-btn-settings');
    const viewPersonas = document.getElementById('tab-view-personas');
    const viewSettings = document.getElementById('tab-view-settings');

    tabPersonas?.addEventListener('click', () => {
      tabPersonas.className = 'flex-1 py-2.5 px-4 rounded-xl text-sm font-semibold transition cursor-pointer bg-purple-600 text-white shadow-lg shadow-purple-900/40';
      tabSettings!.className = 'flex-1 py-2.5 px-4 rounded-xl text-sm font-semibold transition cursor-pointer text-slate-400 hover:text-white hover:bg-white/[0.04]';
      viewPersonas?.classList.remove('hidden');
      viewSettings?.classList.add('hidden');
    });

    tabSettings?.addEventListener('click', () => {
      tabSettings.className = 'flex-1 py-2.5 px-4 rounded-xl text-sm font-semibold transition cursor-pointer bg-purple-600 text-white shadow-lg shadow-purple-900/40';
      tabPersonas!.className = 'flex-1 py-2.5 px-4 rounded-xl text-sm font-semibold transition cursor-pointer text-slate-400 hover:text-white hover:bg-white/[0.04]';
      viewSettings?.classList.remove('hidden');
      viewPersonas?.classList.add('hidden');
    });

    // Avatar Click Zone
    const avatarZone = document.getElementById('avatar-click-zone');
    const fileInput = document.getElementById('avatar-file-input') as HTMLInputElement;

    avatarZone?.addEventListener('click', () => {
      fileInput?.click();
    });

    fileInput?.addEventListener('change', () => {
      const file = fileInput.files?.[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = (e) => {
        const dataUrl = e.target?.result as string;
        const p = personas.find(x => x.id === currentPersonaId);
        if (p) {
          p.avatar = dataUrl;
          savePersonas();
          fillForm();
          renderPillList();
          showToast('Photo updated', 'success');
        }
      };
      reader.readAsDataURL(file);
    });

    // Remove Photo
    document.getElementById('btn-remove-avatar')?.addEventListener('click', (e) => {
      e.stopPropagation();
      const p = personas.find(x => x.id === currentPersonaId);
      if (p) {
        p.avatar = '';
        savePersonas();
        fillForm();
        renderPillList();
        showToast('Photo removed');
      }
    });

    // New Persona
    document.getElementById('btn-new-persona')?.addEventListener('click', () => {
      const newP: Persona = {
        id: 'p_' + Date.now(),
        name: '',
        age: '',
        pronouns: '',
        avatar: '',
        bio: '',
        directives: '',
        isDefault: false
      };
      personas.push(newP);
      currentPersonaId = newP.id;
      savePersonas();
      renderPillList();
      fillForm();
      showToast('New persona created');
    });

    // Save Persona
    document.getElementById('btn-save-persona')?.addEventListener('click', () => {
      const p = personas.find(x => x.id === currentPersonaId);
      if (!p) return;

      const nameInput = document.getElementById('persona-name') as HTMLInputElement;
      const ageInput = document.getElementById('persona-age') as HTMLInputElement;
      const pronounsInput = document.getElementById('persona-pronouns') as HTMLInputElement;
      const aboutInput = document.getElementById('persona-about') as HTMLTextAreaElement;
      const directivesInput = document.getElementById('persona-directives') as HTMLTextAreaElement;

      p.name = nameInput?.value.trim() || '';
      p.age = ageInput?.value.trim() || '';
      p.pronouns = pronounsInput?.value.trim() || '';
      p.bio = aboutInput?.value.trim() || '';
      p.directives = directivesInput?.value.trim() || '';

      savePersonas();
      renderPillList();
      showToast('Persona saved', 'success');
    });

    // Set Default / Active
    document.getElementById('btn-set-default')?.addEventListener('click', () => {
      personas.forEach(x => { x.isDefault = (x.id === currentPersonaId); });
      savePersonas();
      renderPillList();
      fillForm();
      showToast('Equipped persona for chat', 'success');
    });

    // Delete Persona
    document.getElementById('btn-delete-persona')?.addEventListener('click', async () => {
      if (personas.length <= 1) return;
      const p = personas.find(x => x.id === currentPersonaId);
      const ok = await showConfirm('Delete Persona', `Delete "${p?.name || 'this persona'}"?`);
      if (!ok) return;

      personas = personas.filter(x => x.id !== currentPersonaId);
      if (!personas.some(x => x.isDefault)) {
        personas[0].isDefault = true;
      }
      currentPersonaId = personas[0].id;
      savePersonas();
      renderPillList();
      fillForm();
      showToast('Persona deleted');
    });

    // NSFW Mode Options
    const nsfwButtons = document.querySelectorAll('.nsfw-opt-btn');
    const currentNsfw = localStorage.getItem('aetheria_nsfw_mode') || 'show';

    function updateNsfwButtons(mode: string) {
      nsfwButtons.forEach(btn => {
        const bMode = btn.getAttribute('data-mode');
        if (bMode === mode) {
          btn.className = 'nsfw-opt-btn py-2.5 px-2 rounded-xl border border-purple-500/60 bg-purple-600/20 text-white font-semibold text-center transition cursor-pointer text-xs';
        } else {
          btn.className = 'nsfw-opt-btn py-2.5 px-2 rounded-xl border border-white/5 bg-white/[0.02] text-slate-400 hover:text-white font-medium text-center transition cursor-pointer text-xs';
        }
      });
    }

    updateNsfwButtons(currentNsfw);

    nsfwButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const mode = btn.getAttribute('data-mode') || 'show';
        localStorage.setItem('aetheria_nsfw_mode', mode);
        updateNsfwButtons(mode);
        showToast('Preference saved', 'success');
      });
    });

    // Check Auth State
    fetch('/api/auth/me')
      .then(res => res.json())
      .then((data: any) => {
        if (data.authenticated && data.user) {
          const nameLabel = document.getElementById('account-name-label');
          const emailLabel = document.getElementById('account-email-label');
          const avatarPill = document.getElementById('account-avatar-pill');
          const actionBox = document.getElementById('account-action-container');

          if (nameLabel) nameLabel.textContent = data.user.name || 'User';
          if (emailLabel) emailLabel.textContent = data.user.email || '';
          if (avatarPill) avatarPill.textContent = (data.user.name || 'U').charAt(0).toUpperCase();

          if (actionBox) {
            actionBox.innerHTML = `
              <button id="btn-logout" type="button" class="px-3.5 py-1.5 rounded-xl bg-white/5 hover:bg-white/10 text-xs font-semibold text-slate-300 hover:text-white transition cursor-pointer">
                Sign Out
              </button>
            `;
            document.getElementById('btn-logout')?.addEventListener('click', async () => {
              await fetch('/api/auth/logout', { method: 'POST' });
              window.location.reload();
            });
          }
        }
      })
      .catch(() => {});

    // Export Backup
    document.getElementById('btn-export-backup')?.addEventListener('click', () => {
      const backupData: Record<string, any> = {};
      for (let i = 0; i < localStorage.length; i++) {
        const key = localStorage.key(i);
        if (key && key.startsWith('aetheria_')) {
          backupData[key] = localStorage.getItem(key);
        }
      }
      const blob = new Blob([JSON.stringify(backupData, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `aetheria_backup_${new Date().toISOString().slice(0,10)}.json`;
      a.click();
      URL.revokeObjectURL(url);
      showToast('Backup downloaded', 'success');
    });

    // Restore Backup
    document.getElementById('backup-file-input')?.addEventListener('change', (e: any) => {
      const file = e.target?.files?.[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = (event) => {
        try {
          const data = JSON.parse(event.target?.result as string);
          Object.keys(data).forEach(k => {
            if (k.startsWith('aetheria_')) {
              localStorage.setItem(k, data[k]);
            }
          });
          showToast('Backup restored successfully!', 'success');
          setTimeout(() => window.location.reload(), 800);
        } catch {
          showToast('Invalid backup file', 'warning');
        }
      };
      reader.readAsText(file);
    });

    // Clear Cache
    document.getElementById('btn-clear-cache')?.addEventListener('click', async () => {
      const ok = await showConfirm('Clear Local Cache', 'Reset local data? Characters and personas saved only locally will be cleared.');
      if (!ok) return;

      Object.keys(localStorage).forEach(k => {
        if (k.startsWith('aetheria_')) localStorage.removeItem(k);
      });
      window.location.reload();
    });

  });
</script>
