    function showView(targetId: string) {
      const views = ['view-hub', 'view-personas', 'view-appearance', 'view-ai-engine', 'view-voice', 'view-privacy'];
      views.forEach(id => {
        const el = document.getElementById(id);
        if (!el) return;
        if (id === targetId) {
          el.classList.remove('hidden');
          window.scrollTo({ top: 0, behavior: 'instant' });
          if (id === 'view-personas') {
            render3DCarousel();
          }
        } else {
          el.classList.add('hidden');
