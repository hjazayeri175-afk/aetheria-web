---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import BottomNav from '../components/BottomNav.astro';
import { 
  User, 
  Sparkles, 
  Save, 
  Trash2, 
  Plus, 
  Check, 
  Eye, 
  EyeOff,
  Camera,
  Settings,
  Shield,
  Download,
  Upload,
  LogOut,
  LogIn,
  ChevronDown,
  Palette,
  RotateCcw,
  Copy
} from '@lucide/astro';
---

<Layout title="Profile & Personas | Aetheria">
  <Header />

  <main class="min-h-screen bg-[#060813] text-slate-100 pb-28 pt-4 sm:pt-8 px-4">
    <div class="max-w-xl mx-auto">
      
      <!-- Top Navigation Tabs -->
      <div class="flex items-center gap-1 p-1 rounded-2xl bg-white/[0.04] border border-white/[0.08] mb-8">
        <button 
          id="tab-btn-personas" 
          type="button" 
          class="flex-1 py-2.5 px-4 rounded-xl text-sm font-semibold transition cursor-pointer bg-purple-600 text-white shadow-lg shadow-purple-900/40"
        >
          Personas
        </button>
        <button 
          id="tab-btn-settings" 
          type="button" 
          class="flex-1 py-2.5 px-4 rounded-xl text-sm font-semibold transition cursor-pointer text-slate-400 hover:text-white hover:bg-white/[0.04]"
        >
          Settings
        </button>
      </div>

      <!-- ========================================== -->
      <!-- TAB 1: PERSONAS (Clean, Simple, User-first) -->
      <!-- ========================================== -->
      <div id="tab-view-personas" class="space-y-6">
        
        <!-- Header & Action -->
        <div class="flex items-center justify-between">
          <div>
            <h1 class="text-xl font-bold text-white tracking-tight">Personas</h1>
            <p class="text-xs text-slate-400 mt-0.5">Customize how characters perceive you in chat</p>
          </div>
          <button 
            type="button" 
            id="btn-new-persona"
            class="px-3.5 py-1.5 rounded-xl bg-purple-600/20 hover:bg-purple-600/30 border border-purple-500/40 text-purple-300 hover:text-white text-xs font-semibold flex items-center gap-1.5 transition active:scale-95 cursor-pointer shadow-sm"
          >
            <Plus class="w-3.5 h-3.5" />
            <span>New Persona</span>
          </button>
        </div>

        <!-- Master Enable / Disable Toggle -->
        <div class="flex items-center justify-between p-4 rounded-2xl bg-white/[0.02] border border-white/[0.08] transition">
          <div class="flex items-center gap-3">
            <div id="persona-toggle-icon" class="w-9 h-9 rounded-xl bg-purple-600/20 border border-purple-500/30 flex items-center justify-center text-purple-300 transition">
              <User class="w-4 h-4" />
            </div>
            <div>
              <p class="text-xs font-semibold text-white">Enable Persona in Chats</p>
              <p id="persona-toggle-status" class="text-[11px] text-slate-400 transition">Active in chats • Characters will use your persona</p>
            </div>
          </div>
          <label class="relative inline-flex items-center cursor-pointer">
            <input type="checkbox" id="persona-master-toggle" class="sr-only peer" checked>
            <div class="w-11 h-6 bg-white/10 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-purple-600"></div>
          </label>
        </div>

        <!-- Modern Persona Carousel Bar -->
        <div class="space-y-2">
          <div class="flex items-center justify-between text-xs text-slate-400 px-1">
            <span>Your Personas</span>
            <span id="personas-count-label" class="text-[11px] text-purple-400 font-medium">1 persona</span>
          </div>
          <div id="personas-pill-list" class="flex items-center gap-2.5 overflow-x-auto pb-2 pt-0.5 no-scrollbar scroll-smooth">
            <!-- Populated by JS -->
          </div>
        </div>

        <!-- Persona Editor Card -->
        <!-- Appearance & Global Theming Engine (Step 3: Cohesive Presets, Gradient Bubbles, Telegram Extras) -->
        <div class="rounded-3xl bg-white/[0.02] border border-white/[0.08] p-5 sm:p-7 space-y-6">
          <div class="flex items-center justify-between pb-4 border-b border-white/[0.08]">
            <div>
              <h2 class="text-sm font-bold text-white uppercase tracking-wider flex items-center gap-2">
                <Palette class="w-4 h-4 text-purple-400" />
                Chat Appearance & Global Theming
              </h2>
              <p class="text-xs text-slate-400 mt-0.5">Telegram-style cohesive themes, wallpapers, gradient bubbles & density settings</p>
            </div>
            <button 
              id="profile-theme-reset-btn" 
              type="button" 
              class="flex items-center gap-1 px-3 py-1.5 rounded-xl text-xs font-medium text-slate-400 hover:text-rose-400 hover:bg-rose-500/10 border border-white/10 hover:border-rose-500/20 transition-all"
            >
              <RotateCcw class="w-3.5 h-3.5" />
              <span>Reset</span>
            </button>
          </div>

          <!-- PINNED LIVE PREVIEW -->
          <div class="space-y-2">
            <span class="text-xs font-semibold text-slate-300 uppercase tracking-wider flex items-center gap-1.5">
              <Sparkles class="w-3.5 h-3.5 text-purple-400" />
              Live Interactive Preview
            </span>
            <div 
              id="profile-preview-viewport" 
              class="relative h-44 rounded-2xl border border-white/10 overflow-hidden flex flex-col justify-between p-4 shadow-inner transition-all duration-300"
            >
              <div id="profile-preview-image" class="absolute inset-0 z-0 bg-cover bg-center transition-all duration-300"></div>
              <div id="profile-preview-dimmer" class="absolute inset-0 z-0 bg-black pointer-events-none transition-opacity duration-200"></div>
              <div id="profile-preview-pattern" class="absolute inset-0 z-0 pointer-events-none transition-opacity duration-200"></div>

              <!-- Character Mock Bubble -->
              <div class="relative z-10 flex items-start gap-2.5 max-w-[85%]">
                <div class="w-7 h-7 rounded-full bg-purple-600/30 border border-purple-400/40 flex items-center justify-center text-xs font-bold text-purple-200 shrink-0 shadow-md">
                  A
                </div>
                <div 
                  id="profile-preview-char-bubble" 
                  class="px-3.5 py-2 rounded-2xl bg-[#101426] border border-white/10 text-slate-100 shadow-md backdrop-blur-sm transition-all duration-200"
                >
                  <p class="text-[11px] font-semibold text-purple-300 mb-0.5">Aetheria Companion</p>
                  <p class="text-xs leading-relaxed">Customize full themes, gradient bubbles and chat density across all devices ✨</p>
                  <div class="text-[10px] text-slate-400/60 mt-1 text-right">10:42 PM</div>
                </div>
              </div>

              <!-- User Mock Bubble -->
              <div class="relative z-10 flex items-end justify-end max-w-[85%] self-end">
                <div 
                  id="profile-preview-user-bubble" 
                  class="px-3.5 py-2 rounded-2xl bg-gradient-to-r from-purple-600 to-indigo-600 text-white shadow-lg shadow-purple-950/30 transition-all duration-200"
                >
                  <p class="text-xs leading-relaxed">Everything changes in real-time, just like Telegram! 🚀</p>
                  <div class="text-[10px] text-white/70 mt-1 text-right flex items-center justify-end gap-1 font-mono">
                    <span>10:43 PM</span>
                    <svg class="w-3 h-3 inline text-white/90" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 13l2 2L19 7" />
                    </svg>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- SECTION 1: FULL COHESIVE THEME PRESETS -->
          <div class="space-y-3">
            <h3 class="text-xs font-semibold text-slate-300 uppercase tracking-wider">Full Theme Presets (One-Tap Cohesive Styles)</h3>
            <div id="profile-theme-presets-grid" class="grid grid-cols-2 sm:grid-cols-4 gap-2.5">
              <!-- Populated via JS -->
            </div>
          </div>

          <!-- SECTION 2: BUBBLES & TYPOGRAPHY -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Font Size -->
            <div class="p-3.5 rounded-2xl bg-white/[0.02] border border-white/[0.06] space-y-2.5">
              <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-slate-200">Message Text Size</span>
                <span id="profile-font-size-badge" class="px-2 py-0.5 rounded bg-purple-500/20 border border-purple-500/30 text-xs font-mono text-purple-300 font-bold">16px</span>
              </div>
              <input 
                type="range" 
                id="profile-font-size-slider" 
                min="13" 
                max="22" 
                step="1" 
                value="16" 
                class="w-full h-1.5 bg-white/10 rounded-lg appearance-none cursor-pointer accent-purple-500"
              />
            </div>

            <!-- Bubble Radius -->
            <div class="p-3.5 rounded-2xl bg-white/[0.02] border border-white/[0.06] space-y-2.5">
              <div class="flex items-center justify-between">
                <span class="text-xs font-medium text-slate-200">Bubble Corner Roundness</span>
                <span id="profile-radius-badge" class="px-2 py-0.5 rounded bg-purple-500/20 border border-purple-500/30 text-xs font-mono text-purple-300 font-bold">16px</span>
              </div>
              <input 
                type="range" 
                id="profile-radius-slider" 
                min="0" 
                max="24" 
                step="2" 
                value="16" 
                class="w-full h-1.5 bg-white/10 rounded-lg appearance-none cursor-pointer accent-purple-500"
              />
            </div>
          </div>

          <!-- SECTION 3: OUTGOING BUBBLE GRADIENTS & CUSTOM COLORS -->
          <div class="p-4 rounded-2xl bg-white/[0.02] border border-white/[0.06] space-y-4">
            <span class="text-xs font-semibold text-slate-300 uppercase tracking-wider block">Outgoing Message Gradient</span>
            
            <div id="profile-bubble-gradients-grid" class="grid grid-cols-2 sm:grid-cols-4 gap-2">
              <!-- Rendered via JS -->
            </div>

            <!-- Custom 2-Color Gradient Builder -->
            <div class="pt-3 border-t border-white/[0.06] flex flex-col sm:flex-row items-center gap-3">
              <span class="text-xs text-slate-400 shrink-0">Custom 2-Color Gradient:</span>
              <div class="flex items-center gap-2">
                <input type="color" id="profile-grad-color-a" value="#9333ea" class="w-7 h-7 rounded-lg bg-transparent cursor-pointer border-0" />
                <span id="profile-grad-hex-a" class="text-[11px] font-mono text-slate-300">#9333EA</span>
              </div>
              <span class="text-slate-500 text-xs font-bold">→</span>
              <div class="flex items-center gap-2">
                <input type="color" id="profile-grad-color-b" value="#6366f1" class="w-7 h-7 rounded-lg bg-transparent cursor-pointer border-0" />
                <span id="profile-grad-hex-b" class="text-[11px] font-mono text-slate-300">#6366F1</span>
              </div>
            </div>
          </div>

          <!-- SECTION 4: VISUAL EFFECTS & PATTERNS -->
          <div class="p-4 rounded-2xl bg-white/[0.02] border border-white/[0.06] space-y-4">
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold text-slate-300 uppercase tracking-wider">Wallpaper Effects & Doodles</span>
              <button 
                id="profile-blur-toggle" 
                type="button" 
                class="px-3 py-1.5 rounded-xl text-xs font-medium border border-white/10 bg-white/5 text-slate-300 hover:text-white transition-all flex items-center gap-1.5"
              >
                <span id="profile-blur-dot" class="w-2 h-2 rounded-full bg-slate-500"></span>
                <span>Blur Wallpaper</span>
              </button>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- Dimmer Slider -->
              <div>
                <div class="flex items-center justify-between text-xs mb-1.5">
                  <span class="text-slate-400">Darkness Dimmer</span>
                  <span id="profile-dimmer-badge" class="font-mono text-purple-400 font-semibold">20%</span>
                </div>
                <input 
                  type="range" 
                  id="profile-dimmer-slider" 
                  min="0" 
                  max="70" 
                  step="5" 
                  value="20"
                  class="w-full h-1.5 bg-white/10 rounded-lg appearance-none cursor-pointer accent-purple-500"
                />
              </div>

              <!-- Pattern Opacity Slider -->
              <div>
                <div class="flex items-center justify-between text-xs mb-1.5">
                  <span class="text-slate-400">Pattern Opacity</span>
                  <span id="profile-pattern-opacity-badge" class="font-mono text-purple-400 font-semibold">18%</span>
                </div>
                <input 
                  type="range" 
                  id="profile-pattern-opacity-slider" 
                  min="5" 
                  max="50" 
                  step="1" 
                  value="18"
                  class="w-full h-1.5 bg-white/10 rounded-lg appearance-none cursor-pointer accent-purple-500"
                />
              </div>
            </div>

            <!-- Doodle Pills -->
            <div id="profile-doodle-pills" class="grid grid-cols-3 sm:grid-cols-6 gap-1.5">
              <button data-pat-id="none" class="profile-doodle-btn px-2 py-1.5 rounded-xl text-xs font-medium border border-white/10 bg-white/5 text-slate-300 text-center">None</button>
              <button data-pat-id="telegram-doodles" class="profile-doodle-btn px-2 py-1.5 rounded-xl text-xs font-medium border border-purple-500/40 bg-purple-500/20 text-purple-300 text-center">Doodles</button>
              <button data-pat-id="cyber-circuit" class="profile-doodle-btn px-2 py-1.5 rounded-xl text-xs font-medium border border-white/10 bg-white/5 text-slate-300 text-center">Circuit</button>
              <button data-pat-id="constellation-stars" class="profile-doodle-btn px-2 py-1.5 rounded-xl text-xs font-medium border border-white/10 bg-white/5 text-slate-300 text-center">Stars</button>
              <button data-pat-id="hex-mesh" class="profile-doodle-btn px-2 py-1.5 rounded-xl text-xs font-medium border border-white/10 bg-white/5 text-slate-300 text-center">Hex Grid</button>
              <button data-pat-id="matrix-grid" class="profile-doodle-btn px-2 py-1.5 rounded-xl text-xs font-medium border border-white/10 bg-white/5 text-slate-300 text-center">Matrix</button>
            </div>
          </div>

          <!-- SECTION 5: WALLPAPER GALLERY & UPLOAD -->
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold text-slate-300 uppercase tracking-wider">Wallpaper Gallery</span>
              <div class="flex items-center gap-1" id="profile-wp-cats">
                <button data-cat="all" class="profile-cat-btn px-2.5 py-1 rounded-lg text-[11px] font-medium bg-purple-500/20 text-purple-300 border border-purple-500/30">All</button>
                <button data-cat="gradients" class="profile-cat-btn px-2.5 py-1 rounded-lg text-[11px] font-medium text-slate-400 hover:text-slate-200 border border-transparent">Gradients</button>
                <button data-cat="art" class="profile-cat-btn px-2.5 py-1 rounded-lg text-[11px] font-medium text-slate-400 hover:text-slate-200 border border-transparent">Art & Photos</button>
              </div>
            </div>

            <div class="grid grid-cols-2 sm:grid-cols-4 gap-2.5" id="profile-wallpaper-grid">
              <!-- Rendered via JS -->
            </div>
          </div>

          <!-- SECTION 6: CHAT DENSITY & EXPORT/IMPORT -->
          <div class="p-4 rounded-2xl bg-white/[0.02] border border-white/[0.06] space-y-4">
            <span class="text-xs font-semibold text-slate-300 uppercase tracking-wider block">Chat Density & Theme Backup</span>
            
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- Density -->
              <div class="flex items-center gap-4">
                <label class="flex items-center gap-2 text-xs text-slate-300 cursor-pointer">
                  <input type="radio" name="profile-density" value="comfortable" id="profile-density-comfortable" checked class="accent-purple-500" />
                  <span>Comfortable Spacing</span>
                </label>
                <label class="flex items-center gap-2 text-xs text-slate-300 cursor-pointer">
                  <input type="radio" name="profile-density" value="compact" id="profile-density-compact" class="accent-purple-500" />
                  <span>Compact (Desktop)</span>
                </label>
              </div>

              <!-- Export / Import Buttons -->
              <div class="flex items-center gap-2 justify-end">
                <button 
                  id="profile-export-theme-btn" 
                  type="button" 
                  class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-xs font-medium text-slate-200 transition-colors"
                >
                  <Copy class="w-3.5 h-3.5 text-purple-400" />
                  <span>Copy Theme JSON</span>
                </button>
                <button 
                  id="profile-import-theme-btn" 
                  type="button" 
                  class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/5 hover:bg-white/10 border border-white/10 text-xs font-medium text-slate-200 transition-colors"
                >
                  <Download class="w-3.5 h-3.5 text-indigo-400" />
                  <span>Import</span>
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Data & Backup Section -->
        <div class="rounded-3xl bg-white/[0.02] border border-white/[0.08] p-5 sm:p-6 space-y-4">
          <h2 class="text-xs font-bold text-slate-400 uppercase tracking-wider">Data & Backup</h2>

          <div class="flex items-center gap-3">
            <button 
              type="button" 
              id="btn-export-backup"
              class="flex-1 py-2.5 px-3 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/10 text-xs font-medium text-slate-200 hover:text-white transition flex items-center justify-center gap-2 cursor-pointer"
            >
              <Download class="w-3.5 h-3.5" />
              <span>Export Backup</span>
            </button>
            <label 
              class="flex-1 py-2.5 px-3 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/10 text-xs font-medium text-slate-200 hover:text-white transition flex items-center justify-center gap-2 cursor-pointer"
            >
              <Upload class="w-3.5 h-3.5" />
              <span>Restore Backup</span>
              <input type="file" id="backup-file-input" accept=".json" class="hidden" />
            </label>
          </div>

          <div class="pt-2 border-t border-white/5 flex justify-end">
            <button 
              type="button" 
              id="btn-clear-cache"
              class="text-xs text-red-400/80 hover:text-red-300 transition py-1 px-2 rounded-lg hover:bg-red-500/10 cursor-pointer"
            >
              Clear Local Cache
            </button>
          </div>
        </div>

      </div>

    </div>
  </main>

  <BottomNav />

  <!-- Toast Notification Container -->
  <div id="toast-container" class="fixed bottom-20 left-1/2 -translate-x-1/2 z-50 flex flex-col gap-2 pointer-events-none"></div>

  <!-- Custom Confirmation Modal Container -->
  <div id="modal-container" class="fixed inset-0 z-[10000] hidden items-center justify-center p-4 bg-black/75 backdrop-blur-md"></div>
</Layout>

<script>
  interface Persona {
    id: string;
    name: string;
    age?: string;
    pronouns?: string;
    avatar?: string;
    bio?: string;
    directives?: string;
    isDefault?: boolean;
  }

  const STORAGE_KEY_PERSONAS = 'aetheria_saved_personas';
  const STORAGE_KEY_ACTIVE = 'aetheria_user_persona';

  let personas: Persona[] = [];
  let currentPersonaId = '';

  // Helpers: Toast & Modal
  function showToast(message: string, type: 'success' | 'info' | 'warning' = 'info') {
    const container = document.getElementById('toast-container');
    if (!container) return;

    const toast = document.createElement('div');
    const colorClass = type === 'success' 
      ? 'border-emerald-500/40 text-emerald-300 bg-emerald-950/80' 
      : type === 'warning'
      ? 'border-amber-500/40 text-amber-300 bg-amber-950/80'
      : 'border-purple-500/40 text-purple-200 bg-[#0e1224]/90';

    toast.className = `px-4 py-2 rounded-2xl border ${colorClass} backdrop-blur-lg text-xs font-semibold shadow-xl transition-all duration-300 opacity-0 translate-y-2 pointer-events-auto`;
    toast.textContent = message;

    container.appendChild(toast);
    requestAnimationFrame(() => {
      toast.classList.remove('opacity-0', 'translate-y-2');
    });

    setTimeout(() => {
      toast.classList.add('opacity-0', 'translate-y-2');
      setTimeout(() => toast.remove(), 300);
    }, 2500);
  }

  function showConfirm(title: string, message: string): Promise<boolean> {
    return new Promise((resolve) => {
      const container = document.getElementById('modal-container');
      if (!container) {
        resolve(false);
        return;
      }

      container.innerHTML = `
        <div class="w-full max-w-sm rounded-3xl bg-[#0e1224]/95 border border-white/10 p-6 shadow-2xl text-left">
          <h3 class="text-sm font-bold text-white mb-2">${title}</h3>
          <p class="text-xs text-slate-300 leading-relaxed mb-5">${message}</p>
          <div class="flex items-center justify-end gap-2">
            <button id="modal-cancel-btn" type="button" class="px-3.5 py-1.5 rounded-xl bg-white/5 hover:bg-white/10 text-xs text-slate-300 transition cursor-pointer">
              Cancel
            </button>
            <button id="modal-confirm-btn" type="button" class="px-4 py-1.5 rounded-xl bg-red-600 hover:bg-red-500 text-xs font-semibold text-white transition cursor-pointer">
              Confirm
            </button>
          </div>
        </div>
      `;

      container.classList.remove('hidden');
      container.classList.add('flex');

      const cleanup = (val: boolean) => {
        container.classList.add('hidden');
        container.classList.remove('flex');
        container.innerHTML = '';
        resolve(val);
      };

      container.querySelector('#modal-cancel-btn')?.addEventListener('click', () => cleanup(false));
      container.querySelector('#modal-confirm-btn')?.addEventListener('click', () => cleanup(true));
    });
  }

  // Initial Load & Migration
  function loadPersonas() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY_PERSONAS);
      if (raw) {
        personas = JSON.parse(raw);
      }
    } catch {}

    if (!Array.isArray(personas) || personas.length === 0) {
      // Migrate from old single persona if present
      let initialName = '';
      let initialBio = '';
      let initialAvatar = '';
      try {
        const oldRaw = localStorage.getItem(STORAGE_KEY_ACTIVE);
        if (oldRaw) {
          const old = JSON.parse(oldRaw);
          if (old.name && old.name !== 'Traveler') initialName = old.name;
          initialBio = old.bio || old.description || '';
          initialAvatar = old.avatar || '';
        }
      } catch {}

      personas = [{
        id: 'p_' + Date.now(),
        name: initialName,
        age: '',
        pronouns: '',
        avatar: initialAvatar,
        bio: initialBio,
        directives: '',
        isDefault: true
      }];
      savePersonas();
    }

    // Ensure at least one default persona exists
    if (!personas.some(p => p.isDefault)) {
      personas[0].isDefault = true;
    }

    // Determine current persona from default
    const activePersona = personas.find(p => p.isDefault) || personas[0];
    currentPersonaId = activePersona.id;
  }

  function savePersonas() {
    localStorage.setItem(STORAGE_KEY_PERSONAS, JSON.stringify(personas));
    // Keep active persona synced
    const active = personas.find(p => p.isDefault) || personas.find(p => p.id === currentPersonaId) || personas[0];
    if (active) {
      localStorage.setItem(STORAGE_KEY_ACTIVE, JSON.stringify(active));
    }
  }

  // Render Carousel List
  function renderPillList() {
    const list = document.getElementById('personas-pill-list');
    const countLabel = document.getElementById('personas-count-label');
    if (!list) return;

    if (countLabel) {
      countLabel.textContent = `${personas.length} ${personas.length === 1 ? 'persona' : 'personas'}`;
    }

    const itemsHtml = personas.map(p => {
      const isSelected = p.id === currentPersonaId;
      const displayName = p.name.trim() || 'Untitled';
      const ageText = p.age ? `${p.age}` : (p.pronouns ? `${p.pronouns}` : 'No details');
      return `
        <button 
          type="button" 
          class="persona-pill group relative flex items-center gap-3 py-2 px-3.5 rounded-2xl border text-left shrink-0 transition-all duration-200 cursor-pointer ${
            isSelected 
              ? 'bg-purple-600/20 border-purple-500/60 text-white shadow-lg shadow-purple-950/40 ring-1 ring-purple-500/40' 
              : 'bg-white/[0.03] border-white/5 text-slate-400 hover:text-slate-200 hover:bg-white/[0.06] hover:border-white/10'
          }"
          data-id="${p.id}"
        >
          <div class="relative w-8 h-8 rounded-full overflow-hidden bg-purple-950/40 border ${isSelected ? 'border-purple-400' : 'border-white/10'} shrink-0 flex items-center justify-center">
            ${p.avatar ? `<img src="${p.avatar}" class="w-full h-full object-cover" />` : `<span class="text-xs font-bold text-purple-300">${(displayName.charAt(0) || 'U').toUpperCase()}</span>`}
          </div>
          <div class="min-w-0 pr-1">
            <p class="persona-pill-name text-xs font-bold truncate max-w-[90px] sm:max-w-[120px] leading-tight">${displayName}</p>
            <p class="text-[10px] text-slate-500 truncate leading-tight mt-0.5">${ageText}</p>
          </div>
          ${p.isDefault ? '<span class="ml-1 text-[9px] px-1.5 py-0.5 rounded-full bg-purple-500/30 text-purple-200 font-semibold border border-purple-400/20 shrink-0">Active</span>' : ''}
        </button>
      `;
    }).join('');

    const addBtnHtml = `
      <button 
        type="button" 
        id="btn-add-persona-carousel"
        class="flex items-center gap-2 py-2 px-3.5 rounded-2xl border border-dashed border-white/15 bg-white/[0.01] hover:bg-white/[0.05] text-slate-400 hover:text-purple-300 text-xs font-semibold shrink-0 transition cursor-pointer"
        title="Create new persona"
      >
        <span class="w-6 h-6 rounded-full bg-white/5 flex items-center justify-center text-slate-300 font-bold text-xs">+</span>
        <span>Add</span>
      </button>
    `;

    list.innerHTML = itemsHtml + addBtnHtml;

    list.querySelectorAll('.persona-pill').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id');
        if (id) {
          currentPersonaId = id;
          // Instantly activate the selected persona!
          personas.forEach(x => {
            x.isDefault = (x.id === currentPersonaId);
          });
          savePersonas();
          renderPillList();
          fillForm();
          const p = personas.find(x => x.id === currentPersonaId);
          showToast(`Active persona: ${p?.name || 'Persona'}`, 'success');
        }
      });
    });

    document.getElementById('btn-add-persona-carousel')?.addEventListener('click', () => {
      document.getElementById('btn-new-persona')?.click();
    });
  }

  function fillForm() {
    const p = personas.find(x => x.id === currentPersonaId) || personas[0];
    if (!p) return;

    const nameInput = document.getElementById('persona-name') as HTMLInputElement;
    const ageInput = document.getElementById('persona-age') as HTMLInputElement;
    const pronounsInput = document.getElementById('persona-pronouns') as HTMLInputElement;
    const aboutInput = document.getElementById('persona-about') as HTMLTextAreaElement;
    const directivesInput = document.getElementById('persona-directives') as HTMLTextAreaElement;
    const avatarImg = document.getElementById('persona-avatar-img') as HTMLImageElement;
    const avatarPlaceholder = document.getElementById('persona-avatar-placeholder');
    const removeBtn = document.getElementById('btn-remove-avatar');
    const defaultBtn = document.getElementById('btn-set-default');
    const deleteBtn = document.getElementById('btn-delete-persona');

    if (nameInput) nameInput.value = p.name || '';
    if (ageInput) ageInput.value = p.age || '';
    if (pronounsInput) pronounsInput.value = p.pronouns || '';
    if (aboutInput) aboutInput.value = p.bio || '';
    if (directivesInput) directivesInput.value = p.directives || '';

    if (avatarImg && avatarPlaceholder && removeBtn) {
      if (p.avatar) {
        avatarImg.src = p.avatar;
        avatarImg.classList.remove('hidden');
        avatarPlaceholder.classList.add('hidden');
        removeBtn.classList.remove('hidden');
      } else {
        avatarImg.src = '';
        avatarImg.classList.add('hidden');
        avatarPlaceholder.classList.remove('hidden');
        removeBtn.classList.add('hidden');
      }
    }

    const isGlobalEnabled = (localStorage.getItem('aetheria_persona_enabled') !== 'false');
    const statusBadge = document.getElementById('persona-status-badge');
    const statusBadgeText = document.getElementById('persona-status-badge-text');

    if (statusBadge && statusBadgeText) {
      if (isGlobalEnabled) {
        statusBadge.className = 'px-3 py-1.5 rounded-xl bg-purple-500/15 border border-purple-500/30 text-purple-300 text-xs font-semibold flex items-center gap-1.5 select-none';
        statusBadgeText.textContent = 'Active for Chat';
      } else {
        statusBadge.className = 'px-3 py-1.5 rounded-xl bg-white/5 border border-white/10 text-slate-500 text-xs font-medium flex items-center gap-1.5 select-none';
        statusBadgeText.textContent = 'Paused (Chats Off)';
      }
    }

    if (deleteBtn) {
      deleteBtn.style.display = (personas.length > 1) ? 'flex' : 'none';
    }
  }

  // Setup Event Handlers
  document.addEventListener('DOMContentLoaded', () => {
    loadPersonas();
    renderPillList();
    fillForm();

    // Master Persona Enable/Disable Toggle
    const masterToggle = document.getElementById('persona-master-toggle') as HTMLInputElement;
    const toggleStatus = document.getElementById('persona-toggle-status');
    const toggleIcon = document.getElementById('persona-toggle-icon');

    function updateToggleUI(enabled: boolean) {
      if (toggleStatus) {
        toggleStatus.textContent = enabled 
          ? 'Active in chats • Characters will use your persona' 
          : 'Disabled • Characters interact using their default scenario';
      }
      if (toggleIcon) {
        if (enabled) {
          toggleIcon.className = 'w-9 h-9 rounded-xl bg-purple-600/20 border border-purple-500/30 flex items-center justify-center text-purple-300 transition';
        } else {
          toggleIcon.className = 'w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-slate-500 transition';
        }
      }
    }

    const isInitiallyEnabled = (localStorage.getItem('aetheria_persona_enabled') !== 'false');
    if (masterToggle) {
      masterToggle.checked = isInitiallyEnabled;
      updateToggleUI(isInitiallyEnabled);

      masterToggle.addEventListener('change', () => {
        const isEnabled = masterToggle.checked;
        localStorage.setItem('aetheria_persona_enabled', isEnabled ? 'true' : 'false');
        updateToggleUI(isEnabled);
        fillForm();
        showToast(isEnabled ? 'Personas enabled in chats' : 'Personas disabled. Using scenario default', isEnabled ? 'success' : 'info');
      });
    }

    // Tab Switcher
    const tabPersonas = document.getElementById('tab-btn-personas');
    const tabSettings = document.getElementById('tab-btn-settings');
    const viewPersonas = document.getElementById('tab-view-personas');
    const viewSettings = document.getElementById('tab-view-settings');

    tabPersonas?.addEventListener('click', () => {
      tabPersonas.className = 'flex-1 py-2.5 px-4 rounded-xl text-sm font-semibold transition cursor-pointer bg-purple-600 text-white shadow-lg shadow-purple-900/40';
      tabSettings!.className = 'flex-1 py-2.5 px-4 rounded-xl text-sm font-semibold transition cursor-pointer text-slate-400 hover:text-white hover:bg-white/[0.04]';
      viewPersonas?.classList.remove('hidden');
      viewSettings?.classList.add('hidden');
    });

    tabSettings?.addEventListener('click', () => {
      tabSettings.className = 'flex-1 py-2.5 px-4 rounded-xl text-sm font-semibold transition cursor-pointer bg-purple-600 text-white shadow-lg shadow-purple-900/40';
      tabPersonas!.className = 'flex-1 py-2.5 px-4 rounded-xl text-sm font-semibold transition cursor-pointer text-slate-400 hover:text-white hover:bg-white/[0.04]';
      viewSettings?.classList.remove('hidden');
      viewPersonas?.classList.add('hidden');
    });

    // Avatar Click Zone
    const avatarZone = document.getElementById('avatar-click-zone');
    const fileInput = document.getElementById('avatar-file-input') as HTMLInputElement;

    avatarZone?.addEventListener('click', () => {
      fileInput?.click();
    });

    fileInput?.addEventListener('change', () => {
      const file = fileInput.files?.[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = (e) => {
        const dataUrl = e.target?.result as string;
        const p = personas.find(x => x.id === currentPersonaId);
        if (p) {
          p.avatar = dataUrl;
          savePersonas();
          fillForm();
          renderPillList();
          showToast('Photo updated', 'success');
        }
      };
      reader.readAsDataURL(file);
    });

    // Remove Photo
    document.getElementById('btn-remove-avatar')?.addEventListener('click', (e) => {
      e.stopPropagation();
      const p = personas.find(x => x.id === currentPersonaId);
      if (p) {
        p.avatar = '';
        savePersonas();
        fillForm();
        renderPillList();
        showToast('Photo removed');
      }
    });

    // Live update card title as user types
    const nameInput = document.getElementById('persona-name') as HTMLInputElement;
    nameInput?.addEventListener('input', () => {
      const p = personas.find(x => x.id === currentPersonaId);
      if (p) {
        p.name = nameInput.value;
        const pillText = document.querySelector(`.persona-pill[data-id="${p.id}"] .persona-pill-name`);
        if (pillText) {
          pillText.textContent = nameInput.value.trim() || 'Untitled';
        }
      }
    });

    // New Persona
    document.getElementById('btn-new-persona')?.addEventListener('click', () => {
      // Deactivate others
      personas.forEach(x => { x.isDefault = false; });
      const newP: Persona = {
        id: 'p_' + Date.now(),
        name: '',
        age: '',
        pronouns: '',
        avatar: '',
        bio: '',
        directives: '',
        isDefault: true // Immediately active!
      };
      personas.push(newP);
      currentPersonaId = newP.id;
      savePersonas();
      renderPillList();
      fillForm();
      const nInput = document.getElementById('persona-name') as HTMLInputElement;
      nInput?.focus();
      showToast('New persona created & active', 'success');
    });

    // Save Persona
    document.getElementById('btn-save-persona')?.addEventListener('click', () => {
      const p = personas.find(x => x.id === currentPersonaId);
      if (!p) return;

      const nameInp = document.getElementById('persona-name') as HTMLInputElement;
      const ageInput = document.getElementById('persona-age') as HTMLInputElement;
      const pronounsInput = document.getElementById('persona-pronouns') as HTMLInputElement;
      const aboutInput = document.getElementById('persona-about') as HTMLTextAreaElement;
      const directivesInput = document.getElementById('persona-directives') as HTMLTextAreaElement;

      p.name = nameInp?.value.trim() || '';
      p.age = ageInput?.value.trim() || '';
      p.pronouns = pronounsInput?.value.trim() || '';
      p.bio = aboutInput?.value.trim() || '';
      p.directives = directivesInput?.value.trim() || '';

      // Ensure active
      personas.forEach(x => { x.isDefault = (x.id === currentPersonaId); });

      savePersonas();
      renderPillList();
      fillForm();
      showToast('Persona saved', 'success');
    });

    // Delete Persona
    document.getElementById('btn-delete-persona')?.addEventListener('click', async () => {
      if (personas.length <= 1) return;
      const p = personas.find(x => x.id === currentPersonaId);
      const ok = await showConfirm('Delete Persona', `Delete "${p?.name || 'this persona'}"?`);
      if (!ok) return;

      personas = personas.filter(x => x.id !== currentPersonaId);
      if (!personas.some(x => x.isDefault)) {
        personas[0].isDefault = true;
      }
      currentPersonaId = personas[0].id;
      savePersonas();
      renderPillList();
      fillForm();
      showToast('Persona deleted');
    });

    // NSFW Mode Options
    const nsfwButtons = document.querySelectorAll('.nsfw-opt-btn');
    const currentNsfw = localStorage.getItem('aetheria_nsfw_mode') || 'show';

    function updateNsfwButtons(mode: string) {
      nsfwButtons.forEach(btn => {
        const bMode = btn.getAttribute('data-mode');
        if (bMode === mode) {
          btn.className = 'nsfw-opt-btn py-2.5 px-2 rounded-xl border border-purple-500/60 bg-purple-600/20 text-white font-semibold text-center transition cursor-pointer text-xs';
        } else {
          btn.className = 'nsfw-opt-btn py-2.5 px-2 rounded-xl border border-white/5 bg-white/[0.02] text-slate-400 hover:text-white font-medium text-center transition cursor-pointer text-xs';
        }
      });
    }

    updateNsfwButtons(currentNsfw);

    nsfwButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const mode = btn.getAttribute('data-mode') || 'show';
        localStorage.setItem('aetheria_nsfw_mode', mode);
        updateNsfwButtons(mode);
        showToast('Preference saved', 'success');
      });
    });

    // Check Auth State
    fetch('/api/auth/me')
      .then(res => res.json())
      .then((data: any) => {
        if (data.authenticated && data.user) {
          const nameLabel = document.getElementById('account-name-label');
          const emailLabel = document.getElementById('account-email-label');
          const avatarPill = document.getElementById('account-avatar-pill');
          const actionBox = document.getElementById('account-action-container');

          if (nameLabel) nameLabel.textContent = data.user.name || 'User';
          if (emailLabel) emailLabel.textContent = data.user.email || '';
          if (avatarPill) avatarPill.textContent = (data.user.name || 'U').charAt(0).toUpperCase();

          if (actionBox) {
            actionBox.innerHTML = `
              <button id="btn-logout" type="button" class="px-3.5 py-1.5 rounded-xl bg-white/5 hover:bg-white/10 text-xs font-semibold text-slate-300 hover:text-white transition cursor-pointer">
                Sign Out
              </button>
            `;
            document.getElementById('btn-logout')?.addEventListener('click', async () => {
              await fetch('/api/auth/logout', { method: 'POST' });
              window.location.reload();
            });
          }
        }
      })
      .catch(() => {});

    // Export Backup
    document.getElementById('btn-export-backup')?.addEventListener('click', () => {
      const backupData: Record<string, any> = {};
      for (let i = 0; i < localStorage.length; i++) {
        const key = localStorage.key(i);
        if (key && key.startsWith('aetheria_')) {
          backupData[key] = localStorage.getItem(key);
        }
      }
      const blob = new Blob([JSON.stringify(backupData, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `aetheria_backup_${new Date().toISOString().slice(0,10)}.json`;
      a.click();
      URL.revokeObjectURL(url);
      showToast('Backup downloaded', 'success');
    });

    // Restore Backup
    document.getElementById('backup-file-input')?.addEventListener('change', (e: any) => {
      const file = e.target?.files?.[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = (event) => {
        try {
          const data = JSON.parse(event.target?.result as string);
          Object.keys(data).forEach(k => {
            if (k.startsWith('aetheria_')) {
              localStorage.setItem(k, data[k]);
            }
          });
          showToast('Backup restored successfully!', 'success');
          setTimeout(() => window.location.reload(), 800);
        } catch {
          showToast('Invalid backup file', 'warning');
        }
      };
      reader.readAsText(file);
    });

    // Clear Cache
    document.getElementById('btn-clear-cache')?.addEventListener('click', async () => {
      const ok = await showConfirm('Clear Local Cache', 'Reset local data? Characters and personas saved only locally will be cleared.');
      if (!ok) return;

      Object.keys(localStorage).forEach(k => {
        if (k.startsWith('aetheria_')) localStorage.removeItem(k);
      });
      window.location.reload();
    });

    // ==========================================
    // PROFILE CHAT APPEARANCE & THEME CONTROLLER (STEP 2 ENGINE)
    // ==========================================
    function initProfileThemeSection() {
      if (!window.AetheriaTheme) return;

      const pPreviewImg = document.getElementById('profile-preview-image');
      const pPreviewDimmer = document.getElementById('profile-preview-dimmer');
      const pPreviewPattern = document.getElementById('profile-preview-pattern');
      const pPreviewChar = document.getElementById('profile-preview-char-bubble');
      const pPreviewUser = document.getElementById('profile-preview-user-bubble');

      const pFontSizeSlider = document.getElementById('profile-font-size-slider');
      const pFontSizeBadge = document.getElementById('profile-font-size-badge');
      const pRadiusSlider = document.getElementById('profile-radius-slider');
      const pRadiusBadge = document.getElementById('profile-radius-badge');

      const pBlurToggle = document.getElementById('profile-blur-toggle');
      const pBlurDot = document.getElementById('profile-blur-dot');
      const pDimmerSlider = document.getElementById('profile-dimmer-slider');
      const pDimmerBadge = document.getElementById('profile-dimmer-badge');

      const pPatOpacitySlider = document.getElementById('profile-pattern-opacity-slider');
      const pPatOpacityBadge = document.getElementById('profile-pattern-opacity-badge');

      const pPresetsGrid = document.getElementById('profile-theme-presets-grid');
      const pGradGrid = document.getElementById('profile-bubble-gradients-grid');
      const pWallpaperGrid = document.getElementById('profile-wallpaper-grid');
      const pResetBtn = document.getElementById('profile-theme-reset-btn');

      let currentProfileTheme = { ...window.AetheriaTheme.getSettings() };

      function updateProfilePreview(theme) {
        if (!theme) return;
        const wpVal = theme.chatWallpaper || theme.chatBg || 'linear-gradient(to bottom, #090a12, #0e1122, #07080f)';
        if (pPreviewImg) {
          if (wpVal.startsWith('http') || wpVal.startsWith('data:')) {
            pPreviewImg.style.backgroundImage = `url("${wpVal}")`;
            pPreviewImg.style.backgroundSize = 'cover';
            pPreviewImg.style.backgroundPosition = 'center';
          } else {
            pPreviewImg.style.background = wpVal;
            pPreviewImg.style.backgroundSize = '';
            pPreviewImg.style.backgroundPosition = '';
          }
          pPreviewImg.style.filter = theme.chatBlur ? 'blur(12px)' : 'none';
        }

        if (pPreviewDimmer) {
          pPreviewDimmer.style.opacity = (theme.chatDim !== undefined ? theme.chatDim : 0.20).toString();
        }

        if (pPreviewPattern) {
          const patId = theme.chatPatternId || 'telegram-doodles';
          const patObj = window.AetheriaTheme.DOODLE_PATTERNS[patId] || window.AetheriaTheme.DOODLE_PATTERNS['telegram-doodles'];
          pPreviewPattern.style.backgroundImage = patObj.pattern;
          pPreviewPattern.style.backgroundSize = patObj.patternSize;
          pPreviewPattern.style.opacity = (theme.chatPatternOpacity !== undefined ? theme.chatPatternOpacity : 0.18).toString();
        }

        if (pPreviewChar) {
          pPreviewChar.style.backgroundColor = theme.charBubbleBg || '#101426';
          pPreviewChar.style.borderRadius = `${theme.bubbleRadius || 16}px`;
          pPreviewChar.style.fontSize = `${theme.fontSize || 16}px`;
        }

        if (pPreviewUser) {
          const userBg = theme.userBubbleBg || 'linear-gradient(135deg, #9333ea 0%, #6366f1 100%)';
          if (userBg.startsWith('linear-gradient')) {
            pPreviewUser.style.background = userBg;
          } else {
            pPreviewUser.style.backgroundColor = userBg;
          }
          pPreviewUser.style.borderRadius = `${theme.bubbleRadius || 16}px`;
          pPreviewUser.style.fontSize = `${theme.fontSize || 16}px`;
        }
      }

      function syncProfileInputs() {
        currentProfileTheme = { ...window.AetheriaTheme.getSettings() };
        updateProfilePreview(currentProfileTheme);

        if (pFontSizeSlider) pFontSizeSlider.value = currentProfileTheme.fontSize || 16;
        if (pFontSizeBadge) pFontSizeBadge.textContent = `${currentProfileTheme.fontSize || 16}px`;

        if (pRadiusSlider) pRadiusSlider.value = currentProfileTheme.bubbleRadius !== undefined ? currentProfileTheme.bubbleRadius : 16;
        if (pRadiusBadge) pRadiusBadge.textContent = `${currentProfileTheme.bubbleRadius !== undefined ? currentProfileTheme.bubbleRadius : 16}px`;

        if (pBlurToggle && pBlurDot) {
          if (currentProfileTheme.chatBlur) {
            pBlurToggle.classList.add('bg-purple-500/20', 'border-purple-500/40', 'text-purple-200');
            pBlurDot.classList.add('bg-purple-400');
            pBlurDot.classList.remove('bg-slate-500');
          } else {
            pBlurToggle.classList.remove('bg-purple-500/20', 'border-purple-500/40', 'text-purple-200');
            pBlurDot.classList.remove('bg-purple-400');
            pBlurDot.classList.add('bg-slate-500');
          }
        }

        if (pDimmerSlider && pDimmerBadge) {
          const dimPct = Math.round((currentProfileTheme.chatDim !== undefined ? currentProfileTheme.chatDim : 0.20) * 100);
          pDimmerSlider.value = dimPct;
          pDimmerBadge.textContent = `${dimPct}%`;
        }

        if (pPatOpacitySlider && pPatOpacityBadge) {
          const opPct = Math.round((currentProfileTheme.chatPatternOpacity !== undefined ? currentProfileTheme.chatPatternOpacity : 0.18) * 100);
          pPatOpacitySlider.value = opPct;
          pPatOpacityBadge.textContent = `${opPct}%`;
        }

        // Doodle pills
        document.querySelectorAll('.profile-doodle-btn').forEach(btn => {
          if (btn.getAttribute('data-pat-id') === (currentProfileTheme.chatPatternId || 'telegram-doodles')) {
            btn.classList.add('bg-purple-500/20', 'border-purple-500/40', 'text-purple-300');
          } else {
            btn.classList.remove('bg-purple-500/20', 'border-purple-500/40', 'text-purple-300');
          }
        });

        // Density radio
        if (currentProfileTheme.chatDensity === 'compact') {
          const rComp = document.getElementById('profile-density-compact');
          if (rComp) rComp.checked = true;
        } else {
          const rComf = document.getElementById('profile-density-comfortable');
          if (rComf) rComf.checked = true;
        }

        renderProfilePresets();
        renderProfileGradients();
        renderProfileWallpapers('all');
      }

      function renderProfilePresets() {
        if (!pPresetsGrid) return;
        pPresetsGrid.innerHTML = '';

        window.AetheriaTheme.PRESETS.forEach(preset => {
          const isSelected = currentProfileTheme.themeId === preset.id;
          const card = document.createElement('button');
          card.type = 'button';
          card.className = `relative p-2.5 rounded-2xl border text-left flex flex-col justify-between transition-all duration-200 group overflow-hidden ${
            isSelected 
              ? 'bg-purple-500/15 border-purple-500 shadow-md shadow-purple-950/30 ring-1 ring-purple-500/40' 
              : 'bg-white/[0.02] border-white/10 hover:border-white/20 hover:bg-white/[0.04]'
          }`;

          card.innerHTML = `
            <div class="h-14 w-full rounded-xl p-1.5 mb-2 relative overflow-hidden flex flex-col justify-between" style="background: ${preset.chatWallpaper};">
              <div class="w-10 h-2.5 rounded-md shadow-sm" style="background: ${preset.charBubbleBg}; border: 1px solid rgba(255,255,255,0.1);"></div>
              <div class="w-12 h-3 rounded-md shadow-sm self-end" style="background: ${preset.userBubbleBg};"></div>
              ${isSelected ? `
                <div class="absolute top-1 right-1 w-3.5 h-3.5 rounded-full bg-purple-500 text-white flex items-center justify-center shadow-md">
                  <svg class="w-2 h-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
                </div>
              ` : ''}
            </div>
            <div>
              <div class="flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full" style="background-color: ${preset.accent};"></span>
                <p class="text-xs font-semibold text-slate-100 truncate">${preset.name}</p>
              </div>
            </div>
          `;

          card.addEventListener('click', () => {
            window.AetheriaTheme.saveSettings({
              themeId: preset.id,
              accent: preset.accent,
              accentRgb: preset.accentRgb,
              userBubbleBg: preset.userBubbleBg,
              charBubbleBg: preset.charBubbleBg,
              chatWallpaper: preset.chatWallpaper,
              chatPatternId: preset.chatPatternId,
              chatPatternOpacity: preset.chatPatternOpacity,
              chatBlur: preset.chatBlur,
              chatDim: preset.chatDim,
              bubbleRadius: preset.bubbleRadius,
              fontSize: preset.fontSize,
              chatDensity: preset.chatDensity
            });
            syncProfileInputs();
          });

          pPresetsGrid.appendChild(card);
        });
      }

      function renderProfileGradients() {
        if (!pGradGrid) return;
        pGradGrid.innerHTML = '';

        window.AetheriaTheme.BUBBLE_GRADIENTS.forEach(grad => {
          const isSelected = currentProfileTheme.userBubbleBg === grad.gradient;
          const btn = document.createElement('button');
          btn.type = 'button';
          btn.className = `flex items-center gap-2 p-2 rounded-xl border text-left transition-all ${
            isSelected ? 'border-purple-500 bg-purple-500/15 shadow-md shadow-purple-950/30' : 'border-white/10 hover:border-white/20 bg-white/[0.02]'
          }`;

          btn.innerHTML = `
            <span class="w-5 h-5 rounded-lg shrink-0 shadow-sm" style="background: ${grad.gradient};"></span>
            <span class="text-xs font-medium text-slate-200 truncate">${grad.name}</span>
          `;

          btn.addEventListener('click', () => {
            window.AetheriaTheme.saveSettings({ userBubbleBg: grad.gradient });
            syncProfileInputs();
          });

          pGradGrid.appendChild(btn);
        });
      }

      function renderProfileWallpapers(filter = 'all') {
        if (!pWallpaperGrid) return;
        pWallpaperGrid.innerHTML = '';

        const list = window.AetheriaTheme.WALLPAPERS.filter(w => filter === 'all' || w.category === filter);
        list.forEach(wp => {
          const isSelected = currentProfileTheme.chatWallpaper === wp.val;
          const card = document.createElement('button');
          card.type = 'button';
          card.className = `relative aspect-[3/4] rounded-xl border overflow-hidden transition-all group ${
            isSelected ? 'border-purple-500 ring-2 ring-purple-500/40 shadow-lg shadow-purple-950/40' : 'border-white/10 hover:border-white/20'
          }`;

          if (wp.isImage) {
            card.innerHTML = `
              <img src="${wp.thumb}" alt="${wp.name}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent flex items-end p-2">
                <span class="text-[10px] text-white font-medium truncate">${wp.name}</span>
              </div>
            `;
          } else {
            card.innerHTML = `
              <div class="w-full h-full group-hover:scale-105 transition-transform duration-300" style="background: ${wp.thumb};"></div>
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent flex items-end p-2">
                <span class="text-[10px] text-white font-medium truncate">${wp.name}</span>
              </div>
            `;
          }

          card.addEventListener('click', () => {
            window.AetheriaTheme.saveSettings({ chatWallpaper: wp.val, chatWallpaperId: wp.id });
            syncProfileInputs();
          });

          pWallpaperGrid.appendChild(card);
        });
      }

      // Sliders & Toggles event wiring
      pFontSizeSlider?.addEventListener('input', (e) => {
        const val = parseInt(e.target.value, 10);
        window.AetheriaTheme.saveSettings({ fontSize: val });
        syncProfileInputs();
      });

      pRadiusSlider?.addEventListener('input', (e) => {
        const val = parseInt(e.target.value, 10);
        window.AetheriaTheme.saveSettings({ bubbleRadius: val });
        syncProfileInputs();
      });

      pBlurToggle?.addEventListener('click', () => {
        window.AetheriaTheme.saveSettings({ chatBlur: !currentProfileTheme.chatBlur });
        syncProfileInputs();
      });

      pDimmerSlider?.addEventListener('input', (e) => {
        const val = parseInt(e.target.value, 10);
        window.AetheriaTheme.saveSettings({ chatDim: val / 100 });
        syncProfileInputs();
      });

      pPatOpacitySlider?.addEventListener('input', (e) => {
        const val = parseInt(e.target.value, 10);
        window.AetheriaTheme.saveSettings({ chatPatternOpacity: val / 100 });
        syncProfileInputs();
      });

      // Doodle Pills
      document.querySelectorAll('.profile-doodle-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          window.AetheriaTheme.saveSettings({ chatPatternId: btn.getAttribute('data-pat-id') });
          syncProfileInputs();
        });
      });

      // Category filters
      document.querySelectorAll('.profile-cat-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.profile-cat-btn').forEach(b => {
            b.classList.remove('bg-purple-500/20', 'text-purple-300', 'border-purple-500/30');
            b.classList.add('text-slate-400', 'border-transparent');
          });
          btn.classList.add('bg-purple-500/20', 'text-purple-300', 'border-purple-500/30');
          btn.classList.remove('text-slate-400', 'border-transparent');
          renderProfileWallpapers(btn.getAttribute('data-cat') || 'all');
        });
      });

      // 2-Color Gradient pickers
      const pGradA = document.getElementById('profile-grad-color-a');
      const pGradB = document.getElementById('profile-grad-color-b');
      function updateProfileGrad() {
        if (!pGradA || !pGradB) return;
        const a = pGradA.value;
        const b = pGradB.value;
        document.getElementById('profile-grad-hex-a').textContent = a.toUpperCase();
        document.getElementById('profile-grad-hex-b').textContent = b.toUpperCase();
        window.AetheriaTheme.saveSettings({ userBubbleBg: `linear-gradient(135deg, ${a} 0%, ${b} 100%)` });
        syncProfileInputs();
      }
      pGradA?.addEventListener('input', updateProfileGrad);
      pGradB?.addEventListener('input', updateProfileGrad);

      // Density radio
      document.querySelectorAll('input[name="profile-density"]').forEach(radio => {
        radio.addEventListener('change', (e) => {
          window.AetheriaTheme.saveSettings({ chatDensity: e.target.value });
          syncProfileInputs();
        });
      });

      // Reset
      pResetBtn?.addEventListener('click', () => {
        if (confirm('Reset chat appearance to factory default settings?')) {
          window.AetheriaTheme.resetToDefault();
          syncProfileInputs();
        }
      });

      // Export / Import
      const pExportBtn = document.getElementById('profile-export-theme-btn');
      pExportBtn?.addEventListener('click', () => {
        const code = window.AetheriaTheme.exportTheme();
        if (code) {
          navigator.clipboard.writeText(code).then(() => {
            alert('Theme code copied to clipboard!');
          }).catch(() => {
            prompt('Copy theme code:', code);
          });
        }
      });

      const pImportBtn = document.getElementById('profile-import-theme-btn');
      pImportBtn?.addEventListener('click', () => {
        const raw = prompt('Paste theme code:');
        if (raw) {
          const res = window.AetheriaTheme.importTheme(raw);
          if (res) {
            syncProfileInputs();
            alert('Theme imported successfully!');
          } else {
            alert('Invalid theme code.');
          }
        }
      });

      window.addEventListener('aetheria-theme-change', () => {
        syncProfileInputs();
      });

      syncProfileInputs();
    }

    initProfileThemeSection();


  });
</script>
