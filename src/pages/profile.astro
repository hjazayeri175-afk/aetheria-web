        if (iconThemeSun) iconThemeSun.classList.toggle('hidden', mode !== 'day');
        if (iconThemeMoon) iconThemeMoon.classList.toggle('hidden', mode !== 'dark');
        if (iconThemeZap) iconThemeZap.classList.toggle('hidden', mode !== 'oled');

        // Legacy compatibility
        const isDayMode = mode === 'day';
        const iconSun = document.getElementById('icon-sun');
        const iconMoon = document.getElementById('icon-moon');
        if (badgeDayNight) {
          badgeDayNight.textContent = isDayMode ? 'Day' : (mode === 'oled' ? 'OLED' : 'Dark');
        }
        if (labelDayNight) {
          labelDayNight.textContent = isDayMode ? 'Switch to Dark Mode' : 'Switch to Day Mode';
        }
        if (iconSun && iconMoon) {
          iconSun.classList.toggle('hidden', isDayMode);
          iconMoon.classList.toggle('hidden', !isDayMode);
        }

        // Synchronize battery tab toggle
        const oledToggle = document.getElementById('toggle-deep-dark-oled') as HTMLInputElement | null;
        if (oledToggle) {
          oledToggle.checked = mode === 'oled';
        }
      }

      function updatePreview() {
        if (!previewViewport) return;
        const currentActiveMode = (settings.baseMode === 'oled' || settings.baseMode === 'amoled') ? 'oled'
                                : (settings.baseMode === 'day' ? 'day' : 'dark');
        const isOled = currentActiveMode === 'oled';
        const isDay = currentActiveMode === 'day';

        // 1. Wallpaper background
        if (isOled) {
          previewViewport.style.background = '#000000';
          previewViewport.style.backgroundImage = 'none';
        } else if (settings.chatWallpaper && (settings.chatWallpaper.startsWith('url(') || settings.chatWallpaper.startsWith('data:'))) {
          previewViewport.style.background = settings.chatWallpaper;
          previewViewport.style.backgroundSize = 'cover';
          previewViewport.style.backgroundPosition = 'center';
        } else if (settings.chatWallpaper && !isDay) {
          previewViewport.style.background = settings.chatWallpaper;
          previewViewport.style.backgroundSize = 'cover';
          previewViewport.style.backgroundPosition = 'center';
        } else {
          previewViewport.style.background = isDay ? 'linear-gradient(to bottom, #f8fafc, #f1f5f9)' : '#0a0d16';
        }

        // 1.5 Wallpaper pattern overlay
        if (previewPattern) {
          if (isOled) {
            previewPattern.style.backgroundImage = 'none';
          } else {
            const patId = settings.chatPatternId || (settings.id ? ('pattern-' + settings.id.replace('-mode', '').replace('-corner', '').replace('-luxury', '')) : 'pattern-gamer');
            const patObj = (window as any).AetheriaTheme?.PATTERNS?.[patId];
            if (patObj && patObj.pattern && patObj.pattern !== 'none') {
              previewPattern.style.backgroundImage = patObj.pattern;
              previewPattern.style.backgroundSize = patObj.patternSize;
              previewPattern.style.opacity = (settings.chatPatternOpacity !== undefined ? settings.chatPatternOpacity : (isDay ? 0.06 : 0.16)).toString();
            } else {
              previewPattern.style.backgroundImage = 'none';
            }
          }
        }

        // 2. Outgoing User Message Bubble
        if (previewUserBubble) {
          const radius = settings.bubbleRadius !== undefined ? settings.bubbleRadius : 16;
          previewUserBubble.style.borderRadius = `${radius}px`;
          if (isOled) {
            previewUserBubble.style.background = '#0c0e18';
            previewUserBubble.style.border = '1px solid rgba(255, 255, 255, 0.15)';
          } else if (settings.userBubbleBg) {
            previewUserBubble.style.background = settings.userBubbleBg;
            previewUserBubble.style.border = '';
          }
        }

        // 3. Incoming Character Message Bubble
        if (previewCharBubble) {
          const radius = settings.bubbleRadius !== undefined ? settings.bubbleRadius : 16;
          previewCharBubble.style.borderRadius = `${radius}px`;
          if (isOled) {
            previewCharBubble.style.background = '#050505';
            previewCharBubble.style.borderColor = 'rgba(255, 255, 255, 0.14)';
            previewCharBubble.style.boxShadow = 'none';
          } else if (isDay) {
            previewCharBubble.style.background = '#ffffff';
            previewCharBubble.style.borderColor = 'rgba(0, 0, 0, 0.08)';
            previewCharBubble.style.boxShadow = '0 2px 8px rgba(0, 0, 0, 0.04)';
          } else {
            previewCharBubble.style.background = settings.charBubbleBg || '#181d2c';
            previewCharBubble.style.borderColor = 'rgba(255, 255, 255, 0.1)';
            previewCharBubble.style.boxShadow = '';
          }
          const charMsgText = previewCharBubble.querySelector('p');
          if (charMsgText) {
            charMsgText.style.color = isOled ? '#f8fafc' : (isDay ? '#0f172a' : '#ffffff');
          }
        }

        // 4. Message Font Size
        const fontSize = settings.fontSize !== undefined ? settings.fontSize : 16;
        const charMsgText = document.getElementById('profile-preview-char-msg-text');
        const userMsgText = document.getElementById('profile-preview-user-msg-text');
        if (charMsgText) charMsgText.style.fontSize = `${fontSize}px`;
        if (userMsgText) userMsgText.style.fontSize = `${fontSize}px`;

        // 5. Name color pill
        const nameColor = settings.nameColor || settings.accent || '#a855f7';
        if (namePill) {
          namePill.style.color = nameColor;
        }

        // 6. Ensure buttons and indicators are synchronized with currentActiveMode
        syncModeButtons(currentActiveMode);
      }

