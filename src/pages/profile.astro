        const iconThemeMoon = document.getElementById('icon-theme-indicator-moon');
        const iconThemeZap = document.getElementById('icon-theme-indicator-zap');

        if (badgeThemeMode) {
          badgeThemeMode.textContent = mode === 'oled' ? 'OLED Pure' : (mode === 'day' ? 'Day' : 'Dark');
          if (mode === 'oled') {
            badgeThemeMode.className = 'text-xs text-emerald-400 font-bold capitalize px-2.5 py-0.5 rounded-full bg-emerald-950/70 border border-emerald-500/40 shadow-xs';
          } else if (mode === 'day') {
            badgeThemeMode.className = 'text-xs text-amber-300 font-bold capitalize px-2.5 py-0.5 rounded-full bg-amber-950/70 border border-amber-500/40 shadow-xs';
          } else {
