                  <div class="w-1.5 h-1.5 rounded-full bg-white/90"></div>
                </div>
              </div>
            </div>
          `;
        }).join('');

        presetsGrid.querySelectorAll('.preset-theme-card').forEach((card: any) => {
          card.addEventListener('click', () => {
            const found = presets.find((p: any) => p.id === card.dataset.presetId);
            if (!found) return;
            settings = { ...settings, ...found };
            syncInputs();
            updatePreview();
            saveAndApply();
            renderPresets();
          });
