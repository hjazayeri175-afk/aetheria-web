          borderEffectsGrid.querySelectorAll('.avatar-deco-tile').forEach((tile: any) => {
            tile.addEventListener('click', () => {
              const deco = tile.dataset.deco;
              draftBorderEffect = deco;
              if (deco === 'custom' && !draftCustomDecoUrl) {
                const urlInput = document.getElementById('input-custom-deco-url') as HTMLInputElement;
                urlInput?.focus();
              }
              renderBorderEffects();
              updateLivePreview();
            });
          });
        }

        renderBorderEffects();

        // Render Border Glow Colors (8 dots)
        if (gridGlowColors) {
          gridGlowColors.innerHTML = GLOW_COLORS.map(c => `
            <button 
              type="button" 
              class="glow-color-dot relative w-8 h-8 rounded-full cursor-pointer transition-all active:scale-90 flex items-center justify-center shadow-md select-none hover:scale-105"
              data-value="${c.value}"
              title="${c.name}"
              style="background: ${c.value};"
            >
              <span class="glow-check hidden text-white text-[10px] font-bold drop-shadow-[0_1px_2px_rgba(0,0,0,0.8)] select-none pointer-events-none">✓</span>
            </button>
          `).join('');

          gridGlowColors.querySelectorAll('.glow-color-dot').forEach((btn: any) => {
            btn.addEventListener('click', () => {
              draftGlowColor = btn.dataset.value;
              updateLivePreview();
              renderBorderEffects();
            });
          });
        }

        // Custom Asset Importer Handlers
        const btnApplyCustomDecoUrl = document.getElementById('btn-apply-custom-deco-url');
        const inputCustomDecoUrl = document.getElementById('input-custom-deco-url') as HTMLInputElement;
        const inputCustomDecoFile = document.getElementById('input-custom-deco-file') as HTMLInputElement;

        btnApplyCustomDecoUrl?.addEventListener('click', () => {
          if (inputCustomDecoUrl && inputCustomDecoUrl.value.trim()) {
            draftCustomDecoUrl = inputCustomDecoUrl.value.trim();
            draftBorderEffect = 'custom';
            updateLivePreview();
            renderBorderEffects();
            showToast('Custom decoration asset applied! ✨', 'success');
          }
        });

        inputCustomDecoFile?.addEventListener('change', (e: any) => {
          const file = e.target?.files?.[0];
          if (file) {
            const reader = new FileReader();
            reader.onload = (event) => {
              if (event.target?.result) {
                draftCustomDecoUrl = event.target.result as string;
                draftBorderEffect = 'custom';
                if (inputCustomDecoUrl) inputCustomDecoUrl.value = 'Local File Uploaded';
                updateLivePreview();
                renderBorderEffects();
                showToast('Uploaded decoration asset applied! ✨', 'success');
              }
            };
            reader.readAsDataURL(file);
          }
        });

        // Quick Preset Buttons
        document.querySelectorAll('.btn-quick-deco-preset').forEach((btn: any) => {
          btn.addEventListener('click', () => {
            const url = btn.dataset.url;
            if (url) {
              draftCustomDecoUrl = url;
              draftBorderEffect = 'custom';
              if (inputCustomDecoUrl) inputCustomDecoUrl.value = url;
              updateLivePreview();
              renderBorderEffects();
              showToast(`Applied Discord preset: ${btn.textContent}! ✨`, 'success');
            }
          });
        });

        // Initialize state from active persona
        const active = personas.find(p => p.isActive) || personas[0];
        if (active) {
          draftNameColor = active.nameColor || '#a855f7';
          draftBorderEffect = active.avatarBorderEffect || 'none';
          draftCustomDecoUrl = active.avatarDecorationAssetUrl || '';
          draftGlowColor = active.avatarGlowColor || '#06b6d4';
          draftNameIcon = active.nameIcon || '';
          if (inputCustomDecoUrl && draftCustomDecoUrl) {
            inputCustomDecoUrl.value = draftCustomDecoUrl.startsWith('data:') ? 'Custom Uploaded File' : draftCustomDecoUrl;
          }
        }

        switchTab('name');
        filterBadges();
        updateLivePreview();

        // Apply Logic
        function applyStylesAndSave() {
          const active = personas.find(p => p.isActive) || personas[0];
          if (active) {
            active.nameColor = draftNameColor;
            active.avatarBorderEffect = draftBorderEffect as any;
            active.avatarDecorationAssetUrl = draftCustomDecoUrl;
            active.avatarGlowColor = draftGlowColor;
            active.nameIcon = draftNameIcon;

            // Save to LocalStorage
            savePersonas();

            // Dispatch global events
            window.dispatchEvent(new CustomEvent('aetheria:name-style-changed', {
              detail: {
                nameColor: draftNameColor,
                avatarBorderEffect: draftBorderEffect,
                avatarGlowColor: draftGlowColor,
                nameIcon: draftNameIcon
              }
            }));

            window.dispatchEvent(new CustomEvent('aetheria:persona-updated', {
              detail: active
            }));

            updateHubProfileSummary();
            render3DCarousel();
            showToast('Name style & avatar decoration applied! ✨', 'success');
            showView('view-appearance');
          }
        }

        btnHeaderApply?.addEventListener('click', applyStylesAndSave);
        btnApply?.addEventListener('click', applyStylesAndSave);

        btnCancel?.addEventListener('click', () => {
          showView('view-appearance');
        });

        btnReset?.addEventListener('click', () => {
          draftNameColor = '#a855f7';
          draftBorderEffect = 'none';
          draftGlowColor = '#a855f7';
          draftNameIcon = '';
          updateLivePreview();
          showToast('Reset to default name style & border', 'info');
        });
      }
      // Wallpapers
      function renderWallpapers() {
        if (!wallpapersGrid) return;
        const wps = (window as any).AetheriaTheme?.WALLPAPERS || [];
        wallpapersGrid.innerHTML = wps.slice(0, 6).map((w: any) => `
          <div class="wp-card relative h-16 rounded-xl overflow-hidden border border-white/10 cursor-pointer group shadow-sm" data-wp="${w.css}">
            <div class="absolute inset-0 bg-cover bg-center" style="background: ${w.css};"></div>
            <div class="absolute inset-0 bg-black/40 group-hover:bg-black/10 transition flex items-center justify-center">
              <span class="text-[9px] font-bold text-white">${w.name}</span>
            </div>
          </div>
        `).join('');

        wallpapersGrid.querySelectorAll('.wp-card').forEach((card: any) => {
          card.addEventListener('click', () => {
            settings.chatWallpaper = card.dataset.wp;
            updatePreview();
            saveAndApply();
          });
        });
      }

      function updateSliderProgress(slider: HTMLInputElement | null) {
        if (!slider) return;
        const min = parseFloat(slider.min) || 0;
        const max = parseFloat(slider.max) || 100;
        const val = parseFloat(slider.value) || 0;
        const percent = Math.min(Math.max(((val - min) / (max - min)) * 100, 0), 100);
        const activeColor = settings.accent || 'var(--theme-accent, #8E9AB6)';
        const isDay = settings.baseMode === 'day';
        const trackColor = isDay ? '#e2e8f0' : 'rgba(255, 255, 255, 0.14)';
        slider.style.background = `linear-gradient(to right, ${activeColor} 0%, ${activeColor} ${percent}%, ${trackColor} ${percent}%, ${trackColor} 100%)`;
      }

      function syncInputs() {
        if (fontSlider) fontSlider.value = String(settings.fontSize || 16);
        if (fontVal) fontVal.textContent = String(settings.fontSize || 16);
        if (radiusSlider) radiusSlider.value = String(settings.bubbleRadius !== undefined ? settings.bubbleRadius : 16);
        if (radiusVal) radiusVal.textContent = `${settings.bubbleRadius !== undefined ? settings.bubbleRadius : 16}px`;
        syncModeButtons(settings.baseMode || 'dark');
        updateSliderProgress(fontSlider);
        updateSliderProgress(radiusSlider);
      }

      // Event Listeners
      fontSlider?.addEventListener('input', (e: any) => {
        const val = parseInt(e.target.value, 10);
        settings.fontSize = val;
        if (fontVal) fontVal.textContent = String(val);
        updatePreview();
        saveAndApply();
      });

      radiusSlider?.addEventListener('input', (e: any) => {
        const val = parseInt(e.target.value, 10);
        settings.bubbleRadius = val;
        if (radiusVal) radiusVal.textContent = `${val}px`;
        updatePreview();
        saveAndApply();
      });

      // Tri-State Mode Selector Buttons (Day / Dark / OLED)
      const allModeButtons = document.querySelectorAll('#profile-base-mode-group .profile-mode-btn');
      allModeButtons.forEach((btn: any) => {
        btn.addEventListener('click', () => {
          const targetMode = btn.getAttribute('data-mode') || 'dark';
          settings.baseMode = targetMode;
          settings.dayNightMode = targetMode === 'day' ? 'day' : 'dark';

          saveAndApply();
          syncModeButtons(targetMode);
          updatePreview();
          renderPresets();
          render3DCarousel();
        });
      });

      // Synchronize when Power Saving OLED toggle is changed from the battery tab
      window.addEventListener('aetheria:power-saving-change', (e: any) => {
        const psSettings = e.detail || (window as any).AetheriaPowerSaving?.getSettings?.();
        if (psSettings) {
          if (psSettings.deepDarkOLED || psSettings.master) {
            settings.baseMode = 'oled';
            settings.dayNightMode = 'dark';
          } else if (settings.baseMode === 'oled') {
            let prev = 'dark';
            try {
              const stored = localStorage.getItem('aetheria_prev_base_mode');
              if (stored === 'day' || stored === 'dark') prev = stored;
            } catch(e) {}
            settings.baseMode = prev;
            settings.dayNightMode = prev;
          }
          syncModeButtons(settings.baseMode || 'dark');
          updatePreview();
          renderPresets();
          render3DCarousel();
        }
      });

      // Synchronize when Theme changes from another origin/action
      window.addEventListener('aetheria-theme-change', (e: any) => {
        if (e.detail && e.detail.baseMode) {
          settings.baseMode = e.detail.baseMode;
          settings.dayNightMode = e.detail.baseMode === 'day' ? 'day' : 'dark';
          syncModeButtons(settings.baseMode);
          updatePreview();
          renderPresets();
          render3DCarousel();
        }
      });

      btnSwitchDayNight?.addEventListener('click', () => {
        const nextMode = settings.baseMode === 'day' ? 'dark' : 'day';
        settings.baseMode = nextMode;
        settings.dayNightMode = nextMode;
        saveAndApply();
        syncModeButtons(nextMode);
        updatePreview();
        renderPresets();
        render3DCarousel();
      });

      btnToggleWallpaperDrawer?.addEventListener('click', () => {
        const isHidden = drawerWallpaper?.classList.toggle('hidden');
        chevronWallpaper?.classList.toggle('rotate-90', !isHidden);
      });

      photoBtn?.addEventListener('click', () => photoFileInput?.click());
      photoFileInput?.addEventListener('change', (e: any) => {
        const file = e.target.files?.[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (re) => {
          const res = re.target?.result as string;
          settings.chatWallpaper = `url("${res}")`;
          updatePreview();
          saveAndApply();
        };
        reader.readAsDataURL(file);
      });

      // Card 3 & 4 Toggles Wiring
      const toggleSendEnter = document.getElementById('setting-send-enter') as HTMLInputElement | null;
      const toggleStreamTypewriter = document.getElementById('setting-stream-typewriter') as HTMLInputElement | null;
      const toggleSoundEffects = document.getElementById('setting-sound-effects') as HTMLInputElement | null;
      const toggleAutoplayVoice = document.getElementById('setting-autoplay-voice') as HTMLInputElement | null;
      const toggleTapNextMedia = document.getElementById('setting-tap-next-media') as HTMLInputElement | null;
      const toggleReduceMotion = document.getElementById('setting-reduce-motion') as HTMLInputElement | null;

      function playPreviewChime() {
        try {
          const ps = (window as any).AetheriaPowerSaving;
          const gate = (window as any).AetheriaAudio;
          if ((gate && gate.isSoundMuted && gate.isSoundMuted()) || (ps && (ps.getSettings?.().disableSounds || ps.getSettings?.().master))) {
            return;
          }
          const ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.frequency.setValueAtTime(587.33, ctx.currentTime);
          osc.frequency.exponentialRampToValueAtTime(880, ctx.currentTime + 0.12);
          gain.gain.setValueAtTime(0.08, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.13);
          osc.start();
          osc.stop(ctx.currentTime + 0.13);
        } catch(e) {}
      }

      if (toggleSendEnter) {
        toggleSendEnter.checked = localStorage.getItem('aetheria_chat_send_key') !== 'ctrl_enter';
        toggleSendEnter.addEventListener('change', () => {
          localStorage.setItem('aetheria_chat_send_key', toggleSendEnter.checked ? 'enter' : 'ctrl_enter');
        });
      }

      if (toggleStreamTypewriter) {
        toggleStreamTypewriter.checked = localStorage.getItem('aetheria_stream_typewriter') !== 'false';
        toggleStreamTypewriter.addEventListener('change', () => {
          localStorage.setItem('aetheria_stream_typewriter', String(toggleStreamTypewriter.checked));
        });
      }

      if (toggleSoundEffects) {
        toggleSoundEffects.checked = localStorage.getItem('aetheria_sound_effects') === 'true';
        toggleSoundEffects.addEventListener('change', () => {
          localStorage.setItem('aetheria_sound_effects', String(toggleSoundEffects.checked));
          if (toggleSoundEffects.checked) {
            playPreviewChime();
          }
        });
      }

      if (toggleAutoplayVoice) {
        toggleAutoplayVoice.checked = (localStorage.getItem('aetheria_autoplay_voice') === 'true' || localStorage.getItem('aetheria_voice_autoplay') === 'true');
        toggleAutoplayVoice.addEventListener('change', () => {
          const val = String(toggleAutoplayVoice.checked);
          localStorage.setItem('aetheria_autoplay_voice', val);
          localStorage.setItem('aetheria_voice_autoplay', val);
        });
      }

      if (toggleTapNextMedia) {
        toggleTapNextMedia.checked = localStorage.getItem('aetheria_tap_next_media') !== 'false';
        toggleTapNextMedia.addEventListener('change', () => {
          localStorage.setItem('aetheria_tap_next_media', String(toggleTapNextMedia.checked));
        });
      }

      if (toggleReduceMotion) {
        toggleReduceMotion.checked = localStorage.getItem('aetheria_reduce_motion') === 'true';
        toggleReduceMotion.addEventListener('change', () => {
          localStorage.setItem('aetheria_reduce_motion', String(toggleReduceMotion.checked));
          document.documentElement.classList.toggle('reduce-motion', toggleReduceMotion.checked);
        });
      }

      // Init everything
      syncInputs();
      updatePreview();
      renderPresets();
      initNameColorPage();
      renderWallpapers();
    }

    // Call initProfileChatSettings
    initProfileChatSettings();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', bootProfile);
  } else {
    bootProfile();
  }
</script>
