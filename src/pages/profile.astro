    // Render Persona Cards
    personas.forEach((p, idx) => {
      const isFlipped = !!flippedCards[p.id];
      const displayName = escapeHtml(p.name || 'Untitled Persona');
      const aboutText = escapeHtml((p.about || '').trim());
      const directivesText = escapeHtml((p.additionalInstructions || '').trim());
      
      // Demographic parts - ONLY build from real user-entered values (no hardcoded fallbacks!)
