</Layout>

<script>
  // ================= STORAGE CONSTANTS =================
  const STORAGE_KEY_PERSONAS = 'aetheria_saved_personas';
  const STORAGE_KEY_ACTIVE = 'aetheria_user_persona';
  const STORAGE_KEY_CUSTOM_CHARS = 'aetheria_custom_characters';
  const STORAGE_KEY_NSFW = 'aetheria_nsfw_mode';

  interface UserMask {
    id: string;
    name: string;
    age: string;
    gender: string;
    pronouns?: string;
    title?: string;
    avatar: string;
    appearance: string;
    personality: string;
    lore: string;
    directives: string;
    isDefault?: boolean;
  }

  // Pure clean default mask (NO fake pre-filled values!)
  function createBlankMask(id = 'mask_' + Date.now(), name = ''): UserMask {
    return {
      id,
      name,
      age: '',
      gender: '',
      title: '',
      avatar: '',
      appearance: '',
      personality: '',
      lore: '',
      directives: 'Never speak, narrate thoughts, or choose actions for {{user}}. Maintain atmospheric immersion. Format sensory actions in *asterisks* and spoken dialogue in quotes.'
    };
  }

  // DOM Elements
  const tabBtnMasks = document.getElementById('tab-btn-masks');
  const tabBtnAccount = document.getElementById('tab-btn-account');
  const tabViewMasks = document.getElementById('tab-view-masks');
  const tabViewAccount = document.getElementById('tab-view-account');

  const maskPillsContainer = document.getElementById('mask-pills-container');
  const masksCountBadge = document.getElementById('masks-count-badge');
  const addMaskBtn = document.getElementById('add-mask-btn');

  // Mask Form Elements
  const maskForm = document.getElementById('mask-editor-form') as HTMLFormElement;
  const maskIdLabel = document.getElementById('mask-id-label');
  const maskActiveStatusBadge = document.getElementById('mask-active-status-badge');
  const activateMaskBtn = document.getElementById('activate-mask-btn');
  const duplicateMaskBtn = document.getElementById('duplicate-mask-btn');
  const deleteMaskBtn = document.getElementById('delete-mask-btn');

  const maskAvatarClickable = document.getElementById('mask-avatar-clickable');
  const maskAvatarFileInput = document.getElementById('mask-avatar-file-input') as HTMLInputElement;
  const maskAvatarImg = document.getElementById('mask-avatar-img') as HTMLImageElement;
  const maskAvatarPlaceholder = document.getElementById('mask-avatar-placeholder');
  const maskAvatarUrlToggleBtn = document.getElementById('mask-avatar-url-toggle-btn');
  const maskAvatarRemoveBtn = document.getElementById('mask-avatar-remove-btn');
  const maskAvatarUrlDrawer = document.getElementById('mask-avatar-url-drawer');
  const maskAvatarUrlInput = document.getElementById('mask-avatar-url-input') as HTMLInputElement;
  const maskAvatarUrlApplyBtn = document.getElementById('mask-avatar-url-apply-btn');

  const nameInput = document.getElementById('mask-name') as HTMLInputElement;
  const ageInput = document.getElementById('mask-age') as HTMLInputElement;
  const genderInput = document.getElementById('mask-gender') as HTMLInputElement;
  const titleInput = document.getElementById('mask-title') as HTMLInputElement;

  const appearanceInput = document.getElementById('mask-appearance') as HTMLTextAreaElement;
  const personalityInput = document.getElementById('mask-personality') as HTMLTextAreaElement;
  const loreInput = document.getElementById('mask-lore') as HTMLTextAreaElement;
  const directivesInput = document.getElementById('mask-directives') as HTMLTextAreaElement;

  const tokAppearance = document.getElementById('tok-mask-appearance');
  const tokPersonality = document.getElementById('tok-mask-personality');
  const tokLore = document.getElementById('tok-mask-lore');
  const tokDirectives = document.getElementById('tok-mask-directives');

  const resetMaskBtn = document.getElementById('reset-mask-btn');
  const toast = document.getElementById('status-toast') as HTMLElement;
  const toastText = document.getElementById('toast-text') as HTMLElement;

  // Account Tab Elements
  const authStatusPill = document.getElementById('auth-status-pill');
  const accountAvatarLetter = document.getElementById('account-avatar-letter');
  const accountDisplayName = document.getElementById('account-display-name');
  const accountEmail = document.getElementById('account-email');
  const accountLoginLink = document.getElementById('account-login-link');
  const accountLogoutBtn = document.getElementById('account-logout-btn');
  const nsfwFilterBtns = document.querySelectorAll('.nsfw-opt-btn');

  // Backup Elements
  const exportBackupBtn = document.getElementById('export-backup-btn');
  const importBackupFile = document.getElementById('import-backup-file') as HTMLInputElement;
  const clearCacheBtn = document.getElementById('clear-cache-btn');
  const generateSyncBtn = document.getElementById('generate-sync-token-btn');
  const copySyncBtn = document.getElementById('copy-sync-token-btn');
  const applySyncBtn = document.getElementById('apply-sync-token-btn');
  const syncTokenBox = document.getElementById('sync-token-box') as HTMLTextAreaElement;

  let masks: UserMask[] = [];
  let currentEditingId = '';
  let activeChatMaskId = '';
  let currentAvatarData = '';

  function showToast(msg: string) {
    if (!toast || !toastText) return;
    toastText.textContent = msg;
    toast.classList.remove('hidden');
    setTimeout(() => {
      toast.classList.add('hidden');
    }, 3500);
  }

  // Modern Glassmorphic Dialog Modal
  function showConfirmModal({
    title = 'Confirm Action',
    message = 'Are you sure you want to proceed?',
    confirmText = 'Confirm',
    cancelText = 'Cancel',
    type = 'default',
    icon = ''
  }: {
    title?: string;
    message?: string;
    confirmText?: string;
    cancelText?: string;
    type?: string;
    icon?: string;
  } = {}): Promise<boolean> {
    return new Promise((resolve) => {
      const isDanger = type === 'danger';
      const isWarning = type === 'warning';
      const iconDisplay = icon || (isDanger ? '🗑️' : isWarning ? '⚠️' : '✨');

      const backdrop = document.createElement('div');
      backdrop.className = 'fixed inset-0 z-[10000] flex items-center justify-center p-4 bg-black/75 backdrop-blur-md transition-opacity duration-200 opacity-0';
      
      const modal = document.createElement('div');
      modal.className = 'w-full max-w-sm rounded-3xl bg-[#0d1124]/95 border border-purple-500/30 p-5 sm:p-6 shadow-2xl shadow-purple-950/80 transform scale-95 transition-all duration-200 text-left';

      const cancelBtnHtml = cancelText ? `
        <button id="modal-btn-cancel" type="button" class="px-4 py-2 rounded-xl text-xs font-medium text-slate-300 hover:text-white bg-white/5 hover:bg-white/10 border border-white/10 transition-all cursor-pointer">
          ${cancelText}
        </button>
      ` : '';

      const confirmBtnClass = isDanger
        ? 'bg-rose-600 hover:bg-rose-500 text-white shadow-lg shadow-rose-900/40 border border-rose-500/40'
        : 'bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white shadow-lg shadow-purple-900/40 border border-purple-500/40';

      modal.innerHTML = `
        <div class="flex items-start gap-3.5">
          <div class="w-10 h-10 rounded-2xl flex items-center justify-center shrink-0 text-xl ${
            isDanger ? 'bg-rose-500/15 border border-rose-500/30 text-rose-400' : isWarning ? 'bg-amber-500/15 border border-amber-500/30 text-amber-400' : 'bg-purple-500/15 border border-purple-500/30 text-purple-300'
          }">
            ${iconDisplay}
          </div>
          <div class="flex-1 min-w-0">
            <h3 class="text-sm font-bold text-white tracking-wide">${title}</h3>
            <p class="mt-1.5 text-xs text-slate-300 leading-relaxed">${message}</p>
          </div>
        </div>
        <div class="mt-6 flex items-center justify-end gap-2.5">
          ${cancelBtnHtml}
          <button id="modal-btn-confirm" type="button" class="px-4 py-2 rounded-xl text-xs font-semibold shadow-lg transition-all cursor-pointer ${confirmBtnClass}">
            ${confirmText}
          </button>
        </div>
      `;

      backdrop.appendChild(modal);
      document.body.appendChild(backdrop);

      requestAnimationFrame(() => {
        backdrop.classList.remove('opacity-0');
        modal.classList.remove('scale-95');
      });

      const cleanup = (confirmed: boolean) => {
        backdrop.classList.add('opacity-0');
        modal.classList.add('scale-95');
        setTimeout(() => backdrop.remove(), 200);
        window.removeEventListener('keydown', onKeyDown);
        resolve(confirmed);
      };

      const confirmBtn = modal.querySelector('#modal-btn-confirm') as HTMLButtonElement | null;
      const cancelBtn = modal.querySelector('#modal-btn-cancel') as HTMLButtonElement | null;
      if (confirmBtn) confirmBtn.onclick = () => cleanup(true);
      if (cancelBtn) cancelBtn.onclick = () => cleanup(false);
      backdrop.onclick = (e) => {
        if (e.target === backdrop) cleanup(false);
      };

      const onKeyDown = (e: KeyboardEvent) => {
        if (e.key === 'Escape') cleanup(false);
        else if (e.key === 'Enter') cleanup(true);
      };
      window.addEventListener('keydown', onKeyDown);
    });
  }

  function countTokens(text: string): number {
    return Math.ceil((text || '').trim().length / 4);
  }

  function updateTokenCounters() {
    if (tokAppearance && appearanceInput) tokAppearance.textContent = `~${countTokens(appearanceInput.value)} tok`;
    if (tokPersonality && personalityInput) tokPersonality.textContent = `~${countTokens(personalityInput.value)} tok`;
    if (tokLore && loreInput) tokLore.textContent = `~${countTokens(loreInput.value)} tok`;
    if (tokDirectives && directivesInput) tokDirectives.textContent = `~${countTokens(directivesInput.value)} tok`;
  }

  function updateAvatarDisplay(url: string) {
    if (url && url.trim()) {
      maskAvatarImg.src = url;
      maskAvatarImg.classList.remove('hidden');
      maskAvatarPlaceholder?.classList.add('hidden');
    } else {
      maskAvatarImg.src = '';
      maskAvatarImg.classList.add('hidden');
      maskAvatarPlaceholder?.classList.remove('hidden');
    }
  }

  function processAvatarFile(file: File) {
    if (!file || !file.type.startsWith('image/')) {
      showToast('Please select an image file (PNG, JPG, WebP, GIF).');
      return;
    }
    if (file.size > 8 * 1024 * 1024) {
      showToast('File size is too large (Max 8MB).');
      return;
    }

    const reader = new FileReader();
    reader.onload = (e) => {
      const img = new Image();
      img.onload = () => {
        const canvas = document.createElement('canvas');
        const maxSize = 400;
        let width = img.width;
        let height = img.height;
        if (width > height) {
          if (width > maxSize) {
            height = Math.round((height * maxSize) / width);
            width = maxSize;
          }
        } else {
          if (height > maxSize) {
            width = Math.round((width * maxSize) / height);
            height = maxSize;
          }
        }
        canvas.width = width;
        canvas.height = height;
        const ctx = canvas.getContext('2d');
        if (ctx) {
          ctx.drawImage(img, 0, 0, width, height);
          const compressedDataUrl = canvas.toDataURL('image/webp', 0.85);
          currentAvatarData = compressedDataUrl;
          if (maskAvatarUrlInput) maskAvatarUrlInput.value = '';
          updateAvatarDisplay(compressedDataUrl);
          showToast('Avatar photo updated! Click "Save & Apply Mask".');
        }
      };
      img.src = e.target?.result as string;
    };
    reader.readAsDataURL(file);
  }

  // ================= SWITCH TABS =================
  tabBtnMasks?.addEventListener('click', () => {
    tabBtnMasks.className = 'flex-1 flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl text-xs sm:text-sm font-bold transition cursor-pointer bg-purple-600 text-white shadow-lg shadow-purple-900/40';
    tabBtnAccount.className = 'flex-1 flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl text-xs sm:text-sm font-bold transition cursor-pointer text-slate-400 hover:text-white hover:bg-white/[0.05]';
    tabViewMasks?.classList.remove('hidden');
    tabViewAccount?.classList.add('hidden');
  });

  tabBtnAccount?.addEventListener('click', () => {
    tabBtnAccount.className = 'flex-1 flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl text-xs sm:text-sm font-bold transition cursor-pointer bg-purple-600 text-white shadow-lg shadow-purple-900/40';
    tabBtnMasks.className = 'flex-1 flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl text-xs sm:text-sm font-bold transition cursor-pointer text-slate-400 hover:text-white hover:bg-white/[0.05]';
    tabViewAccount?.classList.remove('hidden');
    tabViewMasks?.classList.add('hidden');
    checkAuthStatus();
  });

  // ================= LOAD & MIGRATE MASKS =================
  function loadMasksFromStorage() {
    try {
      const saved = localStorage.getItem(STORAGE_KEY_PERSONAS);
      if (saved) {
        const rawList = JSON.parse(saved);
        masks = rawList.map((item: any) => ({
          id: item.id || ('mask_' + Math.random().toString(36).slice(2, 9)),
          name: item.name || '',
          age: item.age || '',
          gender: item.gender || item.pronouns || '',
          title: item.title || '',
          avatar: (item.avatar && !item.avatar.startsWith('/avatars/')) ? item.avatar : '',
          appearance: item.appearance || '',
          personality: item.personality || '',
          lore: item.lore || item.bio || '',
          directives: item.directives || item.globalNotes || ''
        }));
      }

      // If empty, check active legacy persona
      if (masks.length === 0) {
        const single = localStorage.getItem(STORAGE_KEY_ACTIVE);
        if (single) {
          const item = JSON.parse(single);
          masks = [{
            id: item.id || 'mask_default',
            name: item.name === 'Traveler' ? '' : (item.name || ''),
            age: item.age || '',
            gender: item.gender || (item.pronouns === 'They/Them' ? '' : (item.pronouns || '')),
            title: item.title === 'Explorer of the Nexus' ? '' : (item.title || ''),
            avatar: (item.avatar && !item.avatar.startsWith('/avatars/')) ? item.avatar : '',
            appearance: item.appearance || '',
            personality: item.personality || '',
            lore: (item.bio && item.bio.includes('resilient traveler')) ? '' : (item.bio || ''),
            directives: item.globalNotes || ''
          }];
        } else {
          masks = [createBlankMask('mask_default', '')];
        }
      }

      // Resolve active mask
      const activeObj = localStorage.getItem(STORAGE_KEY_ACTIVE);
      if (activeObj) {
        const parsed = JSON.parse(activeObj);
        activeChatMaskId = parsed.id || masks[0].id;
      } else {
        activeChatMaskId = masks[0].id;
      }

      currentEditingId = activeChatMaskId || masks[0].id;

    } catch (e) {
      masks = [createBlankMask('mask_default', '')];
      activeChatMaskId = masks[0].id;
      currentEditingId = masks[0].id;
    }

    renderMaskPills();
    populateFormWithMask(currentEditingId);
  }

  function renderMaskPills() {
    if (!maskPillsContainer) return;
    maskPillsContainer.innerHTML = '';

    if (masksCountBadge) masksCountBadge.textContent = String(masks.length);

    masks.forEach((m, idx) => {
      const isEditing = m.id === currentEditingId;
      const isActive = m.id === activeChatMaskId;

      const pill = document.createElement('button');
      pill.type = 'button';
      pill.className = `shrink-0 flex items-center gap-2 px-3.5 py-1.5 rounded-xl text-xs font-semibold transition cursor-pointer ${
        isEditing 
          ? 'bg-purple-600 text-white shadow-md shadow-purple-900/40 ring-1 ring-purple-400/50' 
          : 'bg-white/[0.04] text-slate-400 hover:text-white hover:bg-white/[0.08]'
      }`;

      const avatarSnippet = m.avatar 
        ? `<img src="${m.avatar}" class="w-4 h-4 rounded-full object-cover shrink-0" />`
        : `<span class="w-2 h-2 rounded-full ${isActive ? 'bg-emerald-400 animate-pulse' : 'bg-slate-500'}"></span>`;

      pill.innerHTML = `
        ${avatarSnippet}
        <span>${m.name || `Mask ${idx + 1}`}</span>
        ${isActive ? '<span class="text-[9px] px-1 py-0.2 rounded bg-emerald-500/20 text-emerald-300 font-bold">Active</span>' : ''}
      `;

      pill.addEventListener('click', () => {
        saveCurrentFormInMemory();
        currentEditingId = m.id;
        renderMaskPills();
        populateFormWithMask(currentEditingId);
      });

      maskPillsContainer.appendChild(pill);
    });
  }

  function populateFormWithMask(id: string) {
    const mask = masks.find(m => m.id === id) || masks[0];
    if (!mask) return;

    if (maskIdLabel) maskIdLabel.textContent = `ID: ${mask.id.slice(0, 14)}`;

    nameInput.value = mask.name || '';
    ageInput.value = mask.age || '';
    genderInput.value = mask.gender || '';
    titleInput.value = mask.title || '';

    currentAvatarData = mask.avatar || '';
    if (maskAvatarUrlInput) maskAvatarUrlInput.value = mask.avatar && mask.avatar.startsWith('http') ? mask.avatar : '';
    updateAvatarDisplay(currentAvatarData);

    appearanceInput.value = mask.appearance || '';
    personalityInput.value = mask.personality || '';
    loreInput.value = mask.lore || '';
    directivesInput.value = mask.directives || '';

    updateTokenCounters();

    // Active Status Badge & Activate Button
    const isActive = mask.id === activeChatMaskId;
    if (maskActiveStatusBadge) {
      if (isActive) {
        maskActiveStatusBadge.className = 'px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 flex items-center gap-1.5';
        maskActiveStatusBadge.innerHTML = '<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span><span>Active Mask for Chats</span>';
      } else {
        maskActiveStatusBadge.className = 'px-2.5 py-1 rounded-full text-xs font-medium bg-white/[0.04] border border-white/10 text-slate-400 flex items-center gap-1.5';
        maskActiveStatusBadge.innerHTML = '<span class="w-2 h-2 rounded-full bg-slate-500"></span><span>Inactive Mask</span>';
      }
    }

    if (activateMaskBtn) {
      if (isActive) {
        activateMaskBtn.classList.add('hidden');
      } else {
        activateMaskBtn.classList.remove('hidden');
      }
    }

    if (deleteMaskBtn) {
      if (masks.length <= 1) {
        deleteMaskBtn.classList.add('opacity-40', 'pointer-events-none');
      } else {
        deleteMaskBtn.classList.remove('opacity-40', 'pointer-events-none');
      }
    }
  }

  function saveCurrentFormInMemory(): UserMask {
    const updated: UserMask = {
      id: currentEditingId,
      name: nameInput.value.trim(),
      age: ageInput.value.trim(),
      gender: genderInput.value.trim(),
      title: titleInput.value.trim(),
      avatar: currentAvatarData || (maskAvatarUrlInput ? maskAvatarUrlInput.value.trim() : ''),
      appearance: appearanceInput.value.trim(),
      personality: personalityInput.value.trim(),
      lore: loreInput.value.trim(),
      directives: directivesInput.value.trim()
    };

    const idx = masks.findIndex(m => m.id === currentEditingId);
    if (idx !== -1) {
      masks[idx] = updated;
    } else {
      masks.push(updated);
    }
    return updated;
  }

  function saveAllMasksToStorage(notify = true) {
    const current = saveCurrentFormInMemory();
    localStorage.setItem(STORAGE_KEY_PERSONAS, JSON.stringify(masks));

    // Ensure active persona is updated
    const activeMask = masks.find(m => m.id === activeChatMaskId) || current;
    localStorage.setItem(STORAGE_KEY_ACTIVE, JSON.stringify({
      id: activeMask.id,
      name: activeMask.name || 'User',
      age: activeMask.age || '',
      gender: activeMask.gender || '',
      pronouns: activeMask.gender || '',
      title: activeMask.title || '',
      avatar: activeMask.avatar || '',
      appearance: activeMask.appearance || '',
      personality: activeMask.personality || '',
      bio: activeMask.lore || '',
      lore: activeMask.lore || '',
      globalNotes: activeMask.directives || '',
      directives: activeMask.directives || ''
    }));

    renderMaskPills();
    populateFormWithMask(currentEditingId);

    if (notify) {
      showToast(`Mask "${current.name || 'Unnamed'}" saved & active!`);
    }
  }

  // ================= AVATAR LISTENERS =================
  maskAvatarClickable?.addEventListener('click', () => {
    maskAvatarFileInput?.click();
  });

  maskAvatarFileInput?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (file) processAvatarFile(file);
  });

  maskAvatarRemoveBtn?.addEventListener('click', () => {
    currentAvatarData = '';
    if (maskAvatarUrlInput) maskAvatarUrlInput.value = '';
    updateAvatarDisplay('');
    showToast('Avatar removed.');
  });

  maskAvatarUrlToggleBtn?.addEventListener('click', () => {
    maskAvatarUrlDrawer?.classList.toggle('hidden');
    if (!maskAvatarUrlDrawer?.classList.contains('hidden')) {
      maskAvatarUrlInput?.focus();
    }
  });

  maskAvatarUrlApplyBtn?.addEventListener('click', () => {
    const url = maskAvatarUrlInput.value.trim();
    if (url) {
      currentAvatarData = url;
      updateAvatarDisplay(url);
      maskAvatarUrlDrawer?.classList.add('hidden');
      showToast('Avatar image link applied!');
    }
  });

  // Token counters update
  [appearanceInput, personalityInput, loreInput, directivesInput].forEach(inp => {
    inp?.addEventListener('input', updateTokenCounters);
  });

  // Form submit
  maskForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    saveAllMasksToStorage(true);
  });

  // Activate Mask
  activateMaskBtn?.addEventListener('click', () => {
    activeChatMaskId = currentEditingId;
    saveAllMasksToStorage(false);
    showToast('Set as active mask for all roleplay chats!');
  });

  // Add New Mask
  addMaskBtn?.addEventListener('click', () => {
    saveCurrentFormInMemory();
    const newMask = createBlankMask();
    masks.push(newMask);
    currentEditingId = newMask.id;
    activeChatMaskId = newMask.id; // automatically activate new mask
    saveAllMasksToStorage(false);
    renderMaskPills();
    populateFormWithMask(newMask.id);
    nameInput?.focus();
    showToast('New mask created! Enter identity details.');
  });

  // Duplicate Mask
  duplicateMaskBtn?.addEventListener('click', () => {
    saveCurrentFormInMemory();
    const current = masks.find(m => m.id === currentEditingId);
    if (!current) return;

    const dupMask: UserMask = {
      ...current,
      id: 'mask_' + Date.now(),
      name: current.name ? `${current.name} (Copy)` : 'Copy of Mask'
    };
    masks.push(dupMask);
    currentEditingId = dupMask.id;
    saveAllMasksToStorage(false);
    renderMaskPills();
    populateFormWithMask(dupMask.id);
    showToast('Mask duplicated successfully!');
  });

  // Delete Mask
  deleteMaskBtn?.addEventListener('click', async () => {
    if (masks.length <= 1) {
      showToast('Cannot delete the last remaining mask.');
      return;
    }

    const current = masks.find(m => m.id === currentEditingId);
    const confirmed = await showConfirmModal({
      title: 'Delete Mask',
      message: `Permanently delete mask "${current?.name || 'Unnamed'}"? This action cannot be undone.`,
      confirmText: 'Delete Mask',
      cancelText: 'Cancel',
      type: 'danger'
    });

    if (confirmed) {
      masks = masks.filter(m => m.id !== currentEditingId);
      currentEditingId = masks[0].id;
      if (activeChatMaskId === current?.id) {
        activeChatMaskId = masks[0].id;
      }
      saveAllMasksToStorage(false);
      renderMaskPills();
      populateFormWithMask(currentEditingId);
      showToast('Mask deleted.');
    }
  });

  // Reset Mask
  resetMaskBtn?.addEventListener('click', async () => {
    const confirmed = await showConfirmModal({
      title: 'Reset Mask Fields',
      message: 'Revert all fields of this mask to their saved values?',
      confirmText: 'Reset Fields',
      cancelText: 'Cancel',
      type: 'warning'
    });
    if (confirmed) {
      populateFormWithMask(currentEditingId);
      showToast('Mask fields reset.');
    }
  });

  // ================= ACCOUNT & SAFETY =================
  async function checkAuthStatus() {
    try {
      const res = await fetch('/api/auth/me');
      if (res.ok) {
        const data = await res.json();
        if (data.authenticated && data.user) {
          if (authStatusPill) {
            authStatusPill.textContent = 'Authenticated';
            authStatusPill.className = 'text-xs px-2.5 py-0.5 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 font-mono';
          }
          if (accountDisplayName) accountDisplayName.textContent = data.user.displayName || data.user.email.split('@')[0];
          if (accountEmail) accountEmail.textContent = data.user.email;
          if (accountAvatarLetter) accountAvatarLetter.textContent = (data.user.displayName || data.user.email || 'A').charAt(0).toUpperCase();
          accountLoginLink?.classList.add('hidden');
          accountLogoutBtn?.classList.remove('hidden');
          return;
        }
      }
    } catch {}

    // Fallback Guest
    if (authStatusPill) {
      authStatusPill.textContent = 'Guest Mode';
      authStatusPill.className = 'text-xs px-2.5 py-0.5 rounded-full bg-white/[0.06] border border-white/10 text-slate-300 font-mono';
    }
    if (accountDisplayName) accountDisplayName.textContent = 'Guest Explorer';
    if (accountEmail) accountEmail.textContent = 'Local Browser Session (Private)';
    if (accountAvatarLetter) accountAvatarLetter.textContent = 'G';
    accountLoginLink?.classList.remove('hidden');
    accountLogoutBtn?.classList.add('hidden');
  }

  accountLogoutBtn?.addEventListener('click', async () => {
    const confirmed = await showConfirmModal({
      title: 'Log Out',
      message: 'Log out of your Aetheria account on this device?',
      confirmText: 'Log Out',
      cancelText: 'Cancel',
      type: 'warning'
    });
    if (confirmed) {
      try {
        await fetch('/api/auth/logout', { method: 'POST' });
      } catch {}
      window.location.reload();
    }
  });

  // NSFW Preference
  function initNsfwPreference() {
    const curNsfw = localStorage.getItem(STORAGE_KEY_NSFW) || 'full';
    updateNsfwButtons(curNsfw);

    nsfwFilterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const val = btn.getAttribute('data-nsfw') || 'full';
        localStorage.setItem(STORAGE_KEY_NSFW, val);
        updateNsfwButtons(val);
        showToast(`Content filter updated to: ${val.toUpperCase()}`);
      });
    });
  }

  function updateNsfwButtons(val: string) {
    nsfwFilterBtns.forEach(btn => {
      const bVal = btn.getAttribute('data-nsfw');
      if (bVal === val) {
        btn.className = 'nsfw-opt-btn p-4 rounded-2xl border text-left transition cursor-pointer flex flex-col justify-between gap-3 bg-purple-600/15 border-purple-500/60 text-white shadow-lg shadow-purple-950/40 ring-1 ring-purple-400/40';
      } else {
        btn.className = 'nsfw-opt-btn p-4 rounded-2xl border text-left transition cursor-pointer flex flex-col justify-between gap-3 bg-white/[0.02] border-white/10 text-slate-400 hover:text-white hover:bg-white/[0.04]';
      }
    });
  }

  // ================= BACKUP & SYNC =================
  exportBackupBtn?.addEventListener('click', () => {
    saveCurrentFormInMemory();
    const backupData = {
      timestamp: new Date().toISOString(),
      version: '2.0',
      activeMaskId: activeChatMaskId,
      masks: masks,
      customCharacters: JSON.parse(localStorage.getItem(STORAGE_KEY_CUSTOM_CHARS) || '[]'),
      nsfwMode: localStorage.getItem(STORAGE_KEY_NSFW) || 'full'
    };

    const blob = new Blob([JSON.stringify(backupData, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `aetheria_backup_${new Date().toISOString().slice(0, 10)}.json`;
    a.click();
    URL.revokeObjectURL(url);
    showToast('Aetheria complete backup exported successfully!');
  });

  importBackupFile?.addEventListener('change', (e) => {
    const file = (e.target as HTMLInputElement).files?.[0];
    if (!file) return;

    const reader = new FileReader();
    reader.onload = (event) => {
      try {
        const data = JSON.parse(event.target?.result as string);
        if (data.masks && Array.isArray(data.masks)) {
          masks = data.masks;
          localStorage.setItem(STORAGE_KEY_PERSONAS, JSON.stringify(masks));
        } else if (data.personas && Array.isArray(data.personas)) {
          masks = data.personas;
          localStorage.setItem(STORAGE_KEY_PERSONAS, JSON.stringify(masks));
        }
        if (data.activeMaskId) {
          activeChatMaskId = data.activeMaskId;
        } else if (masks.length > 0) {
          activeChatMaskId = masks[0].id;
        }
        if (data.customCharacters && Array.isArray(data.customCharacters)) {
          localStorage.setItem(STORAGE_KEY_CUSTOM_CHARS, JSON.stringify(data.customCharacters));
        }
        if (data.nsfwMode) {
          localStorage.setItem(STORAGE_KEY_NSFW, data.nsfwMode);
          updateNsfwButtons(data.nsfwMode);
        }
        saveAllMasksToStorage(false);
        renderMaskPills();
        populateFormWithMask(activeChatMaskId);
        showToast('Backup restored successfully! All data loaded.');
      } catch (err) {
        showToast('Invalid JSON backup file format.');
      }
    };
    reader.readAsText(file);
  });

  clearCacheBtn?.addEventListener('click', async () => {
    const confirmed = await showConfirmModal({
      title: 'Clear Local Storage',
      message: 'Clear all local masks, custom characters, and preferences from this device? Make sure you have exported a backup first.',
      confirmText: 'Clear Everything',
      cancelText: 'Cancel',
      type: 'danger'
    });
    if (confirmed) {
      localStorage.removeItem(STORAGE_KEY_PERSONAS);
      localStorage.removeItem(STORAGE_KEY_ACTIVE);
      localStorage.removeItem(STORAGE_KEY_CUSTOM_CHARS);
      masks = [createBlankMask()];
      activeChatMaskId = masks[0].id;
      currentEditingId = masks[0].id;
      saveAllMasksToStorage(false);
      renderMaskPills();
      populateFormWithMask(currentEditingId);
      showToast('Cache cleared. Fresh blank mask initialized.');
    }
  });

  // Transfer Token
  generateSyncBtn?.addEventListener('click', () => {
    saveCurrentFormInMemory();
    const payload = {
      v: '2',
      masks,
      activeMaskId: activeChatMaskId,
      customChars: JSON.parse(localStorage.getItem(STORAGE_KEY_CUSTOM_CHARS) || '[]')
    };
    try {
      const json = JSON.stringify(payload);
      const b64 = btoa(unescape(encodeURIComponent(json)));
      if (syncTokenBox) syncTokenBox.value = b64;
      copySyncBtn?.classList.remove('hidden');
      showToast('Transfer code generated! Ready to copy.');
    } catch (err: any) {
      showToast('Failed to generate token: ' + err.message);
    }
  });

  copySyncBtn?.addEventListener('click', () => {
    if (syncTokenBox && syncTokenBox.value) {
      navigator.clipboard.writeText(syncTokenBox.value);
      showToast('Transfer code copied to clipboard!');
    }
  });

  applySyncBtn?.addEventListener('click', async () => {
    const raw = syncTokenBox?.value.trim();
    if (!raw) {
      showToast('Please paste a transfer code first.');
      return;
    }
    try {
      const json = decodeURIComponent(escape(atob(raw)));
      const data = JSON.parse(json);
      if (data.masks && Array.isArray(data.masks)) {
        masks = data.masks;
        localStorage.setItem(STORAGE_KEY_PERSONAS, JSON.stringify(masks));
      }
      if (data.activeMaskId) {
        activeChatMaskId = data.activeMaskId;
      }
      if (data.customChars && Array.isArray(data.customChars)) {
        localStorage.setItem(STORAGE_KEY_CUSTOM_CHARS, JSON.stringify(data.customChars));
      }
      saveAllMasksToStorage(false);
      renderMaskPills();
      populateFormWithMask(activeChatMaskId || masks[0].id);
      showToast('Transfer code applied & merged successfully!');
    } catch (err: any) {
      showToast('Invalid transfer code: ' + err.message);
    }
  });

  // Initial Boot
  loadMasksFromStorage();
  initNsfwPreference();
</script>
