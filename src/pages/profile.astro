---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import BottomNav from '../components/BottomNav.astro';
import { 
  User, 
  Sparkles, 
  ShieldCheck, 
  Save, 
  Upload, 
  Download, 
  Trash2, 
  Plus, 
  RotateCcw, 
  Check, 
  Copy, 
  Eye, 
  EyeOff, 
  MessageSquare, 
  ArrowLeft, 
  Camera,
  ExternalLink,
  Cloud,
  CloudUpload,
  CloudDownload,
  ChevronRight,
  Smartphone,
  Laptop,
  RefreshCw,
  Settings,
  Shield,
  Lock,
  Mail,
  LogOut,
  LogIn,
  AlertTriangle,
  UserCheck
} from '@lucide/astro';
---

<Layout title="User Masks & Account Studio — Aetheria AI">
  <Header />

  <main class="flex-1 max-w-5xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10 pb-28 sm:pb-12 space-y-8">
    
    <!-- Top Nav / Breadcrumbs -->
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a 
          href="/" 
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] text-slate-300 hover:text-white text-xs font-medium transition"
        >
          <ArrowLeft class="w-3.5 h-3.5 text-purple-400" />
          <span>Hub</span>
        </a>
        <span class="text-slate-600">/</span>
        <span class="text-xs font-semibold text-purple-300">Identity & Account Studio</span>
      </div>

      <div class="flex items-center gap-2">
        <a 
          href="/library" 
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] text-slate-300 hover:text-white text-xs font-medium transition"
        >
          <MessageSquare class="w-3.5 h-3.5 text-cyan-400" />
          <span class="hidden sm:inline">Library</span>
        </a>
      </div>
    </div>

    <!-- Top Two Main Navigation Tabs (Separating Masks from Official Account) -->
    <div class="flex items-center gap-2 p-1.5 rounded-2xl bg-[#090b17] border border-white/[0.08] w-full max-w-md mx-auto shadow-xl">
      <button 
        id="tab-btn-masks" 
        type="button" 
        class="flex-1 flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl text-xs sm:text-sm font-bold transition cursor-pointer bg-purple-600 text-white shadow-lg shadow-purple-900/40"
      >
        <span>🎭 Roleplay Masks</span>
        <span id="masks-count-badge" class="px-1.5 py-0.5 rounded-md bg-white/20 text-[10px] font-mono">1</span>
      </button>
      <button 
        id="tab-btn-account" 
        type="button" 
        class="flex-1 flex items-center justify-center gap-2 py-2.5 px-4 rounded-xl text-xs sm:text-sm font-bold transition cursor-pointer text-slate-400 hover:text-white hover:bg-white/[0.05]"
      >
        <span>⚙️ Account & Safety</span>
      </button>
    </div>

    <!-- ======================================================== -->
    <!-- TAB 1: ROLEPLAY MASKS & CHAT IDENTITIES                  -->
    <!-- ======================================================== -->
    <section id="tab-view-masks" class="space-y-6">
      
      <!-- Masks Header & Switcher Bar -->
      <div class="p-5 sm:p-6 rounded-3xl bg-gradient-to-b from-purple-950/20 via-[#0a0d1a] to-[#070913] border border-white/[0.08] shadow-xl space-y-4">
        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div>
            <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/20 text-xs font-medium text-purple-300 mb-2">
              <Sparkles class="w-3.5 h-3.5 text-purple-400" />
              <span>Multi-Identity Persona System</span>
            </div>
            <h1 class="text-xl sm:text-2xl font-black text-white tracking-tight">
              Roleplay Masks & Personas
            </h1>
            <p class="text-xs sm:text-sm text-slate-400 mt-1 max-w-2xl leading-relaxed">
              Equip different masks for different stories. Whether you play as a 7-year-old child or a 99-year-old ancient scholar, your active mask strictly commands how characters perceive and treat you.
            </p>
          </div>

          <!-- New Mask CTA Button -->
          <button 
            id="add-mask-btn"
            type="button" 
            class="shrink-0 flex items-center gap-2 px-4 py-2.5 rounded-2xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white text-xs font-bold shadow-lg shadow-purple-900/30 transition cursor-pointer active:scale-95"
          >
            <Plus class="w-4 h-4" />
            <span>Create New Mask</span>
          </button>
        </div>

        <!-- Mask Selector Pills -->
        <div class="pt-2 border-t border-white/[0.06] flex items-center gap-2 overflow-x-auto pb-1" id="mask-pills-container">
          <!-- Rendered dynamically -->
        </div>
      </div>

      <!-- Active Mask Customization Form -->
      <form id="mask-editor-form" class="space-y-6">
        
        <!-- Mask Card: Visual Avatar & Core Identity -->
        <div class="p-6 rounded-3xl bg-[#080a14] border border-white/[0.08] shadow-xl space-y-6">
          
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-white/[0.06] pb-4">
            <div class="flex items-center gap-3">
              <span id="mask-active-status-badge" class="px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 flex items-center gap-1.5">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>Active Mask for Chats</span>
              </span>
              <span class="text-xs text-slate-500 font-mono" id="mask-id-label">ID: default</span>
            </div>

            <!-- Mask Control Actions -->
            <div class="flex items-center gap-2">
              <button 
                type="button" 
                id="activate-mask-btn"
                class="hidden px-3 py-1.5 rounded-xl bg-purple-600/20 hover:bg-purple-600/30 border border-purple-500/40 text-purple-300 text-xs font-semibold transition cursor-pointer"
              >
                Set as Active Mask
              </button>
              <button 
                type="button" 
                id="duplicate-mask-btn"
                class="px-3 py-1.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/10 text-slate-300 hover:text-white text-xs font-semibold transition cursor-pointer"
                title="Duplicate this mask"
              >
                <Copy class="w-3.5 h-3.5 inline mr-1" />
                <span>Duplicate</span>
              </button>
              <button 
                type="button" 
                id="delete-mask-btn"
                class="px-3 py-1.5 rounded-xl bg-rose-950/20 hover:bg-rose-950/40 border border-rose-500/30 text-rose-300 text-xs font-semibold transition cursor-pointer"
                title="Delete this mask"
              >
                <Trash2 class="w-3.5 h-3.5 inline mr-1" />
                <span>Delete</span>
              </button>
            </div>
          </div>

          <!-- Avatar & Primary Attributes Grid -->
          <div class="flex flex-col md:flex-row gap-6 items-start">
            
            <!-- Standard Interactive Circular Avatar (Clean, 1-Click Upload) -->
            <div class="flex flex-col items-center gap-3 shrink-0 mx-auto md:mx-0">
              <input 
                type="file" 
                id="mask-avatar-file-input" 
                accept="image/png, image/jpeg, image/webp, image/gif" 
                class="hidden" 
              />
              
              <!-- Direct Clickable Avatar Circle with Camera Overlay -->
              <div 
                id="mask-avatar-clickable"
                class="group relative w-28 h-28 sm:w-32 sm:h-32 rounded-full overflow-hidden ring-4 ring-purple-500/30 hover:ring-purple-400 bg-[#0c0e17] flex items-center justify-center cursor-pointer transition-all duration-200 shadow-2xl shadow-purple-950/60"
                title="Click to change mask avatar photo"
              >
                <img 
                  id="mask-avatar-img" 
                  src="" 
                  alt="Mask Avatar" 
                  class="w-full h-full object-cover transition group-hover:scale-105 duration-300 hidden" 
                />
                
                <div id="mask-avatar-placeholder" class="w-full h-full flex flex-col items-center justify-center text-purple-400/80 bg-gradient-to-tr from-purple-950/50 via-slate-900 to-indigo-950/40">
                  <User class="w-12 h-12 stroke-[1.5]" />
                  <span class="text-[10px] font-semibold text-purple-300/80 mt-1">Add Photo</span>
                </div>

                <!-- Hover Camera Badge Overlay -->
                <div class="absolute inset-0 bg-black/55 backdrop-blur-[2px] opacity-0 group-hover:opacity-100 flex flex-col items-center justify-center text-white transition-opacity duration-200">
                  <Camera class="w-6 h-6 text-purple-300 mb-1" />
                  <span class="text-[11px] font-bold tracking-wide">Change</span>
                </div>
              </div>

              <!-- Quick Avatar Controls (URL or Remove) -->
              <div class="flex items-center gap-2 text-[11px]">
                <button 
                  type="button" 
                  id="mask-avatar-url-toggle-btn"
                  class="text-purple-400 hover:text-purple-300 transition underline underline-offset-2 cursor-pointer"
                >
                  Image Link
                </button>
                <span class="text-slate-600">•</span>
                <button 
                  type="button" 
                  id="mask-avatar-remove-btn"
                  class="text-rose-400 hover:text-rose-300 transition underline underline-offset-2 cursor-pointer"
                >
                  Remove
                </button>
              </div>

              <!-- Collapsible Direct Image URL Input -->
              <div id="mask-avatar-url-drawer" class="hidden w-64 space-y-1.5 pt-1">
                <input 
                  type="url" 
                  id="mask-avatar-url-input" 
                  placeholder="https://.../avatar.jpg" 
                  class="w-full px-3 py-1.5 rounded-xl bg-white/[0.04] border border-white/10 text-xs text-white placeholder:text-slate-500 outline-none focus:border-purple-500/50"
                />
                <button 
                  type="button" 
                  id="mask-avatar-url-apply-btn"
                  class="w-full py-1 rounded-xl bg-purple-600/30 hover:bg-purple-600/50 border border-purple-500/40 text-purple-200 text-xs font-semibold transition cursor-pointer"
                >
                  Apply Image Link
                </button>
              </div>
            </div>

            <!-- Primary Identity Fields -->
            <div class="flex-1 w-full space-y-4">
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                
                <!-- Mask / Character Name -->
                <div>
                  <label for="mask-name" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">
                    Mask Name / Identity <span class="text-purple-400">*</span>
                  </label>
                  <input 
                    type="text" 
                    id="mask-name" 
                    required 
                    placeholder="e.g. Alex, Lord Thorne, Evelyn..." 
                    class="w-full px-4 py-2.5 rounded-xl bg-white/[0.04] border border-white/10 focus:border-purple-500/70 text-sm font-semibold text-white placeholder:text-slate-500 outline-none transition"
                  />
                  <p class="text-[11px] text-slate-500 mt-1">Replaces <code class="text-cyan-400 font-mono">{"{{user}}"}</code> in all dialogues and character memories.</p>
                </div>

                <!-- Age / Life Stage (Absolute Override Support) -->
                <div>
                  <label for="mask-age" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5 flex items-center justify-between">
                    <span>Age / Life Stage</span>
                    <span class="text-[10px] text-purple-400 font-normal">Strict Card Override</span>
                  </label>
                  <input 
                    type="text" 
                    id="mask-age" 
                    placeholder="e.g. 7 years old, 24 years old, 99 years old, Ancient..." 
                    class="w-full px-4 py-2.5 rounded-xl bg-white/[0.04] border border-white/10 focus:border-purple-500/70 text-sm font-semibold text-white placeholder:text-slate-500 outline-none transition"
                  />
                  <p class="text-[11px] text-slate-500 mt-1">Crucial for roleplays: dictates your physical maturity to the AI.</p>
                </div>

                <!-- Gender & Pronouns -->
                <div>
                  <label for="mask-gender" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">
                    Gender & Pronouns
                  </label>
                  <input 
                    type="text" 
                    id="mask-gender" 
                    placeholder="e.g. Male (He/Him), Female (She/Her), Androgynous..." 
                    class="w-full px-4 py-2.5 rounded-xl bg-white/[0.04] border border-white/10 focus:border-purple-500/70 text-sm text-white placeholder:text-slate-500 outline-none transition"
                  />
                </div>

                <!-- Roleplay Title or Social Status -->
                <div>
                  <label for="mask-title" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5">
                    Title / Occupation
                  </label>
                  <input 
                    type="text" 
                    id="mask-title" 
                    placeholder="e.g. Student, Wandering Knight, Chief Detective, Wizard..." 
                    class="w-full px-4 py-2.5 rounded-xl bg-white/[0.04] border border-white/10 focus:border-purple-500/70 text-sm text-white placeholder:text-slate-500 outline-none transition"
                  />
                </div>

              </div>
            </div>

          </div>

        </div>

        <!-- Roleplay Characteristics & Description -->
        <div class="p-6 rounded-3xl bg-[#080a14] border border-white/[0.08] shadow-xl space-y-5">
          <div class="border-b border-white/[0.06] pb-3">
            <h2 class="text-base font-bold text-white flex items-center gap-2">
              <Eye class="w-4 h-4 text-purple-400" />
              <span>Visual Appearance & Demeanor</span>
            </h2>
            <p class="text-xs text-slate-400 mt-0.5">
              Characters react dynamically to how you look, your height, your clothing, and your mannerisms.
            </p>
          </div>

          <div class="space-y-4">
            <!-- Physical Appearance -->
            <div>
              <label for="mask-appearance" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5 flex items-center justify-between">
                <span>Physical Appearance & Clothing</span>
                <span id="tok-mask-appearance" class="text-[10px] font-mono text-purple-400">~0 tok</span>
              </label>
              <textarea 
                id="mask-appearance" 
                rows="3" 
                placeholder="Describe your visual appearance, height, build, hair style/color, distinctive eyes, scars, and attire...&#10;&#10;Example:&#10;A frail 99-year-old elder with knee-length silver beard and piercing violet eyes. Wears an embroidered velvet trench coat and round brass spectacles." 
                class="w-full px-4 py-3 rounded-2xl bg-white/[0.04] border border-white/10 focus:border-purple-500/70 text-xs sm:text-sm text-white placeholder:text-slate-500 outline-none leading-relaxed resize-y"
              ></textarea>
            </div>

            <!-- Personality & Behavioral Demeanor -->
            <div>
              <label for="mask-personality" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5 flex items-center justify-between">
                <span>Personality & Temperament</span>
                <span id="tok-mask-personality" class="text-[10px] font-mono text-purple-400">~0 tok</span>
              </label>
              <textarea 
                id="mask-personality" 
                rows="3" 
                placeholder="How your character acts, speaks, and responds emotionally...&#10;&#10;Example:&#10;Soft-spoken, grandfatherly and patient. Possesses immense ancient knowledge, but is humble and occasionally chuckles at small ironies." 
                class="w-full px-4 py-3 rounded-2xl bg-white/[0.04] border border-white/10 focus:border-purple-500/70 text-xs sm:text-sm text-white placeholder:text-slate-500 outline-none leading-relaxed resize-y"
              ></textarea>
            </div>
          </div>
        </div>

        <!-- Roleplay Lore, Backstory & System Directives -->
        <div class="p-6 rounded-3xl bg-[#080a14] border border-white/[0.08] shadow-xl space-y-5">
          <div class="border-b border-white/[0.06] pb-3">
            <h2 class="text-base font-bold text-white flex items-center gap-2">
              <ShieldCheck class="w-4 h-4 text-cyan-400" />
              <span>Backstory Lore & Persona Guardrails</span>
            </h2>
            <p class="text-xs text-slate-400 mt-0.5">
              Define your personal history and standing rules that every character must respect.
            </p>
          </div>

          <div class="space-y-4">
            <!-- Backstory / Lore -->
            <div>
              <label for="mask-lore" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5 flex items-center justify-between">
                <span>Background Lore & History</span>
                <span id="tok-mask-lore" class="text-[10px] font-mono text-cyan-400">~0 tok</span>
              </label>
              <textarea 
                id="mask-lore" 
                rows="3" 
                placeholder="Your past experiences, skills, relationships, or origin story in roleplays...&#10;&#10;Example:&#10;Former head curator of the Royal Citadel Archives, who spent six decades cataloging forbidden artifacts before vanishing into the frontier." 
                class="w-full px-4 py-3 rounded-2xl bg-white/[0.04] border border-white/10 focus:border-cyan-500/70 text-xs sm:text-sm text-white placeholder:text-slate-500 outline-none leading-relaxed resize-y"
              ></textarea>
            </div>

            <!-- Global Directives / Formatting Rules -->
            <div>
              <label for="mask-directives" class="block text-xs font-bold text-slate-300 uppercase tracking-wider mb-1.5 flex items-center justify-between">
                <span>Roleplay Rules & Immersion Guardrails</span>
                <span id="tok-mask-directives" class="text-[10px] font-mono text-cyan-400">~0 tok</span>
              </label>
              <textarea 
                id="mask-directives" 
                rows="3" 
                placeholder="Rules injected for all characters...&#10;&#10;Example:&#10;Never speak, narrate thoughts, or choose actions for &#123;&#123;user&#125;&#125;. Maintain atmospheric immersion. Format sensory actions in *asterisks* and spoken dialogue in quotes." 
                class="w-full px-4 py-3 rounded-2xl bg-white/[0.04] border border-white/10 focus:border-cyan-500/70 text-xs sm:text-sm text-white placeholder:text-slate-500 outline-none leading-relaxed resize-y"
              ></textarea>
            </div>
          </div>
        </div>

        <!-- Strict Card Override Callout Banner -->
        <div class="p-4 rounded-2xl bg-purple-950/20 border border-purple-500/30 flex items-start gap-3">
          <Shield class="w-5 h-5 text-purple-400 shrink-0 mt-0.5" />
          <div class="text-xs leading-relaxed text-slate-300">
            <strong class="text-purple-300 font-bold block mb-0.5">Absolute Identity Override Guarantee:</strong>
            When this mask is active, its <strong class="text-white">Age</strong>, <strong class="text-white">Appearance</strong>, and <strong class="text-white">Traits</strong> are forcefully enforced in system prompts with strict priority over any conflicting character scenario or greeting. If a card assumes you are a child but your mask says 99 years old, the AI will strictly treat you as 99 years old.
          </div>
        </div>

        <!-- Bottom Sticky Save Bar -->
        <div class="sticky bottom-4 z-40 p-4 rounded-3xl bg-[#090b17]/95 backdrop-blur-2xl border border-white/10 shadow-2xl flex items-center justify-between gap-3">
          <div class="flex items-center gap-2 text-xs text-slate-400">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span id="save-status-indicator">Changes ready to save</span>
          </div>

          <div class="flex items-center gap-2.5">
            <button 
              type="button" 
              id="reset-mask-btn"
              class="px-4 py-2.5 rounded-2xl bg-white/[0.05] hover:bg-white/[0.1] border border-white/10 text-xs font-semibold text-slate-300 hover:text-white transition cursor-pointer"
            >
              Reset Mask
            </button>

            <button 
              type="submit" 
              id="save-mask-btn"
              class="px-6 py-2.5 rounded-2xl bg-gradient-to-r from-purple-600 via-indigo-600 to-purple-600 hover:from-purple-500 hover:to-indigo-500 text-xs sm:text-sm font-bold text-white shadow-lg shadow-purple-900/50 flex items-center justify-center gap-2 transition cursor-pointer active:scale-95"
            >
              <Save class="w-4 h-4" />
              <span>Save & Apply Mask</span>
            </button>
          </div>
        </div>

      </form>

    </section>

    <!-- ======================================================== -->
    <!-- TAB 2: ACCOUNT, SAFETY & DATA PREFERENCES                -->
    <!-- ======================================================== -->
    <section id="tab-view-account" class="space-y-6 hidden">
      
      <!-- Account Info & Cloud Status -->
      <div class="p-6 rounded-3xl bg-[#080a14] border border-white/[0.08] shadow-xl space-y-6">
        <div class="border-b border-white/[0.06] pb-3 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <UserCheck class="w-5 h-5 text-purple-400" />
            <h2 class="text-base sm:text-lg font-bold text-white">1. Official Platform Account</h2>
          </div>
          <span id="auth-status-pill" class="text-xs px-2.5 py-0.5 rounded-full bg-white/[0.06] border border-white/10 text-slate-300 font-mono">
            Checking...
          </span>
        </div>

        <!-- Auth State Card -->
        <div id="auth-user-card" class="p-4 sm:p-5 rounded-2xl bg-white/[0.02] border border-white/[0.06] flex flex-col sm:flex-row sm:items-center justify-between gap-4">
          <div class="flex items-center gap-3.5">
            <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-purple-600 to-indigo-600 flex items-center justify-center text-white text-base font-bold shadow-md shadow-purple-950/50 overflow-hidden" id="account-avatar-wrapper">
              <span id="account-avatar-letter">A</span>
            </div>
            <div>
              <h3 id="account-display-name" class="text-sm font-bold text-white">Guest User</h3>
              <p id="account-email" class="text-xs text-slate-400">Local Browser Session</p>
            </div>
          </div>

          <div class="flex items-center gap-2" id="account-action-buttons">
            <a 
              href="/auth" 
              id="account-login-link"
              class="px-4 py-2 rounded-xl bg-purple-600 hover:bg-purple-500 text-white text-xs font-bold transition shadow-sm"
            >
              Sign In / Register
            </a>
            <button 
              type="button" 
              id="account-logout-btn"
              class="hidden px-4 py-2 rounded-xl bg-rose-950/20 hover:bg-rose-950/40 border border-rose-500/30 text-rose-300 text-xs font-semibold transition cursor-pointer"
            >
              Log Out
            </button>
          </div>
        </div>
      </div>

      <!-- Content Safety & NSFW Filters -->
      <div class="p-6 rounded-3xl bg-[#080a14] border border-white/[0.08] shadow-xl space-y-6">
        <div class="border-b border-white/[0.06] pb-3 flex items-center justify-between">
          <div class="flex items-center gap-2">
            <Shield class="w-5 h-5 text-amber-400" />
            <h2 class="text-base sm:text-lg font-bold text-white">2. Content Safety & NSFW Filter</h2>
          </div>
          <span class="text-xs text-slate-400">Applies across Discovery & Chats</span>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-3 gap-3" id="nsfw-filter-selector">
          
          <!-- Option 1: Uncensored / Full -->
          <button 
            type="button" 
            data-nsfw="full"
            class="nsfw-opt-btn p-4 rounded-2xl border text-left transition cursor-pointer flex flex-col justify-between gap-3 bg-purple-600/10 border-purple-500/50 text-white"
          >
            <div class="flex items-center justify-between">
              <span class="text-lg">🔞</span>
              <span class="text-[10px] px-2 py-0.5 rounded-full bg-purple-500/20 text-purple-300 font-mono">Uncensored</span>
            </div>
            <div>
              <h4 class="text-xs font-bold text-white">Show Uncensored</h4>
              <p class="text-[11px] text-slate-400 mt-0.5">Display all spicy and mature character cards and unrestricted themes.</p>
            </div>
          </button>

          <!-- Option 2: Blur Sensitive -->
          <button 
            type="button" 
            data-nsfw="blur"
