      if (p.age && p.age.trim()) demographicParts.push(escapeHtml(p.age.trim()));
      if (p.pronouns && p.pronouns.trim()) demographicParts.push(escapeHtml(p.pronouns.trim()).toLowerCase());
      const demographicText = demographicParts.join(' • ');

      const rawPronouns = (p.pronouns || '').trim();
      const lowerPronouns = rawPronouns.toLowerCase();
      const isHe = lowerPronouns === 'he/him';
      const isShe = lowerPronouns === 'she/her';
      const isThey = lowerPronouns === 'they/them';
