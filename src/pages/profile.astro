              <!-- 1. Top Pill Badge -->
              <div class="w-full py-2 px-3 rounded-full flex items-center justify-center font-bold text-xs sm:text-sm tracking-tight shadow-md transition-transform group-hover:scale-[1.02]" style="background: ${p.pillGradient}; color: ${p.pillTextColor};">
                ${p.name}
              </div>

              <!-- 2. Central Vector Hero Icon -->
              <div class="my-auto py-1 flex items-center justify-center transition-transform duration-300 group-hover:scale-110">
                ${svgIcon}
              </div>

              <!-- 3. Headline / Tagline Text -->
              <div class="text-center px-1 mb-2">
                <div class="text-xs sm:text-[13px] font-normal text-[#E1E3E8] leading-tight whitespace-pre-line opacity-90">
