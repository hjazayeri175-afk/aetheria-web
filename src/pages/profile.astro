          const isSelected = btnMode === mode;
          btn.setAttribute('aria-pressed', isSelected ? 'true' : 'false');
          if (isSelected) {
            if (mode === 'day') {
              btn.className = 'profile-mode-btn flex items-center justify-center gap-1.5 py-2 px-2 rounded-lg text-xs font-bold bg-amber-500/20 text-amber-300 border border-amber-500/40 shadow-xs transition cursor-pointer';
            } else if (mode === 'oled') {
              btn.className = 'profile-mode-btn flex items-center justify-center gap-1.5 py-2 px-2 rounded-lg text-xs font-bold bg-emerald-500/20 text-emerald-400 border border-emerald-500/40 shadow-xs transition cursor-pointer';
            } else {
              btn.className = 'profile-mode-btn flex items-center justify-center gap-1.5 py-2 px-2 rounded-lg text-xs font-bold bg-purple-600/30 text-purple-200 border border-purple-500/40 shadow-xs transition cursor-pointer';
            }
          } else {
            btn.className = 'profile-mode-btn flex items-center justify-center gap-1.5 py-2 px-2 rounded-lg text-xs font-medium text-slate-400 hover:text-white hover:bg-white/5 border border-transparent transition cursor-pointer';
          }
