                <!-- Left/Incoming Chat Bubble -->
                <div class="self-start max-w-[80%] rounded-xl px-2.5 py-1.5 shadow-xs relative z-10" style="background: ${p.charBubbleBg}; border: 1px solid rgba(255,255,255,0.12);">
                  <div class="h-1.5 w-14 rounded-full mb-1" style="background: ${accentColor}99;"></div>
                  <div class="h-1.5 w-8 rounded-full" style="background: rgba(255,255,255,0.25);"></div>
