  function update3DCardTransforms() {
    const cards = document.querySelectorAll<HTMLElement>('.persona-3d-card');
    const totalSlides = personas.length + 1;

    const ps = (window as any).AetheriaPowerSaving;
    const is3DDisabled = Boolean(ps?.getSettings().disable3D || ps?.getSettings().master);

    cards.forEach((card) => {
      const idx = parseInt(card.getAttribute('data-index') || '0', 10);
      const offset = idx - activeCardIndex;

      let transformStr = '';
      let zIndex = 1;
      let opacity = 0;
      let pointerEvents = 'none';
      let filterStr = 'none';

      if (is3DDisabled) {
        // Flat 2D Mode (Power Saving - Zero rotateY / perspective overhead)
        if (offset === 0) {
          transformStr = 'translate3d(0, 0, 0) scale(1)';
          zIndex = 20;
          opacity = 1;
          pointerEvents = 'auto';
        } else if (offset === 1) {
          transformStr = 'translate3d(62%, 0, 0) scale(0.88)';
          zIndex = 10;
          opacity = 0.55;
          pointerEvents = 'auto';
        } else if (offset === -1) {
          transformStr = 'translate3d(-62%, 0, 0) scale(0.88)';
          zIndex = 10;
          opacity = 0.55;
          pointerEvents = 'auto';
        } else if (offset > 1) {
          transformStr = `translate3d(${62 + (offset - 1) * 35}%, 0, 0) scale(0.7)`;
          zIndex = Math.max(1, 10 - offset);
          opacity = 0;
          pointerEvents = 'none';
        } else if (offset < -1) {
          transformStr = `translate3d(${-62 + (offset + 1) * 35}%, 0, 0) scale(0.7)`;
          zIndex = Math.max(1, 10 + offset);
          opacity = 0;
          pointerEvents = 'none';
        }
        filterStr = 'none';
      } else {
        // Full 3D Coverflow Perspective Mode
        if (offset === 0) {
          transformStr = 'translate3d(0, 0, 0) scale(1) rotateY(0deg)';
          zIndex = 20;
          opacity = 1;
          pointerEvents = 'auto';
          filterStr = 'drop-shadow(0 20px 25px rgba(0,0,0,0.7))';
        } else if (offset === 1) {
          transformStr = 'translate3d(58%, 0, -120px) scale(0.85) rotateY(-24deg)';
          zIndex = 10;
          opacity = 0.55;
          pointerEvents = 'auto';
          filterStr = 'drop-shadow(0 15px 20px rgba(0,0,0,0.5)) blur(0.4px)';
        } else if (offset === -1) {
          transformStr = 'translate3d(-58%, 0, -120px) scale(0.85) rotateY(24deg)';
          zIndex = 10;
          opacity = 0.55;
          pointerEvents = 'auto';
          filterStr = 'drop-shadow(0 15px 20px rgba(0,0,0,0.5)) blur(0.4px)';
        } else if (offset > 1) {
          transformStr = `translate3d(${58 + (offset - 1) * 35}%, 0, -240px) scale(0.7) rotateY(-32deg)`;
          zIndex = Math.max(1, 10 - offset);
          opacity = 0;
          pointerEvents = 'none';
        } else if (offset < -1) {
          transformStr = `translate3d(${-58 + (offset + 1) * 35}%, 0, -240px) scale(0.7) rotateY(32deg)`;
          zIndex = Math.max(1, 10 + offset);
          opacity = 0;
          pointerEvents = 'none';
        }
      }

      card.style.transform = transformStr;
      card.style.zIndex = String(zIndex);
      card.style.opacity = String(opacity);
      card.style.pointerEvents = pointerEvents;
      card.style.filter = filterStr;
    });

    const pageIndicator = document.getElementById('carousel-page-indicator');
    if (pageIndicator) {
      pageIndicator.textContent = `${activeCardIndex + 1} / ${totalSlides}`;
    }

    const badge = document.getElementById('personas-count-badge');
    if (badge) {
      badge.textContent = `${personas.length} ${personas.length === 1 ? 'Persona' : 'Personas'}`;
    }

    renderDots();
  }

  function renderDots() {
    const container = document.getElementById('carousel-dots');
    if (!container) return;
    const totalSlides = personas.length + 1;

    let dotsHtml = '';
    for (let i = 0; i < totalSlides; i++) {
      const isCur = i === activeCardIndex;
      const isNew = i === personas.length;
      dotsHtml += `
        <button 
          type="button" 
          class="carousel-dot h-2 rounded-full transition-all duration-300 cursor-pointer ${
            isCur 
              ? 'w-6 bg-[var(--theme-accent,#9333ea)] shadow-[0_0_12px_var(--theme-accent-glow,rgba(147,51,234,0.6))]' 
              : isNew 
              ? 'w-2 bg-purple-500/30 hover:bg-purple-500/60' 
              : 'w-2 bg-stone-700 hover:bg-stone-500'
          }" 
          data-index="${i}" 
          title="${isNew ? 'New Persona' : 'Persona ' + (i + 1)}"
        ></button>
      `;
    }
    container.innerHTML = dotsHtml;

    container.querySelectorAll('.carousel-dot').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const idx = parseInt(btn.getAttribute('data-index') || '0', 10);
        goToCard(idx);
      });
    });
  }

  function goToCard(index: number) {
    const totalSlides = personas.length + 1;
    const target = Math.max(0, Math.min(index, totalSlides - 1));
    if (target !== activeCardIndex) {
      activeCardIndex = target;
      update3DCardTransforms();
    }
  }

  function flipCard(personaId: string, isEditing: boolean) {
    flippedCards[personaId] = isEditing;
    const cardEl = document.querySelector(`.persona-3d-card[data-id="${personaId}"]`);
    if (!cardEl) return;
    const innerEl = cardEl.querySelector('.persona-card-inner') as HTMLElement;
    if (!innerEl) return;

    const controlsBar = document.getElementById('carousel-controls-bar');

    if (isEditing) {
      innerEl.classList.add('rotate-y-180');
      if (controlsBar) controlsBar.classList.add('hidden');
      setTimeout(() => {
        const nameInput = cardEl.querySelector('.card-edit-name') as HTMLInputElement;
        if (nameInput && !nameInput.value) nameInput.focus();
      }, 300);
    } else {
      innerEl.classList.remove('rotate-y-180');
      const anyEditing = Object.values(flippedCards).some(Boolean);
      if (!anyEditing && controlsBar) {
        controlsBar.classList.remove('hidden');
      }
    }
  }

  function setActivePersona(personaId: string) {
    personas.forEach(p => {
      p.isActive = (p.id === personaId);
      p.isDefault = p.isActive;
    });
    savePersonas();
    render3DCarousel();
    const active = personas.find(p => p.id === personaId);
    showToast(`Active persona: ${active?.name || 'Persona'}`, 'success');
  }

  function createNewPersona() {
    const newP = normalizePersona({
      id: 'p_' + Date.now(),
      name: '',
      age: '',
      pronouns: '',
      avatar: '',
      about: '',
      additionalInstructions: '',
      isActive: true
    }, personas.length);

    personas.forEach(p => { p.isActive = false; p.isDefault = false; });
    personas.push(newP);

    activeCardIndex = personas.length - 1;
    flippedCards[newP.id] = true;

    savePersonas();
    render3DCarousel();

    setTimeout(() => {
      const cardEl = document.querySelector(`.persona-3d-card[data-id="${newP.id}"]`);
      const nameInput = cardEl?.querySelector('.card-edit-name') as HTMLInputElement;
      nameInput?.focus();
    }, 350);

    showToast('New persona created — fill in details', 'info');
  }

  function saveCardForm(personaId: string) {
    const p = personas.find(x => x.id === personaId);
    if (!p) return;

    const cardEl = document.querySelector(`.persona-3d-card[data-id="${personaId}"]`);
    if (!cardEl) return;

    const nameInput = cardEl.querySelector('.card-edit-name') as HTMLInputElement;
    const ageInput = cardEl.querySelector('.card-edit-age') as HTMLInputElement;
    const pronounsHidden = cardEl.querySelector('.card-edit-pronouns-value') as HTMLInputElement;
    const aboutTextarea = cardEl.querySelector('.card-edit-about') as HTMLTextAreaElement;
    const directivesTextarea = cardEl.querySelector('.card-edit-directives') as HTMLTextAreaElement;
    const activeToggle = cardEl.querySelector('.card-edit-active-toggle') as HTMLInputElement;

    p.name = nameInput?.value.trim() || '';
    p.age = ageInput?.value.trim() || '';
    p.pronouns = pronounsHidden?.value.trim() || '';
    p.about = aboutTextarea?.value.trim() || '';
    p.additionalInstructions = directivesTextarea?.value.trim() || '';

    if (activeToggle?.checked) {
      personas.forEach(x => { x.isActive = (x.id === personaId); x.isDefault = x.isActive; });
    }

    p.tokenCount = estimateTokens((p.about || '') + ' ' + (p.additionalInstructions || ''));

    savePersonas();
    flipCard(personaId, false);
    setTimeout(() => {
      render3DCarousel();
    }, 300);
    showToast('Persona saved! ✨', 'success');
  }

  async function deleteCardPersona(personaId: string) {
    if (personas.length <= 1) {
      showToast('You must keep at least one persona profile', 'warning');
      return;
    }
    const p = personas.find(x => x.id === personaId);
    const ok = await showConfirm('Delete Persona', `Are you sure you want to delete "${p?.name || 'this persona'}"?`);
    if (!ok) return;

    personas = personas.filter(x => x.id !== personaId);
    if (!personas.some(x => x.isActive)) {
      personas[0].isActive = true;
      personas[0].isDefault = true;
    }

    activeCardIndex = Math.min(activeCardIndex, personas.length - 1);
    savePersonas();
    render3DCarousel();
    showToast('Persona deleted', 'info');
  }

  async function handleAiGenerate(personaId: string, btn: HTMLButtonElement) {
    const cardEl = document.querySelector(`.persona-3d-card[data-id="${personaId}"]`);
    if (!cardEl) return;

    const nameInput = cardEl.querySelector('.card-edit-name') as HTMLInputElement;
    const ageInput = cardEl.querySelector('.card-edit-age') as HTMLInputElement;
    const pronounsHidden = cardEl.querySelector('.card-edit-pronouns-value') as HTMLInputElement;
    const aboutTextarea = cardEl.querySelector('.card-edit-about') as HTMLTextAreaElement;

    const nameVal = nameInput?.value.trim() || 'Roleplayer';
    const ageVal = ageInput?.value.trim() || '';
    const pronounsVal = pronounsHidden?.value.trim() || '';
    const currentPrompt = aboutTextarea?.value.trim() || '';

    const originalContent = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = `<span class="animate-spin inline-block w-2.5 h-2.5 border-2 border-stone-950 border-t-transparent rounded-full mr-1"></span><span>Writing...</span>`;

    try {
      const res = await fetch('/api/enhance-persona', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          name: nameVal,
          age: ageVal,
          pronouns: pronounsVal,
          prompt: currentPrompt
        })
      });

      const data = await res.json().catch(() => ({}));
      if (data && data.ok && data.enhanced) {
        if (aboutTextarea) {
          aboutTextarea.value = data.enhanced;
          aboutTextarea.dispatchEvent(new Event('input'));
        }
        showToast('AI Persona description enhanced! ✨', 'success');
      } else {
        throw new Error('Enhance failed');
      }
    } catch (err) {
      console.warn('AI enhancement fallback:', err);
      if (aboutTextarea) {
        const fallback = `I am ${nameVal}, carrying a poised and watchful presence. Behind my measured words lies an adventurous spirit, always searching for the next revelation.`;
        aboutTextarea.value = fallback;
        aboutTextarea.dispatchEvent(new Event('input'));
        showToast('Generated description from local template ✨', 'info');
      }
    } finally {
      btn.disabled = false;
      btn.innerHTML = originalContent;
    }
  }

  function setupPronounPillSelector(cardEl: HTMLElement) {
    const container = cardEl.querySelector('.pronouns-pill-selector') as HTMLElement;
    if (!container) return;

    const hiddenInput = container.querySelector('.card-edit-pronouns-value') as HTMLInputElement;
    const pillsBar = container.querySelector('.pronouns-pills-bar') as HTMLElement;
    const customBar = container.querySelector('.pronouns-custom-bar') as HTMLElement;
    const customInput = container.querySelector('.pronouns-custom-input') as HTMLInputElement;
    const customClearBtn = container.querySelector('.pronouns-custom-clear') as HTMLButtonElement;
    const customTriggerBtn = container.querySelector('.pronoun-pill-custom-trigger') as HTMLButtonElement;
    const pillBtns = container.querySelectorAll('.pronoun-pill-btn') as NodeListOf<HTMLButtonElement>;

    const activeClass = 'bg-purple-600 text-white font-semibold rounded-lg shadow-[0_0_10px_var(--theme-accent-glow,rgba(147,51,234,0.4))] transition-all duration-200 text-xs flex-1 py-1.5 text-center cursor-pointer select-none whitespace-nowrap';
    const inactiveClass = 'text-gray-400 hover:text-white text-xs flex-1 py-1.5 text-center transition-colors cursor-pointer select-none rounded-lg hover:bg-white/5 whitespace-nowrap';

    // Step 4: Gesture Isolation - prevent touch & pointer events from triggering parent 3D Card Carousel swipe/flip
    ['pointerdown', 'touchstart', 'touchend', 'touchmove', 'mousedown'].forEach(evt => {
      container.addEventListener(evt, (e) => e.stopPropagation());
    });

    // Step 2: Pill Options click handlers (He, She, They)
    pillBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const val = btn.dataset.val || '';
        const currentVal = (hiddenInput?.value || '').trim().toLowerCase();

        if (currentVal === val.toLowerCase()) {
          // Deselect if already active -> reset to ''
          if (hiddenInput) hiddenInput.value = '';
          btn.className = `pronoun-pill-btn ${inactiveClass}`;
        } else {
          // Select clicked pill
          if (hiddenInput) hiddenInput.value = val;
          pillBtns.forEach(b => {
            b.className = `pronoun-pill-btn ${inactiveClass}`;
          });
          btn.className = `pronoun-pill-btn ${activeClass}`;
        }
      });
    });

    // Step 3: Switch into Custom Input Mode (✎)
    customTriggerBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      pillsBar.classList.add('hidden');
      pillsBar.classList.remove('flex');
      customBar.classList.remove('hidden');
      customBar.classList.add('flex');
      if (customInput) {
        const cur = (hiddenInput?.value || '').trim();
        const isPreset = ['he/him', 'she/her', 'they/them'].includes(cur.toLowerCase());
        customInput.value = isPreset ? '' : cur;
        customInput.focus();
      }
    });

    // Custom input typing
    customInput?.addEventListener('input', (e) => {
      e.stopPropagation();
      if (hiddenInput) {
        hiddenInput.value = customInput.value.trim();
      }
    });

    customInput?.addEventListener('keydown', (e) => {
      e.stopPropagation();
      if (e.key === 'Enter') {
        e.preventDefault();
        customInput.blur();
      }
    });

    // Custom clear button (×) - clears custom text and returns to 4-pill view
    customClearBtn?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (customInput) customInput.value = '';
      if (hiddenInput) hiddenInput.value = '';

      pillBtns.forEach(b => {
        b.className = `pronoun-pill-btn ${inactiveClass}`;
      });

      customBar.classList.add('hidden');
      customBar.classList.remove('flex');
      pillsBar.classList.remove('hidden');
      pillsBar.classList.add('flex');
    });
  }

  function setupTokenCounter(cardEl: HTMLElement) {
    const aboutTextarea = cardEl.querySelector('.card-edit-about') as HTMLTextAreaElement;
    const directivesTextarea = cardEl.querySelector('.card-edit-directives') as HTMLTextAreaElement;
    const tokenPill = cardEl.querySelector('.live-token-pill') as HTMLElement;
    if (!tokenPill) return;

    function updateTokens() {
      const text = (aboutTextarea?.value || '') + ' ' + (directivesTextarea?.value || '');
      const tokens = estimateTokens(text);

      tokenPill.textContent = `${tokens} tokens / 500`;

      if (tokens > 500) {
        tokenPill.className = 'live-token-pill px-2.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-red-950/60 text-red-300 border border-red-500/60 shadow-[0_0_10px_rgba(239,68,68,0.5)] animate-pulse';
      } else {
        tokenPill.className = 'live-token-pill px-2.5 py-0.5 rounded-full text-[10px] font-mono bg-purple-950/60 border border-purple-500/40 text-purple-300 font-medium';
      }
    }

    aboutTextarea?.addEventListener('input', updateTokens);
    directivesTextarea?.addEventListener('input', updateTokens);
    updateTokens();
  }

  function triggerAvatarUpload(personaId: string) {
    targetAvatarUploadPersonaId = personaId;
    const fileInput = document.getElementById('avatar-file-input') as HTMLInputElement;
    if (fileInput) {
      fileInput.value = '';
      fileInput.click();
    }
  }

  function attachCardListeners() {
    const cards = document.querySelectorAll<HTMLElement>('.persona-3d-card');
    cards.forEach(card => {
      const idx = parseInt(card.getAttribute('data-index') || '0', 10);
      const isNewTrigger = card.getAttribute('data-trigger-new') === 'true';
      const personaId = card.getAttribute('data-id') || '';

      // Sibling click brings to center
      card.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        if (target.closest('button, input, textarea, a, details, label')) return;

        if (isNewTrigger) {
          if (idx === activeCardIndex) {
            createNewPersona();
          } else {
            goToCard(idx);
          }
          return;
        }

        if (idx !== activeCardIndex) {
          goToCard(idx);
        }
      });

      if (isNewTrigger) {
        card.querySelector('span')?.addEventListener('click', (e) => {
          e.stopPropagation();
          createNewPersona();
        });
        return;
      }

      // Flip to edit buttons
      card.querySelectorAll('.btn-trigger-flip-edit').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          goToCard(idx);
          flipCard(personaId, true);
        });
      });

      // Flip back to viewer buttons
      card.querySelectorAll('.btn-trigger-flip-back').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          flipCard(personaId, false);
        });
      });

      // Quick activate
      card.querySelectorAll('.btn-card-activate').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          setActivePersona(personaId);
        });
      });

      // Avatar upload triggers
      card.querySelectorAll('.avatar-click-target, .btn-trigger-upload').forEach(el => {
        el.addEventListener('click', (e) => {
          e.stopPropagation();
          triggerAvatarUpload(personaId);
        });
      });

      // Remove avatar button
      card.querySelector('.btn-remove-avatar-target')?.addEventListener('click', (e) => {
        e.stopPropagation();
        const p = personas.find(x => x.id === personaId);
        if (p) {
          p.avatar = '';
          savePersonas();
          render3DCarousel();
          showToast('Photo removed', 'info');
        }
      });

      // AI Generate
      card.querySelector('.btn-ai-generate')?.addEventListener('click', (e) => {
        e.stopPropagation();
        handleAiGenerate(personaId, e.currentTarget as HTMLButtonElement);
      });

      // Pronoun segmented pill selector
      setupPronounPillSelector(card);

      // Live token counter
      setupTokenCounter(card);

      // Save persona
      card.querySelector('.btn-card-save')?.addEventListener('click', (e) => {
        e.stopPropagation();
        saveCardForm(personaId);
      });

      // Bind persona to chat
      card.querySelector('.btn-card-bind')?.addEventListener('click', (e) => {
        e.stopPropagation();
        handleBindToChat(personaId);
      });

      // Delete persona
      card.querySelectorAll('.btn-card-delete').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          deleteCardPersona(personaId);
        });
      });
    });
  }

  function handleBindToChat(personaId: string) {
    const p = personas.find(x => x.id === personaId);
    if (!p) return;

    const currentBindings = (p.boundChatIds || []).join(', ');
    const promptText = `Bind "${p.name || 'Persona'}" to specific character chats.\n\nCurrent bound chats: ${currentBindings || 'All chats (Unrestricted)'}\n\nEnter comma-separated Character IDs to lock to specific chats, or leave empty for All Chats:`;

    const input = window.prompt(promptText, currentBindings);
    if (input === null) return; // User cancelled

    const trimmed = input.trim();
    if (!trimmed) {
      p.boundChatIds = [];
      showToast(`"${p.name}" active in ALL chats`, 'info');
    } else {
      p.boundChatIds = trimmed.split(',').map(s => s.trim()).filter(Boolean);
      showToast(`Bound to ${p.boundChatIds.length} chat(s)`, 'success');
    }

    savePersonas();
    render3DCarousel();
  }

  function setupGestures() {
    const stage = document.getElementById('persona-carousel-stage');
    if (!stage) return;

    let startX = 0;
    let startY = 0;
    let isDown = false;

    stage.addEventListener('touchstart', (e) => {
      startX = e.touches[0].clientX;
      startY = e.touches[0].clientY;
      isDown = true;
    }, { passive: true });

    stage.addEventListener('touchend', (e) => {
      if (!isDown) return;
      isDown = false;
      const endX = e.changedTouches[0].clientX;
      const endY = e.changedTouches[0].clientY;
      const diffX = endX - startX;
      const diffY = endY - startY;

      if (Math.abs(diffX) > 40 && Math.abs(diffX) > Math.abs(diffY)) {
        if (diffX < 0) {
          goToCard(activeCardIndex + 1);
        } else {
          goToCard(activeCardIndex - 1);
        }
      }
    }, { passive: true });

    // Desktop mouse drag
    let mouseStartX = 0;
    let isMouseDown = false;

    stage.addEventListener('mousedown', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('input, textarea, button, select, label, details')) return;
      isMouseDown = true;
      mouseStartX = e.clientX;
    });

    window.addEventListener('mouseup', (e) => {
      if (!isMouseDown) return;
      isMouseDown = false;
      const diffX = e.clientX - mouseStartX;
      if (Math.abs(diffX) > 45) {
        if (diffX < 0) {
          goToCard(activeCardIndex + 1);
        } else {
          goToCard(activeCardIndex - 1);
        }
      }
    });

    // Keyboard navigation
    window.addEventListener('keydown', (e) => {
      const personasView = document.getElementById('view-personas');
      if (!personasView || personasView.classList.contains('hidden')) return;
      const activeEl = document.activeElement;
      if (activeEl && (activeEl.tagName === 'INPUT' || activeEl.tagName === 'TEXTAREA')) return;

      if (e.key === 'ArrowRight') {
        goToCard(activeCardIndex + 1);
      } else if (e.key === 'ArrowLeft') {
        goToCard(activeCardIndex - 1);
      }
    });

    // Prev / Next button listeners
    document.getElementById('carousel-btn-prev')?.addEventListener('click', () => {
      goToCard(activeCardIndex - 1);
    });
    document.getElementById('carousel-btn-next')?.addEventListener('click', () => {
      goToCard(activeCardIndex + 1);
    });
  }

  // File input change listener for Base64 image
  const globalAvatarFileInput = document.getElementById('avatar-file-input') as HTMLInputElement;
  globalAvatarFileInput?.addEventListener('change', () => {
    const file = globalAvatarFileInput.files?.[0];
    if (!file || !targetAvatarUploadPersonaId) return;

    if (file.size > 4 * 1024 * 1024) {
      showToast('Image size exceeds 4MB limit', 'warning');
      return;
    }

    const reader = new FileReader();
    reader.onload = (e) => {
      const base64 = e.target?.result as string;
      const p = personas.find(x => x.id === targetAvatarUploadPersonaId);
      if (p) {
        p.avatar = base64;
        savePersonas();
        render3DCarousel();
        showToast('Avatar photo updated', 'success');
      }
    };
    reader.readAsDataURL(file);
  });

  // Setup Event Handlers
  document.addEventListener('DOMContentLoaded', () => {
    loadPersonas();
    render3DCarousel();
    setupGestures();
    updateHubProfileSummary();

    // ==========================================
    // Telegram-Style View Switcher (SPA Hub)
    // ==========================================
    function showView(targetId: string) {
      const views = ['view-hub', 'view-personas', 'view-appearance', 'view-ai-engine', 'view-voice', 'view-privacy', 'view-devices', 'view-power-saving'];
      views.forEach(id => {
        const el = document.getElementById(id);
        if (!el) return;
        if (id === targetId) {
          el.classList.remove('hidden');
          window.scrollTo({ top: 0, behavior: 'instant' });
          if (id === 'view-personas') {
            render3DCarousel();
          } else if (id === 'view-power-saving') {
            syncPowerSavingUI();
          }
        } else {
          el.classList.add('hidden');
        }
      });

      const hashMap: Record<string, string> = {
        'view-hub': '',
        'view-personas': '#personas',
        'view-appearance': '#appearance',
        'view-ai-engine': '#ai-engine',
        'view-voice': '#voice',
        'view-privacy': '#privacy',
        'view-devices': '#devices',
        'view-power-saving': '#power'
      };
      const targetHash = hashMap[targetId] || '';
      if (window.location.hash !== targetHash) {
        history.pushState(null, '', window.location.pathname + targetHash);
      }
    }

    function syncFromHash() {
      const h = window.location.hash;
      if (h === '#personas') showView('view-personas');
      else if (h === '#appearance' || h === '#chat-settings') showView('view-appearance');
      else if (h === '#ai-engine') showView('view-ai-engine');
      else if (h === '#voice') showView('view-voice');
      else if (h === '#privacy' || h === '#data') showView('view-privacy');
      else if (h === '#devices' || h === '#security') {
        showView('view-devices');
        loadDevicesAndSecurity();
      }
      else if (h === '#power' || h === '#power-saving' || h === '#performance') {
        showView('view-power-saving');
        syncPowerSavingUI();
      }
      else showView('view-hub');
    }

    window.addEventListener('popstate', syncFromHash);
    syncFromHash();

