    async function updateSecuritySettings() {
      const tLogin = document.getElementById('toggle-new-login-alert') as HTMLInputElement;
      const tAnomaly = document.getElementById('toggle-ip-anomaly-shield') as HTMLInputElement;
      const alertNewLogin = tLogin ? tLogin.checked : true;
