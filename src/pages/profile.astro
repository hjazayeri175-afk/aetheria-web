<script>
  import { resolveFriendlyDeviceName, maskIp } from '../utils/deviceModelMap';

  function renderBadgeHtml(icon: string, customClass = 'w-4 h-4 inline-block object-contain align-middle ml-1 shrink-0') {
    if (!icon) return '';
    if (icon.startsWith('http://') || icon.startsWith('https://') || icon.startsWith('/')) {
      return `<img src="${icon}" class="${customClass}" alt="Badge" loading="lazy" />`;
    }
    return `<span class="inline-block select-none text-xs ml-1" style="-webkit-text-fill-color: initial; color: initial;">${icon}</span>`;
  }

  interface Persona {
    id: string; // uuid
    name: string;
    avatar?: string; // base64 or object URL
    age?: string;
    pronouns?: 'he/him' | 'she/her' | 'they/them' | string;
    about: string;
    additionalInstructions?: string;
    isActive: boolean;
    boundChatIds?: string[]; // locks persona to specific chats
    tokenCount?: number; // Estimated tokens
    bio?: string;
    directives?: string;
    isDefault?: boolean;
    nameColor?: string;
    avatarBorderEffect?: string;
    avatarDecorationAssetUrl?: string;
    nameIcon?: string;
    avatarGlowColor?: string;
  }

  const STORAGE_KEY_PERSONAS = 'aetheria_saved_personas';
  const STORAGE_KEY_ACTIVE = 'aetheria_user_persona';

  let personas: Persona[] = [];
  let activeCardIndex = 0;
  let flippedCards: Record<string, boolean> = {};
  let targetAvatarUploadPersonaId = '';

  // Helpers: Escaping, Toast & Modal
  function escapeHtml(str: string): string {
    if (!str) return '';
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function formatPronounLabel(rawVal: string): string {
    const v = (rawVal || '').trim().toLowerCase();
    if (!v) return 'Not specified';
    if (v === 'he/him') return 'He / Him';
    if (v === 'she/her') return 'She / Her';
    if (v === 'they/them') return 'They / Them';
    if (v === 'any' || v === 'any/all') return 'Any / All';
    return rawVal.trim();
  }

  function estimateTokens(text: string): number {
    if (!text || typeof text !== 'string') return 0;
    const clean = text.trim();
    if (!clean) return 0;
    const words = clean.split(/\s+/).filter(Boolean).length;
    const chars = clean.length;
    return Math.max(Math.round(words * 1.3), Math.ceil(chars / 3.8));
  }

  function showToast(message: string, type: 'success' | 'info' | 'warning' = 'info') {
    const container = document.getElementById('toast-container');
    if (!container) return;

    const toast = document.createElement('div');
    const colorClass = type === 'success' 
      ? 'border-emerald-500/40 text-emerald-300 bg-emerald-950/90' 
      : type === 'warning'
      ? 'border-amber-500/40 text-amber-300 bg-amber-950/90'
      : 'border-purple-500/40 text-purple-200 bg-[#141824]/95';

    toast.className = `px-4 py-2 rounded-2xl border ${colorClass} backdrop-blur-lg text-xs font-semibold shadow-xl transition-all duration-300 opacity-0 translate-y-2 pointer-events-auto`;
    toast.textContent = message;

    container.appendChild(toast);
    requestAnimationFrame(() => {
      toast.classList.remove('opacity-0', 'translate-y-2');
    });

    setTimeout(() => {
      toast.classList.add('opacity-0', 'translate-y-2');
      setTimeout(() => toast.remove(), 300);
    }, 2500);
  }

  function showConfirm(title: string, message: string): Promise<boolean> {
    return new Promise((resolve) => {
      const modal = document.getElementById('confirm-modal');
      const titleEl = document.getElementById('confirm-title');
      const msgEl = document.getElementById('confirm-message');
      const btnCancel = document.getElementById('confirm-cancel');
      const btnOk = document.getElementById('confirm-ok');

      if (!modal || !titleEl || !msgEl || !btnCancel || !btnOk) {
        resolve(false);
        return;
      }

      titleEl.textContent = title;
      msgEl.textContent = message;
      modal.classList.remove('hidden');
      modal.classList.add('flex');

      const cleanup = () => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        btnCancel.removeEventListener('click', onCancel);
        btnOk.removeEventListener('click', onOk);
      };

      const onCancel = () => { cleanup(); resolve(false); };
      const onOk = () => { cleanup(); resolve(true); };

      btnCancel.addEventListener('click', onCancel);
      btnOk.addEventListener('click', onOk);
    });
  }

  function normalizePersona(raw: any, index: number): Persona {
    const id = raw.id || ('p_' + Date.now() + '_' + index);
    const name = (raw.name || '').trim();
    const avatar = raw.avatar || '';
    const age = (raw.age || '').trim();
    const pronouns = (raw.pronouns || '').trim();
    const about = (raw.about !== undefined ? raw.about : (raw.bio || '')).trim();
    const additionalInstructions = (raw.additionalInstructions !== undefined ? raw.additionalInstructions : (raw.directives || '')).trim();
    const isActive = (raw.isActive !== undefined) ? !!raw.isActive : (raw.isDefault !== undefined ? !!raw.isDefault : false);
    const boundChatIds = Array.isArray(raw.boundChatIds) ? raw.boundChatIds : [];
    const tokenCount = estimateTokens(about + ' ' + additionalInstructions);
    const nameColor = raw.nameColor || '#a855f7';
    const avatarBorderEffect = raw.avatarBorderEffect || 'none';
    const nameIcon = raw.nameIcon !== undefined ? raw.nameIcon : '';
    const avatarGlowColor = raw.avatarGlowColor || '#a855f7';

    return {
      id,
      name,
      avatar,
      age,
      pronouns,
      about,
      additionalInstructions,
      isActive,
      boundChatIds,
      tokenCount,
      bio: about,
      directives: additionalInstructions,
      isDefault: isActive,
      nameColor,
      avatarBorderEffect,
      nameIcon,
      avatarGlowColor
    };
  }

  function loadPersonas() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY_PERSONAS);
      if (raw) {
        const parsed = JSON.parse(raw);
        if (Array.isArray(parsed) && parsed.length > 0) {
          personas = parsed.map((p, idx) => normalizePersona(p, idx));
        }
      }
    } catch {}

    if (!Array.isArray(personas) || personas.length === 0) {
      personas = [
        normalizePersona({
          id: 'p_hossein_default',
          name: 'Hossein',
          age: '26',
          pronouns: 'He/Him',
          avatar: '',
          about: 'Lead system engineer, software designer, and tech enthusiast exploring deep narrative worlds.',
          additionalInstructions: 'Speak naturally, keep descriptions immersive and grounded. Never narrate actions for Hossein.',
          isActive: true
        }, 0)
      ];
      savePersonas();
    }

    if (!personas.some(p => p.isActive)) {
      personas[0].isActive = true;
      personas[0].isDefault = true;
    }

    const activeIdx = personas.findIndex(p => p.isActive);
    activeCardIndex = activeIdx >= 0 ? activeIdx : 0;
  }

  function savePersonas() {
    personas.forEach(p => {
      p.bio = p.about;
      p.directives = p.additionalInstructions;
      p.isDefault = p.isActive;
      p.tokenCount = estimateTokens((p.about || '') + ' ' + (p.additionalInstructions || ''));
    });

    localStorage.setItem(STORAGE_KEY_PERSONAS, JSON.stringify(personas));

    const active = personas.find(p => p.isActive) || personas[0];
    if (active) {
      localStorage.setItem(STORAGE_KEY_ACTIVE, JSON.stringify(active));
    }
    updateHubProfileSummary();
  }

  function updateHubProfileSummary() {
    const active = personas.find(p => p.isActive) || personas[0];
    const hubName = document.getElementById('hub-user-name');
    const hubHandle = document.getElementById('hub-user-handle');
    const hubBadge = document.getElementById('hub-persona-status-badge');
    const hubCountPill = document.getElementById('hub-personas-count-pill');
    const hubSubtitle = document.getElementById('hub-persona-subtitle');
    const hubAvatarImg = document.getElementById('hub-avatar-img') as HTMLImageElement;
    const hubAvatarPlaceholder = document.getElementById('hub-avatar-placeholder');

    if (active) {
      const activeColor = active.nameColor || '#a855f7';
      const activeIcon = active.nameIcon || '';
      const isGrad = activeColor.includes('gradient');

      if (hubName) {
        if (isGrad) {
          hubName.style.backgroundImage = activeColor;
          hubName.style.webkitBackgroundClip = 'text';
          hubName.style.backgroundClip = 'text';
          hubName.style.webkitTextFillColor = 'transparent';
          hubName.style.color = 'transparent';
        } else {
          hubName.style.backgroundImage = 'none';
          hubName.style.webkitBackgroundClip = '';
          hubName.style.backgroundClip = '';
          hubName.style.webkitTextFillColor = '';
          hubName.style.color = activeColor;
        }
        const badgeMarkup = renderBadgeHtml(activeIcon, 'w-4 h-4 inline-block object-contain align-middle ml-1 shrink-0');
        if (badgeMarkup) {
          hubName.innerHTML = `<span>${active.name || 'Hossein'}</span>${badgeMarkup}`;
        } else {
          hubName.textContent = active.name || 'Hossein';
        }
      }

      const profilePill = document.getElementById('profile-name-pill');
      if (profilePill) {
        if (isGrad) {
          profilePill.style.backgroundImage = activeColor;
          profilePill.style.webkitBackgroundClip = 'text';
          profilePill.style.backgroundClip = 'text';
          profilePill.style.webkitTextFillColor = 'transparent';
          profilePill.style.color = 'transparent';
        } else {
          profilePill.style.backgroundImage = 'none';
          profilePill.style.webkitBackgroundClip = '';
          profilePill.style.backgroundClip = '';
          profilePill.style.webkitTextFillColor = '';
          profilePill.style.color = activeColor;
        }
        const badgeMarkup = renderBadgeHtml(activeIcon, 'w-3.5 h-3.5 inline-block object-contain align-middle ml-1 shrink-0');
        profilePill.innerHTML = `<span>${active.name || 'Hossein'}</span>${badgeMarkup}`;
      }

      if (hubHandle) hubHandle.textContent = `@${(active.name || 'user').toLowerCase().replace(/\s+/g, '')} • Active Persona`;
      if (hubSubtitle) hubSubtitle.textContent = `Active: ${active.name || 'Hossein'} • ${personas.length} profiles`;
      
      const hubAvatarTrigger = document.getElementById('hub-avatar-trigger');
      const borderEffect = active.avatarBorderEffect || 'none';
      const glowColor = active.avatarGlowColor || '#a855f7';
      if (hubAvatarTrigger) {
        const avatarWrapper = hubAvatarTrigger.querySelector('div:first-child') as HTMLElement | null;
        if (avatarWrapper) {
          avatarWrapper.style.setProperty('--avatar-glow-color', glowColor);
          avatarWrapper.style.setProperty('--avatar-border-color', glowColor);
          avatarWrapper.classList.remove('avatar-border-none', 'avatar-border-glow', 'avatar-border-dual-gradient', 'avatar-border-dynamic-sparkle');
          if (borderEffect === 'glow') avatarWrapper.classList.add('avatar-border-glow');
          else if (borderEffect === 'dual-gradient') avatarWrapper.classList.add('avatar-border-dual-gradient');
          else if (borderEffect === 'dynamic-sparkle') avatarWrapper.classList.add('avatar-border-dynamic-sparkle');
          else avatarWrapper.classList.add('avatar-border-none');
        }
      }

      if (hubAvatarImg && hubAvatarPlaceholder) {
        if (active.avatar) {
          hubAvatarImg.src = active.avatar;
          hubAvatarImg.classList.remove('hidden');
          hubAvatarPlaceholder.classList.add('hidden');
        } else {
          hubAvatarImg.src = '';
          hubAvatarImg.classList.add('hidden');
          hubAvatarPlaceholder.classList.remove('hidden');
          hubAvatarPlaceholder.textContent = (active.name || 'H').charAt(0).toUpperCase();
        }
      }
    }

    if (hubBadge) hubBadge.textContent = `${personas.length} ${personas.length === 1 ? 'Persona' : 'Personas'} Configured`;
    if (hubCountPill) hubCountPill.textContent = String(personas.length);
  }

  // ==========================================
  // 3D COVERFLOW & 3D FLIP CARD ENGINE
  // ==========================================

