    document.getElementById('btn-terminate-other-sessions')?.addEventListener('click', async () => {
      const otherContainer = document.getElementById('other-sessions-container');
      const hasOtherSessions = otherContainer && otherContainer.querySelector('.btn-revoke-session');
      if (!hasOtherSessions) {
        showToast('No other active sessions connected to your account.', 'info');
        return;
      }

      const confirmed = await showConfirm(
        'Logout of All Other Devices?',
        'Are you sure you want to terminate all other active sessions? All connected phones, laptops, and web sessions (except this current device) will be immediately logged out.'
      );
      if (!confirmed) return;

      const token = localStorage.getItem('aetheria_auth_token');
      const headers: Record<string, string> = { 'Content-Type': 'application/json' };
      if (token) headers['Authorization'] = `Bearer ${token}`;

      try {
        const res = await fetch('/api/sessions/others', {
          method: 'DELETE',
          headers
        });
        const data = await res.json().catch(() => ({}));
        if (data.success) {
          showToast('All other sessions have been disconnected successfully.', 'success');
          await loadDevicesAndSecurity();
