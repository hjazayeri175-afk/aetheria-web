      if (!cachedSecurityLogs || cachedSecurityLogs.length === 0) {
        showToast('No security logs available for export', 'info');
        return;
      }
      const exportData = {
        exportDate: new Date().toISOString(),
        application: 'Aetheria Web',
        edgeSecurity: 'Cloudflare Workers TLS 1.3',
        auditLogs: cachedSecurityLogs
      };
      const blob = new Blob([JSON.stringify(exportData, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `aetheria_security_audit_${new Date().toISOString().slice(0, 10)}.json`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      showToast('Security audit report downloaded', 'success');
