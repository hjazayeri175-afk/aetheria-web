      localStorage.setItem('aetheria_alert_new_login', String(alertNewLogin));
      localStorage.setItem('aetheria_alert_ip_anomaly', String(alertIpAnomaly));
      localStorage.setItem('aetheria_geo_shift_policy', currentGeoShiftPolicy);

      const token = localStorage.getItem('aetheria_auth_token');
      const headers: Record<string, string> = { 'Content-Type': 'application/json' };
      if (token) headers['Authorization'] = `Bearer ${token}`;

      try {
