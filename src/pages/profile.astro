      if (!confirmed) return;

      cachedSecurityLogs = [];
      const timeline = document.getElementById('security-logs-timeline');
      if (timeline) {
        timeline.innerHTML = '<div class="text-xs text-slate-500 py-3 text-center">Security audit trail cleared.</div>';
