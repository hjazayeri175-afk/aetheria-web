wBox=\"0 0 100 65\" fill=\"none\" xmlns=\"http://www.w3.org/2000/svg\">\n  <defs>\n    <linearGradient id=\"lux_grad\" x1=\"0%\" y1=\"0%\" x2=\"100%\" y2=\"100%\">\n      <stop offset=\"0%\" stop-color=\"#FFFFFF\" />\n      <stop offset=\"50%\" stop-color=\"#CBD5E1\" />\n      <stop offset=\"100%\" stop-color=\"#64748B\" />\n    </linearGradient>\n  </defs>\n  <!-- Diamond faceted luxury emblem -->\n  <path d=\"M50 12 L72 26 L72 44 L50 56 L28 44 L28 26 Z\" fill=\"url(#lux_grad)\" fill-opacity=\"0.12\" stroke=\"url(#lux_grad)\" stroke-width=\"2.5\" stroke-linejoin=\"round\" />\n  <!-- Inner Facet -->\n  <path d=\"M50 20 L64 30 L64 40 L50 48 L36 40 L36 30 Z\" stroke=\"#CBD5E1\" stroke-width=\"1.5\" stroke-linejoin=\"round\" fill=\"none\" />\n  <!-- Precision Center Point -->\n  <circle cx=\"50\" cy=\"34\" r=\"3\" fill=\"#FFFFFF\" />\n  <line x1=\"50\" y1=\"20\" x2=\"50\" y2=\"48\" stroke=\"url(#lux_grad)\" stroke-width=\"1\" stroke-dasharray=\"2 2\" />\n</svg>"};
      const THEME_FLOATING_ELEMENTS: Record<string, string> = {"amore": "\n      <span class=\"absolute text-sm top-1 left-3 opacity-30 transform -rotate-12 select-none\">\ud83d\udc96</span>\n      <span class=\"absolute text-xs bottom-2 right-4 opacity-35 transform rotate-6 select-none\">\ud83d\udc95</span>\n      <span class=\"absolute text-xs top-7 right-8 opacity-25 select-none\">\u2728</span>\n    ", "gamer-mode": "\n      <span class=\"absolute text-sm top-1 right-3 opacity-35 transform rotate-12 select-none\">\ud83c\udfae</span>\n      <span class=\"absolute text-xs bottom-2 left-3 opacity-30 transform -rotate-6 select-none\">\ud83d\udc7e</span>\n      <span class=\"absolute text-xs top-8 left-8 opacity-25 select-none\">\u26a1</span>\n    ", "coffee-corner": "\n      <span class=\"absolute text-sm top-1 left-3 opacity-35 transform -rotate-6 select-none\">\u2615</span>\n      <span class=\"absolute text-xs bottom-2 right-4 opacity-30 transform rotate-12 select-none\">\ud83e\udd0e</span>\n      <span class=\"absolute text-xs top-7 right-8 opacity-25 select-none\">\ud83e\udd50</span>\n    ", "power-up": "\n      <span class=\"absolute text-sm top-1 right-3 opacity-40 transform rotate-12 select-none\">\u26a1</span>\n      <span class=\"absolute text-xs bottom-2 left-4 opacity-35 transform -rotate-12 select-none\">\ud83d\udca5</span>\n      <span class=\"absolute text-xs top-8 left-8 opacity-30 select-none\">\u2728</span>\n    ", "winter-cozy": "\n      <span class=\"absolute text-sm top-1 left-4 opacity-35 transform -rotate-6 select-none\">\u2744\ufe0f</span>\n      <span class=\"absolute text-xs bottom-2 right-3 opacity-30 transform rotate-6 select-none\">\ud83c\udf32</span>\n      <span class=\"absolute text-xs top-8 right-8 opacity-25 select-none\">\u2728</span>\n    ", "ocean-motion": "\n      <span class=\"absolute text-sm top-1 right-3 opacity-35 transform rotate-12 select-none\">\ud83c\udf0a</span>\n      <span class=\"absolute text-xs bottom-2 left-4 opacity-30 transform -rotate-6 select-none\">\ud83d\udc1a</span>\n      <span class=\"absolute text-xs top-7 left-8 opacity-30 select-none\">\ud83e\udee7</span>\n    ", "sunset-glow": "\n      <span class=\"absolute text-sm top-1 left-3 opacity-35 transform -rotate-12 select-none\">\ud83c\udf05</span>\n      <span class=\"absolute text-xs bottom-2 right-4 opacity-30 transform rotate-6 select-none\">\ud83c\udf07</span>\n      <span class=\"absolute text-xs top-8 right-8 opacity-25 select-none\">\u2728</span>\n    ", "retro-terminal": "\n      <span class=\"absolute text-sm top-1 right-4 opacity-35 transform rotate-6 select-none\">\ud83d\udcbb</span>\n      <span class=\"absolute text-xs bottom-2 left-3 opacity-30 transform -rotate-12 select-none\">\ud83d\udcdf</span>\n      <span class=\"absolute text-xs top-7 left-8 opacity-30 select-none\">\ud83d\udfe2</span>\n    ", "zen-garden": "\n      <span class=\"absolute text-sm top-1 left-3 opacity-35 transform -rotate-6 select-none\">\ud83c\udf8b</span>\n      <span class=\"absolute text-xs bottom-2 right-4 opacity-30 transform rotate-12 select-none\">\ud83e\udea8</span>\n      <span class=\"absolute text-xs top-8 right-8 opacity-25 select-none\">\u262f\ufe0f</span>\n    ", "urban-jungle": "\n      <span class=\"absolute text-sm top-1 right-3 opacity-35 transform rotate-12 select-none\">\ud83c\udf3f</span>\n      <span class=\"absolute text-xs bottom-2 left-4 opacity-30 transform -rotate-6 select-none\">\ud83c\udfd9\ufe0f</span>\n      <span class=\"absolute text-xs top-7 left-8 opacity-30 select-none\">\ud83c\udf43</span>\n    ", "stargazer": "\n      <span class=\"absolute text-sm top-1 left-4 opacity-35 transform -rotate-12 select-none\">\ud83d\udd2d</span>\n      <span class=\"absolute text-xs bottom-2 right-3 opacity-30 transform rotate-12 select-none\">\ud83c\udf0c</span>\n      <span class=\"absolute text-xs top-8 right-8 opacity-25 select-none\">\u2728</span>\n    ", "monochrome-luxury": "\n      <span class=\"absolute text-sm top-1 right-4 opacity-35 transform rotate-6 select-none\">\ud83d\udc8e</span>\n      <span class=\"absolute text-xs bottom-2 left-3 opacity-30 transform -rotate-6 select-none\">\u23f1\ufe0f</span>\n      <span class=\"absolute text-xs top-7 left-8 opacity-25 select-none\">\u2728</span>\n    "};

function renderPresets() {
        if (!presetsGrid) return;
        const presets = (window as any).AetheriaTheme?.PRESETS || [];
        const activePresetId = settings.id || 'gamer-mode';

        presetsGrid.innerHTML = presets.map((p: any) => {
          const isSelected = p.id === activePresetId;
          const svgIcon = THEME_HERO_SVGS[p.id] || '';
          const floatingHtml = THEME_FLOATING_ELEMENTS[p.id] || '';
          const accentColor = p.accent || '#8E9AB6';

          return `
            <div 
              class="preset-theme-card shrink-0 w-[122px] sm:w-[138px] md:w-[152px] h-[225px] sm:h-[240px] rounded-[22px] p-2.5 flex flex-col justify-between relative overflow-hidden transition-all duration-300 cursor-pointer select-none group" 
              style="background: radial-gradient(circle at 50% 10%, ${accentColor}18 0%, #13161c 70%); border: ${isSelected ? `2px solid ${accentColor}` : '1px solid rgba(255, 255, 255, 0.08)'}; box-shadow: ${isSelected ? `0 0 0 2px ${accentColor}88, 0 0 20px ${accentColor}35, 0 12px 24px rgba(0,0,0,0.7)` : '0 6px 18px rgba(0, 0, 0, 0.4)'};"
              data-preset-id="${p.id}"
            >
              <!-- Selected Checkmark Badge (Top-Right) -->
              ${isSelected ? `
                <div class="absolute top-2 right-2 w-4 h-4 rounded-full flex items-center justify-center shadow-md z-20" style="background: ${accentColor};">
                  <svg class="w-2.5 h-2.5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                    <polyline points="20 6 9 17 4 12"></polyline>
                  </svg>
                </div>
              ` : ''}

              <!-- 1. Top Pill Badge -->
              <div class="w-full py-1 px-1.5 rounded-full flex items-center justify-center font-bold text-[10px] sm:text-[11px] tracking-tight shadow-xs text-center truncate transition-transform group-hover:scale-[1.02]" style="background: ${p.pillGradient}; color: ${p.pillTextColor};">
                ${p.name}
              </div>

              <!-- 2. Central Vector Hero Icon -->
              <div class="my-auto py-0.5 flex items-center justify-center transition-transform duration-300 group-hover:scale-105 [&>svg]:w-14 [&>svg]:h-9 sm:[&>svg]:w-16 sm:[&>svg]:h-10">
                ${svgIcon}
              </div>

              <!-- 3. Headline / Tagline Text -->
              <div class="text-center px-0.5 mb-1">
                <div class="text-[9px] sm:text-[10px] font-normal text-[#E1E3E8] leading-tight line-clamp-2 opacity-90">
                  ${p.tagline || p.description}
                </div>
              </div>

              <!-- 4. Mock Chat Interface Container -->
              <div class="w-full rounded-xl p-1.5 relative overflow-hidden flex flex-col justify-between h-[52px] sm:h-[56px] shadow-inner" style="background: ${p.charBubbleBg}99; backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.06);">
                <!-- Floating Theme Micro-Elements -->
                <div class="absolute inset-0 pointer-events-none overflow-hidden select-none text-[10px]">
                  ${floatingHtml}
                </div>
                
                <!-- Left/Incoming Chat Bubble -->
                <div class="self-start max-w-[85%] rounded-lg px-1.5 py-0.5 shadow-xs relative z-10" style="background: ${p.charBubbleBg}; border: 1px solid rgba(255,255,255,0.12);">
                  <div class="h-1 w-8 sm:w-10 rounded-full mb-0.5" style="background: ${accentColor}99;"></div>
                  <div class="h-1 w-5 sm:w-6 rounded-full" style="background: rgba(255,255,255,0.25);"></div>
                </div>

                <!-- Right/Outgoing Chat Bubble -->
                <div class="self-end max-w-[80%] rounded-full px-1.5 py-0.5 shadow-xs relative z-10 flex items-center gap-1" style="background: ${p.userBubbleBg};">
                  <div class="h-1 w-6 sm:w-8 rounded-full bg-white/70"></div>
                  <div class="w-1 h-1 rounded-full bg-white/90"></div>
                </div>
              </div>
            </div>
          `;
        }).join('');

        presetsGrid.querySelectorAll('.preset-theme-card').forEach((card: any) => {
          card.addEventListener('click', () => {
            const found = presets.find((p: any) => p.id === card.dataset.presetId);
            if (!found) return;
            settings = { ...settings, ...found };
            syncInputs();
            updatePreview();
            saveAndApply();
            renderPresets();
          });
        });
      }

      const btnPrevTheme = document.getElementById('btn-prev-theme');
      const btnNextTheme = document.getElementById('btn-next-theme');

      btnPrevTheme?.addEventListener('click', () => {
        if (presetsGrid) presetsGrid.scrollBy({ left: -140, behavior: 'smooth' });
      });

      btnNextTheme?.addEventListener('click', () => {
        if (presetsGrid) presetsGrid.scrollBy({ left: 140, behavior: 'smooth' });
      });

      function renderNameColors() {
        if (!nameColorPalette) return;
        const colors = (window as any).AetheriaTheme?.NAME_COLORS || [];
        nameColorPalette.innerHTML = colors.map((c: any) => `
          <button type="button" class="name-col-btn p-1.5 rounded-xl bg-white/[0.02] border border-white/[0.08] hover:border-white/30 flex items-center justify-center cursor-pointer transition" data-col="${c.hex}" title="${c.name}">
            <div class="w-6 h-6 rounded-full shadow-md" style="background: ${c.hex};"></div>
          </button>
        `).join('');

        nameColorPalette.querySelectorAll('.name-col-btn').forEach((btn: any) => {
          btn.addEventListener('click', () => {
            settings.nameColor = btn.dataset.col;
            updatePreview();
            saveAndApply();
          });
        });
      }

      // Wallpapers
      function renderWallpapers() {
        if (!wallpapersGrid) return;
        const wps = (window as any).AetheriaTheme?.WALLPAPERS || [];
        wallpapersGrid.innerHTML = wps.slice(0, 6).map((w: any) => `
          <div class="wp-card relative h-16 rounded-xl overflow-hidden border border-white/10 cursor-pointer group shadow-sm" data-wp="${w.css}">
            <div class="absolute inset-0 bg-cover bg-center" style="background: ${w.css};"></div>
            <div class="absolute inset-0 bg-black/40 group-hover:bg-black/10 transition flex items-center justify-center">
              <span class="text-[9px] font-bold text-white">${w.name}</span>
            </div>
          </div>
        `).join('');

        wallpapersGrid.querySelectorAll('.wp-card').forEach((card: any) => {
          card.addEventListener('click', () => {
            settings.chatWallpaper = card.dataset.wp;
            updatePreview();
            saveAndApply();
          });
        });
      }

      function updateSliderProgress(slider: HTMLInputElement | null) {
        if (!slider) return;
        const min = parseFloat(slider.min) || 0;
        const max = parseFloat(slider.max) || 100;
        const val = parseFloat(slider.value) || 0;
        const percent = Math.min(Math.max(((val - min) / (max - min)) * 100, 0), 100);
        const activeColor = settings.accent || 'var(--theme-accent, #8E9AB6)';
        slider.style.background = `linear-gradient(to right, ${activeColor} 0%, ${activeColor} ${percent}%, rgba(255, 255, 255, 0.14) ${percent}%, rgba(255, 255, 255, 0.14) 100%)`;
      }

      function syncInputs() {
        if (fontSlider) fontSlider.value = String(settings.fontSize || 16);
        if (fontVal) fontVal.textContent = String(settings.fontSize || 16);
        if (radiusSlider) radiusSlider.value = String(settings.bubbleRadius !== undefined ? settings.bubbleRadius : 16);
        if (radiusVal) radiusVal.textContent = `${settings.bubbleRadius !== undefined ? settings.bubbleRadius : 16}px`;
        updateSliderProgress(fontSlider);
        updateSliderProgress(radiusSlider);
      }

      // Event Listeners
      fontSlider?.addEventListener('input', (e: any) => {
        const val = parseInt(e.target.value, 10);
        settings.fontSize = val;
        if (fontVal) fontVal.textContent = String(val);
        updatePreview();
        saveAndApply();
      });

      radiusSlider?.addEventListener('input', (e: any) => {
        const val = parseInt(e.target.value, 10);
        settings.bubbleRadius = val;
        if (radiusVal) radiusVal.textContent = `${val}px`;
        updatePreview();
        saveAndApply();
      });

      btnSwitchDayNight?.addEventListener('click', () => {
        settings.baseMode = settings.baseMode === 'day' ? 'dark' : 'day';
        updatePreview();
        saveAndApply();
      });

      btnToggleWallpaperDrawer?.addEventListener('click', () => {
        const isHidden = drawerWallpaper?.classList.toggle('hidden');
        chevronWallpaper?.classList.toggle('rotate-90', !isHidden);
      });

      btnToggleNameColorDrawer?.addEventListener('click', () => {
        const isHidden = drawerNameColor?.classList.toggle('hidden');
        chevronNameColor?.classList.toggle('rotate-90', !isHidden);
      });

      photoBtn?.addEventListener('click', () => photoFileInput?.click());
      photoFileInput?.addEventListener('change', (e: any) => {
        const file = e.target.files?.[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (re) => {
          const res = re.target?.result as string;
          settings.chatWallpaper = `url("${res}")`;
          updatePreview();
          saveAndApply();
        };
        reader.readAsDataURL(file);
      });

      // Card 3 & 4 Toggles Wiring
      const toggleSendEnter = document.getElementById('setting-send-enter') as HTMLInputElement | null;
      const toggleStreamTypewriter = document.getElementById('setting-stream-typewriter') as HTMLInputElement | null;
      const toggleSoundEffects = document.getElementById('setting-sound-effects') as HTMLInputElement | null;
      const toggleAutoplayVoice = document.getElementById('setting-autoplay-voice') as HTMLInputElement | null;
      const toggleTapNextMedia = document.getElementById('setting-tap-next-media') as HTMLInputElement | null;
      const toggleReduceMotion = document.getElementById('setting-reduce-motion') as HTMLInputElement | null;

      function playPreviewChime() {
        try {
          const ctx = new (window.AudioContext || (window as any).webkitAudioContext)();
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.frequency.setValueAtTime(587.33, ctx.currentTime);
          osc.frequency.exponentialRampToValueAtTime(880, ctx.currentTime + 0.12);
          gain.gain.setValueAtTime(0.08, ctx.currentTime);
          gain.gain.exponentialRampToValueAtTime(0.001, ctx.currentTime + 0.13);
          osc.start();
          osc.stop(ctx.currentTime + 0.13);
        } catch(e) {}
      }

      if (toggleSendEnter) {
        toggleSendEnter.checked = localStorage.getItem('aetheria_chat_send_key') !== 'ctrl_enter';
        toggleSendEnter.addEventListener('change', () => {
          localStorage.setItem('aetheria_chat_send_key', toggleSendEnter.checked ? 'enter' : 'ctrl_enter');
        });
      }

      if (toggleStreamTypewriter) {
        toggleStreamTypewriter.checked = localStorage.getItem('aetheria_stream_typewriter') !== 'false';
        toggleStreamTypewriter.addEventListener('change', () => {
          localStorage.setItem('aetheria_stream_typewriter', String(toggleStreamTypewriter.checked));
        });
      }

      if (toggleSoundEffects) {
        toggleSoundEffects.checked = localStorage.getItem('aetheria_sound_effects') === 'true';
        toggleSoundEffects.addEventListener('change', () => {
          localStorage.setItem('aetheria_sound_effects', String(toggleSoundEffects.checked));
          if (toggleSoundEffects.checked) {
            playPreviewChime();
          }
        });
      }

      if (toggleAutoplayVoice) {
        toggleAutoplayVoice.checked = localStorage.getItem('aetheria_autoplay_voice') === 'true';
        toggleAutoplayVoice.addEventListener('change', () => {
          localStorage.setItem('aetheria_autoplay_voice', String(toggleAutoplayVoice.checked));
        });
      }

      if (toggleTapNextMedia) {
        toggleTapNextMedia.checked = localStorage.getItem('aetheria_tap_next_media') !== 'false';
        toggleTapNextMedia.addEventListener('change', () => {
          localStorage.setItem('aetheria_tap_next_media', String(toggleTapNextMedia.checked));
        });
      }

      if (toggleReduceMotion) {
        toggleReduceMotion.checked = localStorage.getItem('aetheria_reduce_motion') === 'true';
        toggleReduceMotion.addEventListener('change', () => {
          localStorage.setItem('aetheria_reduce_motion', String(toggleReduceMotion.checked));
          document.documentElement.classList.toggle('reduce-motion', toggleReduceMotion.checked);
        });
      }

      // Init everything
      syncInputs();
      updatePreview();
      renderPresets();
      renderNameColors();
      renderWallpapers();
    }

    // Call initProfileChatSettings
    initProfileChatSettings();
  });
</script>
