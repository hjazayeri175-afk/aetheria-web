        <!-- Backup & Storage Management -->
        <div class="rounded-3xl bg-[#141824] border border-white/[0.06] p-5 shadow-xl space-y-4">
          <h2 class="text-xs font-bold text-white uppercase tracking-wider">Data & Backups</h2>

          <div class="space-y-2">
            <button 
              type="button" 
              id="btn-export-backup"
              class="w-full p-3 rounded-2xl bg-white/[0.02] hover:bg-white/[0.06] border border-white/[0.06] flex items-center justify-between text-left transition cursor-pointer group"
            >
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-xl bg-purple-500/20 text-purple-300 flex items-center justify-center">
                  <Download class="w-4 h-4" />
                </div>
                <div>
                  <span class="text-xs font-semibold text-white block">Export Backup</span>
                  <span class="text-[11px] text-slate-400">Download personas and chat settings (JSON)</span>
                </div>
              </div>
            </button>

            <label 
              class="w-full p-3 rounded-2xl bg-white/[0.02] hover:bg-white/[0.06] border border-white/[0.06] flex items-center justify-between text-left transition cursor-pointer group"
            >
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-xl bg-blue-500/20 text-blue-300 flex items-center justify-center">
                  <Upload class="w-4 h-4" />
                </div>
                <div>
                  <span class="text-xs font-semibold text-white block">Restore Backup</span>
                  <span class="text-[11px] text-slate-400">Import saved JSON file</span>
                </div>
              </div>
              <input type="file" id="backup-file-input" accept=".json" class="hidden" />
            </label>

            <button 
              type="button" 
              id="btn-clear-cache"
              class="w-full p-3 rounded-2xl bg-red-500/10 hover:bg-red-500/20 border border-red-500/20 flex items-center justify-between text-left transition cursor-pointer group"
            >
              <div class="flex items-center gap-3">
                <div class="w-8 h-8 rounded-xl bg-red-500/20 text-red-400 flex items-center justify-center">
                  <Trash class="w-4 h-4" />
                </div>
                <div>
                  <span class="text-xs font-semibold text-red-300 block">Clear Local Cache</span>
                  <span class="text-[11px] text-red-400/80">Wipe local browser data and restart</span>
                </div>
              </div>
            </button>
          </div>
        </div>

      </div>

    </div>
  </main>

  <!-- Confirm Modal -->
  <div id="confirm-modal" class="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm hidden items-center justify-center p-4">
    <div class="w-full max-w-sm rounded-3xl bg-[#141824] border border-white/10 p-5 space-y-4 shadow-2xl">
      <div>
        <h3 id="confirm-title" class="text-base font-bold text-white">Confirm</h3>
        <p id="confirm-message" class="text-xs text-slate-400 mt-1 leading-relaxed">Are you sure?</p>
      </div>
      <div class="flex items-center justify-end gap-2 pt-2">
        <button id="confirm-cancel" type="button" class="px-4 py-2 rounded-xl bg-white/5 hover:bg-white/10 text-xs font-semibold text-slate-300 cursor-pointer transition">
          Cancel
        </button>
        <button id="confirm-ok" type="button" class="px-4 py-2 rounded-xl bg-red-600 hover:bg-red-500 text-xs font-semibold text-white cursor-pointer transition shadow-md shadow-red-950/50">
          Delete
        </button>
      </div>
    </div>
  </div>

  <!-- Toast Notification Container -->
  <div id="toast-container" class="fixed bottom-24 left-1/2 -translate-x-1/2 z-50 flex flex-col items-center gap-2 pointer-events-none w-full max-w-xs"></div>

  <BottomNav activeNav="persona" />
</Layout>

<script>
  interface Persona {
    id: string;
    name: string;
    age?: string;
    pronouns?: string;
    avatar?: string;
    bio?: string;
    directives?: string;
    isDefault?: boolean;
  }

  const STORAGE_KEY_PERSONAS = 'aetheria_saved_personas';
  const STORAGE_KEY_ACTIVE = 'aetheria_user_persona';

  let personas: Persona[] = [];
  let currentPersonaId = '';

  // Helpers: Toast & Modal
  function showToast(message: string, type: 'success' | 'info' | 'warning' = 'info') {
    const container = document.getElementById('toast-container');
    if (!container) return;

    const toast = document.createElement('div');
    const colorClass = type === 'success' 
      ? 'border-emerald-500/40 text-emerald-300 bg-emerald-950/90' 
      : type === 'warning'
      ? 'border-amber-500/40 text-amber-300 bg-amber-950/90'
      : 'border-purple-500/40 text-purple-200 bg-[#141824]/95';

    toast.className = `px-4 py-2 rounded-2xl border ${colorClass} backdrop-blur-lg text-xs font-semibold shadow-xl transition-all duration-300 opacity-0 translate-y-2 pointer-events-auto`;
    toast.textContent = message;

    container.appendChild(toast);
    requestAnimationFrame(() => {
      toast.classList.remove('opacity-0', 'translate-y-2');
    });

    setTimeout(() => {
      toast.classList.add('opacity-0', 'translate-y-2');
      setTimeout(() => toast.remove(), 300);
    }, 2500);
  }

  function showConfirm(title: string, message: string): Promise<boolean> {
    return new Promise((resolve) => {
      const modal = document.getElementById('confirm-modal');
      const titleEl = document.getElementById('confirm-title');
      const msgEl = document.getElementById('confirm-message');
      const btnCancel = document.getElementById('confirm-cancel');
      const btnOk = document.getElementById('confirm-ok');

      if (!modal || !titleEl || !msgEl || !btnCancel || !btnOk) {
        resolve(false);
        return;
      }

      titleEl.textContent = title;
      msgEl.textContent = message;
      modal.classList.remove('hidden');
      modal.classList.add('flex');

      const cleanup = () => {
        modal.classList.add('hidden');
        modal.classList.remove('flex');
        btnCancel.removeEventListener('click', onCancel);
        btnOk.removeEventListener('click', onOk);
      };

      const onCancel = () => { cleanup(); resolve(false); };
      const onOk = () => { cleanup(); resolve(true); };

      btnCancel.addEventListener('click', onCancel);
      btnOk.addEventListener('click', onOk);
    });
  }

  function loadPersonas() {
    try {
      const raw = localStorage.getItem(STORAGE_KEY_PERSONAS);
      if (raw) {
        personas = JSON.parse(raw);
      }
    } catch {}

    if (!Array.isArray(personas) || personas.length === 0) {
      personas = [
        {
          id: 'p_hossein_default',
          name: 'Hossein',
          age: '26',
          pronouns: 'He/Him',
          avatar: '',
          bio: 'Lead system engineer, software designer, and tech enthusiast.',
          directives: 'Speak naturally, keep descriptions immersive and grounded.',
          isDefault: true
        }
      ];
      savePersonas();
    }

    const defaultPersona = personas.find(p => p.isDefault) || personas[0];
    currentPersonaId = defaultPersona.id;
  }

  function savePersonas() {
    localStorage.setItem(STORAGE_KEY_PERSONAS, JSON.stringify(personas));
    const active = personas.find(p => p.id === currentPersonaId) || personas.find(p => p.isDefault) || personas[0];
    if (active) {
      localStorage.setItem(STORAGE_KEY_ACTIVE, JSON.stringify(active));
    }
    updateHubProfileSummary();
  }

  function updateHubProfileSummary() {
    const active = personas.find(p => p.id === currentPersonaId) || personas.find(p => p.isDefault) || personas[0];
    const hubName = document.getElementById('hub-user-name');
    const hubHandle = document.getElementById('hub-user-handle');
    const hubBadge = document.getElementById('hub-persona-status-badge');
    const hubCountPill = document.getElementById('hub-personas-count-pill');
    const hubSubtitle = document.getElementById('hub-persona-subtitle');
    const hubAvatarImg = document.getElementById('hub-avatar-img') as HTMLImageElement;
    const hubAvatarPlaceholder = document.getElementById('hub-avatar-placeholder');

    if (active) {
      if (hubName) hubName.textContent = active.name || 'Hossein';
      if (hubHandle) hubHandle.textContent = `@${(active.name || 'user').toLowerCase().replace(/\s+/g, '')} • Active Persona`;
      if (hubSubtitle) hubSubtitle.textContent = `Active: ${active.name || 'Hossein'} • ${personas.length} profiles`;
      
      if (hubAvatarImg && hubAvatarPlaceholder) {
        if (active.avatar) {
          hubAvatarImg.src = active.avatar;
          hubAvatarImg.classList.remove('hidden');
          hubAvatarPlaceholder.classList.add('hidden');
        } else {
          hubAvatarImg.src = '';
          hubAvatarImg.classList.add('hidden');
          hubAvatarPlaceholder.classList.remove('hidden');
          hubAvatarPlaceholder.textContent = (active.name || 'H').charAt(0).toUpperCase();
        }
      }
    }

    if (hubBadge) hubBadge.textContent = `${personas.length} ${personas.length === 1 ? 'Persona' : 'Personas'} Configured`;
    if (hubCountPill) hubCountPill.textContent = String(personas.length);
  }

  function renderPillList() {
    const list = document.getElementById('personas-pill-list');
    const countLabel = document.getElementById('personas-count-label');
    if (!list) return;

    if (countLabel) {
      countLabel.textContent = `${personas.length} ${personas.length === 1 ? 'persona' : 'personas'}`;
    }

    const itemsHtml = personas.map(p => {
      const isSelected = p.id === currentPersonaId;
      const displayName = p.name.trim() || 'Untitled';
      const ageText = p.age ? `${p.age}` : (p.pronouns ? `${p.pronouns}` : 'No details');
      return `
        <button 
          type="button" 
          class="persona-pill group relative flex items-center gap-3 py-2 px-3.5 rounded-2xl border text-left shrink-0 transition-all duration-200 cursor-pointer ${
            isSelected 
              ? 'bg-purple-600/20 border-purple-500/60 text-white shadow-lg shadow-purple-950/40 ring-1 ring-purple-500/40' 
              : 'bg-white/[0.03] border-white/5 text-slate-400 hover:text-slate-200 hover:bg-white/[0.06] hover:border-white/10'
          }"
          data-id="${p.id}"
        >
          <div class="relative w-8 h-8 rounded-full overflow-hidden bg-purple-950/40 border ${isSelected ? 'border-purple-400' : 'border-white/10'} shrink-0 flex items-center justify-center">
            ${p.avatar ? `<img src="${p.avatar}" class="w-full h-full object-cover" />` : `<span class="text-xs font-bold text-purple-300">${(displayName.charAt(0) || 'U').toUpperCase()}</span>`}
          </div>
          <div class="min-w-0 pr-1">
            <p class="persona-pill-name text-xs font-bold truncate max-w-[90px] sm:max-w-[120px] leading-tight">${displayName}</p>
            <p class="text-[10px] text-slate-500 truncate leading-tight mt-0.5">${ageText}</p>
          </div>
          ${p.isDefault ? '<span class="ml-1 text-[9px] px-1.5 py-0.5 rounded-full bg-purple-500/30 text-purple-200 font-semibold border border-purple-400/20 shrink-0">Active</span>' : ''}
        </button>
      `;
    }).join('');

    const addBtnHtml = `
      <button 
        type="button" 
        id="btn-add-persona-carousel"
        class="flex items-center gap-2 py-2 px-3.5 rounded-2xl border border-dashed border-white/15 bg-white/[0.01] hover:bg-white/[0.05] text-slate-400 hover:text-purple-300 text-xs font-semibold shrink-0 transition cursor-pointer"
        title="Create new persona"
      >
        <span class="w-6 h-6 rounded-full bg-white/5 flex items-center justify-center text-slate-300 font-bold text-xs">+</span>
        <span>Add</span>
      </button>
    `;

    list.innerHTML = itemsHtml + addBtnHtml;

    list.querySelectorAll('.persona-pill').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id');
        if (id) {
          currentPersonaId = id;
          personas.forEach(x => {
            x.isDefault = (x.id === currentPersonaId);
          });
          savePersonas();
          renderPillList();
          fillForm();
          const p = personas.find(x => x.id === currentPersonaId);
          showToast(`Active persona: ${p?.name || 'Persona'}`, 'success');
        }
      });
    });

    document.getElementById('btn-add-persona-carousel')?.addEventListener('click', () => {
      document.getElementById('btn-new-persona')?.click();
    });
  }

  function fillForm() {
    const p = personas.find(x => x.id === currentPersonaId) || personas[0];
    if (!p) return;

    const nameInput = document.getElementById('persona-name') as HTMLInputElement;
    const ageInput = document.getElementById('persona-age') as HTMLInputElement;
    const pronounsInput = document.getElementById('persona-pronouns') as HTMLInputElement;
    const aboutInput = document.getElementById('persona-about') as HTMLTextAreaElement;
    const directivesInput = document.getElementById('persona-directives') as HTMLTextAreaElement;
    const avatarImg = document.getElementById('persona-avatar-img') as HTMLImageElement;
    const avatarPlaceholder = document.getElementById('persona-avatar-placeholder');
    const removeBtn = document.getElementById('btn-remove-avatar');
    const deleteBtn = document.getElementById('btn-delete-persona');

    if (nameInput) nameInput.value = p.name || '';
    if (ageInput) ageInput.value = p.age || '';
    if (pronounsInput) pronounsInput.value = p.pronouns || '';
    if (aboutInput) aboutInput.value = p.bio || '';
    if (directivesInput) directivesInput.value = p.directives || '';

    if (avatarImg && avatarPlaceholder && removeBtn) {
      if (p.avatar) {
        avatarImg.src = p.avatar;
        avatarImg.classList.remove('hidden');
        avatarPlaceholder.classList.add('hidden');
        removeBtn.classList.remove('hidden');
      } else {
        avatarImg.src = '';
        avatarImg.classList.add('hidden');
        avatarPlaceholder.classList.remove('hidden');
        removeBtn.classList.add('hidden');
      }
    }

    const isGlobalEnabled = (localStorage.getItem('aetheria_persona_enabled') !== 'false');
    const statusBadge = document.getElementById('persona-status-badge');
    const statusBadgeText = document.getElementById('persona-status-badge-text');

    if (statusBadge && statusBadgeText) {
      if (isGlobalEnabled) {
        statusBadge.className = 'px-3 py-1.5 rounded-xl bg-purple-500/15 border border-purple-500/30 text-purple-300 text-xs font-semibold flex items-center gap-1.5 select-none';
        statusBadgeText.textContent = 'Active for Chat';
      } else {
        statusBadge.className = 'px-3 py-1.5 rounded-xl bg-white/5 border border-white/10 text-slate-500 text-xs font-medium flex items-center gap-1.5 select-none';
        statusBadgeText.textContent = 'Paused (Chats Off)';
      }
    }

    if (deleteBtn) {
      deleteBtn.style.display = (personas.length > 1) ? 'flex' : 'none';
    }
  }

  // Setup Event Handlers
  document.addEventListener('DOMContentLoaded', () => {
    loadPersonas();
    renderPillList();
    fillForm();
    updateHubProfileSummary();

    // ==========================================
    // Telegram-Style View Switcher (SPA Hub)
    // ==========================================
    function showView(targetId: string) {
      const views = ['view-hub', 'view-personas', 'view-appearance', 'view-ai-engine', 'view-voice', 'view-privacy'];
      views.forEach(id => {
        const el = document.getElementById(id);
        if (!el) return;
        if (id === targetId) {
          el.classList.remove('hidden');
          window.scrollTo({ top: 0, behavior: 'instant' });
        } else {
          el.classList.add('hidden');
        }
      });

      const hashMap: Record<string, string> = {
        'view-hub': '',
        'view-personas': '#personas',
        'view-appearance': '#appearance',
        'view-ai-engine': '#ai-engine',
        'view-voice': '#voice',
        'view-privacy': '#privacy'
      };
      const targetHash = hashMap[targetId] || '';
      if (window.location.hash !== targetHash) {
        history.pushState(null, '', window.location.pathname + targetHash);
      }
    }

    function syncFromHash() {
      const h = window.location.hash;
      if (h === '#personas') showView('view-personas');
      else if (h === '#appearance' || h === '#chat-settings') showView('view-appearance');
      else if (h === '#ai-engine') showView('view-ai-engine');
      else if (h === '#voice') showView('view-voice');
      else if (h === '#privacy' || h === '#data') showView('view-privacy');
      else showView('view-hub');
    }

    window.addEventListener('popstate', syncFromHash);
    syncFromHash();

    // Hub Menu Item Clicks
    document.getElementById('hub-item-personas')?.addEventListener('click', () => showView('view-personas'));
    document.getElementById('hub-item-appearance')?.addEventListener('click', () => showView('view-appearance'));
    document.getElementById('hub-item-ai')?.addEventListener('click', () => showView('view-ai-engine'));
    document.getElementById('hub-item-voice')?.addEventListener('click', () => showView('view-voice'));
    document.getElementById('hub-item-privacy')?.addEventListener('click', () => showView('view-privacy'));
    document.getElementById('hub-item-data')?.addEventListener('click', () => showView('view-privacy'));
    document.getElementById('hub-avatar-trigger')?.addEventListener('click', () => showView('view-personas'));

    document.getElementById('hub-item-devices')?.addEventListener('click', () => {
      showToast('Active device: Mobile Web Client (Cloudflare Edge)', 'info');
    });

    document.getElementById('hub-item-power')?.addEventListener('click', () => {
      showToast('Power saving: Standard performance active', 'info');
    });

    document.getElementById('hub-item-language')?.addEventListener('click', () => {
      showToast('Language: English (US)', 'info');
    });

    // Sub-Page Back Buttons
    document.getElementById('btn-back-from-personas')?.addEventListener('click', () => showView('view-hub'));
    document.getElementById('btn-back-from-appearance')?.addEventListener('click', () => showView('view-hub'));
    document.getElementById('btn-back-from-ai')?.addEventListener('click', () => showView('view-hub'));
    document.getElementById('btn-back-from-voice')?.addEventListener('click', () => showView('view-hub'));
    document.getElementById('btn-back-from-privacy')?.addEventListener('click', () => showView('view-hub'));

    // Master Persona Enable/Disable Toggle
    const masterToggle = document.getElementById('persona-master-toggle') as HTMLInputElement;
    const toggleStatus = document.getElementById('persona-toggle-status');
    const toggleIcon = document.getElementById('persona-toggle-icon');

    function updateToggleUI(enabled: boolean) {
      if (toggleStatus) {
        toggleStatus.textContent = enabled 
          ? 'Active in chats • Characters will use your persona' 
          : 'Disabled • Characters interact using their default scenario';
      }
      if (toggleIcon) {
        if (enabled) {
          toggleIcon.className = 'w-9 h-9 rounded-xl bg-purple-600/20 border border-purple-500/30 flex items-center justify-center text-purple-300 transition';
        } else {
          toggleIcon.className = 'w-9 h-9 rounded-xl bg-white/5 border border-white/10 flex items-center justify-center text-slate-500 transition';
        }
      }
    }

    const isInitiallyEnabled = (localStorage.getItem('aetheria_persona_enabled') !== 'false');
    if (masterToggle) {
      masterToggle.checked = isInitiallyEnabled;
      updateToggleUI(isInitiallyEnabled);

      masterToggle.addEventListener('change', () => {
        const isEnabled = masterToggle.checked;
        localStorage.setItem('aetheria_persona_enabled', isEnabled ? 'true' : 'false');
        updateToggleUI(isEnabled);
        fillForm();
        showToast(isEnabled ? 'Personas enabled in chats' : 'Personas disabled. Using scenario default', isEnabled ? 'success' : 'info');
      });
    }

    // Avatar Click Zone
    const avatarZone = document.getElementById('avatar-click-zone');
    const fileInput = document.getElementById('avatar-file-input') as HTMLInputElement;

    avatarZone?.addEventListener('click', () => {
      fileInput?.click();
    });

    fileInput?.addEventListener('change', () => {
      const file = fileInput.files?.[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = (e) => {
        const dataUrl = e.target?.result as string;
        const p = personas.find(x => x.id === currentPersonaId);
        if (p) {
          p.avatar = dataUrl;
          savePersonas();
          fillForm();
          renderPillList();
          showToast('Photo updated', 'success');
        }
      };
      reader.readAsDataURL(file);
    });

    // Remove Photo
    document.getElementById('btn-remove-avatar')?.addEventListener('click', (e) => {
      e.stopPropagation();
      const p = personas.find(x => x.id === currentPersonaId);
      if (p) {
        p.avatar = '';
        savePersonas();
        fillForm();
        renderPillList();
        showToast('Photo removed');
      }
    });

    // Live update card title as user types
    const nameInput = document.getElementById('persona-name') as HTMLInputElement;
    nameInput?.addEventListener('input', () => {
      const p = personas.find(x => x.id === currentPersonaId);
      if (p) {
        p.name = nameInput.value;
        const pillText = document.querySelector(`.persona-pill[data-id="${p.id}"] .persona-pill-name`);
        if (pillText) {
          pillText.textContent = nameInput.value.trim() || 'Untitled';
        }
        updateHubProfileSummary();
      }
    });

    // New Persona
    document.getElementById('btn-new-persona')?.addEventListener('click', () => {
      personas.forEach(x => { x.isDefault = false; });
      const newP: Persona = {
        id: 'p_' + Date.now(),
        name: '',
        age: '',
        pronouns: '',
        avatar: '',
        bio: '',
        directives: '',
        isDefault: true
      };
      personas.push(newP);
      currentPersonaId = newP.id;
      savePersonas();
      renderPillList();
      fillForm();
      const nInput = document.getElementById('persona-name') as HTMLInputElement;
      nInput?.focus();
      showToast('New persona created & active', 'success');
    });

    // Save Persona
    document.getElementById('btn-save-persona')?.addEventListener('click', () => {
      const p = personas.find(x => x.id === currentPersonaId);
      if (!p) return;

      const nameInp = document.getElementById('persona-name') as HTMLInputElement;
      const ageInput = document.getElementById('persona-age') as HTMLInputElement;
      const pronounsInput = document.getElementById('persona-pronouns') as HTMLInputElement;
      const aboutInput = document.getElementById('persona-about') as HTMLTextAreaElement;
      const directivesInput = document.getElementById('persona-directives') as HTMLTextAreaElement;

      p.name = nameInp?.value.trim() || '';
      p.age = ageInput?.value.trim() || '';
      p.pronouns = pronounsInput?.value.trim() || '';
      p.bio = aboutInput?.value.trim() || '';
      p.directives = directivesInput?.value.trim() || '';

      personas.forEach(x => { x.isDefault = (x.id === currentPersonaId); });

      savePersonas();
      renderPillList();
      fillForm();
      showToast('Persona saved', 'success');
    });

    // Delete Persona
    document.getElementById('btn-delete-persona')?.addEventListener('click', async () => {
      if (personas.length <= 1) return;
      const p = personas.find(x => x.id === currentPersonaId);
      const ok = await showConfirm('Delete Persona', `Delete "${p?.name || 'this persona'}"?`);
      if (!ok) return;

      personas = personas.filter(x => x.id !== currentPersonaId);
      if (!personas.some(x => x.isDefault)) {
        personas[0].isDefault = true;
      }
      currentPersonaId = personas[0].id;
      savePersonas();
      renderPillList();
      fillForm();
      showToast('Persona deleted');
    });

    // NSFW Mode Options
    const nsfwButtons = document.querySelectorAll('.nsfw-opt-btn');
    const currentNsfw = localStorage.getItem('aetheria_nsfw_mode') || 'show';

    function updateNsfwButtons(mode: string) {
      nsfwButtons.forEach(btn => {
        const bMode = btn.getAttribute('data-mode');
        if (bMode === mode) {
          btn.className = 'nsfw-opt-btn py-2.5 px-2 rounded-xl border border-purple-500/60 bg-purple-600/20 text-white font-semibold text-center transition cursor-pointer text-xs';
        } else {
          btn.className = 'nsfw-opt-btn py-2.5 px-2 rounded-xl border border-white/5 bg-white/[0.02] text-slate-400 hover:text-white font-medium text-center transition cursor-pointer text-xs';
        }
      });
    }

    updateNsfwButtons(currentNsfw);

    nsfwButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const mode = btn.getAttribute('data-mode') || 'show';
        localStorage.setItem('aetheria_nsfw_mode', mode);
        updateNsfwButtons(mode);
        showToast('Preference saved', 'success');
      });
    });

    // Check Auth State
    fetch('/api/auth/me')
      .then(res => res.json())
      .then((data: any) => {
        if (data.authenticated && data.user) {
          const nameLabel = document.getElementById('account-name-label');
          const emailLabel = document.getElementById('account-email-label');
          const avatarPill = document.getElementById('account-avatar-pill');
          const actionBox = document.getElementById('account-action-container');

          if (nameLabel) nameLabel.textContent = data.user.name || 'User';
          if (emailLabel) emailLabel.textContent = data.user.email || '';
          if (avatarPill) avatarPill.textContent = (data.user.name || 'U').charAt(0).toUpperCase();

          if (actionBox) {
            actionBox.innerHTML = `
              <button id="btn-logout" type="button" class="px-3.5 py-1.5 rounded-xl bg-white/5 hover:bg-white/10 text-xs font-semibold text-slate-300 hover:text-white transition cursor-pointer">
                Sign Out
              </button>
            `;
            document.getElementById('btn-logout')?.addEventListener('click', async () => {
              await fetch('/api/auth/logout', { method: 'POST' });
              window.location.reload();
            });
          }
        }
      })
      .catch(() => {});

    // Export Backup
    document.getElementById('btn-export-backup')?.addEventListener('click', () => {
      const backupData: Record<string, any> = {};
      for (let i = 0; i < localStorage.length; i++) {
        const key = localStorage.key(i);
        if (key && key.startsWith('aetheria_')) {
          backupData[key] = localStorage.getItem(key);
        }
      }
      const blob = new Blob([JSON.stringify(backupData, null, 2)], { type: 'application/json' });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `aetheria_backup_${new Date().toISOString().slice(0,10)}.json`;
      a.click();
      URL.revokeObjectURL(url);
      showToast('Backup downloaded', 'success');
    });

    // Restore Backup
    document.getElementById('backup-file-input')?.addEventListener('change', (e: any) => {
      const file = e.target?.files?.[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = (event) => {
        try {
          const data = JSON.parse(event.target?.result as string);
          Object.keys(data).forEach(k => {
            if (k.startsWith('aetheria_')) {
              localStorage.setItem(k, data[k]);
            }
          });
          showToast('Backup restored successfully!', 'success');
          setTimeout(() => window.location.reload(), 800);
        } catch {
          showToast('Invalid backup file', 'warning');
        }
      };
      reader.readAsText(file);
    });

    // Clear Cache
    document.getElementById('btn-clear-cache')?.addEventListener('click', async () => {
      const ok = await showConfirm('Clear Local Cache', 'Reset local data? Characters and personas saved only locally will be cleared.');
      if (!ok) return;

      Object.keys(localStorage).forEach(k => {
        if (k.startsWith('aetheria_')) localStorage.removeItem(k);
      });
      window.location.reload();
    });

    // AI Engine settings save
    document.getElementById('btn-save-ai-cfg')?.addEventListener('click', () => {
      showToast('AI engine settings saved', 'success');
    });

    // ==========================================
    // Profile Chat Settings (Telegram Suite)
    // ==========================================
    function initProfileChatSettings() {
      let settings = { ...(window.AetheriaTheme?.getSettings?.(null) || {}) };

      const previewViewport = document.getElementById('profile-preview-viewport');
      const previewImage = document.getElementById('profile-preview-image');
      const previewDimmer = document.getElementById('profile-preview-dimmer');
      const previewPattern = document.getElementById('profile-preview-pattern');
      const previewCharBubble = document.getElementById('profile-preview-char-bubble');
      const previewUserBubble = document.getElementById('profile-preview-user-bubble');
      const previewCharName = document.getElementById('profile-preview-char-name');
      const namePill = document.getElementById('profile-name-pill');

      const fontSlider = document.getElementById('profile-font-slider') as HTMLInputElement | null;
      const fontVal = document.getElementById('profile-font-val');
      const radiusSlider = document.getElementById('profile-radius-slider') as HTMLInputElement | null;
      const radiusVal = document.getElementById('profile-radius-val');

      const btnSwitchDayNight = document.getElementById('btn-switch-day-night');
      const labelDayNight = document.getElementById('label-day-night');
      const badgeDayNight = document.getElementById('badge-day-night');

      const btnToggleWallpaperDrawer = document.getElementById('btn-toggle-wallpaper-drawer');
      const drawerWallpaper = document.getElementById('drawer-wallpaper');
      const chevronWallpaper = document.getElementById('chevron-wallpaper');

      const btnToggleNameColorDrawer = document.getElementById('btn-toggle-name-color-drawer');
      const drawerNameColor = document.getElementById('drawer-name-color');
      const chevronNameColor = document.getElementById('chevron-name-color');

      const baseModeButtons = document.querySelectorAll('#profile-base-mode-group .profile-mode-btn');
      const nameColorPalette = document.getElementById('profile-name-color-palette');
      const nameColorHex = document.getElementById('profile-name-color-hex');
      const presetsGrid = document.getElementById('profile-presets-grid');
      const wallpapersGrid = document.getElementById('profile-wallpapers-grid');

      const photoFileInput = document.getElementById('profile-photo-file') as HTMLInputElement | null;
      const photoBtn = document.getElementById('profile-photo-btn');

      function updatePreview() {
        if (!previewViewport) return;

        // 1. Wallpaper background
        if (settings.chatWallpaper) {
          previewViewport.style.background = settings.chatWallpaper;
          previewViewport.style.backgroundSize = 'cover';
          previewViewport.style.backgroundPosition = 'center';
        } else {
          previewViewport.style.background = '#0a0d16';
        }

        // 1.5 Wallpaper pattern overlay
        if (previewPattern) {
          const patId = settings.chatPatternId || (settings.id ? ('pattern-' + settings.id.replace('-mode', '').replace('-corner', '').replace('-luxury', '')) : 'pattern-gamer');
          const patObj = (window as any).AetheriaTheme?.PATTERNS?.[patId];
          if (patObj && patObj.pattern && patObj.pattern !== 'none') {
            previewPattern.style.backgroundImage = patObj.pattern;
            previewPattern.style.backgroundSize = patObj.patternSize;
            previewPattern.style.opacity = (settings.chatPatternOpacity !== undefined ? settings.chatPatternOpacity : 0.16).toString();
          } else {
            previewPattern.style.backgroundImage = 'none';
          }
        }

        // 2. Outgoing User Message Bubble
        if (previewUserBubble) {
          const radius = settings.bubbleRadius !== undefined ? settings.bubbleRadius : 16;
          previewUserBubble.style.borderRadius = `${radius}px`;
          if (settings.userBubbleBg) {
            previewUserBubble.style.background = settings.userBubbleBg;
          }
        }

        // 3. Incoming Character Message Bubble
        if (previewCharBubble) {
          const radius = settings.bubbleRadius !== undefined ? settings.bubbleRadius : 16;
          previewCharBubble.style.borderRadius = `${radius}px`;
          if (settings.charBubbleBg) {
            previewCharBubble.style.background = settings.charBubbleBg;
          }
        }

        // 4. Message Font Size
        const fontSize = settings.fontSize !== undefined ? settings.fontSize : 16;
        const charMsgText = document.getElementById('profile-preview-char-msg-text');
        const userMsgText = document.getElementById('profile-preview-user-msg-text');
        if (charMsgText) charMsgText.style.fontSize = `${fontSize}px`;
        if (userMsgText) userMsgText.style.fontSize = `${fontSize}px`;

        // 5. Name color pill
        const nameColor = settings.nameColor || settings.accent || '#a855f7';
        if (namePill) {
          namePill.style.color = nameColor;
        }

        // 6. Day / Night mode badge button
        if (labelDayNight) {
          labelDayNight.textContent = settings.baseMode === 'day' ? 'Day' : 'Dark';
        }
      }

      function saveAndApply() {
        try {
          (window as any).AetheriaTheme?.saveSettings?.(settings, null);
          (window as any).AetheriaTheme?.apply?.(settings);
        } catch(e) {}
        updateSliderProgress(fontSlider);
        updateSliderProgress(radiusSlider);
      }


