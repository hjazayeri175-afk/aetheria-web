---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import CategoryPills from '../components/CategoryPills.astro';
import CharacterGrid from '../components/CharacterGrid.astro';
import BottomNav from '../components/BottomNav.astro';
import QuickChatModal from '../components/QuickChatModal.astro';
import { Sparkles, Download, Plus, ShieldCheck, Zap } from '@lucide/astro';
---

<Layout title="Aetheria — Private Client-Side AI Character Roleplay & Sandbox">
  <Header />
  <CategoryPills />

  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-5 sm:py-8 pb-24 sm:pb-8">
    
    <!-- Hero / Headline Banner -->
    <div class="relative overflow-hidden rounded-2xl sm:rounded-3xl border border-white/[0.08] bg-gradient-to-b from-white/[0.03] to-transparent p-5 sm:p-8 mb-6 sm:mb-8">
      <!-- Ambient Glows -->
      <div class="absolute -right-20 -top-20 w-80 h-80 bg-purple-600/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -left-20 -bottom-20 w-80 h-80 bg-cyan-600/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 max-w-3xl">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/20 text-xs font-medium text-purple-300 mb-3 sm:mb-4">
          <Sparkles class="w-3.5 h-3.5 text-purple-400" />
          <span>Client-Side AI Sandbox • 100% Private</span>
        </div>

        <h1 class="text-2xl sm:text-4xl font-extrabold tracking-tight text-white leading-tight mb-2 sm:mb-3">
          Your Personal Character Vault, <br class="hidden sm:block" />
          <span class="bg-gradient-to-r from-purple-400 via-indigo-300 to-cyan-400 bg-clip-text text-transparent">
            Tavern & Chub Ready.
          </span>
        </h1>

        <p class="text-xs sm:text-sm text-slate-400 leading-relaxed max-w-2xl mb-4 sm:mb-6">
          Bring your own character cards from Chub.ai or craft tailored personas from scratch. Run roleplay with your own API keys directly in the browser.
        </p>

        <!-- Action Buttons & Badges -->
        <div class="flex flex-wrap items-center gap-3 mb-6">
          <a
            href="/create?import=true"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white text-xs sm:text-sm font-semibold shadow-lg shadow-purple-900/30 transition active:scale-95 cursor-pointer"
          >
            <Download class="w-4 h-4" />
            <span>Import Tavern Card</span>
          </a>

          <a
            href="/create"
            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-white/[0.05] hover:bg-white/[0.1] border border-white/10 text-white text-xs sm:text-sm font-semibold transition active:scale-95 cursor-pointer"
          >
            <Plus class="w-4 h-4 text-purple-400" />
            <span>Create Character</span>
          </a>
        </div>

        <!-- Feature Badges -->
        <div class="flex flex-wrap items-center gap-2 sm:gap-3 text-xs text-slate-300">
          <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white/[0.04] border border-white/[0.06]">
            <Zap class="w-3.5 h-3.5 text-amber-400" />
            <span>Multi-Provider BYOK</span>
          </div>
          <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white/[0.04] border border-white/[0.06]">
            <ShieldCheck class="w-3.5 h-3.5 text-emerald-400" />
            <span>Zero-Cloud Data Storage</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Section: Character Cards Grid & Vault -->
    <CharacterGrid />

  </main>

  <!-- Footer -->
  <footer class="border-t border-white/[0.06] pt-8 pb-28 sm:pb-8 text-center text-xs text-slate-500 bg-[#05060a]">
    <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-4">
      <div class="flex items-center gap-2">
        <div class="w-2 h-2 rounded-full bg-purple-500"></div>
        <span class="font-bold text-slate-300">Aetheria AI</span>
      </div>
      <p class="text-slate-500">Private, client-side AI roleplay sandbox & Tavern card hub.</p>
    </div>
  </footer>

  <!-- Section 4: Mobile Bottom Navigation Bar -->
  <BottomNav />

  <!-- Section 5: Obsidian Quick Chat Preview Modal -->
  <QuickChatModal />
</Layout>
