      textProv = activeProf.provider || 'groq';
      textKey = activeProf.apiKey || '';
      baseUrl = activeProf.baseUrl || '';
    } else {
      textProv = localStorage.getItem('aetheria_text_provider') || 'groq';
      if (textProv === 'demo') textProv = 'groq';
      textKey = localStorage.getItem('aetheria_key_' + textProv) || localStorage.getItem('aetheria_text_key') || '';
