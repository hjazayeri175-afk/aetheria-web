  btnUpdateActiveVideoProfile?.addEventListener('click', updateActiveVideoProfile);
  btnDeleteActiveVideoProfile?.addEventListener('click', deleteActiveVideoProfile);

  // ==========================================
  // HUMAN CONTROLS: SPEED & TONE PRESETS
  // ==========================================
  function updateSpeedPillsAndLabel(rate) {
    const rateVal = parseFloat(rate);
    if (badgeVoiceRateLabel) badgeVoiceRateLabel.textContent = `${rateVal.toFixed(2).replace(/\.00$/, '')}x`;
    if (badgeVoiceRateDesc) {
      let desc = 'Natural';
      if (rateVal <= 0.88) desc = 'Slow';
      else if (rateVal <= 1.05) desc = 'Natural';
      else if (rateVal <= 1.2) desc = 'Lively';
      else desc = 'Fast';
      badgeVoiceRateDesc.textContent = `(${desc})`;
    }
    document.querySelectorAll('.voice-speed-preset-btn').forEach(btn => {
      const bRate = parseFloat(btn.getAttribute('data-rate') || '1.0');
      if (Math.abs(bRate - rateVal) < 0.05) {
        btn.className = 'voice-speed-preset-btn py-1.5 px-2 rounded-lg text-xs font-semibold bg-purple-600 text-white border border-purple-500/40 shadow-sm transition cursor-pointer';
      } else {
        btn.className = 'voice-speed-preset-btn py-1.5 px-2 rounded-lg text-xs font-semibold bg-white/[0.04] hover:bg-white/[0.08] text-slate-300 border border-white/5 transition cursor-pointer';
      }
    });
  }

  function updatePitchPillsAndLabel(pitch) {
    const pitchVal = parseFloat(pitch);
    if (badgeVoicePitchLabel) {
      let desc = 'Natural (1.0)';
      if (pitchVal <= 0.88) desc = 'Deep (0.85)';
      else if (pitchVal <= 0.98) desc = 'Warm (0.95)';
      else if (pitchVal <= 1.05) desc = 'Natural (1.0)';
      else desc = 'Bright (1.15)';
      badgeVoicePitchLabel.textContent = desc;
    }
    document.querySelectorAll('.voice-pitch-preset-btn').forEach(btn => {
      const bPitch = parseFloat(btn.getAttribute('data-pitch') || '1.0');
      if (Math.abs(bPitch - pitchVal) < 0.05) {
        btn.className = 'voice-pitch-preset-btn py-1.5 px-2 rounded-lg text-xs font-semibold bg-purple-600 text-white border border-purple-500/40 shadow-sm transition cursor-pointer';
      } else {
        btn.className = 'voice-pitch-preset-btn py-1.5 px-2 rounded-lg text-xs font-semibold bg-white/[0.04] hover:bg-white/[0.08] text-slate-300 border border-white/5 transition cursor-pointer';
      }
    });
  }

  document.querySelectorAll('.voice-speed-preset-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const r = parseFloat(btn.getAttribute('data-rate') || '1.0');
      if (sliderVoiceRate) sliderVoiceRate.value = r;
      localStorage.setItem('aetheria_voice_rate', r.toString());
