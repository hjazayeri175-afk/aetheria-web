    const imgSteps = Math.round(toAsciiNumber(localStorage.getItem('aetheria_image_steps'), 20));
    if (imageStepsInput) imageStepsInput.value = String(imgSteps);
    const imgCfg = toAsciiNumber(localStorage.getItem('aetheria_image_cfg'), 3.5);
    if (imageCfgInput) imageCfgInput.value = String(imgCfg);

    // 5. Video settings
    const vidProv = localStorage.getItem('aetheria_video_provider') || 'fal-kling';
    if (videoProviderSelect) videoProviderSelect.value = vidProv;
    const motion = localStorage.getItem('aetheria_video_motion') || '50';
    if (sliderMotion) sliderMotion.value = motion;
    if (badgeMotion) {
      if (badgeMotion.tagName === 'INPUT') badgeMotion.value = motion;
      else badgeMotion.textContent = motion;
    }

    // Sync Voice Autoplay state (Default: false / muted)
    ttsEnabled = localStorage.getItem('aetheria_voice_autoplay') === 'true';
    syncTtsUi();

    // 6. Sync UI and populate models
    syncProviderVisibility();
    syncImageUiPanels();
    syncVideoUiPanels();
  }

  // Adapt submenus & input fields dynamically based on selected provider
  function syncProviderVisibility() {
    const prov = textProviderSelect?.value || 'groq';
    const conf = PROVIDER_CONFIGS[prov] || PROVIDER_CONFIGS.groq;

    // API Key container
    if (apiKeyContainer) {
      apiKeyContainer.classList.toggle('hidden', !conf.hasKey);
    }
    const apiKeyLabelText = document.getElementById('api-key-label-text');
    if (apiKeyLabelText) {
      apiKeyLabelText.textContent = conf.isKeyOptional ? 'API Key (Optional)' : 'API Key';
    } else if (apiKeyLabel) {
      apiKeyLabel.textContent = conf.isKeyOptional ? 'API Key (Optional)' : 'API Key';
    }
    if (textApiKey) {
      textApiKey.placeholder = conf.keyPlaceholder || 'Paste API Key...';
    }
    if (getKeyLink && conf.keyLink) {
      getKeyLink.href = conf.keyLink;
      getKeyLink.classList.remove('hidden');
    } else if (getKeyLink) {
      getKeyLink.classList.add('hidden');
    }

    // Custom Base URL container
    if (customBaseUrlContainer) {
      customBaseUrlContainer.classList.toggle('hidden', !conf.hasUrl);
    }
    if (customBaseUrlLabel) {
      const labelSpan = customBaseUrlLabel.querySelector('span');
      if (labelSpan) labelSpan.textContent = conf.urlLabel || 'Server URL';
      else customBaseUrlLabel.textContent = conf.urlLabel || 'Server URL';
    }
    if (textBaseUrl) {
      textBaseUrl.placeholder = conf.urlPlaceholder || 'https://api.your-provider.com/v1';
    }
    if (customBaseUrlHint) {
      customBaseUrlHint.textContent = conf.urlHint || '';
    }

    // Model selection sync: load synced models or curated registry defaults
    const activeProfId = localStorage.getItem(ACTIVE_PROFILE_KEY);
    const profiles = getSavedApiProfiles();
    const activeProf = profiles.find(p => p.id === activeProfId && p.provider === prov);

    const requiresKey = conf.hasKey && !conf.isKeyOptional;
    const savedKey = (activeProf ? activeProf.apiKey : '') || localStorage.getItem('aetheria_key_' + prov) || localStorage.getItem('aetheria_text_key') || '';
    const savedUrl = (activeProf ? activeProf.baseUrl : '') || localStorage.getItem('aetheria_url_' + prov) || localStorage.getItem('aetheria_text_base_url') || conf.defaultUrl || '';
    const isConnected = !requiresKey || Boolean(savedKey.trim());

    if (textUnconnectedContainer && textConnectedContainer) {
      textUnconnectedContainer.classList.toggle('hidden', isConnected);
      textConnectedContainer.classList.toggle('hidden', !isConnected);
    }

    if (pingStatusMsg) pingStatusMsg.classList.add('hidden');

    if (!isConnected) {
      setEmptyModelDropdown();
      localStorage.removeItem('aetheria_text_model');
      if (pingProviderName) pingProviderName.textContent = conf.name;
      if (pingLatencyText) {
        pingLatencyText.textContent = '';
        pingLatencyText.classList.add('hidden');
      }
      if (pingIndicatorDot) pingIndicatorDot.className = 'w-2 h-2 rounded-full bg-amber-400';
    } else {
      let modelsList = [];
      if (activeProf && Array.isArray(activeProf.syncedModels) && activeProf.syncedModels.length > 0) {
        modelsList = activeProf.syncedModels;
      } else {
        const cachedModelsRaw = localStorage.getItem('aetheria_synced_models_' + prov);
        if (cachedModelsRaw) {
          try {
            modelsList = JSON.parse(cachedModelsRaw);
          } catch (e) {}
        }
        if (!Array.isArray(modelsList) || modelsList.length === 0) {
          modelsList = DEFAULT_PROVIDER_MODELS[prov] || ['default'];
        }
      }

      let targetModel = '';
      if (activeProf && activeProf.model) {
        targetModel = activeProf.model;
      } else {
        targetModel = localStorage.getItem('aetheria_model_' + prov) || localStorage.getItem('aetheria_text_model') || '';
      }

      const selectedModel = (targetModel && modelsList.includes(targetModel)) ? targetModel : modelsList[0];
      populateModelDropdown(modelsList, selectedModel, false);
      localStorage.setItem('aetheria_text_model', selectedModel);
      localStorage.setItem('aetheria_model_' + prov, selectedModel);

      // Connected Bar update
      if (pingProviderName) {
        pingProviderName.textContent = conf.name;
      }
      if (pingLatencyText) {
        pingLatencyText.classList.remove('hidden');
        pingLatencyText.className = 'text-[10px] px-2 py-0.5 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 font-mono font-medium shrink-0';
        if (!pingLatencyText.textContent || pingLatencyText.textContent.includes('•') || pingLatencyText.textContent === 'Offline') {
          pingLatencyText.textContent = 'Connected';
        }
      }
      if (pingIndicatorDot) {
        pingIndicatorDot.className = 'w-2 h-2 rounded-full bg-emerald-400 shrink-0';
      }
      if (textConnectedKeyMasked) {
        if (conf.hasUrl && !requiresKey) {
          textConnectedKeyMasked.textContent = savedUrl || 'Localhost';
        } else if (savedKey.trim()) {
          const keyTrimmed = savedKey.trim();
          const prefix = keyTrimmed.slice(0, 4);
          const suffix = keyTrimmed.slice(-4);
          textConnectedKeyMasked.textContent = `${prefix}••••${suffix}`;
        } else {
          textConnectedKeyMasked.textContent = '••••••••';
        }
      }
    }

    // Voice & Image tabs
    if (voiceKeyContainer && voiceProviderSelect) {
      voiceKeyContainer.classList.toggle('hidden', voiceProviderSelect.value === 'browser');
    }
    if (elevenVoiceContainer && voiceProviderSelect) {
      elevenVoiceContainer.classList.toggle('hidden', voiceProviderSelect.value !== 'elevenlabs');
    }
    if (openaiVoiceContainer && voiceProviderSelect) {
      openaiVoiceContainer.classList.toggle('hidden', voiceProviderSelect.value !== 'openai');
    }
    if (imageKeyContainer && imageProviderSelect) {
      imageKeyContainer.classList.toggle('hidden', imageProviderSelect.value === 'pollinations');
    }
  }

