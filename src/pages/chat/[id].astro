  let activeAudio = null;

  // Voice speech synthesis (ElevenLabs direct REST API or Browser Web Speech fallback)
  async function speak(text) {
    if (!ttsEnabled) return;
    const filterActions = localStorage.getItem('aetheria_voice_filter') !== 'false';
    let cleanText = text;
    if (filterActions) {
      cleanText = text.replace(/\*[^*]+\*/g, '').trim();
    }
    if (!cleanText) return;

    if (activeAudio) {
      activeAudio.pause();
      activeAudio = null;
    }
    if (window.speechSynthesis) {
      window.speechSynthesis.cancel();
    }

    const provider = localStorage.getItem('aetheria_voice_provider') || 'browser';
    const voiceKey = localStorage.getItem('aetheria_voice_key') || '';
    const voiceId = localStorage.getItem('aetheria_voice_id') || '21m00Tcm4TlvDq8ikWAM';

    if (provider === 'elevenlabs' && voiceKey) {
      try {
        const stability = parseFloat(localStorage.getItem('aetheria_voice_stability') || '0.5');
        const clarity = parseFloat(localStorage.getItem('aetheria_voice_clarity') || '0.75');
        const res = await fetch(`https://api.elevenlabs.io/v1/text-to-speech/${voiceId}`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'xi-api-key': voiceKey
          },
          body: JSON.stringify({
            text: cleanText.slice(0, 1500),
            model_id: 'eleven_multilingual_v2',
            voice_settings: {
              stability: stability,
              similarity_boost: clarity
            }
          })
        });
        if (res.ok) {
          const blob = await res.blob();
          const audioUrl = URL.createObjectURL(blob);
          activeAudio = new Audio(audioUrl);
          activeAudio.play();
          return;
        } else {
          console.warn('ElevenLabs API returned HTTP', res.status);
        }
      } catch (err) {
        console.warn('ElevenLabs speech error, falling back to browser:', err);
      }
    }

    // Browser Web Speech fallback
    if (window.speechSynthesis) {
      const utterance = new SpeechSynthesisUtterance(cleanText);
      utterance.rate = parseFloat(localStorage.getItem('aetheria_voice_rate') || '1.0');
      utterance.pitch = parseFloat(localStorage.getItem('aetheria_voice_pitch') || '1.0');
      utterance.lang = 'en-US';
      window.speechSynthesis.speak(utterance);
    }
  }

  // Build System Prompt with Dynamic Lorebook Injection - 100% Pure SillyTavern / Chub Spec
  function buildSystemPrompt(userText = '') {
    const { beforeCharContent, afterCharContent, triggeredNames } = scanAndInjectLorebook(userText, conversation);
    updateSidebarLoreTriggers(triggeredNames);

    let prompt = '';

    // Standard Main Prompt (Pure narrative framing without rigid corporate rules)
    prompt += `Write {{char}}'s next reply in this fictional roleplay with {{user}}.\n\n`;

    if (beforeCharContent) {
      prompt += `${beforeCharContent}\n\n`;
    }

    // Character Card Attributes (pure Tavern format)
    if (activeChar.description) prompt += `[Character: {{char}}]\n${activeChar.description}\n\n`;
    if (activeChar.personality) prompt += `[Personality: {{char}}]\n${activeChar.personality}\n\n`;
    if (activeChar.scenario) prompt += `[Scenario]\n${activeChar.scenario}\n\n`;
    if (activeChar.speechStyle) prompt += `[Speech Style: {{char}}]\n${activeChar.speechStyle}\n\n`;
    if (activeChar.systemPrompt) prompt += `${activeChar.systemPrompt}\n\n`;

    // Dialogue Examples
    if (activeChar.mesExample) {
      prompt += `<START>\n${activeChar.mesExample}\n\n`;
    }

    // User Persona
    prompt += `[User: {{user}}]\nName: ${activeUserPersona.name || 'User'}\n`;
    if (activeUserPersona.bio) prompt += `${activeUserPersona.bio}\n`;
    if (activeUserPersona.globalNotes) prompt += `${activeUserPersona.globalNotes}\n`;
    prompt += '\n';

    if (afterCharContent) {
      prompt += `${afterCharContent}\n\n`;
    }

    // Pinned Memory / Author's Note Injection
    const pinnedNoteKey = 'aetheria_pinned_note_' + (activeChar.id || character.id || 'default');
    const pinnedNote = localStorage.getItem(pinnedNoteKey) || '';
    if (pinnedNote.trim()) {
      prompt += `[Author's Note: ${pinnedNote.trim()}]\n\n`;
    }

    // Custom post history instructions from character card if present
    const charCustomPostHistory = activeChar.postHistoryInstructions || activeChar.post_history_instructions || '';
    if (charCustomPostHistory.trim()) {
      prompt += `${charCustomPostHistory.trim()}\n\n`;
    }

    return formatMacroText(prompt).trim();
  }

  // Send message & AI Generation with Real-time SSE Token Streaming
  async function handleSendMessage(userText) {
    if (!userText.trim()) return;

    const userMsg = {
      sender: 'user',
      text: userText.trim(),
      timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
    };

    conversation.push(userMsg);
    saveChat();
    appendMessageToDOM(userMsg, conversation.length - 1);
    if (chatStream) chatStream.scrollTop = chatStream.scrollHeight;

    if (input) {
      input.value = '';
      input.style.height = 'auto';
    }

    if (typingIndicator) {
      typingIndicator.classList.remove('hidden');
      if (chatStream) chatStream.scrollTop = chatStream.scrollHeight;
    }

    const provider = localStorage.getItem('aetheria_text_provider') || 'demo';
    const conf = PROVIDER_CONFIGS[provider] || PROVIDER_CONFIGS.demo;
    const apiKey = localStorage.getItem('aetheria_text_key') || '';
    let savedModel = localStorage.getItem('aetheria_text_model') || '';

    // Enforce 100% dynamic models - NEVER fall back to hardcoded legacy models
    if (provider !== 'demo') {
      if (!savedModel || savedModel.includes('No API connected') || savedModel === 'Free Cloud AI') {
        const cachedRaw = localStorage.getItem('aetheria_synced_models_' + provider);
        let cachedList = [];
        try { cachedList = JSON.parse(cachedRaw || '[]'); } catch (e) {}
        if (Array.isArray(cachedList) && cachedList.length > 0) {
          savedModel = cachedList[0];
          localStorage.setItem('aetheria_text_model', savedModel);
        } else if (apiKey) {
          try {
            const fetched = await fetchModelsForProvider(provider, apiKey);
            if (Array.isArray(fetched) && fetched.length > 0) {
              savedModel = fetched[0];
              localStorage.setItem('aetheria_text_model', savedModel);
            }
          } catch (e) {}
        }
      }

      if (!savedModel || savedModel.includes('No API connected') || savedModel === 'Free Cloud AI') {
        if (typingIndicator) typingIndicator.classList.add('hidden');
        const errAlert = {
          sender: 'character',
          text: `⚠️ **No Active Model Selected for ${conf.name}**\nPlease open Engine Settings (⚙️), enter your API key, and click **"Fetch Models"** to sync the active 2026 models directly from your provider account.`,
          timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
          swipes: [''],
          swipeIndex: 0
        };
        conversation.push(errAlert);
        appendMessageToDOM(errAlert, conversation.length - 1);
        return;
      }
    }
    const model = savedModel;
    const temp = parseFloat(localStorage.getItem('aetheria_text_temp') || '0.85');
    const maxTokens = Math.max(1024, parseInt(localStorage.getItem('aetheria_text_tokens') || '2048', 10));
    const topP = parseFloat(localStorage.getItem('aetheria_text_top_p') || '0.95');
    const enableStreaming = localStorage.getItem('aetheria_text_streaming') !== 'false';

    let replyText = '';

    // Direct LLM Call with Real-time Streaming & Resilient Fallbacks
    if ((apiKey || provider === 'custom-local') && provider !== 'demo') {
      try {
        let endpoint = conf.chatEndpoint;
        if (conf.hasUrl) {
          const rawBase = (localStorage.getItem('aetheria_text_base_url') || conf.defaultUrl || 'http://localhost:11434/v1').trim();
          let base = rawBase.replace(/\/+$/, '');
          if (base.endsWith('/chat/completions')) {
            endpoint = base;
          } else if (base.endsWith('/v1')) {
            endpoint = base + '/chat/completions';
          } else {
            endpoint = base + '/chat/completions';
          }
        } else if (provider === 'google') {
          endpoint = 'https://generativelanguage.googleapis.com/v1beta/openai/chat/completions';
        } else if (!endpoint) {
          endpoint = 'https://api.groq.com/openai/v1/chat/completions';
        }

        const systemPrompt = buildSystemPrompt(userText);
        const contextLimit = parseInt(localStorage.getItem('aetheria_text_context') || '16', 10);
        const historySlice = conversation
          .slice(-contextLimit)
          .filter(m => m.text && !isPoisonedOrErrorMessage(m.text))
          .map(m => ({
            role: m.sender === 'user' ? 'user' : 'assistant',
            content: m.text
          }));

        // Send clean user and assistant conversation history (pure dialogue without artificial prompt injection)
        const payloadMessages = historySlice.map(m => ({
          role: m.role,
          content: m.content
        }));

        let payload;
        let headers = { 'Content-Type': 'application/json' };

        if (apiKey) {
          if (provider === 'anthropic') {
            headers['x-api-key'] = apiKey;
            headers['anthropic-version'] = '2023-06-01';
            headers['anthropic-dangerous-direct-browser-access'] = 'true';
          } else if (provider === 'google') {
            headers['x-goog-api-key'] = apiKey;
            headers['Authorization'] = `Bearer ${apiKey}`;
          } else {
            headers['Authorization'] = `Bearer ${apiKey}`;
          }
        }

        if (provider === 'openrouter') {
          headers['HTTP-Referer'] = 'https://aetheria.ai';
          headers['X-Title'] = 'Aetheria AI';
        }

        if (provider === 'anthropic') {
          payload = {
            model: model,
            system: systemPrompt,
            messages: payloadMessages,
            max_tokens: maxTokens,
            temperature: temp,
            stream: enableStreaming
          };
        } else {
          payload = {
            model: model,
            messages: [{ role: 'system', content: systemPrompt }, ...payloadMessages],
            temperature: temp,
            max_tokens: maxTokens,
            top_p: topP,
            stream: enableStreaming
          };
        }

        let res;
        try {
          // Direct browser request first (100% transparent client like SillyTavern — user's own IP & network)
          res = await fetch(endpoint, {
            method: 'POST',
            headers,
            body: JSON.stringify(payload)
          });
        } catch (directErr) {
          console.warn('Direct browser fetch blocked or failed, attempting Edge Relay fallback:', directErr);
          // Fallback to Edge Proxy ONLY if direct browser request fails due to CORS or local network restrictions
          res = await fetch('/api/proxy/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              endpoint,
              apiKey,
              body: payload,
              headers: provider === 'openrouter' ? { 'HTTP-Referer': 'https://aetheria.ai', 'X-Title': 'Aetheria AI' } : {}
            })
          });
          if (res.status === 429) {
            await new Promise(r => setTimeout(r, 2500));
            res = await fetch('/api/proxy/chat', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                endpoint,
                apiKey,
                body: payload,
                headers: provider === 'openrouter' ? { 'HTTP-Referer': 'https://aetheria.ai', 'X-Title': 'Aetheria AI' } : {}
              })
            });
          }
        }

        if (res.ok) {
          if (typingIndicator) typingIndicator.classList.add('hidden');

          // Check if response is streamable
          if (enableStreaming && res.body) {
            const charMsg = {
              sender: 'character',
              text: '',
              timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
              swipes: [''],
              swipeIndex: 0
            };
            conversation.push(charMsg);
            const msgIdx = conversation.length - 1;
            appendMessageToDOM(charMsg, msgIdx);
            const bubbleEl = document.getElementById(`msg-bubble-${msgIdx}`);

            const reader = res.body.getReader();
            const decoder = new TextDecoder('utf-8');
            let buffer = '';
            let rawAccumulated = '';
            let contentText = '';
            let reasoningText = '';

            try {
              while (true) {
                const { done, value } = await reader.read();
                if (done) break;
                const chunk = decoder.decode(value, { stream: true });
                rawAccumulated += chunk;
                buffer += chunk;
                const lines = buffer.split('\n');
                buffer = lines.pop() || '';

                for (const line of lines) {
                  const trimmed = line.trim();
                  if (trimmed.startsWith('data: ')) {
                    const dataStr = trimmed.slice(6);
                    if (dataStr === '[DONE]') continue;
                    try {
                      const parsed = JSON.parse(dataStr);
                      const c = parsed.choices?.[0];

                      // 1. Content token
                      const contentToken = c?.delta?.content 
                        || c?.delta?.text 
                        || c?.text 
                        || c?.message?.content 
                        || parsed.delta?.content 
                        || parsed.delta?.text 
                        || parsed.response 
                        || parsed.content 
                        || '';

                      // 2. Reasoning / Thinking token (DeepSeek R1/V4, Qwen, Ollama, OpenRouter)
                      const reasoningToken = c?.delta?.reasoning_content 
                        || c?.delta?.reasoning 
                        || c?.delta?.thought 
                        || c?.delta?.thinking 
                        || c?.delta?.reasoning_details 
                        || c?.message?.reasoning_content 
                        || parsed.thinking 
                        || '';

                      if (reasoningToken) {
                        reasoningText += reasoningToken;
                      }
                      if (contentToken) {
                        contentText += contentToken;
                      }

                      // Update live bubble in real-time
                      if (bubbleEl) {
                        if (contentText) {
                          let display = '';
                          if (reasoningText.trim()) {
                            display = `<details class="mb-3 rounded-lg border border-purple-500/20 bg-purple-950/20 px-3 py-2 text-xs text-purple-300 select-none"><summary class="cursor-pointer font-medium hover:text-purple-200">💭 روند تفکر (${reasoningText.length} کاراکتر)</summary><div class="mt-2 text-slate-300 font-mono text-[11px] leading-relaxed whitespace-pre-wrap">${reasoningText}</div></details>\n\n${contentText}`;
                          } else {
                            display = contentText;
                          }
                          charMsg.text = display;
                          charMsg.swipes[0] = display;
                          bubbleEl.innerHTML = formatMessageText(display);
                        } else if (reasoningText) {
                          bubbleEl.innerHTML = `<div class="flex items-center gap-2 text-xs text-purple-400 italic mb-2 animate-pulse"><span>💭</span><span>در حال تفکر و پردازش نقش...</span></div><div class="text-xs text-slate-400 font-mono leading-relaxed line-clamp-4 whitespace-pre-wrap border-l-2 border-purple-500/40 pl-2">${reasoningText}</div>`;
                        }
                        if (chatStream) chatStream.scrollTop = chatStream.scrollHeight;
                      }
                    } catch (e) {}
                  }
                }
              }
            } catch (streamErr) {
              console.warn('Stream read error:', streamErr);
            }

            // Combine content and reasoning
            if (contentText && reasoningText.trim()) {
              replyText = `<details class="mb-3 rounded-lg border border-purple-500/20 bg-purple-950/20 px-3 py-2 text-xs text-purple-300 select-none"><summary class="cursor-pointer font-medium hover:text-purple-200">💭 روند تفکر (${reasoningText.length} کاراکتر)</summary><div class="mt-2 text-slate-300 font-mono text-[11px] leading-relaxed whitespace-pre-wrap">${reasoningText}</div></details>\n\n${contentText}`;
            } else {
              replyText = contentText || reasoningText;
            }

            // Fallback JSON parser if provider returned non-SSE JSON response
            if (!replyText.trim()) {
              const fullText = (rawAccumulated + buffer).trim();
              if (fullText.startsWith('{') || fullText.startsWith('[')) {
                try {
                  const json = JSON.parse(fullText);
                  const choice = json.choices?.[0];
                  const cText = choice?.message?.content || choice?.text || (json.content && json.content[0] && json.content[0].text) || json.response || '';
                  const rText = choice?.message?.reasoning_content || choice?.message?.reasoning || choice?.message?.thought || choice?.message?.thinking || '';
                  if (cText && rText) {
                    replyText = `<details class="mb-3 rounded-lg border border-purple-500/20 bg-purple-950/20 px-3 py-2 text-xs text-purple-300 select-none"><summary class="cursor-pointer font-medium hover:text-purple-200">💭 روند تفکر</summary><div class="mt-2 text-slate-300 font-mono text-[11px] leading-relaxed whitespace-pre-wrap">${rText}</div></details>\n\n${cText}`;
                  } else {
                    replyText = cText || rText;
                  }
                  if (json.error) {
                    throw new Error(json.error.message || json.error.code || JSON.stringify(json.error));
                  }
                } catch (jsonErr) {
                  if (jsonErr.message && !jsonErr.message.includes('JSON')) {
                    throw jsonErr;
                  }
                }
              }
            }

            if (replyText.trim()) {
              charMsg.text = replyText;
              charMsg.swipes[0] = replyText;
              if (bubbleEl) {
                bubbleEl.innerHTML = formatMessageText(replyText);
              }
              saveChat();
            } else {
              charMsg.text = '*(مدل پاسخی ارسال نکرد - اتصال یا تنظیمات توکن را بررسی کنید)*';
              charMsg.swipes[0] = charMsg.text;
              if (bubbleEl) {
                bubbleEl.innerHTML = formatMessageText(charMsg.text);
              }
              saveChat();
            }
          } else {
            // Standard non-streaming JSON mode
            const data = await res.json();
            const choice = data.choices?.[0];
            const cText = choice?.message?.content 
              || choice?.text 
              || (data.content && data.content[0] && data.content[0].text) 
              || data.response 
              || '';
            const rText = choice?.message?.reasoning_content 
              || choice?.message?.reasoning 
              || choice?.message?.thought 
              || choice?.message?.thinking 
              || '';

            if (cText && rText) {
              replyText = `<details class="mb-3 rounded-lg border border-purple-500/20 bg-purple-950/20 px-3 py-2 text-xs text-purple-300 select-none"><summary class="cursor-pointer font-medium hover:text-purple-200">💭 روند تفکر</summary><div class="mt-2 text-slate-300 font-mono text-[11px] leading-relaxed whitespace-pre-wrap">${rText}</div></details>\n\n${cText}`;
            } else {
              replyText = cText || rText;
            }

            if (!replyText.trim()) {
              if (data.error) {
                throw new Error(data.error.message || JSON.stringify(data.error));
              }
              replyText = '*(مدل پاسخی ارسال نکرد - اتصال یا تنظیمات توکن را بررسی کنید)*';
            }
            const charMsg = {
              sender: 'character',
              text: replyText,
              timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
              swipes: [replyText],
              swipeIndex: 0
            };
            conversation.push(charMsg);
            saveChat();
            appendMessageToDOM(charMsg, conversation.length - 1);
          }
        } else {
          console.warn('API returned non-OK status', res.status);
          let errDetail = '';
          try {
            const errData = await res.json();
            errDetail = errData.error?.message || errData.message || (typeof errData.error === 'string' ? errData.error : '');
          } catch {}
          if (!errDetail) errDetail = `Server returned HTTP ${res.status}`;
          
          if (typingIndicator) typingIndicator.classList.add('hidden');

          let guidance = '';
          const lowerErr = errDetail.toLowerCase();
          if (res.status === 402 || lowerErr.includes('credit') || lowerErr.includes('payment') || lowerErr.includes('balance')) {
            guidance = `\n\n💡 **Solution (Insufficient Credits):**\nThe model \`${model}\` is a paid model requiring account balance on ${conf.name}.\n👉 You can switch to a **FREE model** right now: Open Settings (⚙️) → Tap Model → Click **"🎁 Free (:free)"** and select a free model (e.g. \`meta-llama/llama-3.3-70b-instruct:free\`).\n👉 Or add credits on [openrouter.ai/credits](https://openrouter.ai/credits).`;
          } else if (res.status === 401 || lowerErr.includes('auth') || lowerErr.includes('user not found') || lowerErr.includes('api key')) {
            guidance = `\n\n💡 **Solution (Invalid Key):**\nPlease open Engine Settings (⚙️), paste your valid API key from ${conf.name} (starting with sk-or-v1-...), and click **"Save Engine Settings"**.`;
          } else if (res.status === 429 || lowerErr.includes('rate limit') || lowerErr.includes('provider returned error') || lowerErr.includes('too many requests')) {
            guidance = `\n\n💡 **Solution (Rate Limit / Overloaded Upstream Server):**\n1. **Switch to another free model:** The free server for \`${model}\` is currently congested. Open Settings (⚙️) → Tap Model → Choose \`google/gemini-2.0-flash-exp:free\` or \`qwen/qwen-2.5-72b-instruct:free\` (they have much higher capacity).\n2. **Free tier limit:** OpenRouter caps free accounts at 50 messages/day. You can switch to **Groq** (free, instant 300 t/s) or **Google Gemini** in Settings.\n3. **OpenRouter Setting:** Make sure "Allow training on inputs" is enabled in your OpenRouter Account Settings (required for free models).`;
          }

          const errorMsg = {
            sender: 'character',
            text: `⚠️ **API Error (${conf.name} - HTTP ${res.status}):** ${errDetail}${guidance}`,
            timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
            swipes: [`⚠️ **API Error (${conf.name} - HTTP ${res.status}):** ${errDetail}${guidance}`],
            swipeIndex: 0
          };
          conversation.push(errorMsg);
          saveChat();
          appendMessageToDOM(errorMsg, conversation.length - 1);
          if (chatStream) chatStream.scrollTop = chatStream.scrollHeight;
          return;
        }
      } catch (err) {
        console.warn('API call failed', err);
        if (typingIndicator) typingIndicator.classList.add('hidden');
        const errorMsg = {
          sender: 'character',
          text: `⚠️ **Connection Error (${conf.name}):** ${err.message || 'Network request failed'}\n\n*Check your network connection or API endpoint configuration in Settings.*`,
          timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
          swipes: [`⚠️ **Connection Error (${conf.name}):** ${err.message || 'Network request failed'}`],
          swipeIndex: 0
        };
        conversation.push(errorMsg);
        saveChat();
        appendMessageToDOM(errorMsg, conversation.length - 1);
        if (chatStream) chatStream.scrollTop = chatStream.scrollHeight;
        return;
      }
    }

    // Fallback response generator ONLY if provider is explicitly 'demo'
    if (!replyText && provider === 'demo') {
      if (typingIndicator) typingIndicator.classList.remove('hidden');
      try {
        const sysPrompt = buildSystemPrompt(userText);
        const demoHistory = conversation.slice(-8)
          .filter(m => m.text && !isPoisonedOrErrorMessage(m.text))
          .map(m => ({
            role: m.sender === 'user' ? 'user' : 'assistant',
            content: m.text
          }));
        const demoRes = await fetch('/api/chat/demo', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            messages: [
              { role: 'system', content: sysPrompt },
              ...demoHistory
            ]
          }),
          signal: AbortSignal.timeout(15000)
        });
        if (demoRes.ok) {
          const demoData = await demoRes.json();
          replyText = (demoData.response || demoData.choices?.[0]?.message?.content || '').trim();
        }
      } catch (e) {
        console.warn('Free Cloud fallback error:', e);
      }

      if (!replyText) {
        await new Promise(r => setTimeout(r, 400));
        replyText = pickResponse(userText);
      }

      if (typingIndicator) typingIndicator.classList.add('hidden');
      const charMsg = {
        sender: 'character',
        text: replyText,
        timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
        swipes: [replyText],
        swipeIndex: 0
      };
      conversation.push(charMsg);
      saveChat();
      appendMessageToDOM(charMsg, conversation.length - 1);
      if (chatStream) chatStream.scrollTop = chatStream.scrollHeight;
    }

    if (typingIndicator) typingIndicator.classList.add('hidden');

    if (ttsEnabled || localStorage.getItem('aetheria_voice_autoplay') === 'true') {
      speak(replyText);
    }

    // Trigger Contextual Smart Prompts Generation
    fetchDynamicSuggestions(replyText);
  }

  function pickResponse(userText) {
    const replies = activeChar.fallbackReplies || character.fallbackReplies || [];
    if (replies.length === 0) {
      return formatMacroText(`*Smiles faintly and leans in closer.* "Your thoughts resonate with an intriguing cadence, {{user}}. Tell me what else is on your mind."`);
    }
    const idx = Math.floor(Math.random() * replies.length);
    return formatMacroText(replies[idx]);
  }

  // Generate Alternative Swipe Variation
  async function generateNewSwipe(msgIdx) {
    const msg = conversation[msgIdx];
    if (!msg || msg.sender !== 'character') return;

    showNotification('✨ Generating alternative response variation...');
    if (typingIndicator) typingIndicator.classList.remove('hidden');

    const provider = localStorage.getItem('aetheria_text_provider') || 'demo';
    const apiKey = localStorage.getItem('aetheria_text_key') || '';
    let model = localStorage.getItem('aetheria_text_model') || '';
    if (!model && provider !== 'demo') {
      const cached = localStorage.getItem('aetheria_synced_models_' + provider);
      try {
        const list = JSON.parse(cached || '[]');
        if (list.length > 0) model = list[0];
      } catch (e) {}
    }
    if (!model && provider !== 'demo') {
      if (typingIndicator) typingIndicator.classList.add('hidden');
      showNotification('⚠️ Please select an active model in Settings first.');
      return;
    }
    const temp = Math.min(1.2, parseFloat(localStorage.getItem('aetheria_text_temp') || '0.85') + 0.15); // higher temperature for variety
    const maxTokens = Math.max(1024, parseInt(localStorage.getItem('aetheria_text_tokens') || '2048', 10));

    let newReply = '';

    if ((apiKey || provider === 'custom-local') && provider !== 'demo') {
      try {
        const conf = PROVIDER_CONFIGS[provider] || PROVIDER_CONFIGS.demo;
        let endpoint = conf.chatEndpoint;
        if (conf.hasUrl) {
          const base = localStorage.getItem('aetheria_text_base_url') || conf.defaultUrl || 'http://localhost:11434/v1';
          endpoint = base.replace(/\/+$/, '') + '/chat/completions';
        } else if (provider === 'google') {
          endpoint = 'https://generativelanguage.googleapis.com/v1beta/openai/chat/completions';
        } else if (!endpoint) {
          endpoint = 'https://api.groq.com/openai/v1/chat/completions';
        }

        const lastUserMsg = conversation.slice(0, msgIdx).reverse().find(m => m.sender === 'user');
        const systemPrompt = buildSystemPrompt(lastUserMsg ? lastUserMsg.text : '');
        const historySlice = conversation.slice(0, msgIdx)
          .filter(m => m.text && !isPoisonedOrErrorMessage(m.text))
          .map(m => ({
            role: m.sender === 'user' ? 'user' : 'assistant',
            content: m.text
          }));

        // Send clean swipe history
        const payloadMessages = historySlice.map(m => ({
          role: m.role,
          content: m.content
        }));

        let payload;
        let headers = { 'Content-Type': 'application/json' };

        if (apiKey) {
          if (provider === 'anthropic') {
            headers['x-api-key'] = apiKey;
            headers['anthropic-version'] = '2023-06-01';
            headers['anthropic-dangerous-direct-browser-access'] = 'true';
          } else if (provider === 'google') {
            headers['x-goog-api-key'] = apiKey;
            headers['Authorization'] = `Bearer ${apiKey}`;
          } else {
            headers['Authorization'] = `Bearer ${apiKey}`;
          }
        }

        if (provider === 'openrouter') {
          headers['HTTP-Referer'] = 'https://aetheria.ai';
          headers['X-Title'] = 'Aetheria AI';
        }

        if (provider === 'anthropic') {
          payload = {
            model: model,
            system: systemPrompt,
            messages: payloadMessages,
            max_tokens: maxTokens,
            temperature: temp
          };
        } else {
          payload = {
            model: model,
            messages: [{ role: 'system', content: systemPrompt }, ...payloadMessages],
            temperature: temp,
            max_tokens: maxTokens
          };
        }

        let res;
        try {
          res = await fetch(endpoint, {
            method: 'POST',
            headers,
            body: JSON.stringify(payload)
          });
        } catch (directErr) {
          res = await fetch('/api/proxy/chat', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              endpoint,
              apiKey,
              body: payload,
              headers: provider === 'openrouter' ? { 'HTTP-Referer': 'https://aetheria.ai', 'X-Title': 'Aetheria AI' } : {}
            })
          });
        }

        if (res.ok) {
          const data = await res.json();
          if (provider === 'anthropic') {
            newReply = data.content?.[0]?.text || '';
          } else {
            const choice = data.choices?.[0];
            const cText = choice?.message?.content 
              || choice?.text 
              || (data.content && data.content[0] && data.content[0].text) 
              || data.response 
              || '';
            const rText = choice?.message?.reasoning_content 
              || choice?.message?.reasoning 
              || choice?.message?.thought 
              || choice?.message?.thinking 
              || '';
            if (cText && rText) {
              newReply = `<details class="mb-3 rounded-lg border border-purple-500/20 bg-purple-950/20 px-3 py-2 text-xs text-purple-300 select-none"><summary class="cursor-pointer font-medium hover:text-purple-200">💭 روند تفکر (${rText.length} کاراکتر)</summary><div class="mt-2 text-slate-300 font-mono text-[11px] leading-relaxed whitespace-pre-wrap">${rText}</div></details>\n\n${cText}`;
            } else {
              newReply = cText || rText;
            }
          }
        }
      } catch (err) {}
    }

    if (!newReply) {
      try {
        const lastUserMsg = conversation.slice(0, msgIdx).reverse().find(m => m.sender === 'user');
        const systemPrompt = buildSystemPrompt(lastUserMsg ? lastUserMsg.text : '');
        const historySlice = conversation.slice(0, msgIdx)
          .filter(m => m.text && !isPoisonedOrErrorMessage(m.text))
          .map(m => ({
            role: m.sender === 'user' ? 'user' : 'assistant',
            content: m.text
          }));
        const demoRes = await fetch('/api/chat/demo', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            messages: [{ role: 'system', content: systemPrompt }, ...historySlice]
          }),
          signal: AbortSignal.timeout(12000)
        });
        if (demoRes.ok) {
          const demoData = await demoRes.json();
          newReply = (demoData.response || demoData.choices?.[0]?.message?.content || '').trim();
        }
      } catch (e) {}
    }

    if (!newReply) {
      await new Promise(r => setTimeout(r, 600));
      newReply = pickResponse('');
    }

    if (typingIndicator) typingIndicator.classList.add('hidden');

    if (!msg.swipes) msg.swipes = [msg.text];
    msg.swipes.push(newReply);
    msg.swipeIndex = msg.swipes.length - 1;
    msg.text = newReply;

    saveChat();
    renderAllMessages();
    showNotification(`Swipe ${msg.swipeIndex + 1}/${msg.swipes.length} ready!`);
    fetchDynamicSuggestions(newReply);
  }

  // Handle Swipe Navigation
  function handleSwipeNavigation(msgIdx, action) {
    const msg = conversation[msgIdx];
    if (!msg || !msg.swipes) return;

    if (action === 'prev') {
      if ((msg.swipeIndex || 0) > 0) {
        msg.swipeIndex--;
        msg.text = msg.swipes[msg.swipeIndex];
        saveChat();
        renderAllMessages();
        fetchDynamicSuggestions(msg.text);
      }
    } else if (action === 'next') {
      const nextIdx = (msg.swipeIndex || 0) + 1;
      if (nextIdx < msg.swipes.length) {
        msg.swipeIndex = nextIdx;
        msg.text = msg.swipes[msg.swipeIndex];
        saveChat();
        renderAllMessages();
        fetchDynamicSuggestions(msg.text);
      } else if (msgIdx === 0 && msg.swipes.length > 1) {
        // Loop back to Scenario 1 when swiping past the last scenario on initial greeting
        msg.swipeIndex = 0;
        msg.text = msg.swipes[0];
        saveChat();
        renderAllMessages();
        fetchDynamicSuggestions(msg.text);
        showNotification('Cycled to Scenario 1');
      } else if (msgIdx === conversation.length - 1) {
        generateNewSwipe(msgIdx);
      }
    }
  }

  // Inline Message Editing
  function enableEditMessage(idx) {
    const msg = conversation[idx];
    if (!msg) return;

    const bubble = document.getElementById(`msg-bubble-${idx}`);
    if (!bubble) return;

    const safeText = (msg.text || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

    bubble.innerHTML = `
      <div class="space-y-2 w-full animate-in fade-in duration-200">
        <textarea id="edit-textarea-${idx}" rows="4" class="w-full p-3 rounded-xl bg-[#080a18] border border-purple-500/60 text-white text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-purple-400 resize-y leading-relaxed font-sans">${safeText}</textarea>
        <div class="flex items-center justify-between text-[11px] text-slate-400">
          <span>Press <kbd class="px-1.5 py-0.5 rounded bg-white/10 text-slate-300 font-mono text-[10px]">Ctrl+Enter</kbd> to save, <kbd class="px-1.5 py-0.5 rounded bg-white/10 text-slate-300 font-mono text-[10px]">Esc</kbd> to cancel</span>
          <div class="flex items-center gap-2">
            <button id="cancel-edit-${idx}" type="button" class="px-3 py-1.5 rounded-xl bg-white/[0.06] hover:bg-white/[0.1] text-xs text-slate-300 transition cursor-pointer">Cancel</button>
            <button id="save-edit-${idx}" type="button" class="px-4 py-1.5 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 text-xs font-bold text-white transition shadow-sm cursor-pointer">Save Changes</button>
          </div>
        </div>
      </div>
    `;

    const textarea = document.getElementById(`edit-textarea-${idx}`);
    if (textarea) {
      textarea.focus();
      textarea.setSelectionRange(textarea.value.length, textarea.value.length);
      textarea.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
          e.preventDefault();
          document.getElementById(`save-edit-${idx}`)?.click();
        } else if (e.key === 'Escape') {
          e.preventDefault();
          renderAllMessages();
        }
      });
    }

    document.getElementById(`cancel-edit-${idx}`)?.addEventListener('click', () => {
      renderAllMessages();
    });

    document.getElementById(`save-edit-${idx}`)?.addEventListener('click', () => {
      if (textarea && textarea.value.trim()) {
        const val = textarea.value.trim();
        msg.text = val;
        if (msg.swipes && msg.swipeIndex !== undefined) {
          msg.swipes[msg.swipeIndex] = val;
        }
        saveChat();
        renderAllMessages();
        showNotification('Message updated.');
      }
    });
  }

  // Rewind Turn Function
  function rewindTurn(idx) {
    const msg = conversation[idx];
    if (!msg) return;

    if (!confirm('Rewind conversation to this turn? Subsequent messages will be removed.')) return;

    let restoredPrompt = '';
    if (msg.sender === 'user') {
      restoredPrompt = msg.text;
      conversation = conversation.slice(0, idx);
    } else {
      // Find the user message before this character reply
      if (idx > 0 && conversation[idx - 1].sender === 'user') {
        restoredPrompt = conversation[idx - 1].text;
        conversation = conversation.slice(0, idx - 1);
      } else {
        conversation = conversation.slice(0, idx);
      }
    }

    saveChat();
    renderAllMessages();

    if (input && restoredPrompt) {
      input.value = restoredPrompt;
      input.focus();
    }
    showNotification('Chat rewound! Prompt restored to input box.');
  }

  // Contextual Image Prompt Synthesizer
  function buildContextualSelfiePrompt() {
    const recent = conversation.slice(-3);
    let actions = [];
    recent.forEach(m => {
      const matched = m.text.match(/\*[^*]+\*/g);
      if (matched) actions.push(...matched.map(a => a.replace(/\*/g, '')));
    });

    const actionText = actions.slice(-2).join(', ');
    const charName = activeChar.name;
    const charTitle = activeChar.title || 'character';
    const charDesc = (activeChar.description || '').slice(0, 140);
    const scenario = (activeChar.scenario || '').slice(0, 100);

    return `Candid smartphone selfie photograph of ${charName}, ${charTitle}. Visual appearance: ${charDesc}. Action & expression: ${actionText || 'looking warmly into the camera, gentle smile'}. Environment setting: ${scenario || 'atmospheric cinematic scene'}. Award-winning photography, detailed face, photorealistic, 8k resolution.`;
  }

  // Contextual Video Motion Prompt Synthesizer
  function buildContextualVideoPrompt() {
    const recent = conversation.slice(-2);
    let actions = [];
    recent.forEach(m => {
      const matched = m.text.match(/\*[^*]+\*/g);
      if (matched) actions.push(...matched.map(a => a.replace(/\*/g, '')));
    });

    const actionText = actions.slice(-1).join('');
    const charName = activeChar.name;
    const charDesc = (activeChar.description || '').slice(0, 120);

    return `Cinematic 4k video of ${charName}, ${charDesc}. Dynamic action: ${actionText || 'looking towards camera, natural facial expressions and gentle head movement'}, highly detailed, photorealistic lighting, fluid 60fps motion.`;
  }

  // Selfie / Photo Generation
  async function handleGenerateSelfie() {
    const prompt = buildContextualSelfiePrompt();
    const imageProvider = localStorage.getItem('aetheria_image_provider') || 'pollinations';
    const falKey = localStorage.getItem('aetheria_fal_key') || localStorage.getItem('aetheria_api_key_fal');
    const openaiKey = localStorage.getItem('aetheria_api_key_openai');

    if (imageProvider === 'fal' && !falKey) {
      showNotification('⚠️ Fal Flux requires an API Key. Opening settings...');
      byokTray?.classList.remove('hidden');
      document.querySelector('[data-engine-tab="image"]')?.click();
      return;
    }
    if (imageProvider === 'dalle' && !openaiKey) {
      showNotification('⚠️ DALL-E 3 requires an OpenAI API Key. Opening settings...');
      byokTray?.classList.remove('hidden');
      document.querySelector('[data-engine-tab="image"]')?.click();
      return;
    }

    showNotification('📷 Capturing scene selfie...');

    const pendingId = 'selfie_' + Date.now();
    const placeholderMsg = {
      sender: 'character',
      text: `*Snaps a candid selfie:* "${activeChar.name}"`,
      timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
      mediaType: 'image_generating',
      mediaPrompt: prompt,
      pendingId: pendingId
    };
    conversation.push(placeholderMsg);
    saveChat();
    renderAllMessages();

    try {
      let finalUrl = '';
      if (imageProvider === 'pollinations' || !falKey) {
        const encoded = encodeURIComponent(prompt);
        finalUrl = `https://image.pollinations.ai/prompt/${encoded}?width=768&height=1024&nologo=true&seed=${Date.now()}`;
      } else if (imageProvider === 'fal' && falKey) {
        const res = await fetch('https://queue.fal.run/fal-ai/flux/schnell', {
          method: 'POST',
          headers: {
            'Authorization': `Key ${falKey}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ prompt: prompt, image_size: "portrait_4_3" })
        });
        const data = await res.json();
        finalUrl = data.images?.[0]?.url || '';
      }

      if (finalUrl) {
        placeholderMsg.mediaType = 'image';
        placeholderMsg.mediaUrl = finalUrl;
        delete placeholderMsg.pendingId;
        saveChat();
        renderAllMessages();
        showNotification('📷 Photo delivered!');
      } else {
        throw new Error('Image URL could not be resolved.');
      }
    } catch (err) {
      showNotification(`Photo error: ${err.message}`);
      conversation = conversation.filter(m => m.pendingId !== pendingId);
      saveChat();
      renderAllMessages();
    }
  }

  // Living Video Generation (BYOK Protected)
  async function handleGenerateVideo() {
    const falKey = localStorage.getItem('aetheria_fal_key') || localStorage.getItem('aetheria_api_key_fal');
    const lumaKey = localStorage.getItem('aetheria_luma_key');

    // Strict Gatekeeper: Only available for users who provided API Key
    if (!falKey && !lumaKey) {
      showNotification('⚠️ Living Video requires an API Key (Fal.ai Kling or Luma). Opening settings...');
      byokTray?.classList.remove('hidden');
      document.querySelector('[data-engine-tab="video"]')?.click();
      return;
    }

    const prompt = buildContextualVideoPrompt();
    showNotification('🎬 Requesting Living Video render...');

    const pendingId = 'video_' + Date.now();
    const placeholderMsg = {
      sender: 'character',
      text: `*Sends living video clip:* "${activeChar.name} in motion"`,
      timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
      mediaType: 'video_generating',
      mediaPrompt: prompt,
      pendingId: pendingId
    };
    conversation.push(placeholderMsg);
    saveChat();
    renderAllMessages();

    try {
      if (falKey) {
        const avatarFullUrl = activeChar.avatarUrl.startsWith('http') 
          ? activeChar.avatarUrl 
          : `${window.location.origin}${activeChar.avatarUrl}`;

        const res = await fetch('https://queue.fal.run/fal-ai/kling-video/v1.5/pro/image-to-video', {
          method: 'POST',
          headers: {
            'Authorization': `Key ${falKey}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            prompt: prompt,
            image_url: avatarFullUrl,
            duration: "5",
            aspect_ratio: "16:9"
          })
        });

        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          throw new Error(err.detail || err.message || `HTTP ${res.status}`);
        }

        const data = await res.json();
        const requestId = data.request_id;
        showNotification('Rendering video frames on Fal cluster...');

        let videoUrl = '';
        for (let i = 0; i < 25; i++) {
          await new Promise(r => setTimeout(r, 4000));
          const checkRes = await fetch(`https://queue.fal.run/fal-ai/kling-video/requests/${requestId}/status`, {
            headers: { 'Authorization': `Key ${falKey}` }
          });
          if (checkRes.ok) {
            const checkData = await checkRes.json();
            if (checkData.status === 'COMPLETED') {
              const resFinal = await fetch(`https://queue.fal.run/fal-ai/kling-video/requests/${requestId}`, {
                headers: { 'Authorization': `Key ${falKey}` }
              });
              const finalData = await resFinal.json();
              videoUrl = finalData.video?.url || '';
              break;
            } else if (checkData.status === 'FAILED') {
              throw new Error('Fal GPU render failed.');
            }
          }
        }

        if (videoUrl) {
          placeholderMsg.mediaType = 'video';
          placeholderMsg.mediaUrl = videoUrl;
          delete placeholderMsg.pendingId;
          saveChat();
          renderAllMessages();
          showNotification('🎬 Living Video ready!');
        } else {
          throw new Error('Render timed out.');
        }
      }
    } catch (err) {
      showNotification(`Video error: ${err.message}`);
      conversation = conversation.filter(m => m.pendingId !== pendingId);
      saveChat();
      renderAllMessages();
    }
  }

  // Toolbar Actions Listeners
