  // Dynamic STT Models Fetch & Rendering
  let isFetchingSttModels = false;

  function renderDynamicSttModels() {
    if (!sttModelMenu) return;
    const prov = localStorage.getItem('aetheria_stt_provider') || 'groq';
    if (prov === 'browser-stt') return;

    // Do NOT render models if key is missing!
    const key = getSttKeyForProvider(prov);
    const customUrl = localStorage.getItem('aetheria_stt_custom_url');
    if (!key && !customUrl) {
      sttModelMenu.innerHTML = '';
      if (sttModelTriggerLabel) sttModelTriggerLabel.textContent = 'Connect key first';
      return;
    }

    const engObj = ALL_STT_ENGINES.find(e => e.id === prov) || ALL_STT_ENGINES[1];
    const currentModel = localStorage.getItem('aetheria_stt_model') || engObj.defaultModel || 'whisper-large-v3-turbo';

    let models = [];
    try {
      const cached = localStorage.getItem('aetheria_cached_stt_models_' + prov);
      if (cached) models = JSON.parse(cached);
    } catch (e) {}

    if (!Array.isArray(models) || models.length === 0) {
      models = engObj.models || [{ id: currentModel, label: currentModel }];
    }

    if (sttModelTriggerLabel) {
      const activeObj = models.find(m => (typeof m === 'string' ? m : m.id) === currentModel);
      sttModelTriggerLabel.textContent = activeObj ? (typeof activeObj === 'string' ? activeObj : (activeObj.label || activeObj.id)) : currentModel;
    }

    sttModelMenu.innerHTML = models.map(m => {
      const id = typeof m === 'string' ? m : m.id;
      const label = typeof m === 'string' ? m : (m.label || m.id);
      const isSelected = id === currentModel;
      return `
        <button 
          type="button" 
          class="w-full px-3 py-2 rounded-lg text-left transition flex items-center justify-between text-xs cursor-pointer ${
            isSelected 
              ? 'bg-rose-600/20 text-white font-bold border border-rose-500/30' 
              : 'hover:bg-white/[0.06] text-slate-300 hover:text-white border border-transparent'
          }"
          onclick="selectSttModel('${id}')"
          role="option"
          aria-selected="${isSelected}"
        >
          <span class="truncate">${label}</span>
          ${isSelected ? '<span class="text-rose-400 font-bold">✓</span>' : ''}
        </button>
      `;
    }).join('');
  }

