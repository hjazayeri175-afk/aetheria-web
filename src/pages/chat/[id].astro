  function adjustInputHeight() {
    if (!input) return;
    input.style.height = 'auto';

    const computed = window.getComputedStyle(input);
    const fontSize = parseFloat(computed.fontSize) || 14;
    const lineHeight = parseFloat(computed.lineHeight) || (fontSize * 1.5);
    const paddingTop = parseFloat(computed.paddingTop) || 6;
    const paddingBottom = parseFloat(computed.paddingBottom) || 6;

    const singleLineHeight = lineHeight + paddingTop + paddingBottom;
    const maxLinesHeight = (lineHeight * 5) + paddingTop + paddingBottom;

    const scrollHeight = input.scrollHeight;

    if (scrollHeight <= singleLineHeight + 4) {
      // Line 1: Single line height
      input.style.height = `${singleLineHeight}px`;
      input.style.overflowY = 'hidden';
    } else if (scrollHeight < maxLinesHeight + 4) {
      // Lines 2 to 5: Expand line by line smoothly
      input.style.height = `${scrollHeight}px`;
      input.style.overflowY = 'hidden';
    } else {
      // Line 5+: Cap at 5 lines and enable smooth vertical scroll
      input.style.height = `${maxLinesHeight}px`;
      input.style.overflowY = 'auto';
    }
  }
