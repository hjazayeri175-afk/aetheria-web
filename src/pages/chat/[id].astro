    if (textModelInput) localStorage.setItem('aetheria_text_model', textModelInput.value.trim());
    if (sliderTemp) localStorage.setItem('aetheria_text_temp', sliderTemp.value);
    if (sliderTokens) localStorage.setItem('aetheria_text_tokens', sliderTokens.value);
    if (sliderTopP) localStorage.setItem('aetheria_text_top_p', sliderTopP.value);
    if (sliderRepPen) localStorage.setItem('aetheria_text_rep_pen', sliderRepPen.value);
    if (sliderFreqPen) localStorage.setItem('aetheria_text_freq_pen', sliderFreqPen.value);
    if (sliderPresPen) localStorage.setItem('aetheria_text_pres_pen', sliderPresPen.value);
