  async function syncSttModelsForProvider(prov, isManual = false) {
    if (isFetchingSttModels || prov === 'browser-stt') return;

    const key = getSttKeyForProvider(prov);
    const engObj = ALL_STT_ENGINES.find(e => e.id === prov);
    if (!key && engObj && engObj.needsKey) {
      if (isManual) showNotification('⚠️ Please enter an API key first.', 'warning');
      return;
    }

    isFetchingSttModels = true;
    if (syncSttModelsIcon) syncSttModelsIcon.classList.add('animate-spin');

    try {
      let endpoint = '';
      if (prov === 'groq') {
        endpoint = 'https://api.groq.com/openai/v1/models';
      } else if (prov === 'openai' || prov === 'openai-stt') {
        endpoint = 'https://api.openai.com/v1/models';
      } else if (prov === 'local-stt' || prov === 'custom-stt') {
        const customUrl = localStorage.getItem('aetheria_stt_custom_url') || '';
        endpoint = customUrl ? customUrl.replace(/\/transcriptions.*/, '/models') : '';
      }

      if (!endpoint) throw new Error('No models endpoint available for this provider.');

      let modelsData = null;
      try {
        const directRes = await fetch(endpoint, {
          method: 'GET',
          headers: {
            'Authorization': `Bearer ${key}`,
            'Accept': 'application/json'
          }
        });
        if (directRes.ok) modelsData = await directRes.json();
      } catch (e) {}

      if (!modelsData) {
        const proxyRes = await fetch('/api/proxy/fetch-models', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ endpoint, apiKey: key })
        });
        if (proxyRes.ok) {
          const pJson = await proxyRes.json();
          modelsData = pJson.data || pJson;
        }
      }

      const rawList = modelsData?.data || (Array.isArray(modelsData) ? modelsData : []);
      let parsed = [];

      if (prov === 'groq') {
        parsed = rawList
          .filter(m => typeof m.id === 'string' && m.id.toLowerCase().includes('whisper'))
          .map(m => ({
            id: m.id,
            label: `${m.id} ${m.id.includes('turbo') ? '(Fastest ~0.2s)' : '(Max Accuracy)'}`
          }));
      } else if (prov === 'openai' || prov === 'openai-stt') {
        parsed = rawList
          .filter(m => typeof m.id === 'string' && m.id.toLowerCase().includes('whisper'))
          .map(m => ({
            id: m.id,
            label: `${m.id} (Studio Accuracy)`
          }));
        if (parsed.length === 0) parsed = [{ id: 'whisper-1', label: 'whisper-1 (Official OpenAI Studio)' }];
      } else {
        parsed = rawList.map(m => ({ id: m.id || m, label: m.id || m }));
      }

      if (parsed.length > 0) {
        localStorage.setItem('aetheria_cached_stt_models_' + prov, JSON.stringify(parsed));
        renderDynamicSttModels();
        if (isManual) showNotification(`✓ Synced ${parsed.length} models from ${prov.toUpperCase()} API!`);
      }
    } catch (err) {
      if (isManual) showNotification(`⚠️ Failed to sync models: ${err.message}`, 'error');
    } finally {
      isFetchingSttModels = false;
      if (syncSttModelsIcon) syncSttModelsIcon.classList.remove('animate-spin');
    }
  }

  // Model Selection Change Handler
  sttModelSelect?.addEventListener('change', () => {
