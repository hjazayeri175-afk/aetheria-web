    ttsIconOff?.classList.toggle('hidden', ttsEnabled);
    showNotification(ttsEnabled ? 'Voice Read Aloud enabled' : 'Voice Read Aloud muted');
  });

  // Clear chat
  clearChatBtn?.addEventListener('click', () => {
    if (confirm(`Reset conversation history with ${activeChar.name}?`)) {
      const initialGreeting = formatMacroText(activeChar.greeting);
      conversation = [{
        sender: 'character',
        text: initialGreeting,
        timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
        swipes: [initialGreeting],
        swipeIndex: 0
      }];
      saveChat();
      renderAllMessages();
      showNotification('Conversation reset to beginning.');
    }
  });

  // Export chat
  exportChatBtn?.addEventListener('click', () => {
    let md = `# Conversation with ${activeChar.name}\n\n`;
    conversation.forEach((msg) => {
      const name = msg.sender === 'character' ? activeChar.name : (activeUserPersona.name || 'You');
      md += `**[${msg.timestamp || ''}] ${name}:**\n${msg.text}\n\n`;
    });
    const blob = new Blob([md], { type: 'text/markdown' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${activeChar.name.toLowerCase().replace(/\s+/g, '_')}_chat.md`;
    a.click();
