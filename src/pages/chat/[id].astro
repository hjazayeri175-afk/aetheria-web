<script define:vars={{ character }}>
  // Client-side state & logic
  let activeChar = { ...character };
  let activeUserPersona = {
    name: 'Traveler',
    pronouns: 'They/Them',
    title: 'Explorer',
    avatar: '',
    bio: '',
    globalNotes: 'Never speak, narrate, or assume actions for {{user}}. Maintain atmospheric immersion.'
  };

  // 1. Resolve User Persona from localStorage
  try {
    const rawPersona = localStorage.getItem('aetheria_user_persona');
    if (rawPersona) {
      activeUserPersona = { ...activeUserPersona, ...JSON.parse(rawPersona) };
    }
  } catch {}

  // 2. Resolve Custom Character if URL is /chat/custom or has ?id=
  const urlParams = new URLSearchParams(window.location.search);
  const customId = urlParams.get('charId') || urlParams.get('id');
  const isCustomRoute = character.id === 'custom' || window.location.pathname.includes('/chat/custom');

  if (isCustomRoute) {
    try {
      const customList = JSON.parse(localStorage.getItem('aetheria_custom_characters') || '[]');
      let matched = null;
      if (customId) {
        matched = customList.find(c => c.id === customId);
      }
      if (!matched && customList.length > 0) {
        matched = customList[customList.length - 1]; // latest created custom character
      }
      if (matched) {
        activeChar = {
          ...activeChar,
          ...matched,
          avatarUrl: matched.avatarUrl || activeChar.avatarUrl,
          greeting: matched.greeting || activeChar.greeting,
          alternateGreetings: (matched.alternateGreetings && matched.alternateGreetings.length > 0) 
            ? matched.alternateGreetings 
            : (matched.alternate_greetings || activeChar.alternateGreetings || []),
          fallbackReplies: (matched.alternateGreetings && matched.alternateGreetings.length > 0) ? matched.alternateGreetings : activeChar.fallbackReplies,
          starterPrompts: (matched.starterPrompts && matched.starterPrompts.length > 0) ? matched.starterPrompts : activeChar.starterPrompts,
          scenario: matched.scenario || activeChar.scenario || '',
          systemPrompt: matched.systemPrompt || activeChar.systemPrompt || '',
          speechStyle: matched.speechStyle || activeChar.speechStyle || '',
          mesExample: matched.mesExample || activeChar.mesExample || '',
          personality: matched.personality || activeChar.personality || '',
          lorebook: matched.lorebook || activeChar.lorebook || []
        };
      }
    } catch {}
  }

  // Macro replacement helper for {{user}} and {{char}} (Tavern / Chub / SillyTavern standard)
  function isPoisonedOrErrorMessage(text) {
    if (!text || typeof text !== 'string') return true;
    const t = text.trim();
    if (t.startsWith('⚠️')) return true;
    if (t.includes('The request was rejected') || t.includes('considered high risk')) return true;
    if (t.includes('你好，我无法') || t.includes('无法给到相关内容') || t.includes('抱歉，我无法')) return true;
    if (t.includes('I cannot fulfill this request') || t.includes('I am unable to fulfill this request')) return true;
    return false;
  }

  function formatMacroText(str) {
    if (!str || typeof str !== 'string') return '';
    const uName = (activeUserPersona && activeUserPersona.name) ? activeUserPersona.name : 'Traveler';
    const cName = (activeChar && activeChar.name) ? activeChar.name : 'Character';
    return str
      .replace(/\{\{user\}\}/gi, uName)
      .replace(/<USER>/gi, uName)
      .replace(/\{\{char\}\}/gi, cName)
      .replace(/<CHAR>/gi, cName)
      .replace(/<BOT>/gi, cName);
  }

  // Retrieve all unique scenario greetings (first_mes + alternate_greetings)
  function getCharacterGreetings() {
    const rawList = [
      activeChar.greeting,
      ...(activeChar.alternateGreetings || []),
      ...(activeChar.alternate_greetings || []),
      ...(character?.alternateGreetings || []),
      ...(character?.alternate_greetings || [])
    ].filter(Boolean);

    const unique = [];
    const seen = new Set();
    rawList.forEach(g => {
      const trimmed = g.trim();
      if (trimmed && !seen.has(trimmed)) {
        seen.add(trimmed);
        unique.push(formatMacroText(trimmed));
      }
    });

    return unique.length > 0 ? unique : [formatMacroText(activeChar.greeting || 'Greetings, traveler.')];
  }

  // Update DOM elements for custom character if resolved
  if (isCustomRoute && activeChar.name !== 'Custom Persona') {
    document.title = `${activeChar.name} — Immersive Roleplay Chat | Aetheria AI`;
    const hName = document.getElementById('chat-header-name');
    if (hName) hName.textContent = activeChar.name;
    const hTitle = document.getElementById('chat-header-title');
    if (hTitle) hTitle.textContent = activeChar.title;
    const hAvatar = document.getElementById('chat-header-avatar');
    if (hAvatar) hAvatar.src = activeChar.avatarUrl;

    const sAvatar = document.getElementById('chat-sidebar-avatar');
    if (sAvatar) sAvatar.src = activeChar.avatarUrl;
    const sCat = document.getElementById('chat-sidebar-category');
    if (sCat) sCat.textContent = activeChar.category || 'Custom';
    const sDesc = document.getElementById('chat-sidebar-desc');
    if (sDesc) sDesc.textContent = formatMacroText(activeChar.description || '');

    const tAvatar = document.getElementById('chat-typing-avatar');
    if (tAvatar) tAvatar.src = activeChar.avatarUrl;
    const tName = document.getElementById('chat-typing-name');
    if (tName) tName.textContent = `${activeChar.name} is thinking...`;

    const rInput = document.getElementById('room-input');
    if (rInput) rInput.placeholder = `Type a message to ${activeChar.name}... (Press Enter to send, Shift+Enter for newline)`;
  }

  let conversation = [];
  let ttsEnabled = true;

  // Multi-session & Branching state
  // ==========================================
  // CORE UTILITIES & GLOBAL NOTIFICATIONS
  // ==========================================
  function escapeHtml(str) {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function showNotification(msg, type = 'info') {
    let container = document.getElementById('aetheria-toast-container');
    if (!container) {
      container = document.createElement('div');
      container.id = 'aetheria-toast-container';
      container.className = 'fixed bottom-5 right-5 z-[9999] flex flex-col gap-2 max-w-sm pointer-events-none';
      document.body.appendChild(container);
    }
    const toast = document.createElement('div');
    const isErr = type === 'error' || msg.includes('⚠️') || msg.includes('error') || msg.includes('Failed');
    toast.className = `px-4 py-2.5 rounded-2xl text-xs font-medium backdrop-blur-md shadow-2xl transition-all duration-300 pointer-events-auto transform translate-y-4 opacity-0 border ${
      isErr 
        ? 'bg-rose-950/85 text-rose-200 border-rose-500/40 shadow-rose-950/50' 
        : 'bg-[#0f132a]/90 text-purple-200 border-purple-500/30 shadow-purple-950/50'
    }`;
    toast.textContent = msg;
    container.appendChild(toast);
    requestAnimationFrame(() => {
      toast.classList.remove('translate-y-4', 'opacity-0');
    });
    setTimeout(() => {
      toast.classList.add('opacity-0', 'translate-y-2');
      setTimeout(() => toast.remove(), 300);
    }, 3500);
  }

  function updateHeaderPill() {
    const el = document.getElementById('chat-engine-label');
    if (el) {
      const provSelect = document.getElementById('text-provider-select');
      const prov = (provSelect ? provSelect.value : '') || localStorage.getItem('aetheria_text_provider') || 'demo';
      const m = localStorage.getItem('aetheria_text_model') || '';
      const pName = (typeof PROVIDER_CONFIGS !== 'undefined' && PROVIDER_CONFIGS[prov]?.name) || prov;
      el.textContent = m ? `${pName} • ${m.split('/').pop() || m}` : pName;
    }
  }

  const SESSIONS_INDEX_KEY = `aetheria_chat_sessions_${activeChar.id}`;
  let currentSessionId = 'session_default';
  let chatSessions = [];

  // Parse sessionId from URL if present (?sessionId=...)
  if (urlParams.get('sessionId')) {
    currentSessionId = urlParams.get('sessionId');
  }

  function getSessionStorageKey(sessionId) {
    return sessionId === 'session_default' 
      ? `aetheria_chat_${activeChar.id}` 
      : `aetheria_chat_${activeChar.id}_${sessionId}`;
  }

  // DOM Elements
  const chatStream = document.getElementById('chat-stream');
  const typingIndicator = document.getElementById('full-typing-indicator');
  const inputForm = document.getElementById('room-input-form');
  const input = document.getElementById('room-input');
  const toggleSidebarBtn = document.getElementById('toggle-sidebar-btn');
  const sidebar = document.getElementById('character-sidebar');
  const sidebarBackdrop = document.getElementById('sidebar-backdrop');
  const closeSidebarMobileBtn = document.getElementById('close-sidebar-mobile-btn');
  const clearChatBtn = document.getElementById('clear-chat-btn');
  const exportChatBtn = document.getElementById('export-chat-btn');
  const toggleTtsBtn = document.getElementById('toggle-tts-btn');
  const ttsIconOn = document.getElementById('tts-icon-on');
  const ttsIconOff = document.getElementById('tts-icon-off');
  
  // Dynamic Smart Prompts elements
  const smartPromptsBar = document.getElementById('smart-prompts-bar');
  const smartPromptsContainer = document.getElementById('smart-prompts-container');
  const smartPromptsLoading = document.getElementById('smart-prompts-loading');
  const refreshSmartPromptsBtn = document.getElementById('refresh-smart-prompts-btn');
  const smartPromptsRefreshIcon = document.getElementById('smart-prompts-refresh-icon');
  let isGeneratingSmartPrompts = false;
  
  // Fullscreen Artwork Lightbox
  const lightboxModal = document.getElementById('artwork-lightbox-modal');
  const lightboxImg = document.getElementById('lightbox-image');
  const lightboxName = document.getElementById('lightbox-char-name');
  const lightboxTitle = document.getElementById('lightbox-char-title');
  const lightboxDownload = document.getElementById('lightbox-download-btn');
  const lightboxClose = document.getElementById('lightbox-close-btn');
  const lightboxBackdropClick = document.getElementById('lightbox-backdrop-click');
  const openLightboxHeaderBtn = document.getElementById('open-lightbox-header-btn');
  const openLightboxSidebarBtn = document.getElementById('open-lightbox-sidebar-btn');

  function openLightbox(imageUrl, title, subtitle) {
    if (!lightboxModal || !lightboxImg) return;
    const url = imageUrl || activeChar.avatarUrl;
    lightboxImg.src = url;
    lightboxImg.alt = title || activeChar.name;

    if (lightboxName) lightboxName.textContent = title || activeChar.name;
    if (lightboxTitle) lightboxTitle.textContent = subtitle ? `• ${subtitle}` : (activeChar.title ? `• ${activeChar.title}` : '');

    if (lightboxDownload) {
      lightboxDownload.href = url;
      const cleanName = (title || activeChar.name || 'character').toLowerCase().replace(/[^a-z0-9]/g, '-');
      lightboxDownload.download = `${cleanName}-art.png`;
    }

    lightboxModal.classList.remove('hidden');
    requestAnimationFrame(() => {
      lightboxModal.classList.remove('opacity-0', 'pointer-events-none');
      lightboxModal.classList.add('opacity-100', 'pointer-events-auto');
      if (lightboxImg) {
        lightboxImg.classList.remove('scale-95');
        lightboxImg.classList.add('scale-100');
      }
    });
  }

  function closeLightbox() {
    if (!lightboxModal) return;
    lightboxModal.classList.remove('opacity-100', 'pointer-events-auto');
    lightboxModal.classList.add('opacity-0', 'pointer-events-none');
    if (lightboxImg) {
      lightboxImg.classList.remove('scale-100');
      lightboxImg.classList.add('scale-95');
    }
    setTimeout(() => {
      lightboxModal.classList.add('hidden');
    }, 250);
  }

  openLightboxHeaderBtn?.addEventListener('click', () => {
    openLightbox(activeChar.avatarUrl, activeChar.name, activeChar.title);
  });

  openLightboxSidebarBtn?.addEventListener('click', () => {
    openLightbox(activeChar.avatarUrl, activeChar.name, activeChar.title);
  });

  lightboxClose?.addEventListener('click', closeLightbox);
  lightboxBackdropClick?.addEventListener('click', (e) => {
    if (e.target === lightboxBackdropClick || e.target === lightboxImg) {
      closeLightbox();
    }
  });

  document.addEventListener('keydown', (e) => {
