  // Sanitize numeric inputs, converting any Persian / Arabic digits to standard ASCII 0-9
  function toAsciiNumber(val, fallback = 0) {
    if (val === null || val === undefined) return fallback;
    let s = String(val).trim();
    if (!s) return fallback;
    s = s.replace(/[۰-۹]/g, d => '۰۱۲۳۴۵۶۷۸۹'.indexOf(d))
         .replace(/[٠-٩]/g, d => '٠١٢٣٤٥٦٧٨٩'.indexOf(d));
    const n = parseFloat(s);
    return isNaN(n) ? fallback : n;
  }

  // Dual Control Sync: Real-time Range Slider <-> Numeric Input Badge
  function setupDualControl(slider, inputOrBadge, unit = '') {
    if (!slider || !inputOrBadge) return;
    const isInput = inputOrBadge.tagName === 'INPUT';

    const syncToBadge = (val) => {
      const asciiVal = toAsciiNumber(val);
      const strVal = String(asciiVal);
      if (isInput) {
        inputOrBadge.value = strVal;
      } else {
        inputOrBadge.textContent = unit ? `${strVal} ${unit}` : strVal;
      }
    };

    slider.addEventListener('input', () => {
      syncToBadge(slider.value);
    });
    slider.addEventListener('change', () => {
      syncToBadge(slider.value);
    });

    if (isInput) {
      inputOrBadge.addEventListener('input', () => {
        // Sanitize any Persian or Arabic digits in real-time
        const raw = String(inputOrBadge.value || '');
        const converted = raw.replace(/[۰-۹]/g, d => '۰۱۲۳۴۵۶۷۸۹'.indexOf(d))
                             .replace(/[٠-٩]/g, d => '٠١٢٣٤٥٦٧٨٩'.indexOf(d));
        if (converted !== raw) {
          inputOrBadge.value = converted;
        }
        const val = toAsciiNumber(converted, NaN);
        if (!isNaN(val)) {
          const min = toAsciiNumber(slider.min, 0);
          const max = toAsciiNumber(slider.max, 100);
          if (val >= min && val <= max) {
            slider.value = val;
          }
        }
      });

      inputOrBadge.addEventListener('change', () => {
        const min = toAsciiNumber(slider.min, 0);
        const max = toAsciiNumber(slider.max, 100);
        let val = toAsciiNumber(inputOrBadge.value, NaN);
        if (isNaN(val)) {
          val = toAsciiNumber(slider.value, min);
        } else {
          if (val < min) val = min;
          if (val > max) val = max;
        }
        slider.value = val;
        inputOrBadge.value = String(val);
      });

      inputOrBadge.addEventListener('blur', () => {
        const min = toAsciiNumber(slider.min, 0);
        const max = toAsciiNumber(slider.max, 100);
        let val = toAsciiNumber(inputOrBadge.value, NaN);
        if (isNaN(val)) {
          val = toAsciiNumber(slider.value, min);
        } else {
          if (val < min) val = min;
          if (val > max) val = max;
        }
        slider.value = val;
        inputOrBadge.value = String(val);
      });
    }
  }

