  });

  // ==========================================
  // PART 4: WORLD INFO & LOREBOOK ENGINE
  // ==========================================
  const CHAR_LORE_KEY = `aetheria_lorebook_${activeChar.id}`;
  const GLOBAL_LORE_KEY = 'aetheria_global_lorebook';
  let activeLoreScope = 'character'; // 'character' | 'global'
  let charLoreEntries = [];
  let globalLoreEntries = [];
  let editingLoreId = null;

  function loadLorebook() {
    // Load character entries
    try {
      const savedChar = localStorage.getItem(CHAR_LORE_KEY);
      if (savedChar) {
        charLoreEntries = JSON.parse(savedChar);
      } else if (activeChar.lorebook) {
        const rawL = activeChar.lorebook;
        const entries = Array.isArray(rawL) ? rawL : (rawL.entries || []);
        if (entries.length > 0) {
          charLoreEntries = JSON.parse(JSON.stringify(entries));
          localStorage.setItem(CHAR_LORE_KEY, JSON.stringify(charLoreEntries));
        } else {
          charLoreEntries = [];
        }
      } else {
        charLoreEntries = [];
      }
    } catch {
      charLoreEntries = [];
    }

    // Load global entries
    try {
      const savedGlobal = localStorage.getItem(GLOBAL_LORE_KEY);
      globalLoreEntries = savedGlobal ? JSON.parse(savedGlobal) : [];
    } catch {
      globalLoreEntries = [];
    }

    // Update sidebar badge
    const badge = document.getElementById('lorebook-entries-badge');
    const totalCount = charLoreEntries.length + globalLoreEntries.length;
    if (badge) {
      badge.textContent = `${totalCount} ${totalCount === 1 ? 'Entry' : 'Entries'}`;
    }
  }

  function getActiveScopeEntries() {
    return activeLoreScope === 'character' ? charLoreEntries : globalLoreEntries;
  }

  function saveCurrentScopeEntries() {
    if (activeLoreScope === 'character') {
      localStorage.setItem(CHAR_LORE_KEY, JSON.stringify(charLoreEntries));
    } else {
      localStorage.setItem(GLOBAL_LORE_KEY, JSON.stringify(globalLoreEntries));
    }
    loadLorebook();
    renderLoreEntries();
  }

  function renderLoreEntries() {
    const listEl = document.getElementById('lore-entries-list');
    const emptyEl = document.getElementById('lore-empty-state');
    if (!listEl) return;

    const entries = getActiveScopeEntries();
    listEl.innerHTML = '';

    if (entries.length === 0) {
      emptyEl?.classList.remove('hidden');
      return;
    }
    emptyEl?.classList.add('hidden');

    entries.forEach((entry) => {
      const card = document.createElement('div');
      card.className = `p-3.5 sm:p-4 rounded-2xl border transition ${
        entry.enabled !== false 
          ? 'bg-[#0a0d20] border-cyan-500/30 shadow-lg shadow-cyan-950/30' 
          : 'bg-white/[0.02] border-white/[0.06] opacity-60'
      }`;

      const rawKeys = entry.keys || entry.key || [];
      const normKeys = Array.isArray(rawKeys) ? rawKeys : (typeof rawKeys === 'string' ? rawKeys.split(',') : []);
      const keysList = normKeys.map(k => `<span class="px-2 py-0.5 rounded-md bg-cyan-500/10 border border-cyan-500/20 text-cyan-300 text-[10px] font-mono">${String(k).trim()}</span>`).join(' ');

      card.innerHTML = `
        <div class="flex items-start justify-between gap-3">
          <div class="flex-1 min-w-0">
            <div class="flex items-center gap-2 flex-wrap">
              <h5 class="text-xs sm:text-sm font-bold text-white">${entry.name || 'Untitled Lore Entry'}</h5>
              <span class="text-[9px] px-1.5 py-0.2 rounded font-mono ${entry.position === 'before_char' ? 'bg-amber-500/20 text-amber-300 border border-amber-500/30' : 'bg-purple-500/20 text-purple-300 border border-purple-500/30'}">
                ${entry.position === 'before_char' ? 'Before Char' : 'After Char'}
              </span>
              ${entry.constant ? '<span class="text-[9px] px-1.5 py-0.2 rounded bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 font-mono font-bold">Always Active</span>' : ''}
              <span class="text-[10px] text-slate-500 font-mono">Order: ${entry.insertion_order || 100}</span>
            </div>

            <div class="flex items-center gap-1.5 flex-wrap mt-2">
              <span class="text-[10px] text-slate-400 font-semibold">Keys:</span>
              ${keysList || '<span class="text-[10px] text-slate-500 italic">None (Constant)</span>'}
            </div>

            <p class="text-xs text-slate-300 bg-black/40 p-2.5 rounded-xl border border-white/[0.06] mt-2.5 leading-relaxed line-clamp-3">
              ${entry.content || ''}
            </p>
          </div>

          <div class="flex items-center gap-1 shrink-0">
            <button type="button" class="toggle-entry-btn p-1.5 rounded-lg ${entry.enabled !== false ? 'text-emerald-400' : 'text-slate-500'} hover:bg-white/[0.06]" title="Toggle Active Status">
              ${entry.enabled !== false ? '🟢' : '⚪'}
            </button>
            <button type="button" class="edit-entry-btn p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-white/[0.06]" title="Edit Lore Entry">
              ✏️
            </button>
            <button type="button" class="delete-entry-btn p-1.5 rounded-lg text-slate-400 hover:text-red-400 hover:bg-white/[0.06]" title="Delete Lore Entry">
              🗑️
            </button>
          </div>
        </div>
      `;

      card.querySelector('.toggle-entry-btn')?.addEventListener('click', () => {
        entry.enabled = entry.enabled === false ? true : false;
        saveCurrentScopeEntries();
      });

      card.querySelector('.edit-entry-btn')?.addEventListener('click', () => {
        openLoreForm(entry);
      });

      card.querySelector('.delete-entry-btn')?.addEventListener('click', () => {
        if (confirm(`Delete lore entry "${entry.name}"?`)) {
          const arr = getActiveScopeEntries();
          const targetIdx = arr.findIndex(e => e.id === entry.id);
          if (targetIdx !== -1) {
            arr.splice(targetIdx, 1);
            saveCurrentScopeEntries();
          }
        }
      });

      listEl.appendChild(card);
    });
  }

  function openLoreForm(entry = null) {
    const form = document.getElementById('lore-editor-form');
    const formTitle = document.getElementById('lore-form-title');
    if (!form) return;

    editingLoreId = entry ? entry.id : null;
    if (formTitle) {
      formTitle.querySelector('span').textContent = entry ? 'Edit Lorebook Entry' : 'Create Lorebook Entry';
    }

    document.getElementById('lore-input-name').value = entry ? entry.name : '';
    const rawK = entry ? (entry.keys || entry.key || []) : [];
    const kArr = Array.isArray(rawK) ? rawK : (typeof rawK === 'string' ? rawK.split(',') : []);
    document.getElementById('lore-input-keys').value = kArr.map(k => String(k).trim()).join(', ');

    const rawSec = entry ? (entry.secondary_keys || entry.secondary_key || []) : [];
    const secArr = Array.isArray(rawSec) ? rawSec : (typeof rawSec === 'string' ? rawSec.split(',') : []);
    document.getElementById('lore-input-second-keys').value = secArr.map(k => String(k).trim()).join(', ');
    document.getElementById('lore-input-content').value = entry ? entry.content : '';
    document.getElementById('lore-input-position').value = entry ? (entry.position || 'after_char') : 'after_char';
    document.getElementById('lore-input-order').value = entry ? String(entry.insertion_order || 100) : '100';
    document.getElementById('lore-input-constant').checked = entry ? !!entry.constant : false;

    form.classList.remove('hidden');
    form.scrollIntoView({ behavior: 'smooth' });
  }

  function closeLoreForm() {
    editingLoreId = null;
    document.getElementById('lore-editor-form')?.classList.add('hidden');
  }

  function saveLoreEntryFromForm() {
    const name = document.getElementById('lore-input-name').value.trim();
    const keysRaw = document.getElementById('lore-input-keys').value;
    const secKeysRaw = document.getElementById('lore-input-second-keys').value;
    const content = document.getElementById('lore-input-content').value.trim();
    const position = document.getElementById('lore-input-position').value;
    const order = parseInt(document.getElementById('lore-input-order').value || '100', 10);
    const constant = document.getElementById('lore-input-constant').checked;

    if (!content) {
      alert('Please enter lore content.');
      return;
    }

    const keys = keysRaw.split(',').map(k => k.trim()).filter(Boolean);
    const secKeys = secKeysRaw.split(',').map(k => k.trim()).filter(Boolean);

    const arr = getActiveScopeEntries();
    if (editingLoreId) {
      const existing = arr.find(e => e.id === editingLoreId);
      if (existing) {
        existing.name = name || 'Untitled Entry';
        existing.keys = keys;
        existing.secondary_keys = secKeys;
        existing.content = content;
        existing.position = position;
        existing.insertion_order = order;
        existing.constant = constant;
      }
    } else {
      arr.push({
        id: 'lore_' + Date.now(),
        name: name || 'Untitled Entry',
        keys: keys,
        secondary_keys: secKeys,
        content: content,
        position: position,
        insertion_order: order,
        constant: constant,
        enabled: true
      });
    }

    saveCurrentScopeEntries();
    closeLoreForm();
    showNotification('Lorebook entry saved.');
  }

  // Runtime Keyword Scanner & Injection Engine
  function scanAndInjectLorebook(userPrompt = '', recentConversation = []) {
    loadLorebook();
    const allEntries = [...charLoreEntries, ...globalLoreEntries];
    if (allEntries.length === 0) {
      return { beforeCharContent: '', afterCharContent: '', triggeredNames: [] };
    }

    // Build scan context: current user prompt + last 2 turns
    const lastTurnsText = recentConversation.slice(-2).map((m) => m.text).join(' ');
    const fullScanText = `${userPrompt} ${lastTurnsText}`.toLowerCase();

    const activeBefore = [];
    const activeAfter = [];
    const triggered = [];

    // Filter, sort by insertion_order descending
    const sorted = [...allEntries].sort((a, b) => (b.insertion_order || 100) - (a.insertion_order || 100));

    sorted.forEach(entry => {
      if (entry.enabled === false) return;

      // Robust normalization of trigger keys across all card formats (string, array, Tavern key/keys)
      const rawPrimary = entry.keys || entry.key || [];
      const primaryKeys = (Array.isArray(rawPrimary) 
        ? rawPrimary 
        : (typeof rawPrimary === 'string' ? rawPrimary.split(',') : [])
      ).map(k => String(k).toLowerCase().trim()).filter(Boolean);

      const rawSecondary = entry.secondary_keys || entry.secondary_key || [];
      const secondaryKeys = (Array.isArray(rawSecondary) 
        ? rawSecondary 
        : (typeof rawSecondary === 'string' ? rawSecondary.split(',') : [])
      ).map(k => String(k).toLowerCase().trim()).filter(Boolean);

      let isHit = false;
      if (entry.constant) {
        isHit = true;
      } else if (primaryKeys.length > 0) {
        const matchesPrimary = primaryKeys.some((k) => fullScanText.includes(k));
        if (matchesPrimary) {
          if (secondaryKeys.length > 0) {
            const matchesSecondary = secondaryKeys.some((k) => fullScanText.includes(k));
            if (matchesSecondary) isHit = true;
          } else {
            isHit = true;
          }
        }
      }

      if (isHit) {
        triggered.push(entry.name || primaryKeys[0] || 'Lore Entry');
        if (entry.position === 'before_char') {
          activeBefore.push(entry.content);
        } else {
          activeAfter.push(entry.content);
        }
      }
    });

    return {
      beforeCharContent: activeBefore.join('\n\n'),
      afterCharContent: activeAfter.join('\n\n'),
      triggeredNames: triggered
    };
  }

  function updateSidebarLoreTriggers(names = []) {
    const container = document.getElementById('sidebar-lore-triggers');
    const tagsContainer = document.getElementById('sidebar-lore-tags');
    if (!container || !tagsContainer) return;

    if (names.length === 0) {
      container.classList.add('hidden');
      tagsContainer.innerHTML = '';
      return;
    }

    container.classList.remove('hidden');
    tagsContainer.innerHTML = names.map(n => `
      <span class="px-2 py-0.5 rounded-md bg-cyan-500/20 text-cyan-300 border border-cyan-500/40 text-[10px] font-mono flex items-center gap-1 shadow-sm">
        <span class="w-1.5 h-1.5 rounded-full bg-cyan-400 animate-pulse"></span>
        <span>${n}</span>
      </span>
    `).join('');
  }

  // Export & Import Lorebook
  function exportLorebook() {
    const data = {
      format: 'aetheria_world_info_v2',
      exportedAt: new Date().toISOString(),
      character: activeChar.name,
      characterLore: charLoreEntries,
      globalLore: globalLoreEntries
    };
    const blob = new Blob([JSON.stringify(data, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${activeChar.name.toLowerCase().replace(/\s+/g, '_')}_lorebook.json`;
    a.click();
    URL.revokeObjectURL(url);
    showNotification('Lorebook exported to JSON.');
  }

  function importLorebook(file) {
    const reader = new FileReader();
    reader.onload = (e) => {
      try {
        const json = JSON.parse(e.target?.result);
        let importedEntries = [];

        if (json.characterLore && Array.isArray(json.characterLore)) {
          importedEntries = json.characterLore;
        } else if (Array.isArray(json.entries)) {
          importedEntries = json.entries;
        } else if (Array.isArray(json)) {
          importedEntries = json;
        } else if (typeof json === 'object') {
          importedEntries = Object.values(json).filter((v) => typeof v === 'object' && (v.content || v.key || v.keys));
        }

        if (importedEntries.length === 0) {
          alert('No valid lorebook entries found in this JSON file.');
          return;
        }

        const normalized = importedEntries.map(e => ({
          id: e.id || 'lore_' + Math.random().toString(36).slice(2, 9),
          name: e.name || e.comment || (Array.isArray(e.keys) ? e.keys[0] : (typeof e.key === 'string' ? e.key : 'Imported Lore')),
          keys: Array.isArray(e.keys) ? e.keys : (typeof e.key === 'string' ? e.key.split(',').map((k) => k.trim()) : []),
          secondary_keys: Array.isArray(e.secondary_keys) ? e.secondary_keys : [],
          content: e.content || '',
          position: e.position || 'after_char',
          insertion_order: e.insertion_order || e.order || 100,
          constant: !!e.constant,
          enabled: e.enabled !== false
        }));

        if (activeLoreScope === 'character') {
          charLoreEntries = [...charLoreEntries, ...normalized];
        } else {
          globalLoreEntries = [...globalLoreEntries, ...normalized];
        }

        saveCurrentScopeEntries();
        showNotification(`Successfully imported ${normalized.length} lore entries!`);
      } catch (err) {
        alert('Invalid JSON file: ' + err.message);
      }
    };
    reader.readAsText(file);
  }

  // Lorebook Modal Event Listeners
  const openLorebookBtn = document.getElementById('open-lorebook-btn');
  const lorebookModal = document.getElementById('lorebook-modal');
  const closeLorebookModal = document.getElementById('close-lorebook-modal');
  const scopeCharBtn = document.getElementById('scope-char-lore-btn');
  const scopeGlobalBtn = document.getElementById('scope-global-lore-btn');
  const addLoreEntryBtn = document.getElementById('add-lore-entry-btn');
  const cancelLoreBtn = document.getElementById('cancel-lore-entry-btn');
  const saveLoreBtn = document.getElementById('save-lore-entry-btn');
  const exportLoreBtn = document.getElementById('export-lorebook-btn');
  const importLoreInput = document.getElementById('import-lorebook-input');

  openLorebookBtn?.addEventListener('click', () => {
    loadLorebook();
    renderLoreEntries();
    lorebookModal?.classList.remove('hidden');
  });

  closeLorebookModal?.addEventListener('click', () => {
    lorebookModal?.classList.add('hidden');
  });

  scopeCharBtn?.addEventListener('click', () => {
    activeLoreScope = 'character';
    scopeCharBtn.className = 'px-3 py-1 rounded-lg text-xs font-semibold bg-cyan-600 text-white transition cursor-pointer';
    if (scopeGlobalBtn) scopeGlobalBtn.className = 'px-3 py-1 rounded-lg text-xs font-semibold text-slate-400 hover:text-white transition cursor-pointer';
    renderLoreEntries();
  });

  scopeGlobalBtn?.addEventListener('click', () => {
    activeLoreScope = 'global';
    scopeGlobalBtn.className = 'px-3 py-1 rounded-lg text-xs font-semibold bg-cyan-600 text-white transition cursor-pointer';
    if (scopeCharBtn) scopeCharBtn.className = 'px-3 py-1 rounded-lg text-xs font-semibold text-slate-400 hover:text-white transition cursor-pointer';
    renderLoreEntries();
  });

  addLoreEntryBtn?.addEventListener('click', () => {
    openLoreForm();
  });

  cancelLoreBtn?.addEventListener('click', closeLoreForm);
  saveLoreBtn?.addEventListener('click', saveLoreEntryFromForm);
  exportLoreBtn?.addEventListener('click', exportLorebook);
  importLoreInput?.addEventListener('change', (e) => {
    const file = (e.target).files?.[0];
    if (file) importLorebook(file);
  });

  // Pinned Memory (Author's Note) handlers
  const pinnedInput = document.getElementById('pinned-note-input');
  const pinnedStatus = document.getElementById('pinned-note-status');
  const savePinnedBtn = document.getElementById('save-pinned-note-btn');

  function initPinnedNote() {
    const key = 'aetheria_pinned_note_' + (activeChar.id || character.id || 'default');
    const val = localStorage.getItem(key) || '';
    if (pinnedInput) {
      pinnedInput.value = val;
      updatePinnedStatus(val.length);
    }
  }

  function updatePinnedStatus(len) {
    if (pinnedStatus) {
      pinnedStatus.textContent = `${len} chars`;
      pinnedStatus.className = len > 0 ? 'text-[10px] text-amber-300 font-mono' : 'text-[10px] text-slate-500 font-mono';
    }
  }

  pinnedInput?.addEventListener('input', (e) => {
    updatePinnedStatus(e.target.value.length);
  });

  savePinnedBtn?.addEventListener('click', () => {
    const key = 'aetheria_pinned_note_' + (activeChar.id || character.id || 'default');
    const val = pinnedInput ? pinnedInput.value.trim() : '';
    localStorage.setItem(key, val);
    showNotification(val ? '📌 Pinned memory saved into prompt!' : '📌 Pinned memory cleared.');
    if (savePinnedBtn) {
      const orig = savePinnedBtn.innerHTML;
      savePinnedBtn.innerHTML = 'Saved! ✓';
      setTimeout(() => { savePinnedBtn.innerHTML = orig; }, 1500);
    }
  });

  // Startup
  loadLorebook();
  initChat();
</script>
