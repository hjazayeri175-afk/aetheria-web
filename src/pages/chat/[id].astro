  // Format action text (*italic*) vs speech
  function formatMessageText(text) {
    if (!text) return '';
    return text.replace(/\*([^*]+)\*/g, '<em class="text-purple-300 italic font-serif">$1</em>');
  }

  // Load and apply settings from localStorage
  function loadEngineSettings() {
    // 1. Text settings
    const textProv = localStorage.getItem('aetheria_text_provider') || 'groq';
    if (textProviderSelect) textProviderSelect.value = textProv;
    if (textApiKey) textApiKey.value = localStorage.getItem('aetheria_text_key') || '';
    if (textBaseUrl) textBaseUrl.value = localStorage.getItem('aetheria_text_base_url') || '';
    if (textModelInput) textModelInput.value = localStorage.getItem('aetheria_text_model') || (textProv === 'groq' ? 'llama-3.3-70b-versatile' : 'anthropic/claude-3.5-sonnet');
    
    // Sliders
    if (sliderTemp) sliderTemp.value = localStorage.getItem('aetheria_text_temp') || '0.85';
    if (sliderTokens) sliderTokens.value = localStorage.getItem('aetheria_text_tokens') || '350';
    if (sliderTopP) sliderTopP.value = localStorage.getItem('aetheria_text_top_p') || '0.95';
    if (sliderRepPen) sliderRepPen.value = localStorage.getItem('aetheria_text_rep_pen') || '1.10';
    if (sliderFreqPen) sliderFreqPen.value = localStorage.getItem('aetheria_text_freq_pen') || '0.00';
    if (sliderPresPen) sliderPresPen.value = localStorage.getItem('aetheria_text_pres_pen') || '0.00';
    if (sliderContext) sliderContext.value = localStorage.getItem('aetheria_text_context') || '16';
    if (toggleStreaming) toggleStreaming.checked = localStorage.getItem('aetheria_text_streaming') !== 'false';

    // 2. Voice settings
    const voiceProv = localStorage.getItem('aetheria_voice_provider') || 'browser';
    if (voiceProviderSelect) voiceProviderSelect.value = voiceProv;
    if (voiceApiKey) voiceApiKey.value = localStorage.getItem('aetheria_voice_key') || '';
    if (voiceIdInput) voiceIdInput.value = localStorage.getItem('aetheria_voice_id') || '21m00Tcm4TlvDq8ikWAM';
    if (openaiVoiceSelect) openaiVoiceSelect.value = localStorage.getItem('aetheria_voice_openai') || 'nova';
    if (sliderStability) sliderStability.value = localStorage.getItem('aetheria_voice_stability') || '0.50';
    if (sliderClarity) sliderClarity.value = localStorage.getItem('aetheria_voice_clarity') || '0.75';
    if (sliderVoiceRate) sliderVoiceRate.value = localStorage.getItem('aetheria_voice_rate') || '1.0';
    if (sliderVoicePitch) sliderVoicePitch.value = localStorage.getItem('aetheria_voice_pitch') || '1.0';
    if (toggleFilterNarration) toggleFilterNarration.checked = localStorage.getItem('aetheria_voice_filter') !== 'false';
    if (toggleAutoplayVoice) toggleAutoplayVoice.checked = localStorage.getItem('aetheria_voice_autoplay') === 'true';

    // 3. Image settings
    const imageProv = localStorage.getItem('aetheria_image_provider') || 'pollinations';
    if (imageProviderSelect) imageProviderSelect.value = imageProv;
    if (imageApiKey) imageApiKey.value = localStorage.getItem('aetheria_image_key') || '';
    if (imageAspectSelect) imageAspectSelect.value = localStorage.getItem('aetheria_image_aspect') || '1:1';
    if (imageStepsInput) imageStepsInput.value = localStorage.getItem('aetheria_image_steps') || '20';
    if (imageCfgInput) imageCfgInput.value = localStorage.getItem('aetheria_image_cfg') || '3.5';
    if (toggleImageAnchor) toggleImageAnchor.checked = localStorage.getItem('aetheria_image_anchor') !== 'false';
    if (imageNegativePrompt) imageNegativePrompt.value = localStorage.getItem('aetheria_image_negative') || 'blurry, distorted, low quality, bad anatomy, deformed limbs, extra fingers, watermark';

    // 4. Video settings
    const videoProv = localStorage.getItem('aetheria_video_provider') || 'fal-kling';
    if (videoProviderSelect) videoProviderSelect.value = videoProv;
    if (videoApiKey) videoApiKey.value = localStorage.getItem('aetheria_video_key') || '';
    if (sliderMotion) sliderMotion.value = localStorage.getItem('aetheria_video_motion') || '50';
    if (videoCameraSelect) videoCameraSelect.value = localStorage.getItem('aetheria_video_camera') || 'subtle';
    if (videoDurationSelect) videoDurationSelect.value = localStorage.getItem('aetheria_video_duration') || '5s';
    if (videoResSelect) videoResSelect.value = localStorage.getItem('aetheria_video_res') || '720p-24fps';

    updateAllBadges();
    syncProviderVisibility();
    updateHeaderPill();
