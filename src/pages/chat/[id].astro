          </button>
        </div>

        <!-- Target Snippet Preview -->
        ${displaySnippet ? `
        <div class="mt-4 px-3.5 py-2.5 rounded-xl bg-white/[0.03] border border-white/[0.06] text-xs">
          <div class="text-[11px] font-medium text-slate-400 mb-1">${safeTargetName}:</div>
          <p class="text-slate-300 italic line-clamp-2 leading-relaxed select-text">"${displaySnippet.replace(/</g, '&lt;').replace(/>/g, '&gt;')}"</p>
        </div>` : ''}

        <!-- Category Options -->
        <div class="mt-4 space-y-1.5">
          <div class="text-[11px] font-medium text-slate-400 mb-1.5">Reason</div>
          
          <label class="group flex items-start gap-3 p-3 rounded-xl border border-white/[0.06] hover:border-white/15 bg-white/[0.02] hover:bg-white/[0.04] cursor-pointer transition select-none">
            <input type="radio" name="report_category" value="safety" class="mt-0.5 accent-rose-500 cursor-pointer" ${category === 'safety' ? 'checked' : ''} />
            <div class="min-w-0">
              <span class="text-xs font-medium text-white block">Harmful or inappropriate content</span>
              <span class="text-[11px] text-slate-400 leading-snug block mt-0.5">Violence, hate speech, sexual content, or harassment</span>
            </div>
          </label>

          <label class="group flex items-start gap-3 p-3 rounded-xl border border-white/[0.06] hover:border-white/15 bg-white/[0.02] hover:bg-white/[0.04] cursor-pointer transition select-none">
            <input type="radio" name="report_category" value="legal" class="mt-0.5 accent-rose-500 cursor-pointer" ${category === 'legal' ? 'checked' : ''} />
            <div class="min-w-0">
              <span class="text-xs font-medium text-white block">Copyright or legal violation</span>
              <span class="text-[11px] text-slate-400 leading-snug block mt-0.5">Intellectual property infringement or illegal material</span>
            </div>
          </label>

          <label class="group flex items-start gap-3 p-3 rounded-xl border border-white/[0.06] hover:border-white/15 bg-white/[0.02] hover:bg-white/[0.04] cursor-pointer transition select-none">
            <input type="radio" name="report_category" value="bug" class="mt-0.5 accent-rose-500 cursor-pointer" ${category === 'bug' ? 'checked' : ''} />
            <div class="min-w-0">
              <span class="text-xs font-medium text-white block">Technical malfunction or glitch</span>
              <span class="text-[11px] text-slate-400 leading-snug block mt-0.5">Repetitive loops, broken response, or system error</span>
            </div>
          </label>

          <label class="group flex items-start gap-3 p-3 rounded-xl border border-white/[0.06] hover:border-white/15 bg-white/[0.02] hover:bg-white/[0.04] cursor-pointer transition select-none">
            <input type="radio" name="report_category" value="spam" class="mt-0.5 accent-rose-500 cursor-pointer" ${category === 'spam' ? 'checked' : ''} />
