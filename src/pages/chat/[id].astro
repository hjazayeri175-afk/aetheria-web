          <span class="inline-block w-3.5 h-3.5 border-2 border-cyan-400 border-t-transparent rounded-full animate-spin shrink-0"></span>
          <span>Verifying API key latency and validating connection...</span>
        </div>
      `);

      const result = await runWizardHealthCheck(wizardSelectedProv.id, key, '');
      loadingBubble?.remove();

      if (result.ok && result.models && result.models.length > 0) {
        wizardLatency = result.latency || 95;
        const liveModels = result.models;
        wizardLiveModels = liveModels;

        // Cache live models in localStorage for this provider
        localStorage.setItem('aetheria_synced_models_' + wizardSelectedProv.id, JSON.stringify(liveModels));

        // Sync to manual tab dropdown & inputs
        if (textProviderSelect) textProviderSelect.value = wizardSelectedProv.id;
        if (textApiKey) textApiKey.value = key;
        populateModelDropdown(liveModels, liveModels[0]);
        updateDynamicPresets(liveModels);
        unlockHyperparameters(true);

        appendNovaBubble(`
