              ? `<div class="w-7 h-7 rounded-full ${voiceCatalogMode === 'tts' ? 'bg-purple-600' : 'bg-rose-600'} text-white flex items-center justify-center text-xs font-bold shadow-md shadow-purple-900/40">✓</div>`
              : `<div class="w-7 h-7 rounded-full bg-white/[0.03] border border-white/10 group-hover:border-purple-400/40 flex items-center justify-center text-slate-400 group-hover:text-purple-300 text-xs transition">→</div>`
