  // ==========================================
  // DYNAMIC VOICE CATALOG & API SYNC
  // ==========================================
  const DEFAULT_OPENAI_VOICES = [
    { id: 'nova', name: 'Nova', gender: 'Female', accent: 'Warm & Natural', style: 'OpenAI Studio Voice' },
    { id: 'shimmer', name: 'Shimmer', gender: 'Female', accent: 'Expressive & Clear', style: 'OpenAI Studio Voice' },
    { id: 'onyx', name: 'Onyx', gender: 'Male', accent: 'Deep & Authoritative', style: 'OpenAI Studio Voice' },
    { id: 'alloy', name: 'Alloy', gender: 'Neutral', accent: 'Balanced & Direct', style: 'OpenAI Studio Voice' },
    { id: 'echo', name: 'Echo', gender: 'Male', accent: 'Smooth & Dynamic', style: 'OpenAI Studio Voice' },
    { id: 'fable', name: 'Fable', gender: 'Neutral', accent: 'Narrative & British', style: 'OpenAI Studio Voice' },
    { id: 'sage', name: 'Sage', gender: 'Female', accent: 'Calm & Intellectual', style: 'OpenAI Studio Voice' },
    { id: 'coral', name: 'Coral', gender: 'Female', accent: 'Bright & Friendly', style: 'OpenAI Studio Voice' },
    { id: 'ash', name: 'Ash', gender: 'Male', accent: 'Casual & Relaxed', style: 'OpenAI Studio Voice' }
  ];

  const langDisplayNames = (typeof Intl !== 'undefined' && Intl.DisplayNames) 
    ? new Intl.DisplayNames(['en'], { type: 'language' }) 
    : null;
  const regionDisplayNames = (typeof Intl !== 'undefined' && Intl.DisplayNames) 
    ? new Intl.DisplayNames(['en'], { type: 'region' }) 
    : null;

  function formatNativeVoice(nv) {
    const rawLang = (nv.lang || 'en-US').replace(/_/g, '-');
    const parts = rawLang.split('-');
    const langCode = parts[0]?.toLowerCase() || 'en';
    const regionCode = parts[1]?.toUpperCase() || '';

    let langName = 'English';
    let regionName = '';

    try {
      if (langDisplayNames && langCode) {
        langName = langDisplayNames.of(langCode) || langCode;
      }
      if (regionDisplayNames && regionCode) {
        regionName = regionDisplayNames.of(regionCode) || regionCode;
      }
    } catch (e) {}

    const hasNonEnglish = /[^ -~]/.test(nv.name || '');

    let cleanName = '';
    if (!hasNonEnglish && nv.name && !nv.name.toLowerCase().includes('default') && !nv.name.toLowerCase().startsWith('en-') && !nv.name.toLowerCase().startsWith('en_')) {
      cleanName = nv.name;
    } else {
      const regionSuffix = regionName ? ` (${regionName})` : '';
      cleanName = `${langName}${regionSuffix}`;
    }

    const cleanAccent = regionName ? `${regionName} Accent` : `${langName} Voice`;

    return {
      name: cleanName,
      accent: cleanAccent
    };
  }

  // Helper to retrieve voices for the active provider
  function getAvailableVoicesForProvider(prov) {
    if (prov === 'elevenlabs') {
      const key = getVoiceKeyForProvider('elevenlabs');
      if (!key) return null; // No key connected -> return null so renderDynamicVoiceCatalog shows the connect state!
      try {
        const cached = localStorage.getItem('aetheria_cached_voices_elevenlabs');
        if (cached) {
          const parsed = JSON.parse(cached);
          if (Array.isArray(parsed) && parsed.length > 0) return parsed;
        }
      } catch (e) {}
      return []; // Key exists but not fetched yet -> trigger real-time fetch!
    }

    if (prov === 'google') {
      const key = getVoiceKeyForProvider('google');
      if (!key) return null;
      try {
        const cached = localStorage.getItem('aetheria_cached_voices_google');
        if (cached) {
          const parsed = JSON.parse(cached);
          if (Array.isArray(parsed) && parsed.length > 0) return parsed;
        }
      } catch (e) {}
      return [];
    }

    if (prov === 'openai') {
      return DEFAULT_OPENAI_VOICES;
    }

    if (prov === 'browser') {
      if (typeof window !== 'undefined' && window.speechSynthesis) {
        const nativeVoices = window.speechSynthesis.getVoices();
        if (nativeVoices && nativeVoices.length > 0) {
          const nameCounts = {};
          return nativeVoices.map(nv => {
            const formatted = formatNativeVoice(nv);
            const baseName = formatted.name;
            nameCounts[baseName] = (nameCounts[baseName] || 0) + 1;
            const finalName = nameCounts[baseName] > 1 ? `${baseName} #${nameCounts[baseName]}` : baseName;

            return {
              id: nv.voiceURI || nv.name,
              name: finalName,
              gender: nv.name.toLowerCase().includes('female') ? 'Female' : nv.name.toLowerCase().includes('male') ? 'Male' : 'Natural',
              accent: formatted.accent,
              style: 'Local Device Voice'
            };
          });
        }
      }
      return [
        { id: 'default', name: 'System Default Voice', gender: 'Natural', accent: 'Device Native', style: 'Offline Native' }
      ];
    }

    return [];
  }

  // Real-time listener for browser system voices initialization
  if (typeof window !== 'undefined' && window.speechSynthesis) {
    window.speechSynthesis.onvoiceschanged = () => {
      const prov = voiceProviderSelect?.value || localStorage.getItem('aetheria_voice_provider') || 'browser';
      if (prov === 'browser') {
        renderDynamicVoiceCatalog(voiceSearchInput?.value || '');
      }
    };
  }

  function getSelectedVoiceDisplayName() {
    const prov = voiceProviderSelect?.value || 'browser';
    const vId = voiceIdInput?.value || localStorage.getItem('aetheria_voice_id');
    const voices = getAvailableVoicesForProvider(prov);
    if (!voices || !Array.isArray(voices) || voices.length === 0) return 'Default Voice';
    const found = voices.find(v => v.id === vId);
    if (found) return found.name;
    return voices[0]?.name || 'Default Voice';
  }

  // Real-time Dynamic Voice Catalog Renderer
  function renderDynamicVoiceCatalog(searchQuery = '') {
    if (!dynamicVoiceGrid) return;
    const prov = voiceProviderSelect?.value || localStorage.getItem('aetheria_voice_provider') || 'browser';
    const voices = getAvailableVoicesForProvider(prov);
    const currentVoiceId = voiceIdInput?.value || localStorage.getItem('aetheria_voice_id') || (prov === 'elevenlabs' ? '21m00Tcm4TlvDq8ikWAM' : prov === 'openai' ? 'nova' : 'default');

    // Case 1: Provider needs API key but none is connected -> show clean connection prompt
    if (voices === null) {
      const provTitle = prov === 'elevenlabs' ? 'ElevenLabs' : prov === 'google' ? 'Google Cloud' : prov.toUpperCase();
      dynamicVoiceGrid.innerHTML = `
        <div class="col-span-full p-6 rounded-2xl bg-purple-950/20 border border-purple-500/30 text-center space-y-3">
          <div class="w-10 h-10 rounded-xl bg-purple-500/20 border border-purple-500/30 text-purple-300 flex items-center justify-center mx-auto shadow-inner">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
          </div>
          <div>
            <h5 class="text-xs font-bold text-white mb-1">Live API Voices Required</h5>
            <p class="text-[11px] text-slate-400 max-w-sm mx-auto leading-relaxed">
              Connect your ${provTitle} API key above to load live voices (including your personal cloned voices and studio models) directly from your account.
            </p>
          </div>
          <button 
            type="button" 
            class="px-4 py-1.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white text-xs font-semibold inline-flex items-center gap-1.5 cursor-pointer shadow-md transition active:scale-95" 
            onclick="document.getElementById('voice-api-key')?.focus()"
          >
            <span>Enter API Key</span>
          </button>
        </div>
      `;
      if (voiceSyncStatusText) voiceSyncStatusText.textContent = `Connect ${provTitle} key to fetch live voices`;
      return;
    }

    // Case 2: Key exists, but voices not yet fetched -> show real-time loading spinner and auto-fetch!
    if (Array.isArray(voices) && voices.length === 0 && prov !== 'browser') {
      const provTitle = prov === 'elevenlabs' ? 'ElevenLabs' : prov === 'google' ? 'Google Cloud' : prov.toUpperCase();
      dynamicVoiceGrid.innerHTML = `
        <div class="col-span-full p-8 rounded-2xl bg-purple-950/20 border border-purple-500/30 text-center space-y-3">
          <div class="w-8 h-8 rounded-full border-2 border-purple-400 border-t-transparent animate-spin mx-auto"></div>
          <div>
            <p class="text-xs font-semibold text-purple-200">Fetching live voices from ${provTitle} API...</p>
            <p class="text-[10px] text-slate-400 mt-0.5">Syncing your personal cloned and library voices in real time</p>
          </div>
        </div>
      `;
      // Trigger background sync automatically
      setTimeout(() => {
        syncVoicesForProvider(prov, false);
      }, 50);
      return;
    }

    const q = (searchQuery || '').toLowerCase().trim();
    const filtered = (voices || []).filter(v => {
      if (!q) return true;
      return (v.name && v.name.toLowerCase().includes(q)) ||
             (v.style && v.style.toLowerCase().includes(q)) ||
             (v.accent && v.accent.toLowerCase().includes(q)) ||
             (v.gender && v.gender.toLowerCase().includes(q)) ||
             (v.id && v.id.toLowerCase().includes(q));
    });

    if (filtered.length === 0) {
      dynamicVoiceGrid.innerHTML = `
        <div class="col-span-full p-5 rounded-2xl bg-white/[0.02] border border-white/5 text-center text-xs text-slate-400">
          No voices match "${searchQuery}". Click "Sync Voices" to refresh from your API account.
        </div>
      `;
      return;
    }

    dynamicVoiceGrid.innerHTML = filtered.map(v => {
      const isSel = v.id === currentVoiceId || (prov === 'openai' && (v.id === openaiVoiceSelect?.value || v.id === localStorage.getItem('aetheria_openai_voice')));
      const isCloned = v.category === 'Cloned' || v.style?.includes('Cloned');
      return `
        <div 
          class="dynamic-voice-card p-2.5 rounded-xl border text-left transition cursor-pointer flex flex-col justify-between gap-1.5 relative group ${
            isSel 
              ? 'bg-purple-950/60 border-purple-500 shadow-md shadow-purple-950/80 ring-1 ring-purple-500/50' 
              : 'bg-white/[0.03] hover:bg-white/[0.06] border-white/10 hover:border-purple-500/30'
          }" 
          data-voice-id="${v.id}"
          data-voice-name="${v.name}"
          data-preview-url="${v.preview_url || ''}"
        >
          <div class="flex items-start justify-between gap-1.5">
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-1.5 flex-wrap">
                <span class="font-bold text-xs ${isSel ? 'text-white' : 'text-slate-200 group-hover:text-purple-200'} truncate">${v.name}</span>
                ${isCloned ? '<span class="px-1.5 py-0.2 rounded bg-rose-500/30 text-rose-300 text-[9px] font-bold font-mono">CLONED</span>' : ''}
                ${isSel ? '<span class="px-1.5 py-0.2 rounded bg-purple-500/30 text-purple-300 text-[9px] font-bold font-mono">SELECTED</span>' : ''}
              </div>
              <p class="text-[10px] text-slate-400 truncate mt-0.5">${v.style || v.accent || ''}</p>
            </div>
            
            <button 
              type="button" 
              class="preview-voice-card-btn w-6 h-6 rounded-lg bg-white/[0.06] hover:bg-purple-600 text-slate-300 hover:text-white flex items-center justify-center text-[10px] transition cursor-pointer shrink-0 active:scale-90" 
              title="Audition ${v.name}"
            >
              ▶
            </button>
          </div>

          <div class="flex items-center gap-1 flex-wrap pt-0.5">
            ${v.gender ? `<span class="px-1.5 py-0.5 rounded-md bg-white/[0.04] text-[9px] text-slate-300 border border-white/5 font-medium">${v.gender}</span>` : ''}
            ${v.accent ? `<span class="px-1.5 py-0.5 rounded-md bg-white/[0.04] text-[9px] text-slate-400 border border-white/5">${v.accent}</span>` : ''}
            ${v.category && !isCloned ? `<span class="px-1.5 py-0.5 rounded-md bg-purple-900/30 text-[9px] text-purple-300 border border-purple-500/20">${v.category}</span>` : ''}
          </div>
        </div>
      `;
    }).join('');

    // Attach card click listeners
    dynamicVoiceGrid.querySelectorAll('.dynamic-voice-card').forEach(card => {
      card.addEventListener('click', (e) => {
        if (e.target.closest('.preview-voice-card-btn')) return;

        const vId = card.getAttribute('data-voice-id');
        const vName = card.getAttribute('data-voice-name');
        if (!vId) return;

        if (voiceIdInput) voiceIdInput.value = vId;
        localStorage.setItem('aetheria_voice_id', vId);

        if (prov === 'openai' && openaiVoiceSelect) {
          openaiVoiceSelect.value = vId;
          localStorage.setItem('aetheria_openai_voice', vId);
        } else if (prov === 'google') {
          localStorage.setItem('aetheria_google_voice', vId);
        }

        renderDynamicVoiceCatalog(voiceSearchInput?.value || '');
        if (voicePreviewStatusText) {
          voicePreviewStatusText.textContent = `Selected voice: ${vName}`;
        }
        showNotification(`✓ Voice selected: ${vName}`);
      });
    });

    // Attach preview audition button listeners
    dynamicVoiceGrid.querySelectorAll('.preview-voice-card-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const card = btn.closest('.dynamic-voice-card');
        if (!card) return;

        const vId = card.getAttribute('data-voice-id');
        const vName = card.getAttribute('data-voice-name');
        const previewUrl = card.getAttribute('data-preview-url');

        if (previewUrl) {
          stopSpeaking();
          btn.textContent = '■';
          activeAudio = new Audio(previewUrl);
          activeAudio.onended = () => { btn.textContent = '▶'; };
          activeAudio.onerror = () => { btn.textContent = '▶'; };
          activeAudio.play();
          showNotification(`Playing preview of ${vName}...`);
        } else {
          if (voiceIdInput) voiceIdInput.value = vId;
          localStorage.setItem('aetheria_voice_id', vId);
          if (prov === 'openai' && openaiVoiceSelect) {
            openaiVoiceSelect.value = vId;
            localStorage.setItem('aetheria_openai_voice', vId);
          } else if (prov === 'google') {
            localStorage.setItem('aetheria_google_voice', vId);
          }
          speak(`Hello! This is ${vName}.`, btn);
        }
      });
    });
