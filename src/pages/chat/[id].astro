    if (sttModelSelect) sttModelSelect.value = sttModel;
    const sttLang = localStorage.getItem('aetheria_stt_lang') || 'auto';
    if (typeof updateSttLangTriggerDisplay === 'function') updateSttLangTriggerDisplay(sttLang);

    if (typeof renderVoiceProfileMenu === 'function') renderVoiceProfileMenu();
    if (typeof renderSttProfileMenu === 'function') renderSttProfileMenu();
    if (typeof renderImageProfileMenu === 'function') renderImageProfileMenu();
    if (typeof renderVisionProfileMenu === 'function') renderVisionProfileMenu();
    if (typeof renderVideoProfileMenu === 'function') renderVideoProfileMenu();
    if (typeof updateSpeedPillsAndLabel === 'function') updateSpeedPillsAndLabel(voiceRate);
    if (typeof updatePitchPillsAndLabel === 'function') updatePitchPillsAndLabel(voicePitch);
    syncVoiceUiPanels();
    updateMicButtonState();

    // 4. Image settings
