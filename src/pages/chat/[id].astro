  }

  async function fetchDynamicSuggestions(contextText) {
    if (isGeneratingSmartPrompts) return;
    isGeneratingSmartPrompts = true;

    if (smartPromptsLoading) {
      smartPromptsLoading.classList.remove('hidden');
      smartPromptsLoading.classList.add('flex');
    }
    if (smartPromptsRefreshIcon) {
      smartPromptsRefreshIcon.classList.add('animate-spin');
    }

    try {
      let targetText = contextText;
      if (!targetText) {
        for (let i = conversation.length - 1; i >= 0; i--) {
          if (conversation[i].sender === 'character') {
            targetText = conversation[i].text;
            break;
          }
        }
      }
      if (!targetText) targetText = activeChar.greeting || character.greeting || '';

      const cleanText = targetText.replace(/\*[^*]+\*/g, '').slice(0, 400).trim();

      const systemPrompt = `You are a roleplay co-writer for an interactive story with "${activeChar.name}".
Based on the character's last message, suggest exactly 3 short, diverse, high-impact options the user could say or do next.
Requirements:
1. Return ONLY a valid JSON array of 3 strings: ["option 1", "option 2", "option 3"].
2. Each option must be under 10 words.
3. Diverse roleplay angles: one conversational/witty reply, one story-progressing question, one bold physical or tactical action.
4. Language must match the dialogue.
5. Absolutely NO markdown, NO codeblocks, NO extra text.`;

      const userPrompt = `Character: ${activeChar.name}\nLast words:\n"${cleanText}"`;

      const res = await fetch('/api/chat/demo', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          messages: [
            { role: 'system', content: systemPrompt },
            { role: 'user', content: userPrompt }
          ]
        }),
        signal: AbortSignal.timeout(7000)
      });

      if (res.ok) {
        const raw = await res.text();
        let parsed = null;
        try {
          parsed = JSON.parse(raw.trim());
        } catch {
          const match = raw.match(/\[[\s\S]*?\]/);
          if (match) {
            try { parsed = JSON.parse(match[0]); } catch {}
          }
        }

        if (Array.isArray(parsed) && parsed.length > 0) {
          const cleanPills = parsed.filter(p => typeof p === 'string' && p.trim().length > 0).slice(0, 4);
          if (cleanPills.length > 0) {
            renderSmartPrompts(cleanPills);
            return;
          }
        }
      }
    } catch (err) {
      console.warn('Smart suggestions fetch error:', err);
    } finally {
      isGeneratingSmartPrompts = false;
      if (smartPromptsLoading) {
        smartPromptsLoading.classList.add('hidden');
        smartPromptsLoading.classList.remove('flex');
      }
      if (smartPromptsRefreshIcon) {
        smartPromptsRefreshIcon.classList.remove('animate-spin');
      }
    }
  }

  // Refresh Smart Prompts on click
  refreshSmartPromptsBtn?.addEventListener('click', () => {
    fetchDynamicSuggestions();
