    const densityRadioCompact = document.getElementById('density-radio-compact');
    const sendRadioEnter = document.getElementById('send-radio-enter');
    const sendRadioCtrlEnter = document.getElementById('send-radio-ctrl-enter');

    const exportBtn = document.getElementById('appearance-export-btn');
    const importBtn = document.getElementById('appearance-import-btn');
    const importBox = document.getElementById('appearance-import-box');
    const importTextarea = document.getElementById('appearance-import-textarea');
    const importCancel = document.getElementById('appearance-import-cancel');
    const importApply = document.getElementById('appearance-import-apply');

    const charId = window.AetheriaTheme?.getActiveCharId?.() || 'current';

    // In-memory working draft state
    let draftSettings = { ...(window.AetheriaTheme?.getSettings?.(charId) || {}) };
    let initialSavedState = { ...draftSettings };

    function switchTab(activeTab, activeView) {
      [tabPresets, tabWallpapers, tabBubbles, tabExtras].forEach(t => {
        if (!t) return;
        t.classList.remove('active', 'border-purple-500', 'text-white');
        t.classList.add('border-transparent', 'text-slate-400');
      });
      [viewPresets, viewWallpapers, viewBubbles, viewExtras].forEach(v => {
        if (v) v.classList.add('hidden');
      });

      if (activeTab && activeView) {
        activeTab.classList.add('active', 'border-purple-500', 'text-white');
        activeTab.classList.remove('border-transparent', 'text-slate-400');
        activeView.classList.remove('hidden');
      }
    }

    tabPresets?.addEventListener('click', () => switchTab(tabPresets, viewPresets));
    tabWallpapers?.addEventListener('click', () => switchTab(tabWallpapers, viewWallpapers));
    tabBubbles?.addEventListener('click', () => switchTab(tabBubbles, viewBubbles));
    tabExtras?.addEventListener('click', () => switchTab(tabExtras, viewExtras));

    // Update Live Preview Viewport
    function updateLivePreview() {
      if (!previewViewport) return;

      const baseMode = draftSettings.baseMode || 'dark';

      // Base mode classes and colors on preview
      if (baseMode === 'amoled') {
        previewViewport.style.backgroundColor = '#000000';
        if (previewCharBubble) {
          previewCharBubble.style.background = '#09090b';
          previewCharBubble.style.borderColor = 'rgba(255, 255, 255, 0.08)';
          previewCharBubble.style.color = '#f1f5f9';
        }
      } else if (baseMode === 'day') {
        previewViewport.style.backgroundColor = '#e2e8f0';
        if (previewCharBubble) {
          previewCharBubble.style.background = '#ffffff';
          previewCharBubble.style.borderColor = '#cbd5e1';
          previewCharBubble.style.color = '#0f172a';
        }
      } else {
        previewViewport.style.backgroundColor = '#090a12';
        if (previewCharBubble) {
          previewCharBubble.style.background = draftSettings.charBubbleBg || '#101426';
          previewCharBubble.style.borderColor = 'rgba(255, 255, 255, 0.08)';
          previewCharBubble.style.color = '#f1f5f9';
        }
      }

      // Background Wallpaper
      if (previewImage) {
        previewImage.style.background = draftSettings.chatWallpaper || draftSettings.chatBg || 'linear-gradient(to bottom, #090a12, #0e1122, #07080f)';
        previewImage.style.filter = draftSettings.chatBlur ? 'blur(14px)' : 'none';
        previewImage.style.transform = draftSettings.chatBlur ? 'scale(1.08)' : 'none';
      }

      // Dimmer
      if (previewDimmer) {
        previewDimmer.style.opacity = String(draftSettings.chatDim !== undefined ? draftSettings.chatDim : 0.20);
      }

      // Pattern
      if (previewPattern) {
        const patId = draftSettings.chatPatternId || 'telegram-doodles';
        const patObj = window.AetheriaTheme?.DOODLE_PATTERNS?.[patId];
        if (patObj && patObj.pattern !== 'none') {
          previewPattern.style.backgroundImage = patObj.pattern;
          previewPattern.style.backgroundSize = patObj.patternSize;
          previewPattern.style.opacity = String(draftSettings.chatPatternOpacity !== undefined ? draftSettings.chatPatternOpacity : 0.18);
        } else {
          previewPattern.style.backgroundImage = 'none';
          previewPattern.style.opacity = '0';
        }
      }

      // Name Color
      const nameColor = draftSettings.nameColor || '#a855f7';
      if (previewCharName) {
        previewCharName.style.color = nameColor;
      }

      // Bubbles Geometry
      const radius = draftSettings.bubbleRadius !== undefined ? draftSettings.bubbleRadius : 16;
      const fontSize = draftSettings.fontSize !== undefined ? draftSettings.fontSize : 16;

      if (previewCharBubble) {
        previewCharBubble.style.borderRadius = `${radius}px`;
        previewCharBubble.style.fontSize = `${fontSize}px`;
      }
      if (previewUserBubble) {
        previewUserBubble.style.borderRadius = `${radius}px`;
        previewUserBubble.style.fontSize = `${fontSize}px`;
        if (draftSettings.userBubbleBg) {
          previewUserBubble.style.background = draftSettings.userBubbleBg;
        }
      }

      // Highlight active base mode pill
      baseModeButtons.forEach(btn => {
        const mode = btn.dataset.mode;
        if (mode === baseMode) {
          btn.classList.add('bg-purple-600', 'text-white', 'shadow-xs');
          btn.classList.remove('text-slate-300');
        } else {
          btn.classList.remove('bg-purple-600', 'text-white', 'shadow-xs');
          btn.classList.add('text-slate-300');
        }
      });
    }

    // Base Mode Toggle Buttons
    baseModeButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        draftSettings.baseMode = btn.dataset.mode;
        if (draftSettings.baseMode === 'amoled') {
          draftSettings.chatWallpaper = '#000000';
          draftSettings.chatPatternId = 'none';
        } else if (draftSettings.baseMode === 'day') {
          draftSettings.chatWallpaper = 'linear-gradient(to bottom, #e2e8f0, #cbd5e1, #94a3b8)';
        }
        updateLivePreview();
        window.AetheriaTheme?.apply?.(draftSettings);
      });
    });

    // Populate Built-in Presets
    function renderPresets() {
      const grid = document.getElementById('appearance-presets-grid');
      if (!grid) return;
      const presets = window.AetheriaTheme?.PRESETS || [];

      grid.innerHTML = presets.map(p => `
        <div class="preset-card p-3 rounded-2xl bg-white/[0.02] border border-white/[0.08] hover:border-purple-500/50 hover:bg-white/[0.04] transition cursor-pointer group flex items-center justify-between" data-preset-id="${p.id}">
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 rounded-xl bg-gradient-to-br ${p.iconGradient || 'from-purple-600 to-indigo-600'} p-0.5 shadow-md flex items-center justify-center text-white shrink-0">
              <span class="text-xs font-bold font-mono">TG</span>
            </div>
            <div>
              <div class="flex items-center gap-1.5">
                <span class="text-xs font-bold text-white group-hover:text-purple-300 transition">${p.name}</span>
                <span class="text-[9px] px-1.5 py-0.2 rounded bg-white/10 text-slate-300 uppercase font-mono">${p.baseMode || 'dark'}</span>
              </div>
              <p class="text-[11px] text-slate-400 truncate max-w-[170px] sm:max-w-[210px]">${p.description}</p>
            </div>
          </div>
          <div class="w-6 h-6 rounded-full border border-white/20 flex items-center justify-center text-transparent preset-indicator shrink-0">
            <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </div>
        </div>
      `).join('');

      grid.querySelectorAll('.preset-card').forEach(card => {
        card.addEventListener('click', () => {
          const pid = card.dataset.presetId;
          const found = presets.find(p => p.id === pid);
          if (!found) return;

          draftSettings = {
            ...draftSettings,
            ...found,
            chatWallpaper: found.chatWallpaper,
            chatPatternId: found.chatPatternId,
            chatPatternOpacity: found.chatPatternOpacity,
            chatBlur: found.chatBlur,
            chatDim: found.chatDim,
            userBubbleBg: found.userBubbleBg,
            charBubbleBg: found.charBubbleBg,
            accent: found.accent,
            accentRgb: found.accentRgb,
            nameColor: found.nameColor || found.accent,
            bubbleRadius: found.bubbleRadius,
            fontSize: found.fontSize,
            baseMode: found.baseMode || 'dark'
          };

          syncControls();
          updateLivePreview();
          window.AetheriaTheme?.apply?.(draftSettings);
        });
      });
    }

    // Render User Saved Custom Themes (STEP 4)
    function renderCustomThemes() {
      if (!customThemesContainer || !customThemesGrid) return;
      const list = window.AetheriaTheme?.getCustomThemes?.() || [];

      if (list.length === 0) {
        customThemesContainer.classList.add('hidden');
        return;
      }

      customThemesContainer.classList.remove('hidden');
      customThemesGrid.innerHTML = list.map(t => `
        <div class="p-2.5 rounded-xl bg-white/[0.03] border border-purple-500/20 hover:border-purple-500/60 transition group flex flex-col justify-between" data-custom-id="${t.id}">
          <div class="flex items-center justify-between gap-1 mb-2">
            <span class="text-xs font-bold text-white truncate max-w-[110px]">${escapeHtml(t.name)}</span>
            <button type="button" class="delete-custom-btn text-slate-500 hover:text-rose-400 p-1 rounded transition cursor-pointer" data-delete-id="${t.id}" title="Delete Theme">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            </button>
          </div>
          <div class="flex items-center gap-1.5 mb-2">
            <div class="w-4 h-4 rounded-full" style="background: ${t.accent || '#9333ea'};" title="Accent"></div>
            <div class="w-4 h-4 rounded-full" style="background: ${t.nameColor || '#a855f7'};" title="Name"></div>
            <div class="flex-1 h-3 rounded-full opacity-80" style="background: ${t.userBubbleBg || 'linear-gradient(135deg, #9333ea, #6366f1)'};" title="Bubble"></div>
          </div>
          <button type="button" class="apply-custom-btn w-full py-1 rounded-lg bg-purple-600/30 hover:bg-purple-600 text-purple-200 hover:text-white text-[10px] font-bold transition cursor-pointer text-center">
            Apply Theme
          </button>
        </div>
      `).join('');

      customThemesGrid.querySelectorAll('.apply-custom-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const card = e.target.closest('[data-custom-id]');
          const id = card?.dataset.customId;
          const found = list.find(item => item.id === id);
          if (found) {
            draftSettings = { ...draftSettings, ...found };
            syncControls();
            updateLivePreview();
            window.AetheriaTheme?.apply?.(draftSettings);
          }
        });
      });

      customThemesGrid.querySelectorAll('.delete-custom-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const id = btn.dataset.deleteId;
          if (confirm('Delete this custom theme?')) {
            window.AetheriaTheme?.deleteCustomTheme?.(id);
            renderCustomThemes();
          }
        });
      });
    }

    // Toggle Custom Theme Creation Form
    btnToggleCustomForm?.addEventListener('click', () => {
      customThemeForm?.classList.toggle('hidden');
      if (!customThemeForm?.classList.contains('hidden')) {
        customThemeNameInput?.focus();
      }
    });

    btnCancelCustomTheme?.addEventListener('click', () => {
      customThemeForm?.classList.add('hidden');
      if (customThemeNameInput) customThemeNameInput.value = '';
    });

    btnSaveCustomTheme?.addEventListener('click', () => {
      const name = customThemeNameInput ? customThemeNameInput.value.trim() : '';
      if (!name) {
        alert('Please enter a theme name');
        return;
      }
      window.AetheriaTheme?.saveCustomTheme?.(name, {
        baseMode: draftSettings.baseMode || 'dark',
        accent: draftSettings.accent || '#9333ea',
        accentRgb: draftSettings.accentRgb || '147, 51, 234',
        nameColor: draftSettings.nameColor || '#a855f7',
        userBubbleBg: draftSettings.userBubbleBg || 'linear-gradient(135deg, #9333ea, #6366f1)',
        charBubbleBg: draftSettings.charBubbleBg || '#101426',
        chatWallpaper: draftSettings.chatWallpaper || 'linear-gradient(to bottom, #090a12, #0e1122, #07080f)',
        chatPatternId: draftSettings.chatPatternId || 'telegram-doodles',
        chatPatternOpacity: draftSettings.chatPatternOpacity !== undefined ? draftSettings.chatPatternOpacity : 0.18,
        chatBlur: !!draftSettings.chatBlur,
        chatDim: draftSettings.chatDim !== undefined ? draftSettings.chatDim : 0.20,
        bubbleRadius: draftSettings.bubbleRadius !== undefined ? draftSettings.bubbleRadius : 16,
        fontSize: draftSettings.fontSize !== undefined ? draftSettings.fontSize : 16,
        chatDensity: draftSettings.chatDensity || 'comfortable'
      });
      if (customThemeNameInput) customThemeNameInput.value = '';
      customThemeForm?.classList.add('hidden');
      renderCustomThemes();
    });

    // Telegram 7 Name Colors (STEP 4)
    function renderNameColors() {
      if (!nameColorPalette) return;
      const colors = window.AetheriaTheme?.NAME_COLORS || [];

      nameColorPalette.innerHTML = colors.map(nc => `
        <button type="button" class="name-color-pill p-2 rounded-xl bg-white/[0.02] border border-white/[0.08] hover:border-white/30 flex flex-col items-center gap-1.5 transition cursor-pointer" data-color="${nc.hex}" title="${nc.name}">
          <div class="w-6 h-6 rounded-full shadow-md flex items-center justify-center text-white" style="background: ${nc.hex};">
            <svg class="w-3 h-3 text-white opacity-0 name-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </div>
          <span class="text-[10px] text-slate-400 font-mono truncate max-w-[50px]">${nc.name.split(' ')[0]}</span>
        </button>
      `).join('');

      nameColorPalette.querySelectorAll('.name-color-pill').forEach(pill => {
        pill.addEventListener('click', () => {
          const col = pill.dataset.color;
          draftSettings.nameColor = col;
          if (customNameColorInput) customNameColorInput.value = col;
          if (nameColorHex) nameColorHex.textContent = col.toUpperCase();
          updateNameColorSelection();
          updateLivePreview();
          window.AetheriaTheme?.apply?.(draftSettings);
        });
      });
    }

    function updateNameColorSelection() {
      const activeColor = (draftSettings.nameColor || '#a855f7').toLowerCase();
      nameColorPalette?.querySelectorAll('.name-color-pill').forEach(pill => {
        const isMatch = (pill.dataset.color || '').toLowerCase() === activeColor;
        const check = pill.querySelector('.name-check');
        if (isMatch) {
          pill.classList.add('border-purple-500', 'bg-purple-500/10');
          if (check) check.classList.remove('opacity-0');
        } else {
          pill.classList.remove('border-purple-500', 'bg-purple-500/10');
          if (check) check.classList.add('opacity-0');
        }
      });
    }

    customNameColorInput?.addEventListener('input', (e) => {
      draftSettings.nameColor = e.target.value;
      if (nameColorHex) nameColorHex.textContent = e.target.value.toUpperCase();
      updateNameColorSelection();
      updateLivePreview();
      window.AetheriaTheme?.apply?.(draftSettings);
    });

    // Sound Controls (STEP 4)
    function syncSoundControls() {
      const isEnabled = window.AetheriaTheme?.isSoundEnabled?.() !== false;
      if (soundToggle) {
        if (isEnabled) {
          soundToggle.textContent = 'Enabled';
          soundToggle.className = 'px-3.5 py-1.5 rounded-xl border text-xs font-semibold transition cursor-pointer bg-purple-500/20 border-purple-500/30 text-purple-300';
        } else {
          soundToggle.textContent = 'Muted';
          soundToggle.className = 'px-3.5 py-1.5 rounded-xl border text-xs font-semibold transition cursor-pointer bg-white/5 border-white/10 text-slate-400';
        }
      }
    }

    soundToggle?.addEventListener('click', () => {
      const current = window.AetheriaTheme?.isSoundEnabled?.() !== false;
      window.AetheriaTheme?.setSoundEnabled?.(!current);
      syncSoundControls();
    });

    soundTestSend?.addEventListener('click', () => {
      window.AetheriaTheme?.playSendSound?.();
    });

    soundTestReceive?.addEventListener('click', () => {
      window.AetheriaTheme?.playReceiveSound?.();
    });

    // Doodle Pattern Pills
    function renderDoodlePills() {
      const container = document.getElementById('appearance-doodle-pills');
      if (!container) return;
      const patterns = window.AetheriaTheme?.DOODLE_PATTERNS || {};

      container.innerHTML = Object.values(patterns).map(p => `
        <button type="button" class="pattern-pill p-2 rounded-xl bg-white/[0.02] border border-white/[0.06] hover:border-purple-500/40 text-[11px] font-medium text-slate-300 hover:text-white transition cursor-pointer flex flex-col items-center gap-1" data-pattern-id="${p.id}">
          <span class="truncate max-w-full">${p.name}</span>
        </button>
      `).join('');

      container.querySelectorAll('.pattern-pill').forEach(pill => {
        pill.addEventListener('click', () => {
          draftSettings.chatPatternId = pill.dataset.patternId;
          updateDoodleSelection();
          updateLivePreview();
          window.AetheriaTheme?.apply?.(draftSettings);
        });
      });
    }

    function updateDoodleSelection() {
      const activePat = draftSettings.chatPatternId || 'telegram-doodles';
      document.querySelectorAll('#appearance-doodle-pills .pattern-pill').forEach(pill => {
        if (pill.dataset.patternId === activePat) {
          pill.classList.add('border-purple-500', 'bg-purple-500/20', 'text-white');
          pill.classList.remove('border-white/[0.06]', 'text-slate-300');
        } else {
          pill.classList.remove('border-purple-500', 'bg-purple-500/20', 'text-white');
          pill.classList.add('border-white/[0.06]', 'text-slate-300');
        }
      });
    }

    // Wallpaper Gallery
    let activeWallpaperCategory = 'all';
    function renderWallpapers() {
      const grid = document.getElementById('appearance-wallpapers-grid');
      if (!grid) return;
      const wallpapers = window.AetheriaTheme?.WALLPAPERS || [];

      const filtered = activeWallpaperCategory === 'all' 
        ? wallpapers 
        : wallpapers.filter(w => w.category === activeWallpaperCategory);

      grid.innerHTML = filtered.map(w => `
        <div class="wallpaper-card relative h-20 rounded-xl overflow-hidden border border-white/10 hover:border-purple-500 transition cursor-pointer group select-none shadow-sm" data-wallpaper-css="${escapeHtml(w.cssValue)}">
          <div class="absolute inset-0" style="background: ${w.thumb.startsWith('http') ? `url('${w.thumb}') center/cover` : w.thumb};"></div>
          <div class="absolute inset-0 bg-black/40 group-hover:bg-black/10 transition"></div>
          <span class="absolute bottom-1.5 left-2 text-[10px] font-medium text-white truncate max-w-[80%] drop-shadow">${w.name}</span>
          <div class="absolute top-1.5 right-1.5 w-5 h-5 rounded-full bg-purple-600 text-white flex items-center justify-center opacity-0 group-hover:opacity-100 transition shadow">
            <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
          </div>
        </div>
      `).join('');

      grid.querySelectorAll('.wallpaper-card').forEach(card => {
        card.addEventListener('click', () => {
          draftSettings.chatWallpaper = card.dataset.wallpaperCss;
          updateLivePreview();
          window.AetheriaTheme?.apply?.(draftSettings);
        });
      });
    }

    document.querySelectorAll('#appearance-wallpaper-category-filters .wp-cat-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#appearance-wallpaper-category-filters .wp-cat-btn').forEach(b => {
          b.classList.remove('active', 'bg-purple-500/20', 'border-purple-500/30', 'text-purple-300');
          b.classList.add('bg-white/5', 'text-slate-400');
        });
        btn.classList.add('active', 'bg-purple-500/20', 'border-purple-500/30', 'text-purple-300');
        btn.classList.remove('bg-white/5', 'text-slate-400');
        activeWallpaperCategory = btn.dataset.cat;
        renderWallpapers();
      });
    });

    // Preset Gradients Pills
    function renderGradientPresets() {
      const container = document.getElementById('appearance-bubble-gradient-presets');
      if (!container) return;
      const grads = window.AetheriaTheme?.BUBBLE_GRADIENTS || [];

      container.innerHTML = grads.map(g => `
        <button type="button" class="grad-pill p-2 rounded-xl bg-white/[0.02] border border-white/[0.06] hover:border-purple-500/50 flex items-center gap-2 transition cursor-pointer text-left" data-grad-css="${escapeHtml(g.css)}" data-grad-from="${g.from}" data-grad-to="${g.to}">
          <div class="w-5 h-5 rounded-lg shadow-inner shrink-0" style="background: ${g.css};"></div>
          <span class="text-xs text-slate-300 truncate font-medium">${g.name}</span>
        </button>
      `).join('');

      container.querySelectorAll('.grad-pill').forEach(pill => {
        pill.addEventListener('click', () => {
          draftSettings.userBubbleBg = pill.dataset.gradCss;
          if (gradColorA) gradColorA.value = pill.dataset.gradFrom;
          if (gradValA) gradValA.textContent = pill.dataset.gradFrom.toUpperCase();
          if (gradColorB) gradColorB.value = pill.dataset.gradTo;
          if (gradValB) gradValB.textContent = pill.dataset.gradTo.toUpperCase();
          updateLivePreview();
          window.AetheriaTheme?.apply?.(draftSettings);
        });
      });
    }

    // Custom 2-Color Gradient Builder
    applyGradBtn?.addEventListener('click', () => {
      const from = gradColorA?.value || '#9333ea';
      const to = gradColorB?.value || '#6366f1';
      const css = `linear-gradient(135deg, ${from} 0%, ${to} 100%)`;
      draftSettings.userBubbleBg = css;
      updateLivePreview();
      window.AetheriaTheme?.apply?.(draftSettings);
    });

    gradColorA?.addEventListener('input', (e) => {
      if (gradValA) gradValA.textContent = e.target.value.toUpperCase();
    });
    gradColorB?.addEventListener('input', (e) => {
      if (gradValB) gradValB.textContent = e.target.value.toUpperCase();
    });

    // Custom Accent Swatches
    const SWATCHES = [
      { name: 'Purple', hex: '#9333ea' },
      { name: 'Amber', hex: '#f59e0b' },
      { name: 'Cyan', hex: '#06b6d4' },
      { name: 'Emerald', hex: '#10b981' },
      { name: 'Rose', hex: '#f43f5e' },
      { name: 'Sky', hex: '#0284c7' }
    ];

    function renderSwatches() {
      if (!swatchesContainer) return;
      swatchesContainer.innerHTML = SWATCHES.map(s => `
        <button type="button" class="accent-swatch w-7 h-7 rounded-xl border border-white/20 transition cursor-pointer hover:scale-110 shadow-sm" style="background: ${s.hex};" data-hex="${s.hex}" title="${s.name}"></button>
      `).join('');

      swatchesContainer.querySelectorAll('.accent-swatch').forEach(sw => {
        sw.addEventListener('click', () => {
          const hex = sw.dataset.hex;
          draftSettings.accent = hex;
          draftSettings.accentRgb = window.AetheriaTheme?.hexToRgb?.(hex) || '147, 51, 234';
          if (customAccentInput) customAccentInput.value = hex;
          if (customAccentHex) customAccentHex.textContent = hex.toUpperCase();
          updateLivePreview();
          window.AetheriaTheme?.apply?.(draftSettings);
        });
      });
    }

    customAccentInput?.addEventListener('input', (e) => {
      const hex = e.target.value;
      draftSettings.accent = hex;
      draftSettings.accentRgb = window.AetheriaTheme?.hexToRgb?.(hex) || '147, 51, 234';
      if (customAccentHex) customAccentHex.textContent = hex.toUpperCase();
      updateLivePreview();
      window.AetheriaTheme?.apply?.(draftSettings);
    });

    // Sliders
    fontSlider?.addEventListener('input', (e) => {
      const val = parseInt(e.target.value, 10);
      draftSettings.fontSize = val;
      if (fontVal) fontVal.textContent = `${val}px`;
      updateLivePreview();
      window.AetheriaTheme?.apply?.(draftSettings);
    });

    radiusSlider?.addEventListener('input', (e) => {
      const val = parseInt(e.target.value, 10);
      draftSettings.bubbleRadius = val;
      if (radiusVal) radiusVal.textContent = `${val}px`;
      updateLivePreview();
      window.AetheriaTheme?.apply?.(draftSettings);
    });

    blurToggle?.addEventListener('click', () => {
      draftSettings.chatBlur = !draftSettings.chatBlur;
      if (blurToggle) {
        blurToggle.textContent = draftSettings.chatBlur ? 'On' : 'Off';
        blurToggle.className = draftSettings.chatBlur
          ? 'px-3 py-1.5 rounded-lg border text-xs font-semibold transition cursor-pointer bg-purple-500/20 border-purple-500/30 text-purple-300'
          : 'px-3 py-1.5 rounded-lg border text-xs font-semibold transition cursor-pointer bg-white/5 border-white/10 text-slate-300';
      }
      updateLivePreview();
      window.AetheriaTheme?.apply?.(draftSettings);
    });

    dimSlider?.addEventListener('input', (e) => {
      const val = parseInt(e.target.value, 10);
      draftSettings.chatDim = val / 100;
      if (dimVal) dimVal.textContent = `${val}%`;
      updateLivePreview();
      window.AetheriaTheme?.apply?.(draftSettings);
    });

    patternOpacitySlider?.addEventListener('input', (e) => {
      const val = parseInt(e.target.value, 10);
      draftSettings.chatPatternOpacity = val / 100;
      if (patternOpacityVal) patternOpacityVal.textContent = `${val}%`;
      updateLivePreview();
      window.AetheriaTheme?.apply?.(draftSettings);
    });

    // Photo Upload Handlers
    photoBtn?.addEventListener('click', () => photoFileInput?.click());

    photoFileInput?.addEventListener('change', (e) => {
      const file = e.target.files?.[0];
      if (!file) return;

      const reader = new FileReader();
      reader.onload = (event) => {
        const img = new Image();
        img.onload = () => {
          const canvas = document.createElement('canvas');
          let width = img.width;
          let height = img.height;
          const maxDim = 1920;
          if (width > maxDim || height > maxDim) {
            if (width > height) {
              height = Math.round((height * maxDim) / width);
              width = maxDim;
            } else {
              width = Math.round((width * maxDim) / height);
              height = maxDim;
            }
          }
          canvas.width = width;
          canvas.height = height;
          const ctx = canvas.getContext('2d');
          ctx.drawImage(img, 0, 0, width, height);

          const compressed = canvas.toDataURL('image/jpeg', 0.82);
          draftSettings.chatWallpaper = `url("${compressed}") center/cover no-repeat`;
          if (photoInfo) photoInfo.classList.remove('hidden');
          updateLivePreview();
          window.AetheriaTheme?.apply?.(draftSettings);
        };
        img.src = event.target.result;
      };
      reader.readAsDataURL(file);
    });

    photoUrlApply?.addEventListener('click', () => {
      const url = photoUrlInput ? photoUrlInput.value.trim() : '';
      if (!url) return;
      draftSettings.chatWallpaper = `url("${url}") center/cover no-repeat`;
      if (photoInfo) photoInfo.classList.remove('hidden');
      updateLivePreview();
      window.AetheriaTheme?.apply?.(draftSettings);
    });

    photoClear?.addEventListener('click', () => {
      draftSettings.chatWallpaper = 'linear-gradient(to bottom, #090a12, #0e1122, #07080f)';
      if (photoInfo) photoInfo.classList.add('hidden');
      if (photoFileInput) photoFileInput.value = '';
      if (photoUrlInput) photoUrlInput.value = '';
      updateLivePreview();
      window.AetheriaTheme?.apply?.(draftSettings);
    });

    // Chat Density Radios
    densityRadioComfortable?.addEventListener('change', () => {
      draftSettings.chatDensity = 'comfortable';
      window.AetheriaTheme?.apply?.(draftSettings);
    });
    densityRadioCompact?.addEventListener('change', () => {
      draftSettings.chatDensity = 'compact';
      window.AetheriaTheme?.apply?.(draftSettings);
    });

    // Send Shortcut Radios
    sendRadioEnter?.addEventListener('change', () => {
      localStorage.setItem('aetheria_chat_send_key', 'enter');
    });
    sendRadioCtrlEnter?.addEventListener('change', () => {
      localStorage.setItem('aetheria_chat_send_key', 'ctrl_enter');
    });

    // Scope Radios
    revertCharBtn?.addEventListener('click', () => {
      if (confirm('Revert this character to the global theme?')) {
        window.AetheriaTheme?.removeCharSettings?.(charId);
        draftSettings = { ...(window.AetheriaTheme?.getSettings?.(null) || {}) };
        initialSavedState = { ...draftSettings };
        syncControls();
        updateLivePreview();
      }
    });

    // JSON Export / Import
    exportBtn?.addEventListener('click', () => {
      const json = JSON.stringify(draftSettings, null, 2);
      navigator.clipboard?.writeText?.(json).then(() => {
        alert('Theme code copied to clipboard!');
      }).catch(() => {
        prompt('Theme JSON Code:', json);
      });
    });

    importBtn?.addEventListener('click', () => {
      importBox?.classList.toggle('hidden');
    });
    importCancel?.addEventListener('click', () => {
      importBox?.classList.add('hidden');
    });
    importApply?.addEventListener('click', () => {
      const raw = importTextarea ? importTextarea.value.trim() : '';
      if (!raw) return;
      try {
        const parsed = JSON.parse(raw);
        draftSettings = { ...draftSettings, ...parsed };
        syncControls();
        updateLivePreview();
        window.AetheriaTheme?.apply?.(draftSettings);
        importBox?.classList.add('hidden');
        if (importTextarea) importTextarea.value = '';
      } catch (err) {
        alert('Invalid Theme JSON!');
      }
    });

    // Factory Reset
    factoryResetBtn?.addEventListener('click', () => {
      if (confirm('Reset theme to original factory defaults?')) {
        window.AetheriaTheme?.resetToDefault?.(null);
        draftSettings = { ...(window.AetheriaTheme?.DEFAULT_THEME || {}) };
        syncControls();
        updateLivePreview();
      }
    });

    // Synchronize UI Controls with draftSettings
    function syncControls() {
      if (fontSlider) fontSlider.value = draftSettings.fontSize || 16;
      if (fontVal) fontVal.textContent = `${draftSettings.fontSize || 16}px`;

      if (radiusSlider) radiusSlider.value = draftSettings.bubbleRadius !== undefined ? draftSettings.bubbleRadius : 16;
      if (radiusVal) radiusVal.textContent = `${draftSettings.bubbleRadius !== undefined ? draftSettings.bubbleRadius : 16}px`;

      if (blurToggle) {
        blurToggle.textContent = draftSettings.chatBlur ? 'On' : 'Off';
        blurToggle.className = draftSettings.chatBlur
          ? 'px-3 py-1.5 rounded-lg border text-xs font-semibold transition cursor-pointer bg-purple-500/20 border-purple-500/30 text-purple-300'
          : 'px-3 py-1.5 rounded-lg border text-xs font-semibold transition cursor-pointer bg-white/5 border-white/10 text-slate-300';
      }

      const dim = Math.round((draftSettings.chatDim !== undefined ? draftSettings.chatDim : 0.20) * 100);
      if (dimSlider) dimSlider.value = dim;
      if (dimVal) dimVal.textContent = `${dim}%`;

      const patOp = Math.round((draftSettings.chatPatternOpacity !== undefined ? draftSettings.chatPatternOpacity : 0.18) * 100);
      if (patternOpacitySlider) patternOpacitySlider.value = patOp;
      if (patternOpacityVal) patternOpacityVal.textContent = `${patOp}%`;

      if (customAccentInput) customAccentInput.value = draftSettings.accent || '#9333ea';
      if (customAccentHex) customAccentHex.textContent = (draftSettings.accent || '#9333ea').toUpperCase();

      if (customNameColorInput) customNameColorInput.value = draftSettings.nameColor || '#a855f7';
      if (nameColorHex) nameColorHex.textContent = (draftSettings.nameColor || '#a855f7').toUpperCase();

      // Density
      if (draftSettings.chatDensity === 'compact') {
        if (densityRadioCompact) densityRadioCompact.checked = true;
      } else {
        if (densityRadioComfortable) densityRadioComfortable.checked = true;
      }

      // Send Key
      const sendPref = localStorage.getItem('aetheria_chat_send_key') || 'enter';
      if (sendPref === 'ctrl_enter') {
        if (sendRadioCtrlEnter) sendRadioCtrlEnter.checked = true;
      } else {
        if (sendRadioEnter) sendRadioEnter.checked = true;
      }

      // Scope
      const hasOverride = window.AetheriaTheme?.hasCharSettings?.(charId);
      if (hasOverride) {
        if (scopeRadioChar) scopeRadioChar.checked = true;
        if (charOverrideBanner) charOverrideBanner.classList.remove('hidden');
      } else {
        if (scopeRadioGlobal) scopeRadioGlobal.checked = true;
        if (charOverrideBanner) charOverrideBanner.classList.add('hidden');
      }

      updateDoodleSelection();
      updateNameColorSelection();
      syncSoundControls();
    }

    // Open Modal
    function openModal() {
      draftSettings = { ...(window.AetheriaTheme?.getSettings?.(charId) || {}) };
      initialSavedState = { ...draftSettings };

      renderPresets();
      renderCustomThemes();
      renderNameColors();
      renderDoodlePills();
      renderWallpapers();
      renderGradientPresets();
      renderSwatches();
      syncControls();
      updateLivePreview();

      modal.classList.remove('hidden');
      requestAnimationFrame(() => {
        modal.classList.remove('opacity-0');
        panel.classList.remove('scale-95');
      });
    }

    // Close Modal
    function closeModal(save = false) {
      if (!save) {
        window.AetheriaTheme?.apply?.(initialSavedState);
      }
      modal.classList.add('opacity-0');
      panel.classList.add('scale-95');
      setTimeout(() => {
        modal.classList.add('hidden');
      }, 200);
    }

    closeBtn?.addEventListener('click', () => closeModal(false));
    cancelBtn?.addEventListener('click', () => closeModal(false));
    modal?.addEventListener('click', (e) => {
      if (e.target === modal) closeModal(false);
    });

    resetBtn?.addEventListener('click', () => {
      draftSettings = { ...initialSavedState };
      syncControls();
      updateLivePreview();
      window.AetheriaTheme?.apply?.(draftSettings);
    });

    saveBtn?.addEventListener('click', () => {
      const isCharScope = scopeRadioChar?.checked;
      const targetChar = isCharScope ? charId : null;
      window.AetheriaTheme?.saveSettings?.(draftSettings, targetChar);
      closeModal(true);
    });

    // Wire trigger buttons
    const triggerInDropdown = document.getElementById('chat-appearance-trigger');
    triggerInDropdown?.addEventListener('click', () => {
      const menu = document.getElementById('chat-overflow-menu');
      if (menu) menu.classList.add('hidden');
      openModal();
    });

    // Listen to custom theme updates from other windows/tabs
    window.addEventListener('aetheria-custom-themes-updated', renderCustomThemes);
  }

  // Initialize engine on DOM load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initChatAppearanceEngine);
  } else {
    initChatAppearanceEngine();
  }
// Startup
  loadLorebook();
  initChat();
</script>
