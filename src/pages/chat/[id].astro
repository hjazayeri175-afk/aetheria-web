            type="text" 
            dir="auto"
            value="${escapeHtml(defaultValue)}" 
            placeholder="${escapeHtml(placeholder)}"
            class="w-full h-11 px-4 rounded-xl bg-black/40 border border-white/10 text-sm text-white placeholder:text-slate-500 focus:outline-none focus:border-emerald-500/60 focus:ring-1 focus:ring-emerald-500/40 transition"
