      return;
    }

    const prov = localStorage.getItem('aetheria_stt_provider') || 'browser-stt';
    if (prov === 'browser-stt' || prov === 'browser') {
      if (isListeningVoice) {
        try { speechRec?.stop(); } catch(e) {}
      } else if (speechRec) {
        try {
          const l = localStorage.getItem('aetheria_stt_lang') || 'auto';
          speechRec.lang = l === 'auto' ? (navigator.language || 'en-US') : (l === 'fa' ? 'fa-IR' : (l === 'en' ? 'en-US' : l));
          speechRec.start();
          showNotification('Listening via device mic... Speak now');
        } catch(e) {
          console.warn('SpeechRecognition start error:', e);
        }
      } else {
        showNotification('⚠️ Speech recognition not supported in this browser. Please use Groq Whisper.', 'warning');
      }
      return;
