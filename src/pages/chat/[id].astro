        if (!id) return;

        if (voiceCatalogMode === 'tts') {
          if (voiceProviderSelect) voiceProviderSelect.value = id;
          localStorage.setItem('aetheria_voice_provider', id);
        } else {
          if (sttProviderSelect) sttProviderSelect.value = id;
          localStorage.setItem('aetheria_stt_provider', id);
        }

        syncVoiceUiPanels();
        updateMicButtonState();
        closeVoiceEngineModal();
        showNotification(`✓ Switched to ${id.toUpperCase()}`);
      });
    });
  }

  voiceModalSearch?.addEventListener('input', () => {
    const q = voiceModalSearch.value;
    if (clearVoiceModalSearch) {
      clearVoiceModalSearch.classList.toggle('hidden', q.length === 0);
    }
    renderVoiceCatalogItems(q);
  });

  clearVoiceModalSearch?.addEventListener('click', () => {
    if (voiceModalSearch) {
      voiceModalSearch.value = '';
      clearVoiceModalSearch.classList.add('hidden');
      voiceModalSearch.focus();
    }
    renderVoiceCatalogItems('');
  });

  quickSelectFreeVoiceBtn?.addEventListener('click', () => {
    const currentActiveId = voiceCatalogMode === 'tts'
      ? (voiceProviderSelect?.value || 'browser')
      : (sttProviderSelect?.value || 'groq');
    const isFreeDefaultActive = voiceCatalogMode === 'tts' 
      ? currentActiveId === 'browser' 
      : currentActiveId === 'browser-stt';

    if (isFreeDefaultActive) {
      closeVoiceEngineModal();
      return;
    }

    if (voiceCatalogMode === 'tts') {
      if (voiceProviderSelect) voiceProviderSelect.value = 'browser';
      localStorage.setItem('aetheria_voice_provider', 'browser');
    } else {
      if (sttProviderSelect) sttProviderSelect.value = 'browser-stt';
      localStorage.setItem('aetheria_stt_provider', 'browser-stt');
    }
    syncVoiceUiPanels();
    updateMicButtonState();
    closeVoiceEngineModal();
    showNotification('✓ Switched to Free Device Voice');
  });

// ==========================================
  // VOICE KEYS & PER-PROVIDER STORAGE
  // ==========================================
  function getVoiceKeyForProvider(prov) {
    if (!prov) return '';
    const specificKey = localStorage.getItem('aetheria_voice_key_' + prov);
    if (specificKey) return specificKey;
    if (prov === 'openai') {
      const textKey = localStorage.getItem('aetheria_key_openai');
      if (textKey) return textKey;
    }
    return localStorage.getItem('aetheria_voice_key') || '';
  }

  function setVoiceKeyForProvider(prov, key) {
    if (prov) {
      localStorage.setItem('aetheria_voice_key_' + prov, key);
    }
    localStorage.setItem('aetheria_voice_key', key);
  }

  // ==========================================
  // VOICE PROFILES (Named Presets)
  // ==========================================
  const VOICE_PROFILES_STORAGE_KEY = 'aetheria_voice_profiles';
  const ACTIVE_VOICE_PROFILE_KEY = 'aetheria_active_voice_profile_id';

  function getSavedVoiceProfiles() {
    try {
      const raw = localStorage.getItem(VOICE_PROFILES_STORAGE_KEY);
      return raw ? JSON.parse(raw) : [];
    } catch (e) {
      return [];
    }
  }

  function saveVoiceProfiles(profiles) {
    try {
      localStorage.setItem(VOICE_PROFILES_STORAGE_KEY, JSON.stringify(profiles));
    } catch (e) {
      console.error(e);
    }
  }

  function renderVoiceProfileMenu() {
    if (!customVoiceProfileMenu) return;
    const profiles = getSavedVoiceProfiles();
    const activeId = localStorage.getItem(ACTIVE_VOICE_PROFILE_KEY) || '';

    let html = `
      <button 
        type="button" 
        class="voice-profile-item w-full px-3 py-2 rounded-xl text-left transition flex items-center justify-between text-xs cursor-pointer ${
          !activeId ? 'bg-purple-600/30 text-white font-semibold border border-purple-500/40' : 'text-slate-300 hover:bg-white/[0.06] hover:text-white'
        }" 
        data-profile-id=""
      >
        <div class="flex items-center gap-2 min-w-0">
          <span class="w-2 h-2 rounded-full ${!activeId ? 'bg-emerald-400' : 'bg-slate-500'}"></span>
          <span class="truncate">Device Voice (Default)</span>
        </div>
        ${!activeId ? '<span class="text-[10px] text-purple-300 font-mono">Active</span>' : ''}
      </button>
    `;

    profiles.forEach(p => {
      const isSel = p.id === activeId;
      html += `
        <button 
          type="button" 
          class="voice-profile-item w-full px-3 py-2 rounded-xl text-left transition flex items-center justify-between text-xs cursor-pointer ${
            isSel ? 'bg-purple-600/30 text-white font-semibold border border-purple-500/40' : 'text-slate-300 hover:bg-white/[0.06] hover:text-white'
          }" 
          data-profile-id="${p.id}"
        >
          <div class="flex items-center gap-2 min-w-0">
            <span class="w-2 h-2 rounded-full ${isSel ? 'bg-emerald-400' : 'bg-purple-400'}"></span>
            <span class="truncate">${p.name}</span>
          </div>
          <span class="text-[9px] px-1.5 py-0.5 rounded bg-white/10 text-slate-300 font-mono uppercase">${p.provider}</span>
        </button>
      `;
    });

    customVoiceProfileMenu.innerHTML = html;

    // Update active trigger label & tag
    if (activeId) {
      const activeProf = profiles.find(p => p.id === activeId);
      if (activeProf) {
        if (customVoiceProfileTriggerLabel) customVoiceProfileTriggerLabel.textContent = activeProf.name;
        if (customVoiceProfileTriggerTag) {
          customVoiceProfileTriggerTag.textContent = activeProf.provider;
          customVoiceProfileTriggerTag.classList.remove('hidden');
        }
        if (customVoiceProfileStatusDot) customVoiceProfileStatusDot.className = 'w-2 h-2 rounded-full bg-emerald-400 shrink-0';
        if (btnUpdateActiveVoiceProfile) btnUpdateActiveVoiceProfile.classList.remove('hidden');
        if (btnDeleteActiveVoiceProfile) btnDeleteActiveVoiceProfile.classList.remove('hidden');
        if (voiceActiveProfileBadge) {
          voiceActiveProfileBadge.textContent = activeProf.name;
          voiceActiveProfileBadge.classList.remove('hidden');
        }
      } else {
        localStorage.removeItem(ACTIVE_VOICE_PROFILE_KEY);
        renderVoiceProfileMenu();
      }
    } else {
      if (customVoiceProfileTriggerLabel) customVoiceProfileTriggerLabel.textContent = 'Device Voice (Default)';
      if (customVoiceProfileTriggerTag) customVoiceProfileTriggerTag.classList.add('hidden');
      if (customVoiceProfileStatusDot) customVoiceProfileStatusDot.className = 'w-2 h-2 rounded-full bg-slate-400 shrink-0';
      if (btnUpdateActiveVoiceProfile) btnUpdateActiveVoiceProfile.classList.add('hidden');
      if (btnDeleteActiveVoiceProfile) btnDeleteActiveVoiceProfile.classList.add('hidden');
      if (voiceActiveProfileBadge) voiceActiveProfileBadge.classList.add('hidden');
    }

    // Attach click listeners
    customVoiceProfileMenu.querySelectorAll('.voice-profile-item').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-profile-id');
        if (id) {
          applyVoiceProfile(id);
        } else {
          localStorage.removeItem(ACTIVE_VOICE_PROFILE_KEY);
          if (voiceProviderSelect) voiceProviderSelect.value = 'browser';
          localStorage.setItem('aetheria_voice_provider', 'browser');
          syncVoiceUiPanels();
          renderVoiceProfileMenu();
          showNotification('✓ Switched to Device Voice profile');
        }
        closeVoiceProfileMenu();
      });
    });
  }

  function applyVoiceProfile(id) {
    const profiles = getSavedVoiceProfiles();
    const prof = profiles.find(p => p.id === id);
    if (!prof) return;

    localStorage.setItem(ACTIVE_VOICE_PROFILE_KEY, prof.id);
    if (voiceProviderSelect) voiceProviderSelect.value = prof.provider;
    localStorage.setItem('aetheria_voice_provider', prof.provider);

    if (prof.apiKey) {
      setVoiceKeyForProvider(prof.provider, prof.apiKey);
      if (voiceApiKey) voiceApiKey.value = prof.apiKey;
    }
    if (prof.voiceId) {
      if (voiceIdInput) voiceIdInput.value = prof.voiceId;
      localStorage.setItem('aetheria_voice_id', prof.voiceId);
      if (prof.provider === 'openai' && openaiVoiceSelect) {
        openaiVoiceSelect.value = prof.voiceId;
        localStorage.setItem('aetheria_openai_voice', prof.voiceId);
      } else if (prof.provider === 'google') {
        localStorage.setItem('aetheria_google_voice', prof.voiceId);
      }
    }
    if (prof.speed) {
      if (sliderVoiceRate) sliderVoiceRate.value = prof.speed;
      localStorage.setItem('aetheria_voice_rate', prof.speed.toString());
      updateSpeedPillsAndLabel(prof.speed);
    }
    if (prof.pitch) {
      if (sliderVoicePitch) sliderVoicePitch.value = prof.pitch;
      localStorage.setItem('aetheria_voice_pitch', prof.pitch.toString());
      updatePitchPillsAndLabel(prof.pitch);
    }
    if (prof.stability !== undefined) {
      if (sliderStability) sliderStability.value = prof.stability;
      localStorage.setItem('aetheria_voice_stability', prof.stability.toString());
      const badge = document.getElementById('badge-stability-val');
      if (badge) badge.textContent = Math.round(prof.stability * 100) + '%';
    }
    if (prof.clarity !== undefined) {
      if (sliderClarity) sliderClarity.value = prof.clarity;
      localStorage.setItem('aetheria_voice_clarity', prof.clarity.toString());
      const badge = document.getElementById('badge-clarity-val');
      if (badge) badge.textContent = Math.round(prof.clarity * 100) + '%';
    }
    if (prof.model && prof.provider === 'openai') {
      if (openaiTtsModelSelect) openaiTtsModelSelect.value = prof.model;
      localStorage.setItem('aetheria_openai_tts_model', prof.model);
    }

    syncVoiceUiPanels();
    renderVoiceProfileMenu();
    showNotification(`✓ Loaded voice profile: ${prof.name}`);
  }

  function saveCurrentAsVoiceProfile(name) {
    if (!name || !name.trim()) {
      showNotification('⚠️ Please enter a profile name', 'warning');
      return;
    }
    const prov = voiceProviderSelect?.value || localStorage.getItem('aetheria_voice_provider') || 'browser';
    const profiles = getSavedVoiceProfiles();
    const newProf = {
      id: 'vp_' + Date.now(),
      name: name.trim(),
      provider: prov,
      apiKey: getVoiceKeyForProvider(prov),
      voiceId: voiceIdInput?.value || localStorage.getItem('aetheria_voice_id') || '21m00Tcm4TlvDq8ikWAM',
      voiceName: getSelectedVoiceDisplayName(),
      speed: parseFloat(sliderVoiceRate?.value || '1.0'),
      pitch: parseFloat(sliderVoicePitch?.value || '1.0'),
      stability: parseFloat(sliderStability?.value || '0.5'),
      clarity: parseFloat(sliderClarity?.value || '0.75'),
      model: prov === 'openai' ? (openaiTtsModelSelect?.value || 'tts-1') : 'eleven_multilingual_v2',
      updatedAt: Date.now()
    };
    profiles.push(newProf);
    saveVoiceProfiles(profiles);
    localStorage.setItem(ACTIVE_VOICE_PROFILE_KEY, newProf.id);
    renderVoiceProfileMenu();
    if (newVoiceProfileForm) newVoiceProfileForm.classList.add('hidden');
    if (newVoiceProfileNameInput) newVoiceProfileNameInput.value = '';
    showNotification(`✓ Voice profile "${newProf.name}" saved!`);
  }

  function updateActiveVoiceProfile() {
    const activeId = localStorage.getItem(ACTIVE_VOICE_PROFILE_KEY);
    if (!activeId) return;
    const profiles = getSavedVoiceProfiles();
    const idx = profiles.findIndex(p => p.id === activeId);
    if (idx === -1) return;

    const prov = voiceProviderSelect?.value || localStorage.getItem('aetheria_voice_provider') || 'browser';
    profiles[idx] = {
      ...profiles[idx],
      provider: prov,
      apiKey: getVoiceKeyForProvider(prov),
      voiceId: voiceIdInput?.value || localStorage.getItem('aetheria_voice_id') || '21m00Tcm4TlvDq8ikWAM',
      voiceName: getSelectedVoiceDisplayName(),
      speed: parseFloat(sliderVoiceRate?.value || '1.0'),
      pitch: parseFloat(sliderVoicePitch?.value || '1.0'),
      stability: parseFloat(sliderStability?.value || '0.5'),
      clarity: parseFloat(sliderClarity?.value || '0.75'),
      model: prov === 'openai' ? (openaiTtsModelSelect?.value || 'tts-1') : 'eleven_multilingual_v2',
      updatedAt: Date.now()
    };
    saveVoiceProfiles(profiles);
    renderVoiceProfileMenu();
    showNotification(`✓ Updated profile "${profiles[idx].name}"!`);
  }

  async function deleteActiveVoiceProfile() {
    const activeId = localStorage.getItem(ACTIVE_VOICE_PROFILE_KEY);
    if (!activeId) return;
    const profiles = getSavedVoiceProfiles();
    const prof = profiles.find(p => p.id === activeId);
    if (!prof) return;

    const confirmed = await showConfirmModal({
      title: 'Delete Voice Profile?',
      message: `Are you sure you want to delete "${prof.name}"?`,
      confirmText: 'Delete',
      cancelText: 'Cancel',
      type: 'danger'
    });
    if (confirmed) {
      const remaining = profiles.filter(p => p.id !== activeId);
      saveVoiceProfiles(remaining);
      localStorage.removeItem(ACTIVE_VOICE_PROFILE_KEY);
      renderVoiceProfileMenu();
      showNotification(`✓ Profile "${prof.name}" deleted.`);
    }
  }

  function openVoiceProfileMenu() {
    if (!customVoiceProfileMenu) return;
    customVoiceProfileMenu.classList.remove('hidden');
    if (customVoiceProfileChevron) customVoiceProfileChevron.classList.add('rotate-180');
  }

  function closeVoiceProfileMenu() {
    if (!customVoiceProfileMenu) return;
    customVoiceProfileMenu.classList.add('hidden');
    if (customVoiceProfileChevron) customVoiceProfileChevron.classList.remove('rotate-180');
  }

  customVoiceProfileTrigger?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (customVoiceProfileMenu?.classList.contains('hidden')) {
      openVoiceProfileMenu();
    } else {
      closeVoiceProfileMenu();
    }
  });

  document.addEventListener('click', (e) => {
    if (customVoiceProfileMenu && !customVoiceProfileMenu.contains(e.target) && !customVoiceProfileTrigger?.contains(e.target)) {
      closeVoiceProfileMenu();
    }
    if (customSttProfileMenu && !customSttProfileMenu.contains(e.target) && !customSttProfileTrigger?.contains(e.target)) {
      closeSttProfileMenu();
    }
    if (customImageProfileMenu && !customImageProfileMenu.contains(e.target) && !customImageProfileTrigger?.contains(e.target)) {
      closeImageProfileMenu();
    }
    if (customVisionProfileMenu && !customVisionProfileMenu.contains(e.target) && !customVisionProfileTrigger?.contains(e.target)) {
      closeVisionProfileMenu();
    }
    if (customVideoProfileMenu && !customVideoProfileMenu.contains(e.target) && !customVideoProfileTrigger?.contains(e.target)) {
      closeVideoProfileMenu();
    }
  });

  btnShowSaveVoiceProfile?.addEventListener('click', () => {
    if (newVoiceProfileForm) {
      newVoiceProfileForm.classList.remove('hidden');
      if (newVoiceProfileNameInput) {
        newVoiceProfileNameInput.value = '';
        newVoiceProfileNameInput.focus();
      }
    }
  });

  btnCancelNewVoiceProfile?.addEventListener('click', () => {
    if (newVoiceProfileForm) newVoiceProfileForm.classList.add('hidden');
  });

  btnConfirmSaveVoiceProfile?.addEventListener('click', () => {
    saveCurrentAsVoiceProfile(newVoiceProfileNameInput?.value || '');
  });

  newVoiceProfileNameInput?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      saveCurrentAsVoiceProfile(newVoiceProfileNameInput.value);
    }
  });

  btnUpdateActiveVoiceProfile?.addEventListener('click', updateActiveVoiceProfile);
  btnDeleteActiveVoiceProfile?.addEventListener('click', deleteActiveVoiceProfile);

  // ==========================================
  // 1. MICROPHONE (STT) PROFILES MANAGEMENT
  // ==========================================
  const STT_PROFILES_STORAGE_KEY = 'aetheria_stt_profiles';
  const ACTIVE_STT_PROFILE_KEY = 'aetheria_active_stt_profile_id';

  function getSavedSttProfiles() {
    try {
      const raw = localStorage.getItem(STT_PROFILES_STORAGE_KEY);
      return raw ? JSON.parse(raw) : [];
    } catch (e) {
      return [];
    }
  }

  function saveSttProfiles(profiles) {
    try {
      localStorage.setItem(STT_PROFILES_STORAGE_KEY, JSON.stringify(profiles));
    } catch (e) {
      console.error(e);
    }
  }

  function renderSttProfileMenu() {
