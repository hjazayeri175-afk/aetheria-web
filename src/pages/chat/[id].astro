  // ==========================================
  // LUXURY MODEL SELECTOR & SEARCH STATE
  // ==========================================
  const customModelTriggerContainer = document.getElementById('custom-model-trigger-container');
  const customModelTriggerBtn = document.getElementById('custom-model-trigger-btn');
  const triggerModelBadge = document.getElementById('trigger-model-badge');
  const triggerModelTitle = document.getElementById('trigger-model-title');
  const triggerModelSubtitle = document.getElementById('trigger-model-subtitle');

  const modelSearchModal = document.getElementById('model-search-modal');
  const closeModelSearchModalBtn = document.getElementById('close-model-search-modal-btn');
  const modelSearchInput = document.getElementById('model-search-input');
  const clearModelSearchBtn = document.getElementById('clear-model-search-btn');
  const modelsListItems = document.getElementById('models-list-items');
  const modelsListEmpty = document.getElementById('models-list-empty');
  const modalModelsCountBadge = document.getElementById('modal-models-count-badge');
  const activeSelectedModelText = document.getElementById('active-selected-model-text');
  const manualInputFromModalBtn = document.getElementById('manual-input-from-modal-btn');
  const modelCatChips = document.querySelectorAll('.model-cat-chip');

  let currentSyncedModels = [];
  let activeModelCategory = 'all';
  let activeModelSearchQuery = '';

  function getModelMeta(id) {
    if (!id) return { id: '', brand: 'AI', badgeClass: 'bg-purple-500/20 text-purple-300 border-purple-500/30', cleanName: 'No Model Selected', isFree: false };
    const lower = id.toLowerCase();
    let brand = 'AI';
    let badgeClass = 'bg-purple-500/20 text-purple-300 border-purple-500/30';
    const isFree = lower.includes(':free');

    if (lower.includes('deepseek')) {
      brand = 'DeepSeek';
      badgeClass = 'bg-cyan-500/20 text-cyan-300 border-cyan-500/30';
    } else if (lower.includes('anthropic') || lower.includes('claude')) {
      brand = 'Claude';
      badgeClass = 'bg-amber-500/20 text-amber-300 border-amber-500/30';
    } else if (lower.includes('meta') || lower.includes('llama')) {
      brand = 'Llama';
      badgeClass = 'bg-blue-500/20 text-blue-300 border-blue-500/30';
    } else if (lower.includes('google') || lower.includes('gemini')) {
      brand = 'Gemini';
      badgeClass = 'bg-emerald-500/20 text-emerald-300 border-emerald-500/30';
    } else if (lower.includes('mistral')) {
      brand = 'Mistral';
      badgeClass = 'bg-orange-500/20 text-orange-300 border-orange-500/30';
    } else if (lower.includes('nous') || lower.includes('hermes')) {
      brand = 'Hermes';
      badgeClass = 'bg-fuchsia-500/20 text-fuchsia-300 border-fuchsia-500/30';
    } else if (lower.includes('openai') || lower.includes('gpt')) {
      brand = 'OpenAI';
      badgeClass = 'bg-emerald-500/20 text-emerald-300 border-emerald-500/30';
    } else if (id.includes('/')) {
      brand = id.split('/')[0].toUpperCase();
      badgeClass = 'bg-slate-500/20 text-slate-300 border-slate-500/30';
    }

    let cleanName = id.includes('/') ? id.split('/').slice(1).join('/') : id;
    if (cleanName.endsWith(':free')) cleanName = cleanName.replace(':free', '');

    return { id, brand, badgeClass, cleanName, isFree };
  }

  function updateCustomModelTrigger(mId) {
    if (!triggerModelTitle || !triggerModelSubtitle || !triggerModelBadge) return;
    if (!mId || mId.includes('No API connected')) {
      triggerModelTitle.textContent = 'Select AI Model';
      triggerModelSubtitle.textContent = 'Tap to search & choose from live models';
      triggerModelBadge.textContent = 'AI';
      triggerModelBadge.className = 'px-2 py-0.5 rounded-md text-[10px] font-bold tracking-wide uppercase bg-purple-500/20 text-purple-300 border border-purple-500/30 shrink-0';
      if (activeSelectedModelText) activeSelectedModelText.textContent = 'No model selected';
      return;
    }

    const meta = getModelMeta(mId);
    triggerModelTitle.textContent = meta.cleanName;
    triggerModelSubtitle.textContent = meta.id;
    triggerModelBadge.textContent = meta.brand;
    triggerModelBadge.className = `px-2 py-0.5 rounded-md text-[10px] font-bold tracking-wide uppercase border shrink-0 ${meta.badgeClass}`;
    if (activeSelectedModelText) activeSelectedModelText.textContent = meta.id;
  }

  function filterModelsList() {
    if (!currentSyncedModels || currentSyncedModels.length === 0) return [];
    const q = (activeModelSearchQuery || '').toLowerCase().trim();
    const cat = activeModelCategory || 'all';

    const topRoleplayKeywords = [
      'deepseek/deepseek-chat', 'deepseek/deepseek-r1', 'claude-3.5-sonnet', 'claude-3.7-sonnet',
      'llama-3.3-70b', 'lumimaid', 'gemini-2.0-flash', 'hermes-3', 'mistral-large', 'mythomax'
    ];

    return currentSyncedModels.filter(m => {
      const lower = m.toLowerCase();

      // Category filter
      if (cat === 'roleplay') {
        const isRp = topRoleplayKeywords.some(rp => lower.includes(rp));
        if (!isRp) return false;
      } else if (cat === 'deepseek') {
        if (!lower.includes('deepseek')) return false;
      } else if (cat === 'anthropic') {
        if (!lower.includes('anthropic') && !lower.includes('claude')) return false;
      } else if (cat === 'meta') {
        if (!lower.includes('meta') && !lower.includes('llama')) return false;
      } else if (cat === 'google') {
        if (!lower.includes('google') && !lower.includes('gemini')) return false;
      } else if (cat === 'mistral') {
        if (!lower.includes('mistral')) return false;
      } else if (cat === 'free') {
        if (!lower.includes(':free')) return false;
      }

      // Search keyword
      if (q) {
        return lower.includes(q);
      }
      return true;
    });
  }

  function renderModelSearchResults() {
    if (!modelsListItems) return;
    const filtered = filterModelsList();
    const currentSelected = textModelSelect?.value || localStorage.getItem('aetheria_text_model') || '';

    if (modalModelsCountBadge) {
      modalModelsCountBadge.textContent = `${filtered.length} of ${currentSyncedModels.length} Models`;
    }

    if (filtered.length === 0) {
      modelsListItems.innerHTML = '';
      if (modelsListEmpty) modelsListEmpty.classList.remove('hidden');
      return;
    }

    if (modelsListEmpty) modelsListEmpty.classList.add('hidden');

    const renderChunk = filtered.slice(0, 100);

    let html = '';
    renderChunk.forEach(mId => {
      const meta = getModelMeta(mId);
      const isSelected = mId === currentSelected;

      html += `
        <button
          type="button"
          data-model-id="${mId}"
          class="model-select-card w-full flex items-center justify-between p-3 rounded-2xl border transition-all cursor-pointer text-left group ${
            isSelected 
              ? 'bg-purple-900/35 border-purple-500/60 shadow-lg shadow-purple-950/60' 
              : 'bg-white/[0.02] hover:bg-white/[0.06] border-white/[0.06] hover:border-purple-500/30'
          }"
        >
          <div class="flex items-center gap-3 min-w-0 pr-2">
            <span class="px-2 py-1 rounded-md text-[10px] font-bold tracking-wider uppercase border shrink-0 ${meta.badgeClass}">
              ${meta.brand}
            </span>
            <div class="min-w-0 flex flex-col">
              <div class="flex items-center gap-1.5 flex-wrap">
                <span class="text-xs sm:text-sm font-semibold text-white truncate">${meta.cleanName}</span>
                ${meta.isFree ? '<span class="px-1.5 py-0.2 rounded text-[9px] font-bold bg-green-500/20 text-green-300 border border-green-500/30">FREE</span>' : ''}
              </div>
              <span class="text-[10px] text-slate-400 font-mono truncate">${meta.id}</span>
            </div>
          </div>
          <div class="shrink-0 pl-1">
            ${isSelected 
              ? '<div class="w-6 h-6 rounded-full bg-purple-600 flex items-center justify-center text-white shadow"><svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/></svg></div>'
              : '<div class="w-6 h-6 rounded-full border border-white/10 group-hover:border-purple-400/50 flex items-center justify-center text-slate-400 group-hover:text-purple-300 text-xs transition">→</div>'
            }
          </div>
        </button>
      `;
    });

    modelsListItems.innerHTML = html;

    modelsListItems.querySelectorAll('.model-select-card').forEach(card => {
      card.addEventListener('click', () => {
        const mId = card.getAttribute('data-model-id');
        if (mId) {
          selectModel(mId);
        }
      });
    });
  }

  function selectModel(mId) {
    if (!mId) return;
    if (textModelSelect) {
      textModelSelect.disabled = false;
      textModelSelect.value = mId;
      if (textModelSelect.value !== mId) {
        const opt = document.createElement('option');
        opt.value = mId;
        opt.textContent = mId;
        opt.selected = true;
        textModelSelect.prepend(opt);
      }
    }
    if (textModelInput) textModelInput.value = mId;
    localStorage.setItem('aetheria_text_model', mId);
    updateCustomModelTrigger(mId);
    updateHeaderPill();
    closeModelSearchModal();
    showNotification(`Active Model: ${mId}`);
  }

  function openModelSearchModal() {
    if (!modelSearchModal) return;
    const prov = textProviderSelect?.value || localStorage.getItem('aetheria_text_provider') || 'groq';

    if (!currentSyncedModels || currentSyncedModels.length === 0) {
      const cached = localStorage.getItem('aetheria_synced_models_' + prov);
      if (cached) {
        try {
          currentSyncedModels = JSON.parse(cached);
        } catch (e) {}
      }
    }

    activeModelCategory = 'all';
    activeModelSearchQuery = '';
    if (modelSearchInput) modelSearchInput.value = '';
    if (clearModelSearchBtn) clearModelSearchBtn.classList.add('hidden');

    modelCatChips.forEach(chip => {
      const filter = chip.getAttribute('data-filter');
      if (filter === 'all') {
        chip.className = 'model-cat-chip px-2.5 py-1 rounded-lg bg-purple-600 text-white font-medium shrink-0 transition cursor-pointer';
      } else {
        chip.className = 'model-cat-chip px-2.5 py-1 rounded-lg bg-white/[0.05] hover:bg-white/[0.1] text-slate-300 font-medium shrink-0 transition cursor-pointer';
      }
    });

    renderModelSearchResults();
    modelSearchModal.classList.remove('hidden');
    modelSearchModal.classList.add('flex');
    setTimeout(() => modelSearchInput?.focus(), 100);
  }

  function closeModelSearchModal() {
    if (!modelSearchModal) return;
    modelSearchModal.classList.add('hidden');
    modelSearchModal.classList.remove('flex');
  }

  // Setup event listeners for custom model selector
  customModelTriggerBtn?.addEventListener('click', openModelSearchModal);
  closeModelSearchModalBtn?.addEventListener('click', closeModelSearchModal);

  modelSearchModal?.addEventListener('click', (e) => {
    if (e.target === modelSearchModal) {
      closeModelSearchModal();
    }
  });

  modelSearchInput?.addEventListener('input', (e) => {
    activeModelSearchQuery = e.target.value;
    if (clearModelSearchBtn) {
      clearModelSearchBtn.classList.toggle('hidden', !activeModelSearchQuery);
    }
    renderModelSearchResults();
  });

  clearModelSearchBtn?.addEventListener('click', () => {
    if (modelSearchInput) {
      modelSearchInput.value = '';
      activeModelSearchQuery = '';
      clearModelSearchBtn.classList.add('hidden');
      renderModelSearchResults();
      modelSearchInput.focus();
    }
  });

  modelCatChips.forEach(chip => {
    chip.addEventListener('click', () => {
      const filter = chip.getAttribute('data-filter') || 'all';
      activeModelCategory = filter;

      modelCatChips.forEach(c => {
        if (c === chip) {
          c.className = 'model-cat-chip px-2.5 py-1 rounded-lg bg-purple-600 text-white font-medium shrink-0 transition cursor-pointer';
        } else {
          c.className = 'model-cat-chip px-2.5 py-1 rounded-lg bg-white/[0.05] hover:bg-white/[0.1] text-slate-300 font-medium shrink-0 transition cursor-pointer';
        }
      });

      renderModelSearchResults();
    });
  });

  manualInputFromModalBtn?.addEventListener('click', () => {
    closeModelSearchModal();
    if (toggleModelInputModeBtn) {
      toggleModelInputModeBtn.click();
    }
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modelSearchModal && !modelSearchModal.classList.contains('hidden')) {
      closeModelSearchModal();
    }
  });

  // Helper: Set empty state for model dropdown when not connected
  function setEmptyModelDropdown() {
    currentSyncedModels = [];
    if (!textModelSelect) return;
    textModelSelect.innerHTML = '<option value="" disabled selected>No API connected — Enter API key &amp; fetch models</option>';
    textModelSelect.disabled = true;
    if (textModelInput) textModelInput.value = '';
    updateCustomModelTrigger('');
    if (modelCountBadge) modelCountBadge.textContent = 'Not connected';
    if (dynamicPresetsContainer) {
      dynamicPresetsContainer.innerHTML = '<span class="text-[10px] text-slate-500 italic">No models loaded. Connect API key to sync.</span>';
    }
  }

  // Populate dynamic model select dropdown
  function populateModelDropdown(models, selected) {
    if (!textModelSelect) return;
    const unique = Array.from(new Set(models || [])).filter(Boolean);
    currentSyncedModels = unique;

    if (unique.length === 0) {
      setEmptyModelDropdown();
      return;
    }
    textModelSelect.disabled = false;
    textModelSelect.innerHTML = '';
    unique.forEach(m => {
      const opt = document.createElement('option');
      opt.value = m;
      opt.textContent = m;
      if (m === selected) opt.selected = true;
      textModelSelect.appendChild(opt);
    });
    if (selected && !unique.includes(selected)) {
      const opt = document.createElement('option');
      opt.value = selected;
      opt.textContent = selected;
      opt.selected = true;
      textModelSelect.prepend(opt);
    }
    const finalSelected = selected || unique[0];
    if (textModelInput) {
      textModelInput.value = finalSelected;
    }
    updateCustomModelTrigger(finalSelected);
    if (modelCountBadge) {
      modelCountBadge.textContent = `${unique.length} Models Synced`;
    }
  }

  // Update quick clickable preset pills
  function updateDynamicPresets(models) {
    if (!dynamicPresetsContainer) return;
    dynamicPresetsContainer.innerHTML = '';
    const wrapper = document.getElementById('dynamic-presets-wrapper');
    const valid = (models || []).filter(Boolean);
    if (valid.length === 0) {
      if (wrapper) wrapper.classList.add('hidden');
      return;
    }
    if (wrapper) wrapper.classList.remove('hidden');
    const slice = valid.slice(0, 6);
    slice.forEach(m => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'quick-model-pill text-[10px] px-2 py-0.5 rounded-lg bg-white/[0.04] hover:bg-purple-950 text-slate-300 hover:text-purple-300 border border-white/10 transition cursor-pointer';
      const shortName = m.split('/').pop() || m;
      btn.textContent = shortName;
      btn.title = m;
      btn.setAttribute('data-model', m);
      btn.addEventListener('click', () => {
        if (textModelSelect) {
          textModelSelect.value = m;
          if (textModelSelect.value !== m) {
            const opt = document.createElement('option');
            opt.value = m;
            opt.textContent = m;
            opt.selected = true;
            textModelSelect.prepend(opt);
          }
        }
        if (textModelInput) textModelInput.value = m;
        localStorage.setItem('aetheria_text_model', m);
        updateCustomModelTrigger(m);
        updateHeaderPill();
      });
      dynamicPresetsContainer.appendChild(btn);
    });
  }

  // Extract model IDs from diverse provider responses (Zero hardcoding, live API only)
  function extractModelIds(data, provider) {
    if (!data) return [];
    let list = [];
    if (data.models && Array.isArray(data.models)) {
      list = data.models
        .filter(m => !m.supportedGenerationMethods || m.supportedGenerationMethods.includes('generateContent'))
        .map(m => (m.name || '').replace(/^models\//, ''))
        .filter(Boolean);
    } else if (data.data && Array.isArray(data.data)) {
      list = data.data.map(m => m.id || m.name).filter(Boolean);
    } else if (Array.isArray(data)) {
      list = data.map(m => (typeof m === 'string' ? m : (m.id || m.name))).filter(Boolean);
    }

    // Filter out non-chat / auxiliary models (embeddings, tts, whisper, audio, moderation, dall-e, imagen)
    list = list.filter(id => {
      const lower = id.toLowerCase();
      return !lower.includes('embed') && 
             !lower.includes('whisper') && 
             !lower.includes('tts') && 
             !lower.includes('moderation') && 
             !lower.includes('dall-e') && 
             !lower.includes('imagen') &&
             !lower.includes('aqa');
    });

    // Natural sort descending so newest versions (e.g. 3.8, 3.7, 2.5) appear at top
    list.sort((a, b) => b.localeCompare(a, undefined, { numeric: true, sensitivity: 'base' }));

    // For OpenRouter: prioritize top-tier roleplay models
    if (provider === 'openrouter') {
      const topPicks = [
        'deepseek/deepseek-chat',
        'deepseek/deepseek-r1',
        'anthropic/claude-3.5-sonnet',
        'anthropic/claude-3.7-sonnet',
        'meta-llama/llama-3.3-70b-instruct',
        'google/gemini-2.0-flash-001',
        'google/gemini-flash-1.5',
        'neversleep/llama-3-lumimaid-70b',
        'nousresearch/hermes-3-llama-3.1-405b',
        'mistralai/mistral-large-2407'
      ];
      const featured = [];
      const others = [];
      list.forEach(id => {
        const found = topPicks.find(p => id.toLowerCase() === p.toLowerCase() || id.toLowerCase().startsWith(p.toLowerCase()));
        if (found) featured.push(id);
        else others.push(id);
      });
      list = [...new Set([...featured, ...others])];
    }

    return list;
  }

  // Fetch live model list from provider endpoint (Zero guessing, API-driven)
  async function fetchModelsForProvider(provArg, keyArg, baseUrlArg) {
    const isEvent = provArg && typeof provArg === 'object' && provArg.preventDefault;
    if (isEvent) provArg.preventDefault();
    const prov = (typeof provArg === 'string' ? provArg : (textProviderSelect?.value || 'groq'));
    const conf = PROVIDER_CONFIGS[prov] || PROVIDER_CONFIGS.demo;
    const key = (typeof keyArg === 'string' ? keyArg : (textApiKey?.value.trim() || localStorage.getItem('aetheria_text_key') || ''));
    const baseUrl = (typeof baseUrlArg === 'string' ? baseUrlArg : (textBaseUrl?.value.trim() || conf.defaultUrl || ''));

    if (prov === 'demo') {
      populateModelDropdown(['Free Cloud AI'], 'Free Cloud AI');
      updateDynamicPresets(['Free Cloud AI']);
      localStorage.setItem('aetheria_text_model', 'Free Cloud AI');
      showNotification('✓ Using Free Cloud AI (Instant)');
      return ['Free Cloud AI'];
    }

    if (conf.hasKey && !conf.isKeyOptional && !key) {
      showNotification('⚠️ Please enter an API key first before fetching models.');
      textApiKey?.focus();
      return [];
    }

    if (fetchModelsIcon) fetchModelsIcon.classList.add('animate-spin');
    if (fetchModelsText) fetchModelsText.textContent = 'Fetching...';
    if (fetchModelsBtn) fetchModelsBtn.disabled = true;

    let models = [];
    try {
      let endpoint = conf.modelsEndpoint;
      if (conf.hasUrl) {
        endpoint = `${baseUrl.replace(/\/+$/, '')}/models`;
      } else if (prov === 'google') {
        endpoint = `https://generativelanguage.googleapis.com/v1beta/models?key=${key}`;
      } else if (prov === 'anthropic') {
        endpoint = 'https://api.anthropic.com/v1/models';
      }

      let responseData = null;
      let isSuccess = false;

      // 1. Direct browser fetch attempt
      try {
        const headers = {};
        if (key && prov !== 'google') {
          if (prov === 'anthropic') {
            headers['x-api-key'] = key;
            headers['anthropic-version'] = '2023-06-01';
            headers['anthropic-dangerous-direct-browser-access'] = 'true';
          } else {
            headers['Authorization'] = `Bearer ${key}`;
          }
        } else if (key && prov === 'google') {
          headers['x-goog-api-key'] = key;
        }
        if (prov === 'openrouter') {
          headers['HTTP-Referer'] = 'https://aetheria.ai';
          headers['X-Title'] = 'Aetheria AI';
        }

        const res = await fetch(endpoint, { method: 'GET', headers });
        if (res.ok) {
          responseData = await res.json();
          isSuccess = true;
        }
      } catch (directErr) {
        // Direct fetch failed (CORS or network), fallback to edge proxy
      }

      // 2. Serverless proxy fallback
      if (!isSuccess) {
        try {
          const proxyRes = await fetch('/api/proxy/fetch-models', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              endpoint,
              apiKey: key,
              headers: prov === 'openrouter' ? { 'HTTP-Referer': 'https://aetheria.ai', 'X-Title': 'Aetheria AI' } : {}
            })
          });
          if (proxyRes.ok) {
            const pJson = await proxyRes.json();
            responseData = pJson.data || pJson;
            isSuccess = true;
          }
        } catch (proxyErr) {
          console.error('Edge proxy fetch failed:', proxyErr);
        }
      }

      if (isSuccess && responseData) {
        models = extractModelIds(responseData, prov);
        if (models && models.length > 0) {
          localStorage.setItem('aetheria_synced_models_' + prov, JSON.stringify(models));
          populateModelDropdown(models, models[0]);
          updateDynamicPresets(models);
          localStorage.setItem('aetheria_text_model', models[0]);
          updateHeaderPill();
          showNotification(`✓ Successfully loaded ${models.length} live models from ${conf.name} API!`);
        } else {
          setEmptyModelDropdown();
          showNotification(`⚠️ Connected to ${conf.name}, but no text generation models were returned.`);
        }
      } else {
        setEmptyModelDropdown();
        showNotification(`⚠️ Could not authenticate with ${conf.name}. Please check your API key.`);
      }
    } catch (err) {
      setEmptyModelDropdown();
      showNotification('⚠️ Connection error while fetching models from API.');
    } finally {
      if (fetchModelsIcon) fetchModelsIcon.classList.remove('animate-spin');
      if (fetchModelsText) fetchModelsText.textContent = 'Fetch Models';
      if (fetchModelsBtn) fetchModelsBtn.disabled = false;
    }
    return models;
  }

  // Health-check / ping connection
  async function pingTextConnection() {
    if (!pingStatusMsg) return;
    const t0 = performance.now();
    const prov = textProviderSelect?.value || 'groq';
    const conf = PROVIDER_CONFIGS[prov] || PROVIDER_CONFIGS.demo;
    const key = textApiKey?.value.trim() || localStorage.getItem('aetheria_text_key') || '';
    const baseUrl = textBaseUrl?.value.trim() || conf.defaultUrl || '';

    if (prov === 'demo') {
      await new Promise(r => setTimeout(r, 85));
      const dt = Math.round(performance.now() - t0);
      pingStatusMsg.className = 'text-xs px-3.5 py-2.5 rounded-xl border bg-emerald-950/40 border-emerald-500/30 text-emerald-300';
      pingStatusMsg.innerHTML = `✓ Free Cloud AI Ready • Latency: ${dt}ms • Model: Instant Cloud Engine`;
      if (pingLatencyText) pingLatencyText.textContent = `Online • Latency: ${dt}ms`;
      if (pingIndicatorDot) pingIndicatorDot.className = 'w-2.5 h-2.5 rounded-full bg-emerald-400 shrink-0';
      return;
    }

    if (conf.hasKey && !conf.isKeyOptional && !key) {
      pingStatusMsg.className = 'text-xs px-3.5 py-2.5 rounded-xl border bg-amber-950/40 border-amber-500/30 text-amber-300';
      pingStatusMsg.textContent = '⚠️ Please enter an API key to test latency.';
      return;
    }

    pingStatusMsg.className = 'text-xs px-3.5 py-2.5 rounded-xl border bg-slate-900/60 border-slate-700/60 text-slate-300 flex items-center gap-2';
    pingStatusMsg.innerHTML = '<svg class="w-3.5 h-3.5 animate-spin" viewBox="0 0 24 24" fill="none" stroke="currentColor"><circle cx="12" cy="12" r="10" stroke-width="3" stroke-dasharray="32" stroke-linecap="round"/></svg> Testing latency to ' + conf.name + '...';

    try {
      let endpoint = conf.modelsEndpoint;
      if (conf.hasUrl) {
        endpoint = `${baseUrl.replace(/\/+$/, '')}/models`;
      } else if (prov === 'google') {
        endpoint = `https://generativelanguage.googleapis.com/v1beta/models?key=${key}`;
      } else if (prov === 'anthropic') {
        endpoint = 'https://api.anthropic.com/v1/models';
      }

      let resOk = false;
      let resStatus = 0;

      try {
        const headers = {};
        if (key && prov !== 'google') {
          if (prov === 'anthropic') {
            headers['x-api-key'] = key;
            headers['anthropic-version'] = '2023-06-01';
            headers['anthropic-dangerous-direct-browser-access'] = 'true';
          } else {
            headers['Authorization'] = `Bearer ${key}`;
          }
        } else if (key && prov === 'google') {
          headers['x-goog-api-key'] = key;
        }

        const res = await fetch(endpoint, { method: 'GET', headers });
        resOk = res.ok;
        resStatus = res.status;
      } catch (err) {
        // Fallback to proxy
        const pRes = await fetch('/api/proxy/fetch-models', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ endpoint, apiKey: key })
        });
        resOk = pRes.ok;
        resStatus = pRes.status;
      }

      const dt = Math.round(performance.now() - t0);
      if (resOk) {
        pingStatusMsg.className = 'text-xs px-3.5 py-2.5 rounded-xl border bg-emerald-950/40 border-emerald-500/30 text-emerald-300';
        pingStatusMsg.innerHTML = `✓ Connection Successful • Latency: ${dt}ms • ${conf.name} API Online`;
        if (pingLatencyText) pingLatencyText.textContent = `Online • Latency: ${dt}ms`;
        if (pingIndicatorDot) pingIndicatorDot.className = 'w-2.5 h-2.5 rounded-full bg-emerald-400 shrink-0';

        // Always sync and populate live models on successful test connection
        await fetchModelsForProvider(prov, key, baseUrl);
      } else {
        pingStatusMsg.className = 'text-xs px-3.5 py-2.5 rounded-xl border bg-rose-950/40 border-rose-500/30 text-rose-300';
        pingStatusMsg.innerHTML = `✕ Connection Failed (HTTP ${resStatus || 'Network Error'}) • Check API key or endpoint`;
        if (pingLatencyText) pingLatencyText.textContent = `Offline • HTTP ${resStatus || 'ERR'}`;
        if (pingIndicatorDot) pingIndicatorDot.className = 'w-2.5 h-2.5 rounded-full bg-rose-500 shrink-0';
      }
    } catch (e) {
      pingStatusMsg.className = 'text-xs px-3.5 py-2.5 rounded-xl border bg-rose-950/40 border-rose-500/30 text-rose-300';
      pingStatusMsg.innerHTML = `✕ Connection Error • Unable to reach API`;
    }
  }

  // Load all engine settings from localStorage
  function loadEngineSettings() {
    // 1. Text provider & Key
    const textProv = localStorage.getItem('aetheria_text_provider') || 'demo';
    if (textProviderSelect) textProviderSelect.value = textProv;
    updateQuickProvChips(textProv);

    const textKey = localStorage.getItem('aetheria_text_key') || '';
    if (textApiKey) textApiKey.value = textKey;

    const baseUrl = localStorage.getItem('aetheria_text_base_url') || '';
    if (textBaseUrl) textBaseUrl.value = baseUrl;

    // 2. Hyperparameters
    const temp = localStorage.getItem('aetheria_text_temp');
    if (temp && tempSlider) { tempSlider.value = temp; if (tempVal) tempVal.textContent = temp; }

    const tokens = localStorage.getItem('aetheria_text_tokens');
    if (tokens && tokensSlider) { tokensSlider.value = tokens; if (tokensVal) tokensVal.textContent = tokens; }

    const topP = localStorage.getItem('aetheria_text_top_p');
    if (topP && topPSlider) { topPSlider.value = topP; if (topPVal) topPVal.textContent = topP; }

    const repPen = localStorage.getItem('aetheria_text_rep_pen');
    if (repPen && repPenSlider) { repPenSlider.value = repPen; if (repPenVal) repPenVal.textContent = repPen; }

    const streaming = localStorage.getItem('aetheria_text_streaming');
    if (streaming && toggleStreaming) toggleStreaming.checked = streaming !== 'false';
    const thinkingVal = localStorage.getItem('aetheria_text_thinking');
    if (toggleThinking) toggleThinking.checked = thinkingVal === 'true'; // default off for snappy roleplay

    // 3. Voice settings
    const voiceProv = localStorage.getItem('aetheria_voice_provider') || 'browser';
    if (voiceProviderSelect) voiceProviderSelect.value = voiceProv;
    const voiceKey = localStorage.getItem('aetheria_voice_key') || '';
    if (voiceApiKey) voiceApiKey.value = voiceKey;

    // 4. Image settings
    const imgProv = localStorage.getItem('aetheria_image_provider') || 'pollinations';
    if (imageProviderSelect) imageProviderSelect.value = imgProv;
    const imgKey = localStorage.getItem('aetheria_image_key') || '';
    if (imageApiKey) imageApiKey.value = imgKey;

    // 5. Video settings
    const vidProv = localStorage.getItem('aetheria_video_provider') || 'kling';
    if (videoProviderSelect) videoProviderSelect.value = vidProv;

    // Sync Voice Autoplay state (Default: false / muted)
    ttsEnabled = localStorage.getItem('aetheria_voice_autoplay') === 'true';
    syncTtsUi();

    // 6. Sync UI and populate models
    syncProviderVisibility();
  }

  // Adapt submenus & input fields dynamically based on selected provider
  function syncProviderVisibility() {
    const prov = textProviderSelect?.value || 'groq';
    const conf = PROVIDER_CONFIGS[prov] || PROVIDER_CONFIGS.demo;

    // Free cloud notice
    if (freeCloudNotice) {
      freeCloudNotice.classList.toggle('hidden', prov !== 'demo');
    }

    // API Key container
    if (apiKeyContainer) {
      apiKeyContainer.classList.toggle('hidden', !conf.hasKey);
    }
    if (apiKeyLabel) {
      apiKeyLabel.textContent = conf.isKeyOptional ? `${conf.name} API Key (Optional)` : `${conf.name} API Key`;
    }
    if (textApiKey) {
      textApiKey.placeholder = conf.keyPlaceholder || 'sk-...';
    }
    if (getKeyLink && conf.keyLink) {
      getKeyLink.href = conf.keyLink;
      getKeyLink.classList.remove('hidden');
    } else if (getKeyLink) {
      getKeyLink.classList.add('hidden');
    }

    // Custom Base URL container
    if (customBaseUrlContainer) {
      customBaseUrlContainer.classList.toggle('hidden', !conf.hasUrl);
    }
    if (customBaseUrlLabel) {
      customBaseUrlLabel.textContent = conf.urlLabel || 'Base API URL';
    }
    if (textBaseUrl) {
      textBaseUrl.placeholder = conf.urlPlaceholder || 'https://api.example.com/v1';
    }
    if (customBaseUrlHint) {
      customBaseUrlHint.textContent = conf.urlHint || '';
    }

    // Model selection sync (Zero hardcoded fallback)
    if (prov === 'demo') {
      populateModelDropdown(['Free Cloud AI'], 'Free Cloud AI');
      localStorage.setItem('aetheria_text_model', 'Free Cloud AI');
    } else {
      const cachedModelsRaw = localStorage.getItem('aetheria_synced_models_' + prov);
      if (cachedModelsRaw) {
        try {
          const cachedModels = JSON.parse(cachedModelsRaw);
          if (Array.isArray(cachedModels) && cachedModels.length > 0) {
            const savedModel = localStorage.getItem('aetheria_text_model');
            const selectedModel = (savedModel && cachedModels.includes(savedModel)) ? savedModel : cachedModels[0];
            populateModelDropdown(cachedModels, selectedModel);
            localStorage.setItem('aetheria_text_model', selectedModel);
          } else {
            setEmptyModelDropdown();
          }
        } catch (e) {
          setEmptyModelDropdown();
        }
      } else {
        // NOT connected yet -> keep completely EMPTY!
        setEmptyModelDropdown();
      }
    }

    // Health Check widget update
    if (pingProviderName) {
      pingProviderName.textContent = conf.name;
    }
    if (pingLatencyText) {
      pingLatencyText.textContent = prov === 'demo' ? 'Online • Free Tier' : 'Configured • Ready to test';
    }

    // Voice & Image tabs
    if (voiceKeyContainer && voiceProviderSelect) {
      voiceKeyContainer.classList.toggle('hidden', voiceProviderSelect.value === 'browser');
    }
    if (elevenVoiceContainer && voiceProviderSelect) {
      elevenVoiceContainer.classList.toggle('hidden', voiceProviderSelect.value !== 'elevenlabs');
    }
    if (openaiVoiceContainer && voiceProviderSelect) {
      openaiVoiceContainer.classList.toggle('hidden', voiceProviderSelect.value !== 'openai');
    }
    if (imageKeyContainer && imageProviderSelect) {
      imageKeyContainer.classList.toggle('hidden', imageProviderSelect.value === 'pollinations');
    }
  }

