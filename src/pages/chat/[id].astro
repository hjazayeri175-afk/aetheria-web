                      <option value="fal-kling">Fal.ai (Kling 1.5 Pro — Realistic Motion)</option>
                      <option value="fal-luma">Fal.ai (Luma Dream Machine — Cinematic Camera)</option>
                      <option value="fal-minimax">Fal.ai (MiniMax Hailuo-01 — Lifelike Expressions)</option>
                      <option value="replicate">Replicate (Runway Gen-3)</option>
                      <option value="custom">Custom Video Endpoint</option>
                    </select>
                  </div>

                  <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1.5">Video API Key</label>
                    <input 
                      id="video-api-key" 
                      type="password" 
                      placeholder="fal_... or r8_..." 
                      class="w-full px-3.5 py-2.5 rounded-xl bg-white/[0.05] border border-white/10 text-xs text-white placeholder:text-slate-500 outline-none focus:border-cyan-500/60 font-mono"
                    />
                  </div>
                </div>

                <!-- Video Parameters -->
                <div class="p-4 rounded-2xl bg-white/[0.02] border border-white/[0.06] space-y-4">
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <!-- Motion Strength -->
                    <div class="space-y-1.5">
                      <div class="flex items-center justify-between text-xs">
                        <span class="text-slate-300 font-medium">Motion Intensity (1-100)</span>
                        <span id="badge-motion" class="text-cyan-300 font-mono font-bold text-xs bg-cyan-950/60 px-2 py-0.5 rounded-lg">50</span>
                      </div>
                      <input id="slider-motion" type="range" min="1" max="100" step="1" value="50" class="w-full accent-cyan-500 cursor-pointer" />
                      <div class="flex justify-between text-[10px] text-slate-500">
                        <span>Subtle Breathing (10)</span>
                        <span>Natural (50)</span>
                        <span>Dynamic Action (90)</span>
                      </div>
                    </div>

                    <!-- Camera Movement Preset -->
                    <div class="space-y-1.5">
                      <label class="block text-xs font-semibold text-slate-300">Camera Movement Preset</label>
                      <select id="video-camera-select" class="w-full px-3.5 py-2 rounded-xl bg-white/[0.05] border border-white/10 text-xs text-white outline-none">
                        <option value="subtle">Living Avatar (Gentle Breathing & Eye Blink)</option>
                        <option value="zoom-in">Slow Cinematic Push In</option>
                        <option value="pan-left">Dolly Pan Left</option>
                        <option value="pan-right">Dolly Pan Right</option>
                        <option value="orbit">Gentle Orbit Arc</option>
                      </select>
                    </div>

                    <!-- Duration -->
                    <div class="space-y-1.5">
                      <label class="block text-xs font-semibold text-slate-300">Video Duration</label>
                      <select id="video-duration-select" class="w-full px-3.5 py-2 rounded-xl bg-white/[0.05] border border-white/10 text-xs text-white outline-none">
                        <option value="5s">5 Seconds (Fast & Cost Efficient)</option>
                        <option value="10s">10 Seconds (Extended Cinematic Sequence)</option>
                      </select>
                    </div>

                    <!-- Resolution & FPS -->
                    <div class="space-y-1.5">
                      <label class="block text-xs font-semibold text-slate-300">Resolution & Frame Rate</label>
                      <select id="video-res-select" class="w-full px-3.5 py-2 rounded-xl bg-white/[0.05] border border-white/10 text-xs text-white outline-none">
                        <option value="720p-24fps">720p HD @ 24fps (Cinematic)</option>
                        <option value="1080p-30fps">1080p Full HD @ 30fps (Fluid)</option>
                      </select>
                    </div>
                  </div>
                </div>
              </div>

            </div>

            <!-- Modal Footer (Actions) -->
            <div class="p-4 sm:p-5 border-t border-white/[0.08] bg-[#090c1b] flex flex-col sm:flex-row items-center justify-between gap-3 shrink-0">
              <button 
                type="button" 
                id="reset-engine-defaults-btn"
                class="text-xs text-slate-400 hover:text-red-400 transition flex items-center gap-1 cursor-pointer"
              >
                <RotateCcw class="w-3.5 h-3.5" />
                <span>Reset to Optimal Defaults</span>
              </button>

              <div class="flex items-center gap-2 w-full sm:w-auto justify-end">
                <button 
                  type="button" 
                  id="cancel-engine-modal"
                  class="px-4 py-2 rounded-xl bg-white/[0.05] hover:bg-white/[0.1] text-slate-300 text-xs font-medium transition cursor-pointer"
                >
                  Cancel
                </button>
                <button 
                  type="button" 
                  id="save-engine-settings-btn"
                  class="px-5 py-2 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white text-xs font-bold shadow-lg shadow-purple-900/50 hover:shadow-purple-600/50 transition cursor-pointer active:scale-95 flex items-center gap-1.5"
                >
                  <Check class="w-4 h-4" />
                  <span>Save Engine Settings</span>
                </button>
              </div>
            </div>

          </div>
        </div>

        <!-- World Info & Lorebook Engine Modal (Part 4) -->
        <div 
          id="lorebook-modal" 
          class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-3 sm:p-6 transition-all duration-300"
        >
          <div class="w-full max-w-3xl max-h-[92vh] bg-[#0c0f22] border border-cyan-500/30 rounded-3xl shadow-2xl shadow-cyan-950/80 flex flex-col overflow-hidden animate-in fade-in zoom-in-95 duration-200">
            
            <!-- Modal Header -->
            <div class="p-4 sm:p-5 border-b border-white/[0.08] bg-[#090c1b] flex items-center justify-between shrink-0">
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-2xl bg-gradient-to-br from-cyan-600 to-indigo-600 flex items-center justify-center text-white shadow-lg shadow-cyan-900/50">
                  <BookOpen class="w-5 h-5" />
                </div>
                <div>
                  <h3 class="text-sm sm:text-base font-bold text-white flex items-center gap-2">
                    <span>World Info & Lorebook Engine</span>
                    <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">V2 Standard</span>
                  </h3>
                  <p class="text-[11px] text-slate-400">Manage contextual world knowledge, faction lore, and keyword triggers.</p>
                </div>
              </div>

              <button 
                type="button" 
                id="close-lorebook-modal"
                class="p-2 rounded-xl text-slate-400 hover:text-white hover:bg-white/[0.06] transition cursor-pointer"
              >
                ✕
              </button>
            </div>

            <!-- Modal Scope & Actions Bar -->
            <div class="px-5 py-3 bg-[#080b18] border-b border-white/[0.06] flex flex-wrap items-center justify-between gap-3 shrink-0">
              <div class="flex items-center gap-1.5 p-1 rounded-xl bg-white/[0.04] border border-white/[0.06]">
                <button 
                  type="button" 
                  id="scope-char-lore-btn"
                  class="px-3 py-1 rounded-lg text-xs font-semibold bg-cyan-600 text-white transition cursor-pointer"
                >
                  Character Lore
                </button>
                <button 
                  type="button" 
                  id="scope-global-lore-btn"
                  class="px-3 py-1 rounded-lg text-xs font-semibold text-slate-400 hover:text-white transition cursor-pointer"
                >
                  Global World Lore
                </button>
              </div>

              <div class="flex items-center gap-2">
                <button 
                  type="button" 
                  id="add-lore-entry-btn"
                  class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-cyan-500/20 hover:bg-cyan-500/30 border border-cyan-500/40 text-cyan-300 text-xs font-bold transition active:scale-95 cursor-pointer shadow-sm"
                >
                  <Plus class="w-3.5 h-3.5" />
                  <span>+ New Entry</span>
                </button>

                <button 
                  type="button" 
                  id="export-lorebook-btn"
                  class="p-1.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] text-slate-300 hover:text-white transition cursor-pointer"
                  title="Export Lorebook (JSON)"
                >
                  <Download class="w-4 h-4 text-slate-400" />
                </button>

                <label 
                  class="p-1.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] text-slate-300 hover:text-white transition cursor-pointer"
                  title="Import Lorebook (JSON / Tavern V2)"
                >
                  <Upload class="w-4 h-4 text-slate-400" />
                  <input id="import-lorebook-input" type="file" accept=".json" class="hidden" />
                </label>
              </div>
            </div>

            <!-- Modal Body (List & Form) -->
            <div class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-4">
              
              <!-- Inline Entry Editor Form (Hidden by default) -->
              <div id="lore-editor-form" class="hidden p-4 rounded-2xl bg-[#090d1f] border border-cyan-500/30 space-y-4 animate-in fade-in duration-200">
                <div class="flex items-center justify-between pb-2 border-b border-white/[0.06]">
                  <h4 id="lore-form-title" class="text-xs sm:text-sm font-bold text-white flex items-center gap-2">
                    <Tag class="w-4 h-4 text-cyan-400" />
                    <span>Create Lorebook Entry</span>
                  </h4>
                  <button type="button" id="cancel-lore-entry-btn" class="text-xs text-slate-400 hover:text-white">Cancel</button>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  <div>
                    <label class="block text-[11px] font-semibold text-slate-300 mb-1">Entry Name / Title</label>
                    <input 
                      id="lore-input-name" 
                      type="text" 
                      placeholder="Entry title"
                      class="w-full px-3 py-2 rounded-xl bg-white/[0.05] border border-white/10 text-xs text-white placeholder:text-slate-500 outline-none focus:border-cyan-500/50"
                    />
                  </div>

                  <div>
                    <label class="block text-[11px] font-semibold text-slate-300 mb-1">Primary Trigger Keys (comma-separated)</label>
                    <input 
                      id="lore-input-keys" 
                      type="text" 
                      placeholder="Keywords separated by commas"
                      class="w-full px-3 py-2 rounded-xl bg-white/[0.05] border border-white/10 text-xs text-white placeholder:text-slate-500 outline-none focus:border-cyan-500/50"
                    />
                  </div>
                </div>

                <div>
                  <label class="block text-[11px] font-semibold text-slate-300 mb-1">Selective / Secondary Keys (Optional)</label>
                  <input 
                    id="lore-input-second-keys" 
                    type="text" 
                    placeholder="Require at least one of these along with primary key"
                    class="w-full px-3 py-2 rounded-xl bg-white/[0.05] border border-white/10 text-xs text-white placeholder:text-slate-500 outline-none focus:border-cyan-500/50"
                  />
                </div>

                <div>
                  <label class="block text-[11px] font-semibold text-slate-300 mb-1">Lore & Knowledge Content (Injected into Prompt)</label>
                  <textarea 
                    id="lore-input-content" 
                    rows="3"
                    placeholder="Describe the secret lore, world history, faction details, or rules..."
                    class="w-full p-3 rounded-xl bg-white/[0.05] border border-white/10 text-xs text-white placeholder:text-slate-500 outline-none focus:border-cyan-500/50 resize-y"
                  ></textarea>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1">
                  <div>
                    <label class="block text-[11px] font-semibold text-slate-300 mb-1">Insertion Position</label>
                    <select id="lore-input-position" class="w-full px-3 py-2 rounded-xl bg-white/[0.05] border border-white/10 text-xs text-white outline-none">
                      <option value="after_char">After Character (Contextual)</option>
                      <option value="before_char">Before Character (Global)</option>
                    </select>
                  </div>

                  <div>
                    <label class="block text-[11px] font-semibold text-slate-300 mb-1">Priority / Insertion Order</label>
                    <input id="lore-input-order" type="number" value="100" class="w-full px-3 py-2 rounded-xl bg-white/[0.05] border border-white/10 text-xs text-white outline-none" />
                  </div>

                  <div class="flex items-center gap-3 pt-4">
                    <label class="flex items-center gap-2 cursor-pointer">
                      <input id="lore-input-constant" type="checkbox" class="w-4 h-4 accent-cyan-500 cursor-pointer" />
                      <span class="text-xs text-slate-300">Always Active (Constant)</span>
                    </label>
                  </div>
                </div>

                <div class="flex items-center justify-end gap-2 pt-2 border-t border-white/[0.06]">
                  <button type="button" id="save-lore-entry-btn" class="px-4 py-2 rounded-xl bg-cyan-600 hover:bg-cyan-500 text-white text-xs font-bold transition shadow-sm cursor-pointer">
                    Save Lore Entry
                  </button>
                </div>
              </div>

              <!-- Entries Container -->
              <div id="lore-entries-list" class="space-y-3">
                <!-- Dynamically rendered -->
              </div>

              <!-- Empty state -->
              <div id="lore-empty-state" class="hidden text-center py-10 px-4 rounded-2xl bg-white/[0.02] border border-white/[0.05] space-y-2">
                <BookOpen class="w-8 h-8 text-cyan-400/50 mx-auto" />
                <h5 class="text-xs font-bold text-white">No Lore Entries Found</h5>
                <p class="text-[11px] text-slate-400 max-w-sm mx-auto">Click "+ New Entry" above or import a Tavern/Chub JSON lorebook to inject world knowledge into this roleplay.</p>
              </div>

            </div>

          </div>
        </div>

        <!-- Fullscreen Character Artwork & Media Lightbox Modal -->
        <div 
          id="artwork-lightbox-modal" 
          class="hidden fixed inset-0 z-50 bg-black/95 backdrop-blur-2xl flex flex-col items-center justify-between p-3.5 sm:p-6 transition-all duration-300 opacity-0 pointer-events-none select-none"
        >
          <!-- Top Action Bar -->
          <div class="w-full max-w-4xl flex items-center justify-between z-10 shrink-0">
            <div class="flex items-center gap-2.5 min-w-0 pr-2">
              <div class="w-2.5 h-2.5 rounded-full bg-purple-500 animate-pulse shrink-0"></div>
              <span id="lightbox-char-name" class="text-xs sm:text-base font-bold text-white tracking-wide truncate">{character.name}</span>
              <span id="lightbox-char-title" class="hidden sm:inline text-xs text-purple-300/80 truncate">• {character.title}</span>
            </div>
            <div class="flex items-center gap-2 shrink-0">
              <a 
                id="lightbox-download-btn" 
                href={character.avatarUrl} 
                download={`${character.name}-artwork.png`}
                target="_blank"
                class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/[0.08] hover:bg-white/[0.15] border border-white/10 text-slate-200 hover:text-white text-xs font-medium transition cursor-pointer active:scale-95"
                title="Save High-Res Artwork"
              >
                <Download class="w-3.5 h-3.5 text-cyan-400" />
                <span class="hidden sm:inline">Save Art</span>
              </a>
              <button 
                id="lightbox-close-btn" 
                type="button" 
                class="w-8 h-8 rounded-full bg-white/[0.08] hover:bg-white/[0.2] text-slate-300 hover:text-white flex items-center justify-center transition cursor-pointer active:scale-95 text-sm"
                title="Close Lightbox"
              >
                <X class="w-4 h-4" />
              </button>
            </div>
          </div>

          <!-- Main Image Centerpiece -->
          <div id="lightbox-backdrop-click" class="relative flex-1 w-full max-w-4xl flex items-center justify-center p-2 min-h-0 cursor-zoom-out">
            <!-- Subtle Ambient Color Glow -->
            <div class="absolute w-72 h-72 sm:w-[450px] sm:h-[450px] rounded-full bg-purple-600/25 blur-[90px] pointer-events-none"></div>

            <img 
              id="lightbox-image" 
              src={character.avatarUrl} 
              alt={character.name} 
              class="relative max-h-[72vh] sm:max-h-[82vh] max-w-full object-contain rounded-2xl sm:rounded-3xl shadow-[0_20px_60px_rgba(0,0,0,0.9)] border border-white/10 select-none transition-transform duration-300 transform scale-95"
            />
          </div>

          <!-- Bottom Floating Hint Bar -->
          <div class="w-full max-w-md text-center shrink-0 z-10 pt-1">
            <p class="text-[11px] text-slate-400 bg-black/60 px-4 py-1.5 rounded-full border border-white/[0.08] inline-flex items-center gap-1.5 backdrop-blur-md">
              <span>Tap anywhere outside or press</span>
              <kbd class="px-1.5 py-0.5 rounded bg-white/10 font-mono text-slate-300 text-[10px]">Esc</kbd>
              <span>to close</span>
            </p>
          </div>
        </div>

        <!-- Chat Messages Scroll Stream -->
        <div 
          id="chat-stream" 
          class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-4 sm:space-y-5"
        >
          <!-- Messages will be populated dynamically from localStorage or greeting -->
        </div>

        <!-- Character Typing Indicator -->
        <div 
          id="full-typing-indicator" 
          class="hidden px-4 sm:px-6 py-2 flex items-center gap-3 animate-pulse"
        >
          <img 
            id="chat-typing-avatar"
            src={character.avatarUrl} 
            alt={character.name} 
            class="w-7 h-7 rounded-full object-cover ring-1 ring-purple-500/40" 
          />
          <div class="px-3.5 py-2 rounded-2xl rounded-tl-sm bg-white/[0.04] border border-white/[0.08] flex items-center gap-1.5 text-xs text-slate-400">
            <span class="w-1.5 h-1.5 rounded-full bg-purple-400 animate-bounce"></span>
            <span class="w-1.5 h-1.5 rounded-full bg-purple-400 animate-bounce [animation-delay:0.2s]"></span>
            <span class="w-1.5 h-1.5 rounded-full bg-purple-400 animate-bounce [animation-delay:0.4s]"></span>
            <span id="chat-typing-name" class="text-[11px] ml-1 text-slate-400">{character.name} is thinking...</span>
          </div>
        </div>

        <!-- Dynamic Smart Prompts / Contextual AI Suggestions Row -->
        <div id="smart-prompts-bar" class="px-2.5 sm:px-6 py-1.5 flex items-center gap-2 overflow-x-auto no-scrollbar shrink-0 w-full max-w-full bg-[#080a17]/80 border-t border-white/[0.04]">
          <div class="flex items-center gap-1.5 shrink-0 text-slate-400">
            <Sparkles class="w-3.5 h-3.5 text-purple-400 animate-pulse" />
            <span class="text-[10px] uppercase font-bold tracking-wider text-slate-300">Smart Ideas</span>
            <button 
              id="refresh-smart-prompts-btn" 
              type="button" 
              class="p-1 rounded-md hover:bg-white/[0.08] text-slate-400 hover:text-purple-300 transition cursor-pointer active:scale-90"
              title="Generate new contextual suggestions based on story"
            >
              <RefreshCw class="w-2.5 h-2.5" id="smart-prompts-refresh-icon" />
            </button>
          </div>

          <!-- Loading indicator -->
          <div id="smart-prompts-loading" class="hidden items-center gap-1.5 text-[11px] text-purple-300/80 font-mono animate-pulse shrink-0">
            <span class="w-1.5 h-1.5 rounded-full bg-purple-400 animate-ping"></span>
            <span>Thinking options...</span>
          </div>

          <!-- Dynamic Prompts Container -->
          <div id="smart-prompts-container" class="flex items-center gap-2 overflow-x-auto no-scrollbar scroll-smooth py-0.5">
            {character.starterPrompts && character.starterPrompts.map((prompt) => {
              const cleanPrompt = String(prompt).trim().replace(/^["'«“]+|["'»”]+$/g, '').trim();
              const displayLabel = cleanPrompt.startsWith('*') ? cleanPrompt : `"${cleanPrompt}"`;
              return (
                <button 
                  type="button"
                  class="room-starter-pill group flex items-center gap-1.5 shrink-0 px-3 py-1.5 rounded-xl bg-white/[0.04] hover:bg-purple-950/40 border border-white/[0.08] hover:border-purple-500/30 text-xs text-slate-300 hover:text-white transition duration-200 cursor-pointer active:scale-95 whitespace-nowrap shadow-sm"
                  data-prompt={cleanPrompt}
                  title="Click to fill reply"
                >
                  <span class="w-1.5 h-1.5 rounded-full bg-purple-400/60 group-hover:bg-purple-400 group-hover:scale-125 transition"></span>
                  <span>{displayLabel}</span>
                </button>
              );
            })}
          </div>
        </div>

        <!-- Bottom Chat Input Bar -->
        <div class="px-3 pt-2 pb-2.5 sm:px-6 sm:pt-2.5 sm:pb-4 border-t border-white/[0.08] bg-[#080a15]/95 backdrop-blur-xl shrink-0 w-full max-w-full">
          <!-- In-Chat Multi-Modal & Action Toolbar -->
          <div class="max-w-4xl mx-auto mb-2 flex items-center justify-between gap-1.5 overflow-x-auto no-scrollbar">
            <!-- Left: Generative Creative Tools -->
            <div class="flex items-center gap-1.5 shrink-0">
              <!-- 1. Request Selfie Photo -->
              <button 
                type="button" 
                id="chat-action-selfie-btn"
                class="px-2.5 py-1 rounded-full bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] hover:border-purple-500/40 text-slate-300 hover:text-white text-[11px] font-medium flex items-center gap-1.5 transition active:scale-95 cursor-pointer shadow-sm shrink-0"
                title="Request a contextual selfie photo from character"
              >
                <Camera class="w-3.5 h-3.5 text-purple-400" />
                <span>Selfie</span>
              </button>

              <!-- 2. Request Living Video Clip -->
              <button 
                type="button" 
                id="chat-action-video-btn"
                class="px-2.5 py-1 rounded-full bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] hover:border-pink-500/40 text-slate-300 hover:text-white text-[11px] font-medium flex items-center gap-1.5 transition active:scale-95 cursor-pointer shadow-sm group shrink-0"
                title="Generate a dynamic cinematic video animation"
              >
                <Film class="w-3.5 h-3.5 text-pink-400 group-hover:scale-110 transition-transform" />
                <span>Video</span>
              </button>
            </div>

            <!-- Right: Roleplay & Controls -->
            <div class="flex items-center gap-1.5 shrink-0">
              <!-- 3. Regenerate / Modify Last Reply -->
              <button 
                type="button" 
                id="chat-action-regenerate-btn"
                class="px-2.5 py-1 rounded-full bg-white/[0.03] hover:bg-white/[0.08] border border-white/[0.07] hover:border-cyan-500/40 text-slate-400 hover:text-cyan-300 text-[11px] font-medium flex items-center gap-1.5 transition active:scale-95 cursor-pointer shrink-0"
                title="Regenerate or modify last response"
              >
                <RefreshCw class="w-3 h-3 text-cyan-400" />
                <span class="hidden sm:inline">Retry</span>
              </button>

              <!-- 4. Rewind Last Turn -->
              <button 
                type="button" 
                id="chat-action-rewind-btn"
                class="px-2.5 py-1 rounded-full bg-white/[0.03] hover:bg-white/[0.08] border border-white/[0.07] hover:border-amber-500/40 text-slate-400 hover:text-amber-300 text-[11px] font-medium flex items-center gap-1.5 transition active:scale-95 cursor-pointer shrink-0"
                title="Rewind last turn"
              >
                <Rewind class="w-3 h-3 text-amber-400" />
                <span class="hidden sm:inline">Rewind</span>
              </button>

              <!-- 5. Active Persona Switcher -->
              <button 
                type="button" 
                id="chat-action-mask-btn"
                class="px-2.5 py-1 rounded-full bg-purple-500/10 hover:bg-purple-500/20 border border-purple-500/30 text-purple-300 hover:text-white text-[11px] font-medium flex items-center gap-1.5 transition active:scale-95 cursor-pointer shrink-0"
                title="Click to switch persona"
