  // Safe helper to extract balanced <details> and <div ...> blocks without breaking nested tags
  function extractBalancedHtmlBlocks(str) {
    const htmlBlocks = [];
    let result = '';
    let i = 0;
    const n = str.length;

    while (i < n) {
      const sub = str.slice(i, i + 8).toLowerCase();
      if (sub.startsWith('<details') || sub.startsWith('<div')) {
        const isDetails = sub.startsWith('<details');
        const targetTag = isDetails ? 'details' : 'div';
        const tagRegex = new RegExp(`<(/?)\\s*${targetTag}(\\s[^>]*)?>`, 'gi');
        tagRegex.lastIndex = i;

        let depth = 0;
        let startPos = i;
        let matched = false;
        let match;

        while ((match = tagRegex.exec(str)) !== null) {
          const isClose = !!match[1];
          if (!isClose) {
            depth++;
          } else {
            depth--;
            if (depth === 0) {
              const endPos = tagRegex.lastIndex;
              const idx = htmlBlocks.length;
              htmlBlocks.push(str.slice(startPos, endPos));
              result += `__HTML_BLOCK_${idx}__`;
              i = endPos;
              matched = true;
              break;
            }
          }
        }

        if (!matched) {
          result += str[i];
          i++;
        }
      } else {
        result += str[i];
        i++;
      }
    }

    return { masked: result, blocks: htmlBlocks };
  }

  // Bulletproof extraction of text from any streaming chunk or JSON response
  // Completely prevents '[object Object]' when providers return nested objects/arrays in reasoning_details or content blocks
  function extractStreamToken(val) {
    if (val === null || val === undefined) return '';
    if (typeof val === 'string') return val;
    if (typeof val === 'number') return String(val);
    if (Array.isArray(val)) {
      return val.map(item => extractStreamToken(item)).join('');
    }
    if (typeof val === 'object') {
      if (typeof val.text === 'string') return val.text;
      if (typeof val.content === 'string') return val.content;
      if (typeof val.summary === 'string') return val.summary;
      if (typeof val.thought === 'string') return val.thought;
      if (typeof val.reasoning === 'string') return val.reasoning;
      if (Array.isArray(val.content)) return extractStreamToken(val.content);
      if (Array.isArray(val.reasoning_details)) return extractStreamToken(val.reasoning_details);
      return '';
    }
    return '';
  }

  // Format action text (*italic*), bold, code, markdown images, and paragraphs (Cinematic Markdown)
  function formatMessageText(text) {
    if (!text) return '';

    // Parse <think>...</think> tags from reasoning models (e.g. DeepSeek R1 / Qwen)
    text = text.replace(/<think>([\s\S]*?)(?:<\/think>|$)/gi, (_, thought) => {
      const trimmed = thought.trim();
      if (!trimmed) return '';
      return `<details class="mb-3 rounded-lg border border-purple-500/20 bg-purple-950/20 px-3 py-2 text-xs text-purple-300 select-none"><summary class="cursor-pointer font-medium hover:text-purple-200">💭 Thought Process (${trimmed.length} chars)</summary><div class="mt-2 text-slate-300 font-mono text-[11px] leading-relaxed whitespace-pre-wrap">${trimmed}</div></details>\n\n`;
    });

    // Protect balanced <details> and <div ...> blocks (e.g. thought boxes, pause notices)
    const { masked, blocks: htmlBlocks } = extractBalancedHtmlBlocks(text);
    let s = masked;

    // Strip orphan/stray reasoning or disclosure tags leaked by model in raw text
    s = s.replace(/<\/?(?:details|summary|think|thought)[^>]*>/gi, '');

    // 0. Extract markdown images before escaping: ![alt](url)
    const mediaPlaceholders = [];
    s = s.replace(/!\[([^\]]*)\]\((https?:\/\/[^\s\)]+)\)/g, (_, alt, url) => {
      const idx = mediaPlaceholders.length;
      mediaPlaceholders.push(`<div class="my-3 rounded-2xl overflow-hidden border border-white/10 shadow-lg bg-black/40 max-w-md"><img src="${url}" alt="${alt || 'Scene illustration'}" class="max-h-96 w-auto max-w-full rounded-2xl object-contain mx-auto block hover:scale-[1.02] transition-transform duration-300" loading="lazy" /></div>`);
      return `__MEDIA_IMG_${idx}__`;
    });

    // Also detect standalone image URLs ending in png/jpg/jpeg/webp/gif
    s = s.replace(/(^|\n|\s)(https?:\/\/[^\s<>]+\.(?:png|jpe?g|webp|gif))(?=\s|\n|$)/gi, (_, prefix, url) => {
      const idx = mediaPlaceholders.length;
      mediaPlaceholders.push(`<div class="my-3 rounded-2xl overflow-hidden border border-white/10 shadow-lg bg-black/40 max-w-md"><img src="${url}" alt="Scene illustration" class="max-h-96 w-auto max-w-full rounded-2xl object-contain mx-auto block hover:scale-[1.02] transition-transform duration-300" loading="lazy" /></div>`);
      return `${prefix}__MEDIA_IMG_${idx}__`;
    });

    // 1. Basic entity escaping
    s = s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;');

    // 2. Protect inline code `code`
    const codeBlocks = [];
    s = s.replace(/`([^`]+)`/g, (_, code) => {
      const idx = codeBlocks.length;
      codeBlocks.push(`<code class="px-1.5 py-0.5 rounded bg-white/10 text-cyan-300 font-mono text-[11px]">${code}</code>`);
      return `__CODE_BLOCK_${idx}__`;
    });

    // 3. Triple asterisks ***bold italic***
    s = s.replace(/\*\*\*([^*]+)\*\*\*/g, '<strong class="font-bold text-purple-200"><em class="italic text-purple-300 font-serif">$1</em></strong>');

    // 4. Double asterisks **bold**
    s = s.replace(/\*\*([^*]+)\*\*/g, '<strong class="font-bold text-white">$1</strong>');

    // 5. Single asterisks *action / sensory narration / thoughts*
    s = s.replace(/\*([^*]+)\*/g, '<em class="text-purple-300/90 italic font-serif leading-relaxed">$1</em>');

    // 6. Restore inline code
    s = s.replace(/__CODE_BLOCK_(\d+)__/g, (_, idx) => codeBlocks[idx] || '');

    // Restore media images
    s = s.replace(/__MEDIA_IMG_(\d+)__/g, (_, idx) => mediaPlaceholders[idx] || '');

    // Restore reasoning / HTML blocks
    s = s.replace(/__HTML_BLOCK_(\d+)__/g, (_, idx) => (htmlBlocks && htmlBlocks[idx]) || '');

    // 7. Multi-line paragraphs: double newlines become separate paragraphs
    // Do NOT wrap raw block elements (<details> or <div>) inside <p> tags to avoid DOM nesting corruption
    const rawParagraphs = s.split(/\n{2,}/);
    const rendered = rawParagraphs
      .map(p => {
        const trimmed = p.trim();
        if (!trimmed) return '';
        if (trimmed.startsWith('<details') || trimmed.startsWith('<div')) {
          return trimmed;
        }
        return `<p class="mb-2.5 last:mb-0 leading-relaxed">${trimmed.replace(/\n/g, '<br/>')}</p>`;
      })
      .filter(Boolean);

    return rendered.join('');
  }

