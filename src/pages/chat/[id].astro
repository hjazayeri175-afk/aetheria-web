  // Sessions dropdown toggle & listeners
  const sessionsBtn = document.getElementById('chat-sessions-btn');
  const sessionsDropdown = document.getElementById('sessions-dropdown');
  const createNewSessionBtn = document.getElementById('create-new-session-btn');

  sessionsBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    sessionsDropdown?.classList.toggle('hidden');
