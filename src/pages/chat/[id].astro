  function saveLoreEntryFromForm() {
    const name = document.getElementById('lore-input-name').value.trim();
    const keysRaw = document.getElementById('lore-input-keys').value;
    const secKeysRaw = document.getElementById('lore-input-second-keys').value;
    const content = document.getElementById('lore-input-content').value.trim();
    const position = document.getElementById('lore-input-position').value;
    const order = parseInt(document.getElementById('lore-input-order').value || '100', 10);
    const constant = document.getElementById('lore-input-constant').checked;

    if (!content) {
      showNotification('Please enter lore content.', 'error');
      return;
    }

    const keys = keysRaw.split(',').map(k => k.trim()).filter(Boolean);
    const secKeys = secKeysRaw.split(',').map(k => k.trim()).filter(Boolean);

    const arr = getActiveScopeEntries();
    if (editingLoreId) {
      const existing = arr.find(e => e.id === editingLoreId);
      if (existing) {
        existing.name = name || 'Untitled Entry';
        existing.keys = keys;
        existing.secondary_keys = secKeys;
        existing.content = content;
        existing.position = position;
        existing.insertion_order = order;
        existing.constant = constant;
      }
    } else {
      arr.push({
        id: 'lore_' + Date.now(),
        name: name || 'Untitled Entry',
        keys: keys,
        secondary_keys: secKeys,
        content: content,
        position: position,
        insertion_order: order,
        constant: constant,
        enabled: true
      });
    }

    saveCurrentScopeEntries();
    closeLoreForm();
    showNotification('Lorebook entry saved.');
  }

  // Runtime Keyword Scanner & Injection Engine
  function scanAndInjectLorebook(userPrompt = '', recentConversation = []) {
    loadLorebook();
    const allEntries = [...charLoreEntries, ...globalLoreEntries];
    if (allEntries.length === 0) {
      return { beforeCharContent: '', afterCharContent: '', triggeredNames: [] };
    }

    // Build scan context: current user prompt + last 2 turns
    const lastTurnsText = recentConversation.slice(-2).map((m) => m.text).join(' ');
    const fullScanText = `${userPrompt} ${lastTurnsText}`.toLowerCase();

    const activeBefore = [];
    const activeAfter = [];
    const triggered = [];

    // Filter, sort by insertion_order descending
    const sorted = [...allEntries].sort((a, b) => (b.insertion_order || 100) - (a.insertion_order || 100));

    sorted.forEach(entry => {
      if (entry.enabled === false) return;

      // Robust normalization of trigger keys across all card formats (string, array, Tavern key/keys)
      const rawPrimary = entry.keys || entry.key || [];
      const primaryKeys = (Array.isArray(rawPrimary) 
        ? rawPrimary 
        : (typeof rawPrimary === 'string' ? rawPrimary.split(',') : [])
      ).map(k => String(k).toLowerCase().trim()).filter(Boolean);

      const rawSecondary = entry.secondary_keys || entry.secondary_key || [];
      const secondaryKeys = (Array.isArray(rawSecondary) 
        ? rawSecondary 
        : (typeof rawSecondary === 'string' ? rawSecondary.split(',') : [])
      ).map(k => String(k).toLowerCase().trim()).filter(Boolean);

      let isHit = false;
      if (entry.constant) {
        isHit = true;
      } else if (primaryKeys.length > 0) {
        const matchesPrimary = primaryKeys.some((k) => fullScanText.includes(k));
        if (matchesPrimary) {
          if (secondaryKeys.length > 0) {
            const matchesSecondary = secondaryKeys.some((k) => fullScanText.includes(k));
            if (matchesSecondary) isHit = true;
          } else {
            isHit = true;
          }
        }
      }

      if (isHit) {
        triggered.push(entry.name || primaryKeys[0] || 'Lore Entry');
        if (entry.position === 'before_char') {
          activeBefore.push(entry.content);
        } else {
          activeAfter.push(entry.content);
        }
      }
    });

    return {
      beforeCharContent: activeBefore.join('\n\n'),
      afterCharContent: activeAfter.join('\n\n'),
      triggeredNames: triggered
    };
  }

