  // ==========================================
  // UNIFIED MULTI-MODALITY PING & TEST ENGINE
  // ==========================================
  async function pingModalityEndpoint(kind, prov, key, customUrl) {
    const t0 = performance.now();
    try {
      // 1. Browser-native or 100% free offline capabilities
      if (prov === 'browser' || prov === 'browser-stt') {
        const supported = (kind === 'tts') 
          ? ('speechSynthesis' in window) 
          : ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window);
        if (!supported) return { ok: false, error: 'Web Speech API is not supported in this browser' };
        return { ok: true, latency: Math.max(2, Math.round(performance.now() - t0)) };
      }

      if (prov === 'pollinations') {
        try {
          await fetch('https://image.pollinations.ai/prompt/ping?width=16&height=16&nologo=true', { method: 'HEAD', mode: 'no-cors' });
        } catch (_) {}
        return { ok: true, latency: Math.max(15, Math.round(performance.now() - t0)) };
      }

      if (prov === 'cloudflare' && kind === 'vision') {
        return { ok: true, latency: Math.max(18, Math.round(performance.now() - t0)) };
      }

      if (prov === 'auto' && kind === 'vision') {
        const textKey = localStorage.getItem('aetheria_text_key') || localStorage.getItem('aetheria_key_google') || localStorage.getItem('aetheria_key_gemini') || localStorage.getItem('aetheria_key_openai') || '';
        if (!textKey) {
          return { ok: true, latency: 15, note: 'Inherits from text model' };
        }
        prov = textKey.startsWith('AIzaSy') ? 'gemini' : 'openai';
        key = textKey;
      }

      // 2. Custom local or user-provided endpoint
      const isCustom = prov === 'custom' || prov === 'custom-stt' || prov === 'local-stt' || prov === 'xtts' || prov === 'comfyui';
      if (isCustom) {
        if (!customUrl) return { ok: false, error: 'Endpoint URL is required' };
        const cleanUrl = customUrl.trim();
        try {
          const res = await fetch('/api/proxy/fetch-models', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              endpoint: cleanUrl,
              apiKey: key || undefined
            })
          });
          const latency = Math.round(performance.now() - t0);
          if (res.ok) {
            const body = await res.json().catch(() => ({}));
            if (body.status === 401 || body.status === 403) {
              return { ok: false, error: `Authentication failed (HTTP ${body.status})` };
            }
            if (body.status > 0 && body.status < 500) {
              return { ok: true, latency };
            }
            return { ok: false, error: body.error || `Server returned HTTP ${body.status}` };
          }
          return { ok: false, error: `Server unreachable (HTTP ${res.status})` };
        } catch (e) {
          return { ok: false, error: e.message || 'Failed to reach custom server' };
        }
      }

      // 3. Cloud Provider Validation Endpoints
      if (!key) return { ok: false, error: 'API key is required' };

      let targetUrl = '';
      let headers = {};

      if (prov === 'elevenlabs') {
        targetUrl = 'https://api.elevenlabs.io/v1/user';
        headers = { 'xi-api-key': key };
      } else if (prov === 'openai' || prov === 'openai-stt') {
        targetUrl = 'https://api.openai.com/v1/models';
        headers = { 'Authorization': `Bearer ${key}` };
      } else if (prov === 'gemini' || prov === 'google') {
        targetUrl = `https://generativelanguage.googleapis.com/v1beta/models?key=${encodeURIComponent(key)}`;
        headers = { 'x-goog-api-key': key };
      } else if (prov === 'groq') {
        targetUrl = 'https://api.groq.com/openai/v1/models';
        headers = { 'Authorization': `Bearer ${key}` };
      } else if (prov === 'deepgram') {
        targetUrl = 'https://api.deepgram.com/v1/projects';
        headers = { 'Authorization': `Token ${key}` };
      } else if (prov === 'cartesia' || prov === 'playht') {
        targetUrl = 'https://api.cartesia.ai/voices';
        headers = { 'X-API-Key': key, 'Cartesia-Version': '2024-06-10' };
      } else if (prov === 'cloudflare' || prov === 'cloudflare-stt') {
        targetUrl = 'https://api.cloudflare.com/client/v4/user/tokens/verify';
        headers = { 'Authorization': `Bearer ${key}` };
      } else if (prov === 'assemblyai') {
        targetUrl = 'https://api.assemblyai.com/v2/transcript?limit=1';
        headers = { 'Authorization': key };
      } else if (prov === 'gladia') {
        targetUrl = 'https://api.gladia.io/v2/live';
        headers = { 'x-gladia-key': key };
      } else if (prov.startsWith('fal-') || prov === 'fal') {
        targetUrl = 'https://api.fal.ai/v1/models';
        headers = { 'Authorization': key.startsWith('Key ') ? key : `Key ${key}` };
      } else if (prov === 'replicate') {
        targetUrl = 'https://api.replicate.com/v1/models';
        headers = { 'Authorization': key.startsWith('Bearer ') || key.startsWith('Token ') ? key : `Bearer ${key}` };
      } else if (prov === 'fishaudio') {
        targetUrl = 'https://api.fish.audio/v1/model';
        headers = { 'Authorization': `Bearer ${key}` };
      } else if (prov === 'openrouter') {
        targetUrl = 'https://openrouter.ai/api/v1/models';
        headers = { 'Authorization': `Bearer ${key}` };
      } else {
        return { ok: true, latency: Math.round(performance.now() - t0) || 50 };
      }

      // Execute through proxy to eliminate any CORS blockers
      const proxyRes = await fetch('/api/proxy/fetch-models', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          endpoint: targetUrl,
          apiKey: key,
          headers: headers
        })
      });

      const latency = Math.round(performance.now() - t0);
      const resData = await proxyRes.json().catch(() => ({}));

      if (proxyRes.ok && resData.success !== false && (resData.status >= 200 && resData.status < 400)) {
        return { ok: true, latency };
      }

      if (resData.data && resData.data.success === true) {
        return { ok: true, latency };
      }

      const statusCode = resData.status || proxyRes.status;
      let errMsg = 'Authentication failed';
      if (statusCode === 401) {
        errMsg = 'Invalid API Key or unauthorized token';
      } else if (statusCode === 403) {
        errMsg = 'Access denied or quota exceeded';
      } else if (statusCode === 404) {
        errMsg = 'API endpoint not found';
      } else if (statusCode === 429) {
        errMsg = 'Rate limit exceeded';
      } else if (resData.error) {
        errMsg = resData.error;
      } else if (resData.data && resData.data.error && resData.data.error.message) {
        errMsg = resData.data.error.message;
      } else if (resData.data && resData.data.detail) {
        errMsg = typeof resData.data.detail === 'string' ? resData.data.detail : (resData.data.detail.message || JSON.stringify(resData.data.detail));
      }

      return {
        ok: false,
        status: statusCode,
        latency,
        error: errMsg
      };
    } catch (err) {
      return {
        ok: false,
        latency: Math.round(performance.now() - t0),
        error: err.message || 'Network connection failed'
      };
    }
  }

