  async function connectImageWithTest() {
    const prov = localStorage.getItem('aetheria_image_provider') || 'pollinations';
    const key = imageApiKey?.value.trim() || '';
    const obj = IMAGE_CATALOG.find(x => x.id === prov) || IMAGE_CATALOG[0];
    const isCustom = obj.needsUrl;
    const customUrlVal = imageCustomUrl?.value.trim() || '';

    if (isCustom && !customUrlVal) {
      showNotification('⚠️ Please enter an Endpoint URL first.', 'warning');
      imageCustomUrl?.focus();
      return;
    }
    if (obj.needsKey && !key && !isCustom) {
      showNotification('⚠️ Please enter an API key first.', 'warning');
      imageApiKey?.focus();
      return;
    }

    if (imageConnectConfirmBtn) {
      imageConnectConfirmBtn.disabled = true;
      imageConnectConfirmBtn.classList.add('opacity-80', 'cursor-wait');
      if (imageConnectBtnIcon) imageConnectBtnIcon.classList.add('animate-spin');
      if (imageConnectBtnText) imageConnectBtnText.textContent = 'Testing...';
    }
    if (imageConnectStatus) {
      imageConnectStatus.classList.add('hidden');
      imageConnectStatus.innerHTML = '';
    }

    const testRes = await pingModalityEndpoint('image', prov, key, customUrlVal);

    if (imageConnectConfirmBtn) {
      imageConnectConfirmBtn.disabled = false;
      imageConnectConfirmBtn.classList.remove('opacity-80', 'cursor-wait');
      if (imageConnectBtnIcon) imageConnectBtnIcon.classList.remove('animate-spin');
      if (imageConnectBtnText) imageConnectBtnText.textContent = 'Connect';
    }

    if (!testRes.ok) {
      if (imageConnectStatus) {
        imageConnectStatus.innerHTML = `
          <div class="p-2.5 rounded-xl bg-rose-500/10 border border-rose-500/25 text-rose-300 text-[11px] flex items-start gap-2">
            <span class="shrink-0 font-bold mt-0.5">✕</span>
            <div class="min-w-0 flex-1">
              <div class="font-semibold text-rose-200">Connection Failed${testRes.status ? ` (HTTP ${testRes.status})` : ''}</div>
              <div class="text-[10px] text-rose-300/80 mt-0.5">${testRes.error || 'Invalid credentials'}</div>
            </div>
          </div>
        `;
        imageConnectStatus.classList.remove('hidden');
      }
      showNotification(`✕ Image test failed: ${testRes.error || 'Unauthorized'}`, 'error');
      imageApiKey?.focus();
      return;
    }

    if (isCustom && imageCustomUrl) {
      localStorage.setItem('aetheria_image_custom_url', customUrlVal);
    }
    if (key) {
      localStorage.setItem('aetheria_key_' + prov, key);
      localStorage.setItem('aetheria_image_key', key);
    }

    if (imageApiKey) imageApiKey.value = '';
    if (imageConnectStatus) imageConnectStatus.classList.add('hidden');

    syncImageUiPanels();
    syncVideoUiPanels();

    if (imageConnectedLatency) {
      imageConnectedLatency.textContent = `${testRes.latency}ms`;
      imageConnectedLatency.className = 'text-[10px] px-2 py-0.5 rounded-full bg-amber-500/15 border border-amber-500/30 text-amber-300 font-mono font-medium shrink-0';
      imageConnectedLatency.classList.remove('hidden');
    }

    showNotification(`✓ ${obj.name} connected successfully! (${testRes.latency}ms)`);
  }

  imageConnectConfirmBtn?.addEventListener('click', connectImageWithTest);
  imageApiKey?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
      e.preventDefault();
      connectImageWithTest();
