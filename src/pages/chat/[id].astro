  // Save all engine settings to localStorage (Bulletproof with fallback)
  function saveAllSettings() {
    try {
      const prov = textProviderSelect?.value || 'openrouter';
      const key = (textApiKey?.value || '').trim();
      const baseUrl = (textBaseUrl?.value || '').trim();

      if (textProviderSelect) localStorage.setItem('aetheria_text_provider', prov);
      if (textApiKey) localStorage.setItem('aetheria_text_key', key);
      if (textBaseUrl) localStorage.setItem('aetheria_text_base_url', baseUrl);

      const isCustomInput = Boolean(textModelInput && !textModelInput.classList.contains('hidden'));
      let model = isCustomInput ? textModelInput.value.trim() : (textModelSelect ? textModelSelect.value : '');
      if (!model || model.includes('No API connected')) {
        model = localStorage.getItem('aetheria_text_model') || '';
      }

      if ((!model || model.includes('No API connected')) && prov !== 'demo') {
        const cached = localStorage.getItem('aetheria_synced_models_' + prov);
        try {
          const list = JSON.parse(cached || '[]');
          if (list.length > 0) model = list[0];
        } catch (e) {}
        if (!model) {
          if (prov === 'openrouter') model = 'deepseek/deepseek-chat';
          else if (prov === 'groq') model = 'llama-3.3-70b-versatile';
          else if (prov === 'google') model = 'gemini-2.0-flash';
          else if (prov === 'anthropic') model = 'claude-3-5-sonnet-20241022';
          else if (prov === 'openai') model = 'gpt-4o';
        }
      }

      if (model) {
        localStorage.setItem('aetheria_text_model', model);
        updateCustomModelTrigger(model);
        if (textModelSelect) {
          textModelSelect.disabled = false;
          textModelSelect.value = model;
        }
      }
      updateHeaderPill();

      if (sliderTemp) localStorage.setItem('aetheria_text_temp', sliderTemp.value);
      if (sliderTokens) localStorage.setItem('aetheria_text_tokens', sliderTokens.value);
      if (sliderTopP) localStorage.setItem('aetheria_text_top_p', sliderTopP.value);
      if (sliderRepPen) localStorage.setItem('aetheria_text_rep_pen', sliderRepPen.value);
      if (sliderFreqPen) localStorage.setItem('aetheria_text_freq_pen', sliderFreqPen.value);
      if (sliderPresPen) localStorage.setItem('aetheria_text_pres_pen', sliderPresPen.value);
      if (sliderContext) localStorage.setItem('aetheria_text_context', sliderContext.value);
      if (toggleStreaming) localStorage.setItem('aetheria_text_streaming', toggleStreaming.checked ? 'true' : 'false');
      if (toggleThinking) localStorage.setItem('aetheria_text_thinking', toggleThinking.checked ? 'true' : 'false');

      if (voiceProviderSelect) localStorage.setItem('aetheria_voice_provider', voiceProviderSelect.value);
      if (voiceApiKey) localStorage.setItem('aetheria_voice_key', voiceApiKey.value.trim());
      if (voiceIdInput) localStorage.setItem('aetheria_voice_id', voiceIdInput.value.trim());
      if (openaiVoiceSelect) localStorage.setItem('aetheria_openai_voice', openaiVoiceSelect.value);
      if (sliderStability) localStorage.setItem('aetheria_voice_stability', sliderStability.value);
      if (sliderClarity) localStorage.setItem('aetheria_voice_clarity', sliderClarity.value);
      if (sliderVoiceRate) localStorage.setItem('aetheria_voice_rate', sliderVoiceRate.value);
      if (sliderVoicePitch) localStorage.setItem('aetheria_voice_pitch', sliderVoicePitch.value);
      if (toggleFilterNarration) localStorage.setItem('aetheria_voice_filter_narration', toggleFilterNarration.checked ? 'true' : 'false');
      if (toggleAutoplayVoice) {
        localStorage.setItem('aetheria_voice_autoplay', toggleAutoplayVoice.checked ? 'true' : 'false');
        ttsEnabled = toggleAutoplayVoice.checked;
        syncTtsUi();
        if (!ttsEnabled) stopSpeaking();
      }

      if (imageProviderSelect) localStorage.setItem('aetheria_image_provider', imageProviderSelect.value);
      if (imageApiKey) localStorage.setItem('aetheria_image_key', imageApiKey.value.trim());
      if (imageAspectSelect) localStorage.setItem('aetheria_image_aspect', imageAspectSelect.value);
