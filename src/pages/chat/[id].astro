        }
        if (customVideoProfileStatusDot) customVideoProfileStatusDot.className = 'w-2 h-2 rounded-full bg-emerald-400 shrink-0';
        if (btnUpdateActiveVideoProfile) btnUpdateActiveVideoProfile.classList.remove('hidden');
        if (btnDeleteActiveVideoProfile) btnDeleteActiveVideoProfile.classList.remove('hidden');
        if (videoActiveProfileBadge) {
          videoActiveProfileBadge.textContent = activeProf.name;
          videoActiveProfileBadge.classList.remove('hidden');
        }
      } else {
        localStorage.removeItem(ACTIVE_VIDEO_PROFILE_KEY);
        renderVideoProfileMenu();
      }
    } else {
      if (customVideoProfileTriggerLabel) customVideoProfileTriggerLabel.textContent = 'Fal.ai Kling 1.5 Pro (Default)';
      if (customVideoProfileTriggerTag) customVideoProfileTriggerTag.classList.add('hidden');
      if (customVideoProfileStatusDot) customVideoProfileStatusDot.className = 'w-2 h-2 rounded-full bg-slate-400 shrink-0';
      if (btnUpdateActiveVideoProfile) btnUpdateActiveVideoProfile.classList.add('hidden');
      if (btnDeleteActiveVideoProfile) btnDeleteActiveVideoProfile.classList.add('hidden');
      if (videoActiveProfileBadge) videoActiveProfileBadge.classList.add('hidden');
    }

    customVideoProfileMenu.querySelectorAll('.video-profile-item').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-profile-id');
        if (id) {
          applyVideoProfile(id);
        } else {
          localStorage.removeItem(ACTIVE_VIDEO_PROFILE_KEY);
          if (typeof window.selectVideoEngine === 'function') {
            window.selectVideoEngine('fal-kling');
          }
          if (typeof window.selectVideoCamera === 'function') {
            window.selectVideoCamera('subtle');
          }
          if (typeof window.selectVideoDuration === 'function') {
            window.selectVideoDuration('5s');
          }
          if (typeof window.selectVideoRes === 'function') {
            window.selectVideoRes('720p-24fps');
          }
          renderVideoProfileMenu();
          showNotification('✓ Switched to default Video profile');
        }
        closeVideoProfileMenu();
      });
    });
