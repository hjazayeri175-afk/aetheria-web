      localStorage.removeItem('aetheria_voice_key');
      localStorage.removeItem('aetheria_image_provider');
      localStorage.removeItem('aetheria_video_provider');
      loadEngineSettings();
      showNotification('Restored optimal roleplay defaults.');
    }
  });

  // Top Engine Tab Switching (Text, Voice, Selfies, Video)
  engineTabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const tabTarget = btn.getAttribute('data-tab');
      if (!tabTarget) return;

      engineTabBtns.forEach(b => {
        b.classList.remove('bg-purple-950/60', 'border-purple-500/50', 'text-white', 'shadow-md', 'shadow-purple-950/40');
