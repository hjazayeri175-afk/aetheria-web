  function renderVoiceModalCategories() {
    if (!voiceModalCategoryChips) return;
    const categories = voiceCatalogMode === 'tts' 
      ? ['All', 'Popular', 'Realistic', 'Fastest', 'Free & Offline']
      : ['All', 'Popular', 'Fastest', 'Free & Offline'];

    voiceModalCategoryChips.innerHTML = categories.map(cat => {
      const filterKey = cat.toLowerCase();
      const isActive = currentVoiceCatalogFilter === filterKey || (cat === 'All' && currentVoiceCatalogFilter === 'all');
      return `
        <button
          type="button"
          data-voice-filter="${filterKey}"
          class="voice-cat-chip px-3 py-1 rounded-full text-xs font-semibold shrink-0 transition cursor-pointer ${
            isActive
              ? (voiceCatalogMode === 'tts' ? 'bg-purple-600 text-white shadow-sm shadow-purple-900/50' : 'bg-rose-600 text-white shadow-sm shadow-rose-900/50')
