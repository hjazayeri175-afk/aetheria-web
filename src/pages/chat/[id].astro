  async function connectVisionWithTest() {
    const prov = localStorage.getItem('aetheria_vision_provider') || 'auto';
    const key = visionApiKey?.value.trim() || '';
    const obj = VISION_CATALOG.find(x => x.id === prov) || VISION_CATALOG[0];
    const isCustom = obj.needsUrl;
    const customUrlVal = visionCustomUrl?.value.trim() || '';

    if (isCustom && !customUrlVal) {
      showNotification('⚠️ Please enter an Endpoint URL first.', 'warning');
      visionCustomUrl?.focus();
      return;
    }
    if (obj.needsKey && !key && !isCustom) {
      showNotification('⚠️ Please enter an API key first.', 'warning');
      visionApiKey?.focus();
      return;
    }

    if (visionConnectConfirmBtn) {
      visionConnectConfirmBtn.disabled = true;
      visionConnectConfirmBtn.classList.add('opacity-80', 'cursor-wait');
      if (visionConnectBtnIcon) visionConnectBtnIcon.classList.add('animate-spin');
      if (visionConnectBtnText) visionConnectBtnText.textContent = 'Testing...';
    }
    if (visionConnectStatus) {
      visionConnectStatus.classList.add('hidden');
      visionConnectStatus.innerHTML = '';
    }

    const testRes = await pingModalityEndpoint('vision', prov, key, customUrlVal);

    if (visionConnectConfirmBtn) {
      visionConnectConfirmBtn.disabled = false;
      visionConnectConfirmBtn.classList.remove('opacity-80', 'cursor-wait');
      if (visionConnectBtnIcon) visionConnectBtnIcon.classList.remove('animate-spin');
      if (visionConnectBtnText) visionConnectBtnText.textContent = 'Connect';
    }

    if (!testRes.ok) {
      if (visionConnectStatus) {
        visionConnectStatus.innerHTML = `
          <div class="p-2.5 rounded-xl bg-rose-500/10 border border-rose-500/25 text-rose-300 text-[11px] flex items-start gap-2">
            <span class="shrink-0 font-bold mt-0.5">✕</span>
            <div class="min-w-0 flex-1">
              <div class="font-semibold text-rose-200">Connection Failed${testRes.status ? ` (HTTP ${testRes.status})` : ''}</div>
              <div class="text-[10px] text-rose-300/80 mt-0.5">${testRes.error || 'Invalid credentials'}</div>
            </div>
          </div>
        `;
        visionConnectStatus.classList.remove('hidden');
      }
      showNotification(`✕ Vision test failed: ${testRes.error || 'Unauthorized'}`, 'error');
      visionApiKey?.focus();
      return;
    }

    if (isCustom && visionCustomUrl) {
      localStorage.setItem('aetheria_vision_custom_url', customUrlVal);
    }
    if (key) {
      localStorage.setItem('aetheria_key_' + prov, key);
      localStorage.setItem('aetheria_vision_key', key);
    }

    if (visionApiKey) visionApiKey.value = '';
    if (visionConnectStatus) visionConnectStatus.classList.add('hidden');

    syncImageUiPanels();
    syncVideoUiPanels();

    if (visionConnectedLatency) {
      visionConnectedLatency.textContent = `${testRes.latency}ms`;
      visionConnectedLatency.className = 'text-[10px] px-2 py-0.5 rounded-full bg-cyan-500/15 border border-cyan-500/30 text-cyan-300 font-mono font-medium shrink-0';
      visionConnectedLatency.classList.remove('hidden');
    }

    showNotification(`✓ ${obj.name} connected successfully! (${testRes.latency}ms)`);
  }

