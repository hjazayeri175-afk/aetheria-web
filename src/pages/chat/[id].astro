  function getSttKeyForProvider(prov) {
    if (prov === 'groq') return localStorage.getItem('aetheria_stt_key_groq') || localStorage.getItem('aetheria_stt_key') || localStorage.getItem('aetheria_key_groq') || '';
    if (prov === 'openai' || prov === 'openai-stt') return localStorage.getItem('aetheria_stt_key_openai') || localStorage.getItem('aetheria_stt_key') || localStorage.getItem('aetheria_key_openai') || '';
    if (prov === 'assemblyai') return localStorage.getItem('aetheria_stt_key_assemblyai') || localStorage.getItem('aetheria_stt_key') || '';
    if (prov === 'google-stt') return localStorage.getItem('aetheria_stt_key_google') || localStorage.getItem('aetheria_stt_key') || '';
    return localStorage.getItem('aetheria_stt_key') || '';
  }

