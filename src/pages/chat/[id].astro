  // Save all engine settings to localStorage (Bulletproof with fallback)
  function saveAllSettings() {
    try {
      const prov = textProviderSelect?.value || 'groq';
      const key = (textApiKey?.value || '').trim();
      const baseUrl = (textBaseUrl?.value || '').trim();

      if (textProviderSelect) localStorage.setItem('aetheria_text_provider', prov);
      if (textApiKey) localStorage.setItem('aetheria_text_key', key);
      if (textBaseUrl) localStorage.setItem('aetheria_text_base_url', baseUrl);

      // Save per-provider
      localStorage.setItem('aetheria_key_' + prov, key);
      localStorage.setItem('aetheria_url_' + prov, baseUrl);

      const isCustomInput = Boolean(textModelInput && !textModelInput.classList.contains('hidden'));
      let model = isCustomInput ? textModelInput.value.trim() : (textModelSelect ? textModelSelect.value : '');
      if (!model || model.includes('No API connected')) {
        model = localStorage.getItem('aetheria_text_model') || '';
      }

      if (!model || model.includes('No API connected')) {
        const cached = localStorage.getItem('aetheria_synced_models_' + prov);
        try {
          const list = JSON.parse(cached || '[]');
          if (list.length > 0) model = list[0];
        } catch (e) {}
        if (!model && DEFAULT_PROVIDER_MODELS[prov]) {
          model = DEFAULT_PROVIDER_MODELS[prov][0];
        }
      }

      if (model) {
        localStorage.setItem('aetheria_text_model', model);
        localStorage.setItem('aetheria_model_' + prov, model);
        updateCustomModelTrigger(model);
        if (textModelSelect) {
          textModelSelect.disabled = false;
          textModelSelect.value = model;
        }
      }

      // If active profile exists, update it automatically
      const activeProfId = localStorage.getItem(ACTIVE_PROFILE_KEY);
      if (activeProfId) {
        const profiles = getSavedApiProfiles();
        const pIdx = profiles.findIndex(p => p.id === activeProfId);
        if (pIdx !== -1) {
          profiles[pIdx].provider = prov;
          profiles[pIdx].apiKey = key;
          profiles[pIdx].baseUrl = baseUrl;
