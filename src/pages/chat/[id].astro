    wizardCurrentStep = 4;
    const provObj = WIZARD_PROVIDERS.find(p => p.id === savedProv) || { id: savedProv, name: savedProv };
    wizardSelectedProv = provObj;
    wizardSelectedModel = savedModel || '';

    wizardChatView?.classList.remove('hidden');
    wizardSettingsView?.classList.add('hidden');
    if (wizardStepBadge) wizardStepBadge.textContent = 'Active Setup';
    if (wizardChatBox) wizardChatBox.innerHTML = '';

    appendNovaBubble(`
      <div class="flex items-center justify-between pb-2 border-b border-white/[0.08] gap-2 flex-wrap">
        <span class="text-emerald-400 font-bold flex items-center gap-1.5 text-xs">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
