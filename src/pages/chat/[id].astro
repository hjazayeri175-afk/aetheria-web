        : 'Enter your API key to enable cinematic video generation.';
      if (videoApiKey) {
        videoApiKey.value = savedVidKey;
        videoApiKey.placeholder = vidObj.keyHint || 'Paste API Key (fal_... or r8_...)...';
      }
      if (videoCustomUrlContainer) {
        videoCustomUrlContainer.classList.toggle('hidden', !isCustomUrl);
        if (isCustomUrl && videoCustomUrl) videoCustomUrl.value = customUrlVal;
      }

      if (videoUnconnectedContainer && videoConnectedContainer) {
        videoUnconnectedContainer.classList.toggle('hidden', isVidConnected);
        videoConnectedContainer.classList.toggle('hidden', !isVidConnected);
      }

      if (isVidConnected) {
        if (videoConnectedProvName) videoConnectedProvName.textContent = vidObj.name;
        if (videoConnectedLatency) {
          videoConnectedLatency.classList.remove('hidden');
          videoConnectedLatency.className = 'text-[10px] px-2 py-0.5 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 font-mono font-medium shrink-0';
          if (!videoConnectedLatency.textContent || videoConnectedLatency.textContent.includes('Offline')) {
            videoConnectedLatency.textContent = 'Connected';
          }
        }
        if (videoConnectedKeyMasked) {
          if (isCustomUrl) {
            videoConnectedKeyMasked.textContent = customUrlVal || 'Custom Endpoint';
          } else if (savedVidKey) {
            const prefix = savedVidKey.slice(0, 4);
            const suffix = savedVidKey.slice(-4);
            videoConnectedKeyMasked.textContent = `${prefix}••••${suffix}`;
          } else {
            videoConnectedKeyMasked.textContent = '••••••••';
