  // Sessions & Branches Management
  function loadSessions() {
    try {
      const saved = localStorage.getItem(SESSIONS_INDEX_KEY);
      chatSessions = saved ? JSON.parse(saved) : [];
    } catch {
      chatSessions = [];
    }

    if (!chatSessions.some(s => s.id === 'session_default')) {
      chatSessions.unshift({
        id: 'session_default',
        title: 'Main Timeline',
        createdAt: new Date().toISOString(),
        updatedAt: new Date().toISOString(),
        messageCount: 0,
        lastMessage: ''
      });
      saveSessionsIndex();
    }

    // Verify currentSessionId exists
    if (!chatSessions.some(s => s.id === currentSessionId)) {
      currentSessionId = 'session_default';
    }

    renderSessionsDropdown();
  }

  function saveSessionsIndex() {
    localStorage.setItem(SESSIONS_INDEX_KEY, JSON.stringify(chatSessions));
  }

  function renderSessionsDropdown() {
    const listEl = document.getElementById('sessions-list');
    const labelEl = document.getElementById('active-session-label');
    const currentSes = chatSessions.find(s => s.id === currentSessionId);
    if (labelEl) {
      labelEl.textContent = currentSes ? currentSes.title : 'Main Branch';
    }

    if (!listEl) return;
    listEl.innerHTML = '';

    chatSessions.forEach(ses => {
      const isActive = ses.id === currentSessionId;
      const item = document.createElement('div');
      item.className = `p-2.5 rounded-xl border transition-all flex items-center justify-between gap-2.5 cursor-pointer ${
        isActive 
          ? 'bg-emerald-500/[0.12] border-emerald-500/40 text-white shadow-sm shadow-emerald-950/20' 
          : 'bg-black/20 hover:bg-white/[0.05] border-white/[0.06] text-slate-300'
      }`;

      const safeTitle = escapeHtml(ses.title || 'Untitled Branch');
      const safeSnippet = escapeHtml((ses.lastMessage || 'Fresh timeline').replace(/[\r\n]+/g, ' ').slice(0, 32));

      item.innerHTML = `
        <div class="flex-1 min-w-0 session-select-area" data-session-id="${ses.id}">
          <div class="flex items-center gap-1.5">
            <span class="font-medium text-xs truncate ${isActive ? 'text-emerald-300' : 'text-slate-200'}">${safeTitle}</span>
            ${isActive ? '<span class="text-[9px] px-1.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 font-mono font-medium shrink-0 border border-emerald-500/30">Active</span>' : ''}
          </div>
          <div class="flex items-center gap-1.5 text-[10px] text-slate-400 mt-0.5">
            <span>${ses.messageCount || 0} msgs</span>
            <span>•</span>
            <span class="truncate max-w-[130px] opacity-75">${safeSnippet}</span>
          </div>
        </div>
        <div class="flex items-center gap-1 shrink-0">
          <button type="button" class="rename-session-btn p-1.5 rounded-lg text-slate-400 hover:text-white hover:bg-white/[0.08] active:scale-95 transition cursor-pointer" data-session-id="${ses.id}" title="Rename branch">
            ${TOOLBAR_ICONS.edit}
          </button>
          ${ses.id !== 'session_default' ? `
            <button type="button" class="delete-session-btn p-1.5 rounded-lg text-slate-400 hover:text-rose-400 hover:bg-rose-500/10 active:scale-95 transition cursor-pointer" data-session-id="${ses.id}" title="Delete branch">
              ${TOOLBAR_ICONS.trash}
            </button>
          ` : ''}
        </div>
      `;

      item.querySelector('.session-select-area')?.addEventListener('click', () => {
        if (!isActive) switchSession(ses.id);
      });

      item.querySelector('.rename-session-btn')?.addEventListener('click', async (e) => {
        e.stopPropagation();
        const newTitle = await showPromptModal({
          title: 'Rename Story Branch',
          message: 'Choose a new title for this timeline:',
          defaultValue: ses.title,
          placeholder: 'Branch title...',
          confirmText: 'Save',
          cancelText: 'Cancel',
          icon: 'branch'
        });
        if (newTitle && newTitle.trim()) {
          ses.title = newTitle.trim();
          saveSessionsIndex();
          renderSessionsDropdown();
          showNotification('Branch renamed.', 'success');
        }
      });

      item.querySelector('.delete-session-btn')?.addEventListener('click', (e) => {
        e.stopPropagation();
        deleteSession(ses.id);
      });

      listEl.appendChild(item);
    });
  }

  function switchSession(sessionId) {
    saveChat();
    currentSessionId = sessionId;

    const url = new URL(window.location.href);
    url.searchParams.set('sessionId', sessionId);
    window.history.replaceState({}, '', url.toString());

    loadActiveSessionConversation();
    renderSessionsDropdown();
    document.getElementById('sessions-dropdown')?.classList.add('hidden');
    const ses = chatSessions.find(s => s.id === sessionId);
    showNotification(`Switched to branch: ${ses?.title || sessionId}`);
  }

  async function createNewSession() {
    const branchNum = chatSessions.length + 1;
    const defaultTitle = `Fresh Timeline #${branchNum}`;
    const title = await showPromptModal({
      title: 'New Story Timeline',
      message: 'Start a clean, fresh timeline from the beginning with this character:',
      defaultValue: defaultTitle,
      placeholder: 'Timeline name...',
      confirmText: 'Start Timeline',
      cancelText: 'Cancel',
      icon: 'branch'
    });
    if (!title || !title.trim()) return;

    const newId = 'session_' + Date.now();

    const newSes = {
      id: newId,
      title: title.trim(),
      createdAt: new Date().toISOString(),
      updatedAt: new Date().toISOString(),
      messageCount: 1,
      lastMessage: activeChar.greeting
    };

    chatSessions.push(newSes);
    saveSessionsIndex();

    const greetings = getCharacterGreetings();
    const initialGreeting = greetings[0];
    const initialConv = [{
      sender: 'character',
      text: initialGreeting,
      timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
      swipes: greetings,
      swipeIndex: 0
    }];
    localStorage.setItem(getSessionStorageKey(newId), JSON.stringify(initialConv));

    switchSession(newId);
  }

  async function branchFromMessage(msgIdx) {
    if (msgIdx < 0 || msgIdx >= conversation.length) return;
    const targetMsg = conversation[msgIdx];
    const preview = (targetMsg?.text || '').slice(0, 24).trim().replace(/[\r\n]+/g, ' ');
    const branchNum = chatSessions.length + 1;
    const defaultTitle = `Branch #${branchNum}${preview ? ` ("${preview}...")` : ` (Turn ${msgIdx + 1})`}`;

    const title = await showPromptModal({
      title: 'Branch Story from Here',
      message: `Create a new timeline branching from message #${msgIdx + 1}. All previous turns are preserved so you can explore an alternate path without affecting your current chat.`,
      defaultValue: defaultTitle,
      placeholder: 'Branch title...',
      confirmText: 'Create Branch',
      cancelText: 'Cancel',
      icon: 'branch'
    });

    if (!title || !title.trim()) return;

    // Slice history up to and including msgIdx
    const slicedConv = JSON.parse(JSON.stringify(conversation.slice(0, msgIdx + 1)));
    const newId = 'session_' + Date.now();

    const newSes = {
      id: newId,
      title: title.trim(),
      createdAt: new Date().toISOString(),
      updatedAt: new Date().toISOString(),
      messageCount: slicedConv.length,
      lastMessage: slicedConv[slicedConv.length - 1]?.text || ''
    };

    chatSessions.push(newSes);
    saveSessionsIndex();

    localStorage.setItem(getSessionStorageKey(newId), JSON.stringify(slicedConv));
    switchSession(newId);
    showNotification(`Branch created from message #${msgIdx + 1}!`, 'success');
  }

  async function deleteSession(sessionId) {
    if (sessionId === 'session_default') {
      await showAlertModal('The Main Timeline cannot be deleted.', 'Notice');
      return;
    }
    const confirmed = await showConfirmModal({
      title: 'Delete Story Branch?',
      message: 'This story branch and all its messages will be permanently deleted.',
      confirmText: 'Delete',
      cancelText: 'Cancel',
      type: 'danger'
    });
    if (!confirmed) return;

    localStorage.removeItem(getSessionStorageKey(sessionId));
    chatSessions = chatSessions.filter(s => s.id !== sessionId);
    saveSessionsIndex();

    if (currentSessionId === sessionId) {
      switchSession('session_default');
    } else {
      renderSessionsDropdown();
    }
    showNotification('Branch deleted.');
  }

  function loadActiveSessionConversation() {
    const key = getSessionStorageKey(currentSessionId);
    const saved = localStorage.getItem(key);
    if (saved) {
      try {
        conversation = JSON.parse(saved);
        conversation.forEach(m => {
          if (m.sender === 'character' && !m.swipes) {
            m.swipes = [m.text];
            m.swipeIndex = 0;
          }
        });
      } catch (e) {
        conversation = [];
      }
    } else {
      conversation = [];
    }

    const greetings = getCharacterGreetings();
    if (conversation.length === 0) {
      const initialGreeting = greetings[0];
      conversation.push({
        sender: 'character',
        text: initialGreeting,
        timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
        swipes: greetings,
        swipeIndex: 0
      });
      saveChat();
    } else if (conversation.length > 0 && conversation[0].sender === 'character') {
      if (greetings.length > 1) {
        const curSwipes = conversation[0].swipes || [conversation[0].text];
        let hasNew = false;
        greetings.forEach(g => {
          if (!curSwipes.includes(g)) {
            curSwipes.push(g);
            hasNew = true;
          }
        });
        conversation[0].swipes = curSwipes;
        if (hasNew) saveChat();
      }

      // Self-heal: If greeting message has empty dialogue (e.g. only thought process tags), restore valid scenario
      const c0 = conversation[0];
      const pureDialogue = (c0.text || '').replace(/<details[\s\S]*?<\/details>/gi, '').trim();
      if (!pureDialogue && c0.swipes && c0.swipes.length > 0) {
        const validGreeting = c0.swipes.find(s => s && s.replace(/<details[\s\S]*?<\/details>/gi, '').trim().length > 0) || greetings[0];
        c0.text = validGreeting;
        const vIdx = c0.swipes.indexOf(validGreeting);
        c0.swipeIndex = vIdx >= 0 ? vIdx : 0;
        saveChat();
      }
    }

    renderAllMessages();
  }

  // Cloud Sync System (Anti-Clear Cache Resilience)
  const cloudBadge = document.getElementById('chat-cloud-sync-badge');
  const cloudText = document.getElementById('chat-cloud-sync-text');

  function updateCloudBadge(status) {
    if (!cloudBadge || !cloudText) return;
    const token = localStorage.getItem('aetheria_auth_token');
    if (!token) {
      cloudBadge.classList.add('hidden');
      return;
    }

    cloudBadge.classList.remove('hidden');
    cloudBadge.classList.add('inline-flex');
    if (status) cloudText.textContent = status;
  }

  async function syncFromCloud() {
    const token = localStorage.getItem('aetheria_auth_token');
    if (!token) return;
    updateCloudBadge('Syncing...');

    try {
      const res = await fetch(`/api/chats/${activeChar.id}`, {
        headers: { 'Authorization': `Bearer ${token}` }
      });
      if (!res.ok) {
        updateCloudBadge('Cloud');
        return;
      }
      const data = await res.json();
      if (data.success && Array.isArray(data.messages) && data.messages.length > 0) {
        // If local conversation was wiped by clear-cache (<= 1 msg) but cloud has full story:
        if (conversation.length <= 1 && data.messages.length > 1) {
          conversation = data.messages.map(m => ({
            id: m.id,
            sender: m.role === 'user' ? 'user' : 'character',
            text: m.text,
            mediaType: m.media_type,
            mediaUrl: m.media_url,
            timestamp: new Date(m.created_at * 1000).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
            swipes: [m.text],
            swipeIndex: 0
          }));
          saveChat(false);
          renderAllMessages();
          updateCloudBadge('Restored');
          setTimeout(() => updateCloudBadge('Cloud'), 3000);
          return;
        }
      }
      updateCloudBadge('Cloud');
    } catch (e) {
      console.warn('Cloud sync from server failed:', e);
      updateCloudBadge('Offline');
    }
  }

  let cloudSyncTimeout = null;
  function syncToCloud() {
    const token = localStorage.getItem('aetheria_auth_token');
    if (!token) return;

    if (cloudSyncTimeout) clearTimeout(cloudSyncTimeout);
    cloudSyncTimeout = setTimeout(async () => {
      try {
        updateCloudBadge('Saving...');
        const payload = {
          characterId: activeChar.id,
          title: activeChar.name,
          messages: conversation.map(m => ({
            id: m.id || undefined,
            role: m.sender === 'user' ? 'user' : 'assistant',
            text: m.text,
            mediaType: m.mediaType,
            mediaUrl: m.mediaUrl,
            timestamp: Date.now()
          }))
        };

        const res = await fetch('/api/chats/sync', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${token}`
          },
          body: JSON.stringify(payload)
        });

        if (res.ok) {
          updateCloudBadge('Saved');
          setTimeout(() => updateCloudBadge('Cloud'), 2500);
        }
      } catch (e) {
        console.warn('Cloud sync to server failed:', e);
      }
    }, 1200);
  }

  // Init Chat Function
  function initChat() {
    loadSessions();
    loadActiveSessionConversation();
    loadEngineSettings();
    initPinnedNote();
    fetchDynamicSuggestions();
    syncFromCloud();
  }

  function saveChat(triggerCloud = true) {
    const key = getSessionStorageKey(currentSessionId);
    localStorage.setItem(key, JSON.stringify(conversation));

    // Update session metadata
    const activeSes = chatSessions.find(s => s.id === currentSessionId);
    if (activeSes) {
      activeSes.messageCount = conversation.length;
      activeSes.updatedAt = new Date().toISOString();
      const lastMsg = conversation[conversation.length - 1];
      activeSes.lastMessage = lastMsg ? (lastMsg.text || '').slice(0, 100) : '';
      saveSessionsIndex();
    }

    if (triggerCloud) {
      syncToCloud();
    }
  }

  function renderAllMessages() {
    if (!chatStream) return;
    chatStream.innerHTML = '';
    conversation.forEach((msg, idx) => {
      appendMessageToDOM(msg, idx);
    });
    chatStream.scrollTop = chatStream.scrollHeight;
  }

