              </button>

              <div class="flex items-center gap-2 w-full sm:w-auto justify-end">
                <button 
                  type="button" 
                  id="cancel-engine-modal"
                  class="px-4 py-2 rounded-xl bg-white/[0.05] hover:bg-white/[0.1] text-slate-300 text-xs font-medium transition cursor-pointer"
                >
                  Cancel
                </button>
                <button 
                  type="button" 
                  id="save-engine-settings-btn"
                  class="px-5 py-2 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white text-xs font-bold shadow-lg shadow-purple-900/50 hover:shadow-purple-600/50 transition cursor-pointer active:scale-95 flex items-center gap-1.5"
                >
                  <Check class="w-4 h-4" />
                  <span>Save Engine Settings</span>
                </button>
              </div>
            </div>

          </div>
        </div>

        <!-- World Info & Lorebook Engine Modal (Part 4) -->
        <div 
          id="lorebook-modal" 
          class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-3 sm:p-6 transition-all duration-300"
        >
          <div class="w-full max-w-3xl max-h-[92vh] bg-[#0c0f22] border border-cyan-500/30 rounded-3xl shadow-2xl shadow-cyan-950/80 flex flex-col overflow-hidden animate-in fade-in zoom-in-95 duration-200">
            
            <!-- Modal Header -->
            <div class="p-4 sm:p-5 border-b border-white/[0.08] bg-[#090c1b] flex items-center justify-between shrink-0">
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-2xl bg-gradient-to-br from-cyan-600 to-indigo-600 flex items-center justify-center text-white shadow-lg shadow-cyan-900/50">
                  <BookOpen class="w-5 h-5" />
                </div>
                <div>
                  <h3 class="text-sm sm:text-base font-bold text-white flex items-center gap-2">
                    <span>World Info & Lorebook Engine</span>
                    <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">V2 Standard</span>
                  </h3>
                  <p class="text-[11px] text-slate-400">Manage contextual world knowledge, faction lore, and keyword triggers.</p>
                </div>
              </div>

              <button 
                type="button" 
                id="close-lorebook-modal"
                class="p-2 rounded-xl text-slate-400 hover:text-white hover:bg-white/[0.06] transition cursor-pointer"
              >
                ✕
              </button>
            </div>

            <!-- Modal Scope & Actions Bar -->
            <div class="px-5 py-3 bg-[#080b18] border-b border-white/[0.06] flex flex-wrap items-center justify-between gap-3 shrink-0">
              <div class="flex items-center gap-1.5 p-1 rounded-xl bg-white/[0.04] border border-white/[0.06]">
                <button 
                  type="button" 
                  id="scope-char-lore-btn"
                  class="px-3 py-1 rounded-lg text-xs font-semibold bg-cyan-600 text-white transition cursor-pointer"
                >
                  Character Lore
                </button>
                <button 
                  type="button" 
                  id="scope-global-lore-btn"
                  class="px-3 py-1 rounded-lg text-xs font-semibold text-slate-400 hover:text-white transition cursor-pointer"
                >
                  Global World Lore
                </button>
              </div>

              <div class="flex items-center gap-2">
                <button 
                  type="button" 
                  id="add-lore-entry-btn"
                  class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-cyan-500/20 hover:bg-cyan-500/30 border border-cyan-500/40 text-cyan-300 text-xs font-bold transition active:scale-95 cursor-pointer shadow-sm"
                >
                  <Plus class="w-3.5 h-3.5" />
                  <span>+ New Entry</span>
                </button>

                <button 
                  type="button" 
                  id="export-lorebook-btn"
                  class="p-1.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] text-slate-300 hover:text-white transition cursor-pointer"
                  title="Export Lorebook (JSON)"
                >
                  <Download class="w-4 h-4 text-slate-400" />
                </button>

                <label 
                  class="p-1.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] text-slate-300 hover:text-white transition cursor-pointer"
                  title="Import Lorebook (JSON / Tavern V2)"
                >
                  <Upload class="w-4 h-4 text-slate-400" />
                  <input id="import-lorebook-input" type="file" accept=".json" class="hidden" />
                </label>
              </div>
            </div>

            <!-- Modal Body (List & Form) -->
            <div class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-4">
              
              <!-- Inline Entry Editor Form (Hidden by default) -->
              <div id="lore-editor-form" class="hidden p-4 rounded-2xl bg-[#090d1f] border border-cyan-500/30 space-y-4 animate-in fade-in duration-200">
                <div class="flex items-center justify-between pb-2 border-b border-white/[0.06]">
                  <h4 id="lore-form-title" class="text-xs sm:text-sm font-bold text-white flex items-center gap-2">
                    <Tag class="w-4 h-4 text-cyan-400" />
                    <span>Create Lorebook Entry</span>
                  </h4>
                  <button type="button" id="cancel-lore-entry-btn" class="text-xs text-slate-400 hover:text-white">Cancel</button>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                  <div>
                    <label class="block text-[11px] font-semibold text-slate-300 mb-1">Entry Name / Title</label>
                    <input 
                      id="lore-input-name" 
                      type="text" 
                      placeholder="e.g. Neo-Kyoto Black Market, Sunforge Vow"
                      class="w-full px-3 py-2 rounded-xl bg-white/[0.05] border border-white/10 text-xs text-white placeholder:text-slate-500 outline-none focus:border-cyan-500/50"
                    />
                  </div>

                  <div>
                    <label class="block text-[11px] font-semibold text-slate-300 mb-1">Primary Trigger Keys (comma-separated)</label>
                    <input 
                      id="lore-input-keys" 
                      type="text" 
                      placeholder="e.g. black market, cyberdeck, megacorp"
                      class="w-full px-3 py-2 rounded-xl bg-white/[0.05] border border-white/10 text-xs text-white placeholder:text-slate-500 outline-none focus:border-cyan-500/50"
                    />
                  </div>
                </div>

                <div>
                  <label class="block text-[11px] font-semibold text-slate-300 mb-1">Selective / Secondary Keys (Optional)</label>
                  <input 
                    id="lore-input-second-keys" 
                    type="text" 
                    placeholder="Require at least one of these along with primary key"
                    class="w-full px-3 py-2 rounded-xl bg-white/[0.05] border border-white/10 text-xs text-white placeholder:text-slate-500 outline-none focus:border-cyan-500/50"
                  />
                </div>

                <div>
                  <label class="block text-[11px] font-semibold text-slate-300 mb-1">Lore & Knowledge Content (Injected into Prompt)</label>
                  <textarea 
                    id="lore-input-content" 
                    rows="3"
                    placeholder="Describe the secret lore, world history, faction details, or rules..."
                    class="w-full p-3 rounded-xl bg-white/[0.05] border border-white/10 text-xs text-white placeholder:text-slate-500 outline-none focus:border-cyan-500/50 resize-y"
                  ></textarea>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-1">
                  <div>
                    <label class="block text-[11px] font-semibold text-slate-300 mb-1">Insertion Position</label>
                    <select id="lore-input-position" class="w-full px-3 py-2 rounded-xl bg-white/[0.05] border border-white/10 text-xs text-white outline-none">
                      <option value="after_char">After Character (Contextual)</option>
                      <option value="before_char">Before Character (Global)</option>
                    </select>
                  </div>

                  <div>
                    <label class="block text-[11px] font-semibold text-slate-300 mb-1">Priority / Insertion Order</label>
                    <input id="lore-input-order" type="number" value="100" class="w-full px-3 py-2 rounded-xl bg-white/[0.05] border border-white/10 text-xs text-white outline-none" />
                  </div>

                  <div class="flex items-center gap-3 pt-4">
                    <label class="flex items-center gap-2 cursor-pointer">
                      <input id="lore-input-constant" type="checkbox" class="w-4 h-4 accent-cyan-500 cursor-pointer" />
                      <span class="text-xs text-slate-300">Always Active (Constant)</span>
                    </label>
                  </div>
                </div>

                <div class="flex items-center justify-end gap-2 pt-2 border-t border-white/[0.06]">
                  <button type="button" id="save-lore-entry-btn" class="px-4 py-2 rounded-xl bg-cyan-600 hover:bg-cyan-500 text-white text-xs font-bold transition shadow-sm cursor-pointer">
                    Save Lore Entry
                  </button>
                </div>
              </div>

              <!-- Entries Container -->
              <div id="lore-entries-list" class="space-y-3">
                <!-- Dynamically rendered -->
              </div>

              <!-- Empty state -->
              <div id="lore-empty-state" class="hidden text-center py-10 px-4 rounded-2xl bg-white/[0.02] border border-white/[0.05] space-y-2">
                <BookOpen class="w-8 h-8 text-cyan-400/50 mx-auto" />
                <h5 class="text-xs font-bold text-white">No Lore Entries Found</h5>
                <p class="text-[11px] text-slate-400 max-w-sm mx-auto">Click "+ New Entry" above or import a Tavern/Chub JSON lorebook to inject world knowledge into this roleplay.</p>
              </div>

            </div>

          </div>
        </div>

        <!-- Chat Messages Scroll Stream -->
        <div 
          id="chat-stream" 
          class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-4 sm:space-y-5"
        >
          <!-- Messages will be populated dynamically from localStorage or greeting -->
        </div>

        <!-- Character Typing Indicator -->
        <div 
          id="full-typing-indicator" 
          class="hidden px-4 sm:px-6 py-2 flex items-center gap-3 animate-pulse"
        >
          <img 
            id="chat-typing-avatar"
            src={character.avatarUrl} 
            alt={character.name} 
            class="w-7 h-7 rounded-full object-cover ring-1 ring-purple-500/40" 
          />
          <div class="px-3.5 py-2 rounded-2xl rounded-tl-sm bg-white/[0.04] border border-white/[0.08] flex items-center gap-1.5 text-xs text-slate-400">
            <span class="w-1.5 h-1.5 rounded-full bg-purple-400 animate-bounce"></span>
            <span class="w-1.5 h-1.5 rounded-full bg-purple-400 animate-bounce [animation-delay:0.2s]"></span>
            <span class="w-1.5 h-1.5 rounded-full bg-purple-400 animate-bounce [animation-delay:0.4s]"></span>
            <span id="chat-typing-name" class="text-[11px] ml-1 text-slate-400">{character.name} is thinking...</span>
          </div>
        </div>

        <!-- Quick Starter Prompts Row -->
        {character.starterPrompts && character.starterPrompts.length > 0 && (
          <div class="px-4 sm:px-6 py-2 flex items-center gap-2 overflow-x-auto no-scrollbar shrink-0">
            <span class="text-[10px] uppercase font-bold text-slate-500 tracking-wider shrink-0 flex items-center gap-1">
              <Sparkles class="w-3 h-3 text-purple-400" />
              <span>Prompt:</span>
            </span>
            {character.starterPrompts.map((prompt) => (
              <button 
                type="button"
                class="room-starter-pill shrink-0 px-3 py-1.5 rounded-xl bg-white/[0.04] hover:bg-purple-900/30 hover:border-purple-500/40 border border-white/[0.08] text-xs text-slate-300 hover:text-white transition duration-200 cursor-pointer active:scale-95"
                data-prompt={prompt}
              >
                "{prompt}"
              </button>
            ))}
          </div>
        )}

        <!-- In-Chat Multi-Modal & Action Toolbar (Part 2) -->
        <div class="px-3 sm:px-6 py-2 bg-[#070913]/90 border-t border-white/[0.06] flex items-center justify-between gap-2 overflow-x-auto no-scrollbar shrink-0">
          <div class="flex items-center gap-2">
            <!-- 1. Request Selfie Photo -->
            <button 
              type="button" 
              id="chat-action-selfie-btn"
              class="px-2.5 py-1.5 rounded-xl bg-purple-500/10 hover:bg-purple-500/20 border border-purple-500/30 text-purple-300 hover:text-white text-xs font-medium flex items-center gap-1.5 transition active:scale-95 cursor-pointer shadow-sm"
              title="Request a contextual selfie photo from character"
            >
              <Camera class="w-3.5 h-3.5 text-purple-400" />
              <span>Send Selfie 📷</span>
            </button>

            <!-- 2. Request Living Video (BYOK Protected) -->
            <button 
              type="button" 
              id="chat-action-video-btn"
              class="px-2.5 py-1.5 rounded-xl bg-pink-500/10 hover:bg-pink-500/20 border border-pink-500/30 text-pink-300 hover:text-white text-xs font-medium flex items-center gap-1.5 transition active:scale-95 cursor-pointer shadow-sm group"
              title="Generate a dynamic cinematic living video (Requires Fal.ai / Luma API Key)"
            >
              <Film class="w-3.5 h-3.5 text-pink-400 group-hover:animate-pulse" />
              <span>Living Video 🎬</span>
              <span class="text-[9px] px-1 py-0.2 rounded bg-pink-500/30 text-pink-200 border border-pink-400/40 font-mono">BYOK</span>
            </button>
          </div>

          <div class="flex items-center gap-2">
            <!-- 3. Regenerate / Swipe Last Reply -->
            <button 
              type="button" 
              id="chat-action-regenerate-btn"
              class="px-2.5 py-1.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] text-slate-300 hover:text-white text-xs font-medium flex items-center gap-1.5 transition active:scale-95 cursor-pointer"
              title="Regenerate alternative response for last character message"
            >
              <RefreshCw class="w-3 h-3 text-cyan-400" />
              <span class="hidden sm:inline">Regenerate</span>
            </button>

            <!-- 4. Rewind Last Turn -->
            <button 
              type="button" 
              id="chat-action-rewind-btn"
              class="px-2.5 py-1.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] text-slate-300 hover:text-amber-300 text-xs font-medium flex items-center gap-1.5 transition active:scale-95 cursor-pointer"
              title="Rewind last turn (restore your prompt to input box)"
            >
              <RotateCcw class="w-3 h-3 text-amber-400" />
              <span class="hidden sm:inline">Rewind</span>
            </button>
          </div>
        </div>

        <!-- Bottom Chat Input Bar -->
        <div class="p-3 sm:p-5 border-t border-white/[0.08] bg-[#080a15]/95 backdrop-blur-xl shrink-0">
          <form id="room-input-form" class="max-w-4xl mx-auto flex items-end gap-2 sm:gap-3">
            <div class="flex-1 relative rounded-2xl bg-white/[0.04] hover:bg-white/[0.06] focus-within:bg-[#0c0f1e] border border-white/[0.1] focus-within:border-purple-500/60 transition shadow-inner">
              <textarea 
                id="room-input" 
                rows="1" 
                placeholder={`Type a message to ${character.name}... (Press Enter to send, Shift+Enter for newline)`}
                class="w-full px-4 py-3 bg-transparent text-sm text-white placeholder:text-slate-500 outline-none resize-none max-h-32 leading-relaxed"
              ></textarea>
            </div>

            <!-- Send Button -->
            <button 
              type="submit" 
              id="room-send-btn"
              class="h-11 px-4 sm:px-5 rounded-2xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-semibold flex items-center justify-center gap-2 shadow-lg shadow-purple-900/40 hover:shadow-purple-600/50 transition-all duration-200 cursor-pointer active:scale-95 shrink-0"
              title="Send Message"
            >
              <Send class="w-4 h-4" />
              <span class="hidden sm:inline text-xs">Send</span>
            </button>
          </form>

          <div class="max-w-4xl mx-auto flex items-center justify-between text-[10px] text-slate-500 mt-2 px-1">
            <span class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              <span id="active-privacy-tag">Client-side encrypted memory • Zero server logging</span>
            </span>
            <span id="active-scenario-tag" class="hidden sm:inline text-purple-400/80 font-mono">
              Scenario: Default Encounter
            </span>
          </div>
        </div>

      </section>
    </div>
  </div>
</Layout>

<script define:vars={{ character }}>
  // Client-side state & logic
  let activeChar = { ...character };
  let activeUserPersona = {
    name: 'Traveler',
    pronouns: 'They/Them',
    title: 'Explorer',
    avatar: '',
    bio: '',
    globalNotes: 'Never speak, narrate, or assume actions for {{user}}. Maintain atmospheric immersion.'
  };

  // 1. Resolve User Persona from localStorage
  try {
    const rawPersona = localStorage.getItem('aetheria_user_persona');
    if (rawPersona) {
      activeUserPersona = { ...activeUserPersona, ...JSON.parse(rawPersona) };
    }
  } catch {}

  // 2. Resolve Custom Character if URL is /chat/custom or has ?id=
  const urlParams = new URLSearchParams(window.location.search);
  const customId = urlParams.get('id');
  const isCustomRoute = character.id === 'custom' || window.location.pathname.includes('/chat/custom');

  if (isCustomRoute) {
    try {
      const customList = JSON.parse(localStorage.getItem('aetheria_custom_characters') || '[]');
      let matched = null;
      if (customId) {
        matched = customList.find(c => c.id === customId);
      }
      if (!matched && customList.length > 0) {
        matched = customList[customList.length - 1]; // latest created custom character
      }
      if (matched) {
        activeChar = {
          ...activeChar,
          ...matched,
          avatarUrl: matched.avatarUrl || activeChar.avatarUrl,
          greeting: matched.greeting || activeChar.greeting,
          fallbackReplies: (matched.alternateGreetings && matched.alternateGreetings.length > 0) ? matched.alternateGreetings : activeChar.fallbackReplies,
          starterPrompts: (matched.starterPrompts && matched.starterPrompts.length > 0) ? matched.starterPrompts : activeChar.starterPrompts,
        };
      }
    } catch {}
  }

  // Macro replacement helper for {{user}} and {{char}}
  function formatMacroText(str) {
    if (!str) return '';
    return str
      .replace(/\{\{user\}\}/gi, activeUserPersona.name || 'Traveler')
      .replace(/\{\{char\}\}/gi, activeChar.name || 'Character');
  }

  // Update DOM elements for custom character if resolved
  if (isCustomRoute && activeChar.name !== 'Custom Persona') {
    document.title = `${activeChar.name} — Immersive Roleplay Chat | Aetheria AI`;
    const hName = document.getElementById('chat-header-name');
    if (hName) hName.textContent = activeChar.name;
    const hTitle = document.getElementById('chat-header-title');
    if (hTitle) hTitle.textContent = activeChar.title;
    const hAvatar = document.getElementById('chat-header-avatar');
    if (hAvatar) hAvatar.src = activeChar.avatarUrl;

    const sAvatar = document.getElementById('chat-sidebar-avatar');
    if (sAvatar) sAvatar.src = activeChar.avatarUrl;
    const sCat = document.getElementById('chat-sidebar-category');
    if (sCat) sCat.textContent = activeChar.category || 'Custom';
    const sDesc = document.getElementById('chat-sidebar-desc');
    if (sDesc) sDesc.textContent = formatMacroText(activeChar.description || '');

    const tAvatar = document.getElementById('chat-typing-avatar');
    if (tAvatar) tAvatar.src = activeChar.avatarUrl;
    const tName = document.getElementById('chat-typing-name');
    if (tName) tName.textContent = `${activeChar.name} is thinking...`;

    const rInput = document.getElementById('room-input');
    if (rInput) rInput.placeholder = `Type a message to ${activeChar.name}... (Press Enter to send, Shift+Enter for newline)`;
  }

  let conversation = [];
  let ttsEnabled = true;

  // Multi-session & Branching state
  const SESSIONS_INDEX_KEY = `aetheria_chat_sessions_${activeChar.id}`;
  let currentSessionId = 'session_default';
  let chatSessions = [];

  // Parse sessionId from URL if present (?sessionId=...)
  const urlParams = new URLSearchParams(window.location.search);
  if (urlParams.get('sessionId')) {
    currentSessionId = urlParams.get('sessionId');
  }

  function getSessionStorageKey(sessionId) {
    return sessionId === 'session_default' 
      ? `aetheria_chat_${activeChar.id}` 
      : `aetheria_chat_${activeChar.id}_${sessionId}`;
  }

  // DOM Elements
  const chatStream = document.getElementById('chat-stream');
  const typingIndicator = document.getElementById('full-typing-indicator');
  const inputForm = document.getElementById('room-input-form');
  const input = document.getElementById('room-input');
  const toggleSidebarBtn = document.getElementById('toggle-sidebar-btn');
  const sidebar = document.getElementById('character-sidebar');
  const clearChatBtn = document.getElementById('clear-chat-btn');
  const exportChatBtn = document.getElementById('export-chat-btn');
  const toggleTtsBtn = document.getElementById('toggle-tts-btn');
  const ttsIconOn = document.getElementById('tts-icon-on');
  const ttsIconOff = document.getElementById('tts-icon-off');
  const starterPills = document.querySelectorAll('.room-starter-pill');
  
  // Multi-Modal Suite Modal elements
  const byokBtn = document.getElementById('chat-byok-btn');
  const byokTray = document.getElementById('chat-byok-tray');
  const closeByok = document.getElementById('close-chat-byok');
  const cancelByok = document.getElementById('cancel-engine-modal');
  const saveEngineBtn = document.getElementById('save-engine-settings-btn');
  const resetDefaultsBtn = document.getElementById('reset-engine-defaults-btn');
  const engineLabel = document.getElementById('chat-engine-label');

  // Tabs
  const engineTabBtns = document.querySelectorAll('.engine-tab-btn');
  const engineTabPanes = document.querySelectorAll('.engine-tab-pane');

  // Text inputs
  const textProviderSelect = document.getElementById('text-provider-select');
  const textApiKey = document.getElementById('text-api-key');
  const textBaseUrl = document.getElementById('text-base-url');
  const customBaseUrlContainer = document.getElementById('custom-base-url-container');
  const textModelInput = document.getElementById('text-model-input');
  const toggleKeyVisibility = document.getElementById('toggle-key-visibility');
  const pingTextBtn = document.getElementById('ping-text-btn');
  const pingStatusMsg = document.getElementById('ping-status-msg');

  // Text Sliders & Badges
  const sliderTemp = document.getElementById('slider-temp');
  const badgeTemp = document.getElementById('badge-temp');
  const sliderTokens = document.getElementById('slider-tokens');
  const badgeTokens = document.getElementById('badge-tokens');
  const sliderTopP = document.getElementById('slider-top-p');
  const badgeTopP = document.getElementById('badge-top-p');
  const sliderRepPen = document.getElementById('slider-rep-pen');
  const badgeRepPen = document.getElementById('badge-rep-pen');
  const sliderFreqPen = document.getElementById('slider-freq-pen');
  const badgeFreqPen = document.getElementById('badge-freq-pen');
  const sliderPresPen = document.getElementById('slider-pres-pen');
  const badgePresPen = document.getElementById('badge-pres-pen');
  const sliderContext = document.getElementById('slider-context');
  const badgeContext = document.getElementById('badge-context');
  const toggleStreaming = document.getElementById('toggle-streaming');

  // Voice Inputs
  const voiceProviderSelect = document.getElementById('voice-provider-select');
  const voiceApiKey = document.getElementById('voice-api-key');
  const voiceKeyContainer = document.getElementById('voice-key-container');
  const voiceIdInput = document.getElementById('voice-id-input');
  const elevenVoiceContainer = document.getElementById('eleven-voice-container');
  const openaiVoiceContainer = document.getElementById('openai-voice-container');
  const openaiVoiceSelect = document.getElementById('openai-voice-select');
  const sliderStability = document.getElementById('slider-stability');
  const badgeStability = document.getElementById('badge-stability');
  const sliderClarity = document.getElementById('slider-clarity');
  const badgeClarity = document.getElementById('badge-clarity');
  const sliderVoiceRate = document.getElementById('slider-voice-rate');
  const badgeVoiceRate = document.getElementById('badge-voice-rate');
  const sliderVoicePitch = document.getElementById('slider-voice-pitch');
  const badgeVoicePitch = document.getElementById('badge-voice-pitch');
  const toggleFilterNarration = document.getElementById('toggle-filter-narration');
  const toggleAutoplayVoice = document.getElementById('toggle-autoplay-voice');
  const testVoiceBtn = document.getElementById('test-voice-btn');

  // Image Inputs
