  function getModalIconSvg(icon, type) {
    if (typeof icon === 'string' && icon.startsWith('<svg')) return icon;
    if (icon === 'rewind' || icon === '↩️' || icon === '⏪') return MODAL_SVGS.rewind;
    if (icon === 'settings' || icon === '⚙️') return MODAL_SVGS.settings;
    if (icon === 'danger' || icon === '🗑️' || type === 'danger') return MODAL_SVGS.danger;
    if (icon === 'warning' || icon === '⚠️' || type === 'warning') return MODAL_SVGS.warning;
    if (icon === 'info' || icon === 'ℹ️' || type === 'info') return MODAL_SVGS.info;
    return MODAL_SVGS.sparkle;
  }

  // Google Gemini / Material 3 Style Confirmation Dialog Modal
  function showConfirmModal({
    title = 'Confirm Action',
    message = 'Are you sure you want to proceed?',
    confirmText = 'Confirm',
    cancelText = 'Cancel',
    type = 'default', // 'danger' | 'warning' | 'info' | 'default'
    icon = ''
  } = {}) {
    return new Promise((resolve) => {
      const isDanger = type === 'danger';
      const isWarning = type === 'warning' || icon === 'rewind' || icon === '↩️' || icon === '⏪';
      const isInfo = type === 'info';
      const iconSvg = getModalIconSvg(icon, type);

      const backdrop = document.createElement('div');
      backdrop.className = 'fixed inset-0 z-[10000] flex items-center justify-center p-4 bg-black/65 backdrop-blur-md transition-opacity duration-200 opacity-0';
      
      const modal = document.createElement('div');
      modal.className = 'w-full max-w-[420px] rounded-[28px] bg-[#1e1f24] border border-white/[0.08] p-6 shadow-2xl shadow-black/90 transform scale-95 opacity-0 transition-all duration-200 ease-out text-left select-none';

      const iconBadgeClass = isDanger
        ? 'bg-rose-500/15 text-rose-400'
        : isWarning
        ? 'bg-amber-500/15 text-amber-300'
        : isInfo
        ? 'bg-sky-500/15 text-sky-400'
        : 'bg-purple-500/15 text-purple-300';

      const cancelBtnHtml = cancelText ? `
        <button id="modal-btn-cancel" type="button" class="h-10 px-5 rounded-full text-xs sm:text-sm font-medium text-slate-300 hover:text-white hover:bg-white/[0.08] active:scale-95 transition-all text-center cursor-pointer">
          ${escapeHtml(cancelText)}
        </button>
      ` : '';

      const confirmBtnClass = isDanger
        ? 'bg-rose-600 hover:bg-rose-500 text-white font-medium shadow-md shadow-rose-950/40'
        : isWarning
        ? 'bg-amber-400 hover:bg-amber-300 text-slate-950 font-semibold shadow-md shadow-amber-950/30'
        : isInfo
        ? 'bg-white hover:bg-slate-200 text-slate-950 font-medium'
        : 'bg-purple-600 hover:bg-purple-500 text-white font-medium shadow-md shadow-purple-950/40';

      const cleanConfirmText = confirmText.replace(/^[\p{Emoji}\s]+/u, '').trim() || confirmText;

      const buttonsHtml = `
        <div class="mt-6 flex items-center justify-end gap-2.5">
          ${cancelBtnHtml}
          <button id="modal-btn-confirm" type="button" class="h-10 px-6 rounded-full text-xs sm:text-sm font-medium transition-all active:scale-95 text-center cursor-pointer flex items-center justify-center gap-1.5 ${confirmBtnClass}">
            ${escapeHtml(cleanConfirmText)}
          </button>
        </div>
      `;

      modal.innerHTML = `
        <div class="flex items-center gap-3.5 mb-2.5">
          <div class="w-10 h-10 rounded-full flex items-center justify-center shrink-0 ${iconBadgeClass}">
            ${iconSvg}
          </div>
          <h3 class="text-lg sm:text-xl font-medium text-slate-100 tracking-tight leading-snug">${escapeHtml(title)}</h3>
        </div>
        <p class="text-sm text-slate-400 leading-relaxed font-normal">${escapeHtml(message)}</p>
        ${buttonsHtml}
      `;

      backdrop.appendChild(modal);
      document.body.appendChild(backdrop);

      requestAnimationFrame(() => {
        backdrop.classList.remove('opacity-0');
        modal.classList.remove('scale-95', 'opacity-0');
      });

      const cleanup = (confirmed) => {
        backdrop.classList.add('opacity-0');
        modal.classList.add('scale-95', 'opacity-0');
        setTimeout(() => backdrop.remove(), 200);
        window.removeEventListener('keydown', onKeyDown);
        resolve(confirmed);
      };

      const confirmBtn = modal.querySelector('#modal-btn-confirm');
      const cancelBtn = modal.querySelector('#modal-btn-cancel');
      if (confirmBtn) confirmBtn.onclick = () => cleanup(true);
      if (cancelBtn) cancelBtn.onclick = () => cleanup(false);
      backdrop.onclick = (e) => {
        if (e.target === backdrop) cleanup(false);
      };

      const onKeyDown = (e) => {
        if (e.key === 'Escape') {
          cleanup(false);
        } else if (e.key === 'Enter') {
          cleanup(true);
        }
      };
      window.addEventListener('keydown', onKeyDown);
    });
  }

  function showAlertModal(message, title = 'System Notice', icon = 'ℹ️') {
    return showConfirmModal({
      title,
      message,
      confirmText: 'Got It',
      cancelText: '',
      type: 'info',
      icon
    });
  }

