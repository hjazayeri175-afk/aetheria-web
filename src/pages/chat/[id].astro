  // Dynamic API Syncing Function
  async function syncVoicesForProvider(prov, isManual = false) {
    if (prov === 'browser') {
      renderDynamicVoiceCatalog(voiceSearchInput?.value || '');
      if (isManual) showNotification('✓ System voices refreshed.');
      return;
    }

    const key = getVoiceKeyForProvider(prov);
    if (!key && prov !== 'browser') {
      if (isManual) {
        showNotification(`⚠️ Please enter your ${prov.toUpperCase()} API key first.`, 'warning');
        voiceApiKey?.focus();
      }
      renderDynamicVoiceCatalog(voiceSearchInput?.value || '');
      return;
    }

    if (syncVoicesIcon) syncVoicesIcon.classList.add('animate-spin');
    if (voiceSyncStatusText) voiceSyncStatusText.textContent = `Syncing voices from ${prov.toUpperCase()}...`;

    try {
      if (prov === 'elevenlabs') {
        let voicesData = null;
        try {
          const res = await fetch('https://api.elevenlabs.io/v1/voices', {
            method: 'GET',
            headers: { 'xi-api-key': key, 'Accept': 'application/json' }
          });
          if (res.ok) {
            voicesData = await res.json();
          }
        } catch (corsErr) {}

        if (!voicesData) {
          const proxyRes = await fetch(`/api/proxy/fetch-models?targetUrl=${encodeURIComponent('https://api.elevenlabs.io/v1/voices')}&apiKey=${encodeURIComponent(key)}`);
          if (proxyRes.ok) {
            voicesData = await proxyRes.json();
          }
        }

        if (voicesData && Array.isArray(voicesData.voices)) {
          const mapped = voicesData.voices.map(v => ({
            id: v.voice_id,
            name: v.name,
            gender: (v.labels && v.labels.gender) ? (v.labels.gender.charAt(0).toUpperCase() + v.labels.gender.slice(1)) : 'Natural',
            accent: (v.labels && v.labels.accent) ? v.labels.accent : '',
            style: (v.labels && v.labels.description) ? v.labels.description : (v.category === 'cloned' ? 'Custom Cloned Voice' : 'Studio Voice'),
            category: v.category === 'cloned' ? 'Cloned' : v.category === 'generated' ? 'Generated' : 'Library',
            preview_url: v.preview_url || ''
          }));
          localStorage.setItem('aetheria_cached_voices_elevenlabs', JSON.stringify(mapped));
          renderDynamicVoiceCatalog(voiceSearchInput?.value || '');
          if (voiceSyncStatusText) voiceSyncStatusText.textContent = `Synced ${mapped.length} live voices from ElevenLabs`;
          if (isManual) showNotification(`✓ Synced ${mapped.length} live ElevenLabs voices!`);
          return;
        } else {
          throw new Error('Could not fetch ElevenLabs voices list');
        }
      }

      if (prov === 'openai') {
        renderDynamicVoiceCatalog(voiceSearchInput?.value || '');
        if (voiceSyncStatusText) voiceSyncStatusText.textContent = 'OpenAI Audio voice models active';
        if (isManual) showNotification('✓ OpenAI Audio voices synced.');
      }

      if (prov === 'google') {
        try {
          const res = await fetch(`/api/proxy/fetch-models?targetUrl=${encodeURIComponent('https://texttospeech.googleapis.com/v1/voices')}&apiKey=${encodeURIComponent(key)}`);
          if (res.ok) {
            const data = await res.json();
            if (data && Array.isArray(data.voices)) {
              const filtered = data.voices.filter(v => 
                v.name.includes('Journey') || 
                v.name.includes('Neural2') || 
                v.name.includes('Studio') || 
                v.name.startsWith('fa-') || 
                v.languageCodes?.includes('fa-IR') ||
                v.name.includes('en-US')
              ).slice(0, 30).map(v => ({
                id: v.name,
                name: v.name.replace(/^[a-z]{2}-[A-Z]{2}-/, ''),
                gender: v.ssmlGender === 'FEMALE' ? 'Female' : v.ssmlGender === 'MALE' ? 'Male' : 'Natural',
                accent: v.languageCodes ? v.languageCodes[0] : 'en-US',
                style: v.name.includes('Journey') ? 'Ultra Natural Journey' : v.name.includes('Neural2') ? 'Neural2 Studio' : 'Google Neural'
              }));
              if (filtered.length > 0) {
                localStorage.setItem('aetheria_cached_voices_google', JSON.stringify(filtered));
                renderDynamicVoiceCatalog(voiceSearchInput?.value || '');
                if (voiceSyncStatusText) voiceSyncStatusText.textContent = `Synced ${filtered.length} Google Cloud voices`;
                if (isManual) showNotification(`✓ Synced ${filtered.length} Google voices!`);
                return;
              }
            }
          }
        } catch (gErr) {}
        renderDynamicVoiceCatalog(voiceSearchInput?.value || '');
      }

    } catch (err) {
      console.warn('Voice sync error:', err);
      if (isManual) showNotification(`⚠️ Voice sync: ${err.message || 'Check key and connection'}`, 'warning');
      renderDynamicVoiceCatalog(voiceSearchInput?.value || '');
    } finally {
      if (syncVoicesIcon) syncVoicesIcon.classList.remove('animate-spin');
    }
  }

  syncVoicesBtn?.addEventListener('click', () => {
    const prov = voiceProviderSelect?.value || 'browser';
    syncVoicesForProvider(prov, true);
