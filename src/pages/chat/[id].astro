  let activeAudio = null;
  let currentSpeakingIdx = null;

  function stopSpeaking() {
    if (activeAudio) {
      try {
        activeAudio.pause();
        activeAudio.currentTime = 0;
      } catch (e) {}
      activeAudio = null;
    }
    if (window.speechSynthesis) {
      try {
        window.speechSynthesis.cancel();
      } catch (e) {}
    }
    currentSpeakingIdx = null;
    document.querySelectorAll('.msg-speak-btn').forEach(btn => {
      btn.innerHTML = TOOLBAR_ICONS.speaker;
      btn.title = "Listen (Read aloud)";
      btn.classList.remove('text-purple-400', 'text-rose-400', 'bg-purple-500/10');
      btn.classList.add('text-slate-400');
    });
  }

  function syncTtsUi() {
    if (ttsIconOn && ttsIconOff) {
      ttsIconOn.classList.toggle('hidden', !ttsEnabled);
      ttsIconOff.classList.toggle('hidden', ttsEnabled);
    }
    if (toggleAutoplayVoice) {
      toggleAutoplayVoice.checked = ttsEnabled;
    }
  }

  // Voice speech synthesis (ElevenLabs direct REST API or Browser Web Speech fallback)
  async function speak(text, triggerBtn = null, msgIdx = null) {
    // If the same message is currently being read aloud, toggle it off / stop immediately
    if (msgIdx !== null && currentSpeakingIdx === msgIdx) {
      stopSpeaking();
      return;
    }

    // Stop any existing speech before starting new one
    stopSpeaking();

    const filterActions = localStorage.getItem('aetheria_voice_filter') !== 'false';
    let cleanText = text;
    // Strip thought process / internal details
    cleanText = cleanText.replace(/<details[\s\S]*?<\/details>/gi, '').trim();
    if (filterActions) {
      cleanText = cleanText.replace(/\*[^*]+\*/g, '').trim();
    }
    if (!cleanText) return;

    currentSpeakingIdx = msgIdx;
    if (triggerBtn) {
      triggerBtn.innerHTML = TOOLBAR_ICONS.stop;
      triggerBtn.title = "Stop reading aloud";
      triggerBtn.classList.remove('text-slate-400');
      triggerBtn.classList.add('text-purple-400', 'bg-purple-500/10');
    }

    const provider = localStorage.getItem('aetheria_voice_provider') || 'browser';
    const voiceKey = localStorage.getItem('aetheria_voice_key') || '';
    const voiceId = localStorage.getItem('aetheria_voice_id') || '21m00Tcm4TlvDq8ikWAM';

    if (provider === 'elevenlabs' && voiceKey) {
      try {
        const stability = parseFloat(localStorage.getItem('aetheria_voice_stability') || '0.5');
        const clarity = parseFloat(localStorage.getItem('aetheria_voice_clarity') || '0.75');
        const res = await fetch(`https://api.elevenlabs.io/v1/text-to-speech/${voiceId}`, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'xi-api-key': voiceKey
          },
          body: JSON.stringify({
            text: cleanText.slice(0, 1500),
            model_id: 'eleven_multilingual_v2',
            voice_settings: {
              stability: stability,
              similarity_boost: clarity
            }
          })
        });
        if (res.ok) {
          const blob = await res.blob();
          const audioUrl = URL.createObjectURL(blob);
          activeAudio = new Audio(audioUrl);
          activeAudio.onended = () => {
            stopSpeaking();
          };
          activeAudio.onerror = () => {
            stopSpeaking();
          };
          activeAudio.play();
          return;
        } else {
          console.warn('ElevenLabs API returned HTTP', res.status);
        }
      } catch (err) {
        console.warn('ElevenLabs speech error, falling back to browser:', err);
      }
    }

    // Browser Web Speech fallback
    if (window.speechSynthesis) {
      const utterance = new SpeechSynthesisUtterance(cleanText);
      utterance.rate = parseFloat(localStorage.getItem('aetheria_voice_rate') || '1.0');
      utterance.pitch = parseFloat(localStorage.getItem('aetheria_voice_pitch') || '1.0');
      // If Persian characters detected, set Persian language tag
      const isPersian = /[\u0600-\u06FF]/.test(cleanText);
      utterance.lang = isPersian ? 'fa-IR' : 'en-US';

      utterance.onend = () => {
        stopSpeaking();
      };
      utterance.onerror = () => {
        stopSpeaking();
      };

      window.speechSynthesis.speak(utterance);
    }
  }

  // Build System Prompt with Dynamic Lorebook Injection - 100% Pure SillyTavern / Chub Spec
  function buildSystemPrompt(userText = '', options = {}) {
    const { beforeCharContent, afterCharContent, triggeredNames } = scanAndInjectLorebook(userText, conversation);
    updateSidebarLoreTriggers(triggeredNames);

    let prompt = '';
    const isPersonaEnabled = options.skipPersona ? false : isPersonaGloballyActive();

    // Standard Main Prompt (Pure narrative framing without rigid corporate rules)
    if (isPersonaEnabled && activeUserPersona && activeUserPersona.name && activeUserPersona.name.trim()) {
      prompt += `Write {{char}}'s next reply in this fictional roleplay with {{user}}.\n\n`;
    } else {
      prompt += `Write {{char}}'s next reply in this fictional roleplay.\n\n`;
    }

    if (beforeCharContent) {
      prompt += `${beforeCharContent}\n\n`;
    }

    // Character Card Attributes (pure Tavern format)
    if (activeChar.description) prompt += `[Character: {{char}}]\n${activeChar.description}\n\n`;
    if (activeChar.personality) prompt += `[Personality: {{char}}]\n${activeChar.personality}\n\n`;
    if (activeChar.scenario) prompt += `[Scenario]\n${activeChar.scenario}\n\n`;
    if (activeChar.speechStyle) prompt += `[Speech Style: {{char}}]\n${activeChar.speechStyle}\n\n`;
    if (activeChar.systemPrompt) prompt += `${activeChar.systemPrompt}\n\n`;

    // Dialogue Examples
    if (activeChar.mesExample) {
      prompt += `<START>\n${activeChar.mesExample}\n\n`;
    }

    // User Persona: Pure Tavern format - ONLY attached if explicitly enabled. Zero meta-injections or artificial rules.
    if (isPersonaEnabled && activeUserPersona && !activeUserPersona.disabled && activeUserPersona.id !== 'none') {
      const uName = (activeUserPersona.name && activeUserPersona.name.trim()) ? activeUserPersona.name.trim() : 'User';
      prompt += `[User: {{user}}]\n`;
      if (uName !== 'User') prompt += `Name: ${uName}\n`;
      if (activeUserPersona.age) prompt += `Age: ${activeUserPersona.age}\n`;
      if (activeUserPersona.gender || activeUserPersona.pronouns) prompt += `Gender: ${activeUserPersona.gender || activeUserPersona.pronouns}\n`;
      if (activeUserPersona.title) prompt += `Role: ${activeUserPersona.title}\n`;
      if (activeUserPersona.appearance) prompt += `Appearance: ${activeUserPersona.appearance}\n`;
      if (activeUserPersona.personality) prompt += `Personality: ${activeUserPersona.personality}\n`;
      const userLore = activeUserPersona.lore || activeUserPersona.bio || '';
      if (userLore) prompt += `Backstory: ${userLore}\n`;
      const userRules = activeUserPersona.directives || activeUserPersona.globalNotes || '';
      if (userRules) prompt += `Details: ${userRules}\n\n`;
      else prompt += `\n`;
    }

    if (afterCharContent) {
      prompt += `${afterCharContent}\n\n`;
    }

    // Pinned Memory / Author's Note Injection
    const pinnedNoteKey = 'aetheria_pinned_note_' + (activeChar.id || character.id || 'default');
    const pinnedNote = localStorage.getItem(pinnedNoteKey) || '';
    if (pinnedNote.trim()) {
      prompt += `[Author's Note: ${pinnedNote.trim()}]\n\n`;
    }

    // Custom post history instructions from character card if present
    const charCustomPostHistory = activeChar.postHistoryInstructions || activeChar.post_history_instructions || '';
    if (charCustomPostHistory.trim()) {
      prompt += `${charCustomPostHistory.trim()}\n\n`;
    }

    return formatMacroText(prompt).trim();
  }

  // Send message & AI Generation with Real-time SSE Token Streaming
  
  // Recovery actions for when a model exhausts tokens on thinking
  window.continueGeneration = async function() {
    const lastMsg = conversation[conversation.length - 1];
    if (lastMsg && lastMsg.sender === 'character') {
      conversation.pop();
      const lastEl = document.querySelector('#chat-stream > div:last-child');
      if (lastEl) lastEl.remove();
      saveChat();
    }
    const lastUserMsg = conversation.slice().reverse().find(m => m.sender === 'user');
    if (lastUserMsg) {
      const userText = lastUserMsg.text;
      conversation.pop();
      const lastUserEl = document.querySelector('#chat-stream > div:last-child');
      if (lastUserEl) lastUserEl.remove();
      saveChat();
      handleSendMessage(userText);
    }
  };

  window.disableThinkingAndRetry = async function() {
    localStorage.setItem('aetheria_text_thinking', 'false');
    const toggleThinkingEl = document.getElementById('toggle-thinking');
    if (toggleThinkingEl) toggleThinkingEl.checked = false;

    // Pop the unfinished character message
    const lastMsg = conversation[conversation.length - 1];
    if (lastMsg && lastMsg.sender === 'character') {
      conversation.pop();
      const lastEl = document.querySelector('#chat-stream > div:last-child');
      if (lastEl) lastEl.remove();
      saveChat();
    }
    // Re-send the last user message
    const lastUserMsg = conversation.slice().reverse().find(m => m.sender === 'user');
    if (lastUserMsg) {
      const userText = lastUserMsg.text;
      conversation.pop(); // pop user message too since handleSendMessage appends it
      const lastUserEl = document.querySelector('#chat-stream > div:last-child');
      if (lastUserEl) lastUserEl.remove();
      saveChat();
      handleSendMessage(userText);
    }
  };

  async function handleSendMessage(userText) {
    if (!userText.trim()) return;

    const userMsg = {
      sender: 'user',
      text: userText.trim(),
      timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
    };

    conversation.push(userMsg);
    saveChat();
    appendMessageToDOM(userMsg, conversation.length - 1);
    if (chatStream) chatStream.scrollTop = chatStream.scrollHeight;

    if (input) {
      input.value = '';
      adjustInputHeight();
      updateSendBtnState();
    }

    if (typingIndicator) {
      typingIndicator.classList.remove('hidden');
      if (chatStream) chatStream.scrollTop = chatStream.scrollHeight;
    }

    const provider = localStorage.getItem('aetheria_text_provider') || 'demo';
    const conf = PROVIDER_CONFIGS[provider] || PROVIDER_CONFIGS.demo;
    const apiKey = localStorage.getItem('aetheria_text_key') || '';
    let savedModel = localStorage.getItem('aetheria_text_model') || '';

    // Enforce 100% dynamic models - NEVER fall back to hardcoded legacy models
    if (provider !== 'demo') {
      if (!savedModel || savedModel.includes('No API connected') || savedModel === 'Free Cloud AI') {
        const cachedRaw = localStorage.getItem('aetheria_synced_models_' + provider);
        let cachedList = [];
        try { cachedList = JSON.parse(cachedRaw || '[]'); } catch (e) {}
        if (Array.isArray(cachedList) && cachedList.length > 0) {
          savedModel = cachedList[0];
          localStorage.setItem('aetheria_text_model', savedModel);
        } else if (apiKey) {
          try {
            const fetched = await fetchModelsForProvider(provider, apiKey);
            if (Array.isArray(fetched) && fetched.length > 0) {
              savedModel = fetched[0];
              localStorage.setItem('aetheria_text_model', savedModel);
            }
          } catch (e) {}
        }
      }

      if (!savedModel || savedModel.includes('No API connected') || savedModel === 'Free Cloud AI') {
        if (typingIndicator) typingIndicator.classList.add('hidden');
        const errAlert = {
          sender: 'character',
          text: `⚠️ **No Active Model Selected for ${conf.name}**\nPlease open Engine Settings (⚙️), enter your API key, and click **"Fetch Models"** to sync the active 2026 models directly from your provider account.`,
          timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
          swipes: [''],
          swipeIndex: 0
        };
        conversation.push(errAlert);
        appendMessageToDOM(errAlert, conversation.length - 1);
        return;
      }
    }
    const model = savedModel;
    const temp = parseFloat(localStorage.getItem('aetheria_text_temp') || '0.85');
    const maxTokens = Math.max(1024, parseInt(localStorage.getItem('aetheria_text_tokens') || '2048', 10));
    const topP = parseFloat(localStorage.getItem('aetheria_text_top_p') || '0.95');
    const enableStreaming = localStorage.getItem('aetheria_text_streaming') !== 'false';

    let replyText = '';

    // Direct LLM Call with Real-time Streaming & Resilient Fallbacks
    if ((apiKey || provider === 'custom-local') && provider !== 'demo') {
      try {
        let endpoint = conf.chatEndpoint;
        if (conf.hasUrl) {
          const rawBase = (localStorage.getItem('aetheria_text_base_url') || conf.defaultUrl || 'http://localhost:11434/v1').trim();
          let base = rawBase.replace(/\/+$/, '');
          if (base.endsWith('/chat/completions')) {
            endpoint = base;
          } else if (base.endsWith('/v1')) {
            endpoint = base + '/chat/completions';
          } else {
            endpoint = base + '/chat/completions';
          }
        } else if (provider === 'google') {
          endpoint = 'https://generativelanguage.googleapis.com/v1beta/openai/chat/completions';
        } else if (!endpoint) {
          endpoint = 'https://api.groq.com/openai/v1/chat/completions';
        }

        let systemPrompt = buildSystemPrompt(userText);
        const contextLimit = parseInt(localStorage.getItem('aetheria_text_context') || '16', 10);
        const historySlice = conversation
          .slice(-contextLimit)
          .filter(m => m.text && !isPoisonedOrErrorMessage(m.text))
          .map(m => ({
            role: m.sender === 'user' ? 'user' : 'assistant',
            content: m.text
          }));

        // Send clean user and assistant conversation history (strictly sanitized of persona when disabled)
        const payloadMessages = getSanitizedHistoryForAPI(historySlice);

        let payload;
        let headers = { 'Content-Type': 'application/json' };

        if (apiKey) {
          if (provider === 'anthropic') {
            headers['x-api-key'] = apiKey;
            headers['anthropic-version'] = '2023-06-01';
            headers['anthropic-dangerous-direct-browser-access'] = 'true';
          } else if (provider === 'google') {
            headers['x-goog-api-key'] = apiKey;
            headers['Authorization'] = `Bearer ${apiKey}`;
          } else {
            headers['Authorization'] = `Bearer ${apiKey}`;
          }
        }

        if (provider === 'openrouter') {
          headers['HTTP-Referer'] = 'https://aetheria.ai';
          headers['X-Title'] = 'Aetheria AI';
        }

        const enableThinking = localStorage.getItem('aetheria_text_thinking') === 'true';
        let effectiveMaxTokens = maxTokens;
        const isReasoningModel = /deepseek|r1|reasoning|qwq|flash|thinking/i.test(model);
        if (enableThinking || isReasoningModel) {
          // Generous token budget so internal thinking never starves the character response
          effectiveMaxTokens = Math.max(maxTokens, 8192);
          systemPrompt += `\n\n[REASONING & ROLEPLAY PROTOCOL]:\n- Keep internal thinking focused on {{char}}'s inner emotions and subtext.\n- CRITICAL: You MUST write {{char}}'s spoken dialogue, emotional reactions, and roleplay actions (*in asterisks*) outside the thought process as your final response.\n- Never end your turn inside the thinking phase without {{char}} speaking to {{user}}.`;
          systemPrompt = formatMacroText(systemPrompt);
        }

        if (provider === 'anthropic') {
          payload = {
            model: model,
            system: systemPrompt,
            messages: payloadMessages,
            max_tokens: effectiveMaxTokens,
            temperature: temp,
            stream: enableStreaming
          };
          if (enableThinking) {
            payload.thinking = { type: 'enabled', budget_tokens: 2048 };
          } else {
            payload.thinking = { type: 'disabled' };
          }
        } else {
          const isOModel = typeof model === 'string' && /^o[13](-mini)?/i.test(model);
          payload = {
            model: model,
            messages: [{ role: 'system', content: systemPrompt }, ...payloadMessages],
            temperature: isOModel ? undefined : temp,
            ...(isOModel ? { max_completion_tokens: effectiveMaxTokens } : { max_tokens: effectiveMaxTokens }),
            top_p: isOModel ? undefined : topP,
            stream: enableStreaming
          };

          if (provider === 'openrouter') {
            if (enableThinking) {
              payload.reasoning = {
                effort: 'low',
                exclude: false
              };
            } else {
              // OpenRouter standard: effort 'none' disables thinking, exclude: true strips reasoning if model forces it internally
              payload.reasoning = {
                effort: 'none',
                exclude: true
              };
            }
          } else if (isReasoningModel) {
            if (!enableThinking) {
              // Explicitly disable thinking for snappy character roleplay
              payload.thinking = { type: 'disabled' };
              payload.chat_template_kwargs = { thinking: false };
            } else {
              payload.thinking = { type: 'enabled' };
              payload.reasoning_effort = 'low';
              payload.chat_template_kwargs = { thinking: true };
            }
          }
        }

        let res;
        try {
          // Direct browser request first (100% transparent client like SillyTavern — user's own IP & network)
          res = await fetch(endpoint, {
            method: 'POST',
            headers,
            body: JSON.stringify(payload)
          });
          // If 400 Bad Request and payload contained thinking parameters, retry once cleanly without them
          if (res.status === 400 && (payload.thinking || payload.chat_template_kwargs || payload.reasoning || payload.reasoning_effort)) {
            const cleanPayload = { ...payload };
            delete cleanPayload.thinking;
            delete cleanPayload.reasoning_effort;
            delete cleanPayload.chat_template_kwargs;
            delete cleanPayload.reasoning;
            res = await fetch(endpoint, {
              method: 'POST',
              headers,
              body: JSON.stringify(cleanPayload)
            });
          }
        } catch (directErr) {
          console.warn('Direct browser fetch blocked or failed, attempting Edge Relay fallback:', directErr);
          // Fallback to Edge Proxy ONLY if direct browser request fails due to CORS or local network restrictions
          const sendProxy = async () => {
            return await fetch('/api/proxy/chat', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                endpoint,
                apiKey,
                body: payload,
                headers: provider === 'openrouter' ? { 'HTTP-Referer': 'https://aetheria.ai', 'X-Title': 'Aetheria AI' } : {}
              })
            });
          };

          try {
            res = await sendProxy();
          } catch (proxyErr) {
            console.warn('Edge Relay attempt 1 failed, retrying in 1.5s...', proxyErr);
            await new Promise(r => setTimeout(r, 1500));
            res = await sendProxy();
          }

          if (res && res.status === 429) {
            await new Promise(r => setTimeout(r, 2500));
            try {
              res = await sendProxy();
            } catch (retryErr) {
              console.warn('Edge Relay 429 retry failed:', retryErr);
            }
          }
        }

        if (res.ok) {
          if (typingIndicator) typingIndicator.classList.add('hidden');

          // Check if response is streamable
          if (enableStreaming && res.body) {
            const charMsg = {
              sender: 'character',
              text: '',
              timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
              swipes: [''],
              swipeIndex: 0
            };
            conversation.push(charMsg);
            const msgIdx = conversation.length - 1;
            appendMessageToDOM(charMsg, msgIdx);
            const bubbleEl = document.getElementById(`msg-bubble-${msgIdx}`);

            const reader = res.body.getReader();
            const decoder = new TextDecoder('utf-8');
            let buffer = '';
            let rawAccumulated = '';
            let contentText = '';
            let reasoningText = '';
            let finishReason = '';

            try {
              while (true) {
                const { done, value } = await reader.read();
                if (done) break;
                const chunk = decoder.decode(value, { stream: true });
                rawAccumulated += chunk;
                buffer += chunk;
                const lines = buffer.split('\n');
                buffer = lines.pop() || '';

                for (const line of lines) {
                  const trimmed = line.trim();
                  if (trimmed.startsWith('data: ')) {
                    const dataStr = trimmed.slice(6);
                    if (dataStr === '[DONE]') continue;
                    try {
                      const parsed = JSON.parse(dataStr);
                      const c = parsed.choices?.[0];
                      if (c?.finish_reason) finishReason = c.finish_reason;

                      // 1. Content token
                      const rawContent = c?.delta?.content 
                        ?? c?.delta?.text 
                        ?? c?.text 
                        ?? c?.message?.content 
                        ?? parsed.delta?.content 
                        ?? parsed.delta?.text 
                        ?? parsed.response 
                        ?? parsed.content;

                      const contentToken = extractStreamToken(rawContent);

                      // 2. Reasoning / Thinking token (DeepSeek R1/V4, Qwen, Ollama, OpenRouter)
                      const rawReasoning = c?.delta?.reasoning_content 
                        ?? c?.delta?.reasoning 
                        ?? c?.delta?.thought 
                        ?? c?.delta?.thinking 
                        ?? c?.delta?.reasoning_details 
                        ?? c?.message?.reasoning_content 
                        ?? c?.message?.reasoning_details 
                        ?? parsed.thinking;

                      const reasoningToken = extractStreamToken(rawReasoning);

                      if (reasoningToken) {
                        reasoningText += reasoningToken;
                      }
                      if (contentToken) {
                        contentText += contentToken;
                      }

                      // Update live bubble in real-time
                      if (bubbleEl) {
                        if (contentText) {
                          let display = '';
                          if (reasoningText.trim()) {
                            display = `<details class="mb-3 rounded-lg border border-purple-500/20 bg-purple-950/20 px-3 py-2 text-xs text-purple-300 select-none"><summary class="cursor-pointer font-medium hover:text-purple-200">💭 Thought Process (${reasoningText.length} chars)</summary><div class="mt-2 text-slate-300 font-mono text-[11px] leading-relaxed whitespace-pre-wrap">${reasoningText}</div></details>\n\n${contentText}`;
                          } else {
                            display = contentText;
                          }
                          charMsg.text = display;
                          charMsg.swipes[0] = display;
                          bubbleEl.innerHTML = formatMessageText(display);
                        } else if (reasoningText) {
                          bubbleEl.innerHTML = `<div class="flex items-center gap-2 text-xs text-purple-400 italic mb-2 animate-pulse"><span>💭</span><span>Thinking & processing character persona...</span></div><div class="text-xs text-slate-400 font-mono leading-relaxed line-clamp-4 whitespace-pre-wrap border-l-2 border-purple-500/40 pl-2">${reasoningText}</div>`;
                        }
                        if (chatStream) chatStream.scrollTop = chatStream.scrollHeight;
                      }
                    } catch (e) {}
                  }
                }
              }
            } catch (streamErr) {
              console.warn('Stream read error:', streamErr);
            }

            // Auto-synthesis: If model spent tokens in reasoning and left dialogue empty,
            // automatically perform a fast follow-up to extract/continue dialogue so the user gets both!
            if (!contentText.trim() && reasoningText.trim()) {
              if (bubbleEl) {
                bubbleEl.innerHTML = `<details class="mb-3 rounded-lg border border-purple-500/20 bg-purple-950/20 px-3 py-2 text-xs text-purple-300 select-none"><summary class="cursor-pointer font-medium hover:text-purple-200">💭 Thought Process (${reasoningText.length} chars)</summary><div class="mt-2 text-slate-300 font-mono text-[11px] leading-relaxed whitespace-pre-wrap">${reasoningText}</div></details>\n\n<div class="flex items-center gap-2 text-xs text-purple-400 italic animate-pulse"><span>✨</span><span>Finalizing ${activeChar.name || 'character'}'s dialogue...</span></div>`;
              }
              try {
                const autoPayload = {
                  model: model,
                  messages: [
                    { 
                      role: 'system', 
                      content: `${systemPrompt}\n\n[CRITICAL DIRECTIVE]: Internal reasoning is completed. Immediately write ${activeChar.name || 'character'}'s spoken dialogue, emotional reactions, and roleplay actions (*in asterisks*) to ${activeUserPersona?.name || 'User'}. Output ONLY pure spoken dialogue and actions, with NO thinking tags, NO disclosure tags, and NO raw markdown thoughts.` 
                    },
                    ...payloadMessages
                  ],
                  temperature: temp,
                  ...(typeof model === 'string' && /^o[13](-mini)?/i.test(model) ? { max_completion_tokens: 2048 } : { max_tokens: 2048 }),
                  stream: false
                };
                if (provider === 'openrouter') {
                  autoPayload.reasoning = { effort: 'none', exclude: true };
                }
                const autoRes = await fetch(endpoint, {
                  method: 'POST',
                  headers,
                  body: JSON.stringify(autoPayload)
                });
                if (autoRes.ok) {
                  const autoData = await autoRes.json();
                  let synthesized = extractStreamToken(autoData.choices?.[0]?.message?.content || autoData.choices?.[0]?.text || (autoData.content && autoData.content[0] && autoData.content[0].text) || autoData.response || '').trim();
                  if (synthesized) {
                    synthesized = stripInternalArtifactsForLLM(synthesized);
                    if (synthesized) {
                      contentText = synthesized;
                    }
                  }
                }
              } catch (autoErr) {
                console.warn('Auto-synthesis failed:', autoErr);
              }
            }

            // Combine content and reasoning
            if (contentText && reasoningText.trim()) {
              replyText = `<details class="mb-3 rounded-lg border border-purple-500/20 bg-purple-950/20 px-3 py-2 text-xs text-purple-300 select-none"><summary class="cursor-pointer font-medium hover:text-purple-200">💭 Thought Process (${reasoningText.length} chars)</summary><div class="mt-2 text-slate-300 font-mono text-[11px] leading-relaxed whitespace-pre-wrap">${reasoningText}</div></details>\n\n${contentText}`;
            } else if (contentText) {
              replyText = contentText;
            } else if (reasoningText.trim()) {
              const notice = finishReason === 'length'
                ? `The model reached the token limit (${effectiveMaxTokens}) during reasoning.`
                : `The model completed reasoning but paused before generating spoken dialogue.`;
              replyText = `<details class="mb-3 rounded-lg border border-purple-500/20 bg-purple-950/20 px-3 py-2 text-xs text-purple-300 select-none" open><summary class="cursor-pointer font-medium hover:text-purple-200">💭 Thought Process (${reasoningText.length} chars)</summary><div class="mt-2 text-slate-300 font-mono text-[11px] leading-relaxed whitespace-pre-wrap">${reasoningText}</div></details>\n\n<div class="p-3 rounded-xl bg-amber-500/10 border border-amber-500/30 text-amber-200 text-xs flex flex-col gap-2"><div>⚠️ <strong>Stream Paused:</strong> ${notice}</div><div class="flex flex-wrap items-center gap-2 mt-1"><button type="button" onclick="window.continueGeneration()" class="px-3 py-1.5 rounded-lg bg-purple-600 hover:bg-purple-500 text-white font-medium text-xs shadow transition-all cursor-pointer">✨ Continue Dialogue</button><button type="button" onclick="window.disableThinkingAndRetry()" class="px-3 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 text-slate-200 text-xs transition-all cursor-pointer">⚡ Fast Reply (Disable Thinking)</button></div></div>`;
            }

            // Fallback JSON parser if provider returned non-SSE JSON response
            if (!replyText.trim()) {
              const fullText = (rawAccumulated + buffer).trim();
              if (fullText.startsWith('{') || fullText.startsWith('[')) {
                try {
                  const json = JSON.parse(fullText);
                  const choice = json.choices?.[0];
                  const cText = extractStreamToken(choice?.message?.content || choice?.text || (json.content && json.content[0] && json.content[0].text) || json.response || '');
                  const rText = extractStreamToken(choice?.message?.reasoning_content || choice?.message?.reasoning || choice?.message?.thought || choice?.message?.thinking || choice?.message?.reasoning_details || '').trim();
                  if (cText && rText) {
                    replyText = `<details class="mb-3 rounded-lg border border-purple-500/20 bg-purple-950/20 px-3 py-2 text-xs text-purple-300 select-none"><summary class="cursor-pointer font-medium hover:text-purple-200">💭 Thought Process (${rText.length} chars)</summary><div class="mt-2 text-slate-300 font-mono text-[11px] leading-relaxed whitespace-pre-wrap">${rText}</div></details>\n\n${cText}`;
                  } else {
                    replyText = cText || rText;
                  }
                  if (json.error) {
                    throw new Error(json.error.message || json.error.code || JSON.stringify(json.error));
                  }
                } catch (jsonErr) {
                  if (jsonErr.message && !jsonErr.message.includes('JSON')) {
                    throw jsonErr;
                  }
                }
              }
            }

            if (replyText.trim()) {
              charMsg.text = replyText;
              charMsg.swipes[0] = replyText;
              if (bubbleEl) {
                bubbleEl.innerHTML = formatMessageText(replyText);
              }
              saveChat();
            } else {
              charMsg.text = '*(No response generated - check API connection or token settings)*';
              charMsg.swipes[0] = charMsg.text;
              if (bubbleEl) {
                bubbleEl.innerHTML = formatMessageText(charMsg.text);
              }
              saveChat();
            }
          } else {
            // Standard non-streaming JSON mode
            const data = await res.json();
            const choice = data.choices?.[0];
            const cText = extractStreamToken(choice?.message?.content 
              || choice?.text 
              || (data.content && data.content[0] && data.content[0].text) 
              || data.response 
              || '');
            const rText = extractStreamToken(choice?.message?.reasoning_content 
              || choice?.message?.reasoning 
              || choice?.message?.thought 
              || choice?.message?.thinking 
              || choice?.message?.reasoning_details 
              || '').trim();

            if (cText && rText) {
              replyText = `<details class="mb-3 rounded-lg border border-purple-500/20 bg-purple-950/20 px-3 py-2 text-xs text-purple-300 select-none"><summary class="cursor-pointer font-medium hover:text-purple-200">💭 Thought Process (${rText.length} chars)</summary><div class="mt-2 text-slate-300 font-mono text-[11px] leading-relaxed whitespace-pre-wrap">${rText}</div></details>\n\n${cText}`;
            } else {
              replyText = cText || rText;
            }

            if (!replyText.trim()) {
              if (data.error) {
                throw new Error(data.error.message || JSON.stringify(data.error));
              }
              replyText = '*(No response generated - check API connection or token settings)*';
            }
            const charMsg = {
              sender: 'character',
              text: replyText,
              timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
              swipes: [replyText],
              swipeIndex: 0
            };
            conversation.push(charMsg);
            saveChat();
            appendMessageToDOM(charMsg, conversation.length - 1);
          }
        } else {
          console.warn('API returned non-OK status', res.status);
          let errDetail = '';
          try {
            const errData = await res.json();
            errDetail = errData.error?.message || errData.message || (typeof errData.error === 'string' ? errData.error : '');
          } catch {}
          if (!errDetail) errDetail = `Server returned HTTP ${res.status}`;
          
          if (typingIndicator) typingIndicator.classList.add('hidden');

          let guidance = '';
          const lowerErr = errDetail.toLowerCase();
          if (res.status === 402 || lowerErr.includes('credit') || lowerErr.includes('payment') || lowerErr.includes('balance')) {
            guidance = `\n\n💡 **Solution (Insufficient Credits):**\nThe model \`${model}\` is a paid model requiring account balance on ${conf.name}.\n👉 You can switch to a **FREE model** right now: Open Settings (⚙️) → Tap Model → Click **"🎁 Free (:free)"** and select a free model (e.g. \`meta-llama/llama-3.3-70b-instruct:free\`).\n👉 Or add credits on [openrouter.ai/credits](https://openrouter.ai/credits).`;
          } else if (res.status === 401 || lowerErr.includes('auth') || lowerErr.includes('user not found') || lowerErr.includes('api key')) {
            guidance = `\n\n💡 **Solution (Invalid Key):**\nPlease open Engine Settings (⚙️), paste your valid API key from ${conf.name} (starting with sk-or-v1-...), and click **"Save Engine Settings"**.`;
          } else if (res.status === 429 || lowerErr.includes('rate limit') || lowerErr.includes('provider returned error') || lowerErr.includes('too many requests')) {
            guidance = `\n\n💡 **Solution (Rate Limit / Overloaded Upstream Server):**\n1. **Switch to another free model:** The free server for \`${model}\` is currently congested. Open Settings (⚙️) → Tap Model → Choose \`google/gemini-2.0-flash-exp:free\` or \`qwen/qwen-2.5-72b-instruct:free\` (they have much higher capacity).\n2. **Free tier limit:** OpenRouter caps free accounts at 50 messages/day. You can switch to **Groq** (free, instant 300 t/s) or **Google Gemini** in Settings.\n3. **OpenRouter Setting:** Make sure "Allow training on inputs" is enabled in your OpenRouter Account Settings (required for free models).`;
          }

          const errorMsg = {
            sender: 'character',
            text: `⚠️ **API Error (${conf.name} - HTTP ${res.status}):** ${errDetail}${guidance}`,
            timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
            swipes: [`⚠️ **API Error (${conf.name} - HTTP ${res.status}):** ${errDetail}${guidance}`],
            swipeIndex: 0
          };
          conversation.push(errorMsg);
          saveChat();
          appendMessageToDOM(errorMsg, conversation.length - 1);
          if (chatStream) chatStream.scrollTop = chatStream.scrollHeight;
          return;
        }
      } catch (err) {
        console.warn('API call failed', err);
        if (typingIndicator) typingIndicator.classList.add('hidden');
        const errorMsg = {
          sender: 'character',
          text: `⚠️ **Connection Error (${conf.name}):** ${err.message || 'Network request failed'}\n\n*Check your network connection or API endpoint configuration in Settings.*`,
          timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
          swipes: [`⚠️ **Connection Error (${conf.name}):** ${err.message || 'Network request failed'}`],
          swipeIndex: 0
        };
        conversation.push(errorMsg);
        saveChat();
        appendMessageToDOM(errorMsg, conversation.length - 1);
        if (chatStream) chatStream.scrollTop = chatStream.scrollHeight;
        return;
      }
    }

    // Fallback response generator ONLY if provider is explicitly 'demo'
    if (!replyText && provider === 'demo') {
      if (typingIndicator) typingIndicator.classList.remove('hidden');
      try {
        const sysPrompt = buildSystemPrompt(userText);
        const rawDemoHistory = conversation.slice(-8)
          .filter(m => m.text && !isPoisonedOrErrorMessage(m.text));
        const demoHistory = getSanitizedHistoryForAPI(rawDemoHistory);
        const demoRes = await fetch('/api/chat/demo', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            messages: [
              { role: 'system', content: sysPrompt },
              ...demoHistory
            ]
          }),
          signal: AbortSignal.timeout(15000)
        });
        if (demoRes.ok) {
          const demoData = await demoRes.json();
          replyText = (demoData.response || demoData.choices?.[0]?.message?.content || '').trim();
        }
      } catch (e) {
        console.warn('Free Cloud fallback error:', e);
      }

      if (!replyText) {
        await new Promise(r => setTimeout(r, 400));
        replyText = pickResponse(userText);
      }

      if (typingIndicator) typingIndicator.classList.add('hidden');
      const charMsg = {
        sender: 'character',
        text: replyText,
        timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
        swipes: [replyText],
        swipeIndex: 0
      };
      conversation.push(charMsg);
      saveChat();
      appendMessageToDOM(charMsg, conversation.length - 1);
      if (chatStream) chatStream.scrollTop = chatStream.scrollHeight;
    }

    if (typingIndicator) typingIndicator.classList.add('hidden');

    if (ttsEnabled && localStorage.getItem('aetheria_voice_autoplay') === 'true') {
      speak(replyText);
    }

    // Trigger Contextual Smart Prompts Generation
    fetchDynamicSuggestions(replyText);
  }

  function pickResponse(userText) {
    const replies = activeChar.fallbackReplies || character.fallbackReplies || [];
    if (replies.length === 0) {
      return formatMacroText(`*Smiles faintly and leans in closer.* "Your thoughts resonate with an intriguing cadence, {{user}}. Tell me what else is on your mind."`);
    }
    const idx = Math.floor(Math.random() * replies.length);
    return formatMacroText(replies[idx]);
  }

