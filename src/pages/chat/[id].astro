    if (wizSliderTokens) localStorage.setItem('aetheria_text_tokens', wizSliderTokens.value);
    if (wizSliderContext) localStorage.setItem('aetheria_text_context', wizSliderContext.value);
    if (wizSliderRepPen) localStorage.setItem('aetheria_text_rep_pen', wizSliderRepPen.value);
    if (wizToggleStreaming) localStorage.setItem('aetheria_text_streaming', String(wizToggleStreaming.checked));

    loadEngineSettings();
    byokTray?.classList.add('hidden');
    showNotification('✨ AI Setup Complete! Your characters are ready to chat.');
  });

  btnWizardRestart?.addEventListener('click', () => {
