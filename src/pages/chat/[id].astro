    }, 280);
  }

  function handleHoldEnd(e) {
    if (holdSendTimer) {
      clearTimeout(holdSendTimer);
      holdSendTimer = null;
    }
    if (isRecordingChatAudio && isHoldSendingChatAudio) {
      stopChatAudioRecording(false);
    }
  }

  function handleHoldMove(e) {
    if (!isRecordingChatAudio || !isHoldSendingChatAudio) return;
    if (e.touches && e.touches[0]) {
      const diffY = touchStartY - e.touches[0].clientY;
      if (Math.abs(diffY) > 60) {
        isChatRecordingCancelled = true;
        if (voiceRecordingHint) voiceRecordingHint.textContent = 'Cancelled (Release to discard)';
      }
    }
  }

  roomSendBtn?.addEventListener('mousedown', handleHoldStart);
  roomSendBtn?.addEventListener('mouseup', handleHoldEnd);
  roomSendBtn?.addEventListener('mouseleave', handleHoldEnd);

  roomSendBtn?.addEventListener('touchstart', handleHoldStart, { passive: true });
  roomSendBtn?.addEventListener('touchend', handleHoldEnd);
  roomSendBtn?.addEventListener('touchcancel', () => stopChatAudioRecording(true));
