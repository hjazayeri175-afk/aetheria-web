  // Generate Alternative Swipe Variation (Supports Longer, Shorter, Don't personalize, Retry)
  async function generateNewSwipe(msgIdx, mode = 'retry') {
    const msg = conversation[msgIdx];
    if (!msg || msg.sender !== 'character') return;

    if (mode === 'longer') {
      showNotification('✨ Generating longer, more detailed response...');
    } else if (mode === 'shorter') {
      showNotification('✨ Generating shorter, concise response...');
    } else if (mode === 'depersonalize') {
      showNotification('✨ Generating response without personalization...');
    } else {
      showNotification('✨ Generating alternative response variation...');
    }
    if (typingIndicator) typingIndicator.classList.remove('hidden');

    const provider = localStorage.getItem('aetheria_text_provider') || 'demo';
    const apiKey = localStorage.getItem('aetheria_text_key') || '';
    let model = localStorage.getItem('aetheria_text_model') || '';
    if (!model && provider !== 'demo') {
      const cached = localStorage.getItem('aetheria_synced_models_' + provider);
      try {
        const list = JSON.parse(cached || '[]');
        if (list.length > 0) model = list[0];
      } catch (e) {}
    }
    if (!model && provider !== 'demo') {
      if (typingIndicator) typingIndicator.classList.add('hidden');
      showNotification('⚠️ Please select an active model in Settings first.');
      return;
    }
    const temp = Math.min(1.2, parseFloat(localStorage.getItem('aetheria_text_temp') || '0.85') + 0.15); // higher temperature for variety
    const maxTokens = Math.max(1024, parseInt(localStorage.getItem('aetheria_text_tokens') || '2048', 10));

    let newReply = '';

    const lastUserMsg = conversation.slice(0, msgIdx).reverse().find(m => m.sender === 'user');
    const systemPrompt = buildSystemPrompt(lastUserMsg ? lastUserMsg.text : '', { skipPersona: mode === 'depersonalize' });
    const historySlice = conversation.slice(0, msgIdx)
      .filter(m => m.text && !isPoisonedOrErrorMessage(m.text))
      .map(m => ({
        role: m.sender === 'user' ? 'user' : 'assistant',
        content: m.text
      }));

    // Send clean swipe history (strictly sanitized of persona when disabled or depersonalized)
    const payloadMessages = getSanitizedHistoryForAPI(historySlice, mode === 'depersonalize');

    if (payloadMessages.length === 0) {
      payloadMessages.push({
        role: 'user',
        content: `[Start the roleplay scenario as ${activeChar.name}. Greet the user in-character with a vivid, evocative opening description and dialogue.]`
      });
    }

    const isThinkingEnabled = (localStorage.getItem('aetheria_text_thinking') === 'true');
    const isReasoningModel = /deepseek|r1|reasoning|qwq|flash|thinking/i.test(model);
    let swipeSystemPrompt = systemPrompt;
    let tokenBudget = maxTokens;

    if (mode === 'longer') {
      tokenBudget = Math.max(maxTokens, 3072);
      swipeSystemPrompt += `\n\n[REGENERATION DIRECTIVE - EXPAND RESPONSE]:\n- You MUST generate a significantly LONGER and more detailed response.\n- Elaborate extensively on sensory details, setting, {{char}}'s internal monologue, nuances of emotional expression, and body language.\n- Expand spoken dialogue and deepen the conversation scene.\n- Do NOT summarize or rush.`;
    } else if (mode === 'shorter') {
      tokenBudget = Math.min(maxTokens, 768);
      swipeSystemPrompt += `\n\n[REGENERATION DIRECTIVE - CONCISE RESPONSE]:\n- You MUST generate a SHORTER, punchy, and concise response.\n- Focus strictly on immediate dialogue and primary action.\n- Omit flowery narrative filler or long internal monologues.\n- Keep your entire reply within 1-2 tight, impactful paragraphs.`;
    } else if (mode === 'depersonalize') {
      swipeSystemPrompt += `\n\n[REGENERATION DIRECTIVE - UNBIASED ROLEPLAY]:\n- Respond naturally in-character without assuming personalized user backstory, custom personas, or stored user traits.\n- Base the interaction strictly on the scenario and the immediate scene dialogue.`;
    }

    if (isThinkingEnabled || isReasoningModel) {
      tokenBudget = Math.max(tokenBudget, 8192);
      swipeSystemPrompt += `\n\n[REASONING & ROLEPLAY PROTOCOL]:\n- Keep internal thinking focused on {{char}}'s inner emotions and subtext.\n- CRITICAL: You MUST write {{char}}'s spoken dialogue, emotional reactions, and roleplay actions (*in asterisks*) outside the thought process as your final response.\n- Never end your turn inside the thinking phase without {{char}} speaking to {{user}}.`;
    }
    swipeSystemPrompt = formatMacroText(swipeSystemPrompt);

    if ((apiKey || provider === 'custom-local') && provider !== 'demo') {
      try {
        const conf = PROVIDER_CONFIGS[provider] || PROVIDER_CONFIGS.demo;
        let endpoint = conf.chatEndpoint;
        if (conf.hasUrl) {
          const base = localStorage.getItem('aetheria_text_base_url') || conf.defaultUrl || 'http://localhost:11434/v1';
          endpoint = base.replace(/\/+$/, '') + '/chat/completions';
        } else if (provider === 'google') {
          endpoint = 'https://generativelanguage.googleapis.com/v1beta/openai/chat/completions';
        } else if (!endpoint) {
          endpoint = 'https://api.groq.com/openai/v1/chat/completions';
        }

        let payload;
        let headers = { 'Content-Type': 'application/json' };

        if (apiKey) {
          if (provider === 'anthropic') {
            headers['x-api-key'] = apiKey;
            headers['anthropic-version'] = '2023-06-01';
            headers['anthropic-dangerous-direct-browser-access'] = 'true';
          } else if (provider === 'google') {
            headers['x-goog-api-key'] = apiKey;
            headers['Authorization'] = `Bearer ${apiKey}`;
          } else {
            headers['Authorization'] = `Bearer ${apiKey}`;
          }
        }

        if (provider === 'openrouter') {
          headers['HTTP-Referer'] = 'https://aetheria.ai';
          headers['X-Title'] = 'Aetheria AI';
        }

        if (provider === 'anthropic') {
          payload = {
            model: model,
            system: swipeSystemPrompt,
            messages: payloadMessages,
            max_tokens: tokenBudget,
            temperature: temp
          };
          if (isThinkingEnabled) {
            payload.thinking = { type: 'enabled', budget_tokens: 2048 };
          } else {
            payload.thinking = { type: 'disabled' };
          }
        } else {
          const isOModel = typeof model === 'string' && /^o[13](-mini)?/i.test(model);
          payload = {
            model: model,
            messages: [{ role: 'system', content: swipeSystemPrompt }, ...payloadMessages],
            temperature: isOModel ? undefined : temp,
            ...(isOModel ? { max_completion_tokens: tokenBudget } : { max_tokens: tokenBudget })
          };
          if (provider === 'openrouter') {
            if (isThinkingEnabled) {
              payload.reasoning = { effort: 'low', exclude: false };
            } else {
              payload.reasoning = { effort: 'none', exclude: true };
            }
          } else if (!isThinkingEnabled) {
            payload.thinking = { type: 'disabled' };
            payload.chat_template_kwargs = { thinking: false };
          }
        }

        let res;
        try {
          res = await fetch(endpoint, {
            method: 'POST',
            headers,
            body: JSON.stringify(payload)
          });
        } catch (directErr) {
          const sendProxy = async () => {
            return await fetch('/api/proxy/chat', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                endpoint,
                apiKey,
                body: payload,
                headers: provider === 'openrouter' ? { 'HTTP-Referer': 'https://aetheria.ai', 'X-Title': 'Aetheria AI' } : {}
              })
            });
          };
          try {
            res = await sendProxy();
          } catch (proxyErr) {
            console.warn('Swipe Edge Relay attempt 1 failed, retrying in 1.5s...', proxyErr);
            await new Promise(r => setTimeout(r, 1500));
            res = await sendProxy();
          }
        }

        if (res.ok) {
          const data = await res.json();
          if (provider === 'anthropic') {
            newReply = extractStreamToken(data.content?.[0]?.text || data.content || '');
          } else {
            const choice = data.choices?.[0];
            const cText = extractStreamToken(choice?.message?.content 
              || choice?.text 
              || (data.content && data.content[0] && data.content[0].text) 
              || data.response 
              || '').trim();
            const rText = extractStreamToken(choice?.message?.reasoning_content 
              || choice?.message?.reasoning 
              || choice?.message?.thought 
              || choice?.message?.thinking 
              || choice?.message?.reasoning_details 
              || '').trim();
            const cleanDialogue = stripInternalArtifactsForLLM(cText);
            if (cleanDialogue && rText) {
              newReply = `<details class="mb-3 rounded-lg border border-purple-500/20 bg-purple-950/20 px-3 py-2 text-xs text-purple-300 select-none"><summary class="cursor-pointer font-medium hover:text-purple-200">💭 Thought Process (${rText.length} chars)</summary><div class="mt-2 text-slate-300 font-mono text-[11px] leading-relaxed whitespace-pre-wrap">${rText}</div></details>\n\n${cleanDialogue}`;
            } else if (cleanDialogue) {
              newReply = cleanDialogue;
            } else {
              // Only thought returned without dialogue -> do not treat as valid dialogue
              newReply = '';
            }
          }
        }
      } catch (err) {}
    }

    if (!newReply) {
      try {
        const demoRes = await fetch('/api/chat/demo', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            messages: [{ role: 'system', content: swipeSystemPrompt }, ...payloadMessages]
          }),
          signal: AbortSignal.timeout(12000)
        });
        if (demoRes.ok) {
          const demoData = await demoRes.json();
          newReply = (demoData.response || demoData.choices?.[0]?.message?.content || '').trim();
        }
      } catch (e) {}
    }

    if (!newReply) {
      await new Promise(r => setTimeout(r, 600));
      newReply = pickResponse('');
    }

    if (typingIndicator) typingIndicator.classList.add('hidden');

    if (!msg.swipes) msg.swipes = [msg.text];
    msg.swipes.push(newReply);
    msg.swipeIndex = msg.swipes.length - 1;
    msg.text = newReply;

    saveChat();
    renderAllMessages();
    showNotification(`Swipe ${msg.swipeIndex + 1}/${msg.swipes.length} ready!`);
    fetchDynamicSuggestions(newReply);
  }

  // Handle Swipe Navigation
  function handleSwipeNavigation(msgIdx, action) {
    const msg = conversation[msgIdx];
    if (!msg || !msg.swipes) return;

    if (action === 'prev') {
      if ((msg.swipeIndex || 0) > 0) {
        const cur = msg.swipes[msg.swipeIndex || 0] || '';
        const pureCur = cur.replace(/<details[\s\S]*?<\/details>/gi, '').trim();
        // If current swipe was an empty thought-only glitch, remove it from list
        if (!pureCur && msg.swipes.length > 1) {
          msg.swipes.splice(msg.swipeIndex, 1);
        }
        msg.swipeIndex = Math.max(0, (msg.swipeIndex || 0) - 1);
        msg.text = msg.swipes[msg.swipeIndex];
        saveChat();
        renderAllMessages();
        fetchDynamicSuggestions(msg.text);
        if (msgIdx === 0) {
          showNotification(`Switched to Scenario ${msg.swipeIndex + 1} of ${msg.swipes.length}`);
        }
      }
    } else if (action === 'next') {
      const nextIdx = (msg.swipeIndex || 0) + 1;
      if (nextIdx < msg.swipes.length) {
        msg.swipeIndex = nextIdx;
        msg.text = msg.swipes[msg.swipeIndex];
        saveChat();
        renderAllMessages();
        fetchDynamicSuggestions(msg.text);
      } else if (msgIdx === 0 && msg.swipes.length > 1) {
        // Loop back to Scenario 1 when swiping past the last scenario on initial greeting
        msg.swipeIndex = 0;
        msg.text = msg.swipes[0];
        saveChat();
        renderAllMessages();
        fetchDynamicSuggestions(msg.text);
        showNotification('Cycled to Scenario 1');
      } else if (msgIdx === conversation.length - 1) {
        generateNewSwipe(msgIdx);
      }
    }
  }

  // Inline Message Editing
  let activeEditingIndex = null;

  function enableEditMessage(idx) {
    const msg = conversation[idx];
    if (!msg) return;

    if (activeEditingIndex !== null && activeEditingIndex !== idx) {
      renderAllMessages();
    }
    activeEditingIndex = idx;

    const bubble = document.getElementById(`msg-bubble-${idx}`);
    if (!bubble) return;

    const isUserMsg = msg.sender === 'user';
    const messageRow = bubble.closest('#chat-msg-row-' + idx) || bubble.closest('.group\\/msg') || bubble.parentElement;
    const actionFooter = messageRow?.querySelector('.msg-copy-btn')?.parentElement;
    if (actionFooter) actionFooter.classList.add('hidden');

    const bubbleWrapper = bubble.parentElement;
    if (bubbleWrapper && isUserMsg) {
      bubbleWrapper.classList.remove('max-w-lg');
      bubbleWrapper.classList.add('max-w-2xl');
    }

    // Transform bubble into sleek Gemini / ChatGPT dark surface
    bubble.className = "w-full rounded-2xl bg-[#1e1f24] border border-white/[0.12] shadow-2xl overflow-hidden transition-all duration-200 text-left";

    const safeText = (msg.text || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

    bubble.innerHTML = `
      <div class="p-3 sm:p-4">
        <textarea 
          id="edit-textarea-${idx}" 
          dir="auto" 
          class="w-full bg-transparent border-0 text-slate-100 text-xs sm:text-sm focus:outline-none focus:ring-0 resize-none leading-relaxed font-sans placeholder:text-slate-500 overflow-y-auto block" 
          placeholder="${isUserMsg ? 'Edit your message...' : 'Edit response...'}"
        >${safeText}</textarea>
      </div>
      <div class="px-3.5 py-2.5 sm:px-4 sm:py-3 flex items-center justify-between border-t border-white/[0.08] bg-black/25">
        <div class="text-[11px] text-slate-400 select-none flex items-center gap-1.5 font-normal">
          ${isUserMsg ? `
            <span class="inline-block w-1.5 h-1.5 rounded-full bg-purple-400 animate-pulse"></span>
            <span class="hidden sm:inline">Updating will regenerate response</span>
            <span class="sm:hidden">Regenerates</span>
          ` : `
            <span class="inline-block w-1.5 h-1.5 rounded-full bg-slate-400"></span>
            <span>Editing response</span>
          `}
        </div>
        <div class="flex items-center gap-2">
          <button 
            id="cancel-edit-${idx}" 
            type="button" 
            class="px-4 py-1.5 rounded-full text-xs font-medium text-slate-400 hover:text-white hover:bg-white/[0.08] active:scale-95 transition cursor-pointer select-none"
          >
            Cancel
          </button>
          <button 
            id="save-edit-${idx}" 
            type="button" 
            class="px-4 py-1.5 rounded-full text-xs font-semibold ${isUserMsg ? 'bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white shadow-md shadow-purple-950/40' : 'bg-white/10 hover:bg-white/20 text-slate-100'} active:scale-95 transition cursor-pointer select-none flex items-center gap-1.5"
          >
            <span>${isUserMsg ? 'Update & Send' : 'Save'}</span>
            ${isUserMsg ? `
              <svg class="w-3.5 h-3.5 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14"/>
                <path d="m12 5 7 7-7 7"/>
              </svg>
            ` : ''}
          </button>
        </div>
      </div>
    `;

    const textarea = document.getElementById(`edit-textarea-${idx}`);
    if (textarea) {
      const adjustHeight = () => {
        textarea.style.height = 'auto';
        textarea.style.height = `${Math.max(56, Math.min(textarea.scrollHeight, 260))}px`;
      };
      requestAnimationFrame(() => {
        adjustHeight();
        textarea.focus();
        textarea.setSelectionRange(textarea.value.length, textarea.value.length);
      });
      textarea.addEventListener('input', adjustHeight);

      textarea.addEventListener('keydown', (e) => {
        if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
          e.preventDefault();
          document.getElementById(`save-edit-${idx}`)?.click();
        } else if (e.key === 'Escape') {
          e.preventDefault();
          document.getElementById(`cancel-edit-${idx}`)?.click();
        }
      });
    }

    document.getElementById(`cancel-edit-${idx}`)?.addEventListener('click', () => {
      activeEditingIndex = null;
      renderAllMessages();
    });

    document.getElementById(`save-edit-${idx}`)?.addEventListener('click', () => {
      if (!textarea) return;
      const val = textarea.value.trim();
      if (!val) return;

      activeEditingIndex = null;

      if (isUserMsg) {
        if (val === msg.text) {
          renderAllMessages();
          return;
        }

        // ChatGPT & Google Gemini standard:
        // 1. Truncate conversation from this user message forward
        conversation = conversation.slice(0, idx);
        saveChat();
        renderAllMessages();

        // 2. Dispatch updated prompt to handleSendMessage for a fresh streamed response!
        handleSendMessage(val);
      } else {
        msg.text = val;
        if (msg.swipes && msg.swipeIndex !== undefined) {
          msg.swipes[msg.swipeIndex] = val;
        }
        saveChat();
        renderAllMessages();
        showNotification('Response updated.');
      }
    });
  }

  // Rewind Turn Function
  async function rewindTurn(idx) {
    const msg = conversation[idx];
    if (!msg) return;

    const confirmed = await showConfirmModal({
      title: 'Rewind to here?',
      message: 'Subsequent messages will be deleted, and this prompt will be copied to the input box for editing.',
      confirmText: 'Rewind',
      cancelText: 'Cancel',
      icon: 'rewind',
      type: 'warning'
    });
    if (!confirmed) return;

    let restoredPrompt = '';
    if (msg.sender === 'user') {
      restoredPrompt = msg.text;
      conversation = conversation.slice(0, idx);
    } else {
      // Find the user message before this character reply
      if (idx > 0 && conversation[idx - 1].sender === 'user') {
        restoredPrompt = conversation[idx - 1].text;
        conversation = conversation.slice(0, idx - 1);
      } else {
        conversation = conversation.slice(0, idx);
      }
    }

    saveChat();
    renderAllMessages();

    if (input && restoredPrompt) {
      input.value = restoredPrompt;
      input.focus();
    }
    showNotification('Chat rewound! Prompt restored to input box.');
  }

  // Contextual Image Prompt Synthesizer
  function buildContextualSelfiePrompt() {
    const recent = conversation.slice(-3);
    let actions = [];
    recent.forEach(m => {
      const matched = m.text.match(/\*[^*]+\*/g);
      if (matched) actions.push(...matched.map(a => a.replace(/\*/g, '')));
    });

    const actionText = actions.slice(-2).join(', ');
    const charName = activeChar.name;
    const charTitle = activeChar.title || 'character';
    const charDesc = (activeChar.description || '').slice(0, 140);
    const scenario = (activeChar.scenario || '').slice(0, 100);

    return `Candid smartphone selfie photograph of ${charName}, ${charTitle}. Visual appearance: ${charDesc}. Action & expression: ${actionText || 'looking warmly into the camera, gentle smile'}. Environment setting: ${scenario || 'atmospheric cinematic scene'}. Award-winning photography, detailed face, photorealistic, 8k resolution.`;
  }

  // Contextual Video Motion Prompt Synthesizer
  function buildContextualVideoPrompt() {
    const recent = conversation.slice(-2);
    let actions = [];
    recent.forEach(m => {
      const matched = m.text.match(/\*[^*]+\*/g);
      if (matched) actions.push(...matched.map(a => a.replace(/\*/g, '')));
    });

    const actionText = actions.slice(-1).join('');
    const charName = activeChar.name;
    const charDesc = (activeChar.description || '').slice(0, 120);

    return `Cinematic 4k video of ${charName}, ${charDesc}. Dynamic action: ${actionText || 'looking towards camera, natural facial expressions and gentle head movement'}, highly detailed, photorealistic lighting, fluid 60fps motion.`;
  }

  // Selfie / Photo Generation
  async function handleGenerateSelfie() {
    const prompt = buildContextualSelfiePrompt();
    const imageProvider = localStorage.getItem('aetheria_image_provider') || 'pollinations';
    const falKey = localStorage.getItem('aetheria_fal_key') || localStorage.getItem('aetheria_api_key_fal');
    const openaiKey = localStorage.getItem('aetheria_api_key_openai');

    if (imageProvider === 'fal' && !falKey) {
      showNotification('⚠️ Fal Flux requires an API Key. Opening settings...');
      byokTray?.classList.remove('hidden');
      document.querySelector('[data-engine-tab="image"]')?.click();
      return;
    }
    if (imageProvider === 'dalle' && !openaiKey) {
      showNotification('⚠️ DALL-E 3 requires an OpenAI API Key. Opening settings...');
      byokTray?.classList.remove('hidden');
      document.querySelector('[data-engine-tab="image"]')?.click();
      return;
    }

    showNotification('📷 Capturing scene selfie...');

    const pendingId = 'selfie_' + Date.now();
    const placeholderMsg = {
      sender: 'character',
      text: `*Snaps a candid selfie:* "${activeChar.name}"`,
      timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
      mediaType: 'image_generating',
      mediaPrompt: prompt,
      pendingId: pendingId
    };
    conversation.push(placeholderMsg);
    saveChat();
    renderAllMessages();

    try {
      let finalUrl = '';
      if (imageProvider === 'pollinations' || !falKey) {
        const encoded = encodeURIComponent(prompt);
        finalUrl = `https://image.pollinations.ai/prompt/${encoded}?width=768&height=1024&nologo=true&seed=${Date.now()}`;
      } else if (imageProvider === 'fal' && falKey) {
        const res = await fetch('https://queue.fal.run/fal-ai/flux/schnell', {
          method: 'POST',
          headers: {
            'Authorization': `Key ${falKey}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ prompt: prompt, image_size: "portrait_4_3" })
        });
        const data = await res.json();
        finalUrl = data.images?.[0]?.url || '';
      }

      if (finalUrl) {
        placeholderMsg.mediaType = 'image';
        placeholderMsg.mediaUrl = finalUrl;
        delete placeholderMsg.pendingId;
        saveChat();
        renderAllMessages();
        showNotification('📷 Photo delivered!');
      } else {
        throw new Error('Image URL could not be resolved.');
      }
    } catch (err) {
      showNotification(`Photo error: ${err.message}`);
      conversation = conversation.filter(m => m.pendingId !== pendingId);
      saveChat();
      renderAllMessages();
    }
  }

  // Living Video Generation (BYOK Protected)
  async function handleGenerateVideo() {
    const falKey = localStorage.getItem('aetheria_fal_key') || localStorage.getItem('aetheria_api_key_fal');
    const lumaKey = localStorage.getItem('aetheria_luma_key');

    // Strict Gatekeeper: Only available for users who provided API Key
    if (!falKey && !lumaKey) {
      showNotification('⚠️ Living Video requires an API Key (Fal.ai Kling or Luma). Opening settings...');
      byokTray?.classList.remove('hidden');
      document.querySelector('[data-engine-tab="video"]')?.click();
      return;
    }

    const prompt = buildContextualVideoPrompt();
    showNotification('🎬 Requesting Living Video render...');

    const pendingId = 'video_' + Date.now();
    const placeholderMsg = {
      sender: 'character',
      text: `*Sends living video clip:* "${activeChar.name} in motion"`,
      timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
      mediaType: 'video_generating',
      mediaPrompt: prompt,
      pendingId: pendingId
    };
    conversation.push(placeholderMsg);
    saveChat();
    renderAllMessages();

    try {
      if (falKey) {
        const avatarFullUrl = activeChar.avatarUrl.startsWith('http') 
          ? activeChar.avatarUrl 
          : `${window.location.origin}${activeChar.avatarUrl}`;

        const res = await fetch('https://queue.fal.run/fal-ai/kling-video/v1.5/pro/image-to-video', {
          method: 'POST',
          headers: {
            'Authorization': `Key ${falKey}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            prompt: prompt,
            image_url: avatarFullUrl,
            duration: "5",
            aspect_ratio: "16:9"
          })
        });

        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          throw new Error(err.detail || err.message || `HTTP ${res.status}`);
        }

        const data = await res.json();
        const requestId = data.request_id;
        showNotification('Rendering video frames on Fal cluster...');

        let videoUrl = '';
        for (let i = 0; i < 25; i++) {
          await new Promise(r => setTimeout(r, 4000));
          const checkRes = await fetch(`https://queue.fal.run/fal-ai/kling-video/requests/${requestId}/status`, {
            headers: { 'Authorization': `Key ${falKey}` }
          });
          if (checkRes.ok) {
            const checkData = await checkRes.json();
            if (checkData.status === 'COMPLETED') {
              const resFinal = await fetch(`https://queue.fal.run/fal-ai/kling-video/requests/${requestId}`, {
                headers: { 'Authorization': `Key ${falKey}` }
              });
              const finalData = await resFinal.json();
              videoUrl = finalData.video?.url || '';
              break;
            } else if (checkData.status === 'FAILED') {
              throw new Error('Fal GPU render failed.');
            }
          }
        }

        if (videoUrl) {
          placeholderMsg.mediaType = 'video';
          placeholderMsg.mediaUrl = videoUrl;
          delete placeholderMsg.pendingId;
          saveChat();
          renderAllMessages();
          showNotification('🎬 Living Video ready!');
        } else {
          throw new Error('Render timed out.');
        }
      }
    } catch (err) {
      showNotification(`Video error: ${err.message}`);
      conversation = conversation.filter(m => m.pendingId !== pendingId);
      saveChat();
      renderAllMessages();
    }
  }

