    if (hasText) {
      fullscreenSendBtn.className = "w-11 h-11 sm:w-12 sm:h-12 rounded-full flex items-center justify-center transition-all duration-200 active:scale-95 shadow-lg shadow-purple-950/60 cursor-pointer bg-purple-600 hover:bg-purple-500 text-white opacity-100 scale-100";
    } else {
      fullscreenSendBtn.className = "w-11 h-11 sm:w-12 sm:h-12 rounded-full flex items-center justify-center transition-all duration-200 shadow-sm cursor-not-allowed bg-purple-600 text-white opacity-40 scale-95";
    }
  }

  function openFullscreenComposer() {
    if (!fullscreenComposerModal || !fullscreenTextarea || !input) return;

    fullscreenTextarea.value = input.value;
    updateFullscreenSendBtnState();

    fullscreenComposerModal.classList.remove('hidden');
    requestAnimationFrame(() => {
      fullscreenComposerModal.classList.remove('opacity-0', 'pointer-events-none');
      fullscreenComposerModal.classList.add('opacity-100', 'pointer-events-auto');
      fullscreenTextarea.focus();
      const len = fullscreenTextarea.value.length;
      fullscreenTextarea.setSelectionRange(len, len);
    });
  }

  function closeFullscreenComposer(syncBack = true) {
    if (!fullscreenComposerModal) return;
    if (syncBack && input && fullscreenTextarea) {
      input.value = fullscreenTextarea.value;
      adjustInputHeight();
      updateSendBtnState();
    }
    fullscreenComposerModal.classList.remove('opacity-100', 'pointer-events-auto');
    fullscreenComposerModal.classList.add('opacity-0', 'pointer-events-none');
    setTimeout(() => {
      fullscreenComposerModal.classList.add('hidden');
    }, 200);
  }

  function submitFromFullscreen() {
    if (!fullscreenTextarea || !input) return;
    const text = fullscreenTextarea.value.trim();
    if (!text && currentMultimodalMode === null && attachedImageBase64 === null) return;

    // Sync text to main input
    input.value = fullscreenTextarea.value;
    adjustInputHeight();
    updateSendBtnState();

    // Close modal without overwriting back
    closeFullscreenComposer(false);

    // Submit message through unified handler
    handleUnifiedSubmit();
  }

  chatInputExpandBtn?.addEventListener('click', openFullscreenComposer);
  fullscreenCloseBtn?.addEventListener('click', () => closeFullscreenComposer(true));

  fullscreenTextarea?.addEventListener('input', () => {
    updateFullscreenSendBtnState();
    if (input) {
      input.value = fullscreenTextarea.value;
      adjustInputHeight();
      updateSendBtnState();
    }
  });

  fullscreenSendBtn?.addEventListener('click', () => {
    if (fullscreenTextarea && fullscreenTextarea.value.trim()) {
      submitFromFullscreen();
    }
  });

  fullscreenTextarea?.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') {
      e.preventDefault();
      closeFullscreenComposer(true);
      return;
    }
    if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
      e.preventDefault();
      submitFromFullscreen();
    }
  });

