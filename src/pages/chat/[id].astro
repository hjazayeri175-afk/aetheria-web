  function applySttProfile(id) {
    const profiles = getSavedSttProfiles();
    const prof = profiles.find(p => p.id === id);
    if (!prof) return;

    localStorage.setItem(ACTIVE_STT_PROFILE_KEY, prof.id);
    if (prof.engine && typeof window.selectSttEngine === 'function') {
      window.selectSttEngine(prof.engine);
    }
    if (prof.apiKey) {
      localStorage.setItem('aetheria_stt_key_' + prof.engine, prof.apiKey);
      localStorage.setItem('aetheria_stt_key', prof.apiKey);
    }
    if (prof.customUrl) {
      localStorage.setItem('aetheria_stt_custom_url', prof.customUrl);
    }
    if (typeof syncVoiceUiPanels === 'function') syncVoiceUiPanels();
    renderSttProfileMenu();
    showNotification(`✓ Loaded microphone profile: ${prof.name}`);
  }

  function saveCurrentAsSttProfile(name) {
    if (!name || !name.trim()) {
      showNotification('⚠️ Please enter a profile name', 'warning');
      return;
    }
    const currentEngine = localStorage.getItem('aetheria_stt_engine') || 'cloudflare';
    const profiles = getSavedSttProfiles();
    const newProf = {
      id: 'sttp_' + Date.now(),
      name: name.trim(),
      engine: currentEngine,
      apiKey: localStorage.getItem('aetheria_stt_key_' + currentEngine) || localStorage.getItem('aetheria_stt_key') || '',
      customUrl: localStorage.getItem('aetheria_stt_custom_url') || '',
      updatedAt: Date.now()
    };
    profiles.push(newProf);
    saveSttProfiles(profiles);
    localStorage.setItem(ACTIVE_STT_PROFILE_KEY, newProf.id);
    renderSttProfileMenu();
    if (newSttProfileForm) newSttProfileForm.classList.add('hidden');
    if (newSttProfileNameInput) newSttProfileNameInput.value = '';
    showNotification(`✓ Microphone profile "${newProf.name}" saved!`);
  }

  function updateActiveSttProfile() {
    const activeId = localStorage.getItem(ACTIVE_STT_PROFILE_KEY);
    if (!activeId) return;
    const profiles = getSavedSttProfiles();
    const idx = profiles.findIndex(p => p.id === activeId);
    if (idx === -1) return;

    const currentEngine = localStorage.getItem('aetheria_stt_engine') || 'cloudflare';
    profiles[idx] = {
