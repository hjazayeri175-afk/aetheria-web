  async function handleWizardChatSubmit() {
    if (!wizardChatInput) return;
    const rawText = wizardChatInput.value.trim();

    if (wizardCurrentStep === 1) {
      const name = rawText || wizardUserName || 'Traveler';
      wizardUserName = name;
      localStorage.setItem('aetheria_user_display_name', name);
      try {
        if (activeUserPersona) {
          activeUserPersona.name = name;
          localStorage.setItem('aetheria_user_persona', JSON.stringify(activeUserPersona));
        }
      } catch {}
      appendUserBubble(name);
      wizardChatInput.value = '';

      appendNovaBubble(`
        <p class="font-bold text-white">Nice to meet you, <span class="text-purple-300">${name}</span>! ✨</p>
        <p class="text-slate-300">Your persona name is saved. Next, let's choose which AI engine will drive your conversations.</p>
      `);

      setTimeout(goToStep2, 500);
      return;
    }

    if (!rawText) return;

    if (wizardCurrentStep === 3) {
      const key = rawText;
      wizardApiKey = key;
      const maskedKey = key.length > 8 ? `${key.slice(0, 4)}••••••••${key.slice(-4)}` : '••••••••';
      appendUserBubble(`Submitted API Key: ${maskedKey}`);
      wizardChatInput.value = '';

      const loadingBubble = appendNovaBubble(`
        <div class="flex items-center gap-2 text-cyan-300 font-semibold" id="wiz-loader">
          <span class="inline-block w-3.5 h-3.5 border-2 border-cyan-400 border-t-transparent rounded-full animate-spin shrink-0"></span>
          <span>Verifying API key latency and validating connection...</span>
        </div>
      `);

      const result = await runWizardHealthCheck(wizardSelectedProv.id, key, '');
      loadingBubble?.remove();

      if (result.ok && result.models && result.models.length > 0) {
        wizardLatency = result.latency || 95;
        const liveModels = result.models;
        wizardLiveModels = liveModels;

        // Cache live models in localStorage for this provider
        localStorage.setItem('aetheria_synced_models_' + wizardSelectedProv.id, JSON.stringify(liveModels));

        // Sync to manual tab dropdown & inputs
        if (textProviderSelect) textProviderSelect.value = wizardSelectedProv.id;
        if (textApiKey) textApiKey.value = key;
        populateModelDropdown(liveModels, liveModels[0]);
        updateDynamicPresets(liveModels);
        unlockHyperparameters(true);

        appendNovaBubble(`
          <div class="flex items-center justify-between pb-2 border-b border-white/[0.08] gap-2 flex-wrap">
            <span class="text-emerald-400 font-bold flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse shrink-0"></span>
              Connection &amp; API Models Synced!
            </span>
            <span class="text-[10px] text-slate-400 font-mono">Latency: ${wizardLatency}ms • ${liveModels.length} Models from API</span>
          </div>
          <p class="font-semibold text-white pt-1">Select an active model retrieved directly from ${wizardSelectedProv.name}:</p>
          ${liveModels.length > 6 ? `
            <input 
              type="text" 
              id="wiz-model-search-filter" 
              placeholder="Filter ${liveModels.length} models from API..." 
              class="w-full px-3 py-1.5 rounded-lg bg-black/40 border border-white/10 text-xs text-white placeholder-slate-500 outline-none focus:border-purple-500/60 font-mono mt-1 mb-1"
            />
          ` : ''}
          <div class="flex flex-col gap-1.5 pt-1 max-h-56 overflow-y-auto pr-1" id="wiz-model-picker-container">
            ${liveModels.slice(0, 40).map((mId, idx) => `
              <button 
                type="button" 
                data-model-id="${mId}" 
                class="wiz-model-pick-btn w-full text-left px-3 sm:px-3.5 py-2.5 rounded-xl bg-white/[0.04] hover:bg-purple-900/30 border border-white/10 hover:border-purple-500/50 text-xs transition flex items-center justify-between gap-2 group cursor-pointer ${idx === 0 ? 'border-purple-500/50 bg-purple-950/20' : ''}"
              >
                <div class="flex items-center gap-2 min-w-0">
                  <span class="w-2 h-2 rounded-full ${idx === 0 ? 'bg-cyan-400' : 'bg-slate-500'} shrink-0 group-hover:bg-cyan-400"></span>
                  <span class="font-mono text-white group-hover:text-purple-300 truncate">${mId}</span>
                </div>
                ${idx === 0 ? '<span class="text-[9px] text-cyan-300 font-bold px-1.5 py-0.5 rounded bg-cyan-950/60 border border-cyan-500/30 shrink-0">Default</span>' : ''}
              </button>
            `).join('')}
          </div>
        `);

        const bindModelClicks = () => {
          document.querySelectorAll('.wiz-model-pick-btn').forEach(btn => {
            btn.addEventListener('click', () => {
              const mId = btn.getAttribute('data-model-id') || '';
              wizardSelectedModel = mId;
              if (textModelSelect) textModelSelect.value = mId;
              if (textModelInput) textModelInput.value = mId;
              localStorage.setItem('aetheria_text_model', mId);
              appendUserBubble(`Selected model: ${mId}`);

              appendNovaBubble(`
                <p class="font-bold text-emerald-300">✓ Model Confirmed: ${mId}</p>
                <p class="text-slate-300">Your configuration is verified and securely stored in your browser.</p>
                <p class="text-xs text-purple-300 font-semibold pt-1">Proceeding to fine-tune character creativity and memory...</p>
              `);

              setTimeout(goToStep4, 800);
            });
          });
        };
        bindModelClicks();

        const searchInput = document.getElementById('wiz-model-search-filter');
        if (searchInput) {
          searchInput.addEventListener('input', () => {
            const query = searchInput.value.toLowerCase().trim();
            const container = document.getElementById('wiz-model-picker-container');
            if (!container) return;
            const filtered = liveModels.filter(m => m.toLowerCase().includes(query)).slice(0, 40);
            container.innerHTML = filtered.map((mId, idx) => `
              <button 
                type="button" 
                data-model-id="${mId}" 
                class="wiz-model-pick-btn w-full text-left px-3 sm:px-3.5 py-2.5 rounded-xl bg-white/[0.04] hover:bg-purple-900/30 border border-white/10 hover:border-purple-500/50 text-xs transition flex items-center justify-between gap-2 group cursor-pointer ${idx === 0 ? 'border-purple-500/50 bg-purple-950/20' : ''}"
              >
                <div class="flex items-center gap-2 min-w-0">
                  <span class="w-2 h-2 rounded-full ${idx === 0 ? 'bg-cyan-400' : 'bg-slate-500'} shrink-0 group-hover:bg-cyan-400"></span>
                  <span class="font-mono text-white group-hover:text-purple-300 truncate">${mId}</span>
                </div>
              </button>
            `).join('');
            bindModelClicks();
          });
        }
      } else {
        setEmptyModelDropdown();
        appendNovaBubble(`
          <div class="p-3 rounded-xl bg-red-950/50 border border-red-500/40 text-red-200 space-y-1.5">
            <div class="flex items-center gap-1.5 font-bold text-red-300">
              <span>✕</span>
              <span>API Key Validation Failed (${result.status || 'Network Error'})</span>
            </div>
            <p class="text-[11px] leading-relaxed text-red-200">
              ${result.message || 'The provided key was rejected by the provider.'}
            </p>
            <p class="text-[11px] text-slate-300 pt-1">
              Please verify your key from <a href="${wizardSelectedProv.keyUrl}" target="_blank" class="text-cyan-400 underline font-semibold">${wizardSelectedProv.keyText}</a> and paste it again below:
            </p>
          </div>
        `);
        if (wizardChatInput) {
          wizardChatInput.placeholder = 'Paste your valid API key again here...';
          wizardChatInput.focus();
        }
      }
    }
  }

  function goToStep4() {
    wizardCurrentStep = 4;
    wizardChatView?.classList.add('hidden');
    wizardSettingsView?.classList.remove('hidden');
    if (wizardStepBadge) wizardStepBadge.textContent = 'Step 4 of 4: Roleplay Fine-Tuning';

    if (wizSumProv) wizSumProv.textContent = wizardSelectedProv?.name || localStorage.getItem('aetheria_text_provider') || 'Connected Provider';
    if (wizSumModel) wizSumModel.textContent = wizardSelectedModel || localStorage.getItem('aetheria_text_model') || 'Selected Model';

    const currentTemp = localStorage.getItem('aetheria_text_temp') || (sliderTemp?.value || '0.90');
    const currentTokens = localStorage.getItem('aetheria_text_tokens') || (sliderTokens?.value || '450');
    const currentContext = localStorage.getItem('aetheria_text_context') || (sliderContext?.value || '16');
    const currentRepPen = localStorage.getItem('aetheria_text_rep_pen') || (sliderRepPen?.value || '1.10');
    const currentStreaming = localStorage.getItem('aetheria_text_streaming') !== 'false';

    if (wizSliderTemp) {
      wizSliderTemp.value = currentTemp;
      if (wizValTemp) wizValTemp.textContent = Number(currentTemp).toFixed(2);
    }
    if (wizSliderTokens) {
      wizSliderTokens.value = currentTokens;
      if (wizValTokens) wizValTokens.textContent = `${currentTokens} tok`;
    }
    if (wizSliderContext) {
      wizSliderContext.value = currentContext;
      if (wizValContext) wizValContext.textContent = `${currentContext} turns`;
    }
    if (wizSliderRepPen) {
      wizSliderRepPen.value = currentRepPen;
      if (wizValRepPen) wizValRepPen.textContent = Number(currentRepPen).toFixed(2);
    }
    if (wizToggleStreaming) {
      wizToggleStreaming.checked = currentStreaming;
    }

    wizardSettingsView?.scrollIntoView({ behavior: 'smooth' });
  }

  // Hook step 4 actions
  wizBtnReconfigure?.addEventListener('click', () => {
    wizardChatView?.classList.remove('hidden');
    wizardSettingsView?.classList.add('hidden');
    goToStep2();
