      engineTabBtns.forEach(b => {
        b.className = 'engine-tab-btn px-4 py-2.5 text-xs font-bold rounded-t-xl transition flex items-center gap-2 cursor-pointer border-b-2 border-transparent text-slate-400 hover:text-slate-200';
      });
      btn.className = 'engine-tab-btn px-4 py-2.5 text-xs font-bold rounded-t-xl transition flex items-center gap-2 cursor-pointer border-b-2 border-purple-500 text-purple-300 bg-purple-950/30';

      engineTabPanes.forEach(pane => {
        pane.classList.toggle('hidden', pane.id !== targetId);
      });
    });
  });

  // Quick Model Pills
  document.querySelectorAll('.quick-model-pill').forEach(pill => {
    pill.addEventListener('click', () => {
      const model = pill.getAttribute('data-model');
      if (model && textModelInput) {
        textModelInput.value = model;
      }
    });
  });

  // Quick Voice Pills
  document.querySelectorAll('.quick-voice-pill').forEach(pill => {
    pill.addEventListener('click', () => {
      const voice = pill.getAttribute('data-voice');
      if (voice && voiceIdInput) {
        voiceIdInput.value = voice;
      }
    });
  });

  // Show/Hide Key toggle
  toggleKeyVisibility?.addEventListener('click', () => {
    if (textApiKey) {
      textApiKey.type = textApiKey.type === 'password' ? 'text' : 'password';
    }
  });

  // Test Latency (Ping)
  pingTextBtn?.addEventListener('click', async () => {
    if (!pingStatusMsg) return;
    pingStatusMsg.classList.remove('hidden');
    pingStatusMsg.className = 'text-xs px-3.5 py-2 rounded-xl border bg-purple-950/40 border-purple-500/30 text-purple-300 flex items-center gap-2';
    pingStatusMsg.innerHTML = '<span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span><span>Measuring connection latency...</span>';

    const t0 = performance.now();
    try {
      const prov = textProviderSelect?.value || 'demo';
      const key = textApiKey?.value.trim() || '';
      
      if (prov === 'demo') {
        await new Promise(r => setTimeout(r, 120));
        const dt = Math.round(performance.now() - t0);
        pingStatusMsg.className = 'text-xs px-3.5 py-2 rounded-xl border bg-emerald-950/40 border-emerald-500/30 text-emerald-300';
        pingStatusMsg.innerHTML = `✓ Free Edge Simulator Ready • Latency: ${dt}ms`;
        return;
      }

      if (!key) {
        pingStatusMsg.className = 'text-xs px-3.5 py-2 rounded-xl border bg-amber-950/40 border-amber-500/30 text-amber-300';
        pingStatusMsg.innerHTML = '⚠️ Please enter your API Key before testing connection.';
        return;
      }

      // Quick probe
      let endpoint = 'https://api.groq.com/openai/v1/models';
      let headers = { 'Authorization': `Bearer ${key}` };
      if (prov === 'openrouter') endpoint = 'https://openrouter.ai/api/v1/models';
      if (prov === 'deepseek') endpoint = 'https://api.deepseek.com/models';
      if (prov === 'openai') endpoint = 'https://api.openai.com/v1/models';
      if (prov === 'custom') endpoint = (textBaseUrl?.value.trim() || 'http://localhost:11434/v1') + '/models';

      const res = await fetch(endpoint, { method: 'GET', headers });
      const dt = Math.round(performance.now() - t0);
      if (res.ok) {
        pingStatusMsg.className = 'text-xs px-3.5 py-2 rounded-xl border bg-emerald-950/40 border-emerald-500/30 text-emerald-300';
        pingStatusMsg.innerHTML = `✓ Connection Successful (${prov.toUpperCase()}) • Latency: ${dt}ms`;
      } else {
        pingStatusMsg.className = 'text-xs px-3.5 py-2 rounded-xl border bg-red-950/40 border-red-500/30 text-red-300';
        pingStatusMsg.innerHTML = `✕ HTTP ${res.status}: Check your API key or model name.`;
      }
    } catch (err) {
      pingStatusMsg.className = 'text-xs px-3.5 py-2 rounded-xl border bg-amber-950/40 border-amber-500/30 text-amber-300';
      pingStatusMsg.innerHTML = `⚠️ Direct ping blocked by browser CORS policy. Key will be sent during direct chat.`;
    }
  });

  // Test Voice button
  testVoiceBtn?.addEventListener('click', () => {
    const prov = voiceProviderSelect?.value || 'browser';
    const rate = parseFloat(sliderVoiceRate?.value || '1.0');
    const pitch = parseFloat(sliderVoicePitch?.value || '1.0');
    
    if (window.speechSynthesis) {
      window.speechSynthesis.cancel();
      const utterance = new SpeechSynthesisUtterance(`Greetings traveler. I am ${character.name}. This is a live voice preview.`);
      utterance.rate = rate;
      utterance.pitch = pitch;
      utterance.lang = 'en-US';
      window.speechSynthesis.speak(utterance);
      showNotification('Playing speech synthesis preview...');
    }
  });

  // Test Image button
  testImageBtn?.addEventListener('click', () => {
    if (!testImagePreview || !testImagePreviewContainer) return;
    testImagePreviewContainer.classList.remove('hidden');
    const prompt = encodeURIComponent(`${character.name}, ${character.title}, aesthetic studio portrait, dramatic cinematic lighting, masterpiece 8k`);
    const seed = Math.floor(Math.random() * 1000000);
    const testUrl = `https://image.pollinations.ai/prompt/${prompt}?width=512&height=512&seed=${seed}&nologo=true`;
    
    testImagePreview.src = testUrl;
    showNotification('Rendering in-chat test image preview...');
  });

  // Reset Defaults
  resetDefaultsBtn?.addEventListener('click', () => {
    if (confirm('Reset all 4 engine settings to optimal roleplay defaults?')) {
      localStorage.removeItem('aetheria_text_provider');
      localStorage.removeItem('aetheria_text_key');
      localStorage.removeItem('aetheria_text_base_url');
      localStorage.removeItem('aetheria_text_model');
      localStorage.removeItem('aetheria_text_temp');
      localStorage.removeItem('aetheria_text_tokens');
      localStorage.removeItem('aetheria_text_top_p');
      localStorage.removeItem('aetheria_text_rep_pen');
      localStorage.removeItem('aetheria_text_freq_pen');
      localStorage.removeItem('aetheria_text_pres_pen');
      localStorage.removeItem('aetheria_text_context');
      localStorage.removeItem('aetheria_text_streaming');
      localStorage.removeItem('aetheria_voice_provider');
      localStorage.removeItem('aetheria_voice_key');
      localStorage.removeItem('aetheria_image_provider');
      localStorage.removeItem('aetheria_video_provider');
      loadEngineSettings();
      showNotification('Restored optimal roleplay defaults.');
    }
  });

  // Modal Open/Close
  byokBtn?.addEventListener('click', () => byokTray?.classList.remove('hidden'));
  closeByok?.addEventListener('click', () => byokTray?.classList.add('hidden'));
  cancelByok?.addEventListener('click', () => byokTray?.classList.add('hidden'));
  saveEngineBtn?.addEventListener('click', saveAllSettings);

  // Close modal on backdrop click
  byokTray?.addEventListener('click', (e) => {
    if (e.target === byokTray) byokTray.classList.add('hidden');
  });

  // Init Chat Function
  function initChat() {
    const saved = localStorage.getItem(STORAGE_KEY);
    if (saved) {
      try {
        conversation = JSON.parse(saved);
      } catch (e) {
        conversation = [];
      }
    }

    if (conversation.length === 0) {
      conversation.push({
        sender: 'character',
        text: character.greeting,
        timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
      });
      saveChat();
    }

    renderAllMessages();
    loadEngineSettings();
  }

  function saveChat() {
    localStorage.setItem(STORAGE_KEY, JSON.stringify(conversation));
  }

  function renderAllMessages() {
    if (!chatStream) return;
    chatStream.innerHTML = '';
    conversation.forEach((msg, idx) => {
      appendMessageToDOM(msg, idx);
    });
    chatStream.scrollTop = chatStream.scrollHeight;
  }

  function appendMessageToDOM(msg, idx) {
    if (!chatStream) return;
    const isChar = msg.sender === 'character';
    
    const wrapper = document.createElement('div');
    wrapper.className = isChar 
      ? 'flex items-start gap-3 max-w-2xl'
      : 'flex items-start gap-3 max-w-2xl ml-auto justify-end';

    if (isChar) {
      wrapper.innerHTML = `
        <img src="${character.avatarUrl}" alt="${character.name}" class="w-8 h-8 rounded-full object-cover ring-1 ring-purple-500/30 shrink-0 mt-1" />
        <div class="space-y-1">
          <div class="flex items-center gap-2">
            <span class="text-xs font-bold text-slate-200">${character.name}</span>
            <span class="text-[10px] text-slate-500">${msg.timestamp || 'Just now'}</span>
          </div>
          <div class="p-3.5 sm:p-4 rounded-2xl rounded-tl-sm bg-[#101426] border border-white/[0.08] text-xs sm:text-sm text-slate-200 leading-relaxed shadow-md">
            ${formatMessageText(msg.text)}
          </div>
          <div class="flex items-center gap-2 pt-0.5">
            <button class="msg-speak-btn text-[10px] text-slate-500 hover:text-purple-400 flex items-center gap-1 transition cursor-pointer" data-idx="${idx}">
              <span>🔊 Listen</span>
            </button>
            <button class="msg-copy-btn text-[10px] text-slate-500 hover:text-slate-300 flex items-center gap-1 transition cursor-pointer" data-text="${encodeURIComponent(msg.text)}">
              <span>📋 Copy</span>
            </button>
          </div>
        </div>
      `;
    } else {
      wrapper.innerHTML = `
        <div class="space-y-1 text-right">
          <div class="flex items-center justify-end gap-2">
            <span class="text-[10px] text-slate-500">${msg.timestamp || 'Just now'}</span>
            <span class="text-xs font-bold text-purple-300">You</span>
          </div>
          <div class="p-3.5 sm:p-4 rounded-2xl rounded-tr-sm bg-gradient-to-r from-purple-700 to-indigo-600 text-white text-xs sm:text-sm leading-relaxed shadow-lg shadow-purple-950/40 text-left">
            ${msg.text}
          </div>
        </div>
        <div class="w-8 h-8 rounded-full bg-purple-600 flex items-center justify-center text-white text-xs font-bold shrink-0 mt-1">
          U
        </div>
      `;
    }

    chatStream.appendChild(wrapper);
  }

  // Voice speech synthesis
  function speak(text) {
    if (!ttsEnabled || !window.speechSynthesis) return;
    const filterActions = localStorage.getItem('aetheria_voice_filter') !== 'false';
    let cleanText = text;
    if (filterActions) {
      cleanText = text.replace(/\*[^*]+\*/g, '').trim();
    }
    if (!cleanText) return;

    window.speechSynthesis.cancel();
    const utterance = new SpeechSynthesisUtterance(cleanText);
    utterance.rate = parseFloat(localStorage.getItem('aetheria_voice_rate') || '1.0');
    utterance.pitch = parseFloat(localStorage.getItem('aetheria_voice_pitch') || '1.0');
    utterance.lang = 'en-US';
    window.speechSynthesis.speak(utterance);
  }

  // Send message & AI Generation
  async function handleSendMessage(userText) {
    if (!userText.trim()) return;

    const userMsg = {
      sender: 'user',
      text: userText.trim(),
      timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
    };

    conversation.push(userMsg);
    saveChat();
    appendMessageToDOM(userMsg, conversation.length - 1);
    if (chatStream) chatStream.scrollTop = chatStream.scrollHeight;

    if (input) {
      input.value = '';
      input.style.height = 'auto';
    }

    // Show typing
    if (typingIndicator) {
      typingIndicator.classList.remove('hidden');
      if (chatStream) chatStream.scrollTop = chatStream.scrollHeight;
    }

    const provider = localStorage.getItem('aetheria_text_provider') || 'demo';
    const apiKey = localStorage.getItem('aetheria_text_key') || '';
    const model = localStorage.getItem('aetheria_text_model') || 'llama-3.3-70b-versatile';
    const temp = parseFloat(localStorage.getItem('aetheria_text_temp') || '0.85');
    const maxTokens = parseInt(localStorage.getItem('aetheria_text_tokens') || '350', 10);
    const topP = parseFloat(localStorage.getItem('aetheria_text_top_p') || '0.95');

    let replyText = '';

    // If BYOK key provided and not demo, attempt direct API call
    if (apiKey && provider !== 'demo') {
      try {
        let endpoint = 'https://api.groq.com/openai/v1/chat/completions';
        if (provider === 'openrouter') endpoint = 'https://openrouter.ai/api/v1/chat/completions';
        if (provider === 'deepseek') endpoint = 'https://api.deepseek.com/chat/completions';
        if (provider === 'openai') endpoint = 'https://api.openai.com/v1/chat/completions';
        if (provider === 'custom') {
          const base = localStorage.getItem('aetheria_text_base_url') || 'http://localhost:11434/v1';
          endpoint = base.replace(/\/+$/, '') + '/chat/completions';
        }

        // Build system prompt with persona context
        const systemPrompt = `You are roleplaying as ${character.name}, ${character.title}.
Character Persona & Traits: ${character.description}
Tags: ${character.tags.join(', ')}
Behavioral Instructions: Stay fully in character. Adhere strictly to SFW standards. Use *asterisks* for expressive physical actions and sensory details, and use quotes for spoken dialogue. Respond with evocative emotional depth.`;

        // Build recent history
        const contextLimit = parseInt(localStorage.getItem('aetheria_text_context') || '16', 10);
        const historySlice = conversation.slice(-contextLimit).map(m => ({
          role: m.sender === 'user' ? 'user' : 'assistant',
          content: m.text
        }));

        const messages = [
          { role: 'system', content: systemPrompt },
          ...historySlice
        ];

        const res = await fetch(endpoint, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${apiKey}`,
            ...(provider === 'openrouter' ? { 'HTTP-Referer': 'https://aetheria.ai', 'X-Title': 'Aetheria AI' } : {})
          },
          body: JSON.stringify({
            model: model,
            messages: messages,
            temperature: temp,
            max_tokens: maxTokens,
            top_p: topP
          })
        });

        if (res.ok) {
          const data = await res.json();
          replyText = data.choices?.[0]?.message?.content || '';
        } else {
          console.warn('API returned error status, falling back to simulator', res.status);
        }
      } catch (err) {
        console.warn('API call failed, falling back to persona engine', err);
      }
    }

    // Fallback response generator if API was not configured or errored
    if (!replyText) {
      await new Promise(r => setTimeout(r, 700 + Math.random() * 500));
      replyText = pickResponse(userText);
    }

    if (typingIndicator) typingIndicator.classList.add('hidden');

    const charMsg = {
      sender: 'character',
      text: replyText,
      timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
    };

    conversation.push(charMsg);
    saveChat();
    appendMessageToDOM(charMsg, conversation.length - 1);
    if (chatStream) chatStream.scrollTop = chatStream.scrollHeight;

    if (ttsEnabled || localStorage.getItem('aetheria_voice_autoplay') === 'true') {
      speak(replyText);
    }
  }

  function pickResponse(userText) {
    const replies = character.fallbackReplies || [];
    if (replies.length === 0) {
      return `*Smiles faintly and leans in closer.* "Your thoughts resonate with an intriguing cadence. Tell me what else is on your mind."`;
    }
    const idx = Math.floor(Math.random() * replies.length);
    return replies[idx];
  }

  // Event Listeners
  inputForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (input) handleSendMessage(input.value);
  });

  input?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      handleSendMessage(input.value);
    }
  });

  // Auto-resize textarea
  input?.addEventListener('input', () => {
    input.style.height = 'auto';
    input.style.height = `${Math.min(input.scrollHeight, 128)}px`;
  });

  // Starter prompts
  starterPills.forEach((btn) => {
    btn.addEventListener('click', () => {
      const prompt = btn.getAttribute('data-prompt');
      if (prompt && input) {
        input.value = prompt;
        input.focus();
        handleSendMessage(prompt);
      }
    });
  });

  // Toggle Lore Sidebar
  toggleSidebarBtn?.addEventListener('click', () => {
    sidebar?.classList.toggle('hidden');
    sidebar?.classList.toggle('flex');
  });

  // Toggle Voice TTS
  toggleTtsBtn?.addEventListener('click', () => {
    ttsEnabled = !ttsEnabled;
    ttsIconOn?.classList.toggle('hidden', !ttsEnabled);
    ttsIconOff?.classList.toggle('hidden', ttsEnabled);
    showNotification(ttsEnabled ? 'Voice Read Aloud enabled' : 'Voice Read Aloud muted');
  });

  // Clear chat
  clearChatBtn?.addEventListener('click', () => {
    if (confirm(`Reset conversation history with ${character.name}?`)) {
      conversation = [{
        sender: 'character',
        text: character.greeting,
        timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
      }];
      saveChat();
      renderAllMessages();
      showNotification('Conversation reset to beginning.');
    }
  });

  // Export chat
  exportChatBtn?.addEventListener('click', () => {
    let md = `# Conversation with ${character.name}\n\n`;
    conversation.forEach((msg) => {
      const name = msg.sender === 'character' ? character.name : 'You';
      md += `**[${msg.timestamp || ''}] ${name}:**\n${msg.text}\n\n`;
    });
    const blob = new Blob([md], { type: 'text/markdown' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${character.name.toLowerCase().replace(/\s+/g, '_')}_chat.md`;
    a.click();
    URL.revokeObjectURL(url);
    showNotification('Chat exported to Markdown file!');
  });

  // Delegate copy and speak
  document.addEventListener('click', (e) => {
    const target = e.target;
    const copyBtn = target.closest('.msg-copy-btn');
    if (copyBtn) {
      const text = decodeURIComponent(copyBtn.getAttribute('data-text') || '');
      navigator.clipboard.writeText(text);
      showNotification('Copied message to clipboard!');
      return;
    }

    const speakBtn = target.closest('.msg-speak-btn');
    if (speakBtn) {
      const idx = parseInt(speakBtn.getAttribute('data-idx') || '0', 10);
      const msg = conversation[idx];
      if (msg) speak(msg.text);
    }
  });

  // Startup
  initChat();
</script>
