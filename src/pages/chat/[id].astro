      if (videoDurationSelect) localStorage.setItem('aetheria_video_duration', videoDurationSelect.value);

      if (engineLabel) {
        const pName = PROVIDER_CONFIGS[prov]?.name || 'Engine';
        engineLabel.textContent = pName;
      }
    } catch (saveErr) {
