  function escapeHtml(str) {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function showNotification(msg, type = 'info') {
    let container = document.getElementById('aetheria-toast-container');
    if (!container) {
      container = document.createElement('div');
      container.id = 'aetheria-toast-container';
      container.className = 'fixed bottom-5 right-5 z-[9999] flex flex-col gap-2 max-w-sm pointer-events-none';
      document.body.appendChild(container);
    }
    const toast = document.createElement('div');
    const isErr = type === 'error' || msg.includes('⚠️') || msg.includes('error') || msg.includes('Failed');
    toast.className = `px-4 py-2.5 rounded-2xl text-xs font-medium backdrop-blur-md shadow-2xl transition-all duration-300 pointer-events-auto transform translate-y-4 opacity-0 border ${
      isErr 
        ? 'bg-rose-950/85 text-rose-200 border-rose-500/40 shadow-rose-950/50' 
        : 'bg-[#0f132a]/90 text-purple-200 border-purple-500/30 shadow-purple-950/50'
    }`;
    toast.textContent = msg;
    container.appendChild(toast);
    requestAnimationFrame(() => {
      toast.classList.remove('translate-y-4', 'opacity-0');
    });
    setTimeout(() => {
      toast.classList.add('opacity-0', 'translate-y-2');
      setTimeout(() => toast.remove(), 300);
    }, 3500);
  }

