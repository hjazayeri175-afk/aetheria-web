        </div>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 pt-1" id="wiz-active-actions">
        <button type="button" id="wiz-act-tune" class="w-full py-2.5 px-3 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white font-bold text-xs transition cursor-pointer flex items-center justify-center gap-1.5 shadow-md shadow-purple-950/60">
          <span>⚙️</span>
          <span>Fine-Tune Parameters</span>
        </button>
        <button type="button" id="wiz-act-reconfig" class="w-full py-2.5 px-3 rounded-xl bg-white/[0.06] hover:bg-white/[0.12] border border-white/10 text-slate-200 hover:text-white font-bold text-xs transition cursor-pointer flex items-center justify-center gap-1.5">
          <span>🔄</span>
          <span>Change Provider / Key</span>
        </button>
      </div>
    `);

    document.getElementById('wiz-act-tune')?.addEventListener('click', () => {
      goToStep4();
    });
    document.getElementById('wiz-act-reconfig')?.addEventListener('click', () => {
      goToStep2();
    });

    if (wizardChatInput) {
      wizardChatInput.value = '';
      wizardChatInput.placeholder = 'Type to change persona name or select action above...';
      wizardChatInput.type = 'text';
