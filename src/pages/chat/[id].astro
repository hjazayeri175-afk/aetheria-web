          <span class="w-2 h-2 rounded-full ${!activeId ? 'bg-emerald-400' : 'bg-slate-500'}"></span>
          <span class="truncate">Fal.ai Kling 1.5 Pro (Default)</span>
        </div>
        ${!activeId ? '<span class="text-[10px] text-cyan-300 font-mono">Active</span>' : ''}
      </button>
    `;

    profiles.forEach(p => {
      const isSel = p.id === activeId;
      html += `
        <button 
          type="button" 
          class="video-profile-item w-full px-3 py-2 rounded-xl text-left transition flex items-center justify-between text-xs cursor-pointer ${
            isSel ? 'bg-cyan-600/30 text-white font-semibold border border-cyan-500/40' : 'text-slate-300 hover:bg-white/[0.06] hover:text-white'
