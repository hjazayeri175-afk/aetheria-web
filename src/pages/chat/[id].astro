          <button id="prompt-modal-cancel" type="button" class="h-10 px-5 rounded-full text-xs sm:text-sm font-medium text-slate-300 hover:text-white hover:bg-white/[0.08] active:scale-95 transition-all text-center cursor-pointer">
            ${escapeHtml(cancelText)}
          </button>
          <button id="prompt-modal-confirm" type="button" class="h-10 px-6 rounded-full text-xs sm:text-sm font-semibold transition-all active:scale-95 text-center cursor-pointer flex items-center justify-center gap-1.5 bg-gradient-to-r from-emerald-600 to-teal-600 hover:from-emerald-500 hover:to-teal-500 text-white shadow-md shadow-emerald-950/40">
            ${escapeHtml(confirmText)}
          </button>
        </div>
      `;

      backdrop.appendChild(modal);
      document.body.appendChild(backdrop);

      const input = modal.querySelector('#prompt-modal-input');
      requestAnimationFrame(() => {
        backdrop.classList.remove('opacity-0');
        modal.classList.remove('scale-95', 'opacity-0');
        if (input) {
          input.focus();
          input.select();
        }
      });

      const cleanup = (val) => {
        backdrop.classList.add('opacity-0');
        modal.classList.add('scale-95', 'opacity-0');
        setTimeout(() => backdrop.remove(), 200);
        window.removeEventListener('keydown', onKeyDown);
        resolve(val);
      };

      const confirmBtn = modal.querySelector('#prompt-modal-confirm');
      const cancelBtn = modal.querySelector('#prompt-modal-cancel');
      if (confirmBtn) {
        confirmBtn.onclick = () => {
          const val = input ? input.value.trim() : '';
          cleanup(val || defaultValue || null);
        };
      }
      if (cancelBtn) cancelBtn.onclick = () => cleanup(null);
      backdrop.onclick = (e) => {
        if (e.target === backdrop) cleanup(null);
      };

      const onKeyDown = (e) => {
        if (e.key === 'Escape') {
          cleanup(null);
        } else if (e.key === 'Enter') {
          e.preventDefault();
          const val = input ? input.value.trim() : '';
          cleanup(val || defaultValue || null);
        }
      };
      window.addEventListener('keydown', onKeyDown);
    });
