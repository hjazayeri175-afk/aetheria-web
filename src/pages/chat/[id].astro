  // Helper: Set empty state for model dropdown when not connected
  function setEmptyModelDropdown() {
    currentSyncedModels = [];
    if (!textModelSelect) return;
    textModelSelect.innerHTML = '<option value="" disabled selected>No API Key — Enter key to load models</option>';
    textModelSelect.disabled = true;
    if (textModelInput) textModelInput.value = '';
    updateCustomModelTrigger('');
    if (modelCountBadge) modelCountBadge.textContent = '0 Models';
    if (dynamicPresetsContainer) {
      dynamicPresetsContainer.innerHTML = '<span class="text-[10px] text-slate-500 italic">No models loaded. Connect API key to sync.</span>';
    }
  }

  // Populate dynamic model select dropdown
  function populateModelDropdown(models, selected, allowUnknown = false) {
    if (!textModelSelect) return;
    const unique = Array.from(new Set(models || [])).filter(Boolean);
    currentSyncedModels = unique;

    if (unique.length === 0) {
      setEmptyModelDropdown();
      return;
    }
    textModelSelect.disabled = false;
    textModelSelect.innerHTML = '';
    unique.forEach(m => {
      const opt = document.createElement('option');
      opt.value = m;
      opt.textContent = m;
      if (m === selected) opt.selected = true;
      textModelSelect.appendChild(opt);
    });

    let finalSelected = selected;
    if (selected && !unique.includes(selected)) {
      if (allowUnknown) {
        const opt = document.createElement('option');
        opt.value = selected;
        opt.textContent = selected;
        opt.selected = true;
        textModelSelect.prepend(opt);
      } else {
        finalSelected = unique[0];
        if (textModelSelect.options.length > 0) {
          textModelSelect.options[0].selected = true;
        }
      }
    } else if (!selected) {
      finalSelected = unique[0];
      if (textModelSelect.options.length > 0) {
        textModelSelect.options[0].selected = true;
      }
    }

    if (textModelInput) {
      textModelInput.value = finalSelected;
    }
    updateCustomModelTrigger(finalSelected);
    if (modelCountBadge) {
      modelCountBadge.textContent = `${unique.length} Models`;
    }
  }

  // Update quick clickable preset pills
  function updateDynamicPresets(models) {
    if (!dynamicPresetsContainer) return;
    dynamicPresetsContainer.innerHTML = '';
    const wrapper = document.getElementById('dynamic-presets-wrapper');
    const valid = (models || []).filter(Boolean);
    if (valid.length === 0) {
      if (wrapper) wrapper.classList.add('hidden');
      return;
    }
    if (wrapper) wrapper.classList.remove('hidden');
    const slice = valid.slice(0, 6);
    slice.forEach(m => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = 'quick-model-pill text-[10px] px-2 py-0.5 rounded-lg bg-white/[0.04] hover:bg-purple-950 text-slate-300 hover:text-purple-300 border border-white/10 transition cursor-pointer';
      const shortName = m.split('/').pop() || m;
      btn.textContent = shortName;
      btn.title = m;
      btn.setAttribute('data-model', m);
      btn.addEventListener('click', () => {
        if (textModelSelect) {
          textModelSelect.value = m;
          if (textModelSelect.value !== m) {
            const opt = document.createElement('option');
            opt.value = m;
            opt.textContent = m;
            opt.selected = true;
            textModelSelect.prepend(opt);
          }
        }
        if (textModelInput) textModelInput.value = m;
        localStorage.setItem('aetheria_text_model', m);
        updateCustomModelTrigger(m);
        updateHeaderPill();
      });
      dynamicPresetsContainer.appendChild(btn);
    });
  }

  // Extract model IDs from diverse provider responses (Zero hardcoding, live API only)
  function extractModelIds(data, provider) {
    if (!data) return [];
    let list = [];
    if (data.models && Array.isArray(data.models)) {
      list = data.models
        .filter(m => !m.supportedGenerationMethods || m.supportedGenerationMethods.includes('generateContent'))
        .map(m => (m.name || '').replace(/^models\//, ''))
        .filter(Boolean);
    } else if (data.data && Array.isArray(data.data)) {
      list = data.data.map(m => m.id || m.name).filter(Boolean);
    } else if (Array.isArray(data)) {
      list = data.map(m => (typeof m === 'string' ? m : (m.id || m.name))).filter(Boolean);
    }

    // Filter out non-chat / auxiliary models (embeddings, tts, whisper, audio, moderation, dall-e, imagen)
    list = list.filter(id => {
      const lower = id.toLowerCase();
      return !lower.includes('embed') && 
             !lower.includes('whisper') && 
             !lower.includes('tts') && 
             !lower.includes('moderation') && 
             !lower.includes('dall-e') && 
             !lower.includes('imagen') &&
             !lower.includes('aqa');
    });

    // Natural sort descending so newest versions (e.g. 3.8, 3.7, 2.5) appear at top
    list.sort((a, b) => b.localeCompare(a, undefined, { numeric: true, sensitivity: 'base' }));

    // For OpenRouter: prioritize top-tier roleplay models
    if (provider === 'openrouter') {
      const topPicks = [
        'deepseek/deepseek-chat',
        'deepseek/deepseek-r1',
        'anthropic/claude-3.5-sonnet',
        'anthropic/claude-3.7-sonnet',
        'meta-llama/llama-3.3-70b-instruct',
        'google/gemini-2.0-flash-001',
        'google/gemini-flash-1.5',
        'neversleep/llama-3-lumimaid-70b',
        'nousresearch/hermes-3-llama-3.1-405b',
        'mistralai/mistral-large-2407'
      ];
      const featured = [];
      const others = [];
      list.forEach(id => {
        const found = topPicks.find(p => id.toLowerCase() === p.toLowerCase() || id.toLowerCase().startsWith(p.toLowerCase()));
        if (found) featured.push(id);
        else others.push(id);
      });
      list = [...new Set([...featured, ...others])];
    }

    return list;
  }

  // Fetch live model list from provider endpoint (Zero guessing, API-driven)
  async function fetchModelsForProvider(provArg, keyArg, baseUrlArg) {
    const isEvent = provArg && typeof provArg === 'object' && provArg.preventDefault;
    if (isEvent) provArg.preventDefault();
    const prov = (typeof provArg === 'string' ? provArg : (textProviderSelect?.value || 'groq'));
    const conf = PROVIDER_CONFIGS[prov] || PROVIDER_CONFIGS.groq;
    const key = (typeof keyArg === 'string' ? keyArg : (textApiKey?.value.trim() || localStorage.getItem('aetheria_text_key') || ''));
    const baseUrl = (typeof baseUrlArg === 'string' ? baseUrlArg : (textBaseUrl?.value.trim() || conf.defaultUrl || ''));

    if (prov === 'perplexity') {
      const pModels = ['sonar-pro', 'sonar', 'sonar-reasoning'];
      localStorage.setItem('aetheria_synced_models_perplexity', JSON.stringify(pModels));
      populateModelDropdown(pModels, pModels[0], false);
      updateDynamicPresets(pModels);
      localStorage.setItem('aetheria_text_model', pModels[0]);
      localStorage.setItem('aetheria_model_perplexity', pModels[0]);
      updateHeaderPill();
      showNotification('✓ Loaded active Perplexity Sonar models!');
      return pModels;
    }

    if (conf.hasKey && !conf.isKeyOptional && !key) {
      showNotification('⚠️ Please enter an API key first before fetching models.');
      textApiKey?.focus();
      return [];
    }

    if (fetchModelsIcon) fetchModelsIcon.classList.add('animate-spin');
    if (fetchModelsText) fetchModelsText.textContent = 'Fetching...';
    if (fetchModelsBtn) fetchModelsBtn.disabled = true;

    let models = [];
    try {
      let endpoint = conf.modelsEndpoint;
      if (conf.hasUrl) {
        endpoint = `${baseUrl.replace(/\/+$/, '')}/models`;
      } else if (prov === 'google') {
        endpoint = `https://generativelanguage.googleapis.com/v1beta/models?key=${key}`;
      } else if (prov === 'anthropic') {
        endpoint = 'https://api.anthropic.com/v1/models';
      }

      let responseData = null;
      let isSuccess = false;

      // 1. Direct browser fetch attempt
      try {
        const headers = {};
        if (key && prov !== 'google') {
          if (prov === 'anthropic') {
            headers['x-api-key'] = key;
            headers['anthropic-version'] = '2023-06-01';
            headers['anthropic-dangerous-direct-browser-access'] = 'true';
          } else {
            headers['Authorization'] = `Bearer ${key}`;
          }
        } else if (key && prov === 'google') {
          headers['x-goog-api-key'] = key;
        }
        if (prov === 'openrouter') {
          headers['HTTP-Referer'] = 'https://aetheria.ai';
          headers['X-Title'] = 'Aetheria AI';
        }

        const res = await fetch(endpoint, { method: 'GET', headers });
        if (res.ok) {
          responseData = await res.json();
          isSuccess = true;
        }
      } catch (directErr) {
        // Direct fetch failed (CORS or network), fallback to edge proxy
      }

      // 2. Serverless proxy fallback
      if (!isSuccess) {
        try {
          const proxyRes = await fetch('/api/proxy/fetch-models', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
              endpoint,
              apiKey: key,
              headers: prov === 'openrouter' ? { 'HTTP-Referer': 'https://aetheria.ai', 'X-Title': 'Aetheria AI' } : {}
            })
          });
          if (proxyRes.ok) {
            const pJson = await proxyRes.json();
            responseData = pJson.data || pJson;
            isSuccess = true;
          }
        } catch (proxyErr) {
          console.error('Edge proxy fetch failed:', proxyErr);
        }
      }

      if (isSuccess && responseData) {
        models = extractModelIds(responseData, prov);
        if (models && models.length > 0) {
          localStorage.setItem('aetheria_synced_models_' + prov, JSON.stringify(models));
          populateModelDropdown(models, models[0], false);
          updateDynamicPresets(models);
          localStorage.setItem('aetheria_text_model', models[0]);
          localStorage.setItem('aetheria_model_' + prov, models[0]);

          // Update active profile if applicable
          const activeProfId = localStorage.getItem(ACTIVE_PROFILE_KEY);
          if (activeProfId) {
            const profs = getSavedApiProfiles();
            const p = profs.find(x => x.id === activeProfId);
            if (p && p.provider === prov) {
              p.syncedModels = models;
              p.model = models[0];
              p.updatedAt = Date.now();
              saveApiProfilesToStorage(profs);
              renderApiProfilesDropdown(activeProfId);
            }
          }
          updateHeaderPill();
          showNotification(`✓ Successfully loaded ${models.length} live models from ${conf.name} API!`);
        } else {
          setEmptyModelDropdown();
          showNotification(`⚠️ Connected to ${conf.name}, but no text generation models were returned.`);
        }
      } else {
        setEmptyModelDropdown();
        showNotification(`⚠️ Could not authenticate with ${conf.name}. Please check your API key.`);
      }
    } catch (err) {
      setEmptyModelDropdown();
      showNotification('⚠️ Connection error while fetching models from API.');
    } finally {
      if (fetchModelsIcon) fetchModelsIcon.classList.remove('animate-spin');
      if (fetchModelsText) fetchModelsText.textContent = 'Fetch Models';
      if (fetchModelsBtn) fetchModelsBtn.disabled = false;
    }
    return models;
  }

  // Helper: Core test ping runner for Text AI
  async function runTextPingTest(prov, key, baseUrl) {
    const conf = PROVIDER_CONFIGS[prov] || PROVIDER_CONFIGS.groq;
    const t0 = performance.now();
    let endpoint = conf.modelsEndpoint;
    if (conf.hasUrl) {
      endpoint = `${(baseUrl || conf.defaultUrl || '').replace(/\/+$/, '')}/models`;
    } else if (prov === 'google') {
      endpoint = `https://generativelanguage.googleapis.com/v1beta/models?key=${key}`;
    } else if (prov === 'anthropic') {
      endpoint = 'https://api.anthropic.com/v1/models';
    }

    let resOk = false;
    let resStatus = 0;
    let errorText = '';

    try {
      const headers = {};
      if (key && prov !== 'google') {
        if (prov === 'anthropic') {
          headers['x-api-key'] = key;
          headers['anthropic-version'] = '2023-06-01';
          headers['anthropic-dangerous-direct-browser-access'] = 'true';
        } else {
          headers['Authorization'] = `Bearer ${key}`;
        }
      } else if (key && prov === 'google') {
        headers['x-goog-api-key'] = key;
      }

      const res = await fetch(endpoint, { method: 'GET', headers });
      resOk = res.ok;
      resStatus = res.status;
      if (!res.ok) {
        const txt = await res.text().catch(() => '');
        try {
          const j = JSON.parse(txt);
          errorText = j.error?.message || j.message || `HTTP ${res.status}`;
        } catch {
          errorText = `HTTP ${res.status}`;
        }
      }
    } catch (err) {
      // Fallback via Worker CORS Proxy
      try {
        const pRes = await fetch('/api/proxy/fetch-models', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ endpoint, apiKey: key })
        });
        resOk = pRes.ok;
        resStatus = pRes.status;
        if (!pRes.ok) {
          const txt = await pRes.text().catch(() => '');
          try {
            const j = JSON.parse(txt);
            errorText = j.error?.message || j.message || `HTTP ${pRes.status}`;
          } catch {
            errorText = `HTTP ${pRes.status}`;
          }
        }
      } catch (proxyErr) {
        resOk = false;
        errorText = (proxyErr && proxyErr.message) ? proxyErr.message : 'Network request failed';
      }
    }

    const dt = Math.round(performance.now() - t0);
    return { ok: resOk, status: resStatus, latency: dt, error: errorText };
  }

  // Live Test button inside Connected Card
  async function pingTextConnection() {
    const prov = textProviderSelect?.value || 'groq';
    const conf = PROVIDER_CONFIGS[prov] || PROVIDER_CONFIGS.groq;
    const key = (textApiKey?.value.trim() || localStorage.getItem('aetheria_key_' + prov) || localStorage.getItem('aetheria_text_key') || '').trim();
    const baseUrl = (textBaseUrl?.value.trim() || localStorage.getItem('aetheria_url_' + prov) || conf.defaultUrl || '').trim();

    const originalBtnHtml = pingTextBtn ? pingTextBtn.innerHTML : '';
    if (pingTextBtn) {
      pingTextBtn.disabled = true;
      pingTextBtn.classList.add('opacity-70', 'cursor-wait');
      pingTextBtn.innerHTML = '<svg class="w-3 h-3 animate-spin text-purple-400" viewBox="0 0 24 24" fill="none"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path></svg><span class="text-[10px]">Testing...</span>';
    }

    try {
      const result = await runTextPingTest(prov, key, baseUrl);
      if (result.ok) {
        if (pingLatencyText) {
          pingLatencyText.textContent = `${result.latency}ms`;
          pingLatencyText.className = 'text-[10px] px-2 py-0.5 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 font-mono font-medium shrink-0';
          pingLatencyText.classList.remove('hidden');
        }
        if (pingIndicatorDot) pingIndicatorDot.className = 'w-2 h-2 rounded-full bg-emerald-400 shrink-0';
        showNotification(`✓ ${conf.name} latency: ${result.latency}ms`);
      } else {
        if (pingLatencyText) {
          pingLatencyText.textContent = 'Offline';
          pingLatencyText.className = 'text-[10px] px-2 py-0.5 rounded-full bg-rose-500/15 border border-rose-500/30 text-rose-400 font-mono font-medium shrink-0';
          pingLatencyText.classList.remove('hidden');
        }
        if (pingIndicatorDot) pingIndicatorDot.className = 'w-2 h-2 rounded-full bg-rose-500 shrink-0';
        showNotification(`⚠️ Connection test failed: ${result.error || 'Server error'}`);
      }
    } catch (e) {
      showNotification(`⚠️ Test error: ${(e && e.message) ? e.message : 'Failed'}`);
    } finally {
      if (pingTextBtn) {
        pingTextBtn.disabled = false;
        pingTextBtn.classList.remove('opacity-70', 'cursor-wait');
        pingTextBtn.innerHTML = originalBtnHtml;
      }
    }
  }

  // Connect button with validation in Unconnected Form
  async function connectTextWithTest() {
    const prov = textProviderSelect?.value || 'groq';
    const conf = PROVIDER_CONFIGS[prov] || PROVIDER_CONFIGS.groq;
    const key = (textApiKey?.value || '').trim();
    const url = (textBaseUrl?.value || '').trim();

    const requiresKey = conf.hasKey && !conf.isKeyOptional;
    if (requiresKey && !key) {
      if (pingStatusMsg) {
        pingStatusMsg.className = 'text-xs px-3.5 py-2.5 rounded-xl border bg-rose-950/40 border-rose-500/30 text-rose-300 block leading-relaxed';
        pingStatusMsg.textContent = '⚠️ Please enter an API key to connect.';
        pingStatusMsg.classList.remove('hidden');
      }
      textApiKey?.focus();
      return;
    }

    if (textConnectConfirmBtn) {
      textConnectConfirmBtn.disabled = true;
      textConnectConfirmBtn.classList.add('opacity-80', 'cursor-wait');
      if (textConnectBtnText) textConnectBtnText.textContent = 'Testing...';
      if (textConnectBtnIcon) textConnectBtnIcon.classList.add('animate-spin');
    }
    if (pingStatusMsg) pingStatusMsg.classList.add('hidden');

    try {
      const result = await runTextPingTest(prov, key, url);
      if (result.ok) {
        // Save key and URL
        if (key) {
          localStorage.setItem('aetheria_key_' + prov, key);
          localStorage.setItem('aetheria_text_key', key);
        }
        if (url) {
          localStorage.setItem('aetheria_url_' + prov, url);
          localStorage.setItem('aetheria_text_base_url', url);
        }

        // Switch to connected container
        if (textUnconnectedContainer && textConnectedContainer) {
          textUnconnectedContainer.classList.add('hidden');
          textConnectedContainer.classList.remove('hidden');
        }
        if (pingStatusMsg) pingStatusMsg.classList.add('hidden');

        if (pingProviderName) pingProviderName.textContent = conf.name;
        if (pingLatencyText) {
          pingLatencyText.textContent = `${result.latency}ms`;
          pingLatencyText.className = 'text-[10px] px-2 py-0.5 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 font-mono font-medium shrink-0';
          pingLatencyText.classList.remove('hidden');
        }
        if (pingIndicatorDot) {
          pingIndicatorDot.className = 'w-2 h-2 rounded-full bg-emerald-400 shrink-0';
        }
        if (textConnectedKeyMasked) {
          if (conf.hasUrl && !requiresKey) {
            textConnectedKeyMasked.textContent = url || 'Localhost';
          } else if (key) {
            const prefix = key.slice(0, 4);
            const suffix = key.slice(-4);
            textConnectedKeyMasked.textContent = `${prefix}••••${suffix}`;
          } else {
            textConnectedKeyMasked.textContent = '••••••••';
          }
        }

        // Fetch & sync live models list
        await fetchModelsForProvider(prov, key, url);

        showNotification(`✓ ${conf.name} connected successfully! (${result.latency}ms)`);
      } else {
        if (pingStatusMsg) {
          pingStatusMsg.className = 'text-xs px-3.5 py-2.5 rounded-xl border bg-rose-950/40 border-rose-500/30 text-rose-300 block leading-relaxed';
          pingStatusMsg.textContent = `✕ Connection failed: ${result.error || 'Check API key or server URL'}`;
          pingStatusMsg.classList.remove('hidden');
        }
      }
    } catch (err) {
      if (pingStatusMsg) {
        pingStatusMsg.className = 'text-xs px-3.5 py-2.5 rounded-xl border bg-rose-950/40 border-rose-500/30 text-rose-300 block leading-relaxed';
        pingStatusMsg.textContent = `✕ Connection error: ${(err && err.message) ? err.message : 'Unable to connect'}`;
        pingStatusMsg.classList.remove('hidden');
      }
    } finally {
      if (textConnectConfirmBtn) {
        textConnectConfirmBtn.disabled = false;
        textConnectConfirmBtn.classList.remove('opacity-80', 'cursor-wait');
        if (textConnectBtnText) textConnectBtnText.textContent = 'Connect';
        if (textConnectBtnIcon) textConnectBtnIcon.classList.remove('animate-spin');
      }
    }
  }

  // ==========================================
  // NAMED API PROFILES MANAGEMENT SYSTEM
  // ==========================================
  const PROFILES_STORAGE_KEY = 'aetheria_api_profiles';
  const ACTIVE_PROFILE_KEY = 'aetheria_active_profile_id';
  let currentActiveProvider = localStorage.getItem('aetheria_text_provider') || 'groq';

  function getSavedApiProfiles() {
    try {
      const raw = localStorage.getItem(PROFILES_STORAGE_KEY);
      if (!raw) return [];
      const parsed = JSON.parse(raw);
      return Array.isArray(parsed) ? parsed : [];
    } catch (e) {
      console.error('Error reading API profiles:', e);
      return [];
    }
  }

  function saveApiProfilesToStorage(profiles) {
    try {
      localStorage.setItem(PROFILES_STORAGE_KEY, JSON.stringify(profiles));
    } catch (e) {
      console.error('Error saving API profiles:', e);
    }
  }

  function renderApiProfilesDropdown(activeId = null) {
    if (!apiProfileSelect) return;
    const currentActive = activeId !== null ? activeId : localStorage.getItem(ACTIVE_PROFILE_KEY);
    const profiles = getSavedApiProfiles();

    apiProfileSelect.innerHTML = '';

    const defaultOpt = document.createElement('option');
    defaultOpt.value = '';
    defaultOpt.textContent = 'Direct Mode (No Profile)';
    if (!currentActive) defaultOpt.selected = true;
    apiProfileSelect.appendChild(defaultOpt);

    profiles.forEach(prof => {
      const opt = document.createElement('option');
      opt.value = prof.id;
      const provName = PROVIDER_CONFIGS[prof.provider]?.name || prof.provider;
      const modelShort = (prof.model || '').split('/').pop() || prof.model || 'Default';
      opt.textContent = `🏷️ ${prof.name} (${provName} • ${modelShort})`;
      if (prof.id === currentActive) opt.selected = true;
      apiProfileSelect.appendChild(opt);
    });

    // 2026 Custom Dropdown Presentation (No Native OS Picker)
    if (customProfileMenu) {
      customProfileMenu.innerHTML = '';

      // Direct Option
      const directItem = document.createElement('button');
      directItem.type = 'button';
      directItem.className = `w-full px-3 py-2 rounded-xl text-left flex items-center justify-between transition cursor-pointer text-xs group ${
        !currentActive ? 'bg-purple-600/25 text-white border border-purple-500/40' : 'text-slate-300 hover:bg-white/[0.05] hover:text-white'
      }`;
      directItem.innerHTML = `
        <div class="flex items-center gap-2 min-w-0 pr-2">
          <span class="w-2 h-2 rounded-full ${!currentActive ? 'bg-emerald-400' : 'bg-slate-500'} shrink-0"></span>
          <span class="font-medium truncate">Direct Mode (No Profile)</span>
        </div>
        ${!currentActive ? '<span class="text-purple-400 text-xs font-bold">✓</span>' : ''}
      `;
      directItem.addEventListener('click', () => {
        apiProfileSelect.value = '';
        apiProfileSelect.dispatchEvent(new Event('change'));
        closeCustomProfileMenu();
      });
      customProfileMenu.appendChild(directItem);

      if (profiles.length > 0) {
        const divider = document.createElement('div');
        divider.className = 'h-px bg-white/[0.08] my-1';
        customProfileMenu.appendChild(divider);
      }

      profiles.forEach(prof => {
        const isSelected = prof.id === currentActive;
        const provName = PROVIDER_CONFIGS[prof.provider]?.name || prof.provider;
        const modelShort = (prof.model || '').split('/').pop() || prof.model || 'Default';

        const item = document.createElement('button');
        item.type = 'button';
        item.className = `w-full px-3 py-2 rounded-xl text-left flex items-center justify-between transition cursor-pointer text-xs group ${
          isSelected ? 'bg-purple-600/25 text-white border border-purple-500/40' : 'text-slate-300 hover:bg-white/[0.05] hover:text-white'
        }`;
        item.innerHTML = `
          <div class="flex items-center gap-2 min-w-0 pr-2">
            <span class="w-2 h-2 rounded-full ${isSelected ? 'bg-emerald-400' : 'bg-purple-400'} shrink-0"></span>
            <div class="min-w-0 flex flex-col">
              <span class="font-semibold text-white truncate">${prof.name}</span>
              <span class="text-[10px] text-slate-400 truncate">${provName} • ${modelShort}</span>
            </div>
          </div>
          <div class="flex items-center gap-1 shrink-0">
            <span class="text-[9px] px-1.5 py-0.5 rounded bg-purple-900/40 text-purple-300 border border-purple-500/30 uppercase font-mono">${prof.provider}</span>
            ${isSelected ? '<span class="text-purple-400 text-xs font-bold ml-1">✓</span>' : ''}
          </div>
        `;
        item.addEventListener('click', () => {
          apiProfileSelect.value = prof.id;
          apiProfileSelect.dispatchEvent(new Event('change'));
          closeCustomProfileMenu();
        });
        customProfileMenu.appendChild(item);
      });
    }

    if (customProfileTriggerLabel) {
      const activeProf = profiles.find(p => p.id === currentActive);
      if (activeProf) {
        customProfileTriggerLabel.textContent = activeProf.name;
        if (customProfileTriggerTag) {
          customProfileTriggerTag.textContent = activeProf.provider;
          customProfileTriggerTag.classList.remove('hidden');
        }
        if (customProfileStatusDot) {
          customProfileStatusDot.className = 'w-2 h-2 rounded-full bg-emerald-400 shrink-0';
        }
