  // Voice speech synthesis
  function speak(text) {
    if (!ttsEnabled || !window.speechSynthesis) return;
    const filterActions = localStorage.getItem('aetheria_voice_filter') !== 'false';
    let cleanText = text;
    if (filterActions) {
      cleanText = text.replace(/\*[^*]+\*/g, '').trim();
    }
    if (!cleanText) return;

    window.speechSynthesis.cancel();
    const utterance = new SpeechSynthesisUtterance(cleanText);
    utterance.rate = parseFloat(localStorage.getItem('aetheria_voice_rate') || '1.0');
    utterance.pitch = parseFloat(localStorage.getItem('aetheria_voice_pitch') || '1.0');
    utterance.lang = 'en-US';
    window.speechSynthesis.speak(utterance);
  }

  // Build System Prompt with Dynamic Lorebook Injection
  function buildSystemPrompt(userText = '') {
    const { beforeCharContent, afterCharContent, triggeredNames } = scanAndInjectLorebook(userText, conversation);
    updateSidebarLoreTriggers(triggeredNames);

    let prompt = '';
    if (beforeCharContent) {
      prompt += `[WORLD & LORE KNOWLEDGE:\n${beforeCharContent}]\n\n`;
    }

    prompt += `You are roleplaying as ${activeChar.name}, ${activeChar.title}.
Character Persona & Core Traits:
${formatMacroText(activeChar.description || '')}
${activeChar.personality ? `Personality: ${formatMacroText(activeChar.personality)}` : ''}
${activeChar.scenario ? `Scenario / Context: ${formatMacroText(activeChar.scenario)}` : ''}
${activeChar.speechStyle ? `Dialogue Style: ${formatMacroText(activeChar.speechStyle)}` : ''}
${activeChar.mesExample ? `Example Dialogue:\n${formatMacroText(activeChar.mesExample)}` : ''}
${activeChar.systemPrompt ? `Specific Instructions:\n${formatMacroText(activeChar.systemPrompt)}` : ''}

User Identity ({{user}}):
- Name: ${activeUserPersona.name || 'Traveler'}
- Pronouns: ${activeUserPersona.pronouns || 'Unspecified'}
- Persona Appearance & Traits: ${formatMacroText(activeUserPersona.bio || 'A traveler visiting the realm.')}
- User Guardrails & Rules: ${formatMacroText(activeUserPersona.globalNotes || 'Never speak, narrate, or assume actions for {{user}}.')}

Behavioral Instructions:
Stay fully in character as ${activeChar.name}. Adhere strictly to wholesome SFW standards.
Use *asterisks* for expressive physical gestures, movements, tone and sensory details.
Use quotes "like this" for spoken dialogue.
Never speak, narrate, or decide thoughts or actions for {{user}}. Maintain high immersion and emotional responsiveness.`;

    if (afterCharContent) {
      prompt += `\n\n[CONTEXTUAL WORLD LORE:\n${afterCharContent}]`;
    }

    // Pinned Memory / Author's Note Injection (SillyTavern Standard)
    const pinnedNoteKey = 'aetheria_pinned_note_' + (activeChar.id || character.id || 'default');
    const pinnedNote = localStorage.getItem(pinnedNoteKey) || '';
    if (pinnedNote.trim()) {
      prompt += `\n\n[AUTHOR NOTE & PINNED MEMORY:\n${formatMacroText(pinnedNote.trim())}\nImportant: The plot details, relationship status, and facts above are permanent anchors and must be respected.]`;
    }

    return prompt;
  }

  // Send message & AI Generation with Real-time SSE Token Streaming
  async function handleSendMessage(userText) {
    if (!userText.trim()) return;

    const userMsg = {
      sender: 'user',
      text: userText.trim(),
      timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })
    };

    conversation.push(userMsg);
    saveChat();
    appendMessageToDOM(userMsg, conversation.length - 1);
    if (chatStream) chatStream.scrollTop = chatStream.scrollHeight;

    if (input) {
      input.value = '';
      input.style.height = 'auto';
    }

    if (typingIndicator) {
      typingIndicator.classList.remove('hidden');
      if (chatStream) chatStream.scrollTop = chatStream.scrollHeight;
    }

    const provider = localStorage.getItem('aetheria_text_provider') || 'demo';
    const apiKey = localStorage.getItem('aetheria_text_key') || '';
    const model = localStorage.getItem('aetheria_text_model') || 'llama-3.3-70b-versatile';
    const temp = parseFloat(localStorage.getItem('aetheria_text_temp') || '0.85');
    const maxTokens = parseInt(localStorage.getItem('aetheria_text_tokens') || '350', 10);
    const topP = parseFloat(localStorage.getItem('aetheria_text_top_p') || '0.95');
    const enableStreaming = localStorage.getItem('aetheria_text_streaming') !== 'false';

    let replyText = '';

    // Direct LLM Call with Streaming
    if (apiKey && provider !== 'demo') {
      try {
        let endpoint = 'https://api.groq.com/openai/v1/chat/completions';
        if (provider === 'openrouter') endpoint = 'https://openrouter.ai/api/v1/chat/completions';
        if (provider === 'deepseek') endpoint = 'https://api.deepseek.com/chat/completions';
        if (provider === 'openai') endpoint = 'https://api.openai.com/v1/chat/completions';
        if (provider === 'custom') {
          const base = localStorage.getItem('aetheria_text_base_url') || 'http://localhost:11434/v1';
          endpoint = base.replace(/\/+$/, '') + '/chat/completions';
        }

        const systemPrompt = buildSystemPrompt(userText);
        const contextLimit = parseInt(localStorage.getItem('aetheria_text_context') || '16', 10);
        const historySlice = conversation.slice(-contextLimit).map(m => ({
          role: m.sender === 'user' ? 'user' : 'assistant',
          content: m.text
        }));

        const messages = [
          { role: 'system', content: systemPrompt },
          ...historySlice
        ];

        const payload = {
          model: model,
          messages: messages,
          temperature: temp,
          max_tokens: maxTokens,
          top_p: topP,
          stream: enableStreaming
        };

        const res = await fetch(endpoint, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${apiKey}`,
            ...(provider === 'openrouter' ? { 'HTTP-Referer': 'https://aetheria.ai', 'X-Title': 'Aetheria AI' } : {})
          },
          body: JSON.stringify(payload)
        });

        if (res.ok) {
          if (typingIndicator) typingIndicator.classList.add('hidden');

          if (enableStreaming && res.body) {
            // Token Streaming Execution
            const charMsg = {
              sender: 'character',
              text: '',
              timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
              swipes: [''],
              swipeIndex: 0
            };
            conversation.push(charMsg);
            const msgIdx = conversation.length - 1;
            appendMessageToDOM(charMsg, msgIdx);
            const bubbleEl = document.getElementById(`msg-bubble-${msgIdx}`);

            const reader = res.body.getReader();
            const decoder = new TextDecoder('utf-8');
            let buffer = '';

            while (true) {
              const { done, value } = await reader.read();
              if (done) break;
              buffer += decoder.decode(value, { stream: true });
              const lines = buffer.split('\n');
              buffer = lines.pop() || '';

              for (const line of lines) {
                const trimmed = line.trim();
                if (trimmed.startsWith('data: ')) {
                  const dataStr = trimmed.slice(6);
                  if (dataStr === '[DONE]') continue;
                  try {
                    const parsed = JSON.parse(dataStr);
                    const token = parsed.choices?.[0]?.delta?.content || '';
                    if (token) {
                      replyText += token;
                      charMsg.text = replyText;
                      charMsg.swipes[0] = replyText;
                      if (bubbleEl) {
                        bubbleEl.innerHTML = formatMessageText(replyText);
                      }
                      if (chatStream) chatStream.scrollTop = chatStream.scrollHeight;
                    }
                  } catch (e) {}
                }
              }
            }
            saveChat();
          } else {
            const data = await res.json();
            replyText = data.choices?.[0]?.message?.content || '';
          }
        } else {
          console.warn('API returned non-OK status', res.status);
        }
      } catch (err) {
        console.warn('API call failed, falling back to simulator', err);
      }
    }

    // Fallback response generator if API was not configured, failed, or streaming wasn't used
    if (!replyText) {
      if (typingIndicator) typingIndicator.classList.remove('hidden');
      try {
        const pollHistory = recentHistory.map(m => ({
          role: m.sender === 'user' ? 'user' : 'assistant',
          content: m.text
        }));
        const pollRes = await fetch('https://text.pollinations.ai/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            messages: [
              { role: 'system', content: sysPrompt },
              ...pollHistory
            ],
            model: 'openai',
            temperature: 0.85
          }),
          signal: AbortSignal.timeout(8000)
        });
        if (pollRes.ok) {
          const pollText = await pollRes.text();
          if (pollText && !pollText.includes('"error"') && pollText.length > 5) {
            replyText = pollText.trim();
          }
        }
      } catch (e) {
        console.warn('Anonymous keyless fallback error:', e);
      }

      if (!replyText) {
        await new Promise(r => setTimeout(r, 500));
        replyText = pickResponse(userText);
      }

      if (typingIndicator) typingIndicator.classList.add('hidden');

      const charMsg = {
        sender: 'character',
        text: replyText,
        timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
        swipes: [replyText],
        swipeIndex: 0
      };
      conversation.push(charMsg);
      saveChat();
      appendMessageToDOM(charMsg, conversation.length - 1);
      if (chatStream) chatStream.scrollTop = chatStream.scrollHeight;
    }

    if (typingIndicator) typingIndicator.classList.add('hidden');

    if (ttsEnabled || localStorage.getItem('aetheria_voice_autoplay') === 'true') {
      speak(replyText);
    }
  }

  function pickResponse(userText) {
    const replies = activeChar.fallbackReplies || character.fallbackReplies || [];
    if (replies.length === 0) {
      return formatMacroText(`*Smiles faintly and leans in closer.* "Your thoughts resonate with an intriguing cadence, {{user}}. Tell me what else is on your mind."`);
    }
    const idx = Math.floor(Math.random() * replies.length);
    return formatMacroText(replies[idx]);
  }

  // Generate Alternative Swipe Variation
  async function generateNewSwipe(msgIdx) {
    const msg = conversation[msgIdx];
    if (!msg || msg.sender !== 'character') return;

    showNotification('✨ Generating alternative response variation...');
    if (typingIndicator) typingIndicator.classList.remove('hidden');

    const provider = localStorage.getItem('aetheria_text_provider') || 'demo';
    const apiKey = localStorage.getItem('aetheria_text_key') || '';
    const model = localStorage.getItem('aetheria_text_model') || 'llama-3.3-70b-versatile';
    const temp = Math.min(1.2, parseFloat(localStorage.getItem('aetheria_text_temp') || '0.85') + 0.15); // higher temperature for variety
    const maxTokens = parseInt(localStorage.getItem('aetheria_text_tokens') || '350', 10);

    let newReply = '';

    if (apiKey && provider !== 'demo') {
      try {
        let endpoint = 'https://api.groq.com/openai/v1/chat/completions';
        if (provider === 'openrouter') endpoint = 'https://openrouter.ai/api/v1/chat/completions';
        if (provider === 'deepseek') endpoint = 'https://api.deepseek.com/chat/completions';
        if (provider === 'openai') endpoint = 'https://api.openai.com/v1/chat/completions';

        const lastUserMsg = conversation.slice(0, msgIdx).reverse().find(m => m.sender === 'user');
        const systemPrompt = buildSystemPrompt(lastUserMsg ? lastUserMsg.text : '');
        const historySlice = conversation.slice(0, msgIdx).map(m => ({
          role: m.sender === 'user' ? 'user' : 'assistant',
          content: m.text
        }));

        const res = await fetch(endpoint, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${apiKey}`,
            ...(provider === 'openrouter' ? { 'HTTP-Referer': 'https://aetheria.ai', 'X-Title': 'Aetheria AI' } : {})
          },
          body: JSON.stringify({
            model: model,
            messages: [{ role: 'system', content: systemPrompt }, ...historySlice],
            temperature: temp,
            max_tokens: maxTokens
          })
        });

        if (res.ok) {
          const data = await res.json();
          newReply = data.choices?.[0]?.message?.content || '';
        }
      } catch (err) {}
    }

    if (!newReply) {
      try {
        const lastUserMsg = conversation.slice(0, msgIdx).reverse().find(m => m.sender === 'user');
        const systemPrompt = buildSystemPrompt(lastUserMsg ? lastUserMsg.text : '');
        const historySlice = conversation.slice(0, msgIdx).map(m => ({
          role: m.sender === 'user' ? 'user' : 'assistant',
          content: m.text
        }));
        const pollRes = await fetch('https://text.pollinations.ai/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            messages: [{ role: 'system', content: systemPrompt }, ...historySlice],
            model: 'openai',
            temperature: 0.9
          }),
          signal: AbortSignal.timeout(8000)
        });
        if (pollRes.ok) {
          const pollText = await pollRes.text();
          if (pollText && !pollText.includes('"error"') && pollText.length > 5) {
            newReply = pollText.trim();
          }
        }
      } catch (e) {}
    }

    if (!newReply) {
      await new Promise(r => setTimeout(r, 600));
      newReply = pickResponse('');
    }

    if (typingIndicator) typingIndicator.classList.add('hidden');

    if (!msg.swipes) msg.swipes = [msg.text];
    msg.swipes.push(newReply);
    msg.swipeIndex = msg.swipes.length - 1;
    msg.text = newReply;

    saveChat();
    renderAllMessages();
    showNotification(`Swipe ${msg.swipeIndex + 1}/${msg.swipes.length} ready!`);
  }

  // Handle Swipe Navigation
  function handleSwipeNavigation(msgIdx, action) {
    const msg = conversation[msgIdx];
    if (!msg || !msg.swipes) return;

    if (action === 'prev') {
      if ((msg.swipeIndex || 0) > 0) {
        msg.swipeIndex--;
        msg.text = msg.swipes[msg.swipeIndex];
        saveChat();
        renderAllMessages();
      }
    } else if (action === 'next') {
      const nextIdx = (msg.swipeIndex || 0) + 1;
      if (nextIdx < msg.swipes.length) {
        msg.swipeIndex = nextIdx;
        msg.text = msg.swipes[msg.swipeIndex];
        saveChat();
        renderAllMessages();
      } else if (msgIdx === conversation.length - 1) {
        generateNewSwipe(msgIdx);
      }
    }
  }

  // Inline Message Editing
  function enableEditMessage(idx) {
    const msg = conversation[idx];
    if (!msg) return;

    const bubble = document.getElementById(`msg-bubble-${idx}`);
    if (!bubble) return;

    bubble.innerHTML = `
      <div class="space-y-2 w-full">
        <textarea id="edit-textarea-${idx}" rows="4" class="w-full p-3 rounded-xl bg-[#080a18] border border-purple-500/60 text-white text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-purple-400 resize-y leading-relaxed">${msg.text}</textarea>
        <div class="flex items-center justify-end gap-2">
          <button id="cancel-edit-${idx}" type="button" class="px-3 py-1.5 rounded-xl bg-white/[0.06] hover:bg-white/[0.1] text-xs text-slate-300 transition cursor-pointer">Cancel</button>
          <button id="save-edit-${idx}" type="button" class="px-4 py-1.5 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 text-xs font-bold text-white transition shadow-sm cursor-pointer">Save Changes</button>
        </div>
      </div>
    `;

    document.getElementById(`cancel-edit-${idx}`)?.addEventListener('click', () => {
      renderAllMessages();
    });

    document.getElementById(`save-edit-${idx}`)?.addEventListener('click', () => {
      const textarea = document.getElementById(`edit-textarea-${idx}`);
      if (textarea && textarea.value.trim()) {
        const val = textarea.value.trim();
        msg.text = val;
        if (msg.swipes && msg.swipeIndex !== undefined) {
          msg.swipes[msg.swipeIndex] = val;
        }
        saveChat();
        renderAllMessages();
        showNotification('Message updated.');
      }
    });
  }

  // Rewind Turn Function
  function rewindTurn(idx) {
    const msg = conversation[idx];
    if (!msg) return;

    if (!confirm('Rewind conversation to this turn? Subsequent messages will be removed.')) return;

    let restoredPrompt = '';
    if (msg.sender === 'user') {
      restoredPrompt = msg.text;
      conversation = conversation.slice(0, idx);
    } else {
      // Find the user message before this character reply
      if (idx > 0 && conversation[idx - 1].sender === 'user') {
        restoredPrompt = conversation[idx - 1].text;
        conversation = conversation.slice(0, idx - 1);
      } else {
        conversation = conversation.slice(0, idx);
      }
    }

    saveChat();
    renderAllMessages();

    if (input && restoredPrompt) {
      input.value = restoredPrompt;
      input.focus();
    }
    showNotification('Chat rewound! Prompt restored to input box.');
  }

  // Contextual Image Prompt Synthesizer
  function buildContextualSelfiePrompt() {
    const recent = conversation.slice(-3);
    let actions = [];
    recent.forEach(m => {
      const matched = m.text.match(/\*[^*]+\*/g);
      if (matched) actions.push(...matched.map(a => a.replace(/\*/g, '')));
    });

    const actionText = actions.slice(-2).join(', ');
    const charName = activeChar.name;
    const charTitle = activeChar.title || 'character';
    const charDesc = (activeChar.description || '').slice(0, 140);
    const scenario = (activeChar.scenario || '').slice(0, 100);

    return `Candid smartphone selfie photograph of ${charName}, ${charTitle}. Visual appearance: ${charDesc}. Action & expression: ${actionText || 'looking warmly into the camera, gentle smile'}. Environment setting: ${scenario || 'atmospheric cinematic scene'}. Award-winning photography, detailed face, photorealistic, 8k resolution.`;
  }

  // Contextual Video Motion Prompt Synthesizer
  function buildContextualVideoPrompt() {
    const recent = conversation.slice(-2);
    let actions = [];
    recent.forEach(m => {
      const matched = m.text.match(/\*[^*]+\*/g);
      if (matched) actions.push(...matched.map(a => a.replace(/\*/g, '')));
    });

    const actionText = actions.slice(-1).join('');
    const charName = activeChar.name;
    const charDesc = (activeChar.description || '').slice(0, 120);

    return `Cinematic 4k video of ${charName}, ${charDesc}. Dynamic action: ${actionText || 'looking towards camera, natural facial expressions and gentle head movement'}, highly detailed, photorealistic lighting, fluid 60fps motion.`;
  }

  // Selfie / Photo Generation
  async function handleGenerateSelfie() {
    const prompt = buildContextualSelfiePrompt();
    const imageProvider = localStorage.getItem('aetheria_image_provider') || 'pollinations';
    const falKey = localStorage.getItem('aetheria_fal_key') || localStorage.getItem('aetheria_api_key_fal');
    const openaiKey = localStorage.getItem('aetheria_api_key_openai');

    if (imageProvider === 'fal' && !falKey) {
      showNotification('⚠️ Fal Flux requires an API Key. Opening settings...');
      byokTray?.classList.remove('hidden');
      document.querySelector('[data-engine-tab="image"]')?.click();
      return;
    }
    if (imageProvider === 'dalle' && !openaiKey) {
      showNotification('⚠️ DALL-E 3 requires an OpenAI API Key. Opening settings...');
      byokTray?.classList.remove('hidden');
      document.querySelector('[data-engine-tab="image"]')?.click();
      return;
    }

    showNotification('📷 Capturing scene selfie...');

    const pendingId = 'selfie_' + Date.now();
    const placeholderMsg = {
      sender: 'character',
      text: `*Snaps a candid selfie:* "${activeChar.name}"`,
      timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
      mediaType: 'image_generating',
      mediaPrompt: prompt,
      pendingId: pendingId
    };
    conversation.push(placeholderMsg);
    saveChat();
    renderAllMessages();

    try {
      let finalUrl = '';
      if (imageProvider === 'pollinations' || !falKey) {
        const encoded = encodeURIComponent(prompt);
        finalUrl = `https://image.pollinations.ai/prompt/${encoded}?width=768&height=1024&nologo=true&seed=${Date.now()}`;
      } else if (imageProvider === 'fal' && falKey) {
        const res = await fetch('https://queue.fal.run/fal-ai/flux/schnell', {
          method: 'POST',
          headers: {
            'Authorization': `Key ${falKey}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ prompt: prompt, image_size: "portrait_4_3" })
        });
        const data = await res.json();
        finalUrl = data.images?.[0]?.url || '';
      }

      if (finalUrl) {
        placeholderMsg.mediaType = 'image';
        placeholderMsg.mediaUrl = finalUrl;
        delete placeholderMsg.pendingId;
        saveChat();
        renderAllMessages();
        showNotification('📷 Photo delivered!');
      } else {
        throw new Error('Image URL could not be resolved.');
      }
    } catch (err) {
      showNotification(`Photo error: ${err.message}`);
      conversation = conversation.filter(m => m.pendingId !== pendingId);
      saveChat();
      renderAllMessages();
    }
  }

  // Living Video Generation (BYOK Protected)
  async function handleGenerateVideo() {
    const falKey = localStorage.getItem('aetheria_fal_key') || localStorage.getItem('aetheria_api_key_fal');
    const lumaKey = localStorage.getItem('aetheria_luma_key');

    // Strict Gatekeeper: Only available for users who provided API Key
    if (!falKey && !lumaKey) {
      showNotification('⚠️ Living Video requires an API Key (Fal.ai Kling or Luma). Opening settings...');
      byokTray?.classList.remove('hidden');
      document.querySelector('[data-engine-tab="video"]')?.click();
      return;
    }

    const prompt = buildContextualVideoPrompt();
    showNotification('🎬 Requesting Living Video render...');

    const pendingId = 'video_' + Date.now();
    const placeholderMsg = {
      sender: 'character',
      text: `*Sends living video clip:* "${activeChar.name} in motion"`,
      timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
      mediaType: 'video_generating',
      mediaPrompt: prompt,
      pendingId: pendingId
    };
    conversation.push(placeholderMsg);
    saveChat();
    renderAllMessages();

    try {
      if (falKey) {
        const avatarFullUrl = activeChar.avatarUrl.startsWith('http') 
          ? activeChar.avatarUrl 
          : `${window.location.origin}${activeChar.avatarUrl}`;

        const res = await fetch('https://queue.fal.run/fal-ai/kling-video/v1.5/pro/image-to-video', {
          method: 'POST',
          headers: {
            'Authorization': `Key ${falKey}`,
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            prompt: prompt,
            image_url: avatarFullUrl,
            duration: "5",
            aspect_ratio: "16:9"
          })
        });

        if (!res.ok) {
          const err = await res.json().catch(() => ({}));
          throw new Error(err.detail || err.message || `HTTP ${res.status}`);
        }

        const data = await res.json();
        const requestId = data.request_id;
        showNotification('Rendering video frames on Fal cluster...');

        let videoUrl = '';
        for (let i = 0; i < 25; i++) {
          await new Promise(r => setTimeout(r, 4000));
          const checkRes = await fetch(`https://queue.fal.run/fal-ai/kling-video/requests/${requestId}/status`, {
            headers: { 'Authorization': `Key ${falKey}` }
          });
          if (checkRes.ok) {
            const checkData = await checkRes.json();
            if (checkData.status === 'COMPLETED') {
              const resFinal = await fetch(`https://queue.fal.run/fal-ai/kling-video/requests/${requestId}`, {
                headers: { 'Authorization': `Key ${falKey}` }
              });
              const finalData = await resFinal.json();
              videoUrl = finalData.video?.url || '';
              break;
            } else if (checkData.status === 'FAILED') {
              throw new Error('Fal GPU render failed.');
            }
          }
        }

        if (videoUrl) {
          placeholderMsg.mediaType = 'video';
          placeholderMsg.mediaUrl = videoUrl;
          delete placeholderMsg.pendingId;
          saveChat();
          renderAllMessages();
          showNotification('🎬 Living Video ready!');
        } else {
          throw new Error('Render timed out.');
        }
      }
    } catch (err) {
      showNotification(`Video error: ${err.message}`);
      conversation = conversation.filter(m => m.pendingId !== pendingId);
      saveChat();
      renderAllMessages();
    }
  }

  // Toolbar Actions Listeners
  const selfieBtn = document.getElementById('chat-action-selfie-btn');
  const videoBtn = document.getElementById('chat-action-video-btn');
  const regenBtn = document.getElementById('chat-action-regenerate-btn');
  const rewindBtn = document.getElementById('chat-action-rewind-btn');

  selfieBtn?.addEventListener('click', handleGenerateSelfie);
  videoBtn?.addEventListener('click', handleGenerateVideo);
  regenBtn?.addEventListener('click', () => {
    if (conversation.length > 0) {
      const lastIdx = conversation.length - 1;
      if (conversation[lastIdx].sender === 'character') {
        generateNewSwipe(lastIdx);
      } else {
        handleSendMessage(conversation[lastIdx].text);
      }
    }
  });
  rewindBtn?.addEventListener('click', () => {
    if (conversation.length > 0) {
      rewindTurn(conversation.length - 1);
    }
  });

  // Global delegation for dynamic message buttons (Edit, Rewind, Swipes, Speak, Copy, Delete)
  document.addEventListener('click', (e) => {
    const target = e.target;

    // Swipe buttons
    const swipeBtn = target.closest('.msg-swipe-btn');
    if (swipeBtn) {
      const idx = parseInt(swipeBtn.getAttribute('data-idx') || '0', 10);
      const action = swipeBtn.getAttribute('data-action') || 'next';
      handleSwipeNavigation(idx, action);
      return;
    }

    // Edit button
    const editBtn = target.closest('.msg-edit-btn');
    if (editBtn) {
      const idx = parseInt(editBtn.getAttribute('data-idx') || '0', 10);
      enableEditMessage(idx);
      return;
    }

    // Rewind button
    const rewindMsgBtn = target.closest('.msg-rewind-btn');
    if (rewindMsgBtn) {
      const idx = parseInt(rewindMsgBtn.getAttribute('data-idx') || '0', 10);
      rewindTurn(idx);
      return;
    }

    // Delete button
    const deleteBtn = target.closest('.msg-delete-btn');
    if (deleteBtn) {
      const idx = parseInt(deleteBtn.getAttribute('data-idx') || '0', 10);
      if (confirm('Delete this message?')) {
        conversation.splice(idx, 1);
        saveChat();
        renderAllMessages();
        showNotification('Message deleted.');
      }
      return;
    }

    // Copy button
    const copyBtn = target.closest('.msg-copy-btn');
    if (copyBtn) {
      const text = decodeURIComponent(copyBtn.getAttribute('data-text') || '');
      navigator.clipboard.writeText(text);
      showNotification('Copied message to clipboard!');
      return;
    }

    // Speak button
    const speakBtn = target.closest('.msg-speak-btn');
    if (speakBtn) {
      const idx = parseInt(speakBtn.getAttribute('data-idx') || '0', 10);
      const msg = conversation[idx];
      if (msg) speak(msg.text);
    }
  });

  // Event Listeners
  inputForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (input) handleSendMessage(input.value);
  });

  input?.addEventListener('keydown', (e) => {
    if (e.key === 'Enter' && !e.shiftKey) {
      e.preventDefault();
      handleSendMessage(input.value);
    }
  });

  // Auto-resize textarea
  input?.addEventListener('input', () => {
    input.style.height = 'auto';
    input.style.height = `${Math.min(input.scrollHeight, 128)}px`;
  });

  // Starter prompts
  starterPills.forEach((btn) => {
    btn.addEventListener('click', () => {
