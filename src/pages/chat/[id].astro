  // Live STT Test Button (Microphone Audition)
  let sttTestMediaRecorder = null;
  let sttTestChunks = [];
  testSttBtn?.addEventListener('click', async () => {
    const prov = localStorage.getItem('aetheria_stt_provider') || 'browser-stt';
    const outputBox = document.getElementById('stt-test-output-box');
    const outputText = document.getElementById('stt-test-output-text');

    if (prov === 'browser-stt' || prov === 'browser') {
      if (typeof window === 'undefined' || (!('webkitSpeechRecognition' in window) && !('SpeechRecognition' in window))) {
        showNotification('⚠️ Built-in Web Speech API is not supported in this browser. Please switch to Groq Whisper.', 'warning');
        return;
      }

      const SpeechAPI = window.SpeechRecognition || window.webkitSpeechRecognition;
      try {
        const recognizer = new SpeechAPI();
        recognizer.continuous = false;
        recognizer.interimResults = false;
        const currentLang = localStorage.getItem('aetheria_stt_lang') || 'auto';
        recognizer.lang = currentLang === 'auto' ? (navigator.language || 'en-US') : (currentLang === 'fa' ? 'fa-IR' : (currentLang === 'en' ? 'en-US' : currentLang));

        if (testSttBtnLabel) testSttBtnLabel.textContent = 'Listening (Speak now)...';
        testSttBtn.disabled = true;

        recognizer.onresult = (evt) => {
          let heard = '';
          for (let i = evt.resultIndex; i < evt.results.length; ++i) {
            heard += evt.results[i][0].transcript;
          }
          if (outputBox && outputText) {
            outputBox.classList.remove('hidden');
            outputText.textContent = heard ? `"${heard}"` : '(No speech detected)';
          }
          showNotification('✓ Speech recognized successfully!');
        };

        recognizer.onerror = (err) => {
          if (outputBox && outputText) {
            outputBox.classList.remove('hidden');
            outputText.textContent = `Notice: ${err.error || 'No speech detected'}`;
          }
        };

        recognizer.onend = () => {
          testSttBtn.disabled = false;
          if (testSttBtnLabel) testSttBtnLabel.textContent = 'Test Mic (3s)';
        };

        recognizer.start();
        setTimeout(() => {
          try { recognizer.stop(); } catch(e) {}
        }, 3500);
      } catch (err) {
        showNotification(`⚠️ Microphone error: ${err.message}`, 'error');
        testSttBtn.disabled = false;
        if (testSttBtnLabel) testSttBtnLabel.textContent = 'Test Mic (3s)';
      }
      return;
    }

    if (!isSttReady()) {
      showNotification('🔒 Please enter your STT API key or server URL first to test recording.', 'warning');
      sttApiKey?.focus();
      return;
    }

    if (!navigator.mediaDevices?.getUserMedia) {
      showNotification('⚠️ Microphone access is not supported by your browser.', 'warning');
      return;
    }
    if (testSttBtn.disabled) return;

    try {
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      sttTestChunks = [];
      sttTestMediaRecorder = new MediaRecorder(stream);
      sttTestMediaRecorder.ondataavailable = (e) => {
        if (e.data && e.data.size > 0) sttTestChunks.push(e.data);
      };
      sttTestMediaRecorder.onstop = async () => {
        stream.getTracks().forEach(t => t.stop());
        const audioBlob = new Blob(sttTestChunks, { type: sttTestMediaRecorder.mimeType || 'audio/webm' });
        if (testSttBtnLabel) testSttBtnLabel.textContent = 'Transcribing...';
        try {
          const text = await transcribeAudioBlob(audioBlob);
          if (outputBox && outputText) {
            outputBox.classList.remove('hidden');
            outputText.textContent = text ? `"${text}"` : "(No speech detected or empty audio)";
          }
          showNotification('✓ Voice input transcribed successfully!');
        } catch (err) {
          if (outputBox && outputText) {
            outputBox.classList.remove('hidden');
            outputText.textContent = `Error: ${err.message || 'Transcription failed'}`;
          }
        } finally {
          testSttBtn.disabled = false;
          if (testSttBtnLabel) testSttBtnLabel.textContent = 'Test Mic (3s)';
        }
      };

      testSttBtn.disabled = true;
      let countdown = 3;
      if (testSttBtnLabel) testSttBtnLabel.textContent = `Listening (${countdown}s)...`;
      const cdInterval = setInterval(() => {
        countdown--;
        if (countdown > 0 && testSttBtnLabel) {
          testSttBtnLabel.textContent = `Listening (${countdown}s)...`;
        } else {
          clearInterval(cdInterval);
        }
      }, 1000);

      sttTestMediaRecorder.start();
      setTimeout(() => {
        if (sttTestMediaRecorder && sttTestMediaRecorder.state === 'recording') {
          sttTestMediaRecorder.stop();
        }
      }, 3000);
    } catch (err) {
      showNotification(`⚠️ Microphone permission denied: ${err.message}`, 'error');
    }
  });

  // Audio transcription API dispatcher
  async function transcribeAudioBlob(blob) {
    const prov = localStorage.getItem('aetheria_stt_provider') || 'groq';
    let apiKey = (localStorage.getItem('aetheria_stt_key') || '').trim();
    if (!apiKey) {
      if (prov === 'groq') apiKey = (localStorage.getItem('aetheria_key_groq') || localStorage.getItem('aetheria_text_key') || '').trim();
      if (prov === 'openai') apiKey = (localStorage.getItem('aetheria_key_openai') || localStorage.getItem('aetheria_text_key') || '').trim();
    }
    const model = localStorage.getItem('aetheria_stt_model') || (prov === 'groq' ? 'whisper-large-v3-turbo' : 'whisper-1');
    const lang = localStorage.getItem('aetheria_stt_lang') || 'auto';
    const customUrl = localStorage.getItem('aetheria_stt_custom_url') || '';

    let endpoint = '';
    if (prov === 'groq') {
      endpoint = 'https://api.groq.com/openai/v1/audio/transcriptions';
    } else if (prov === 'openai') {
      endpoint = 'https://api.openai.com/v1/audio/transcriptions';
    } else if (prov === 'faster-whisper') {
      endpoint = 'http://localhost:8000/v1/audio/transcriptions';
    } else if (prov === 'custom-stt' || prov === 'custom') {
      endpoint = customUrl || 'http://localhost:8000/v1/audio/transcriptions';
    } else {
      endpoint = 'https://api.groq.com/openai/v1/audio/transcriptions';
    }

    const formData = new FormData();
    const fileExt = blob.type.includes('mp4') ? 'mp4' : 'webm';
    formData.append('file', blob, `voice_recording.${fileExt}`);
    formData.append('model', model);
    formData.append('response_format', 'json');
    if (lang && lang !== 'auto') {
      formData.append('language', lang);
    }

    const headers = {};
    if (apiKey) headers['Authorization'] = `Bearer ${apiKey}`;

    const res = await fetch(endpoint, {
      method: 'POST',
      headers,
      body: formData
    });

    if (!res.ok) {
      const errText = await res.text();
      let msg = `HTTP ${res.status}`;
      try {
        const errJson = JSON.parse(errText);
        msg = errJson.error?.message || msg;
      } catch(e) {}
      throw new Error(msg);
    }

    const data = await res.json();
    return data.text || '';
  }

  function isSttReady() {
    const prov = localStorage.getItem('aetheria_stt_provider') || 'groq';
    if (prov === 'browser' || prov === 'browser-stt') return true;
    if (prov === 'faster-whisper') return true;
    if (prov === 'custom-stt' || prov === 'custom') {
      const url = (localStorage.getItem('aetheria_stt_custom_url') || '').trim();
      return Boolean(url);
    }
    let key = (localStorage.getItem('aetheria_stt_key') || '').trim();
    if (!key) {
      if (prov === 'groq') key = (localStorage.getItem('aetheria_key_groq') || localStorage.getItem('aetheria_text_key') || '').trim();
      if (prov === 'openai') key = (localStorage.getItem('aetheria_key_openai') || localStorage.getItem('aetheria_text_key') || '').trim();
    }
    return Boolean(key);
  }

