  async function connectVideoWithTest() {
    const prov = localStorage.getItem('aetheria_video_provider') || 'fal-kling';
    const key = videoApiKey?.value.trim() || '';
    const obj = VIDEO_CATALOG.find(x => x.id === prov) || VIDEO_CATALOG[0];
    const isCustom = obj.needsUrl;
    const customUrlVal = videoCustomUrl?.value.trim() || '';

    if (isCustom && !customUrlVal) {
      showNotification('⚠️ Please enter an Endpoint URL first.', 'warning');
      videoCustomUrl?.focus();
      return;
    }
    if (obj.needsKey && !key && !isCustom) {
      showNotification('⚠️ Please enter an API key first.', 'warning');
      videoApiKey?.focus();
      return;
    }

    if (videoConnectConfirmBtn) {
      videoConnectConfirmBtn.disabled = true;
      videoConnectConfirmBtn.classList.add('opacity-80', 'cursor-wait');
      if (videoConnectBtnIcon) videoConnectBtnIcon.classList.add('animate-spin');
      if (videoConnectBtnText) videoConnectBtnText.textContent = 'Testing...';
    }
    if (videoConnectStatus) {
      videoConnectStatus.classList.add('hidden');
      videoConnectStatus.innerHTML = '';
    }

    const testRes = await pingModalityEndpoint('video', prov, key, customUrlVal);

    if (videoConnectConfirmBtn) {
