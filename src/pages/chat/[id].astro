        }" 
        data-profile-id=""
      >
        <div class="flex items-center gap-2 min-w-0">
          <span class="w-2 h-2 rounded-full ${!activeId ? 'bg-rose-400' : 'bg-slate-500'}"></span>
          <span class="truncate">Cloudflare Workers AI (Default)</span>
        </div>
        ${!activeId ? '<span class="text-[10px] text-rose-300 font-mono">Active</span>' : ''}
      </button>
    `;

    profiles.forEach(p => {
