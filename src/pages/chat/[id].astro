  // Dynamic Smart Prompts System
  function renderSmartPrompts(prompts) {
    if (!smartPromptsContainer) return;
    if (!prompts || prompts.length === 0) {
      prompts = activeChar.starterPrompts || character.starterPrompts || [];
    }
    smartPromptsContainer.innerHTML = prompts.map(p => `
      <button 
        type="button"
        class="room-starter-pill shrink-0 px-3 py-1.5 rounded-xl bg-purple-950/40 hover:bg-purple-900/60 hover:border-purple-400/50 border border-purple-500/25 text-xs text-purple-200 hover:text-white transition duration-200 cursor-pointer active:scale-95 whitespace-nowrap shadow-sm"
        data-prompt="${p.replace(/"/g, '&quot;')}"
      >
        "${p.replace(/"/g, '&quot;')}"
      </button>
    `).join('');

    smartPromptsContainer.querySelectorAll('.room-starter-pill').forEach((btn) => {
      btn.addEventListener('click', () => {
        const prompt = btn.getAttribute('data-prompt');
        if (prompt && input) {
          input.value = prompt;
          input.focus();
          input.style.height = 'auto';
          input.style.height = `${Math.min(input.scrollHeight, 128)}px`;
        }
      });
