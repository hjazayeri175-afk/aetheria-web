  function updateAllBadges() {
    if (badgeTemp && sliderTemp) badgeTemp.textContent = parseFloat(sliderTemp.value).toFixed(2);
    if (badgeTokens && sliderTokens) badgeTokens.textContent = `${sliderTokens.value} tok`;
    if (badgeTopP && sliderTopP) badgeTopP.textContent = parseFloat(sliderTopP.value).toFixed(2);
    if (badgeRepPen && sliderRepPen) badgeRepPen.textContent = parseFloat(sliderRepPen.value).toFixed(2);
    if (badgeFreqPen && sliderFreqPen) badgeFreqPen.textContent = parseFloat(sliderFreqPen.value).toFixed(2);
    if (badgePresPen && sliderPresPen) badgePresPen.textContent = parseFloat(sliderPresPen.value).toFixed(2);
    if (badgeContext && sliderContext) badgeContext.textContent = `${sliderContext.value} Turns`;

    if (badgeStability && sliderStability) badgeStability.textContent = parseFloat(sliderStability.value).toFixed(2);
    if (badgeClarity && sliderClarity) badgeClarity.textContent = parseFloat(sliderClarity.value).toFixed(2);
    if (badgeVoiceRate && sliderVoiceRate) badgeVoiceRate.textContent = `${parseFloat(sliderVoiceRate.value).toFixed(1)}x`;
    if (badgeVoicePitch && sliderVoicePitch) badgeVoicePitch.textContent = parseFloat(sliderVoicePitch.value).toFixed(2);

    if (badgeMotion && sliderMotion) badgeMotion.textContent = sliderMotion.value;
  }

  function syncProviderVisibility() {
    // Custom base URL
    if (customBaseUrlContainer && textProviderSelect) {
      customBaseUrlContainer.classList.toggle('hidden', textProviderSelect.value !== 'custom');
    }
    // Voice keys
    if (voiceKeyContainer && voiceProviderSelect) {
      voiceKeyContainer.classList.toggle('hidden', voiceProviderSelect.value === 'browser');
    }
    if (elevenVoiceContainer && voiceProviderSelect) {
      elevenVoiceContainer.classList.toggle('hidden', voiceProviderSelect.value !== 'elevenlabs');
    }
    if (openaiVoiceContainer && voiceProviderSelect) {
      openaiVoiceContainer.classList.toggle('hidden', voiceProviderSelect.value !== 'openai');
    }
    // Image keys
    if (imageKeyContainer && imageProviderSelect) {
      imageKeyContainer.classList.toggle('hidden', imageProviderSelect.value === 'pollinations');
    }
  }

  function updateHeaderPill() {
    if (!engineLabel) return;
    const textProv = textProviderSelect?.value || localStorage.getItem('aetheria_text_provider') || 'groq';
    const model = textModelInput?.value || localStorage.getItem('aetheria_text_model') || 'Llama 3.3';
    const shortModel = model.split('/').pop() || model;
    
    if (textProv === 'demo') {
      engineLabel.textContent = 'Engine: Free Edge Simulator';
    } else {
      engineLabel.textContent = `Engine: ${textProv.toUpperCase()} (${shortModel.slice(0, 16)})`;
    }
  }

  function saveAllSettings() {
    // 1. Text
    if (textProviderSelect) localStorage.setItem('aetheria_text_provider', textProviderSelect.value);
