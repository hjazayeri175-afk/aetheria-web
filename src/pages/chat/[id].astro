    const cleanSnippet = (() => {
      if (!snippet) return '';
      let s = String(snippet);
      s = s.replace(/<details[\s\S]*?<\/details>/gi, '');
      s = s.replace(/<think[\s\S]*?<\/think>/gi, '');
      s = s.replace(/<[^>]+>/g, ' ');
      s = s.replace(/&nbsp;/g, ' ')
           .replace(/&amp;/g, '&')
           .replace(/&lt;/g, '<')
           .replace(/&gt;/g, '>')
           .replace(/&quot;/g, '"')
           .replace(/&#039;/g, "'")
           .replace(/&#x27;/g, "'");
      s = s.replace(/```[\s\S]*?```/g, '');
      s = s.replace(/`([^`]+)`/g, '$1');
      s = s.replace(/[*_~#]/g, '');
      s = s.replace(/\s+/g, ' ').trim();
      return s;
    })();

    const displaySnippet = cleanSnippet.length > 200 ? cleanSnippet.slice(0, 200) + '...' : cleanSnippet;
    const safeTargetName = String(targetName || (targetType === 'character' ? 'Character' : 'Response')).replace(/</g, '&lt;').replace(/>/g, '&gt;');

    backdrop.innerHTML = `
      <div class="w-full max-w-md rounded-2xl bg-[#0f1118] border border-white/10 p-5 sm:p-6 shadow-2xl shadow-black/80 transform scale-95 transition-all duration-200 text-left max-h-[90vh] overflow-y-auto custom-scrollbar flex flex-col">
        
        <!-- Header -->
