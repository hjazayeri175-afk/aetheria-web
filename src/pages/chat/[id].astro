  // Speech-to-Text via Web Speech API
  let speechRec = null;
  let isListeningVoice = false;
  if (typeof window !== 'undefined' && ('webkitSpeechRecognition' in window || 'SpeechRecognition' in window)) {
    const SpeechAPI = window.SpeechRecognition || window.webkitSpeechRecognition;
    try {
      speechRec = new SpeechAPI();
      speechRec.continuous = false;
      speechRec.interimResults = true;
      const savedSttLang = localStorage.getItem('aetheria_stt_lang') || 'auto';
      speechRec.lang = savedSttLang === 'auto' ? (navigator.language || 'en-US') : savedSttLang;

      speechRec.onstart = () => {
        isListeningVoice = true;
        micBtn?.classList.add('text-rose-400', 'bg-rose-500/20', 'animate-pulse');
      };
      speechRec.onend = () => {
        isListeningVoice = false;
        micBtn?.classList.remove('text-rose-400', 'bg-rose-500/20', 'animate-pulse');
      };
      speechRec.onresult = (evt) => {
        let transcript = '';
        for (let i = evt.resultIndex; i < evt.results.length; ++i) {
          transcript += evt.results[i][0].transcript;
        }
        if (transcript && input) {
          input.value = (input.value ? input.value + ' ' : '') + transcript;
          adjustInputHeight();
          updateSendBtnState();
        }
      };
      speechRec.onerror = () => {
        isListeningVoice = false;
        micBtn?.classList.remove('text-rose-400', 'bg-rose-500/20', 'animate-pulse');
      };
    } catch (e) {}
  }

  let activeMediaRecorder = null;
  let activeAudioChunks = [];
  let recordingInterval = null;
  let recordingStartTime = 0;
  let isRecordingChatAudio = false;
  let isHoldSendingChatAudio = false;
  let isChatRecordingCancelled = false;
  let holdSendTimer = null;
  let touchStartY = 0;

  async function startChatAudioRecording(isHold = false) {
    if (!isSttReady()) {
      promptConfigureStt();
      return;
    }
    if (isRecordingChatAudio) return;

    if (!navigator.mediaDevices?.getUserMedia) {
      showNotification('⚠️ Microphone recording not supported on this device.', 'warning');
      return;
    }

    try {
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
      activeAudioChunks = [];
      activeMediaRecorder = new MediaRecorder(stream);
      isRecordingChatAudio = true;
      isHoldSendingChatAudio = isHold;
      isChatRecordingCancelled = false;

      activeMediaRecorder.ondataavailable = (e) => {
        if (e.data && e.data.size > 0) activeAudioChunks.push(e.data);
      };

      activeMediaRecorder.onstop = async () => {
        stream.getTracks().forEach(t => t.stop());
        clearInterval(recordingInterval);
        isRecordingChatAudio = false;
        voiceRecordingOverlay?.classList.add('hidden');
        micBtn?.classList.remove('text-rose-400', 'bg-rose-500/20', 'animate-pulse');

        if (isChatRecordingCancelled) {
          showNotification('Recording cancelled');
          return;
        }

        const audioBlob = new Blob(activeAudioChunks, { type: activeMediaRecorder.mimeType || 'audio/webm' });
        showNotification('Transcribing voice audio...');

        try {
          const transcript = await transcribeAudioBlob(audioBlob);
          if (!transcript || !transcript.trim()) {
            showNotification('No speech recognized.', 'info');
            return;
          }

          if (isHoldSendingChatAudio) {
            // Push-to-Talk auto-send
            if (typeof sendUserMessage === 'function') {
              sendUserMessage(transcript.trim());
            } else if (input) {
              input.value = transcript.trim();
              document.getElementById('room-send-btn')?.click();
            }
          } else {
            // Tap-to-record fills input
            if (input) {
              input.value = (input.value ? input.value + ' ' : '') + transcript.trim();
              adjustInputHeight();
              updateSendBtnState();
              input.focus();
            }
          }
        } catch (err) {
          showNotification(`⚠️ Voice transcription error: ${err.message}`, 'error');
        }
      };

      // Show recording UI
      voiceRecordingOverlay?.classList.remove('hidden');
      micBtn?.classList.add('text-rose-400', 'bg-rose-500/20', 'animate-pulse');
      if (voiceRecordingHint) {
        voiceRecordingHint.textContent = isHold ? 'Release to send • Slide away to cancel' : 'Tap mic again or Cancel to finish';
      }

      recordingStartTime = Date.now();
      if (voiceRecordingTimer) voiceRecordingTimer.textContent = '0:00';
      recordingInterval = setInterval(() => {
        const sec = Math.floor((Date.now() - recordingStartTime) / 1000);
        const m = Math.floor(sec / 60);
        const s = sec % 60;
        if (voiceRecordingTimer) {
          voiceRecordingTimer.textContent = `${m}:${s < 10 ? '0' : ''}${s}`;
        }
      }, 500);

      activeMediaRecorder.start();
    } catch (err) {
      showNotification(`⚠️ Microphone permission denied: ${err.message}`, 'error');
      isRecordingChatAudio = false;
    }
  }

  function stopChatAudioRecording(cancel = false) {
    if (!isRecordingChatAudio || !activeMediaRecorder) return;
    if (cancel) isChatRecordingCancelled = true;
    if (activeMediaRecorder.state === 'recording') {
      activeMediaRecorder.stop();
    }
  }

  cancelVoiceRecordingBtn?.addEventListener('click', () => {
    stopChatAudioRecording(true);
  });

  // Tap on mic button
  micBtn?.addEventListener('click', () => {
    if (!isSttReady()) {
