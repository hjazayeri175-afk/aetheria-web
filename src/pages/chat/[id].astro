          ${cat}
        </button>
      `;
    }).join('');

    voiceModalCategoryChips.querySelectorAll('.voice-cat-chip').forEach(btn => {
      btn.addEventListener('click', () => {
        currentVoiceCatalogFilter = btn.getAttribute('data-voice-filter') || 'all';
        renderVoiceModalCategories();
        renderVoiceCatalogItems(voiceModalSearch?.value || '');
      });
    });
  }

  function renderVoiceCatalogItems(query = '') {
    if (!voiceModalItems) return;
    const q = query.trim().toLowerCase();
    const list = voiceCatalogMode === 'tts' ? TTS_CATALOG : STT_CATALOG;
    const currentActiveId = voiceCatalogMode === 'tts'
      ? (voiceProviderSelect?.value || 'browser')
      : (sttProviderSelect?.value || 'groq');

    const filtered = list.filter(item => {
      // Category match
      if (currentVoiceCatalogFilter === 'popular' && item.category !== 'Popular') return false;
      if (currentVoiceCatalogFilter === 'realistic' && item.category !== 'Realistic') return false;
      if (currentVoiceCatalogFilter === 'fastest' && item.category !== 'Fastest') return false;
      if (currentVoiceCatalogFilter === 'free & offline' && item.category !== 'Free & Offline') return false;

      // Query match
      if (!q) return true;
      return item.name.toLowerCase().includes(q) ||
             item.desc.toLowerCase().includes(q) ||
             item.id.toLowerCase().includes(q) ||
             item.badge.toLowerCase().includes(q);
    });

    if (voiceModalCountBadge) {
      if (!q && currentVoiceCatalogFilter === 'all') {
        voiceModalCountBadge.textContent = `${list.length} Available`;
      } else if (filtered.length === list.length) {
        voiceModalCountBadge.textContent = `${list.length} Available`;
      } else {
        voiceModalCountBadge.textContent = `${filtered.length} of ${list.length}`;
      }
    }

    if (voiceModalActiveFooterText) {
      const activeObj = list.find(x => x.id === currentActiveId) || list[0];
      voiceModalActiveFooterText.textContent = `Active: ${activeObj.name}`;
    }

    if (quickSelectFreeVoiceBtn) {
      const isFreeDefaultActive = voiceCatalogMode === 'tts' 
        ? currentActiveId === 'browser' 
        : currentActiveId === 'browser-stt';

      if (isFreeDefaultActive) {
        quickSelectFreeVoiceBtn.innerHTML = `<span>Done</span>`;
        quickSelectFreeVoiceBtn.className = 'px-4 py-1.5 rounded-xl bg-white/[0.08] hover:bg-white/[0.12] text-white border border-white/10 transition text-xs font-semibold shrink-0 active:scale-95 cursor-pointer';
      } else {
        quickSelectFreeVoiceBtn.innerHTML = `
          <svg class="w-3.5 h-3.5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          <span>Use Free Device Voice</span>
        `;
        quickSelectFreeVoiceBtn.className = 'px-3 py-1.5 rounded-xl bg-emerald-500/15 hover:bg-emerald-500/25 text-emerald-300 border border-emerald-500/30 transition flex items-center gap-1.5 cursor-pointer text-xs font-semibold shrink-0 active:scale-95';
      }
    }

    if (filtered.length === 0) {
      voiceModalItems.innerHTML = `
        <div class="py-12 text-center text-slate-400 flex flex-col items-center justify-center">
          <div class="w-12 h-12 rounded-2xl bg-purple-500/10 border border-purple-500/20 text-purple-400 flex items-center justify-center mb-3 shadow-inner">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"/></svg>
          </div>
          <div class="text-sm font-semibold text-white mb-1">No Voice Engines Found</div>
          <div class="text-xs text-slate-400 max-w-xs mb-4">No engines match your search. Try another query or switch categories.</div>
          <button type="button" id="clear-voice-empty-btn" class="px-3.5 py-1.5 rounded-xl bg-purple-600 hover:bg-purple-500 text-white text-xs font-semibold transition cursor-pointer">
            Reset Filter
          </button>
        </div>
      `;
      document.getElementById('clear-voice-empty-btn')?.addEventListener('click', () => {
        if (voiceModalSearch) voiceModalSearch.value = '';
        currentVoiceCatalogFilter = 'all';
        renderVoiceModalCategories();
        renderVoiceCatalogItems();
      });
      return;
    }

    voiceModalItems.innerHTML = filtered.map(item => {
      const isSelected = item.id === currentActiveId;
      return `
        <button
          type="button"
          data-engine-id="${item.id}"
          class="voice-engine-card w-full p-3 sm:p-3.5 rounded-2xl border text-left transition-all flex items-center justify-between gap-3 cursor-pointer group ${
            isSelected
              ? (voiceCatalogMode === 'tts' 
                  ? 'bg-purple-950/40 border-purple-500/70 ring-1 ring-purple-500/30 shadow-md shadow-purple-950/40' 
                  : 'bg-rose-950/40 border-rose-500/70 ring-1 ring-rose-500/30 shadow-md shadow-rose-950/40')
