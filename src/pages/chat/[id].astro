  function adjustInputHeight() {
    if (!input) return;
    input.style.height = 'auto';

    const singleLineHeight = 28;
    const lineHeight = 26; // 17px * 1.55 line-height
    const maxLinesHeight = lineHeight * 6; // up to 6 lines max

    const val = input.value;
    const hasText = !!val.trim();
    const scrollHeight = input.scrollHeight;

    // Check if multi-line: user entered newline or text wrapped beyond 1 line
    const isMultiLine = hasText && (val.includes('\n') || scrollHeight > singleLineHeight + 6);

    updateComposerLayoutMode(isMultiLine);

    if (isMultiLine) {
      if (scrollHeight > maxLinesHeight) {
        input.style.height = `${maxLinesHeight}px`;
        input.style.overflowY = 'auto';
