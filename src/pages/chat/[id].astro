---
import Layout from '../../layouts/Layout.astro';
import { characters, customCharacterPlaceholder, type Character } from '../../data/characters';
import { 
  ArrowLeft, 
  Send, 
  Sparkles, 
  ShieldCheck, 
  KeyRound, 
  Volume2, 
  VolumeX, 
  Trash2, 
  Download, 
  RotateCcw, 
  PanelLeftClose, 
  PanelLeft, 
  Check, 
  Copy, 
  Flame, 
  Star, 
  Bot, 
  User, 
  ExternalLink, 
  MessageSquare, 
  SlidersHorizontal, 
  Camera, 
  Video, 
  Film,
  Brain, 
  Zap, 
  Play, 
  Eye, 
  EyeOff,
  Pencil,
  ChevronLeft,
  ChevronRight,
  RefreshCw,
  GitBranch,
  ChevronDown,
  Plus,
  BookOpen,
  Tag,
  Upload
} from '@lucide/astro';

export function getStaticPaths() {
  const paths = characters.map((character) => ({
    params: { id: character.id },
    props: { character },
  }));
  paths.push({
    params: { id: 'custom' },
    props: { character: customCharacterPlaceholder },
  });
  return paths;
}

interface Props {
  character: Character;
}

const { character } = Astro.props;
---

<Layout title={`${character.name} — Immersive Roleplay Chat | Aetheria AI`}>
  <div class="h-screen flex flex-col bg-[#070913] text-slate-100 overflow-hidden font-sans">
    
    <!-- Top Navigation Header -->
    <header class="h-14 sm:h-16 border-b border-white/[0.08] bg-[#090b17]/95 backdrop-blur-xl px-3 sm:px-6 flex items-center justify-between z-30 shrink-0">
      <div class="flex items-center gap-2.5 sm:gap-4">
        <!-- Back to Hub -->
        <a 
          href="/" 
          class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] text-slate-300 hover:text-white text-xs font-medium transition active:scale-95"
          title="Back to Hub"
        >
          <ArrowLeft class="w-4 h-4 text-purple-400" />
          <span class="hidden sm:inline">Hub</span>
        </a>

        <!-- Character Status Header -->
        <div class="flex items-center gap-2.5">
          <div class="relative w-9 h-9 sm:w-10 sm:h-10 rounded-full overflow-hidden ring-2 ring-purple-500/30 shrink-0">
            <img 
              id="chat-header-avatar"
              src={character.avatarUrl} 
              alt={character.name} 
              class="w-full h-full object-cover" 
            />
            <span class="absolute bottom-0 right-0 w-2.5 h-2.5 rounded-full bg-emerald-400 ring-2 ring-[#090b17]"></span>
          </div>
          <div>
            <div class="flex items-center gap-1.5">
              <h1 id="chat-header-name" class="text-xs sm:text-sm font-bold text-white tracking-wide">{character.name}</h1>
              <span class="inline-flex items-center gap-0.5 px-1.5 py-0.2 rounded text-[9px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
                <ShieldCheck class="w-2.5 h-2.5" />
                <span>SFW</span>
              </span>
            </div>
            <p id="chat-header-title" class="text-[10px] sm:text-xs text-purple-400/90 truncate max-w-[130px] sm:max-w-xs">{character.title}</p>
          </div>
        </div>
      </div>

      <!-- Right Header Actions -->
      <div class="flex items-center gap-1 sm:gap-2">
        <!-- Chat Branch / Sessions Dropdown Trigger -->
        <div class="relative">
          <button 
            id="chat-sessions-btn"
            type="button"
            class="flex items-center gap-1.5 px-2.5 sm:px-3 py-1.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] text-slate-300 hover:text-white text-xs font-medium transition cursor-pointer active:scale-95"
            title="Manage Chat Branches & Sessions"
          >
            <GitBranch class="w-3.5 h-3.5 text-emerald-400" />
            <span id="active-session-label" class="hidden sm:inline font-mono truncate max-w-[90px]">Main Branch</span>
            <ChevronDown class="w-3 h-3 text-slate-400" />
          </button>

          <!-- Sessions Dropdown Popover -->
          <div 
            id="sessions-dropdown" 
            class="hidden absolute right-0 mt-2 w-72 sm:w-80 rounded-2xl bg-[#0c0f20]/95 border border-purple-500/30 shadow-2xl shadow-purple-950/80 p-3 z-50 backdrop-blur-2xl"
          >
            <div class="flex items-center justify-between pb-2 mb-2 border-b border-white/[0.08]">
              <div class="flex items-center gap-1.5">
                <GitBranch class="w-3.5 h-3.5 text-emerald-400" />
                <span class="text-xs font-bold text-white">Story Branches</span>
              </div>
              <button 
                id="create-new-session-btn"
                type="button"
                class="px-2.5 py-1 rounded-lg bg-emerald-500/20 hover:bg-emerald-500/30 border border-emerald-500/40 text-emerald-300 text-[11px] font-bold flex items-center gap-1 transition cursor-pointer"
              >
                <Plus class="w-3 h-3" />
                <span>New Branch</span>
              </button>
            </div>

            <!-- List of Sessions Container -->
            <div id="sessions-list" class="max-h-60 overflow-y-auto space-y-1.5 pr-0.5 text-xs">
              <!-- Rendered via JS -->
            </div>
          </div>
        </div>

        <!-- Multi-Modal Engine Button (Primary BYOK & Tuning Hub) -->
        <button 
          id="chat-byok-btn"
          class="flex items-center gap-1.5 px-2.5 sm:px-3 py-1.5 rounded-xl bg-purple-950/50 hover:bg-purple-900/60 border border-purple-500/40 text-purple-200 text-xs font-medium transition cursor-pointer shadow-lg shadow-purple-950/50 active:scale-95 group"
          title="Configure Multi-Modal AI Engine (Text, Voice, Image, Video)"
        >
          <SlidersHorizontal class="w-3.5 h-3.5 text-cyan-400 group-hover:rotate-45 transition duration-300" />
          <span class="hidden md:inline font-mono font-semibold" id="chat-engine-label">Engine: Groq (Llama 3.3)</span>
          <span class="inline md:hidden font-mono font-semibold">Engine</span>
        </button>

        <!-- Toggle Lore Sidebar (Desktop / Tablet) -->
        <button 
          id="toggle-sidebar-btn"
          class="p-2 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] text-slate-400 hover:text-slate-200 text-xs transition cursor-pointer"
          title="Toggle Character Persona Details"
        >
          <PanelLeft class="w-4 h-4 text-purple-400" />
        </button>

        <!-- Voice Read Aloud Quick Toggle -->
        <button 
          id="toggle-tts-btn"
          class="p-2 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] text-slate-400 hover:text-purple-300 text-xs transition cursor-pointer"
          title="Toggle Voice Read Aloud"
        >
          <Volume2 id="tts-icon-on" class="w-4 h-4 text-purple-400" />
          <VolumeX id="tts-icon-off" class="w-4 h-4 text-slate-500 hidden" />
        </button>

        <!-- Export Chat -->
        <button 
          id="export-chat-btn"
          class="hidden sm:flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] text-slate-300 hover:text-white text-xs transition cursor-pointer"
          title="Export Conversation (Markdown)"
        >
          <Download class="w-3.5 h-3.5 text-slate-400" />
          <span>Export</span>
        </button>

        <!-- Clear Chat History -->
        <button 
          id="clear-chat-btn"
          class="p-2 rounded-xl bg-white/[0.04] hover:bg-red-500/20 border border-white/[0.08] hover:border-red-500/30 text-slate-400 hover:text-red-400 text-xs transition cursor-pointer"
          title="Clear Conversation History"
        >
          <Trash2 class="w-4 h-4" />
        </button>
      </div>
    </header>

    <!-- Main Content Area: Sidebar + Chat Thread -->
    <div class="flex-1 flex overflow-hidden relative">
      
      <!-- Left Sidebar: Character Persona & Lore Drawer -->
      <aside 
        id="character-sidebar"
        class="w-80 shrink-0 border-r border-white/[0.08] bg-[#080a14] overflow-y-auto hidden lg:flex flex-col p-5 space-y-5 transition-all duration-300 z-20"
      >
        <!-- Character Portrait Banner -->
        <div class="relative rounded-2xl overflow-hidden aspect-[4/3] border border-white/[0.1] shadow-lg shadow-purple-950/40">
          <img 
            id="chat-sidebar-avatar"
            src={character.avatarUrl} 
            alt={character.name} 
            class="w-full h-full object-cover" 
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#080a14] via-transparent to-transparent"></div>
          <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between">
            <span id="chat-sidebar-category" class="text-[11px] font-semibold px-2 py-0.5 rounded-full bg-black/60 backdrop-blur-md text-purple-300 border border-purple-500/30">
              {character.category}
            </span>
            <div class="flex items-center gap-1 text-[11px] font-bold text-amber-400 bg-black/60 px-2 py-0.5 rounded-full backdrop-blur-md">
              <Star class="w-3 h-3 fill-amber-400" />
              <span>{character.rating}</span>
            </div>
          </div>
        </div>

        <!-- Bio & Lore -->
        <div class="space-y-2">
          <h2 class="text-xs uppercase tracking-wider text-slate-400 font-bold">About Character</h2>
          <p id="chat-sidebar-desc" class="text-xs text-slate-300 leading-relaxed bg-white/[0.02] p-3.5 rounded-xl border border-white/[0.05]">
            {character.description}
          </p>
        </div>

        <!-- Tags -->
        <div class="space-y-2">
          <h2 class="text-xs uppercase tracking-wider text-slate-400 font-bold">Tags & Archetypes</h2>
          <div class="flex flex-wrap gap-1.5">
            {character.tags.map((tag) => (
              <span class="px-2.5 py-1 rounded-lg bg-white/[0.04] text-[11px] text-slate-300 border border-white/[0.06]">
                #{tag}
              </span>
            ))}
          </div>
        </div>

        <!-- World Info & Lorebook Manager Strip (Part 4) -->
        <div class="p-3.5 rounded-2xl bg-gradient-to-b from-[#0e1227] to-[#0a0d1d] border border-cyan-500/20 space-y-3 shadow-lg shadow-cyan-950/20">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <BookOpen class="w-4 h-4 text-cyan-400" />
              <h2 class="text-xs font-bold text-white tracking-wide">World Lorebook</h2>
            </div>
            <span id="lorebook-entries-badge" class="px-2 py-0.5 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-[10px] font-mono text-cyan-300">
              0 Entries
            </span>
          </div>
          <p class="text-[11px] text-slate-400 leading-relaxed">
            Dynamic context injection. Triggers secret lore when matching keywords appear in conversation.
          </p>
          <div class="flex items-center gap-2">
            <button 
              id="open-lorebook-btn"
              type="button"
              class="w-full flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl bg-cyan-600/20 hover:bg-cyan-600/30 border border-cyan-500/30 text-cyan-300 hover:text-white text-xs font-semibold transition active:scale-95 cursor-pointer shadow-sm"
            >
              <BookOpen class="w-3.5 h-3.5" />
              <span>Manage Lorebook 📚</span>
            </button>
          </div>
          <!-- Live Triggered Lore Feedback -->
          <div id="sidebar-lore-triggers" class="hidden space-y-1.5 pt-2 border-t border-white/[0.06]">
            <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">Active In Memory:</span>
            <div id="sidebar-lore-tags" class="flex flex-wrap gap-1">
              <!-- Dynamically populated -->
            </div>
          </div>
        </div>

        <!-- Pinned Memory & Author's Note Box (SillyTavern Standard) -->
        <div class="p-3.5 rounded-2xl bg-gradient-to-b from-[#161226] to-[#0c0919] border border-amber-500/25 space-y-2.5 shadow-lg shadow-amber-950/20">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-1.5">
              <span class="text-sm">📌</span>
              <h2 class="text-xs font-bold text-amber-200 tracking-wide">Pinned Memory</h2>
            </div>
            <span class="px-2 py-0.5 rounded-full bg-amber-500/10 border border-amber-500/20 text-[10px] font-mono text-amber-300">
              Author's Note
            </span>
          </div>
          <p class="text-[11px] text-slate-400 leading-relaxed">
            Persistent context anchor. Injected into every AI turn to preserve key relationship facts and plot states across long chats.
          </p>
          <textarea 
            id="pinned-note-input"
            rows="3"
            placeholder="e.g. {{char}} and {{user}} escaped Sector 4 together. They share a fragile trust and are currently hiding from patrols..."
            class="w-full px-2.5 py-2 rounded-xl bg-black/40 border border-white/10 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-amber-400/50 resize-none font-sans leading-relaxed"
          ></textarea>
          <div class="flex items-center justify-between pt-1">
            <span id="pinned-note-status" class="text-[10px] text-slate-400 font-mono">0 chars</span>
            <button 
              id="save-pinned-note-btn"
              type="button"
              class="px-2.5 py-1 rounded-lg bg-amber-500/20 hover:bg-amber-500/30 border border-amber-500/40 text-amber-300 hover:text-white text-[11px] font-medium transition cursor-pointer active:scale-95"
            >
              Save Pin 📌
            </button>
          </div>
        </div>

        <!-- Safety Certification -->
        <div class="p-3.5 rounded-xl bg-purple-950/20 border border-purple-500/20 space-y-1.5">
          <div class="flex items-center gap-1.5 text-xs font-semibold text-purple-300">
            <Sparkles class="w-3.5 h-3.5 text-cyan-400" />
            <span>Tavern V2 Compliant</span>
          </div>
          <p class="text-[11px] text-slate-400 leading-normal">
            Multi-modal roleplay ready. Supports live LLM cognition, streaming speech synthesis, and dynamic scene selfies.
          </p>
        </div>

        <!-- Session Privacy -->
        <div class="text-[10px] text-slate-500 text-center pt-4 border-t border-white/[0.05]">
          Client-side encrypted memory. Chats & API keys stay 100% in your browser.
        </div>
      </aside>

      <!-- Center: Immersive Chat Feed & Input -->
      <section class="flex-1 flex flex-col h-full overflow-hidden bg-gradient-to-b from-[#090b17] to-[#060810] relative">
        
        <!-- Multi-Modal AI Engine Suite Modal / Drawer -->
        <div 
          id="chat-byok-tray" 
          class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-3 sm:p-6 transition-all duration-300"
        >
          <div class="w-full max-w-3xl max-h-[92vh] bg-[#0c0f22] border border-purple-500/30 rounded-3xl shadow-2xl shadow-purple-950/80 flex flex-col overflow-hidden animate-in fade-in zoom-in-95 duration-200">
            
            <!-- Modal Header -->
            <div class="p-4 sm:p-5 border-b border-white/[0.08] bg-[#090c1b] flex items-center justify-between shrink-0">
              <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-2xl bg-gradient-to-br from-purple-600 to-cyan-500 flex items-center justify-center text-white shadow-lg shadow-purple-900/50">
                  <SlidersHorizontal class="w-5 h-5" />
                </div>
                <div>
                  <h3 class="text-sm sm:text-base font-bold text-white flex items-center gap-2">
                    <span>Multi-Modal AI Engine Suite</span>
                    <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-cyan-500/10 text-cyan-400 border border-cyan-500/20">BYOK Pro</span>
                  </h3>
                  <p class="text-[11px] text-slate-400">Configure text cognition, voice synthesis, image generation & video motion.</p>
                </div>
              </div>
              <button id="close-chat-byok" class="w-8 h-8 rounded-full bg-white/[0.06] hover:bg-white/[0.12] text-slate-300 hover:text-white flex items-center justify-center transition cursor-pointer text-sm">✕</button>
            </div>

            <!-- Tab Navigation Bar (4 Modalities) -->
            <div class="px-4 sm:px-6 pt-3 border-b border-white/[0.08] bg-[#0a0d1e] flex gap-2 overflow-x-auto no-scrollbar shrink-0">
              <button type="button" class="engine-tab-btn px-4 py-2.5 text-xs font-bold rounded-t-xl transition flex items-center gap-2 cursor-pointer border-b-2 border-purple-500 text-purple-300 bg-purple-950/30" data-tab="tab-text">
                <Brain class="w-4 h-4 text-purple-400" />
                <span>Text (Brain & LLM)</span>
              </button>
              <button type="button" class="engine-tab-btn px-4 py-2.5 text-xs font-bold rounded-t-xl transition flex items-center gap-2 cursor-pointer border-b-2 border-transparent text-slate-400 hover:text-slate-200" data-tab="tab-voice">
                <Volume2 class="w-4 h-4 text-emerald-400" />
                <span>Voice (Speech & TTS)</span>
              </button>
              <button type="button" class="engine-tab-btn px-4 py-2.5 text-xs font-bold rounded-t-xl transition flex items-center gap-2 cursor-pointer border-b-2 border-transparent text-slate-400 hover:text-slate-200" data-tab="tab-image">
                <Camera class="w-4 h-4 text-amber-400" />
                <span>Image (Selfies & Art)</span>
              </button>
              <button type="button" class="engine-tab-btn px-4 py-2.5 text-xs font-bold rounded-t-xl transition flex items-center gap-2 cursor-pointer border-b-2 border-transparent text-slate-400 hover:text-slate-200" data-tab="tab-video">
                <Video class="w-4 h-4 text-cyan-400" />
                <span>Video (Living Motion)</span>
              </button>
            </div>

            <!-- Modal Body (Scrollable Settings Panes) -->
            <div class="p-4 sm:p-6 overflow-y-auto flex-1 space-y-6">
              
              <!-- ================= 1. TAB: TEXT ENGINE ================= -->
              <div id="tab-text" class="engine-tab-pane space-y-5">
                <div class="flex items-center justify-between pb-2 border-b border-white/[0.06]">
                  <div>
                    <h4 class="text-xs sm:text-sm font-bold text-white flex items-center gap-2">
                      <Brain class="w-4 h-4 text-purple-400" />
                      <span>Text Model & Cognition Hyperparameters</span>
                    </h4>
                    <p class="text-[11px] text-slate-400">Controls character reasoning, creativity, response length & conversational fidelity.</p>
                  </div>
                  <button type="button" id="ping-text-btn" class="px-3 py-1.5 rounded-xl bg-purple-900/40 hover:bg-purple-800/60 border border-purple-500/30 text-purple-300 text-xs font-semibold flex items-center gap-1.5 transition cursor-pointer">
                    <Zap class="w-3.5 h-3.5 text-cyan-400" />
                    <span>Test Latency</span>
                  </button>
                </div>

                <div id="ping-status-msg" class="hidden text-xs px-3.5 py-2 rounded-xl border"></div>

                <!-- Provider & Key Grid -->
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                  <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1.5">LLM Provider</label>
                    <select id="text-provider-select" class="w-full px-3.5 py-2.5 rounded-xl bg-white/[0.05] border border-white/10 text-xs text-white outline-none focus:border-purple-500/60">
                      <option value="groq">Groq (Ultra-Fast Llama 3.3 70B & 8B — Free Tier)</option>
                      <option value="openrouter">OpenRouter (Claude 3.5 Sonnet, DeepSeek V3, Mistral)</option>
                      <option value="deepseek">DeepSeek Direct (deepseek-chat / deepseek-reasoner)</option>
                      <option value="openai">OpenAI (GPT-4o, GPT-4o-mini)</option>
                      <option value="anthropic">Anthropic (Claude 3.5 Sonnet, Haiku)</option>
                      <option value="custom">Custom OpenAI-Compatible Endpoint (Ollama, LMStudio, vLLM)</option>
                      <option value="demo">Free Edge Simulator (No API Key Required)</option>
                    </select>
                  </div>

                  <div>
                    <label class="block text-xs font-semibold text-slate-300 mb-1.5 flex items-center justify-between">
                      <span>API Key</span>
                      <button type="button" id="toggle-key-visibility" class="text-[10px] text-purple-400 hover:text-purple-300">Show/Hide</button>
                    </label>
                    <div class="relative">
                      <input 
                        id="text-api-key" 
                        type="password" 
                        placeholder="sk-... or gsk_..." 
                        class="w-full px-3.5 py-2.5 rounded-xl bg-white/[0.05] border border-white/10 text-xs text-white placeholder:text-slate-500 outline-none focus:border-purple-500/60 font-mono"
                      />
                    </div>
                  </div>
                </div>

                <!-- Custom Base URL (Conditional) -->
                <div id="custom-base-url-container" class="hidden space-y-1.5">
                  <label class="block text-xs font-semibold text-slate-300">Custom Base URL</label>
                  <input 
                    id="text-base-url" 
                    type="url" 
                    placeholder="http://localhost:11434/v1 or https://my-custom-proxy.com/v1" 
                    class="w-full px-3.5 py-2.5 rounded-xl bg-white/[0.05] border border-white/10 text-xs text-white placeholder:text-slate-500 outline-none focus:border-purple-500/60 font-mono"
                  />
                  <p class="text-[10px] text-slate-400">Compatible with Ollama, LM Studio, vLLM, Text-Gen-WebUI & custom reverse proxies.</p>
                </div>

                <!-- Model Identifier -->
                <div class="space-y-1.5">
                  <label class="block text-xs font-semibold text-slate-300 flex items-center justify-between">
                    <span>Model Identifier</span>
                    <span class="text-[10px] text-slate-400">e.g. anthropic/claude-3.5-sonnet, llama-3.3-70b-versatile</span>
                  </label>
                  <input 
                    id="text-model-input" 
                    type="text" 
                    value="llama-3.3-70b-versatile"
                    class="w-full px-3.5 py-2.5 rounded-xl bg-white/[0.05] border border-white/10 text-xs text-white outline-none focus:border-purple-500/60 font-mono"
                  />
                  <!-- Quick Model Presets -->
                  <div class="flex flex-wrap gap-1.5 pt-1">
                    <span class="text-[10px] text-slate-500 self-center">Presets:</span>
                    <button type="button" class="quick-model-pill text-[10px] px-2 py-0.5 rounded-lg bg-white/[0.04] hover:bg-purple-950 text-slate-300 hover:text-purple-300 border border-white/10 transition" data-model="llama-3.3-70b-versatile">Llama 3.3 70B (Groq)</button>
                    <button type="button" class="quick-model-pill text-[10px] px-2 py-0.5 rounded-lg bg-white/[0.04] hover:bg-purple-950 text-slate-300 hover:text-purple-300 border border-white/10 transition" data-model="anthropic/claude-3.5-sonnet">Claude 3.5 Sonnet</button>
                    <button type="button" class="quick-model-pill text-[10px] px-2 py-0.5 rounded-lg bg-white/[0.04] hover:bg-purple-950 text-slate-300 hover:text-purple-300 border border-white/10 transition" data-model="deepseek/deepseek-chat">DeepSeek V3</button>
                    <button type="button" class="quick-model-pill text-[10px] px-2 py-0.5 rounded-lg bg-white/[0.04] hover:bg-purple-950 text-slate-300 hover:text-purple-300 border border-white/10 transition" data-model="gpt-4o">GPT-4o</button>
                  </div>
                </div>

                <!-- Sliders Grid (Hyperparameters) -->
                <div class="p-4 rounded-2xl bg-white/[0.02] border border-white/[0.06] space-y-4">
                  <div class="flex items-center justify-between text-xs font-bold text-slate-300 uppercase tracking-wider">
                    <span>Hyperparameter Tuning</span>
                    <span class="text-[10px] text-purple-400 font-normal lowercase">real-time probability sampling</span>
