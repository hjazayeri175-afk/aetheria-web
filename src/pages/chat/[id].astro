---
import Layout from '../../layouts/Layout.astro';
import { characters, customCharacterPlaceholder, type Character } from '../../data/characters';
import { 
  ArrowLeft, 
  Send, 
  Sparkles, 
  ShieldCheck, 
  KeyRound, 
  Volume2, 
  VolumeX, 
  Trash2, 
  Download, 
  RotateCcw, 
  PanelLeftClose, 
  PanelLeft, 
  Check, 
  Copy, 
  Flame, 
  Star, 
  Bot, 
  User, 
  ExternalLink, 
  MessageSquare, 
  SlidersHorizontal, 
  Camera, 
  Video, 
  Film,
  Brain, 
  Zap, 
  Play, 
  Eye, 
  EyeOff,
  Pencil,
  ChevronLeft,
  ChevronRight,
  RefreshCw,
  GitBranch,
  ChevronDown,
  Plus,
  BookOpen,
  Tag,
  Upload,
  Maximize2,
  X,
  Search,
  Cloud,
  Lock,
  LockOpen,
  Flag,
  Rewind,
  ArrowUp,
  Mic
} from '@lucide/astro';

export function getStaticPaths() {
  const paths = characters.map((character) => ({
    params: { id: character.id },
    props: { character },
  }));
  paths.push({
    params: { id: 'custom' },
    props: { character: customCharacterPlaceholder },
  });
  return paths;
}

interface Props {
  character: Character;
}

const { character } = Astro.props;
---

<Layout title={`${character.name} — Immersive Roleplay Chat | Aetheria AI`} noScroll={true}>
  <div class="h-[100dvh] max-h-[100dvh] w-full max-w-[100vw] flex flex-col bg-[#070913] text-slate-100 overflow-hidden font-sans">
    
    <!-- Top Navigation Header -->
    <header class="h-14 sm:h-16 border-b border-white/[0.08] bg-[#090b17]/95 backdrop-blur-xl px-2 sm:px-6 flex items-center justify-between z-30 shrink-0 w-full max-w-full overflow-visible">
      <div class="flex items-center gap-1.5 sm:gap-4 min-w-0">
        <!-- Back to Hub -->
        <a 
          href="/" 
          class="flex items-center gap-1 p-2 sm:px-2.5 sm:py-1.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] text-slate-300 hover:text-white text-xs font-medium transition active:scale-95 shrink-0"
          title="Back to Hub"
        >
          <ArrowLeft class="w-4 h-4 text-purple-400" />
          <span class="hidden sm:inline">Hub</span>
        </a>

        <!-- Character Status Header -->
        <div class="flex items-center gap-2 min-w-0">
          <button 
            id="open-lightbox-header-btn"
            type="button"
            class="relative w-8 h-8 sm:w-10 sm:h-10 rounded-full overflow-hidden ring-2 ring-purple-500/30 hover:ring-purple-400 transition cursor-pointer active:scale-95 group shrink-0"
            title="View Full Character Art"
          >
            <img 
              id="chat-header-avatar"
              src={character.avatarUrl} 
              alt={character.name} 
              class="w-full h-full object-cover group-hover:scale-110 transition duration-300" 
            />
            <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition flex items-center justify-center">
              <Maximize2 class="w-3.5 h-3.5 text-white drop-shadow" />
            </div>
            <span class="absolute bottom-0 right-0 w-2 h-2 sm:w-2.5 sm:h-2.5 rounded-full bg-emerald-400 ring-2 ring-[#090b17]"></span>
          </button>
          <div class="min-w-0">
            <div class="flex items-center gap-1">
              <h1 id="chat-header-name" class="text-xs sm:text-sm font-bold text-white tracking-wide truncate max-w-[85px] xs:max-w-[130px] sm:max-w-none">{character.name}</h1>


              <!-- Cloud Sync Indicator (Anti-Clear Cache) -->
              <span id="chat-cloud-sync-badge" class="hidden items-center gap-1 px-1.5 py-0.2 rounded text-[8px] sm:text-[9px] font-semibold bg-cyan-500/10 text-cyan-400 border border-cyan-500/20 shrink-0" title="Connected to Cloud Edge Storage">
                <Cloud class="w-2.5 h-2.5" />
                <span id="chat-cloud-sync-text">Cloud</span>
              </span>
            </div>
            <p id="chat-header-title" class="text-[10px] sm:text-xs text-purple-400/90 truncate max-w-[85px] xs:max-w-[130px] sm:max-w-xs">{character.title}</p>
          </div>
        </div>
      </div>

      <!-- Right Header Actions -->
      <div class="flex items-center gap-1 sm:gap-2 shrink-0">
        <!-- Chat Branch / Sessions Dropdown Trigger -->
        <div class="relative">
          <button 
            id="chat-sessions-btn"
            type="button"
            class="flex items-center gap-1 p-2 sm:px-3 sm:py-1.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] text-slate-300 hover:text-white text-xs font-medium transition cursor-pointer active:scale-95"
            title="Manage Chat Branches & Sessions"
          >
            <GitBranch class="w-3.5 h-3.5 text-emerald-400" />
            <span id="active-session-label" class="hidden md:inline font-mono truncate max-w-[90px]">Main Branch</span>
            <ChevronDown class="w-3 h-3 text-slate-400 hidden sm:inline" />
          </button>

          <!-- Sessions Dropdown Popover -->
          <div 
            id="sessions-dropdown" 
            class="hidden fixed inset-x-3 top-16 sm:absolute sm:inset-auto sm:right-0 sm:top-full sm:mt-2 w-auto sm:w-80 max-w-[calc(100vw-1.5rem)] rounded-2xl bg-[#0c0f20]/98 border border-purple-500/30 shadow-2xl shadow-purple-950/80 p-3 z-50 backdrop-blur-2xl"
          >
            <div class="flex items-center justify-between pb-2 mb-2 border-b border-white/[0.08]">
              <div class="flex items-center gap-1.5">
                <GitBranch class="w-3.5 h-3.5 text-emerald-400" />
                <span class="text-xs font-bold text-white">Story Branches</span>
              </div>
              <button 
                id="create-new-session-btn"
                type="button"
                class="px-2.5 py-1 rounded-lg bg-emerald-500/20 hover:bg-emerald-500/30 border border-emerald-500/40 text-emerald-300 text-[11px] font-bold flex items-center gap-1 transition cursor-pointer"
              >
                <Plus class="w-3 h-3" />
                <span>New Branch</span>
              </button>
            </div>

            <!-- List of Sessions Container -->
            <div id="sessions-list" class="max-h-60 overflow-y-auto space-y-1.5 pr-0.5 text-xs">
              <!-- Rendered via JS -->
            </div>
          </div>
        </div>

        <!-- Chat Settings Button -->
        <button 
          id="chat-byok-btn"
          class="flex items-center gap-1.5 p-2 sm:px-3 sm:py-1.5 rounded-xl bg-purple-950/50 hover:bg-purple-900/60 border border-purple-500/40 text-purple-200 text-xs font-medium transition cursor-pointer shadow-lg shadow-purple-950/50 active:scale-95 group"
          title="Chat Preferences (Voice, Selfies & AI Settings)"
        >
          <SlidersHorizontal class="w-3.5 h-3.5 text-purple-400 group-hover:rotate-45 transition duration-300" />
          <span class="hidden sm:inline font-medium" id="chat-engine-label">Settings</span>
        </button>

        <!-- Toggle Lore Sidebar (Desktop / Mobile Drawer) -->
        <button 
          id="toggle-sidebar-btn"
          class="p-2 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] text-slate-400 hover:text-slate-200 text-xs transition cursor-pointer"
          title="Toggle Character Details"
        >
          <PanelLeft class="w-4 h-4 text-purple-400" />
        </button>

        <!-- Voice Read Aloud Quick Toggle -->
        <button 
          id="toggle-tts-btn"
          class="p-2 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] text-slate-400 hover:text-purple-300 text-xs transition cursor-pointer"
          title="Toggle Auto Voice Read Aloud"
        >
          <Volume2 id="tts-icon-on" class="w-4 h-4 text-purple-400 hidden" />
          <VolumeX id="tts-icon-off" class="w-4 h-4 text-slate-400" />
        </button>

        <!-- Export Chat -->
        <button 
          id="export-chat-btn"
          class="hidden sm:flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] text-slate-300 hover:text-white text-xs transition cursor-pointer"
          title="Export Conversation (Markdown)"
        >
          <Download class="w-3.5 h-3.5 text-slate-400" />
          <span>Export</span>
        </button>

        <!-- Clear Chat History -->
        <button 
          id="clear-chat-btn"
          class="p-2 rounded-xl bg-white/[0.04] hover:bg-red-500/20 border border-white/[0.08] hover:border-red-500/30 text-slate-400 hover:text-red-400 text-xs transition cursor-pointer"
          title="Clear Conversation History"
        >
          <Trash2 class="w-4 h-4" />
        </button>
      </div>
    </header>

    <!-- Main Content Area: Sidebar + Chat Thread -->
    <div class="flex-1 flex overflow-hidden relative w-full max-w-full min-w-0">
      
      <!-- Backdrop for mobile drawer -->
      <div 
        id="sidebar-backdrop" 
        class="fixed inset-0 bg-black/75 backdrop-blur-sm z-40 hidden transition-opacity"
      ></div>

      <!-- Left Sidebar: Character Persona & Lore Drawer -->
      <aside 
        id="character-sidebar"
        class="fixed inset-y-0 left-0 z-50 w-80 max-w-[85vw] border-r border-white/[0.08] bg-[#080a14] overflow-y-auto hidden lg:flex lg:relative lg:inset-auto lg:z-20 flex-col p-4 sm:p-5 space-y-4 sm:space-y-5 transition-all duration-300 shadow-2xl lg:shadow-none"
      >
        <!-- Mobile Close Header -->
        <div class="flex items-center justify-between lg:hidden pb-3 border-b border-white/[0.08]">
          <span class="text-xs font-bold text-white uppercase tracking-wider">Character Lore & Details</span>
          <button 
            id="close-sidebar-mobile-btn" 
            type="button" 
            class="p-1.5 rounded-xl bg-white/[0.05] hover:bg-white/[0.1] text-slate-300 hover:text-white transition cursor-pointer"
            title="Close Drawer"
          >
            <PanelLeftClose class="w-4 h-4 text-purple-400" />
          </button>
        </div>
        <!-- Character Portrait Banner (Clickable Lightbox Trigger) -->
        <button 
          id="open-lightbox-sidebar-btn" 
          type="button"
          class="relative w-full rounded-2xl overflow-hidden aspect-[4/3] border border-white/[0.1] shadow-lg shadow-purple-950/40 cursor-pointer group transition active:scale-[0.99] text-left block"
          title="View Full High-Resolution Artwork"
        >
          <img 
            id="chat-sidebar-avatar"
            src={character.avatarUrl} 
            alt={character.name} 
            class="w-full h-full object-cover group-hover:scale-105 transition duration-500" 
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#080a14] via-transparent to-transparent"></div>

          <!-- Hover Expand Badge -->
          <div class="absolute top-3 right-3 flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-black/70 backdrop-blur-md text-[10px] font-semibold text-white border border-white/20 opacity-80 group-hover:opacity-100 group-hover:border-purple-400 transition">
            <Maximize2 class="w-3 h-3 text-purple-300" />
            <span>Full Art</span>
          </div>

          <div class="absolute bottom-3 left-3 right-3 flex items-center justify-between">
            <span id="chat-sidebar-category" class="text-[11px] font-semibold px-2 py-0.5 rounded-full bg-black/60 backdrop-blur-md text-purple-300 border border-purple-500/30">
              {character.category}
            </span>
            <div class="flex items-center gap-1 text-[11px] font-bold text-amber-400 bg-black/60 px-2 py-0.5 rounded-full backdrop-blur-md">
              <Star class="w-3 h-3 fill-amber-400" />
              <span>{character.rating}</span>
            </div>
          </div>
        </button>

        <!-- Bio & Lore -->
        <div class="space-y-2">
          <h2 class="text-xs uppercase tracking-wider text-slate-400 font-bold">About Character</h2>
          <p id="chat-sidebar-desc" class="text-xs text-slate-300 leading-relaxed bg-white/[0.02] p-3.5 rounded-xl border border-white/[0.05]">
            {character.description}
          </p>
        </div>

        <!-- Tags -->
        <div class="space-y-2">
          <h2 class="text-xs uppercase tracking-wider text-slate-400 font-bold">Tags & Archetypes</h2>
          <div class="flex flex-wrap gap-1.5">
            {character.tags.map((tag) => (
              <span class="px-2.5 py-1 rounded-lg bg-white/[0.04] text-[11px] text-slate-300 border border-white/[0.06]">
                #{tag}
              </span>
            ))}
          </div>
        </div>

        <!-- World Info & Lorebook Manager Strip (Part 4) -->
        <div class="p-3.5 rounded-2xl bg-gradient-to-b from-[#0e1227] to-[#0a0d1d] border border-cyan-500/20 space-y-3 shadow-lg shadow-cyan-950/20">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-2">
              <BookOpen class="w-4 h-4 text-cyan-400" />
              <h2 class="text-xs font-bold text-white tracking-wide">World Lorebook</h2>
            </div>
            <span id="lorebook-entries-badge" class="px-2 py-0.5 rounded-full bg-cyan-500/10 border border-cyan-500/20 text-[10px] font-mono text-cyan-300">
              0 Entries
            </span>
          </div>
          <p class="text-[11px] text-slate-400 leading-relaxed">
            Dynamic context injection. Triggers secret lore when matching keywords appear in conversation.
          </p>
          <div class="flex items-center gap-2">
            <button 
              id="open-lorebook-btn"
              type="button"
              class="w-full flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl bg-cyan-600/20 hover:bg-cyan-600/30 border border-cyan-500/30 text-cyan-300 hover:text-white text-xs font-semibold transition active:scale-95 cursor-pointer shadow-sm"
            >
              <BookOpen class="w-3.5 h-3.5" />
              <span>Manage Lorebook 📚</span>
            </button>
          </div>
          <!-- Live Triggered Lore Feedback -->
          <div id="sidebar-lore-triggers" class="hidden space-y-1.5 pt-2 border-t border-white/[0.06]">
            <span class="text-[10px] uppercase font-bold text-slate-400 tracking-wider">Active In Memory:</span>
            <div id="sidebar-lore-tags" class="flex flex-wrap gap-1">
              <!-- Dynamically populated -->
            </div>
          </div>
        </div>

        <!-- Pinned Memory & Author's Note Box (SillyTavern Standard) -->
        <div class="p-3.5 rounded-2xl bg-gradient-to-b from-[#161226] to-[#0c0919] border border-amber-500/25 space-y-2.5 shadow-lg shadow-amber-950/20">
          <div class="flex items-center justify-between">
            <div class="flex items-center gap-1.5">
              <span class="text-sm">📌</span>
              <h2 class="text-xs font-bold text-amber-200 tracking-wide">Pinned Memory</h2>
            </div>
            <span class="px-2 py-0.5 rounded-full bg-amber-500/10 border border-amber-500/20 text-[10px] font-mono text-amber-300">
              Author's Note
            </span>
          </div>
          <p class="text-[11px] text-slate-400 leading-relaxed">
            Persistent context anchor. Injected into every AI turn to preserve key relationship facts and plot states across long chats.
          </p>
          <textarea 
            id="pinned-note-input"
            rows="3"
            placeholder="Key facts, current scenario status, or shared lore..."
            class="w-full px-2.5 py-2 rounded-xl bg-black/40 border border-white/10 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-amber-400/50 resize-none font-sans leading-relaxed"
          ></textarea>
          <div class="flex items-center justify-between pt-1">
            <span id="pinned-note-status" class="text-[10px] text-slate-400 font-mono">0 chars</span>
            <button 
              id="save-pinned-note-btn"
              type="button"
              class="px-2.5 py-1 rounded-lg bg-amber-500/20 hover:bg-amber-500/30 border border-amber-500/40 text-amber-300 hover:text-white text-[11px] font-medium transition cursor-pointer active:scale-95"
            >
              Save Pin 📌
            </button>
          </div>
        </div>

        <!-- Safety Certification -->
        <div class="p-3.5 rounded-xl bg-purple-950/20 border border-purple-500/20 space-y-1.5">
          <div class="flex items-center gap-1.5 text-xs font-semibold text-purple-300">
            <Sparkles class="w-3.5 h-3.5 text-cyan-400" />
            <span>Tavern V2 Compliant</span>
          </div>
          <p class="text-[11px] text-slate-400 leading-normal">
            Multi-modal roleplay ready. Supports live LLM cognition, streaming speech synthesis, and dynamic scene selfies.
          </p>
        </div>

        <!-- Report Character / Content Compliance -->
        <button
          type="button"
          id="report-character-sidebar-btn"
          class="w-full flex items-center justify-center gap-2 py-2 px-3 rounded-xl bg-white/[0.03] hover:bg-rose-500/10 border border-white/[0.08] hover:border-rose-500/30 text-slate-400 hover:text-rose-300 text-xs font-medium transition cursor-pointer active:scale-95"
          title="Report legal issue or safety violation regarding this character"
        >
          <Flag class="w-3.5 h-3.5 text-rose-400" />
          <span>Report Content / Legal Issue</span>
        </button>

        <!-- Session Privacy -->
        <div class="text-[10px] text-slate-500 text-center pt-4 border-t border-white/[0.05]">
          Client-side encrypted memory. Chats & API keys stay 100% in your browser.
        </div>
      </aside>

      <!-- Center: Immersive Chat Feed & Input -->
      <section class="flex-1 min-w-0 flex flex-col h-full overflow-hidden bg-gradient-to-b from-[#090b17] to-[#060810] relative w-full max-w-full">
        
        <!-- Multi-Modal AI Engine Suite Modal / Drawer -->
        <div 
          id="chat-byok-tray" 
          class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-center justify-center p-3 sm:p-6 transition-all duration-300"
        >
          <div class="w-full max-w-3xl max-h-[92vh] bg-[#0c0f22] border border-purple-500/30 rounded-3xl shadow-2xl shadow-purple-950/80 flex flex-col overflow-hidden animate-in fade-in zoom-in-95 duration-200">
            
            <!-- Modal Header -->
            <div class="p-3.5 sm:p-5 border-b border-white/[0.08] bg-[#090c1b] flex items-center justify-between shrink-0">
              <div class="flex items-center gap-2.5 sm:gap-3 min-w-0">
                <div class="w-8 h-8 sm:w-9 sm:h-9 rounded-2xl bg-gradient-to-br from-purple-600 to-cyan-500 flex items-center justify-center text-white shadow-lg shadow-purple-900/50 shrink-0">
                  <SlidersHorizontal class="w-4 h-4 sm:w-5 sm:h-5" />
                </div>
                <div class="min-w-0">
                  <h3 class="text-xs sm:text-base font-bold text-white flex items-center gap-1.5 truncate">
                    <span class="truncate">Chat & Media Settings</span>
                  </h3>
                  <p class="text-[10px] sm:text-[11px] text-slate-400 truncate">Customize voices, character selfies, animations & AI models</p>
                </div>
              </div>
              <button id="close-chat-byok" class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-white/[0.06] hover:bg-white/[0.12] text-slate-300 hover:text-white flex items-center justify-center transition cursor-pointer text-xs sm:text-sm shrink-0">✕</button>
            </div>

            <!-- Tab Navigation Bar (4 Modalities - 4-Column Grid) -->
            <div class="p-2 sm:px-6 sm:py-3 border-b border-white/[0.08] bg-[#0a0d1e] grid grid-cols-4 gap-1.5 sm:gap-3 shrink-0">
              <!-- Tab 1: Text -->
              <button 
                type="button" 
                class="engine-tab-btn flex flex-col sm:flex-row items-center justify-center gap-1 sm:gap-2 py-2 px-1 sm:px-3 rounded-xl border transition cursor-pointer text-center bg-purple-950/60 border-purple-500/50 text-white shadow-md shadow-purple-950/40" 
                data-tab="tab-text"
              >
                <Brain class="w-4 h-4 sm:w-4 sm:h-4 text-purple-400 shrink-0" />
                <div class="flex flex-col sm:flex-row items-center sm:gap-1 min-w-0">
                  <span class="text-[11px] sm:text-xs font-bold leading-tight truncate">Text</span>
                  <span class="hidden md:inline text-[9px] text-purple-300/80 font-mono">(Story)</span>
                </div>
              </button>

              <!-- Tab 2: Voice -->
              <button 
                type="button" 
                class="engine-tab-btn flex flex-col sm:flex-row items-center justify-center gap-1 sm:gap-2 py-2 px-1 sm:px-3 rounded-xl border transition cursor-pointer text-center bg-white/[0.03] hover:bg-white/[0.07] border-white/[0.06] text-slate-400 hover:text-slate-200" 
                data-tab="tab-voice"
              >
                <Volume2 class="w-4 h-4 sm:w-4 sm:h-4 text-emerald-400 shrink-0" />
                <div class="flex flex-col sm:flex-row items-center sm:gap-1 min-w-0">
                  <span class="text-[11px] sm:text-xs font-bold leading-tight truncate">Voice</span>
                  <span class="hidden md:inline text-[9px] text-emerald-300/80 font-mono">(Speech)</span>
                </div>
              </button>

              <!-- Tab 3: Image -->
              <button 
                type="button" 
                class="engine-tab-btn flex flex-col sm:flex-row items-center justify-center gap-1 sm:gap-2 py-2 px-1 sm:px-3 rounded-xl border transition cursor-pointer text-center bg-white/[0.03] hover:bg-white/[0.07] border-white/[0.06] text-slate-400 hover:text-slate-200" 
                data-tab="tab-image"
              >
                <Camera class="w-4 h-4 sm:w-4 sm:h-4 text-amber-400 shrink-0" />
                <div class="flex flex-col sm:flex-row items-center sm:gap-1 min-w-0">
                  <span class="text-[11px] sm:text-xs font-bold leading-tight truncate">Selfies</span>
                  <span class="hidden md:inline text-[9px] text-amber-300/80 font-mono">(Photos)</span>
                </div>
              </button>

              <!-- Tab 4: Video -->
              <button 
                type="button" 
                class="engine-tab-btn flex flex-col sm:flex-row items-center justify-center gap-1 sm:gap-2 py-2 px-1 sm:px-3 rounded-xl border transition cursor-pointer text-center bg-white/[0.03] hover:bg-white/[0.07] border-white/[0.06] text-slate-400 hover:text-slate-200" 
                data-tab="tab-video"
              >
                <Video class="w-4 h-4 sm:w-4 sm:h-4 text-cyan-400 shrink-0" />
                <div class="flex flex-col sm:flex-row items-center sm:gap-1 min-w-0">
                  <span class="text-[11px] sm:text-xs font-bold leading-tight truncate">Video</span>
                  <span class="hidden md:inline text-[9px] text-cyan-300/80 font-mono">(Motion)</span>
                </div>
              </button>
            </div>

            <!-- Modal Body (Scrollable Settings Panes) -->
            <div class="p-4 sm:p-6 overflow-y-auto flex-1 space-y-6">
              
              <!-- ================= 1. TAB: TEXT ENGINE ================= -->
              <div id="tab-text" class="engine-tab-pane space-y-4">
                <div class="flex items-center justify-between pb-2 border-b border-white/[0.06]">
                  <div>
                    <h4 class="text-xs sm:text-sm font-bold text-white flex items-center gap-2">
                      <Brain class="w-4 h-4 text-purple-400" />
                      <span>Chat Model & AI Personality</span>
                    </h4>
                    <p class="text-[11px] text-slate-400">Configure text model provider, API authentication, and conversation style</p>
                  </div>
                </div>

                <!-- Mode Switcher: Smart Wizard vs Manual Config -->
                <div class="flex items-center justify-between p-1 bg-white/[0.04] rounded-2xl border border-white/[0.08] gap-1">
