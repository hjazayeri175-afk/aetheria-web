  async function runWizardHealthCheck(prov, key, baseUrl) {
    const t0 = performance.now();
    const conf = PROVIDER_CONFIGS[prov] || PROVIDER_CONFIGS.groq;

    try {
      let endpoint = conf.modelsEndpoint;
      if (conf.hasUrl) {
        endpoint = `${baseUrl.replace(/\/+$/, '')}/models`;
      } else if (prov === 'google') {
        endpoint = `https://generativelanguage.googleapis.com/v1beta/models?key=${key}`;
      } else if (prov === 'anthropic') {
        endpoint = 'https://api.anthropic.com/v1/models';
      }

      let resStatus = null;
      let latency = 0;
      let responseData = null;

      try {
        const headers = {};
        if (key && prov !== 'google') {
          if (prov === 'anthropic') {
            headers['x-api-key'] = key;
            headers['anthropic-version'] = '2023-06-01';
            headers['anthropic-dangerous-direct-browser-access'] = 'true';
          } else {
            headers['Authorization'] = `Bearer ${key}`;
          }
        }
        if (prov === 'openrouter') {
          headers['HTTP-Referer'] = 'https://aetheria.ai';
          headers['X-Title'] = 'Aetheria AI';
        }
        const res = await fetch(endpoint, { method: 'GET', headers });
        latency = Math.round(performance.now() - t0);
        resStatus = res.status;
        if (res.ok) {
          responseData = await res.json();
        }
      } catch (err) {
        const proxyRes = await fetch('/api/proxy/fetch-models', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            endpoint,
            apiKey: key,
            headers: prov === 'openrouter' ? { 'HTTP-Referer': 'https://aetheria.ai', 'X-Title': 'Aetheria AI' } : {}
          })
        });
        latency = Math.round(performance.now() - t0);
        resStatus = proxyRes.status;
        if (proxyRes.ok) {
          const pJson = await proxyRes.json();
          responseData = pJson.data || pJson;
        }
      }

      if (resStatus >= 200 && resStatus < 300) {
        const models = extractModelIds(responseData, prov);
        return { ok: true, latency: latency || 110, status: resStatus, models };
      } else {
        return { 
          ok: false, 
          status: resStatus, 
          latency, 
          message: resStatus === 401 || resStatus === 403 
            ? 'The API key is invalid, unauthorized, or expired.' 
            : `Provider responded with HTTP ${resStatus}` 
        };
      }
    } catch (e) {
      return { ok: false, status: 0, message: 'Unable to reach provider API. Please check your network or try again.' };
    }
  }

