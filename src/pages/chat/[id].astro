          ? 'bg-purple-900/40 border-purple-500/50 text-white shadow-sm shadow-purple-950/40' 
          : 'bg-white/[0.03] hover:bg-white/[0.06] border-white/[0.06] text-slate-300'
      }`;

      item.innerHTML = `
        <div class="flex-1 min-w-0 session-select-area" data-session-id="${ses.id}">
          <div class="flex items-center gap-1.5">
            <span class="font-bold text-xs truncate ${isActive ? 'text-purple-300' : 'text-slate-200'}">${ses.title}</span>
            ${isActive ? '<span class="text-[9px] px-1.5 py-0.2 rounded bg-emerald-500/20 text-emerald-400 font-mono">Active</span>' : ''}
          </div>
          <div class="flex items-center gap-2 text-[10px] text-slate-500 mt-0.5">
            <span>${ses.messageCount || 0} messages</span>
            <span>•</span>
            <span class="truncate max-w-[110px]">${ses.lastMessage ? `"${ses.lastMessage}"` : 'New timeline'}</span>
          </div>
        </div>
        <div class="flex items-center gap-1 shrink-0">
          <button type="button" class="rename-session-btn p-1 text-slate-400 hover:text-white transition" data-session-id="${ses.id}" title="Rename branch">
            ✏️
          </button>
          ${ses.id !== 'session_default' ? `
            <button type="button" class="delete-session-btn p-1 text-slate-400 hover:text-red-400 transition" data-session-id="${ses.id}" title="Delete branch">
              🗑️
            </button>
          ` : ''}
        </div>
      `;

      item.querySelector('.session-select-area')?.addEventListener('click', () => {
        if (!isActive) switchSession(ses.id);
      });

      item.querySelector('.rename-session-btn')?.addEventListener('click', (e) => {
        e.stopPropagation();
        const newTitle = prompt('Rename story branch:', ses.title);
        if (newTitle && newTitle.trim()) {
          ses.title = newTitle.trim();
          saveSessionsIndex();
          renderSessionsDropdown();
        }
      });

      item.querySelector('.delete-session-btn')?.addEventListener('click', (e) => {
        e.stopPropagation();
        deleteSession(ses.id);
      });

      listEl.appendChild(item);
    });
  }

  function switchSession(sessionId) {
    saveChat();
    currentSessionId = sessionId;

    const url = new URL(window.location.href);
    url.searchParams.set('sessionId', sessionId);
    window.history.replaceState({}, '', url.toString());

    loadActiveSessionConversation();
    renderSessionsDropdown();
    document.getElementById('sessions-dropdown')?.classList.add('hidden');
    const ses = chatSessions.find(s => s.id === sessionId);
    showNotification(`Switched to branch: ${ses?.title || sessionId}`);
  }

  function createNewSession() {
    const branchNum = chatSessions.length + 1;
    const defaultTitle = `Branch #${branchNum}`;
    const title = prompt('Enter a name for this new story branch:', defaultTitle) || defaultTitle;
    const newId = 'session_' + Date.now();

    const newSes = {
      id: newId,
      title: title.trim(),
      createdAt: new Date().toISOString(),
      updatedAt: new Date().toISOString(),
      messageCount: 1,
      lastMessage: activeChar.greeting
    };

    chatSessions.push(newSes);
    saveSessionsIndex();

    const initialGreeting = formatMacroText(activeChar.greeting);
    const initialConv = [{
      sender: 'character',
      text: initialGreeting,
      timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
      swipes: [initialGreeting],
      swipeIndex: 0
    }];
    localStorage.setItem(getSessionStorageKey(newId), JSON.stringify(initialConv));

    switchSession(newId);
  }

  function deleteSession(sessionId) {
    if (sessionId === 'session_default') {
      alert('Cannot delete the Main Timeline.');
      return;
    }
    if (!confirm('Delete this story branch and all its messages? This cannot be undone.')) return;

    localStorage.removeItem(getSessionStorageKey(sessionId));
    chatSessions = chatSessions.filter(s => s.id !== sessionId);
    saveSessionsIndex();

    if (currentSessionId === sessionId) {
      switchSession('session_default');
    } else {
      renderSessionsDropdown();
    }
    showNotification('Branch deleted.');
  }

  function loadActiveSessionConversation() {
    const key = getSessionStorageKey(currentSessionId);
    const saved = localStorage.getItem(key);
    if (saved) {
      try {
        conversation = JSON.parse(saved);
        conversation.forEach(m => {
          if (m.sender === 'character' && !m.swipes) {
            m.swipes = [m.text];
            m.swipeIndex = 0;
          }
        });
      } catch (e) {
        conversation = [];
      }
    } else {
      conversation = [];
    }

    if (conversation.length === 0) {
      const initialGreeting = formatMacroText(activeChar.greeting);
      conversation.push({
        sender: 'character',
        text: initialGreeting,
        timestamp: new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }),
        swipes: [initialGreeting],
        swipeIndex: 0
      });
      saveChat();
    }

    renderAllMessages();
  }

  // Init Chat Function
  function initChat() {
    loadSessions();
    loadActiveSessionConversation();
    loadEngineSettings();
    initPinnedNote();
  }

  function saveChat() {
    const key = getSessionStorageKey(currentSessionId);
    localStorage.setItem(key, JSON.stringify(conversation));

    // Update session metadata
    const activeSes = chatSessions.find(s => s.id === currentSessionId);
    if (activeSes) {
      activeSes.messageCount = conversation.length;
      activeSes.updatedAt = new Date().toISOString();
      const lastMsg = conversation[conversation.length - 1];
      activeSes.lastMessage = lastMsg ? (lastMsg.text || '').slice(0, 100) : '';
      saveSessionsIndex();
    }
  }

  function renderAllMessages() {
    if (!chatStream) return;
    chatStream.innerHTML = '';
    conversation.forEach((msg, idx) => {
      appendMessageToDOM(msg, idx);
    });
    chatStream.scrollTop = chatStream.scrollHeight;
  }

