      if (voiceIdInput) localStorage.setItem('aetheria_voice_id', voiceIdInput.value.trim());
      if (openaiVoiceSelect) localStorage.setItem('aetheria_openai_voice', openaiVoiceSelect.value);
      if (openaiTtsModelSelect) localStorage.setItem('aetheria_openai_tts_model', openaiTtsModelSelect.value);
      if (sliderStability) localStorage.setItem('aetheria_voice_stability', sliderStability.value);
      if (sliderClarity) localStorage.setItem('aetheria_voice_clarity', sliderClarity.value);
      if (sliderVoiceRate) localStorage.setItem('aetheria_voice_rate', sliderVoiceRate.value);
      if (sliderVoicePitch) localStorage.setItem('aetheria_voice_pitch', sliderVoicePitch.value);
      if (toggleFilterNarration) localStorage.setItem('aetheria_voice_filter_narration', toggleFilterNarration.checked ? 'true' : 'false');
      if (toggleAutoplayVoice) {
        localStorage.setItem('aetheria_voice_autoplay', toggleAutoplayVoice.checked ? 'true' : 'false');
