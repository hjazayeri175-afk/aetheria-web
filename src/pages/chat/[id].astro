        if (btnDeleteActiveSttProfile) btnDeleteActiveSttProfile.classList.remove('hidden');
        if (sttActiveProfileBadge) {
          sttActiveProfileBadge.textContent = activeProf.name;
          sttActiveProfileBadge.classList.remove('hidden');
        }
      } else {
        localStorage.removeItem(ACTIVE_STT_PROFILE_KEY);
        renderSttProfileMenu();
      }
    } else {
      if (customSttProfileTriggerLabel) customSttProfileTriggerLabel.textContent = 'Cloudflare Workers AI (Default)';
      if (customSttProfileTriggerTag) customSttProfileTriggerTag.classList.add('hidden');
      if (customSttProfileStatusDot) customSttProfileStatusDot.className = 'w-2 h-2 rounded-full bg-slate-400 shrink-0';
      if (btnUpdateActiveSttProfile) btnUpdateActiveSttProfile.classList.add('hidden');
      if (btnDeleteActiveSttProfile) btnDeleteActiveSttProfile.classList.add('hidden');
