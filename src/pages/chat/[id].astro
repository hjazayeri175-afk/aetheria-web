  function showNotification(msg) {
    const toast = document.createElement('div');
    toast.className = 'fixed bottom-20 left-1/2 -translate-x-1/2 z-50 px-4 py-2.5 rounded-2xl bg-[#12162b] border border-purple-500/50 text-white text-xs font-semibold shadow-2xl shadow-purple-950 flex items-center gap-2 animate-in fade-in slide-in-from-bottom-3 duration-200';
    toast.innerHTML = `<span class="w-2 h-2 rounded-full bg-emerald-400"></span><span>${msg}</span>`;
    document.body.appendChild(toast);
    setTimeout(() => {
      toast.classList.add('opacity-0', 'transition', 'duration-300');
      setTimeout(() => toast.remove(), 300);
    }, 2500);
  }

  // Sliders real-time listeners
  [
    sliderTemp, sliderTokens, sliderTopP, sliderRepPen, sliderFreqPen, sliderPresPen, sliderContext,
    sliderStability, sliderClarity, sliderVoiceRate, sliderVoicePitch, sliderMotion
  ].forEach(slider => {
    slider?.addEventListener('input', updateAllBadges);
  });

  // Providers change listeners
  textProviderSelect?.addEventListener('change', () => {
    syncProviderVisibility();
    if (textProviderSelect.value === 'groq' && textModelInput) {
      textModelInput.value = 'llama-3.3-70b-versatile';
    } else if (textProviderSelect.value === 'openrouter' && textModelInput) {
      textModelInput.value = 'anthropic/claude-3.5-sonnet';
    } else if (textProviderSelect.value === 'deepseek' && textModelInput) {
      textModelInput.value = 'deepseek-chat';
    } else if (textProviderSelect.value === 'openai' && textModelInput) {
      textModelInput.value = 'gpt-4o';
    }
