                id="lightbox-download-btn" 
                href={character.avatarUrl} 
                download={`${character.name}-artwork.png`}
                target="_blank"
                class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/[0.08] hover:bg-white/[0.15] border border-white/10 text-slate-200 hover:text-white text-xs font-medium transition cursor-pointer active:scale-95"
                title="Save High-Res Artwork"
              >
                <Download class="w-3.5 h-3.5 text-cyan-400" />
                <span class="hidden sm:inline">Save Art</span>
              </a>
              <button 
                id="lightbox-close-btn" 
                type="button" 
                class="w-8 h-8 rounded-full bg-white/[0.08] hover:bg-white/[0.2] text-slate-300 hover:text-white flex items-center justify-center transition cursor-pointer active:scale-95 text-sm"
                title="Close Lightbox"
              >
                <X class="w-4 h-4" />
              </button>
            </div>
          </div>

          <!-- Main Image Centerpiece -->
          <div id="lightbox-backdrop-click" class="relative flex-1 w-full max-w-4xl flex items-center justify-center p-2 min-h-0 cursor-zoom-out">
            <!-- Subtle Ambient Color Glow -->
            <div class="absolute w-72 h-72 sm:w-[450px] sm:h-[450px] rounded-full bg-purple-600/25 blur-[90px] pointer-events-none"></div>

            <img 
              id="lightbox-image" 
              src={character.avatarUrl} 
              alt={character.name} 
              class="relative max-h-[72vh] sm:max-h-[82vh] max-w-full object-contain rounded-2xl sm:rounded-3xl shadow-[0_20px_60px_rgba(0,0,0,0.9)] border border-white/10 select-none transition-transform duration-300 transform scale-95"
            />
          </div>

          <!-- Bottom Floating Hint Bar -->
          <div class="w-full max-w-md text-center shrink-0 z-10 pt-1">
            <p class="text-[11px] text-slate-400 bg-black/60 px-4 py-1.5 rounded-full border border-white/[0.08] inline-flex items-center gap-1.5 backdrop-blur-md">
              <span>Tap anywhere outside or press</span>
              <kbd class="px-1.5 py-0.5 rounded bg-white/10 font-mono text-slate-300 text-[10px]">Esc</kbd>
              <span>to close</span>
            </p>
          </div>
        </div>

        <!-- Ultra-Minimal Fullscreen Composer (Pure AMOLED Black, ChatGPT Zen Style) -->
        <div 
          id="fullscreen-composer-modal" 
          class="hidden fixed inset-0 z-50 bg-[#000000] text-[#f1f3f4] flex flex-col justify-between transition-opacity duration-200 opacity-0 pointer-events-none select-text"
          style="height: 100dvh; max-height: 100dvh;"
        >
          <!-- Top Row: Minimal Collapse Trigger (Inward diagonal arrows, LTR placed top-right) -->
          <div class="w-full pt-[max(env(safe-area-inset-top),16px)] px-4 sm:px-6 flex items-center justify-end shrink-0 z-10">
            <button 
              type="button" 
              id="fullscreen-composer-close-btn"
              class="w-10 h-10 rounded-full flex items-center justify-center text-white/70 hover:text-white hover:bg-white/10 active:scale-90 transition cursor-pointer"
              title="Collapse"
            >
              <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M4 14h6v6"></path>
                <path d="M20 10h-6V4"></path>
                <path d="M14 10l7-7"></path>
                <path d="M3 21l7-7"></path>
              </svg>
            </button>
          </div>

          <!-- Main Writing Area: Seamless Full-Screen Textarea -->
          <div class="flex-1 w-full max-w-4xl mx-auto px-4 sm:px-8 py-2 flex flex-col min-h-0">
            <textarea 
              id="fullscreen-composer-textarea"
              dir="auto"
              placeholder="Message..."
              class="w-full flex-1 bg-transparent text-[#f1f3f4] text-[17px] sm:text-[19px] leading-[1.7] placeholder:text-white/30 outline-none resize-none overflow-y-auto selection:bg-purple-500/30 caret-purple-400 font-normal focus:ring-0 text-left border-none"
              style="scrollbar-width: thin;"
            ></textarea>
          </div>

          <!-- Bottom Row: Floating Circular Send Button (LTR: placed on the right, above keyboard) -->
          <div class="w-full pb-[max(env(safe-area-inset-bottom),16px)] px-4 sm:px-6 flex items-center justify-end shrink-0 z-10">
            <button 
              type="button" 
              id="fullscreen-composer-send-btn"
              class="w-11 h-11 sm:w-12 sm:h-12 rounded-full flex items-center justify-center transition-all duration-200 shadow-sm cursor-not-allowed bg-purple-600 text-white opacity-40 scale-95"
              title="Send message"
            >
              <svg class="w-5 h-5 sm:w-6 sm:h-6 stroke-[2.5]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 19V5M5 12l7-7 7 7"/>
              </svg>
            </button>
          </div>
        </div>

        <!-- Chat Messages Scroll Stream -->
        <div 
          id="chat-stream" 
          class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-4 sm:space-y-5 relative z-10"
        >
          <!-- Messages will be populated dynamically from localStorage or greeting -->
        </div>

        <!-- Character Typing Indicator -->
        <div 
          id="full-typing-indicator" 
          class="hidden px-4 sm:px-6 py-2 flex items-center gap-3 animate-pulse"
        >
          <img 
            id="chat-typing-avatar"
            src={character.avatarUrl} 
            alt={character.name} 
            class="w-7 h-7 rounded-full object-cover ring-1 ring-purple-500/40" 
          />
          <div class="px-3.5 py-2 rounded-2xl rounded-tl-sm bg-white/[0.04] border border-white/[0.08] flex items-center gap-1.5 text-xs text-slate-400">
            <span class="w-1.5 h-1.5 rounded-full bg-purple-400 animate-bounce"></span>
            <span class="w-1.5 h-1.5 rounded-full bg-purple-400 animate-bounce [animation-delay:0.2s]"></span>
            <span class="w-1.5 h-1.5 rounded-full bg-purple-400 animate-bounce [animation-delay:0.4s]"></span>
            <span id="chat-typing-name" class="text-[11px] ml-1 text-slate-400">{character.name} is thinking...</span>
          </div>
        </div>

        <!-- Dynamic Smart Prompts / Contextual AI Suggestions Row -->
        <div id="smart-prompts-bar" class="px-2.5 sm:px-6 py-1.5 flex items-center gap-2 overflow-x-auto no-scrollbar shrink-0 w-full max-w-full bg-[#080a17]/80 border-t border-white/[0.04]">
          <div class="flex items-center gap-1.5 shrink-0 text-slate-400">
            <Sparkles class="w-3.5 h-3.5 text-purple-400 animate-pulse" />
            <span class="text-[10px] uppercase font-bold tracking-wider text-slate-300">Smart Ideas</span>
            <button 
              id="refresh-smart-prompts-btn" 
              type="button" 
              class="p-1 rounded-md hover:bg-white/[0.08] text-slate-400 hover:text-purple-300 transition cursor-pointer active:scale-90"
              title="Generate new contextual suggestions based on story"
            >
              <RefreshCw class="w-2.5 h-2.5" id="smart-prompts-refresh-icon" />
            </button>
          </div>

          <!-- Loading indicator -->
          <div id="smart-prompts-loading" class="hidden items-center gap-1.5 text-[11px] text-purple-300/80 font-mono animate-pulse shrink-0">
            <span class="w-1.5 h-1.5 rounded-full bg-purple-400 animate-ping"></span>
            <span>Thinking options...</span>
          </div>

          <!-- Dynamic Prompts Container -->
          <div id="smart-prompts-container" class="flex items-center gap-2 overflow-x-auto no-scrollbar scroll-smooth py-0.5">
            {character.starterPrompts && character.starterPrompts.map((prompt) => {
              const cleanPrompt = String(prompt).trim().replace(/^["'«“]+|["'»”]+$/g, '').trim();
              const displayLabel = cleanPrompt.startsWith('*') ? cleanPrompt : `"${cleanPrompt}"`;
              return (
                <button 
                  type="button"
                  class="room-starter-pill group flex items-center gap-1.5 shrink-0 px-3 py-1.5 rounded-xl bg-white/[0.04] hover:bg-purple-950/40 border border-white/[0.08] hover:border-purple-500/30 text-xs text-slate-300 hover:text-white transition duration-200 cursor-pointer active:scale-95 whitespace-nowrap shadow-sm"
                  data-prompt={cleanPrompt}
                  title="Click to fill reply"
                >
                  <span class="w-1.5 h-1.5 rounded-full bg-purple-400/60 group-hover:bg-purple-400 group-hover:scale-125 transition"></span>
                  <span>{displayLabel}</span>
                </button>
              );
            })}
          </div>
        </div>

        <!-- Bottom Chat Input Bar -->
        <div class="px-2 py-1.5 sm:px-6 sm:py-2.5 border-t border-white/[0.08] bg-[#080a15]/95 backdrop-blur-xl shrink-0 w-full max-w-full">
          <!-- In-Chat Multi-Modal & Action Toolbar (Hidden: consolidated cleanly into the '+' menu) -->
          <div class="hidden max-w-4xl mx-auto mb-2 items-center justify-between gap-1.5 overflow-x-auto no-scrollbar">
            <!-- Left: Generative Creative Tools -->
            <div class="flex items-center gap-1.5 shrink-0">
              <!-- 1. Request Selfie Photo -->
              <button 
                type="button" 
                id="chat-action-selfie-btn"
                class="px-2.5 py-1 rounded-full bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] hover:border-purple-500/40 text-slate-300 hover:text-white text-[11px] font-medium flex items-center gap-1.5 transition active:scale-95 cursor-pointer shadow-sm shrink-0"
                title="Request a contextual selfie photo from character"
              >
                <Camera class="w-3.5 h-3.5 text-purple-400" />
                <span>Selfie</span>
              </button>

              <!-- 2. Request Living Video Clip -->
              <button 
                type="button" 
                id="chat-action-video-btn"
                class="px-2.5 py-1 rounded-full bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] hover:border-pink-500/40 text-slate-300 hover:text-white text-[11px] font-medium flex items-center gap-1.5 transition active:scale-95 cursor-pointer shadow-sm group shrink-0"
                title="Generate a dynamic cinematic video animation"
              >
                <Film class="w-3.5 h-3.5 text-pink-400 group-hover:scale-110 transition-transform" />
                <span>Video</span>
              </button>
            </div>

            <!-- Right: Roleplay & Controls -->
            <div class="flex items-center gap-1.5 shrink-0">
              <!-- 3. Regenerate / Modify Last Reply -->
              <button 
                type="button" 
                id="chat-action-regenerate-btn"
                class="px-2.5 py-1 rounded-full bg-white/[0.03] hover:bg-white/[0.08] border border-white/[0.07] hover:border-cyan-500/40 text-slate-400 hover:text-cyan-300 text-[11px] font-medium flex items-center gap-1.5 transition active:scale-95 cursor-pointer shrink-0"
                title="Regenerate or modify last response"
              >
                <RefreshCw class="w-3 h-3 text-cyan-400" />
                <span class="hidden sm:inline">Retry</span>
              </button>

              <!-- 4. Rewind Last Turn -->
              <button 
                type="button" 
                id="chat-action-rewind-btn"
                class="px-2.5 py-1 rounded-full bg-white/[0.03] hover:bg-white/[0.08] border border-white/[0.07] hover:border-amber-500/40 text-slate-400 hover:text-amber-300 text-[11px] font-medium flex items-center gap-1.5 transition active:scale-95 cursor-pointer shrink-0"
                title="Rewind last turn"
              >
                <Rewind class="w-3 h-3 text-amber-400" />
                <span class="hidden sm:inline">Rewind</span>
              </button>

              <!-- 5. Active Persona Switcher -->
              <button 
                type="button" 
                id="chat-action-mask-btn"
                class="px-2.5 py-1 rounded-full bg-purple-500/10 hover:bg-purple-500/20 border border-purple-500/30 text-purple-300 hover:text-white text-[11px] font-medium flex items-center gap-1.5 transition active:scale-95 cursor-pointer shrink-0"
                title="Click to switch persona"
              >
                <User class="w-3 h-3 text-purple-400 shrink-0" />
                <span id="chat-active-mask-label" class="inline max-w-[100px] sm:max-w-[140px] truncate">You</span>
              </button>
            </div>
          </div>

          <!-- Hidden File Inputs for Multimodal & Document Attachments -->
          <input type="file" id="chat-file-photo-input" accept="image/*" class="hidden" />
          <input type="file" id="chat-file-camera-input" accept="image/*" capture="environment" class="hidden" />
          <input type="file" id="chat-file-doc-input" accept=".txt,.json,.md,.pdf,.csv" class="hidden" />

          <!-- Bottom Input Form (Google Gemini Capsule) -->
          <form id="room-input-form" class="w-full max-w-4xl mx-auto relative">
            <!-- Gemini-Style Floating Tools Popover (Triggered by + button) -->
            <div 
              id="chat-plus-menu" 
              class="hidden absolute bottom-full left-0 mb-3 w-[calc(100vw-2rem)] max-w-[340px] sm:max-w-sm bg-[#181920]/95 border border-white/[0.12] rounded-3xl p-3 shadow-2xl shadow-black/95 backdrop-blur-2xl z-50 flex flex-col gap-2 select-none"
            >
              <!-- Drag Handle Bar -->
              <div class="w-10 h-1 bg-white/20 rounded-full mx-auto my-0.5"></div>

              <!-- Top Row: Quick Input Actions (Photos, Camera, Files) -->
              <div class="grid grid-cols-3 gap-2 px-1 pt-1">
                <!-- 1. Photos / Gallery -->
                <button 
                  type="button" 
                  id="plus-action-photos"
                  class="flex flex-col items-center gap-1.5 p-2 rounded-2xl bg-white/[0.04] hover:bg-white/[0.09] active:scale-95 border border-white/[0.08] transition cursor-pointer group"
                  title="Attach Photo from Gallery (Vision AI & Reference)"
                >
                  <div class="w-11 h-11 rounded-full bg-purple-500/15 border border-purple-500/25 text-purple-300 flex items-center justify-center group-hover:scale-105 transition">
                    <svg class="w-5 h-5 text-purple-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
                      <circle cx="9" cy="9" r="2"/>
                      <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
                    </svg>
                  </div>
                  <span class="text-[11px] font-medium text-slate-200">Photos</span>
                </button>

                <!-- 2. Camera Snapshot -->
                <button 
                  type="button" 
                  id="plus-action-camera"
                  class="flex flex-col items-center gap-1.5 p-2 rounded-2xl bg-white/[0.04] hover:bg-white/[0.09] active:scale-95 border border-white/[0.08] transition cursor-pointer group"
                  title="Take Camera Photo"
                >
                  <div class="w-11 h-11 rounded-full bg-sky-500/15 border border-sky-500/25 text-sky-300 flex items-center justify-center group-hover:scale-105 transition">
                    <svg class="w-5 h-5 text-sky-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M14.5 4h-5L7 7H4a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-3l-2.5-3z"/>
                      <circle cx="12" cy="13" r="3"/>
                    </svg>
                  </div>
                  <span class="text-[11px] font-medium text-slate-200">Camera</span>
                </button>

                <!-- 3. Attach Files / Docs -->
                <button 
                  type="button" 
                  id="plus-action-files"
                  class="flex flex-col items-center gap-1.5 p-2 rounded-2xl bg-white/[0.04] hover:bg-white/[0.09] active:scale-95 border border-white/[0.08] transition cursor-pointer group"
                  title="Upload Text or Document File"
                >
                  <div class="w-11 h-11 rounded-full bg-amber-500/15 border border-amber-500/25 text-amber-300 flex items-center justify-center group-hover:scale-105 transition">
                    <svg class="w-5 h-5 text-amber-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m21.44 11.05-9.19 9.19a6 6 0 0 1-8.49-8.49l8.57-8.57A4 4 0 1 1 18 8.84l-8.59 8.57a2 2 0 0 1-2.83-2.83l8.49-8.48"/>
                    </svg>
                  </div>
                  <span class="text-[11px] font-medium text-slate-200">Files</span>
                </button>
              </div>

              <!-- Subtle Divider -->
              <div class="border-t border-white/[0.08] my-1 mx-1"></div>

              <!-- Bottom Section: Generative Multimodal AI Modes (Gemini list style) -->
              <div class="flex flex-col gap-1 px-1">
                <div class="px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-slate-400">Creation & Multimodal</div>

                <!-- 1. Images Mode -->
                <button 
                  type="button" 
                  id="plus-mode-images"
                  class="w-full px-2.5 py-2.5 rounded-2xl hover:bg-white/[0.06] text-left flex items-center gap-3 text-xs text-slate-200 hover:text-white transition cursor-pointer group active:scale-[0.99]"
                >
                  <div class="w-9 h-9 rounded-xl bg-purple-500/15 border border-purple-500/30 text-purple-300 flex items-center justify-center shrink-0 group-hover:scale-105 transition">
                    <svg class="w-4.5 h-4.5 text-purple-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <rect width="18" height="18" x="3" y="3" rx="2" ry="2"/>
                      <circle cx="9" cy="9" r="2"/>
                      <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/>
                    </svg>
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="font-medium text-white flex items-center gap-1.5">
                      <span>Images</span>
                      <span class="text-[9px] px-1.5 py-0.2 rounded-md bg-purple-500/20 text-purple-300 font-mono">Create</span>
                    </div>
                    <div class="text-[10px] text-slate-400 truncate">Create character selfies & scenes</div>
                  </div>
                </button>

                <!-- 2. Videos Mode -->
                <button 
                  type="button" 
                  id="plus-mode-videos"
                  class="w-full px-2.5 py-2.5 rounded-2xl hover:bg-white/[0.06] text-left flex items-center gap-3 text-xs text-slate-200 hover:text-white transition cursor-pointer group active:scale-[0.99]"
                >
                  <div class="w-9 h-9 rounded-xl bg-sky-500/15 border border-sky-500/30 text-sky-300 flex items-center justify-center shrink-0 group-hover:scale-105 transition">
                    <svg class="w-4.5 h-4.5 text-sky-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="m22 8-6 4 6 4V8Z"/>
                      <rect width="14" height="12" x="2" y="6" rx="2" ry="2"/>
                    </svg>
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="font-medium text-white flex items-center gap-1.5">
                      <span>Videos</span>
                      <span class="text-[9px] px-1.5 py-0.2 rounded-md bg-sky-500/20 text-sky-300 font-mono">Motion</span>
                    </div>
                    <div class="text-[10px] text-slate-400 truncate">Bring character or scene to life</div>
                  </div>
                </button>

                <!-- 3. Voice & Audio Mode -->
                <button 
                  type="button" 
                  id="plus-mode-voice"
                  class="w-full px-2.5 py-2.5 rounded-2xl hover:bg-white/[0.06] text-left flex items-center gap-3 text-xs text-slate-200 hover:text-white transition cursor-pointer group active:scale-[0.99]"
                >
                  <div class="w-9 h-9 rounded-xl bg-emerald-500/15 border border-emerald-500/30 text-emerald-300 flex items-center justify-center shrink-0 group-hover:scale-105 transition">
                    <svg class="w-4.5 h-4.5 text-emerald-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/>
                      <path d="M19 10v2a7 7 0 0 1-14 0v-2"/>
                      <line x1="12" x2="12" y1="19" y2="22"/>
                    </svg>
                  </div>
                  <div class="flex-1 min-w-0">
                    <div class="font-medium text-white flex items-center gap-1.5">
                      <span>Voice & Audio</span>
                      <span class="text-[9px] px-1.5 py-0.2 rounded-md bg-emerald-500/20 text-emerald-300 font-mono">Spoken</span>
                    </div>
                    <div class="text-[10px] text-slate-400 truncate">Generate voice memo or narration</div>
                  </div>
                </button>

                <!-- Divider -->
                <div class="border-t border-white/[0.08] my-1 mx-1"></div>

                <!-- Personal Intelligence / User Persona Row (Google Gemini Style) -->
                <div 
                  id="plus-persona-row"
                  class="w-full px-2.5 py-2 rounded-2xl bg-white/[0.03] hover:bg-white/[0.06] border border-white/[0.08] transition flex items-center justify-between gap-2.5 text-left group"
                >
                  <!-- Left: Clickable Identity Area to Switch/Edit Persona -->
                  <button 
                    type="button" 
                    id="plus-persona-select-btn" 
                    class="flex items-center gap-3 min-w-0 flex-1 text-left cursor-pointer group-hover:opacity-95"
                    title="Click to switch or edit persona"
                  >
                    <!-- Icon: Person Outline with AI Sparkle (Personal Intelligence) -->
                    <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-indigo-500/20 to-purple-500/20 border border-indigo-500/30 text-indigo-300 flex items-center justify-center shrink-0 relative">
                      <svg class="w-4.5 h-4.5 text-indigo-200" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/>
                        <circle cx="12" cy="7" r="4"/>
                      </svg>
                      <!-- Sparkle in bottom-right corner -->
                      <span class="absolute -bottom-0.5 -right-0.5 text-amber-300 text-[10px] leading-none drop-shadow">✦</span>
                    </div>

                    <div class="flex-1 min-w-0">
                      <div class="flex items-center gap-1.5">
                        <span class="text-xs font-semibold text-white tracking-tight">Personal Intelligence</span>
                        <span class="text-[9px] px-1.5 py-0.2 rounded-md bg-white/10 text-slate-300 font-mono">Labs</span>
                      </div>
                      <div id="plus-persona-subtitle" class="text-[10px] text-slate-400 truncate">Personalize chat if helpful</div>
                    </div>
                  </button>

                  <!-- Right: Material 3 Style Toggle Switch -->
                  <button 
                    type="button" 
                    id="plus-persona-toggle-btn"
                    class="relative inline-flex h-6 w-11 shrink-0 cursor-pointer rounded-full border-2 border-transparent transition-colors duration-200 ease-in-out focus:outline-none"
                    role="switch" 
                    aria-checked="true"
                    title="Toggle persona personalization on/off"
                  >
                    <span id="plus-persona-toggle-track" class="pointer-events-none absolute inset-0 rounded-full bg-purple-600 transition-colors duration-200"></span>
                    <span id="plus-persona-toggle-thumb" class="pointer-events-none relative inline-block h-5 w-5 transform rounded-full bg-white shadow-md ring-0 transition duration-200 ease-in-out translate-x-5"></span>
                  </button>
                </div>
              </div>
            </div>

            <!-- Unified Gemini Pill Input Bar (Compact Single Row when empty, Full-Width Multi-Line when typing) -->
            <div 
              id="room-input-container" 
              class="relative flex flex-col p-1.5 sm:p-2 rounded-[24px] sm:rounded-[28px] bg-[#1e1f20] hover:bg-[#222326] focus-within:bg-[#1e1f20] border border-white/[0.08] focus-within:border-white/20 transition-all duration-150 shadow-xl shadow-black/50"
            >
