  function openCustomProfileMenu() {
    if (!customProfileMenu) return;
    customProfileMenu.classList.remove('hidden');
    customProfileTrigger?.setAttribute('aria-expanded', 'true');
    if (customProfileChevron) customProfileChevron.classList.add('rotate-180');
  }

  function closeCustomProfileMenu() {
    if (!customProfileMenu) return;
    customProfileMenu.classList.add('hidden');
    customProfileTrigger?.setAttribute('aria-expanded', 'false');
    if (customProfileChevron) customProfileChevron.classList.remove('rotate-180');
  }

  function toggleCustomProfileMenu() {
    if (!customProfileMenu) return;
    if (customProfileMenu.classList.contains('hidden')) {
      openCustomProfileMenu();
    } else {
      closeCustomProfileMenu();
    }
  }

  customProfileTrigger?.addEventListener('click', (e) => {
    e.stopPropagation();
    toggleCustomProfileMenu();
  });

  document.addEventListener('click', (e) => {
    if (customProfileMenu && !customProfileMenu.classList.contains('hidden')) {
      if (!customProfileMenu.contains(e.target) && !customProfileTrigger?.contains(e.target)) {
        closeCustomProfileMenu();
      }
    }
  });

  function updateProfileButtonsUI(activeId, profiles = null) {
    const profs = profiles || getSavedApiProfiles();
    const activeProf = profs.find(p => p.id === activeId);

    if (activeProf) {
      if (btnUpdateActiveProfile) btnUpdateActiveProfile.classList.remove('hidden');
      if (btnDeleteActiveProfile) btnDeleteActiveProfile.classList.remove('hidden');
      if (activeProfileBadge) {
        activeProfileBadge.classList.remove('hidden');
        activeProfileBadge.textContent = activeProf.name;
      }
    } else {
      if (btnUpdateActiveProfile) btnUpdateActiveProfile.classList.add('hidden');
      if (btnDeleteActiveProfile) btnDeleteActiveProfile.classList.add('hidden');
      if (activeProfileBadge) activeProfileBadge.classList.add('hidden');
    }
  }

  function switchApiProfile(profileId) {
    if (!profileId) {
      localStorage.removeItem(ACTIVE_PROFILE_KEY);
      renderApiProfilesDropdown(null);
      updateHeaderPill();
      showNotification('Direct Provider Mode active');
      return;
    }

    const profiles = getSavedApiProfiles();
    const prof = profiles.find(p => p.id === profileId);
    if (!prof) {
      localStorage.removeItem(ACTIVE_PROFILE_KEY);
      renderApiProfilesDropdown(null);
      return;
    }

    localStorage.setItem(ACTIVE_PROFILE_KEY, prof.id);

    // 1. Set Provider
    const targetProv = prof.provider || 'groq';
    if (textProviderSelect) {
      textProviderSelect.value = targetProv;
    }
    localStorage.setItem('aetheria_text_provider', targetProv);
    currentActiveProvider = targetProv;
    updateQuickProvChips(targetProv);

    // 2. Set API Key and Base URL
    const targetKey = prof.apiKey || '';
    if (textApiKey) textApiKey.value = targetKey;
    localStorage.setItem('aetheria_text_key', targetKey);
    localStorage.setItem('aetheria_key_' + targetProv, targetKey);

    const targetUrl = prof.baseUrl || '';
    if (textBaseUrl) textBaseUrl.value = targetUrl;
    localStorage.setItem('aetheria_text_base_url', targetUrl);
    localStorage.setItem('aetheria_url_' + targetProv, targetUrl);

    // 3. Set Models strictly for this profile/provider
    let modelsList = [];
    if (Array.isArray(prof.syncedModels) && prof.syncedModels.length > 0) {
      modelsList = prof.syncedModels;
    } else {
      const cachedRaw = localStorage.getItem('aetheria_synced_models_' + targetProv);
      if (cachedRaw) {
        try { modelsList = JSON.parse(cachedRaw); } catch (e) {}
      }
      if (!Array.isArray(modelsList) || modelsList.length === 0) {
        modelsList = DEFAULT_PROVIDER_MODELS[targetProv] || ['default'];
      }
    }

    const selectedModel = (prof.model && modelsList.includes(prof.model)) ? prof.model : modelsList[0];
    populateModelDropdown(modelsList, selectedModel, false);
    updateDynamicPresets(modelsList);
    localStorage.setItem('aetheria_text_model', selectedModel);
    localStorage.setItem('aetheria_model_' + targetProv, selectedModel);

    // 4. Update UI
    syncProviderVisibility();
    renderApiProfilesDropdown(prof.id);
    updateHeaderPill();

    const provName = PROVIDER_CONFIGS[targetProv]?.name || targetProv;
    showNotification(`✓ Switched to profile: ${prof.name} (${provName})`);
  }

  function saveCurrentAsNewProfile(name) {
    const profileName = (name || '').trim();
    if (!profileName) {
      showNotification('⚠️ Please enter a name for this profile.');
      return;
    }

    const prov = textProviderSelect?.value || 'groq';
    const apiKey = (textApiKey?.value || '').trim();
    const baseUrl = (textBaseUrl?.value || '').trim();
    const isCustomInput = Boolean(textModelInput && !textModelInput.classList.contains('hidden'));
    let model = isCustomInput ? textModelInput.value.trim() : (textModelSelect ? textModelSelect.value : '');
    if (!model || model.includes('No API connected')) {
      model = localStorage.getItem('aetheria_text_model') || (DEFAULT_PROVIDER_MODELS[prov] ? DEFAULT_PROVIDER_MODELS[prov][0] : 'default');
    }

    let syncedModels = currentSyncedModels;
    if (!Array.isArray(syncedModels) || syncedModels.length === 0) {
      try {
        syncedModels = JSON.parse(localStorage.getItem('aetheria_synced_models_' + prov) || '[]');
      } catch(e) {}
    }
    if (!Array.isArray(syncedModels) || syncedModels.length === 0) {
      syncedModels = DEFAULT_PROVIDER_MODELS[prov] || [model];
    }

    const newProfile = {
      id: 'prof_' + Date.now() + '_' + Math.random().toString(36).substring(2, 7),
      name: profileName,
      provider: prov,
      apiKey: apiKey,
      baseUrl: baseUrl,
      model: model,
      syncedModels: syncedModels,
      updatedAt: Date.now()
    };

    const profiles = getSavedApiProfiles();
    profiles.push(newProfile);
    saveApiProfilesToStorage(profiles);
    localStorage.setItem(ACTIVE_PROFILE_KEY, newProfile.id);

    // Cache per-provider
    localStorage.setItem('aetheria_key_' + prov, apiKey);
    localStorage.setItem('aetheria_url_' + prov, baseUrl);
    localStorage.setItem('aetheria_model_' + prov, model);
    localStorage.setItem('aetheria_text_provider', prov);
    localStorage.setItem('aetheria_text_key', apiKey);
    localStorage.setItem('aetheria_text_base_url', baseUrl);
    localStorage.setItem('aetheria_text_model', model);

    renderApiProfilesDropdown(newProfile.id);
    updateHeaderPill();

    if (newProfileForm) newProfileForm.classList.add('hidden');
    if (newProfileNameInput) newProfileNameInput.value = '';

    showNotification(`✓ Profile "${profileName}" saved successfully!`);
  }

  function updateActiveProfile() {
    const activeId = localStorage.getItem(ACTIVE_PROFILE_KEY);
    if (!activeId) {
      showNotification('⚠️ No active profile selected. Use "Save as New Profile" instead.');
      return;
    }

    const profiles = getSavedApiProfiles();
    const idx = profiles.findIndex(p => p.id === activeId);
    if (idx === -1) return;

    const prov = textProviderSelect?.value || 'groq';
    const apiKey = (textApiKey?.value || '').trim();
    const baseUrl = (textBaseUrl?.value || '').trim();
    const isCustomInput = Boolean(textModelInput && !textModelInput.classList.contains('hidden'));
    let model = isCustomInput ? textModelInput.value.trim() : (textModelSelect ? textModelSelect.value : '');
    if (!model || model.includes('No API connected')) {
      model = localStorage.getItem('aetheria_text_model') || (DEFAULT_PROVIDER_MODELS[prov] ? DEFAULT_PROVIDER_MODELS[prov][0] : 'default');
    }

    profiles[idx].provider = prov;
    profiles[idx].apiKey = apiKey;
    profiles[idx].baseUrl = baseUrl;
    profiles[idx].model = model;
    if (Array.isArray(currentSyncedModels) && currentSyncedModels.length > 0) {
      profiles[idx].syncedModels = currentSyncedModels;
    }
    profiles[idx].updatedAt = Date.now();

    saveApiProfilesToStorage(profiles);

    localStorage.setItem('aetheria_key_' + prov, apiKey);
    localStorage.setItem('aetheria_url_' + prov, baseUrl);
    localStorage.setItem('aetheria_model_' + prov, model);

    renderApiProfilesDropdown(activeId);
    updateHeaderPill();
    showNotification(`✓ Profile "${profiles[idx].name}" updated.`);
  }

  function deleteActiveProfile() {
    const activeId = localStorage.getItem(ACTIVE_PROFILE_KEY);
    if (!activeId) return;

    const profiles = getSavedApiProfiles();
    const prof = profiles.find(p => p.id === activeId);
    if (!prof) return;

    if (!confirm(`Are you sure you want to delete profile "${prof.name}"?`)) return;

    const remaining = profiles.filter(p => p.id !== activeId);
    saveApiProfilesToStorage(remaining);
    localStorage.removeItem(ACTIVE_PROFILE_KEY);
    renderApiProfilesDropdown(null);
    updateHeaderPill();
    showNotification(`✓ Profile "${prof.name}" deleted.`);
  }

  // Handle Provider switching: saves old provider data, loads new provider data, isolates models
  function handleProviderChange(newProv) {
    const oldProv = currentActiveProvider;

    // 1. SAVE outgoing provider's current settings so they are never lost!
    if (oldProv && oldProv !== newProv) {
      if (textApiKey) {
        localStorage.setItem('aetheria_key_' + oldProv, textApiKey.value.trim());
      }
      if (textBaseUrl) {
        localStorage.setItem('aetheria_url_' + oldProv, textBaseUrl.value.trim());
      }
      const curModel = localStorage.getItem('aetheria_text_model');
      if (curModel) {
        localStorage.setItem('aetheria_model_' + oldProv, curModel);
      }
    }

    currentActiveProvider = newProv;
    localStorage.setItem('aetheria_text_provider', newProv);

    // 2. LOAD incoming provider's saved settings
    const conf = PROVIDER_CONFIGS[newProv] || PROVIDER_CONFIGS.groq;
    const savedKey = localStorage.getItem('aetheria_key_' + newProv) || '';
    const savedUrl = localStorage.getItem('aetheria_url_' + newProv) || (conf.defaultUrl || '');

    if (textApiKey) textApiKey.value = savedKey;
    localStorage.setItem('aetheria_text_key', savedKey);

    if (textBaseUrl) textBaseUrl.value = savedUrl;
    localStorage.setItem('aetheria_text_base_url', savedUrl);

    // 3. LOAD incoming provider's models (Clear if key is required but missing)
    const requiresKey = conf.hasKey && !conf.isKeyOptional;
    if (requiresKey && !savedKey.trim()) {
      setEmptyModelDropdown();
      localStorage.removeItem('aetheria_text_model');
    } else {
      let modelsList = [];
      const cachedRaw = localStorage.getItem('aetheria_synced_models_' + newProv);
      if (cachedRaw) {
        try { modelsList = JSON.parse(cachedRaw); } catch(e) {}
      }
      if (!Array.isArray(modelsList) || modelsList.length === 0) {
        modelsList = DEFAULT_PROVIDER_MODELS[newProv] || ['default'];
      }

      const savedModelForProv = localStorage.getItem('aetheria_model_' + newProv);
      const selectedModel = (savedModelForProv && modelsList.includes(savedModelForProv))
        ? savedModelForProv
        : modelsList[0];

      populateModelDropdown(modelsList, selectedModel, false);
      localStorage.setItem('aetheria_text_model', selectedModel);
    }

    // 5. Update UI controls & badges
    syncProviderVisibility();
    updateQuickProvChips(newProv);
    updateHeaderPill();

    // 6. If active profile's provider does not match the newly selected provider, unselect active profile
    const activeProfId = localStorage.getItem(ACTIVE_PROFILE_KEY);
    if (activeProfId) {
      const profs = getSavedApiProfiles();
      const p = profs.find(x => x.id === activeProfId);
      if (p && p.provider !== newProv) {
        localStorage.removeItem(ACTIVE_PROFILE_KEY);
        renderApiProfilesDropdown(null);
      }
    }
  }

  // Load all engine settings from localStorage
  function loadEngineSettings() {
    // 0. Check if active API profile exists
    const activeProfId = localStorage.getItem(ACTIVE_PROFILE_KEY);
    const profiles = getSavedApiProfiles();
