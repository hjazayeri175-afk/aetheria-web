  function syncVoiceUiPanels() {
    // 1. TTS Progressive Disclosure
    const ttsId = voiceProviderSelect?.value || localStorage.getItem('aetheria_voice_provider') || 'browser';
    updateTtsEngineTriggerDisplay(ttsId);
    const ttsObj = TTS_CATALOG.find(x => x.id === ttsId) || TTS_CATALOG[0];
    const savedTtsKey = getVoiceKeyForProvider(ttsId);
    const isTtsConnected = (!ttsObj.needsKey) || Boolean(savedTtsKey);

    if (ttsActiveEngineName) ttsActiveEngineName.textContent = ttsObj.name;
    if (ttsActiveEngineDesc) ttsActiveEngineDesc.textContent = ttsObj.desc;
    if (ttsActiveIconBox) ttsActiveIconBox.innerHTML = getVoiceEngineIconSvg(ttsObj.id);

    if (voiceApiKey) {
      voiceApiKey.value = savedTtsKey;
    }

    if (ttsConnectionBadge) {
      if (!ttsObj.needsKey) {
        ttsConnectionBadge.className = 'px-2 py-0.5 rounded-full text-[10px] font-mono font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30';
        ttsConnectionBadge.textContent = '100% Free • Ready';
      } else if (!isTtsConnected) {
        ttsConnectionBadge.className = 'px-2 py-0.5 rounded-full text-[10px] font-mono font-semibold bg-amber-500/20 text-amber-300 border border-amber-500/30';
        ttsConnectionBadge.textContent = 'Key Required';
      } else {
        ttsConnectionBadge.className = 'px-2 py-0.5 rounded-full text-[10px] font-mono font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30';
        ttsConnectionBadge.textContent = 'Connected & Active';
      }
    }

    // Free device voice card vs Cloud connection card
    const isCustomTtsUrl = ttsObj.category === 'custom' || ttsId === 'xtts' || ttsId === 'custom';
    const customTtsUrlVal = localStorage.getItem('aetheria_tts_custom_url') || (ttsId === 'xtts' ? 'http://localhost:8020' : '');

    if (ttsId === 'browser') {
      if (ttsFreeDeviceCard) ttsFreeDeviceCard.classList.remove('hidden');
      if (ttsConnectionCard) ttsConnectionCard.classList.add('hidden');
      if (dynamicVoiceSection) dynamicVoiceSection.classList.remove('hidden');
    } else {
      if (ttsFreeDeviceCard) ttsFreeDeviceCard.classList.add('hidden');
      if (ttsConnectionCard) {
        ttsConnectionCard.classList.remove('hidden');
        if (ttsConnectTitle) ttsConnectTitle.textContent = `Connect ${ttsObj.name} API`;
        if (ttsConnectDesc) {
          ttsConnectDesc.textContent = isCustomTtsUrl 
            ? 'Enter your custom endpoint URL to connect.' 
            : 'Enter your API key to enable voice playback.';
        }
        if (voiceApiKey) {
          voiceApiKey.value = savedTtsKey;
          voiceApiKey.placeholder = ttsId === 'elevenlabs' ? 'Paste xi-api-key...' : (ttsId === 'openai' ? 'Paste sk-...' : (ttsId === 'google' ? 'Paste AIzaSy...' : 'Paste API Key...'));
        }
        if (voiceCustomUrlContainer) {
          voiceCustomUrlContainer.classList.toggle('hidden', !isCustomTtsUrl);
          if (isCustomTtsUrl && voiceCustomUrl) {
            voiceCustomUrl.value = customTtsUrlVal;
          }
        }

        // Toggle between Unconnected Form and Connected Bar
        if (ttsUnconnectedContainer && ttsConnectedContainer) {
          ttsUnconnectedContainer.classList.toggle('hidden', isTtsConnected);
          ttsConnectedContainer.classList.toggle('hidden', !isTtsConnected);
        }

        if (isTtsConnected) {
          if (ttsConnectedProvName) ttsConnectedProvName.textContent = ttsObj.name;
          if (ttsConnectedLatency) {
            ttsConnectedLatency.classList.remove('hidden');
            ttsConnectedLatency.className = 'text-[10px] px-2 py-0.5 rounded-full bg-emerald-500/15 border border-emerald-500/30 text-emerald-400 font-mono font-medium shrink-0';
            if (!ttsConnectedLatency.textContent || ttsConnectedLatency.textContent.includes('Offline')) {
              ttsConnectedLatency.textContent = 'Connected';
            }
          }
          if (ttsConnectedKeyMasked) {
            if (isCustomTtsUrl) {
              ttsConnectedKeyMasked.textContent = customTtsUrlVal || 'Custom Endpoint';
            } else if (savedTtsKey) {
              const prefix = savedTtsKey.slice(0, 4);
              const suffix = savedTtsKey.slice(-4);
              ttsConnectedKeyMasked.textContent = `${prefix}••••${suffix}`;
            } else {
              ttsConnectedKeyMasked.textContent = '••••••••';
            }
          }
        }

        // Only show voice selection if connected (or if it doesn't need a key)
        if (dynamicVoiceSection) {
          dynamicVoiceSection.classList.toggle('hidden', ttsObj.needsKey && !isTtsConnected);
        }

        // Quick reuse from Text tab
        const textKey = (ttsId === 'openai' ? localStorage.getItem('aetheria_key_openai') : (ttsId === 'google' ? localStorage.getItem('aetheria_key_google') : '')) || '';
        if (ttsQuickReuseKeyBtn && ttsQuickReuseLabel) {
          if (!savedTtsKey && textKey) {
            ttsQuickReuseKeyBtn.classList.remove('hidden');
            ttsQuickReuseLabel.textContent = `Connect with saved ${ttsId === 'openai' ? 'OpenAI' : 'Google'} Key from Text Engine`;
          } else {
            ttsQuickReuseKeyBtn.classList.add('hidden');
          }
        }
      }
    }

    // ElevenLabs extra sliders
    if (elevenExtraSettings) {
      elevenExtraSettings.classList.toggle('hidden', ttsId !== 'elevenlabs');
    }

    // Pitch slider hidden for OpenAI (OpenAI TTS doesn't support pitch shifting)
    if (voicePitchContainer) {
      voicePitchContainer.classList.toggle('hidden', ttsId === 'openai');
    }

    // OpenAI Model Selection Toggle (tts-1 vs tts-1-hd)
    if (openaiModelToggleContainer) {
      openaiModelToggleContainer.classList.toggle('hidden', ttsId !== 'openai');
    }

    if (customVoiceIdBox) {
      customVoiceIdBox.classList.toggle('hidden', ttsId !== 'elevenlabs');
    }

    // 2. STT Progressive Disclosure & Custom Dropdowns Sync
    const sttId = localStorage.getItem('aetheria_stt_provider') || 'groq';
    const isBrowserStt = sttId === 'browser-stt';
    const engObj = ALL_STT_ENGINES.find(e => e.id === sttId) || ALL_STT_ENGINES[1];
    const savedSttKey = getSttKeyForProvider(sttId);
    const isCustomUrl = Boolean(engObj.needsUrl);
    const customUrlVal = localStorage.getItem('aetheria_stt_custom_url') || engObj.defaultUrl || '';
    const isSttConnected = isBrowserStt || (isCustomUrl ? Boolean(customUrlVal) : Boolean(savedSttKey));

    updateSttEngineTriggerDisplay(sttId);

    if (sttFreeDeviceCard) {
      sttFreeDeviceCard.classList.toggle('hidden', !isBrowserStt);
    }

    if (sttConnectionCard) {
      sttConnectionCard.classList.toggle('hidden', isBrowserStt);
      if (!isBrowserStt) {
        if (sttConnectTitle) {
          sttConnectTitle.textContent = `Connect ${engObj.name}`;
        }
        if (sttConnectDesc) {
          sttConnectDesc.textContent = isCustomUrl 
            ? 'Enter your endpoint URL to connect.' 
            : 'Enter your API key to enable speech transcription.';
        }
        if (sttApiKey) {
          sttApiKey.value = savedSttKey;
          sttApiKey.placeholder = engObj.placeholder || 'Enter API Key...';
        }

        if (sttCustomUrlContainer) {
          sttCustomUrlContainer.classList.toggle('hidden', !isCustomUrl);
          if (isCustomUrl && sttCustomUrl) {
            sttCustomUrl.value = customUrlVal;
            sttCustomUrl.placeholder = engObj.defaultUrl || 'http://localhost:8000/v1/audio/transcriptions';
          }
        }

        // Toggle between Unconnected Form and Connected Bar
        if (sttUnconnectedContainer && sttConnectedContainer) {
          sttUnconnectedContainer.classList.toggle('hidden', isSttConnected);
          sttConnectedContainer.classList.toggle('hidden', !isSttConnected);
        }

        if (isSttConnected) {
          if (sttConnectedProvName) sttConnectedProvName.textContent = engObj.name;
          if (sttConnectedLatency) {
            sttConnectedLatency.classList.remove('hidden');
            sttConnectedLatency.className = 'text-[10px] px-2 py-0.5 rounded-full bg-rose-500/15 border border-rose-500/30 text-rose-300 font-mono font-medium shrink-0';
            if (!sttConnectedLatency.textContent || sttConnectedLatency.textContent.includes('Offline')) {
              sttConnectedLatency.textContent = 'Connected';
            }
          }
          if (sttConnectedKeyMasked) {
            if (isCustomUrl) {
              sttConnectedKeyMasked.textContent = customUrlVal || 'Custom Endpoint';
            } else if (savedSttKey) {
              const prefix = savedSttKey.slice(0, 4);
              const suffix = savedSttKey.slice(-4);
              sttConnectedKeyMasked.textContent = `${prefix}••••${suffix}`;
            } else {
              sttConnectedKeyMasked.textContent = '••••••••';
            }
          }
          // ONLY render models when key is connected!
          renderDynamicSttModels();
        } else {
          // When NOT connected: clear models menu so NO pre-filled dummy options appear!
          if (sttModelMenu) sttModelMenu.innerHTML = '';
        }

        // Quick reuse from Text tab
        const textKey = (sttId === 'groq' ? localStorage.getItem('aetheria_key_groq') : (sttId === 'openai-stt' ? localStorage.getItem('aetheria_key_openai') : '')) || '';
        if (sttQuickReuseKeyBtn && sttQuickReuseLabel) {
          if (!savedSttKey && textKey) {
            sttQuickReuseKeyBtn.classList.remove('hidden');
            sttQuickReuseLabel.textContent = `Use saved ${sttId === 'groq' ? 'Groq' : 'OpenAI'} Key from Text Engine`;
          } else {
            sttQuickReuseKeyBtn.classList.add('hidden');
          }
        }
      }
    }

    // Sync Spoken Language trigger
    const currentSttLang = localStorage.getItem('aetheria_stt_lang') || 'auto';
    updateSttLangTriggerDisplay(currentSttLang);
  }

