            </div>
          </div>
          ${isCur ? '<span class="text-[10px] px-1.5 py-0.5 rounded bg-purple-500/30 text-purple-200 font-bold shrink-0">Active</span>' : ''}
        </button>
      `;
    }).join('');

    modal.innerHTML = `
      <div class="flex items-center justify-between border-b border-white/[0.08] pb-3 mb-3">
        <div>
          <h3 class="text-xs font-bold text-white uppercase tracking-wider">Chat Persona</h3>
          <p class="text-[10px] text-slate-400 mt-0.5">Choose your identity for this chat</p>
        </div>
