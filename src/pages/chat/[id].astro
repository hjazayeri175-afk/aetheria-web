  // Export chat
  exportChatBtn?.addEventListener('click', () => {
    let md = `# Conversation with ${activeChar.name}\n\n`;
    const isPersonaActive = isPersonaGloballyActive();
    const userName = isPersonaActive ? (activeUserPersona.name || 'You') : 'You';
    conversation.forEach((msg) => {
      const name = msg.sender === 'character' ? activeChar.name : userName;
      md += `**[${msg.timestamp || ''}] ${name}:**\n${msg.text}\n\n`;
    });
    const blob = new Blob([md], { type: 'text/markdown' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
