    backdrop.appendChild(modal);
    document.body.appendChild(backdrop);

    requestAnimationFrame(() => {
      backdrop.classList.remove('opacity-0');
      modal.classList.remove('translate-y-6', 'scale-95');
    });

    const cleanup = () => {
      backdrop.classList.add('opacity-0');
      modal.classList.add('translate-y-6', 'scale-95');
      setTimeout(() => backdrop.remove(), 200);
    };

    modal.querySelector('#close-mask-modal-btn')?.addEventListener('click', cleanup);
    modal.querySelector('#done-mask-modal-btn')?.addEventListener('click', cleanup);
    backdrop.addEventListener('click', (e) => {
      if (e.target === backdrop) cleanup();
    });

    modal.querySelectorAll('.mask-pick-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-mask-id');
        if (id === 'none') {
          localStorage.setItem('aetheria_persona_enabled', 'false');
          activeUserPersona = {
            id: 'none',
            name: 'You',
            disabled: true,
            age: '',
            gender: '',
            title: '',
            avatar: '',
            appearance: '',
            personality: '',
            bio: '',
            lore: '',
            globalNotes: '',
            directives: ''
          };
          updateChatMaskLabel();
          renderAllMessages();
          showNotification('Persona disabled. Playing anonymously with no identity.');
          cleanup();
          return;
        }

        const chosen = savedMasks.find((x) => x.id === id);
        if (chosen) {
          localStorage.setItem('aetheria_persona_enabled', 'true');
          activeUserPersona = {
            id: chosen.id,
            name: chosen.name || 'User',
            age: chosen.age || '',
            gender: chosen.gender || chosen.pronouns || '',
            pronouns: chosen.gender || chosen.pronouns || '',
            title: chosen.title || '',
            avatar: chosen.avatar || '',
            appearance: chosen.appearance || '',
            personality: chosen.personality || '',
            bio: chosen.bio || chosen.lore || '',
            lore: chosen.lore || chosen.bio || '',
            globalNotes: chosen.directives || chosen.globalNotes || '',
            directives: chosen.directives || chosen.globalNotes || ''
          };
          localStorage.setItem('aetheria_user_persona', JSON.stringify(activeUserPersona));
          updateChatMaskLabel();
          renderAllMessages();
          showNotification(`Switched to persona: ${activeUserPersona.name || 'You'}`);
          cleanup();
        }
      });
    });
  });

  window.addEventListener('pageshow', () => {
    const isNowEnabled = (localStorage.getItem('aetheria_persona_enabled') !== 'false');
    if (!isNowEnabled) {
      activeUserPersona = {
        id: 'none',
        name: 'You',
        disabled: true,
        age: '',
        gender: '',
        title: '',
        avatar: '',
        appearance: '',
        personality: '',
        bio: '',
        lore: '',
        globalNotes: '',
        directives: ''
      };
    } else {
      try {
        const raw = localStorage.getItem('aetheria_user_persona');
        if (raw) activeUserPersona = JSON.parse(raw);
      } catch {}
    }
    updateChatMaskLabel();
    renderAllMessages();
  });

  selfieBtn?.addEventListener('click', handleGenerateSelfie);
  videoBtn?.addEventListener('click', handleGenerateVideo);
  regenBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (conversation.length > 0) {
      const lastIdx = conversation.length - 1;
      if (conversation[lastIdx].sender === 'character') {
        openRegenerateMenu(regenBtn, lastIdx);
      } else {
        handleSendMessage(conversation[lastIdx].text);
      }
    }
  });
  rewindBtn?.addEventListener('click', () => {
    if (conversation.length > 0) {
      rewindTurn(conversation.length - 1);
    }
  });

  const dismissMessagePopovers = () => {
    const pop1 = document.getElementById('chat-regenerate-popover');
    if (pop1) pop1.remove();
    const pop2 = document.getElementById('chat-more-popover');
    if (pop2) pop2.remove();
  };
  chatStream?.addEventListener('scroll', dismissMessagePopovers, { passive: true });
  window.addEventListener('scroll', dismissMessagePopovers, { passive: true });

  // Global delegation for dynamic message buttons (Edit, Rewind, Swipes, Speak, Copy, Delete, Lightbox)
  document.addEventListener('click', (e) => {
    const target = e.target;

    // Dismiss contextual regeneration popovers on outside click
    const regenPopover = document.getElementById('chat-regenerate-popover');
    if (regenPopover && !regenPopover.contains(target) && !target.closest('.msg-regenerate-btn') && !target.closest('#chat-action-regenerate-btn')) {
      regenPopover.remove();
    }
    const morePopover = document.getElementById('chat-more-popover');
    if (morePopover && !morePopover.contains(target) && !target.closest('.msg-more-btn')) {
      morePopover.remove();
    }

    // More options button (...) on character or user message
    const moreMsgBtn = target.closest('.msg-more-btn');
    if (moreMsgBtn) {
      const idx = parseInt(moreMsgBtn.getAttribute('data-idx') || '0', 10);
      const isUser = moreMsgBtn.getAttribute('data-is-user') === 'true';
      openMessageMoreMenu(moreMsgBtn, idx, isUser);
      return;
    }

    // Regenerate / modify response button on character message
    const regenMsgBtn = target.closest('.msg-regenerate-btn');
    if (regenMsgBtn) {
      const idx = parseInt(regenMsgBtn.getAttribute('data-idx') || '0', 10);
      openRegenerateMenu(regenMsgBtn, idx);
      return;
    }

    // Lightbox image trigger (for in-chat photos / selfies)
    const lightboxImgTrigger = target.closest('.lightbox-img-trigger');
    if (lightboxImgTrigger) {
      const imgUrl = lightboxImgTrigger.getAttribute('data-img-url');
      const imgTitle = lightboxImgTrigger.getAttribute('data-img-title');
      const imgDesc = lightboxImgTrigger.getAttribute('data-img-desc');
      openLightbox(imgUrl, imgTitle, imgDesc);
      return;
    }

    // Lightbox character avatar trigger in messages
    const charAvatarTrigger = target.closest('.open-lightbox-char-trigger');
    if (charAvatarTrigger) {
      openLightbox(activeChar.avatarUrl, activeChar.name, activeChar.title);
      return;
    }

    // Swipe buttons
    const swipeBtn = target.closest('.msg-swipe-btn');
    if (swipeBtn) {
      const idx = parseInt(swipeBtn.getAttribute('data-idx') || '0', 10);
      const action = swipeBtn.getAttribute('data-action') || 'next';
      handleSwipeNavigation(idx, action);
      return;
    }

    // Edit button
    const editBtn = target.closest('.msg-edit-btn');
    if (editBtn) {
      const idx = parseInt(editBtn.getAttribute('data-idx') || '0', 10);
      enableEditMessage(idx);
      return;
    }

    // Rewind button
    const rewindMsgBtn = target.closest('.msg-rewind-btn');
    if (rewindMsgBtn) {
      const idx = parseInt(rewindMsgBtn.getAttribute('data-idx') || '0', 10);
      rewindTurn(idx);
      return;
    }

    // Delete button
    const deleteBtn = target.closest('.msg-delete-btn');
    if (deleteBtn) {
      const idx = parseInt(deleteBtn.getAttribute('data-idx') || '0', 10);
      showConfirmModal({
        title: 'Delete Message?',
        message: 'Remove this message from the conversation history?',
        confirmText: 'Delete',
        cancelText: 'Cancel',
        type: 'danger'
      }).then(confirmed => {
        if (confirmed) {
          conversation.splice(idx, 1);
          saveChat();
          renderAllMessages();
          showNotification('Message deleted.');
        }
      });
      return;
    }

    // Copy button
    const copyBtn = target.closest('.msg-copy-btn');
    if (copyBtn) {
      const text = decodeURIComponent(copyBtn.getAttribute('data-text') || '');
      navigator.clipboard.writeText(text);
      copyBtn.innerHTML = TOOLBAR_ICONS.check;
      copyBtn.classList.remove('text-slate-400');
      copyBtn.classList.add('text-emerald-400');
      setTimeout(() => {
        copyBtn.innerHTML = TOOLBAR_ICONS.copy;
        copyBtn.classList.remove('text-emerald-400');
        copyBtn.classList.add('text-slate-400');
      }, 1500);
      showNotification('Copied message to clipboard!');
      return;
    }

    // Speak / Stop button
    const speakBtn = target.closest('.msg-speak-btn');
    if (speakBtn) {
      const idx = parseInt(speakBtn.getAttribute('data-idx') || '0', 10);
      const msg = conversation[idx];
      if (msg) speak(msg.text, speakBtn, idx);
      return;
    }

    // Report message / response button
    const reportMsgBtn = target.closest('.msg-report-btn');
    if (reportMsgBtn) {
      const idx = parseInt(reportMsgBtn.getAttribute('data-idx') || '0', 10);
      const msg = conversation[idx];
      if (msg) {
        openReportModal({
          targetType: 'message',
          targetId: `msg_${idx}_${Date.now()}`,
          targetName: (typeof activeChar !== 'undefined' && activeChar ? activeChar.name : 'AI Response'),
          category: 'legal',
          snippet: msg.text,
          metadata: {
            messageIndex: idx,
            sender: msg.sender,
            characterId: typeof activeChar !== 'undefined' ? activeChar?.id : '',
            characterName: typeof activeChar !== 'undefined' ? activeChar?.name : '',
            provider: localStorage.getItem('aetheria_text_provider') || 'auto',
            model: localStorage.getItem('aetheria_text_model') || 'auto'
          }
        });
      }
      return;
    }

    // Report character sidebar button
    const reportCharBtn = target.closest('#report-character-sidebar-btn');
    if (reportCharBtn) {
      openReportModal({
        targetType: 'character',
        targetId: typeof activeChar !== 'undefined' ? activeChar.id : 'character',
        targetName: typeof activeChar !== 'undefined' ? activeChar.name : 'Character',
        category: 'safety',
        snippet: typeof activeChar !== 'undefined' ? `${activeChar.name}: ${(activeChar.description || '').slice(0, 300)}` : '',
        metadata: {
          characterId: typeof activeChar !== 'undefined' ? activeChar.id : '',
          characterName: typeof activeChar !== 'undefined' ? activeChar.name : '',
          category: typeof activeChar !== 'undefined' ? activeChar.category : '',
          tags: typeof activeChar !== 'undefined' ? activeChar.tags : []
        }
      });
      return;
    }
  });

  // -------------------------------------------------------------
  // EVENT LISTENERS: GEMINI INPUT, DYNAMIC RESIZING, & CONTROLS
  // -------------------------------------------------------------
  const plusBtn = document.getElementById('chat-input-plus-btn');
  const plusMenu = document.getElementById('chat-plus-menu');
  const micBtn = document.getElementById('chat-input-mic-btn');

  // Multimodal & Input DOM Elements
  const multimodalActiveChip = document.getElementById('multimodal-active-chip');
  const multimodalChipIcon = document.getElementById('multimodal-chip-icon');
  const multimodalChipLabel = document.getElementById('multimodal-chip-label');
  const multimodalChipCloseBtn = document.getElementById('multimodal-chip-close-btn');
  const multimodalAspectPillContainer = document.getElementById('multimodal-aspect-pill-container');
  const multimodalAspectTrigger = document.getElementById('multimodal-aspect-trigger');
  const multimodalAspectMenu = document.getElementById('multimodal-aspect-menu');
  const multimodalAspectLabel = document.getElementById('multimodal-aspect-label');
  const chatAttachedImageContainer = document.getElementById('chat-attached-image-container');
  const chatAttachedImagePreview = document.getElementById('chat-attached-image-preview');
  const chatRemoveAttachedImageBtn = document.getElementById('chat-remove-attached-image-btn');

  const filePhotoInput = document.getElementById('chat-file-photo-input');
  const fileCameraInput = document.getElementById('chat-file-camera-input');
  const fileDocInput = document.getElementById('chat-file-doc-input');

  function setMultimodalMode(mode) {
    currentMultimodalMode = mode;
    plusMenu?.classList.add('hidden');
    plusBtn?.classList.remove('rotate-45', 'text-purple-400');

    if (!mode) {
      multimodalActiveChip?.classList.add('hidden');
      multimodalAspectPillContainer?.classList.add('hidden');
      multimodalAspectMenu?.classList.add('hidden');
      if (input) input.placeholder = `Message ${activeChar.name}...`;
      updateSendBtnState();
      return;
    }

    multimodalActiveChip?.classList.remove('hidden');

    if (mode === 'image') {
      if (multimodalChipIcon) {
        multimodalChipIcon.innerHTML = `<svg class="w-3.5 h-3.5 text-purple-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="3" rx="2" ry="2"/><circle cx="9" cy="9" r="2"/><path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"/></svg>`;
      }
      if (multimodalChipLabel) multimodalChipLabel.textContent = 'Images';
      multimodalAspectPillContainer?.classList.remove('hidden');
      if (input) input.placeholder = 'Describe your image or character selfie...';
    } else if (mode === 'video') {
      if (multimodalChipIcon) {
        multimodalChipIcon.innerHTML = `<svg class="w-3.5 h-3.5 text-sky-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m22 8-6 4 6 4V8Z"/><rect width="14" height="12" x="2" y="6" rx="2" ry="2"/></svg>`;
      }
      if (multimodalChipLabel) multimodalChipLabel.textContent = 'Videos';
      multimodalAspectPillContainer?.classList.add('hidden');
      if (input) input.placeholder = 'Describe motion or scene to animate...';
    } else if (mode === 'voice') {
      if (multimodalChipIcon) {
        multimodalChipIcon.innerHTML = `<svg class="w-3.5 h-3.5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/></svg>`;
      }
      if (multimodalChipLabel) multimodalChipLabel.textContent = 'Voice & Audio';
      multimodalAspectPillContainer?.classList.add('hidden');
      if (input) input.placeholder = 'Enter text for character voice memo...';
    }

    updateSendBtnState();
    input?.focus();
  }

  function clearAttachedImage() {
    attachedImageBase64 = null;
    chatAttachedImageContainer?.classList.add('hidden');
    if (chatAttachedImagePreview) chatAttachedImagePreview.src = '';
    if (filePhotoInput) filePhotoInput.value = '';
    if (fileCameraInput) fileCameraInput.value = '';
    updateSendBtnState();
  }

  function handleImageFileSelected(file) {
    if (!file || !file.type.startsWith('image/')) {
      showNotification('Please select a valid image file');
      return;
    }
    if (file.size > 10 * 1024 * 1024) {
      showNotification('Image size exceeds 10MB limit');
      return;
    }
    const reader = new FileReader();
    reader.onload = (e) => {
      attachedImageBase64 = e.target.result;
      if (chatAttachedImagePreview) chatAttachedImagePreview.src = attachedImageBase64;
      chatAttachedImageContainer?.classList.remove('hidden');
      updateSendBtnState();
      showNotification('📷 Photo attached as reference / visual input');
    };
    reader.readAsDataURL(file);
  }

  async function handleUnifiedSubmit() {
    const text = input ? input.value.trim() : '';

    if (currentMultimodalMode === 'image') {
      const currentPrompt = text;
      const currentImg = attachedImageBase64;
      const currentAspect = selectedAspectRatio;
      if (input) {
        input.value = '';
        adjustInputHeight();
      }
      setMultimodalMode(null);
      clearAttachedImage();
      await handleGenerateSelfie(currentPrompt, currentImg, currentAspect);
      return;
    }

    if (currentMultimodalMode === 'video') {
      const currentPrompt = text;
      const currentImg = attachedImageBase64;
      if (input) {
        input.value = '';
        adjustInputHeight();
      }
      setMultimodalMode(null);
      clearAttachedImage();
      await handleGenerateVideo(currentPrompt, currentImg);
      return;
    }

    if (currentMultimodalMode === 'voice') {
      const currentText = text;
      if (input) {
        input.value = '';
        adjustInputHeight();
      }
      setMultimodalMode(null);
      if (currentText) {
        speak(currentText);
      }
      return;
    }

    // Normal chat message
    if (!text && !attachedImageBase64) return;
    const userMsgText = text;
    const userAttachedImg = attachedImageBase64;
    if (input) {
      input.value = '';
      adjustInputHeight();
    }
    clearAttachedImage();
    await handleSendMessage(userMsgText, userAttachedImg);
  }

  inputForm?.addEventListener('submit', (e) => {
    e.preventDefault();
    handleUnifiedSubmit();
  });

  input?.addEventListener('keydown', (e) => {
    if (e.isComposing || e.keyCode === 229) return;

    const sendPref = localStorage.getItem('aetheria_chat_send_key') || 'enter';

    if (isTouchDevice()) {
      if (e.key === 'Enter') {
        setTimeout(adjustInputHeight, 0);
        return;
      }
    }

    if (sendPref === 'ctrl_enter') {
      if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
        e.preventDefault();
        handleUnifiedSubmit();
        return;
      }
      if (e.key === 'Enter') {
        setTimeout(adjustInputHeight, 0);
        return;
      }
    } else {
      if (e.shiftKey) {
        setTimeout(adjustInputHeight, 0);
        return;
      }
      if (e.key === 'Enter') {
        e.preventDefault();
        handleUnifiedSubmit();
      }
    }
  });

  input?.addEventListener('input', () => {
    adjustInputHeight();
    updateSendBtnState();
  });

  input?.addEventListener('paste', () => {
    setTimeout(() => {
      adjustInputHeight();
      updateSendBtnState();
    }, 10);
  });

  // Mobile optimization: Auto-hide Smart Ideas suggestion bar on keyboard focus to maximize reading room
  input?.addEventListener('focus', () => {
    if (window.innerWidth < 640 && smartPromptsBar) {
      smartPromptsBar.style.display = 'none';
    }
  });

  input?.addEventListener('blur', () => {
    if (window.innerWidth < 640 && smartPromptsBar && !input.value.trim()) {
      smartPromptsBar.style.display = '';
    }
  });

  // Gemini-style Plus Menu (+) Controls
  plusBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (!plusMenu) return;
    const isHidden = plusMenu.classList.contains('hidden');
    if (isHidden) {
      plusMenu.classList.remove('hidden');
      plusBtn.classList.add('rotate-45', 'text-purple-400');
    } else {
      plusMenu.classList.add('hidden');
      plusBtn.classList.remove('rotate-45', 'text-purple-400');
    }
  });

  document.addEventListener('click', (e) => {
    if (plusMenu && !plusMenu.classList.contains('hidden')) {
      if (!plusMenu.contains(e.target) && e.target !== plusBtn) {
        plusMenu.classList.add('hidden');
        plusBtn?.classList.remove('rotate-45', 'text-purple-400');
      }
    }
  });

  // Gemini Plus Menu Quick Actions
  document.getElementById('plus-action-photos')?.addEventListener('click', () => {
    plusMenu?.classList.add('hidden');
    plusBtn?.classList.remove('rotate-45', 'text-purple-400');
    filePhotoInput?.click();
  });

  document.getElementById('plus-action-camera')?.addEventListener('click', () => {
    plusMenu?.classList.add('hidden');
    plusBtn?.classList.remove('rotate-45', 'text-purple-400');
    fileCameraInput?.click();
  });

  document.getElementById('plus-action-files')?.addEventListener('click', () => {
    plusMenu?.classList.add('hidden');
    plusBtn?.classList.remove('rotate-45', 'text-purple-400');
    fileDocInput?.click();
  });

  document.getElementById('plus-mode-images')?.addEventListener('click', () => {
    setMultimodalMode('image');
  });

  document.getElementById('plus-mode-videos')?.addEventListener('click', () => {
    setMultimodalMode('video');
  });

  document.getElementById('plus-mode-voice')?.addEventListener('click', () => {
    setMultimodalMode('voice');
  });

  multimodalChipCloseBtn?.addEventListener('click', () => {
    setMultimodalMode(null);
  });

  chatRemoveAttachedImageBtn?.addEventListener('click', () => {
    clearAttachedImage();
  });

  filePhotoInput?.addEventListener('change', (e) => {
    const file = e.target.files?.[0];
    if (file) handleImageFileSelected(file);
  });

  fileCameraInput?.addEventListener('change', (e) => {
    const file = e.target.files?.[0];
    if (file) handleImageFileSelected(file);
  });

  fileDocInput?.addEventListener('change', async (e) => {
    const file = e.target.files?.[0];
    if (!file) return;
    try {
      const text = await file.text();
      if (input) {
