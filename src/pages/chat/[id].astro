<script define:vars={{ character }}>
  // Client-side state & logic
  let activeChar = { ...character };
  let activeUserPersona = {
    name: 'You',
    age: '',
    gender: '',
    pronouns: '',
    title: '',
    avatar: '',
    appearance: '',
    personality: '',
    bio: '',
    lore: '',
    globalNotes: 'Never speak, narrate, or assume actions for {{user}}. Maintain atmospheric immersion.'
  };

  // 1. Resolve User Persona / Mask from localStorage (Physical Data Isolation when disabled)
  const isPersonaGloballyEnabled = (localStorage.getItem('aetheria_persona_enabled') !== 'false');
  if (isPersonaGloballyEnabled) {
    try {
      const rawPersona = localStorage.getItem('aetheria_user_persona');
      if (rawPersona) {
        const parsed = JSON.parse(rawPersona);
        activeUserPersona = { ...activeUserPersona, ...parsed };
        if (activeUserPersona.name === 'Traveler') activeUserPersona.name = 'You';
      }
    } catch {}
  } else {
    // Physical isolation: do not load or hold any persona data in runtime memory
    activeUserPersona = {
      id: 'none',
      name: 'You',
      disabled: true,
      age: '',
      gender: '',
      pronouns: '',
      title: '',
      avatar: '',
      appearance: '',
      personality: '',
      bio: '',
      lore: '',
      globalNotes: '',
      directives: ''
    };
  }

  // 2. Resolve Custom Character if URL is /chat/custom or has ?id=
  const urlParams = new URLSearchParams(window.location.search);
  const customId = urlParams.get('charId') || urlParams.get('id');
  const isCustomRoute = character.id === 'custom' || window.location.pathname.includes('/chat/custom');

  if (isCustomRoute) {
    try {
      const customList = JSON.parse(localStorage.getItem('aetheria_custom_characters') || '[]');
      let matched = null;
      if (customId) {
        matched = customList.find(c => c.id === customId);
      }
      if (!matched && customList.length > 0) {
        matched = customList[customList.length - 1]; // latest created custom character
      }
      if (matched) {
        activeChar = {
          ...activeChar,
          ...matched,
          avatarUrl: matched.avatarUrl || activeChar.avatarUrl,
          greeting: matched.greeting || activeChar.greeting,
          alternateGreetings: (matched.alternateGreetings && matched.alternateGreetings.length > 0) 
            ? matched.alternateGreetings 
            : (matched.alternate_greetings || activeChar.alternateGreetings || []),
          fallbackReplies: (matched.alternateGreetings && matched.alternateGreetings.length > 0) ? matched.alternateGreetings : activeChar.fallbackReplies,
          starterPrompts: (matched.starterPrompts && matched.starterPrompts.length > 0) ? matched.starterPrompts : activeChar.starterPrompts,
          scenario: matched.scenario || activeChar.scenario || '',
          systemPrompt: matched.systemPrompt || activeChar.systemPrompt || '',
          speechStyle: matched.speechStyle || activeChar.speechStyle || '',
          mesExample: matched.mesExample || activeChar.mesExample || '',
          personality: matched.personality || activeChar.personality || '',
          lorebook: matched.lorebook || activeChar.lorebook || []
        };
      }
    } catch {}
  }

  // Macro replacement helper for {{user}} and {{char}} (Tavern / Chub / SillyTavern standard)
  function isPoisonedOrErrorMessage(text) {
    if (!text || typeof text !== 'string') return true;
    const t = text.trim();
    if (t.startsWith('⚠️')) return true;
    if (t.includes('The request was rejected') || t.includes('considered high risk')) return true;
    if (t.includes('你好，我无法') || t.includes('无法给到相关内容') || t.includes('抱歉，我无法')) return true;
    if (t.includes('I cannot fulfill this request') || t.includes('I am unable to fulfill this request')) return true;
    return false;
  }

  function isPersonaGloballyActive() {
    return (localStorage.getItem('aetheria_persona_enabled') !== 'false')
      && activeUserPersona 
      && activeUserPersona.id !== 'none'
      && !activeUserPersona.disabled;
  }

  function formatMacroText(str) {
    if (!str || typeof str !== 'string') return '';
    const isPersonaActive = isPersonaGloballyActive();
    const uName = (isPersonaActive && activeUserPersona && activeUserPersona.name && activeUserPersona.name.trim()) 
      ? activeUserPersona.name.trim() 
      : null;
    const cName = (activeChar && activeChar.name) ? activeChar.name : 'Character';

    let result = str
      .replace(/\{\{char\}\}/gi, cName)
      .replace(/<CHAR>/gi, cName)
      .replace(/<BOT>/gi, cName);

    if (uName) {
      result = result
        .replace(/\{\{user\}\}'s/gi, `${uName}'s`)
        .replace(/<USER>'s/gi, `${uName}'s`)
        .replace(/\{\{user\}\}/gi, uName)
        .replace(/<USER>/gi, uName);
    } else {
      // When persona is disabled: replace with natural 2nd-person pronouns ("you" / "your"), never literal "User"
      result = result
        .replace(/\{\{user\}\}'s/gi, 'your')
        .replace(/<USER>'s/gi, 'your')
        .replace(/,\s*\{\{user\}\}/gi, '')
        .replace(/,\s*<USER>/gi, '')
        .replace(/\{\{user\}\},\s*/gi, '')
        .replace(/<USER>,\s*/gi, '')
        .replace(/\{\{user\}\}/gi, 'you')
        .replace(/<USER>/gi, 'you');
    }
    return result;
  }

  // Strictly clean internal thoughts, HTML details tags, and UI artifacts before sending history to LLM API
  function stripInternalArtifactsForLLM(text) {
    if (!text || typeof text !== 'string') return '';
    let cleaned = text;
    // Strip <details>...</details>
    cleaned = cleaned.replace(/<details[\s\S]*?<\/details>/gi, '');
    // Strip <think>...</think>
    cleaned = cleaned.replace(/<think>[\s\S]*?<\/think>/gi, '');
    cleaned = cleaned.replace(/<thought>[\s\S]*?<\/thought>/gi, '');
    // Strip unclosed <details> or <think>
    cleaned = cleaned.replace(/<details[\s\S]*$/gi, '');
    cleaned = cleaned.replace(/<think>[\s\S]*$/gi, '');
    cleaned = cleaned.replace(/<thought>[\s\S]*$/gi, '');
    // Strip [Internal Thoughts: ...]
    cleaned = cleaned.replace(/\[Internal Thoughts:[\s\S]*?\]/gi, '');
    // Strip [Directive: ...]
    cleaned = cleaned.replace(/\[Directive:[\s\S]*?\]/gi, '');
    // Strip UI notices and alerts
    cleaned = cleaned.replace(/<div class="[^"]*(?:bg-amber|border-amber|rounded)[^"]*"[\s\S]*?<\/div>/gi, '');
    // Strip any lingering HTML tags like </details> or </div>
    cleaned = cleaned.replace(/<\/?(?:details|summary|div|span|p|code)[^>]*>/gi, '');
    return cleaned.trim();
  }

  // Sanitize history messages sent to LLM: strictly scrub persona names/identities if persona is disabled,
  // and strip internal thoughts / UI markup so LLMs never hallucinate tags or leak CoT into dialogue
  function getSanitizedHistoryForAPI(historySlice, forceDepersonalize = false) {
    if (!Array.isArray(historySlice)) return [];
    const isPersonaActive = forceDepersonalize ? false : isPersonaGloballyActive();

    let nameList = [];
    if (!isPersonaActive) {
      const knownNames = new Set(['Traveler']);
      try {
        const rawPersona = localStorage.getItem('aetheria_user_persona');
        if (rawPersona) {
          const parsed = JSON.parse(rawPersona);
          if (parsed.name && parsed.name.trim() && parsed.name.trim().toLowerCase() !== 'you') {
            knownNames.add(parsed.name.trim());
          }
        }
        const rawMasks = localStorage.getItem('aetheria_user_personas');
        if (rawMasks) {
          const masks = JSON.parse(rawMasks);
          if (Array.isArray(masks)) {
            masks.forEach(m => {
              if (m.name && m.name.trim() && m.name.trim().toLowerCase() !== 'you') {
                knownNames.add(m.name.trim());
              }
            });
          }
        }
        const dName = localStorage.getItem('aetheria_user_display_name');
        if (dName && dName.trim() && dName.trim().toLowerCase() !== 'you') {
          knownNames.add(dName.trim());
        }
      } catch {}
      nameList = [...knownNames].filter(n => n && n.length > 1);
    }

    return historySlice
      .map(m => {
        let content = m.content || m.text || '';
        // Always strip internal thoughts and UI markup from history sent to API
        content = stripInternalArtifactsForLLM(content);

        if (!isPersonaActive && nameList.length > 0) {
          nameList.forEach(name => {
            const escaped = name.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
            content = content
              .replace(new RegExp(`\\b${escaped}'s\\b`, 'gi'), 'your')
              .replace(new RegExp(`,\\s*${escaped}\\b`, 'gi'), '')
              .replace(new RegExp(`\\b${escaped},\\s*`, 'gi'), '')
              .replace(new RegExp(`\\b${escaped}\\b`, 'gi'), 'you');
          });
        }

        return {
          role: m.role || (m.sender === 'user' ? 'user' : 'assistant'),
          content: content
        };
      })
      .filter(m => m.content && m.content.trim().length > 0);
  }

  // Retrieve all unique scenario greetings (first_mes + alternate_greetings)
  function getCharacterGreetings() {
    const rawList = [
      activeChar.greeting,
      ...(activeChar.alternateGreetings || []),
      ...(activeChar.alternate_greetings || []),
      ...(character?.alternateGreetings || []),
      ...(character?.alternate_greetings || [])
    ].filter(Boolean);

    const unique = [];
    const seen = new Set();
    rawList.forEach(g => {
      const trimmed = g.trim();
      if (trimmed && !seen.has(trimmed)) {
        seen.add(trimmed);
        unique.push(formatMacroText(trimmed));
      }
    });

    return unique.length > 0 ? unique : [formatMacroText(activeChar.greeting || 'Greetings, traveler.')];
  }

