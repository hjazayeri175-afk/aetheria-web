  function applyVideoProfile(id) {
    const profiles = getSavedVideoProfiles();
    const prof = profiles.find(p => p.id === id);
    if (!prof) return;

    localStorage.setItem(ACTIVE_VIDEO_PROFILE_KEY, prof.id);
    if (prof.provider && typeof window.selectVideoEngine === 'function') {
      window.selectVideoEngine(prof.provider);
    }
    if (prof.apiKey) {
      localStorage.setItem('aetheria_video_key', prof.apiKey);
      localStorage.setItem('aetheria_key_' + prof.provider, prof.apiKey);
    }
    if (prof.customUrl) {
      localStorage.setItem('aetheria_video_custom_url', prof.customUrl);
    }
    if (prof.camera && typeof window.selectVideoCamera === 'function') {
      window.selectVideoCamera(prof.camera);
    }
    if (prof.duration && typeof window.selectVideoDuration === 'function') {
      window.selectVideoDuration(prof.duration);
    }
    if (prof.resolution && typeof window.selectVideoRes === 'function') {
      window.selectVideoRes(prof.resolution);
    }
    if (prof.motion !== undefined) {
      if (sliderMotion) sliderMotion.value = prof.motion;
      if (badgeMotion) badgeMotion.value = prof.motion;
      localStorage.setItem('aetheria_video_motion', prof.motion.toString());
    }

    if (typeof syncVideoUiPanels === 'function') syncVideoUiPanels();
    renderVideoProfileMenu();
    showNotification(`✓ Loaded video profile: ${prof.name}`);
  }

  function saveCurrentAsVideoProfile(name) {
    if (!name || !name.trim()) {
      showNotification('⚠️ Please enter a profile name', 'warning');
      return;
    }
    const currentProv = localStorage.getItem('aetheria_video_provider') || 'fal-kling';
    const profiles = getSavedVideoProfiles();
    const newProf = {
      id: 'vidp_' + Date.now(),
      name: name.trim(),
      provider: currentProv,
      apiKey: localStorage.getItem('aetheria_video_key') || localStorage.getItem('aetheria_key_' + currentProv) || '',
      customUrl: localStorage.getItem('aetheria_video_custom_url') || '',
      camera: localStorage.getItem('aetheria_video_camera') || 'subtle',
      duration: localStorage.getItem('aetheria_video_duration') || '5s',
      resolution: localStorage.getItem('aetheria_video_res') || '720p-24fps',
      motion: sliderMotion?.value || '50',
      updatedAt: Date.now()
    };
    profiles.push(newProf);
    saveVideoProfiles(profiles);
    localStorage.setItem(ACTIVE_VIDEO_PROFILE_KEY, newProf.id);
    renderVideoProfileMenu();
    if (newVideoProfileForm) newVideoProfileForm.classList.add('hidden');
    if (newVideoProfileNameInput) newVideoProfileNameInput.value = '';
    showNotification(`✓ Video profile "${newProf.name}" saved!`);
  }

  function updateActiveVideoProfile() {
    const activeId = localStorage.getItem(ACTIVE_VIDEO_PROFILE_KEY);
    if (!activeId) return;
    const profiles = getSavedVideoProfiles();
    const idx = profiles.findIndex(p => p.id === activeId);
    if (idx === -1) return;

    const currentProv = localStorage.getItem('aetheria_video_provider') || 'fal-kling';
    profiles[idx] = {
      ...profiles[idx],
      provider: currentProv,
      apiKey: localStorage.getItem('aetheria_video_key') || localStorage.getItem('aetheria_key_' + currentProv) || '',
      customUrl: localStorage.getItem('aetheria_video_custom_url') || '',
      camera: localStorage.getItem('aetheria_video_camera') || 'subtle',
      duration: localStorage.getItem('aetheria_video_duration') || '5s',
      resolution: localStorage.getItem('aetheria_video_res') || '720p-24fps',
      motion: sliderMotion?.value || '50',
      updatedAt: Date.now()
    };
    saveVideoProfiles(profiles);
    renderVideoProfileMenu();
    showNotification(`✓ Updated video profile "${profiles[idx].name}"!`);
  }

  async function deleteActiveVideoProfile() {
    const activeId = localStorage.getItem(ACTIVE_VIDEO_PROFILE_KEY);
    if (!activeId) return;
    const profiles = getSavedVideoProfiles();
    const prof = profiles.find(p => p.id === activeId);
    if (!prof) return;

    const confirmed = await showConfirmModal({
      title: 'Delete Video Profile?',
      message: `Are you sure you want to delete "${prof.name}"?`,
      confirmText: 'Delete',
      cancelText: 'Cancel',
      type: 'danger'
    });
    if (confirmed) {
      const remaining = profiles.filter(p => p.id !== activeId);
      saveVideoProfiles(remaining);
      localStorage.removeItem(ACTIVE_VIDEO_PROFILE_KEY);
      renderVideoProfileMenu();
      showNotification(`✓ Profile "${prof.name}" deleted.`);
    }
  }

  function openVideoProfileMenu() {
    if (!customVideoProfileMenu) return;
    customVideoProfileMenu.classList.remove('hidden');
    if (customVideoProfileChevron) customVideoProfileChevron.classList.add('rotate-180');
  }

  function closeVideoProfileMenu() {
    if (!customVideoProfileMenu) return;
    customVideoProfileMenu.classList.add('hidden');
    if (customVideoProfileChevron) customVideoProfileChevron.classList.remove('rotate-180');
  }

