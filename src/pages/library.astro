---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import BottomNav from '../components/BottomNav.astro';
import { characters } from '../data/characters';
import { 
  MessageSquare, 
  Sparkles, 
  Plus, 
  Search, 
  Download, 
  Upload, 
  Trash2, 
  GitBranch, 
  ArrowLeft, 
  ExternalLink, 
  Film, 
  Camera, 
  Clock, 
  ShieldCheck, 
  Bot, 
  User, 
  RefreshCw, 
  FileText, 
  Check,
  Archive
} from '@lucide/astro';
---

<Layout title="Conversations & Storyline Library — Aetheria AI">
  <Header />

  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10 pb-28 sm:pb-16 space-y-6">
    
    <!-- Telegram-Style Elastic Pull-Down Archive Drawer -->
    <div 
      id="archive-reveal-wrapper" 
      class="archive-reveal-drawer w-full overflow-hidden transition-[height,opacity] duration-200 ease-out select-none"
      style="height: 0px; opacity: 0;"
    >
      <div 
        id="archive-drawer-inner" 
        class="w-full h-14 rounded-2xl bg-gradient-to-r from-amber-500/10 via-amber-500/15 to-amber-500/10 border border-amber-500/25 px-4 flex items-center justify-between cursor-pointer hover:border-amber-500/40 transition-all shadow-lg shadow-amber-950/20 mb-2"
        role="button"
        tabindex="0"
      >
        <div class="flex items-center gap-3">
          <div id="archive-drawer-icon-box" class="w-9 h-9 rounded-xl bg-amber-500/20 border border-amber-500/30 flex items-center justify-center text-amber-400 transition-transform">
            <Archive class="w-5 h-5" />
          </div>
          <div>
            <div class="flex items-center gap-2">
              <span class="text-xs sm:text-sm font-semibold text-amber-200">Archived Chats</span>
              <span id="archive-drawer-badge" class="text-[10px] px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-300 font-mono font-bold">0</span>
            </div>
            <p class="text-[10px] text-amber-400/80">Tap to open hidden conversations</p>
          </div>
        </div>
        <div class="text-amber-400/80 flex items-center gap-1 text-xs font-medium">
          <span>View</span>
          <ArrowLeft class="w-4 h-4 rotate-180" />
        </div>
      </div>
    </div>

    <!-- Clean, Consumer-Grade Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-2.5">
          <button 
            id="archive-back-btn" 
            type="button" 
            class="hidden p-2 rounded-xl bg-white/[0.06] hover:bg-white/10 text-slate-300 hover:text-white transition cursor-pointer" 
            title="Back to Active Chats"
            aria-label="Back to Active Chats"
          >
            <ArrowLeft class="w-5 h-5" />
          </button>
          <h1 id="library-main-title" class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight flex items-center gap-2.5">
            <span id="library-title-text">Chats</span>
            <span id="stat-total-chats" class="text-xs px-2.5 py-0.5 rounded-full bg-white/[0.06] border border-white/[0.1] text-slate-300 font-semibold font-mono">0</span>
          </h1>
        </div>
        <p id="library-subtitle" class="text-xs text-slate-400 mt-1">Your conversations and active roleplay storylines</p>
      </div>

      <!-- Quick Action Buttons: subtle backup & restore & desktop archive toggle -->
      <div class="flex items-center gap-2 self-start sm:self-auto flex-wrap">
        <button 
          id="archive-toggle-btn"
          type="button"
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 border border-amber-500/20 text-amber-300 hover:text-amber-200 text-xs font-medium transition cursor-pointer"
          title="Open Archived Chats"
        >
          <Archive class="w-3.5 h-3.5 text-amber-400" />
          <span>Archived (<span id="archive-header-count">0</span>)</span>
        </button>

        <button 
          id="backup-all-btn"
          type="button" 
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] text-slate-400 hover:text-slate-200 text-xs font-medium transition cursor-pointer"
          title="Backup all chat histories to a JSON file"
        >
          <Download class="w-3.5 h-3.5 text-slate-400" />
          <span>Backup</span>
        </button>

        <label 
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] text-slate-400 hover:text-slate-200 text-xs font-medium transition cursor-pointer"
          title="Restore chat histories from a JSON backup file"
        >
          <Upload class="w-3.5 h-3.5 text-slate-400" />
          <span>Restore</span>
          <input id="restore-input" type="file" accept=".json" class="hidden" />
        </label>
      </div>
    </div>

    <!-- Search & Filter Controls -->
    <div class="space-y-3">
      <!-- Search Input -->
      <div class="relative">
        <Search class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 pointer-events-none" />
        <input 
          id="library-search-input" 
          type="text" 
          placeholder="Search chats, character names, or storylines..." 
          class="w-full pl-11 pr-4 py-2.5 rounded-xl bg-[#16171d] border border-white/[0.08] focus:border-white/30 focus:ring-1 focus:ring-white/20 text-xs sm:text-sm text-slate-200 placeholder:text-slate-500 outline-none transition shadow-sm"
        />
      </div>

      <!-- Filter Pills: nowrap and shrink-0 to prevent truncation -->
      <div class="flex items-center gap-2 overflow-x-auto no-scrollbar pb-1">
        <button type="button" class="lib-filter-pill active px-3.5 py-1.5 rounded-full text-xs font-medium shadow-sm transition cursor-pointer flex items-center gap-1.5 shrink-0 whitespace-nowrap" data-filter="all">
          <MessageSquare class="w-3.5 h-3.5" />
          <span>All Chats</span>
        </button>
        <button type="button" class="lib-filter-pill px-3.5 py-1.5 rounded-full text-xs font-medium transition cursor-pointer flex items-center gap-1.5 shrink-0 whitespace-nowrap" data-filter="custom">
          <User class="w-3.5 h-3.5" />
          <span>Custom Heroes</span>
        </button>
        <button type="button" class="lib-filter-pill px-3.5 py-1.5 rounded-full text-xs font-medium transition cursor-pointer flex items-center gap-1.5 shrink-0 whitespace-nowrap" data-filter="official">
          <ShieldCheck class="w-3.5 h-3.5" />
          <span>Official Champions</span>
        </button>
        <button type="button" class="lib-filter-pill px-3.5 py-1.5 rounded-full text-xs font-medium transition cursor-pointer flex items-center gap-1.5 shrink-0 whitespace-nowrap" data-filter="media">
          <Camera class="w-3.5 h-3.5" />
          <span>With Media</span>
        </button>
      </div>
    </div>

    <!-- Active Conversations Grid (Compact Cards with Gestures) -->
    <div id="conversations-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4">
      <!-- Populated via JavaScript dynamically -->
    </div>

    <!-- Empty State -->
    <div id="library-empty-state" class="hidden text-center py-16 px-4 rounded-2xl bg-[#16171d] border border-white/[0.08] space-y-4">
      <div class="w-14 h-14 rounded-2xl bg-white/[0.04] border border-white/[0.08] flex items-center justify-center mx-auto text-slate-400">
        <MessageSquare class="w-7 h-7" />
      </div>
      <div class="max-w-md mx-auto space-y-1">
        <h3 class="text-base sm:text-lg font-semibold text-white">No active storylines found</h3>
        <p class="text-xs sm:text-sm text-slate-400">
          You haven't chatted with any characters yet or no threads matched your current filter. Choose a champion to begin!
        </p>
      </div>
      <div class="flex items-center justify-center gap-3 pt-2">
        <a 
          href="/" 
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white/[0.08] hover:bg-white/[0.12] border border-white/10 text-white text-xs font-semibold transition"
        >
          <Sparkles class="w-3.5 h-3.5" />
          <span>Explore Champions</span>
        </a>
        <a 
          href="/create" 
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white/[0.05] hover:bg-white/[0.1] text-slate-300 hover:text-white text-xs font-medium transition border border-white/10"
        >
          <Plus class="w-3.5 h-3.5" />
          <span>Create Studio</span>
        </a>
      </div>
    </div>

    <!-- Floating Toast Notification (Undo, Confirmations) -->
    <div id="library-toast-container" class="fixed bottom-20 sm:bottom-10 left-1/2 -translate-x-1/2 z-[9999] pointer-events-none transition-all duration-300 transform translate-y-12 opacity-0">
      <div id="library-toast" class="pointer-events-auto flex items-center gap-3 px-4 py-2.5 rounded-2xl bg-[#1e1f24] text-white border border-white/10 shadow-2xl shadow-black/80 text-xs sm:text-sm">
        <span id="library-toast-icon" class="text-amber-400 flex items-center"></span>
        <span id="library-toast-message" class="text-slate-200 font-medium"></span>
        <button id="library-toast-action" type="button" class="hidden ml-1 px-3 py-1 rounded-xl bg-amber-500/20 hover:bg-amber-500/30 text-amber-300 font-semibold text-xs border border-amber-500/30 transition cursor-pointer">
          Undo
        </button>
      </div>
    </div>

  </main>

  <BottomNav />
</Layout>

<script define:vars={{ initialCharacters: characters }}>
  let activeFilter = 'all';
  let searchQuery = '';
  let allStorylines = [];
  let currentView = 'active'; // 'active' or 'archived'

  // DOM Elements
  const gridEl = document.getElementById('conversations-grid');
  const emptyEl = document.getElementById('library-empty-state');
  const searchInput = document.getElementById('library-search-input');
  const filterPills = document.querySelectorAll('.lib-filter-pill');
  const backupBtn = document.getElementById('backup-all-btn');
  const restoreInput = document.getElementById('restore-input');
  const statChats = document.getElementById('stat-total-chats');
  const mainTitleEl = document.getElementById('library-main-title');
  const titleTextEl = document.getElementById('library-title-text');
  const subtitleEl = document.getElementById('library-subtitle');
  const archiveBackBtn = document.getElementById('archive-back-btn');
  const archiveToggleBtn = document.getElementById('archive-toggle-btn');
  const archiveHeaderCount = document.getElementById('archive-header-count');

  // ICONS SVG map
  const ICONS = {
    sparkles: `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.9 5.8a2 2 0 0 1-1.3 1.3L3 12l5.8 1.9a2 2 0 0 1 1.3 1.3L12 21l1.9-5.8a2 2 0 0 1 1.3-1.3L21 12l-5.8-1.9a2 2 0 0 1-1.3-1.3Z"/></svg>`,
    danger: `<svg class="w-5 h-5 text-rose-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>`,
    clock: `<svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>`,
    trash: `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>`,
    image: `<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>`,
    film: `<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"></rect><line x1="7" y1="2" x2="7" y2="22"></line><line x1="17" y1="2" x2="17" y2="22"></line><line x1="2" y1="12" x2="22" y2="12"></line><line x1="2" y1="7" x2="7" y2="7"></line><line x1="2" y1="17" x2="7" y2="17"></line><line x1="17" y1="17" x2="22" y2="17"></line><line x1="17" y1="7" x2="22" y2="7"></line></svg>`,
    archive: `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="5" x="2" y="3" rx="1"/><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"/><path d="M10 12h4"/></svg>`,
    archiveRestore: `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="5" x="2" y="3" rx="1"/><path d="M4 8v11a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8"/><path d="m9 15 3-3 3 3"/><path d="M12 12v9"/></svg>`,
    undo: `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7v6h6"/><path d="M21 17a9 9 0 0 0-9-9 9 9 0 0 0-6 2.3L3 13"/></svg>`,
    check: `<svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>`
  };

  function escapeHtml(str) {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function cleanTitle(str, fallback = 'Custom Companion') {
    if (!str) return fallback;
    let s = String(str);
    for (let i = 0; i < 3; i++) {
      if (!s.includes('&')) break;
      s = s.replace(/&amp;/gi, '&').replace(/&lt;/gi, '<').replace(/&gt;/gi, '>').replace(/&quot;/gi, '"').replace(/&#39;/gi, "'");
    }
    s = s.replace(/<\/(?:h[1-6]|p|div|li|blockquote)>/gi, '. ').replace(/<br\s*\/?>/gi, '. ');
    s = s.replace(/<[^>]+>/g, ' ');
    s = s.replace(/(^|\s)#{1,6}\s+/g, '$1');
    s = s.replace(/(\*\*|__)(.*?)\1/g, '$2');
    s = s.replace(/(\*|_)(.*?)\1/g, '$2');
    s = s.replace(/~~(.*?)~~/g, '$1');
    s = s.replace(/`([^`]+)`/g, '$1');
    s = s.replace(/<+[a-zA-Z0-9]*$/g, '').replace(/^>+/g, '');
    s = s.replace(/[\r\n\t]+/g, ' ').replace(/\s{2,}/g, ' ').trim();
    if (!s) return fallback;
    if (s.length > 70) s = s.slice(0, 65).trim() + '...';
    return s;
  }

  function parseLastMessage(rawText) {
    if (!rawText) return { cleanDialogue: 'No dialogue exchange yet...' };
    let text = String(rawText);
    text = text.replace(/<details[\s\S]*?<\/details>/gi, '').trim();
    text = text.replace(/<think>[\s\S]*?(?:<\/think>|$)/gi, '').trim();
    text = text.replace(/<thought>[\s\S]*?(?:<\/thought>|$)/gi, '').trim();
    text = text.replace(/!\[([^\]]*)\]\([^)]+\)/g, '').trim();
    text = text.replace(/<\/?[^>]+(>|$)/g, '').trim();
    text = text.replace(/\s+/g, ' ').trim();
    return {
      cleanDialogue: text || 'Story started. Continue the journey...'
    };
  }

  // Modern Clean Dialog Modal
  function showConfirmModal({
    title = 'Confirm Action',
    message = 'Are you sure you want to proceed?',
    confirmText = 'Confirm',
    cancelText = 'Cancel',
    type = 'default',
    icon = ''
  } = {}) {
    return new Promise((resolve) => {
      const isDanger = type === 'danger';
      const isWarning = type === 'warning';
      
      let iconSvg = ICONS.sparkles;
      if (typeof icon === 'string' && icon.startsWith('<svg')) iconSvg = icon;
      else if (icon === 'danger' || isDanger) iconSvg = ICONS.danger;

      const backdrop = document.createElement('div');
      backdrop.className = 'fixed inset-0 z-[100] flex items-center justify-center p-4 bg-black/70 backdrop-blur-md transition-all duration-200 opacity-0';
      
      const modal = document.createElement('div');
      modal.className = 'w-full max-w-sm rounded-3xl bg-[#14151b] border border-white/10 p-6 shadow-2xl space-y-5 transform scale-95 transition-all duration-200';
      
      modal.innerHTML = `
        <div class="flex items-center gap-3.5">
          <div class="w-10 h-10 rounded-2xl ${isDanger ? 'bg-rose-500/15 text-rose-400 border border-rose-500/30' : isWarning ? 'bg-amber-500/15 text-amber-400 border border-amber-500/30' : 'bg-purple-500/15 text-purple-400 border border-purple-500/30'} flex items-center justify-center shrink-0">
            ${iconSvg}
          </div>
          <div>
            <h3 class="text-base font-bold text-white tracking-tight">${escapeHtml(title)}</h3>
            <p class="text-[11px] text-slate-400 mt-0.5">Aetheria Storyline Action</p>
          </div>
        </div>

        <p class="text-xs sm:text-sm text-slate-300 leading-relaxed">${escapeHtml(message)}</p>

        <div class="flex items-center justify-end gap-2.5 pt-2">
          ${cancelText ? `
            <button type="button" class="modal-cancel-btn px-4 py-2 rounded-xl text-xs font-semibold text-slate-400 hover:text-white hover:bg-white/[0.06] transition cursor-pointer">
              ${escapeHtml(cancelText)}
            </button>
          ` : ''}
          <button type="button" class="modal-confirm-btn px-5 py-2 rounded-xl text-xs font-semibold text-white ${isDanger ? 'bg-rose-600 hover:bg-rose-500 shadow-lg shadow-rose-950/40' : 'bg-purple-600 hover:bg-purple-500 shadow-lg shadow-purple-950/40'} transition cursor-pointer">
            ${escapeHtml(confirmText)}
          </button>
        </div>
      `;

      backdrop.appendChild(modal);
      document.body.appendChild(backdrop);

      requestAnimationFrame(() => {
        backdrop.classList.remove('opacity-0');
        modal.classList.remove('scale-95');
        modal.classList.add('scale-100');
      });

      const cleanup = (result) => {
        backdrop.classList.add('opacity-0');
        modal.classList.add('scale-95');
        window.removeEventListener('keydown', onKeyDown);
        setTimeout(() => backdrop.remove(), 200);
        resolve(result);
      };

      modal.querySelector('.modal-confirm-btn')?.addEventListener('click', () => cleanup(true));
      modal.querySelector('.modal-cancel-btn')?.addEventListener('click', () => cleanup(false));
      backdrop.onclick = (e) => {
        if (e.target === backdrop) cleanup(false);
      };

      const onKeyDown = (e) => {
        if (e.key === 'Escape') cleanup(false);
        else if (e.key === 'Enter') cleanup(true);
      };
      window.addEventListener('keydown', onKeyDown);
    });
  }

  function showAlertModal(message, title = 'System Notice', icon = 'info') {
    return showConfirmModal({
      title,
      message,
      confirmText: 'Got It',
      cancelText: '',
      type: 'info',
      icon
    });
  }

  // Toast System with Undo
  let toastTimeout = null;
  function showToast({ message, actionText = '', onAction = null, duration = 4500 }) {
    const container = document.getElementById('library-toast-container');
    const msgEl = document.getElementById('library-toast-message');
    const actionBtn = document.getElementById('library-toast-action');
    const iconEl = document.getElementById('library-toast-icon');
    if (!container || !msgEl) return;

    msgEl.textContent = message;
    if (iconEl) iconEl.innerHTML = ICONS.archive;

    if (actionText && typeof onAction === 'function') {
      actionBtn.textContent = actionText;
      actionBtn.classList.remove('hidden');
      actionBtn.onclick = (e) => {
        e.stopPropagation();
        hideToast();
        onAction();
      };
    } else {
      actionBtn.classList.add('hidden');
      actionBtn.onclick = null;
    }

    container.classList.remove('translate-y-12', 'opacity-0', 'pointer-events-none');
    container.classList.add('translate-y-0', 'opacity-100');

    if (toastTimeout) clearTimeout(toastTimeout);
    toastTimeout = setTimeout(hideToast, duration);
  }

  function hideToast() {
    const container = document.getElementById('library-toast-container');
    if (!container) return;
    container.classList.remove('translate-y-0', 'opacity-100');
    container.classList.add('translate-y-12', 'opacity-0', 'pointer-events-none');
  }

  // Load All Storylines
  function loadStorylines() {
    allStorylines = [];
    let customChars = [];
    try {
      customChars = JSON.parse(localStorage.getItem('aetheria_custom_characters') || '[]');
    } catch {}

    const fullRoster = [...initialCharacters, ...customChars];
    const rosterMap = new Map();
    fullRoster.forEach(c => rosterMap.set(c.id, c));

    // Archived set
    let archivedKeys = new Set();
    try {
      archivedKeys = new Set(JSON.parse(localStorage.getItem('aetheria_archived_chats') || '[]'));
    } catch {}

    // Scan localStorage
    for (let i = 0; i < localStorage.length; i++) {
      const key = localStorage.key(i);
      if (!key) continue;

      if (key.startsWith('aetheria_chat_') && !key.startsWith('aetheria_chat_sessions_')) {
        const remainder = key.replace('aetheria_chat_', '');
        let charId = remainder;
        let sessionId = 'session_default';

        if (remainder.includes('_session_')) {
          const parts = remainder.split('_session_');
          charId = parts[0];
          sessionId = 'session_' + parts[1];
        }

        let conv = [];
        try {
          conv = JSON.parse(localStorage.getItem(key) || '[]');
        } catch {}

        if (conv.length > 0) {
          const char = rosterMap.get(charId) || {
            id: charId,
            name: charId.replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase()),
            title: 'Custom Character',
            avatarUrl: '/avatars/asian_woman.webp',
            isCustom: true
          };

          let branchTitle = 'Main Timeline';
          try {
            const sessionsList = JSON.parse(localStorage.getItem(`aetheria_chat_sessions_${charId}`) || '[]');
            const foundSes = sessionsList.find(s => s.id === sessionId);
            if (foundSes && foundSes.title) branchTitle = foundSes.title;
          } catch {}

          const lastMsg = conv[conv.length - 1];
          const hasImage = conv.some(m => m.mediaType === 'image');
          const hasVideo = conv.some(m => m.mediaType === 'video');

          allStorylines.push({
            storageKey: key,
            charId: charId,
            sessionId: sessionId,
            branchTitle: branchTitle,
            character: char,
            conversation: conv,
            messageCount: conv.length,
            lastMessageText: lastMsg ? lastMsg.text : '',
            lastTimestamp: lastMsg ? (lastMsg.timestamp || 'Recent') : 'Recent',
            hasImage: hasImage,
            hasVideo: hasVideo,
            isCustom: !!char.isCustom,
            isArchived: archivedKeys.has(key)
          });
        }
      }
    }

    allStorylines.sort((a, b) => b.messageCount - a.messageCount);
    updateStats();
    renderGrid();
  }

  function updateStats() {
    const activeCount = allStorylines.filter(s => !s.isArchived).length;
    const archivedCount = allStorylines.filter(s => s.isArchived).length;

    if (statChats) {
      statChats.textContent = currentView === 'archived' ? String(archivedCount) : String(activeCount);
    }

    const drawerBadge = document.getElementById('archive-drawer-badge');
    if (drawerBadge) drawerBadge.textContent = String(archivedCount);

    if (archiveHeaderCount) {
      archiveHeaderCount.textContent = String(archivedCount);
    }
  }

  // Switch View between Active and Archived
  function switchView(view) {
    currentView = view;
    const archiveDrawer = document.getElementById('archive-reveal-wrapper');

    if (view === 'archived') {
      if (titleTextEl) titleTextEl.textContent = 'Archived Chats';
      if (subtitleEl) subtitleEl.textContent = 'Hidden conversations and archived storylines';
      if (archiveBackBtn) archiveBackBtn.classList.remove('hidden');
      if (archiveDrawer) {
        archiveDrawer.style.height = '0px';
        archiveDrawer.style.opacity = '0';
      }
      if (archiveToggleBtn) archiveToggleBtn.classList.add('hidden');
      window.location.hash = '#archived';
    } else {
      if (titleTextEl) titleTextEl.textContent = 'Chats';
      if (subtitleEl) subtitleEl.textContent = 'Your conversations and active roleplay storylines';
      if (archiveBackBtn) archiveBackBtn.classList.add('hidden');
      if (archiveToggleBtn) archiveToggleBtn.classList.remove('hidden');
      if (window.location.hash === '#archived') {
        history.pushState('', document.title, window.location.pathname + window.location.search);
      }
    }

    updateStats();
    renderGrid();
  }

  // Render Grid
  function renderGrid() {
    if (!gridEl) return;
    gridEl.innerHTML = '';

    // Filter by active view (active vs archived)
    let filtered = allStorylines.filter(item => {
      return currentView === 'archived' ? item.isArchived : !item.isArchived;
    });

    // Apply Filter Pills
    if (activeFilter === 'custom') {
      filtered = filtered.filter(item => item.isCustom);
    } else if (activeFilter === 'official') {
      filtered = filtered.filter(item => !item.isCustom);
    } else if (activeFilter === 'media') {
      filtered = filtered.filter(item => item.hasImage || item.hasVideo);
    }

    // Apply Search Query
    if (searchQuery) {
      const q = searchQuery.toLowerCase();
      filtered = filtered.filter(item => {
        return (
          item.character.name.toLowerCase().includes(q) ||
          item.branchTitle.toLowerCase().includes(q) ||
          item.lastMessageText.toLowerCase().includes(q)
        );
      });
    }

    // Empty state
    if (filtered.length === 0) {
      if (emptyEl) {
        emptyEl.classList.remove('hidden');
        const emptyTitle = emptyEl.querySelector('h3');
        const emptyDesc = emptyEl.querySelector('p');
        if (currentView === 'archived') {
          if (emptyTitle) emptyTitle.textContent = 'No archived chats found';
          if (emptyDesc) emptyDesc.textContent = 'You have not archived any conversations yet. Swipe left on any chat card to move it here.';
        } else {
          if (emptyTitle) emptyTitle.textContent = 'No active storylines found';
          if (emptyDesc) emptyDesc.textContent = "You haven't chatted with any characters yet or no threads matched your current filter. Choose a champion to begin!";
        }
      }
      return;
    } else {
      if (emptyEl) emptyEl.classList.add('hidden');
    }

    // Render Cards
    filtered.forEach(item => {
      const char = item.character;
      const isCustom = item.isCustom;
      const chatUrl = isCustom 
        ? `/chat/custom?id=${encodeURIComponent(char.id)}&sessionId=${encodeURIComponent(item.sessionId)}`
        : `/chat/${encodeURIComponent(char.id)}?sessionId=${encodeURIComponent(item.sessionId)}`;

      const parsed = parseLastMessage(item.lastMessageText);

      const wrapper = document.createElement('div');
      wrapper.className = 'chat-card-swipe-container relative overflow-hidden rounded-2xl select-none';
      wrapper.setAttribute('data-key', item.storageKey);

      wrapper.innerHTML = `
        <!-- Left Action: Trash (Revealed on Swipe Right) -->
        <div class="chat-swipe-action-left absolute inset-y-0 left-0 w-full flex items-center justify-start bg-[#e11d48] text-white select-none z-[1]" style="opacity: 0; pointer-events: none;" title="Delete">
          <button type="button" class="chat-swipe-action-btn chat-swipe-btn-left flex flex-col items-center justify-center w-[84px] h-full gap-1 text-white select-none active:opacity-80 transition-transform">
            <div class="chat-swipe-icon-circle w-10 h-10 rounded-full bg-white/20 flex items-center justify-center shadow-inner transition-transform">
              <span class="w-5 h-5 flex items-center justify-center shrink-0 text-white">${ICONS.trash}</span>
            </div>
            <span class="text-[10px] font-semibold uppercase tracking-wider text-white">Delete</span>
          </button>
        </div>

        <!-- Right Action: Archive / Unarchive (Revealed on Swipe Left) -->
        <div class="chat-swipe-action-right absolute inset-y-0 right-0 w-full flex items-center justify-end bg-[#d97706] text-white select-none z-[1]" style="opacity: 0; pointer-events: none;" title="${currentView === 'archived' ? 'Restore' : 'Archive'}">
          <button type="button" class="chat-swipe-action-btn chat-swipe-btn-right flex flex-col items-center justify-center w-[84px] h-full gap-1 text-white select-none active:opacity-80 transition-transform">
            <div class="chat-swipe-icon-circle w-10 h-10 rounded-full bg-white/20 flex items-center justify-center shadow-inner transition-transform">
              <span class="w-5 h-5 flex items-center justify-center shrink-0 text-white">${currentView === 'archived' ? ICONS.archiveRestore : ICONS.archive}</span>
            </div>
            <span class="text-[10px] font-semibold uppercase tracking-wider text-white">${currentView === 'archived' ? 'Restore' : 'Archive'}</span>
          </button>
        </div>

        <!-- Front Card (Z-10) -->
        <div class="chat-card-front chat-history-card relative z-10 w-full rounded-2xl bg-[#15161c] hover:bg-[#191b22] border border-white/[0.08] p-3 sm:p-3.5 flex items-center gap-3 cursor-pointer shadow-sm select-none" role="button" tabindex="0">
          <!-- Avatar: w-12 h-12 -->
          <div class="relative w-12 h-12 rounded-xl overflow-hidden ring-1 ring-white/10 shrink-0 bg-white/[0.04]">
            <img src="${escapeHtml(char.avatarUrl)}" alt="${escapeHtml(char.name)}" class="w-full h-full object-cover" loading="lazy" />
            <span class="absolute bottom-0.5 right-0.5 w-2.5 h-2.5 rounded-full bg-emerald-400 ring-2 ring-[#15161c]"></span>
          </div>

          <!-- Content: Top row + single line narrative snippet -->
          <div class="min-w-0 flex-1 space-y-1">
            <!-- Top Row: Name & Badges on Left, Metrics on Right -->
            <div class="flex items-center justify-between gap-2">
              <div class="flex items-center gap-1.5 min-w-0 truncate">
                <h3 class="chat-card-title text-sm font-semibold text-white truncate">${escapeHtml(cleanTitle(char.name, 'Character'))}</h3>
                ${isCustom ? '<span class="chat-card-custom-badge text-[9px] px-1.5 py-0.2 rounded font-mono shrink-0">Custom</span>' : ''}
                ${item.hasImage ? `<span class="chat-card-media-badge inline-flex items-center text-[10px] px-1 py-0.2 rounded shrink-0" title="Includes Photos">${ICONS.image}</span>` : ''}
              </div>
              
              <!-- Metrics: tiny, single-row string on the top right next to title -->
              <div class="chat-card-metrics text-[10px] text-slate-400 font-mono flex items-center gap-2 shrink-0">
                <span>${item.messageCount} msgs</span>
                <span class="text-slate-600">•</span>
                <span class="flex items-center gap-1">
                  <span class="text-slate-500">${ICONS.clock}</span>
                  ${escapeHtml(item.lastTimestamp)}
                </span>
              </div>
            </div>

            <!-- Narrative Teaser: Tight single line with truncate -->
            <p class="chat-card-teaser text-xs text-slate-300/80 truncate leading-snug italic">
              "${escapeHtml(parsed.cleanDialogue)}"
            </p>
          </div>
        </div>
      `;

      bindCardGestures(wrapper, item, chatUrl);
      gridEl.appendChild(wrapper);
    });
  }

  // Global reference to the currently open/docked card
  let activeDockedCard = null;

  // Global listeners to automatically close any docked card when tapping outside or scrolling
  window.addEventListener('scroll', () => {
    if (activeDockedCard) {
      activeDockedCard.close();
    }
  }, { passive: true });

  document.addEventListener('pointerdown', (e) => {
    if (activeDockedCard && !activeDockedCard.element.contains(e.target)) {
      activeDockedCard.close();
    }
  }, { passive: true });

  // Bind Touch & Mouse Gestures for Swipeable Cards (Telegram & iOS Native Quality)
  function bindCardGestures(wrapper, item, chatUrl) {
    const front = wrapper.querySelector('.chat-card-front');
    const leftAction = wrapper.querySelector('.chat-swipe-action-left');
    const rightAction = wrapper.querySelector('.chat-swipe-action-right');
    const leftBtn = wrapper.querySelector('.chat-swipe-btn-left');
    const rightBtn = wrapper.querySelector('.chat-swipe-btn-right');
    const leftIconCircle = wrapper.querySelector('.chat-swipe-btn-left .chat-swipe-icon-circle');
    const rightIconCircle = wrapper.querySelector('.chat-swipe-btn-right .chat-swipe-icon-circle');

    if (!front) return;

    const SNAP_WIDTH = 84; // Docked action button width in px
    const REVEAL_THRESHOLD = 38; // Drag needed to snap open
    const FULL_SWIPE_THRESHOLD = 170; // Drag needed for automatic full swipe
    const VELOCITY_SNAP_THRESHOLD = 0.32; // px/ms flick to snap open
    const VELOCITY_FULL_SWIPE_THRESHOLD = 1.25; // px/ms fast flick for full swipe
    const DEAD_ZONE = 7; // Lock horizontal vs vertical gesture

    let currentTranslation = 0;
    let dockedState = 0; // 0 = closed, +SNAP_WIDTH = right open (trash), -SNAP_WIDTH = left open (archive)
    let isTracking = false;
    let isSwiping = false;
    let isScrolling = false;
    let hasMoved = false;
    let hasVibratedFull = false;

    let startX = 0;
    let startY = 0;
    let startTranslation = 0;
    let latestClientX = 0;
    let lastMoveX = 0;
    let lastMoveTime = 0;
    let currentVelocityX = 0;
    let rafId = null;

    function animateTo(targetPx, duration = 280) {
      dockedState = targetPx;
      currentTranslation = targetPx;

      front.style.transition = `transform ${duration}ms cubic-bezier(0.18, 0.9, 0.32, 1.08), box-shadow 0.2s ease`;
      front.style.transform = `translate3d(${targetPx}px, 0, 0)`;

      if (targetPx === 0) {
        front.classList.remove('is-docked', 'is-swiping');
        if (activeDockedCard && activeDockedCard.element === wrapper) {
          activeDockedCard = null;
        }
        setTimeout(() => {
          if (dockedState === 0) {
            if (leftAction) {
              leftAction.style.opacity = '0';
              leftAction.style.pointerEvents = 'none';
            }
            if (rightAction) {
              rightAction.style.opacity = '0';
              rightAction.style.pointerEvents = 'none';
            }
            if (leftIconCircle) leftIconCircle.style.transform = 'scale(1)';
            if (rightIconCircle) rightIconCircle.style.transform = 'scale(1)';
          }
        }, duration);
      } else {
        front.classList.remove('is-swiping');
        front.classList.add('is-docked');
        activeDockedCard = {
          element: wrapper,
          close: () => animateTo(0)
        };
        if (targetPx > 0) {
          if (leftAction) {
            leftAction.style.opacity = '1';
            leftAction.style.pointerEvents = 'auto';
          }
          if (rightAction) {
            rightAction.style.opacity = '0';
            rightAction.style.pointerEvents = 'none';
          }
        } else {
          if (rightAction) {
            rightAction.style.opacity = '1';
            rightAction.style.pointerEvents = 'auto';
          }
          if (leftAction) {
            leftAction.style.opacity = '0';
            leftAction.style.pointerEvents = 'none';
          }
        }
      }
    }

    wrapper._dockReset = () => animateTo(0);

    function triggerDeleteAction() {
      dockedState = 0;
      if (activeDockedCard && activeDockedCard.element === wrapper) {
        activeDockedCard = null;
      }
      front.classList.remove('is-docked', 'is-swiping');
      if (navigator.vibrate) {
        try { navigator.vibrate([14, 25]); } catch {}
      }
      front.style.transition = 'transform 0.24s cubic-bezier(0.2, 0.9, 0.3, 1), opacity 0.2s ease';
      front.style.transform = 'translate3d(100%, 0, 0)';
      front.style.opacity = '0';
      handleCardDelete(item, wrapper, front);
    }

    function triggerArchiveAction() {
      dockedState = 0;
      if (activeDockedCard && activeDockedCard.element === wrapper) {
        activeDockedCard = null;
      }
      front.classList.remove('is-docked', 'is-swiping');
      if (navigator.vibrate) {
        try { navigator.vibrate([14, 25]); } catch {}
      }
      front.style.transition = 'transform 0.24s cubic-bezier(0.2, 0.9, 0.3, 1), opacity 0.2s ease';
      front.style.transform = 'translate3d(-100%, 0, 0)';
      front.style.opacity = '0';
      if (currentView === 'archived') {
        handleCardUnarchive(item, wrapper, front);
      } else {
        handleCardArchive(item, wrapper, front);
      }
    }

    leftBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      triggerDeleteAction();
    });

    rightBtn?.addEventListener('click', (e) => {
      e.preventDefault();
      e.stopPropagation();
      triggerArchiveAction();
    });

    function renderSwipeFrame() {
      rafId = null;
      if (!isTracking || !isSwiping) return;

      const dragDelta = latestClientX - startX;
      let targetX = startTranslation + dragDelta;
      const absTarget = Math.abs(targetX);
      const sign = Math.sign(targetX);

      // Continuous asymptotic rubber-band resistance beyond FULL_SWIPE_THRESHOLD
      let computedX = targetX;
      if (absTarget > FULL_SWIPE_THRESHOLD) {
        const overdrag = absTarget - FULL_SWIPE_THRESHOLD;
        const elasticExtra = (overdrag * 0.35) / (1 + overdrag * 0.003);
        computedX = sign * (FULL_SWIPE_THRESHOLD + elasticExtra);
      }

      currentTranslation = computedX;
      front.style.transform = `translate3d(${computedX}px, 0, 0)`;

      const isRightSwipe = computedX > 0;
      const activeAction = isRightSwipe ? leftAction : rightAction;
      const inactiveAction = isRightSwipe ? rightAction : leftAction;
      const activeIconCircle = isRightSwipe ? leftIconCircle : rightIconCircle;
      const inactiveIconCircle = isRightSwipe ? rightIconCircle : leftIconCircle;

      if (activeAction) {
        activeAction.style.opacity = '1';
        activeAction.style.pointerEvents = 'auto';
        activeAction.style.zIndex = '2';
      }
      if (inactiveAction) {
        inactiveAction.style.opacity = '0';
        inactiveAction.style.pointerEvents = 'none';
        inactiveAction.style.zIndex = '1';
      }

      // Haptic tick & icon scale when crossing full-swipe threshold
      if (absTarget >= FULL_SWIPE_THRESHOLD) {
        if (activeIconCircle) activeIconCircle.style.transform = 'scale(1.22)';
        if (!hasVibratedFull) {
          hasVibratedFull = true;
          if (navigator.vibrate) {
            try { navigator.vibrate(14); } catch {}
          }
        }
      } else {
        if (activeIconCircle) {
          const p = Math.min(1, Math.max(0, (absTarget - 25) / (SNAP_WIDTH - 25)));
          activeIconCircle.style.transform = `scale(${0.9 + p * 0.1})`;
        }
        if (absTarget < FULL_SWIPE_THRESHOLD - 25) {
          hasVibratedFull = false;
        }
      }
    }

    function onGestureStart(clientX, clientY) {
      if (rafId) {
        cancelAnimationFrame(rafId);
        rafId = null;
      }

      // Close any other open card before tracking this one
      if (activeDockedCard && activeDockedCard.element !== wrapper) {
        activeDockedCard.close();
      }

      startX = clientX;
      startY = clientY;
      latestClientX = clientX;
      lastMoveX = clientX;
      lastMoveTime = performance.now();
      currentVelocityX = 0;

      startTranslation = dockedState;
      isTracking = true;
      isSwiping = false;
      isScrolling = false;
      hasMoved = false;
      hasVibratedFull = false;

      front.style.transition = 'none';
      front.classList.add('is-swiping');
    }

    function onGestureMove(clientX, clientY, e) {
      if (!isTracking) return;

      latestClientX = clientX;
      const now = performance.now();
      const dt = now - lastMoveTime;
      if (dt > 8) {
        currentVelocityX = (clientX - lastMoveX) / dt;
        lastMoveX = clientX;
        lastMoveTime = now;
      }

      const rawDeltaX = clientX - startX;
      const rawDeltaY = clientY - startY;

      if (!isSwiping && !isScrolling) {
        if (Math.hypot(rawDeltaX, rawDeltaY) < DEAD_ZONE) return;

        if (Math.abs(rawDeltaY) >= Math.abs(rawDeltaX)) {
          isScrolling = true;
          isTracking = false;
          front.classList.remove('is-swiping');
          return;
        } else {
          isSwiping = true;
          startX = clientX - Math.sign(rawDeltaX) * DEAD_ZONE;
        }
      }

      if (isSwiping) {
        if (e && e.cancelable) e.preventDefault();
        hasMoved = true;

        if (!rafId) {
          rafId = requestAnimationFrame(renderSwipeFrame);
        }
      }
    }

    function onGestureEnd() {
      if (!isTracking) return;
      if (rafId) {
        cancelAnimationFrame(rafId);
        rafId = null;
      }
      isTracking = false;

      if (!isSwiping) {
        animateTo(dockedState, 200);
        return;
      }

      isSwiping = false;

      const dragDelta = latestClientX - startX;
      let targetX = startTranslation + dragDelta;
      const absTarget = Math.abs(targetX);
      const sign = Math.sign(targetX);

      // Check Full Swipe commit
      const isFullSwipeByDistance = absTarget >= FULL_SWIPE_THRESHOLD;
      const isFullSwipeByVelocity = Math.abs(currentVelocityX) > VELOCITY_FULL_SWIPE_THRESHOLD && Math.sign(currentVelocityX) === sign;

      if (isFullSwipeByDistance || isFullSwipeByVelocity) {
        if (sign > 0) {
          triggerDeleteAction();
        } else {
          triggerArchiveAction();
        }
        return;
      }

      // Check Snap-to-Reveal Docking
      const isSnapByDistance = absTarget >= REVEAL_THRESHOLD;
      const isSnapByVelocity = Math.abs(currentVelocityX) > VELOCITY_SNAP_THRESHOLD && Math.sign(currentVelocityX) === sign;

      // Check if user was already docked and flicked backwards to close
      const isClosingFlick = dockedState !== 0 && Math.sign(currentVelocityX) !== Math.sign(dockedState) && Math.abs(currentVelocityX) > VELOCITY_SNAP_THRESHOLD;

      if (isClosingFlick || (!isSnapByDistance && !isSnapByVelocity)) {
        animateTo(0);
      } else {
        animateTo(sign * SNAP_WIDTH);
      }
    }

    // Touch events on front card
    front.addEventListener('touchstart', (e) => {
      if (e.touches.length !== 1) return;
      onGestureStart(e.touches[0].clientX, e.touches[0].clientY);
    }, { passive: true });

    window.addEventListener('touchmove', (e) => {
      if (!isTracking) return;
      if (e.touches.length !== 1) return;
      onGestureMove(e.touches[0].clientX, e.touches[0].clientY, e);
    }, { passive: false });

    window.addEventListener('touchend', (e) => {
      if (!isTracking) return;
      onGestureEnd();
    }, { passive: true });

    window.addEventListener('touchcancel', (e) => {
      if (!isTracking) return;
      onGestureEnd();
    }, { passive: true });

    // Mouse drag support for desktop debugging
    let isMouseDown = false;
    front.addEventListener('mousedown', (e) => {
      if (e.button !== 0) return;
      isMouseDown = true;
      onGestureStart(e.clientX, e.clientY);
    });

    window.addEventListener('mousemove', (e) => {
      if (!isMouseDown || !isTracking) return;
      onGestureMove(e.clientX, e.clientY, e);
    });

    window.addEventListener('mouseup', (e) => {
      if (!isMouseDown) return;
      isMouseDown = false;
      if (isTracking) {
        onGestureEnd();
      }
    });

    // Front card tap/click handler
    front.addEventListener('click', (e) => {
      // If card was docked open, any tap on the card front should close it
      if (dockedState !== 0) {
        e.preventDefault();
        e.stopPropagation();
        animateTo(0);
        return;
      }

      // If user dragged during this touch, prevent navigation
      if (hasMoved || Math.abs(currentTranslation) > 6) {
        e.preventDefault();
        e.stopPropagation();
        return;
      }

      window.location.href = chatUrl;
    });

    front.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        window.location.href = chatUrl;
      }
    });
  }

  // Handle Card Deletion
  async function handleCardDelete(item, wrapper, front) {
    const char = item.character;
    const confirmed = await showConfirmModal({
      title: 'Delete Storyline',
      message: `Are you sure you want to delete the "${item.branchTitle}" storyline with ${char.name}?`,
      confirmText: 'Delete Storyline',
      cancelText: 'Cancel',
      icon: 'danger',
      type: 'danger'
    });

    if (confirmed) {
      localStorage.removeItem(item.storageKey);

      try {
        let list = JSON.parse(localStorage.getItem('aetheria_archived_chats') || '[]');
        list = list.filter(k => k !== item.storageKey);
        localStorage.setItem('aetheria_archived_chats', JSON.stringify(list));
      } catch {}

      wrapper.style.transition = 'height 0.25s ease, margin 0.25s ease, opacity 0.25s ease';
      wrapper.style.height = '0px';
      wrapper.style.marginBottom = '0px';
      wrapper.style.opacity = '0';
      wrapper.style.overflow = 'hidden';

      setTimeout(() => {
        loadStorylines();
        showToast({
          message: `Storyline with ${char.name} deleted.`
        });
      }, 250);
    } else {
      if (typeof wrapper._dockReset === 'function') {
        wrapper._dockReset();
      } else {
        front.style.transition = 'transform 0.28s cubic-bezier(0.18, 0.9, 0.32, 1.08), opacity 0.24s ease';
        front.style.transform = 'translate3d(0px, 0, 0)';
        front.style.opacity = '1';
      }
      setTimeout(() => {
        const leftAction = wrapper.querySelector('.chat-swipe-action-left');
        const rightAction = wrapper.querySelector('.chat-swipe-action-right');
        if (leftAction) {
          leftAction.style.opacity = '0';
          leftAction.style.pointerEvents = 'none';
        }
        if (rightAction) {
          rightAction.style.opacity = '0';
          rightAction.style.pointerEvents = 'none';
        }
      }, 280);
    }
  }

  // Handle Card Archive
  function handleCardArchive(item, wrapper, front) {
    wrapper.style.transition = 'height 0.25s ease, margin 0.25s ease, opacity 0.25s ease';
    wrapper.style.height = '0px';
    wrapper.style.marginBottom = '0px';
    wrapper.style.opacity = '0';
    wrapper.style.overflow = 'hidden';

    setTimeout(() => {
      archiveChat(item.storageKey, item.character?.name);
    }, 250);
  }

  // Handle Card Unarchive
  function handleCardUnarchive(item, wrapper, front) {
    wrapper.style.transition = 'height 0.25s ease, margin 0.25s ease, opacity 0.25s ease';
    wrapper.style.height = '0px';
    wrapper.style.marginBottom = '0px';
    wrapper.style.opacity = '0';
    wrapper.style.overflow = 'hidden';

    setTimeout(() => {
      unarchiveChat(item.storageKey, item.character?.name);
    }, 250);
  }

  function archiveChat(storageKey, charName) {
    try {
      const list = JSON.parse(localStorage.getItem('aetheria_archived_chats') || '[]');
      if (!list.includes(storageKey)) {
        list.push(storageKey);
        localStorage.setItem('aetheria_archived_chats', JSON.stringify(list));
      }
    } catch {}

    loadStorylines();

    showToast({
      message: `Chat with ${charName || 'Character'} archived`,
      actionText: 'Undo',
      onAction: () => {
        unarchiveChat(storageKey, charName);
      }
    });
  }

  function unarchiveChat(storageKey, charName) {
    try {
      let list = JSON.parse(localStorage.getItem('aetheria_archived_chats') || '[]');
      list = list.filter(k => k !== storageKey);
      localStorage.setItem('aetheria_archived_chats', JSON.stringify(list));
    } catch {}

    loadStorylines();

    showToast({
      message: `Chat with ${charName || 'Character'} restored`,
      actionText: 'Undo',
      onAction: () => {
        archiveChat(storageKey, charName);
      }
    });
  }

  // Telegram-Style Pull-to-Reveal Pull Handler
  function initTelegramPullArchive() {
    const wrapper = document.getElementById('archive-reveal-wrapper');
    const drawerInner = document.getElementById('archive-drawer-inner');
    const iconBox = document.getElementById('archive-drawer-icon-box');
    if (!wrapper || !drawerInner) return;

    let pullStartY = 0;
    let isPulling = false;
    let pullVibrated = false;
    let currentPullDist = 0;
    let drawerLocked = false;

    window.addEventListener('touchstart', (e) => {
      if (window.scrollY <= 2 && currentView === 'active' && e.touches.length === 1) {
        pullStartY = e.touches[0].clientY;
        isPulling = true;
        pullVibrated = false;
        currentPullDist = 0;
        wrapper.style.transition = 'none';
      }
    }, { passive: true });

    window.addEventListener('touchmove', (e) => {
      if (!isPulling || window.scrollY > 2) return;

      const currentY = e.touches[0].clientY;
      const rawDeltaY = currentY - pullStartY;

      if (rawDeltaY > 0) {
        const pullDist = Math.min(85, rawDeltaY * 0.45);
        currentPullDist = pullDist;

        if (e.cancelable && pullDist > 10) e.preventDefault();

        wrapper.style.height = `${pullDist}px`;
        wrapper.style.opacity = `${Math.min(1, pullDist / 40)}`;

        if (iconBox) {
          const scale = Math.min(1.2, 0.7 + (pullDist / 60) * 0.4);
          iconBox.style.transform = `scale(${scale})`;
        }

        if (pullDist >= 60 && !pullVibrated) {
          if (navigator.vibrate) {
            try { navigator.vibrate(10); } catch {}
          }
          pullVibrated = true;
        }
      }
    }, { passive: false });

    window.addEventListener('touchend', () => {
      if (!isPulling) return;
      isPulling = false;

      if (currentPullDist >= 60) {
        wrapper.style.transition = 'height 0.25s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.2s ease';
        wrapper.style.height = '68px';
        wrapper.style.opacity = '1';
        drawerLocked = true;
      } else {
        wrapper.style.transition = 'height 0.25s ease, opacity 0.2s ease';
        wrapper.style.height = '0px';
        wrapper.style.opacity = '0';
        drawerLocked = false;
      }
      pullVibrated = false;
    }, { passive: true });

    // Collapse when scrolling down
    window.addEventListener('scroll', () => {
      if (drawerLocked && window.scrollY > 20) {
        wrapper.style.transition = 'height 0.25s ease, opacity 0.2s ease';
        wrapper.style.height = '0px';
        wrapper.style.opacity = '0';
        drawerLocked = false;
      }
    }, { passive: true });

    drawerInner.addEventListener('click', () => {
      switchView('archived');
    });

    drawerInner.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        switchView('archived');
      }
    });
  }

  // Backup & Restore
  function backupAllData() {
    const backupObj = {
      meta: {
        app: 'Aetheria AI',
        version: '1.0',
        exportedAt: new Date().toISOString()
      },
      conversations: {},
      sessionsIndexes: {},
      customCharacters: [],
      userPersona: null,
      archivedChats: []
    };

    for (let i = 0; i < localStorage.length; i++) {
      const k = localStorage.key(i);
      if (!k) continue;

      if (k.startsWith('aetheria_chat_') && !k.startsWith('aetheria_chat_sessions_')) {
        try {
          backupObj.conversations[k] = JSON.parse(localStorage.getItem(k) || '[]');
        } catch {}
      } else if (k.startsWith('aetheria_chat_sessions_')) {
        try {
          backupObj.sessionsIndexes[k] = JSON.parse(localStorage.getItem(k) || '[]');
        } catch {}
      } else if (k === 'aetheria_custom_characters') {
        try {
          backupObj.customCharacters = JSON.parse(localStorage.getItem(k) || '[]');
        } catch {}
      } else if (k === 'aetheria_user_persona') {
        try {
          backupObj.userPersona = JSON.parse(localStorage.getItem(k) || '{}');
        } catch {}
      }
    }

    try {
      backupObj.archivedChats = JSON.parse(localStorage.getItem('aetheria_archived_chats') || '[]');
    } catch {}

    const jsonStr = JSON.stringify(backupObj, null, 2);
    const blob = new Blob([jsonStr], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `aetheria_complete_backup_${new Date().toISOString().slice(0, 10)}.json`;
    a.click();
    URL.revokeObjectURL(url);
  }

  function restoreData(file) {
    const reader = new FileReader();
    reader.onload = async (e) => {
      try {
        const data = JSON.parse(e.target?.result);
        if (!data || !data.meta || data.meta.app !== 'Aetheria AI') {
          await showAlertModal('Invalid backup file format. Please select a valid Aetheria JSON backup.', 'File Error');
          return;
        }

        const confirmed = await showConfirmModal({
          title: 'Restore Backup',
          message: 'Restore backup? Existing storylines with identical identifiers will be updated.',
          confirmText: 'Restore Backup',
          cancelText: 'Cancel',
          icon: 'package',
          type: 'warning'
        });
        if (confirmed) {
          if (data.conversations) {
            Object.keys(data.conversations).forEach(k => {
              localStorage.setItem(k, JSON.stringify(data.conversations[k]));
            });
          }
          if (data.sessionsIndexes) {
            Object.keys(data.sessionsIndexes).forEach(k => {
              localStorage.setItem(k, JSON.stringify(data.sessionsIndexes[k]));
            });
          }
          if (data.customCharacters && Array.isArray(data.customCharacters)) {
            localStorage.setItem('aetheria_custom_characters', JSON.stringify(data.customCharacters));
          }
          if (data.userPersona) {
            localStorage.setItem('aetheria_user_persona', JSON.stringify(data.userPersona));
          }
          if (data.archivedChats && Array.isArray(data.archivedChats)) {
            localStorage.setItem('aetheria_archived_chats', JSON.stringify(data.archivedChats));
          }

          await showAlertModal('Backup restored successfully! All data loaded.', 'Success', 'check');
          loadStorylines();
        }
      } catch (err) {
        await showAlertModal('Failed to parse backup file: ' + err.message, 'File Error');
      }
    };
    reader.readAsText(file);
  }

  // Filter pills click
  filterPills.forEach(pill => {
    pill.addEventListener('click', () => {
      filterPills.forEach(p => p.classList.remove('active'));
      pill.classList.add('active');
      activeFilter = pill.getAttribute('data-filter') || 'all';
      renderGrid();
    });
  });

  // Search input live
  searchInput?.addEventListener('input', () => {
    searchQuery = (searchInput.value || '').trim();
    renderGrid();
  });

  // Back button
  archiveBackBtn?.addEventListener('click', () => {
    switchView('active');
  });

  // Archive toggle button
  archiveToggleBtn?.addEventListener('click', () => {
    if (currentView === 'active') {
      switchView('archived');
    } else {
      switchView('active');
    }
  });

  // Hash navigation
  window.addEventListener('hashchange', () => {
    if (window.location.hash === '#archived') {
      if (currentView !== 'archived') switchView('archived');
    } else {
      if (currentView !== 'active') switchView('active');
    }
  });

  // Backup & Restore
  backupBtn?.addEventListener('click', backupAllData);
  restoreInput?.addEventListener('change', (e) => {
    const file = e.target.files?.[0];
    if (file) restoreData(file);
  });

  // Init
  if (window.location.hash === '#archived') {
    currentView = 'archived';
  }
  initTelegramPullArchive();
  loadStorylines();
</script>
