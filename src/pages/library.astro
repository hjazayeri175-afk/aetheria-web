---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import BottomNav from '../components/BottomNav.astro';
import { characters } from '../data/characters';
import { 
  MessageSquare, 
  Sparkles, 
  Plus, 
  Search, 
  Download, 
  Upload, 
  Trash2, 
  GitBranch, 
  ArrowLeft, 
  ExternalLink, 
  Film, 
  Camera, 
  Clock, 
  ShieldCheck, 
  Bot, 
  User, 
  RefreshCw, 
  FileText, 
  Check 
} from '@lucide/astro';
---

<Layout title="Conversations & Storyline Library — Aetheria AI">
  <Header />

  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10 pb-28 sm:pb-16 space-y-8">
    
    <!-- Clean, Consumer-Grade Header -->
    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4">
      <div>
        <div class="flex items-center gap-2.5">
          <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight">Chats</h1>
          <span id="stat-total-chats" class="text-xs px-2.5 py-0.5 rounded-full bg-purple-500/15 border border-purple-500/30 text-purple-300 font-semibold font-mono">0</span>
        </div>
        <p class="text-xs text-slate-400 mt-1">Your conversations and active roleplay storylines</p>
      </div>

      <!-- Quick Action Buttons -->
      <div class="flex items-center gap-2 self-start sm:self-auto">
        <button 
          id="backup-all-btn"
          type="button" 
          class="flex items-center gap-2 px-3.5 py-2 rounded-full bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] text-slate-300 hover:text-white text-xs font-medium transition cursor-pointer"
          title="Backup all chat histories to a JSON file"
        >
          <Download class="w-3.5 h-3.5 text-purple-400" />
          <span class="hidden sm:inline">Backup Data</span>
          <span class="sm:hidden">Backup</span>
        </button>

        <label 
          class="flex items-center gap-2 px-3.5 py-2 rounded-full bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] text-slate-300 hover:text-white text-xs font-medium transition cursor-pointer"
          title="Restore chat histories from a JSON backup file"
        >
          <Upload class="w-3.5 h-3.5 text-cyan-400" />
          <span class="hidden sm:inline">Restore</span>
          <span class="sm:hidden">Restore</span>
          <input id="restore-input" type="file" accept=".json" class="hidden" />
        </label>

        <a 
          href="/" 
          class="flex items-center gap-2 px-4 py-2 rounded-full bg-gradient-to-r from-purple-600 via-indigo-600 to-purple-600 hover:from-purple-500 hover:to-indigo-500 text-white text-xs font-semibold transition shadow-md shadow-purple-900/30 active:scale-95"
        >
          <Plus class="w-3.5 h-3.5 stroke-[2.5]" />
          <span>New Chat</span>
        </a>
      </div>
    </div>

    <!-- Search & Filter Controls -->
    <div class="space-y-3.5">
      <!-- Search Input -->
      <div class="relative">
        <Search class="absolute left-4 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400 pointer-events-none" />
        <input 
          id="library-search-input" 
          type="text" 
          placeholder="Search chats, character names, or storylines..." 
          class="w-full pl-11 pr-4 py-2.5 rounded-full bg-[#18191e] border border-white/[0.08] focus:border-purple-500/50 focus:ring-2 focus:ring-purple-500/20 text-xs sm:text-sm text-slate-200 placeholder:text-slate-500 outline-none transition shadow-sm"
        />
      </div>

      <!-- Filter Pills -->
      <div class="flex items-center gap-2 overflow-x-auto no-scrollbar pb-1">
        <button type="button" class="lib-filter-pill active px-3.5 py-1.5 rounded-full text-xs font-semibold bg-purple-600/20 text-purple-200 border border-purple-500/40 shadow-sm transition cursor-pointer flex items-center gap-1.5" data-filter="all">
          <MessageSquare class="w-3.5 h-3.5" />
          <span>All Chats</span>
        </button>
        <button type="button" class="lib-filter-pill px-3.5 py-1.5 rounded-full text-xs font-medium bg-white/[0.03] hover:bg-white/[0.06] text-slate-400 hover:text-slate-200 border border-white/[0.06] transition cursor-pointer flex items-center gap-1.5" data-filter="custom">
          <User class="w-3.5 h-3.5" />
          <span>Custom Heroes</span>
        </button>
        <button type="button" class="lib-filter-pill px-3.5 py-1.5 rounded-full text-xs font-medium bg-white/[0.03] hover:bg-white/[0.06] text-slate-400 hover:text-slate-200 border border-white/[0.06] transition cursor-pointer flex items-center gap-1.5" data-filter="official">
          <ShieldCheck class="w-3.5 h-3.5" />
          <span>Official Champions</span>
        </button>
        <button type="button" class="lib-filter-pill px-3.5 py-1.5 rounded-full text-xs font-medium bg-white/[0.03] hover:bg-white/[0.06] text-slate-400 hover:text-slate-200 border border-white/[0.06] transition cursor-pointer flex items-center gap-1.5" data-filter="media">
          <Camera class="w-3.5 h-3.5" />
          <span>With Media</span>
        </button>
      </div>
    </div>

    <!-- Active Conversations Grid -->
    <div id="conversations-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
      <!-- Populated via JavaScript dynamically -->
    </div>

    <!-- Empty State -->
    <div id="library-empty-state" class="hidden text-center py-16 px-4 rounded-[28px] bg-[#18191e] border border-white/[0.08] space-y-4">
      <div class="w-16 h-16 rounded-2xl bg-purple-600/10 border border-purple-500/20 flex items-center justify-center mx-auto text-purple-400">
        <MessageSquare class="w-8 h-8" />
      </div>
      <div class="max-w-md mx-auto space-y-1">
        <h3 class="text-base sm:text-lg font-bold text-white">No active storylines found</h3>
        <p class="text-xs sm:text-sm text-slate-400">
          You haven't chatted with any characters yet or no threads matched your current filter. Choose a champion from the hub or build your own!
        </p>
      </div>
      <div class="flex items-center justify-center gap-3 pt-2">
        <a 
          href="/" 
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-purple-600 hover:bg-purple-500 text-white text-xs font-semibold transition shadow-lg shadow-purple-900/40"
        >
          <Sparkles class="w-3.5 h-3.5" />
          <span>Explore Champions</span>
        </a>
        <a 
          href="/create" 
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-full bg-white/[0.05] hover:bg-white/[0.1] text-slate-300 hover:text-white text-xs font-medium transition border border-white/10"
        >
          <Plus class="w-3.5 h-3.5" />
          <span>Create Studio</span>
        </a>
      </div>
    </div>

  </main>

  <BottomNav />
</Layout>

<script define:vars={{ initialCharacters: characters }}>
  let activeFilter = 'all';
  let searchQuery = '';
  let allStorylines = [];

  // DOM Elements
  const gridEl = document.getElementById('conversations-grid');
  const emptyEl = document.getElementById('library-empty-state');
  const searchInput = document.getElementById('library-search-input');
  const filterPills = document.querySelectorAll('.lib-filter-pill');
  const backupBtn = document.getElementById('backup-all-btn');
  const restoreInput = document.getElementById('restore-input');

  const statChats = document.getElementById('stat-total-chats');
  const statMessages = document.getElementById('stat-total-messages');
  const statChars = document.getElementById('stat-total-chars');
  const statStorage = document.getElementById('stat-storage-size');

  // Load All Storylines
  const ICONS = {
    gitBranch: `<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="6" y1="3" x2="6" y2="15"></line><circle cx="18" cy="6" r="3"></circle><circle cx="6" cy="18" r="3"></circle><path d="M18 9a9 9 0 0 1-9 9"></path></svg>`,
    play: `<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>`,
    fileText: `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path><polyline points="14 2 14 8 20 8"></polyline><line x1="16" y1="13" x2="8" y2="13"></line><line x1="16" y1="17" x2="8" y2="17"></line><polyline points="10 9 9 9 8 9"></polyline></svg>`,
    trash: `<svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="3 6 5 6 21 6"></polyline><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>`,
    image: `<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect><circle cx="8.5" cy="8.5" r="1.5"></circle><polyline points="21 15 16 10 5 21"></polyline></svg>`,
    film: `<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"></rect><line x1="7" y1="2" x2="7" y2="22"></line><line x1="17" y1="2" x2="17" y2="22"></line><line x1="2" y1="12" x2="22" y2="12"></line><line x1="2" y1="7" x2="7" y2="7"></line><line x1="2" y1="17" x2="7" y2="17"></line><line x1="17" y1="17" x2="22" y2="17"></line><line x1="17" y1="7" x2="22" y2="7"></line></svg>`,
    brain: `<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9.5 2A2.5 2.5 0 0 1 12 4.5v15a2.5 2.5 0 0 1-4.96.44 2.5 2.5 0 0 1-2.96-3.08 3 3 0 0 1-.34-5.58 2.5 2.5 0 0 1 1.32-4.24 2.5 2.5 0 0 1 4.44-5.04Z"></path><path d="M14.5 2A2.5 2.5 0 0 0 12 4.5v15a2.5 2.5 0 0 0 4.96.44 2.5 2.5 0 0 0 2.96-3.08 3 3 0 0 0 .34-5.58 2.5 2.5 0 0 0-1.32-4.24 2.5 2.5 0 0 0-4.44-5.04Z"></path></svg>`,
    sparkles: `<svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 3-1.912 5.813a2 2 0 0 1-1.275 1.275L3 12l5.813 1.912a2 2 0 0 1 1.275 1.275L12 21l1.912-5.813a2 2 0 0 1 1.275-1.275L21 12l-5.813-1.912a2 2 0 0 1-1.275-1.275L12 3Z"></path></svg>`,
    clock: `<svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>`,
    check: `<svg class="w-4 h-4 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>`,
    alertTriangle: `<svg class="w-5 h-5 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z"></path><line x1="12" y1="9" x2="12" y2="13"></line><line x1="12" y1="17" x2="12.01" y2="17"></line></svg>`,
    info: `<svg class="w-5 h-5 text-sky-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><path d="M12 16v-4"></path><path d="M12 8h.01"></path></svg>`,
    danger: `<svg class="w-5 h-5 text-rose-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"></path><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"></path><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"></path><line x1="10" y1="11" x2="10" y2="17"></line><line x1="14" y1="11" x2="14" y2="17"></line></svg>`,
    package: `<svg class="w-5 h-5 text-purple-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m7.5 4.27 9 5.15"></path><path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path><path d="m3.3 7 8.7 5 8.7-5"></path><path d="M12 22V12"></path></svg>`
  };

  function escapeHtml(str) {
    if (!str) return '';
    return String(str)
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  function parseLastMessage(rawText) {
    if (!rawText) return { cleanDialogue: 'No dialogue exchange yet...', hasThought: false, thoughtChars: 0 };
    let text = String(rawText);
    let hasThought = false;
    let thoughtChars = 0;

    // 1. Check for <details>...Thought Process...</details>
    const detailsMatch = text.match(/<details[\s\S]*?<\/details>/i);
    if (detailsMatch) {
      hasThought = true;
      const lenMatch = detailsMatch[0].match(/(\d+)\s*chars/i);
      thoughtChars = lenMatch ? parseInt(lenMatch[1], 10) : 0;
      text = text.replace(/<details[\s\S]*?<\/details>/gi, '').trim();
    }

    // 2. Check for <think>...</think>
    const thinkMatch = text.match(/<think>([\s\S]*?)(?:<\/think>|$)/i);
    if (thinkMatch) {
      hasThought = true;
      if (!thoughtChars) thoughtChars = thinkMatch[1].trim().length;
      text = text.replace(/<think>[\s\S]*?(?:<\/think>|$)/gi, '').trim();
    }

    // 3. Check for <thought>...</thought>
    const thoughtMatch = text.match(/<thought>([\s\S]*?)(?:<\/thought>|$)/i);
    if (thoughtMatch) {
      hasThought = true;
      if (!thoughtChars) thoughtChars = thoughtMatch[1].trim().length;
      text = text.replace(/<thought>[\s\S]*?(?:<\/thought>|$)/gi, '').trim();
    }

    // 4. Strip markdown images
    text = text.replace(/!\[([^\]]*)\]\([^)]+\)/g, '').trim();

    // 5. Strip residual HTML tags
    text = text.replace(/<\/?[^>]+(>|$)/g, '').trim();

    if (!text && hasThought) {
      text = 'Internal thought process completed.';
    }

    return {
      cleanDialogue: text || 'No dialogue exchange yet...',
      hasThought,
      thoughtChars
    };
  }

  // Modern Clean Dialog Modal (Google Gemini / Material 3 Dark)
  function showConfirmModal({
    title = 'Confirm Action',
    message = 'Are you sure you want to proceed?',
    confirmText = 'Confirm',
    cancelText = 'Cancel',
    type = 'default',
    icon = ''
  } = {}) {
    return new Promise((resolve) => {
      const isDanger = type === 'danger';
      const isWarning = type === 'warning' || icon === 'rewind';
      
      let iconSvg = ICONS.sparkles;
      if (typeof icon === 'string' && icon.startsWith('<svg')) iconSvg = icon;
      else if (icon === 'danger' || icon === '🗑️' || isDanger) iconSvg = ICONS.danger;
      else if (icon === 'warning' || icon === '⚠️' || isWarning) iconSvg = ICONS.alertTriangle;
      else if (icon === 'info' || icon === 'ℹ️' || type === 'info') iconSvg = ICONS.info;
      else if (icon === 'package' || icon === '📦') iconSvg = ICONS.package;

      const backdrop = document.createElement('div');
      backdrop.className = 'fixed inset-0 z-[10000] flex items-center justify-center p-4 bg-black/65 backdrop-blur-md transition-opacity duration-200 opacity-0';
      
      const modal = document.createElement('div');
      modal.className = 'w-full max-w-[420px] rounded-[28px] bg-[#1e1f24] border border-white/[0.08] p-6 shadow-2xl shadow-black/90 transform scale-95 transition-all duration-200 text-left select-none';

      const iconBadgeClass = isDanger
        ? 'bg-rose-500/10 border border-rose-500/20 text-rose-400'
        : isWarning
        ? 'bg-amber-500/10 border border-amber-500/20 text-amber-400'
        : type === 'info'
        ? 'bg-sky-500/10 border border-sky-500/20 text-sky-400'
        : 'bg-purple-500/10 border border-purple-500/20 text-purple-400';

      const cancelBtnHtml = cancelText ? `
        <button id="modal-btn-cancel" type="button" class="h-10 px-5 rounded-full text-xs font-medium text-slate-300 hover:text-white bg-white/[0.05] hover:bg-white/[0.1] border border-white/[0.08] transition-colors text-center cursor-pointer">
          ${escapeHtml(cancelText)}
        </button>
      ` : '';

      const confirmBtnClass = isDanger
        ? 'bg-rose-600 hover:bg-rose-500 text-white shadow-md shadow-rose-950/40'
        : isWarning
        ? 'bg-amber-600 hover:bg-amber-500 text-white shadow-md shadow-amber-950/40'
        : 'bg-purple-600 hover:bg-purple-500 text-white shadow-md shadow-purple-950/40';

      const cleanConfirmText = confirmText.replace(/^[\p{Emoji}\s]+/u, '');

      modal.innerHTML = `
        <div class="flex items-start gap-4">
          <div class="w-11 h-11 rounded-2xl flex items-center justify-center shrink-0 ${iconBadgeClass}">
            ${iconSvg}
          </div>
          <div class="flex-1 min-w-0 pt-0.5">
            <h3 class="text-base font-semibold text-white tracking-tight">${escapeHtml(title)}</h3>
            <p class="mt-1.5 text-xs text-slate-300/80 leading-relaxed">${escapeHtml(message)}</p>
          </div>
        </div>
        <div class="mt-6 flex items-center justify-end gap-2.5">
          ${cancelBtnHtml}
          <button id="modal-btn-confirm" type="button" class="h-10 px-5 rounded-full text-xs font-semibold shadow-md transition-colors text-center cursor-pointer ${confirmBtnClass}">
            ${escapeHtml(cleanConfirmText)}
          </button>
        </div>
      `;

      backdrop.appendChild(modal);
      document.body.appendChild(backdrop);

      requestAnimationFrame(() => {
        backdrop.classList.remove('opacity-0');
        modal.classList.remove('scale-95');
      });

      const cleanup = (confirmed) => {
        backdrop.classList.add('opacity-0');
        modal.classList.add('scale-95');
        setTimeout(() => backdrop.remove(), 200);
        window.removeEventListener('keydown', onKeyDown);
        resolve(confirmed);
      };

      const confirmBtn = modal.querySelector('#modal-btn-confirm');
      const cancelBtn = modal.querySelector('#modal-btn-cancel');
      if (confirmBtn) confirmBtn.onclick = () => cleanup(true);
      if (cancelBtn) cancelBtn.onclick = () => cleanup(false);
      backdrop.onclick = (e) => {
        if (e.target === backdrop) cleanup(false);
      };

      const onKeyDown = (e) => {
        if (e.key === 'Escape') cleanup(false);
        else if (e.key === 'Enter') cleanup(true);
      };
      window.addEventListener('keydown', onKeyDown);
    });
  }

  function showAlertModal(message, title = 'System Notice', icon = 'info') {
    return showConfirmModal({
      title,
      message,
      confirmText: 'Got It',
      cancelText: '',
      type: 'info',
      icon
    });
  }

  function loadStorylines() {
    allStorylines = [];
    let customChars = [];
    try {
      customChars = JSON.parse(localStorage.getItem('aetheria_custom_characters') || '[]');
    } catch {}

    const fullRoster = [...initialCharacters, ...customChars];
    const rosterMap = new Map();
    fullRoster.forEach(c => rosterMap.set(c.id, c));

    // Scan localStorage for conversation keys
    for (let i = 0; i < localStorage.length; i++) {
      const key = localStorage.key(i);
      if (!key) continue;

      if (key.startsWith('aetheria_chat_') && !key.startsWith('aetheria_chat_sessions_')) {
        // e.g. aetheria_chat_lyra-vance or aetheria_chat_lyra-vance_session_123
        const remainder = key.replace('aetheria_chat_', '');
        let charId = remainder;
        let sessionId = 'session_default';

        if (remainder.includes('_session_')) {
          const parts = remainder.split('_session_');
          charId = parts[0];
          sessionId = 'session_' + parts[1];
        }

        let conv = [];
        try {
          conv = JSON.parse(localStorage.getItem(key) || '[]');
        } catch {}

        if (conv.length > 0) {
          const char = rosterMap.get(charId) || {
            id: charId,
            name: charId.replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase()),
            title: 'Custom Character',
            avatarUrl: '/avatars/asian_woman.webp',
            isCustom: true
          };

          // Get session title from sessions index
          let branchTitle = 'Main Timeline';
          try {
            const sessionsList = JSON.parse(localStorage.getItem(`aetheria_chat_sessions_${charId}`) || '[]');
            const foundSes = sessionsList.find(s => s.id === sessionId);
            if (foundSes && foundSes.title) branchTitle = foundSes.title;
          } catch {}

          const lastMsg = conv[conv.length - 1];
          const hasImage = conv.some(m => m.mediaType === 'image');
          const hasVideo = conv.some(m => m.mediaType === 'video');

          allStorylines.push({
            storageKey: key,
            charId: charId,
            sessionId: sessionId,
            branchTitle: branchTitle,
            character: char,
            conversation: conv,
            messageCount: conv.length,
            lastMessageText: lastMsg ? lastMsg.text : '',
            lastTimestamp: lastMsg ? (lastMsg.timestamp || 'Recent') : 'Recent',
            hasImage: hasImage,
            hasVideo: hasVideo,
            isCustom: !!char.isCustom
          });
        }
      }
    }

    // Sort by latest message
    allStorylines.sort((a, b) => b.messageCount - a.messageCount);
    updateStats();
    renderGrid();
  }

  function updateStats() {
    let totalMsgs = 0;
    const uniqueChars = new Set();

    allStorylines.forEach(s => {
      totalMsgs += s.messageCount;
      uniqueChars.add(s.charId);
    });

    if (statChats) statChats.textContent = allStorylines.length.toString();
    if (statMessages) statMessages.textContent = totalMsgs.toLocaleString();
    if (statChars) statChars.textContent = uniqueChars.size.toString();

    // Calculate approximate local storage footprint
    let totalBytes = 0;
    for (let i = 0; i < localStorage.length; i++) {
      const k = localStorage.key(i);
      if (k && k.startsWith('aetheria_')) {
        totalBytes += (localStorage.getItem(k) || '').length * 2;
      }
    }
    const kb = (totalBytes / 1024).toFixed(1);
    if (statStorage) statStorage.textContent = kb;
  }

  function renderGrid() {
    if (!gridEl) return;
    gridEl.innerHTML = '';

    const filtered = allStorylines.filter(item => {
      // Filter tab
      if (activeFilter === 'custom' && !item.isCustom) return false;
      if (activeFilter === 'official' && item.isCustom) return false;
      if (activeFilter === 'media' && !item.hasImage && !item.hasVideo) return false;

      // Search query
      if (searchQuery) {
        const q = searchQuery.toLowerCase();
        const matchName = item.character.name.toLowerCase().includes(q);
        const matchBranch = item.branchTitle.toLowerCase().includes(q);
        const matchText = (item.lastMessageText || '').toLowerCase().includes(q);
        return matchName || matchBranch || matchText;
      }

      return true;
    });

    if (filtered.length === 0) {
      gridEl.classList.add('hidden');
      emptyEl?.classList.remove('hidden');
      return;
    }

    gridEl.classList.remove('hidden');
    emptyEl?.classList.add('hidden');

    filtered.forEach(item => {
      const char = item.character;
      const card = document.createElement('div');
      card.className = 'group relative flex flex-col justify-between rounded-[26px] bg-[#18191e] border border-white/[0.08] hover:border-purple-500/40 hover:shadow-2xl hover:shadow-black/70 transition-all duration-200 p-4 sm:p-5 overflow-hidden';

      const chatUrl = char.isCustom 
        ? `/chat/custom?charId=${char.id}&sessionId=${item.sessionId}`
        : `/chat/${char.id}?sessionId=${item.sessionId}`;

      const parsed = parseLastMessage(item.lastMessageText);

      card.innerHTML = `
        <div>
          <!-- Card Header -->
          <div class="flex items-start justify-between gap-3 mb-3.5">
            <div class="flex items-center gap-3 min-w-0">
              <div class="relative w-12 h-12 rounded-2xl overflow-hidden ring-1 ring-white/10 shrink-0 bg-white/[0.04]">
                <img src="${escapeHtml(char.avatarUrl)}" alt="${escapeHtml(char.name)}" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" loading="lazy" />
                <span class="absolute bottom-0.5 right-0.5 w-2.5 h-2.5 rounded-full bg-emerald-400 ring-2 ring-[#18191e]"></span>
              </div>
              <div class="min-w-0">
                <div class="flex items-center gap-2">
                  <h3 class="text-sm sm:text-base font-semibold text-white group-hover:text-purple-300 transition line-clamp-1">${escapeHtml(char.name)}</h3>
                  ${char.isCustom ? '<span class="text-[10px] px-2 py-0.5 rounded-full bg-cyan-500/15 text-cyan-300 border border-cyan-500/30 font-medium">Custom</span>' : ''}
                </div>
                <p class="text-xs text-slate-400 font-normal truncate max-w-[170px] sm:max-w-[210px] mt-0.5">${escapeHtml(char.title)}</p>
              </div>
            </div>

            <div class="flex flex-col items-end gap-1.5 shrink-0">
              <span class="text-[11px] text-slate-400 font-mono flex items-center gap-1">
                <span class="text-slate-500">${ICONS.clock}</span>
                ${escapeHtml(item.lastTimestamp)}
              </span>
              <span class="text-[11px] px-2.5 py-0.5 rounded-full bg-white/[0.05] border border-white/[0.08] text-slate-300 font-mono">
                ${item.messageCount} msgs
              </span>
            </div>
          </div>

          <!-- Branch / Timeline Badge -->
          <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/20 text-[11px] text-emerald-300 mb-3 font-mono max-w-full">
            <span class="text-emerald-400 shrink-0">${ICONS.gitBranch}</span>
            <span class="font-medium truncate">${escapeHtml(item.branchTitle)}</span>
          </div>

          <!-- Last Message Snippet -->
          <div class="p-3.5 rounded-2xl bg-[#121316] border border-white/[0.05] text-xs text-slate-300 leading-relaxed mb-3.5 line-clamp-3 select-none flex flex-col justify-center min-h-[72px]">
            ${parsed.hasThought ? `
              <div class="inline-flex items-center gap-1.5 text-[10px] text-purple-300 font-medium mb-1 tracking-wide">
                <span class="text-purple-400">${ICONS.brain}</span>
                <span>Thinking Process (${parsed.thoughtChars ? parsed.thoughtChars + ' chars' : 'active'})</span>
              </div>
            ` : ''}
            <p class="italic text-slate-300/90 line-clamp-2">"${escapeHtml(parsed.cleanDialogue)}"</p>
          </div>

          <!-- Media indicators -->
          <div class="flex items-center gap-2 mb-3.5 text-[11px]">
            ${item.hasImage ? `<span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-purple-500/10 text-purple-300 border border-purple-500/20 font-medium"><span class="text-purple-400">${ICONS.image}</span> Photos</span>` : ''}
            ${item.hasVideo ? `<span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-pink-500/10 text-pink-300 border border-pink-500/20 font-medium"><span class="text-pink-400">${ICONS.film}</span> Video Clips</span>` : ''}
          </div>
        </div>

        <!-- Card Action Footer -->
        <div class="flex items-center justify-between gap-2 pt-3.5 border-t border-white/[0.06]">
          <a 
            href="${chatUrl}" 
            class="flex-1 inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-full bg-gradient-to-r from-purple-600 via-indigo-600 to-purple-600 hover:from-purple-500 hover:to-indigo-500 text-white text-xs font-semibold shadow-md shadow-purple-950/40 transition active:scale-[0.98]"
          >
            <span class="text-purple-200">${ICONS.play}</span>
            <span>Resume Story</span>
          </a>

          <button 
            type="button" 
            class="export-single-md-btn p-2.5 rounded-full bg-white/[0.04] hover:bg-white/[0.08] text-slate-300 hover:text-white border border-white/[0.06] hover:border-white/[0.12] transition cursor-pointer flex items-center justify-center" 
            data-key="${item.storageKey}"
            data-name="${escapeHtml(char.name)}"
            data-branch="${escapeHtml(item.branchTitle)}"
            title="Export Markdown"
            aria-label="Export Markdown"
          >
            ${ICONS.fileText}
          </button>

          <button 
            type="button" 
            class="delete-single-chat-btn p-2.5 rounded-full bg-white/[0.04] hover:bg-rose-500/15 text-slate-400 hover:text-rose-400 border border-white/[0.06] hover:border-rose-500/30 transition cursor-pointer flex items-center justify-center" 
            data-key="${item.storageKey}"
            data-name="${escapeHtml(char.name)}"
            title="Delete Storyline"
            aria-label="Delete Storyline"
          >
            ${ICONS.trash}
          </button>
        </div>
      `;

      // Export single MD handler
      card.querySelector('.export-single-md-btn')?.addEventListener('click', () => {
        exportStorylineToMarkdown(item);
      });

      // Delete single chat handler
      card.querySelector('.delete-single-chat-btn')?.addEventListener('click', async () => {
        const confirmed = await showConfirmModal({
          title: 'Delete Storyline',
          message: `Are you sure you want to delete the "${item.branchTitle}" storyline with ${char.name}?`,
          confirmText: 'Delete Storyline',
          cancelText: 'Cancel',
          icon: 'danger',
          type: 'danger'
        });
        if (confirmed) {
          localStorage.removeItem(item.storageKey);
          loadStorylines();
        }
      });

      gridEl.appendChild(card);
    });
  }

  // Export single conversation to Markdown
  function exportStorylineToMarkdown(item) {
    let md = `# Conversation with ${item.character.name} — ${item.branchTitle}\n\n`;
    md += `*Generated via Aetheria AI Library on ${new Date().toLocaleDateString()}*\n\n---\n\n`;

    item.conversation.forEach(msg => {
      const senderName = msg.sender === 'character' ? item.character.name : 'User';
      md += `### ${senderName} [${msg.timestamp || ''}]\n`;
      if (msg.mediaUrl) {
        md += `![Media](${msg.mediaUrl})\n\n`;
      }
      md += `${msg.text}\n\n`;
    });

    const blob = new Blob([md], { type: 'text/markdown' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${item.character.name.toLowerCase().replace(/\s+/g, '_')}_${item.sessionId}.md`;
    a.click();
    URL.revokeObjectURL(url);
  }

  // Backup all data to JSON
  function backupAllData() {
    const backupObj = {
      meta: {
        app: 'Aetheria AI',
        version: '1.0',
        exportedAt: new Date().toISOString()
      },
      conversations: {},
      sessionsIndexes: {},
      customCharacters: [],
      userPersona: null
    };

    for (let i = 0; i < localStorage.length; i++) {
      const k = localStorage.key(i);
      if (!k) continue;

      if (k.startsWith('aetheria_chat_') && !k.startsWith('aetheria_chat_sessions_')) {
        try {
          backupObj.conversations[k] = JSON.parse(localStorage.getItem(k) || '[]');
        } catch {}
      } else if (k.startsWith('aetheria_chat_sessions_')) {
        try {
          backupObj.sessionsIndexes[k] = JSON.parse(localStorage.getItem(k) || '[]');
        } catch {}
      } else if (k === 'aetheria_custom_characters') {
        try {
          backupObj.customCharacters = JSON.parse(localStorage.getItem(k) || '[]');
        } catch {}
      } else if (k === 'aetheria_user_persona') {
        try {
          backupObj.userPersona = JSON.parse(localStorage.getItem(k) || '{}');
        } catch {}
      }
    }

    const jsonStr = JSON.stringify(backupObj, null, 2);
    const blob = new Blob([jsonStr], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `aetheria_complete_backup_${new Date().toISOString().slice(0, 10)}.json`;
    a.click();
    URL.revokeObjectURL(url);
  }

  // Restore data from JSON
  function restoreData(file) {
    const reader = new FileReader();
    reader.onload = async (e) => {
      try {
        const data = JSON.parse(e.target?.result);
        if (!data || !data.meta || data.meta.app !== 'Aetheria AI') {
          await showAlertModal('Invalid backup file format. Please select a valid Aetheria JSON backup.', 'File Error');
          return;
        }

        const confirmed = await showConfirmModal({
          title: 'Restore Backup',
          message: 'Restore backup? Existing storylines with identical identifiers will be updated.',
          confirmText: 'Restore Backup',
          cancelText: 'Cancel',
          icon: 'package',
          type: 'warning'
        });
        if (confirmed) {
          // Restore conversations
          if (data.conversations) {
            Object.keys(data.conversations).forEach(k => {
              localStorage.setItem(k, JSON.stringify(data.conversations[k]));
            });
          }
          // Restore sessions indexes
          if (data.sessionsIndexes) {
            Object.keys(data.sessionsIndexes).forEach(k => {
              localStorage.setItem(k, JSON.stringify(data.sessionsIndexes[k]));
            });
          }
          // Restore custom characters
          if (data.customCharacters && Array.isArray(data.customCharacters)) {
            localStorage.setItem('aetheria_custom_characters', JSON.stringify(data.customCharacters));
          }
          // Restore user persona
          if (data.userPersona) {
            localStorage.setItem('aetheria_user_persona', JSON.stringify(data.userPersona));
          }

          await showAlertModal('Backup restored successfully! All data loaded.', 'Success', 'check');
          loadStorylines();
        }
      } catch (err) {
        await showAlertModal('Failed to parse backup file: ' + err.message, 'File Error');
      }
    };
    reader.readAsText(file);
  }

  // Filter pills click
  filterPills.forEach(pill => {
    pill.addEventListener('click', () => {
      filterPills.forEach(p => {
        p.className = 'lib-filter-pill px-3.5 py-1.5 rounded-full text-xs font-medium bg-white/[0.03] hover:bg-white/[0.06] text-slate-400 hover:text-slate-200 border border-white/[0.06] transition cursor-pointer flex items-center gap-1.5';
      });
      pill.className = 'lib-filter-pill active px-3.5 py-1.5 rounded-full text-xs font-semibold bg-purple-600/20 text-purple-200 border border-purple-500/40 shadow-sm transition cursor-pointer flex items-center gap-1.5';
      activeFilter = pill.getAttribute('data-filter') || 'all';
      renderGrid();
    });
  });

  // Search input live
  searchInput?.addEventListener('input', () => {
    searchQuery = (searchInput.value || '').trim();
    renderGrid();
  });

  // Backup & Restore
  backupBtn?.addEventListener('click', backupAllData);
  restoreInput?.addEventListener('change', (e) => {
    const file = e.target.files?.[0];
    if (file) restoreData(file);
  });

  // Startup
  loadStorylines();
</script>