---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import BottomNav from '../components/BottomNav.astro';
import { characters } from '../data/characters';
import { 
  MessageSquare, 
  Sparkles, 
  Plus, 
  Search, 
  Download, 
  Upload, 
  Trash2, 
  GitBranch, 
  ArrowLeft, 
  ExternalLink, 
  Film, 
  Camera, 
  Clock, 
  ShieldCheck, 
  Bot, 
  User, 
  RefreshCw, 
  FileText, 
  Check 
} from '@lucide/astro';
---

<Layout title="Conversations & Storyline Library — Aetheria AI">
  <Header />

  <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10 pb-28 sm:pb-16 space-y-8">
    
    <!-- Top Nav / Breadcrumbs -->
    <div class="flex items-center justify-between">
      <div class="flex items-center gap-3">
        <a 
          href="/" 
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] text-slate-300 hover:text-white text-xs font-medium transition active:scale-95"
        >
          <ArrowLeft class="w-3.5 h-3.5 text-purple-400" />
          <span>Back to Hub</span>
        </a>
        <div class="h-4 w-[1px] bg-white/10"></div>
        <span class="text-xs font-semibold text-purple-300 flex items-center gap-1.5">
          <MessageSquare class="w-3.5 h-3.5" />
          <span>Storyline Archives</span>
        </span>
      </div>

      <div class="flex items-center gap-2">
        <a 
          href="/create" 
          class="flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-purple-600/30 hover:bg-purple-600/50 border border-purple-500/40 text-purple-200 hover:text-white text-xs font-bold transition shadow-sm"
        >
          <Plus class="w-3.5 h-3.5 stroke-[2.5]" />
          <span>New Character Studio</span>
        </a>
      </div>
    </div>

    <!-- Hero Header & Stats Strip -->
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-b from-[#0e1227] via-[#090b16] to-[#07080f] border border-purple-500/20 p-6 sm:p-8 shadow-2xl">
      <div class="absolute top-0 right-0 -mt-10 -mr-10 w-96 h-96 bg-purple-600/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute bottom-0 left-1/3 -mb-10 w-80 h-80 bg-indigo-600/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="relative z-10 space-y-6">
        <div class="max-w-3xl space-y-2">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/10 border border-purple-500/20 text-xs font-semibold text-purple-300">
            <Sparkles class="w-3.5 h-3.5 text-purple-400" />
            <span>Persistent Client-Side Memory</span>
          </div>
          <h1 class="text-2xl sm:text-4xl font-extrabold text-white tracking-tight">
            Conversations & Storyline Library
          </h1>
          <p class="text-sm sm:text-base text-slate-400 leading-relaxed">
            Manage your multi-turn chat sessions, branching storylines, and generated visual moments. Everything is saved locally in your browser for zero latency and complete privacy.
          </p>
        </div>

        <!-- 4 Live Stats Metrics -->
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4 pt-2">
          <div class="p-4 rounded-2xl bg-white/[0.03] border border-white/[0.08] backdrop-blur-md">
            <span class="text-[11px] font-medium text-slate-400 block mb-1">Active Storylines</span>
            <div class="flex items-baseline gap-2">
              <span id="stat-total-chats" class="text-2xl sm:text-3xl font-extrabold text-white font-mono">0</span>
              <span class="text-xs text-purple-400 font-medium">Threads</span>
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-white/[0.03] border border-white/[0.08] backdrop-blur-md">
            <span class="text-[11px] font-medium text-slate-400 block mb-1">Exchanged Messages</span>
            <div class="flex items-baseline gap-2">
              <span id="stat-total-messages" class="text-2xl sm:text-3xl font-extrabold text-emerald-400 font-mono">0</span>
              <span class="text-xs text-slate-400">Total</span>
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-white/[0.03] border border-white/[0.08] backdrop-blur-md">
            <span class="text-[11px] font-medium text-slate-400 block mb-1">Characters Contacted</span>
            <div class="flex items-baseline gap-2">
              <span id="stat-total-chars" class="text-2xl sm:text-3xl font-extrabold text-cyan-400 font-mono">0</span>
              <span class="text-xs text-slate-400">Profiles</span>
            </div>
          </div>

          <div class="p-4 rounded-2xl bg-white/[0.03] border border-white/[0.08] backdrop-blur-md">
            <span class="text-[11px] font-medium text-slate-400 block mb-1">Memory Footprint</span>
            <div class="flex items-baseline gap-2">
              <span id="stat-storage-size" class="text-2xl sm:text-3xl font-extrabold text-indigo-300 font-mono">0</span>
              <span class="text-xs text-slate-400">KB</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Filter & Controls Toolbar -->
    <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4 p-4 rounded-2xl bg-[#0a0d1d] border border-white/[0.08]">
      
      <!-- Search Input -->
      <div class="relative flex-1 max-w-md">
        <Search class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" />
        <input 
          id="library-search-input"
          type="text" 
          placeholder="Search storylines, character names, or text..." 
          class="w-full pl-10 pr-4 py-2 rounded-xl bg-white/[0.04] border border-white/[0.08] focus:border-purple-500/60 text-xs sm:text-sm text-slate-200 placeholder:text-slate-500 outline-none transition"
        />
      </div>

      <!-- Filter Pills -->
      <div class="flex flex-wrap items-center gap-1.5 overflow-x-auto no-scrollbar">
        <button type="button" class="lib-filter-pill px-3 py-1.5 rounded-xl text-xs font-semibold bg-purple-600 text-white transition cursor-pointer" data-filter="all">
          All Chats
        </button>
        <button type="button" class="lib-filter-pill px-3 py-1.5 rounded-xl text-xs font-semibold bg-white/[0.04] hover:bg-white/[0.08] text-slate-300 transition cursor-pointer" data-filter="custom">
          Custom Characters
        </button>
        <button type="button" class="lib-filter-pill px-3 py-1.5 rounded-xl text-xs font-semibold bg-white/[0.04] hover:bg-white/[0.08] text-slate-300 transition cursor-pointer" data-filter="official">
          Official Roster
        </button>
        <button type="button" class="lib-filter-pill px-3 py-1.5 rounded-xl text-xs font-semibold bg-white/[0.04] hover:bg-white/[0.08] text-slate-300 transition cursor-pointer" data-filter="media">
          With Media (📷/🎬)
        </button>
      </div>

      <!-- Global Backup & Restore Actions -->
      <div class="flex items-center gap-2 shrink-0">
        <a 
          href="/create"
          class="flex items-center gap-1.5 px-3 py-2 rounded-xl bg-purple-600/20 hover:bg-purple-600/30 border border-purple-500/30 text-purple-300 hover:text-white text-xs font-semibold transition cursor-pointer"
          title="Import Tavern PNG card or create custom character"
        >
          <Sparkles class="w-3.5 h-3.5 text-purple-400" />
          <span class="hidden sm:inline">Import Card / Create</span>
          <span class="sm:hidden">Import</span>
        </a>

        <button 
          id="backup-all-btn"
          type="button" 
          class="flex items-center gap-1.5 px-3 py-2 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] text-slate-300 hover:text-white text-xs font-medium transition cursor-pointer"
          title="Backup all chat histories and personas to a single JSON file"
        >
          <Download class="w-3.5 h-3.5 text-cyan-400" />
          <span class="hidden sm:inline">Backup All (.JSON)</span>
          <span class="sm:hidden">Backup</span>
        </button>

        <label 
          class="flex items-center gap-1.5 px-3 py-2 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] border border-white/[0.08] text-slate-300 hover:text-white text-xs font-medium transition cursor-pointer"
          title="Restore chat histories and personas from a JSON backup file"
        >
          <Upload class="w-3.5 h-3.5 text-purple-400" />
          <span class="hidden sm:inline">Restore</span>
          <input id="restore-input" type="file" accept=".json" class="hidden" />
        </label>
      </div>
    </div>

    <!-- Active Conversations Grid -->
    <div id="conversations-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
      <!-- Populated via JavaScript dynamically -->
    </div>

    <!-- Empty State -->
    <div id="library-empty-state" class="hidden text-center py-16 px-4 rounded-3xl bg-[#090b17] border border-white/[0.06] space-y-4">
      <div class="w-16 h-16 rounded-2xl bg-purple-600/10 border border-purple-500/20 flex items-center justify-center mx-auto text-purple-400">
        <MessageSquare class="w-8 h-8" />
      </div>
      <div class="max-w-md mx-auto space-y-1">
        <h3 class="text-base sm:text-lg font-bold text-white">No active storylines found</h3>
        <p class="text-xs sm:text-sm text-slate-400">
          You haven't chatted with any characters yet or no threads matched your current filter. Choose a champion from the hub or build your own!
        </p>
      </div>
      <div class="flex items-center justify-center gap-3 pt-2">
        <a 
          href="/" 
          class="px-4 py-2 rounded-xl bg-purple-600 hover:bg-purple-500 text-white text-xs font-bold transition shadow-lg shadow-purple-900/40"
        >
          Explore Champions 🌌
        </a>
        <a 
          href="/create" 
          class="px-4 py-2 rounded-xl bg-white/[0.05] hover:bg-white/[0.1] text-slate-300 hover:text-white text-xs font-medium transition border border-white/10"
        >
          Create Studio 🚀
        </a>
      </div>
    </div>

  </main>

  <BottomNav />
</Layout>

<script define:vars={{ initialCharacters: characters }}>
  let activeFilter = 'all';
  let searchQuery = '';
  let allStorylines = [];

  // DOM Elements
  const gridEl = document.getElementById('conversations-grid');
  const emptyEl = document.getElementById('library-empty-state');
  const searchInput = document.getElementById('library-search-input');
  const filterPills = document.querySelectorAll('.lib-filter-pill');
  const backupBtn = document.getElementById('backup-all-btn');
  const restoreInput = document.getElementById('restore-input');

  const statChats = document.getElementById('stat-total-chats');
  const statMessages = document.getElementById('stat-total-messages');
  const statChars = document.getElementById('stat-total-chars');
  const statStorage = document.getElementById('stat-storage-size');

  // Load All Storylines
  function loadStorylines() {
    allStorylines = [];
    let customChars = [];
    try {
      customChars = JSON.parse(localStorage.getItem('aetheria_custom_characters') || '[]');
    } catch {}

    const fullRoster = [...initialCharacters, ...customChars];
    const rosterMap = new Map();
    fullRoster.forEach(c => rosterMap.set(c.id, c));

    // Scan localStorage for conversation keys
    for (let i = 0; i < localStorage.length; i++) {
      const key = localStorage.key(i);
      if (!key) continue;

      if (key.startsWith('aetheria_chat_') && !key.startsWith('aetheria_chat_sessions_')) {
        // e.g. aetheria_chat_lyra-vance or aetheria_chat_lyra-vance_session_123
        const remainder = key.replace('aetheria_chat_', '');
        let charId = remainder;
        let sessionId = 'session_default';

        if (remainder.includes('_session_')) {
          const parts = remainder.split('_session_');
          charId = parts[0];
          sessionId = 'session_' + parts[1];
        }

        let conv = [];
        try {
          conv = JSON.parse(localStorage.getItem(key) || '[]');
        } catch {}

        if (conv.length > 0) {
          const char = rosterMap.get(charId) || {
            id: charId,
            name: charId.replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase()),
            title: 'Custom Character',
            avatarUrl: '/avatars/asian_woman.webp',
            isCustom: true
          };

          // Get session title from sessions index
          let branchTitle = 'Main Timeline';
          try {
            const sessionsList = JSON.parse(localStorage.getItem(`aetheria_chat_sessions_${charId}`) || '[]');
            const foundSes = sessionsList.find(s => s.id === sessionId);
            if (foundSes && foundSes.title) branchTitle = foundSes.title;
          } catch {}

          const lastMsg = conv[conv.length - 1];
          const hasImage = conv.some(m => m.mediaType === 'image');
          const hasVideo = conv.some(m => m.mediaType === 'video');

          allStorylines.push({
            storageKey: key,
            charId: charId,
            sessionId: sessionId,
            branchTitle: branchTitle,
            character: char,
            conversation: conv,
            messageCount: conv.length,
            lastMessageText: lastMsg ? lastMsg.text : '',
            lastTimestamp: lastMsg ? (lastMsg.timestamp || 'Recent') : 'Recent',
            hasImage: hasImage,
            hasVideo: hasVideo,
            isCustom: !!char.isCustom
          });
        }
      }
    }

    // Sort by latest message
    allStorylines.sort((a, b) => b.messageCount - a.messageCount);
    updateStats();
    renderGrid();
  }

  function updateStats() {
    let totalMsgs = 0;
    const uniqueChars = new Set();

    allStorylines.forEach(s => {
      totalMsgs += s.messageCount;
      uniqueChars.add(s.charId);
    });

    if (statChats) statChats.textContent = allStorylines.length.toString();
    if (statMessages) statMessages.textContent = totalMsgs.toLocaleString();
    if (statChars) statChars.textContent = uniqueChars.size.toString();

    // Calculate approximate local storage footprint
    let totalBytes = 0;
    for (let i = 0; i < localStorage.length; i++) {
      const k = localStorage.key(i);
      if (k && k.startsWith('aetheria_')) {
        totalBytes += (localStorage.getItem(k) || '').length * 2;
      }
    }
    const kb = (totalBytes / 1024).toFixed(1);
    if (statStorage) statStorage.textContent = kb;
  }

  function renderGrid() {
    if (!gridEl) return;
    gridEl.innerHTML = '';

    const filtered = allStorylines.filter(item => {
      // Filter tab
      if (activeFilter === 'custom' && !item.isCustom) return false;
      if (activeFilter === 'official' && item.isCustom) return false;
      if (activeFilter === 'media' && !item.hasImage && !item.hasVideo) return false;

      // Search query
      if (searchQuery) {
        const q = searchQuery.toLowerCase();
        const matchName = item.character.name.toLowerCase().includes(q);
        const matchBranch = item.branchTitle.toLowerCase().includes(q);
        const matchText = (item.lastMessageText || '').toLowerCase().includes(q);
        return matchName || matchBranch || matchText;
      }

      return true;
    });

    if (filtered.length === 0) {
      gridEl.classList.add('hidden');
      emptyEl?.classList.remove('hidden');
      return;
    }

    gridEl.classList.remove('hidden');
    emptyEl?.classList.add('hidden');

    filtered.forEach(item => {
      const char = item.character;
      const card = document.createElement('div');
      card.className = 'group relative flex flex-col rounded-3xl bg-[#0c0f20] border border-white/[0.08] hover:border-purple-500/50 hover:shadow-2xl hover:shadow-purple-950/50 transition-all duration-300 p-5 overflow-hidden';

      const chatUrl = char.isCustom 
        ? `/chat/custom?charId=${char.id}&sessionId=${item.sessionId}`
        : `/chat/${char.id}?sessionId=${item.sessionId}`;

      card.innerHTML = `
        <div class="flex items-start justify-between gap-3 mb-3.5">
          <div class="flex items-center gap-3">
            <div class="relative w-12 h-12 rounded-2xl overflow-hidden ring-2 ring-purple-500/30 shrink-0">
              <img src="${char.avatarUrl}" alt="${char.name}" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" loading="lazy" />
              <span class="absolute bottom-0 right-0 w-2.5 h-2.5 rounded-full bg-emerald-400 ring-2 ring-[#0c0f20]"></span>
            </div>
            <div>
              <div class="flex items-center gap-2">
                <h3 class="text-sm sm:text-base font-bold text-white group-hover:text-purple-300 transition line-clamp-1">${char.name}</h3>
                ${char.isCustom ? '<span class="text-[9px] px-1.5 py-0.2 rounded-full bg-purple-500/20 text-purple-300 border border-purple-500/30 font-semibold">Custom</span>' : ''}
              </div>
              <p class="text-xs text-purple-400/80 font-medium truncate max-w-[180px]">${char.title}</p>
            </div>
          </div>

          <div class="flex flex-col items-end gap-1">
            <span class="text-[10px] text-slate-500 font-mono">${item.lastTimestamp}</span>
            <span class="text-[10px] px-2 py-0.5 rounded-lg bg-white/[0.04] border border-white/[0.08] text-slate-300 font-mono">
              ${item.messageCount} msgs
            </span>
          </div>
        </div>

        <!-- Branch / Timeline Badge -->
        <div class="flex items-center gap-1.5 px-2.5 py-1 rounded-xl bg-purple-950/30 border border-purple-500/20 text-[11px] text-purple-300 mb-3 font-mono">
          <span class="text-emerald-400">🌿</span>
          <span class="font-bold truncate">${item.branchTitle}</span>
        </div>

        <!-- Last Message Snippet -->
        <div class="flex-1 p-3 rounded-2xl bg-white/[0.02] border border-white/[0.05] text-xs text-slate-300 leading-relaxed mb-4 line-clamp-3 select-none">
          "${item.lastMessageText || 'No dialogue exchange yet...'}"
        </div>

        <!-- Media indicators -->
        <div class="flex items-center gap-2 mb-4 text-[10px]">
          ${item.hasImage ? '<span class="px-2 py-0.5 rounded-md bg-purple-500/10 text-purple-300 border border-purple-500/20 flex items-center gap-1"><span>📷</span> Photos</span>' : ''}
          ${item.hasVideo ? '<span class="px-2 py-0.5 rounded-md bg-pink-500/10 text-pink-300 border border-pink-500/20 flex items-center gap-1"><span>🎬</span> Video Clips</span>' : ''}
        </div>

        <!-- Card Action Footer -->
        <div class="flex items-center justify-between gap-2 pt-3 border-t border-white/[0.08]">
          <a 
            href="${chatUrl}" 
            class="flex-1 inline-flex items-center justify-center gap-1.5 px-3 py-2 rounded-xl bg-gradient-to-r from-purple-600 to-indigo-600 hover:from-purple-500 hover:to-indigo-500 text-white text-xs font-bold transition shadow-md shadow-purple-900/30 active:scale-95"
          >
            <span>Resume Story 🚀</span>
          </a>

          <button 
            type="button" 
            class="export-single-md-btn p-2 rounded-xl bg-white/[0.04] hover:bg-white/[0.08] text-slate-300 hover:text-white transition cursor-pointer" 
            data-key="${item.storageKey}"
            data-name="${char.name}"
            data-branch="${item.branchTitle}"
            title="Export this conversation to Markdown"
          >
            📄
          </button>

          <button 
            type="button" 
            class="delete-single-chat-btn p-2 rounded-xl bg-white/[0.04] hover:bg-red-500/20 text-slate-400 hover:text-red-400 transition cursor-pointer" 
            data-key="${item.storageKey}"
            data-name="${char.name}"
            title="Delete this storyline"
          >
            🗑️
          </button>
        </div>
      `;

      // Export single MD handler
      card.querySelector('.export-single-md-btn')?.addEventListener('click', () => {
        exportStorylineToMarkdown(item);
      });

      // Delete single chat handler
      card.querySelector('.delete-single-chat-btn')?.addEventListener('click', () => {
        if (confirm(`Delete the "${item.branchTitle}" storyline with ${char.name}?`)) {
          localStorage.removeItem(item.storageKey);
          loadStorylines();
        }
      });

      gridEl.appendChild(card);
    });
  }

  // Export single conversation to Markdown
  function exportStorylineToMarkdown(item) {
    let md = `# Conversation with ${item.character.name} — ${item.branchTitle}\n\n`;
    md += `*Generated via Aetheria AI Library on ${new Date().toLocaleDateString()}*\n\n---\n\n`;

    item.conversation.forEach(msg => {
      const senderName = msg.sender === 'character' ? item.character.name : 'User';
      md += `### ${senderName} [${msg.timestamp || ''}]\n`;
      if (msg.mediaUrl) {
        md += `![Media](${msg.mediaUrl})\n\n`;
      }
      md += `${msg.text}\n\n`;
    });

    const blob = new Blob([md], { type: 'text/markdown' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${item.character.name.toLowerCase().replace(/\s+/g, '_')}_${item.sessionId}.md`;
    a.click();
    URL.revokeObjectURL(url);
  }

  // Backup all data to JSON
  function backupAllData() {
    const backupObj = {
      meta: {
        app: 'Aetheria AI',
        version: '1.0',
        exportedAt: new Date().toISOString()
      },
      conversations: {},
      sessionsIndexes: {},
      customCharacters: [],
      userPersona: null
    };

    for (let i = 0; i < localStorage.length; i++) {
      const k = localStorage.key(i);
      if (!k) continue;

      if (k.startsWith('aetheria_chat_') && !k.startsWith('aetheria_chat_sessions_')) {
        try {
          backupObj.conversations[k] = JSON.parse(localStorage.getItem(k) || '[]');
        } catch {}
      } else if (k.startsWith('aetheria_chat_sessions_')) {
        try {
          backupObj.sessionsIndexes[k] = JSON.parse(localStorage.getItem(k) || '[]');
        } catch {}
      } else if (k === 'aetheria_custom_characters') {
        try {
          backupObj.customCharacters = JSON.parse(localStorage.getItem(k) || '[]');
        } catch {}
      } else if (k === 'aetheria_user_persona') {
        try {
          backupObj.userPersona = JSON.parse(localStorage.getItem(k) || '{}');
        } catch {}
      }
    }

    const jsonStr = JSON.stringify(backupObj, null, 2);
    const blob = new Blob([jsonStr], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `aetheria_complete_backup_${new Date().toISOString().slice(0, 10)}.json`;
    a.click();
    URL.revokeObjectURL(url);
  }

  // Restore data from JSON
  function restoreData(file) {
    const reader = new FileReader();
    reader.onload = (e) => {
      try {
        const data = JSON.parse(e.target?.result);
        if (!data || !data.meta || data.meta.app !== 'Aetheria AI') {
          alert('Invalid backup file. Please select a valid Aetheria AI JSON backup.');
          return;
        }

        if (confirm('Restore backup? Existing storylines with identical names will be updated.')) {
          // Restore conversations
          if (data.conversations) {
            Object.keys(data.conversations).forEach(k => {
              localStorage.setItem(k, JSON.stringify(data.conversations[k]));
            });
          }
          // Restore sessions indexes
          if (data.sessionsIndexes) {
            Object.keys(data.sessionsIndexes).forEach(k => {
              localStorage.setItem(k, JSON.stringify(data.sessionsIndexes[k]));
            });
          }
          // Restore custom characters
          if (data.customCharacters && Array.isArray(data.customCharacters)) {
            localStorage.setItem('aetheria_custom_characters', JSON.stringify(data.customCharacters));
          }
          // Restore user persona
          if (data.userPersona) {
            localStorage.setItem('aetheria_user_persona', JSON.stringify(data.userPersona));
          }

          alert('✅ Backup restored successfully!');
          loadStorylines();
        }
      } catch (err) {
        alert('Failed to parse backup file: ' + err.message);
      }
    };
    reader.readAsText(file);
  }

  // Filter pills click
  filterPills.forEach(pill => {
    pill.addEventListener('click', () => {
      filterPills.forEach(p => {
        p.className = 'lib-filter-pill px-3 py-1.5 rounded-xl text-xs font-semibold bg-white/[0.04] hover:bg-white/[0.08] text-slate-300 transition cursor-pointer';
      });
      pill.className = 'lib-filter-pill px-3 py-1.5 rounded-xl text-xs font-semibold bg-purple-600 text-white transition cursor-pointer';
      activeFilter = pill.getAttribute('data-filter') || 'all';
      renderGrid();
    });
  });

  // Search input live
  searchInput?.addEventListener('input', () => {
    searchQuery = (searchInput.value || '').trim();
    renderGrid();
  });

  // Backup & Restore
  backupBtn?.addEventListener('click', backupAllData);
  restoreInput?.addEventListener('change', (e) => {
    const file = e.target.files?.[0];
    if (file) restoreData(file);
  });

  // Startup
  loadStorylines();
</script>