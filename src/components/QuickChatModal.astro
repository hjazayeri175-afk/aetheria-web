---
import { characters } from '../data/characters';
import { 
  X, 
  Sparkles, 
  Star,
  MessageSquare,
  Share2,
  BookOpen,
  Scroll,
  Pencil,
  ArrowRight
} from '@lucide/astro';
---

<!-- Character Showcase / Profile View Modal -->
<div 
  id="character-showcase-modal"
  class="fixed inset-0 z-50 flex items-end sm:items-center justify-center p-0 sm:p-4 bg-black/85 backdrop-blur-md transition-all duration-300 opacity-0 pointer-events-none"
  role="dialog"
  aria-modal="true"
  aria-labelledby="showcase-name"
>
  <!-- Modal Dialog Container -->
  <div 
    id="showcase-modal-dialog"
    class="w-full max-h-[94vh] sm:max-h-[90vh] rounded-t-3xl sm:rounded-3xl border-t sm:border border-white/[0.12] bg-[#090b16] flex flex-col overflow-hidden shadow-2xl shadow-purple-950/90 transform translate-y-full sm:translate-y-0 sm:scale-95 transition-all duration-300 ease-out sm:max-w-2xl sm:mx-auto"
  >
    <!-- Mobile Pull Drag Bar -->
    <div class="w-12 h-1.5 rounded-full bg-white/20 mx-auto my-2.5 shrink-0 sm:hidden"></div>

    <!-- Modal Header -->
    <header class="px-4 py-3 sm:px-6 sm:py-3.5 border-b border-white/[0.08] bg-[#0c0f20]/95 flex items-center justify-between shrink-0">
      <div class="flex items-center gap-2">
        <span class="text-xs font-bold uppercase tracking-wider text-purple-400 flex items-center gap-1.5">
          <Sparkles class="w-3.5 h-3.5" />
          <span>Character Showcase</span>
        </span>
      </div>

      <div class="flex items-center gap-2">
        <!-- Interactive Star Button -->
        <button 
          type="button"
          id="showcase-star-btn"
          class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 border border-amber-500/30 text-amber-300 text-xs font-semibold transition active:scale-95 cursor-pointer"
          title="Star this character"
        >
          <Star id="showcase-star-icon" class="w-3.5 h-3.5 fill-none text-amber-400 transition" />
          <span id="showcase-star-count">1.2k</span>
        </button>

        <!-- Share Button -->
        <button 
          type="button"
          id="showcase-share-btn"
          class="p-2 rounded-xl bg-white/[0.05] hover:bg-white/[0.1] text-slate-400 hover:text-white transition cursor-pointer"
          title="Share character link"
        >
          <Share2 class="w-4 h-4" />
        </button>

        <!-- Close Button -->
        <button 
          type="button" 
          id="showcase-close-btn"
          class="p-2 rounded-xl bg-white/[0.05] hover:bg-white/[0.1] text-slate-400 hover:text-white transition cursor-pointer"
          aria-label="Close"
        >
          <X class="w-4 h-4" />
        </button>
      </div>
    </header>

    <!-- Scrollable Showcase Body -->
    <div class="flex-1 overflow-y-auto p-4 sm:p-6 space-y-5 custom-scrollbar">
      
      <!-- Hero Banner / Portrait & Identity -->
      <div class="flex flex-col sm:flex-row gap-4 sm:gap-5 items-center sm:items-start bg-white/[0.02] border border-white/[0.06] rounded-2xl p-4 sm:p-5">
        <div class="relative shrink-0 w-28 h-36 sm:w-32 sm:h-40 rounded-2xl overflow-hidden shadow-2xl ring-2 ring-purple-500/30 bg-[#07080e]">
          <img 
            id="showcase-avatar" 
            src="" 
            alt="Character Portrait" 
            class="w-full h-full object-cover object-center"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
        </div>

        <div class="flex-1 text-center sm:text-left min-w-0">
          <div class="flex flex-wrap items-center justify-center sm:justify-start gap-2 mb-1.5">
            <span id="showcase-badge" class="px-2.5 py-0.5 rounded-full bg-purple-500/20 border border-purple-500/30 text-[10px] font-bold text-purple-300">
              Roleplay
            </span>
            <span id="showcase-author" class="text-[11px] text-slate-400 font-medium">
              Created by @Aetheria
            </span>
          </div>

          <h2 id="showcase-name" class="text-xl sm:text-2xl font-black text-white tracking-tight">
            Character Name
          </h2>

          <p id="showcase-title" class="text-xs sm:text-sm font-medium text-purple-400/90 mt-0.5">
            Character Title
          </p>

          <div id="showcase-tags" class="flex flex-wrap items-center justify-center sm:justify-start gap-1.5 mt-3">
            <!-- Dynamic tags -->
          </div>
        </div>
      </div>

      <!-- Description & Story World -->
      <div class="space-y-2">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center gap-1.5">
          <BookOpen class="w-3.5 h-3.5 text-purple-400" />
          <span>Story & World Background</span>
        </h4>
        <div 
          id="showcase-description" 
          class="p-4 rounded-2xl bg-white/[0.03] border border-white/[0.06] text-xs sm:text-sm text-slate-300 leading-relaxed max-h-48 overflow-y-auto whitespace-pre-wrap font-normal"
        >
          Character backstory...
        </div>
      </div>

      <!-- Opening Dialogue / Greeting Preview -->
      <div class="space-y-2">
        <h4 class="text-xs font-bold uppercase tracking-wider text-slate-400 flex items-center gap-1.5">
          <Scroll class="w-3.5 h-3.5 text-amber-400" />
          <span>Opening Scene (First Message)</span>
        </h4>
        <div 
          id="showcase-greeting" 
          class="p-4 rounded-2xl bg-purple-950/20 border border-purple-500/20 text-xs sm:text-sm text-purple-200 italic leading-relaxed"
        >
          "*Glares across the dimly lit room...*"
        </div>
      </div>

    </div>

    <!-- Action Footer: Direct Navigation to Full Chat -->
    <footer class="p-4 sm:p-5 border-t border-white/[0.08] bg-[#0c0f20]/95 flex items-center gap-3 shrink-0">
      <a 
        id="showcase-edit-btn"
        href="#"
        class="hidden px-4 py-3.5 rounded-2xl bg-white/[0.05] hover:bg-white/[0.1] border border-white/10 text-xs font-semibold text-slate-300 hover:text-white transition items-center gap-2"
        title="Edit Character in Studio"
      >
        <Pencil class="w-4 h-4 text-purple-400" />
        <span>Edit</span>
      </a>

      <a 
        id="showcase-start-chat-btn"
        href="#"
        class="flex-1 inline-flex items-center justify-center gap-2 px-6 py-3.5 rounded-2xl bg-gradient-to-r from-purple-600 via-indigo-600 to-purple-600 hover:from-purple-500 hover:to-indigo-500 active:scale-[0.98] text-white font-bold text-sm shadow-xl shadow-purple-950/70 transition duration-300 cursor-pointer"
      >
        <MessageSquare class="w-4 h-4" />
        <span id="showcase-start-btn-label">Start Roleplay / Chat</span>
        <ArrowRight class="w-4 h-4 opacity-70 ml-1" />
      </a>
    </footer>
  </div>
</div>

<!-- Embedded Predefined Characters JSON -->
<script id="predefined-characters-data" type="application/json" set:html={JSON.stringify(characters)} />

<script>
  // DOM Elements
  const showcaseModal = document.getElementById('character-showcase-modal');
  const showcaseDialog = document.getElementById('showcase-modal-dialog');
  const showcaseCloseBtn = document.getElementById('showcase-close-btn');
  const showcaseAvatar = document.getElementById('showcase-avatar') as HTMLImageElement;
  const showcaseBadge = document.getElementById('showcase-badge');
  const showcaseAuthor = document.getElementById('showcase-author');
  const showcaseName = document.getElementById('showcase-name');
  const showcaseTitle = document.getElementById('showcase-title');
  const showcaseTags = document.getElementById('showcase-tags');
  const showcaseDescription = document.getElementById('showcase-description');
  const showcaseGreeting = document.getElementById('showcase-greeting');
  const showcaseStarBtn = document.getElementById('showcase-star-btn');
  const showcaseStarIcon = document.getElementById('showcase-star-icon');
  const showcaseStarCount = document.getElementById('showcase-star-count');
  const showcaseShareBtn = document.getElementById('showcase-share-btn');
  const showcaseStartBtn = document.getElementById('showcase-start-chat-btn') as HTMLAnchorElement;
  const showcaseEditBtn = document.getElementById('showcase-edit-btn') as HTMLAnchorElement;
  const showcaseStartBtnLabel = document.getElementById('showcase-start-btn-label');

  // Predefined characters lookup
  let predefinedChars: any[] = [];
  try {
    const rawData = document.getElementById('predefined-characters-data')?.textContent;
    if (rawData) predefinedChars = JSON.parse(rawData);
  } catch {
    predefinedChars = [];
  }

  let activeCharacter: any = null;

  // Notification Toast Helper
  function showShowcaseToast(msg: string) {
    const toast = document.createElement('div');
    toast.className = 'fixed bottom-6 left-1/2 -translate-x-1/2 z-[60] px-4 py-2 rounded-xl bg-purple-900/90 text-white text-xs font-semibold shadow-2xl backdrop-blur-md border border-purple-500/40 pointer-events-none transition-all duration-300';
    toast.textContent = msg;
    document.body.appendChild(toast);
    setTimeout(() => {
      toast.style.opacity = '0';
      toast.style.transform = 'translate(-50%, 10px)';
      setTimeout(() => toast.remove(), 300);
    }, 2500);
  }

  // Open Showcase Modal
  function openShowcase(charId: string) {
    if (!charId) return;

    // 1. Look in predefined
    let char = predefinedChars.find(c => c.id === charId);

    // 2. Look in custom characters
    if (!char) {
      try {
        const customList = JSON.parse(localStorage.getItem('aetheria_custom_characters') || '[]');
        char = customList.find((c: any) => c.id === charId);
        if (char) char.isCustom = true;
      } catch {}
    }

    if (!char) return;
    activeCharacter = char;

    // Populate visual details
    if (showcaseAvatar) showcaseAvatar.src = char.avatarUrl || '/avatars/default.webp';
    if (showcaseName) showcaseName.textContent = char.name || 'Unknown Character';
    if (showcaseTitle) showcaseTitle.textContent = char.title || 'AI Companion';
    
    if (showcaseBadge) {
      showcaseBadge.textContent = char.isCustom ? 'Custom Creation' : (char.badge || char.category || 'Roleplay');
    }

    if (showcaseAuthor) {
      showcaseAuthor.textContent = char.isCustom ? 'Created by You' : 'Created by @Aetheria';
    }

    // Populate tags
    if (showcaseTags) {
      showcaseTags.innerHTML = '';
      const tags: string[] = char.tags || [char.category || 'Roleplay'];
      tags.forEach((tag: string) => {
        const span = document.createElement('span');
        span.className = 'px-2 py-0.5 rounded-lg bg-white/[0.04] border border-white/5 text-[10px] font-medium text-slate-300';
        span.textContent = `#${tag}`;
        showcaseTags.appendChild(span);
      });
    }

    // Populate description & greeting
    if (showcaseDescription) {
      showcaseDescription.textContent = char.description || char.scenario || 'No detailed background provided.';
    }

    if (showcaseGreeting) {
      showcaseGreeting.textContent = char.greeting || '*Awaits your first message...*';
    }

    // Update Star state
    updateStarUI(char.id);

    // Update Start Chat button
    if (showcaseStartBtn) {
      if (char.isCustom) {
        showcaseStartBtn.href = `/chat/custom?id=${encodeURIComponent(char.id)}`;
      } else {
        showcaseStartBtn.href = `/chat/${encodeURIComponent(char.id)}`;
      }
    }

    if (showcaseStartBtnLabel) {
      showcaseStartBtnLabel.textContent = `Start Roleplay with ${char.name.split(' ')[0]}`;
    }

    // Edit button for custom characters
    if (showcaseEditBtn) {
      if (char.isCustom) {
        showcaseEditBtn.href = `/create?edit=${encodeURIComponent(char.id)}`;
        showcaseEditBtn.classList.remove('hidden');
        showcaseEditBtn.classList.add('inline-flex');
      } else {
        showcaseEditBtn.classList.add('hidden');
        showcaseEditBtn.classList.remove('inline-flex');
      }
    }

    // Animate Modal Open
    showcaseModal?.classList.remove('opacity-0', 'pointer-events-none');
    showcaseModal?.classList.add('opacity-100', 'pointer-events-auto');
    showcaseDialog?.classList.remove('translate-y-full', 'sm:scale-95');
    showcaseDialog?.classList.add('translate-y-0', 'sm:scale-100');
    document.body.style.overflow = 'hidden';
  }

  // Close Showcase Modal
  function closeShowcase() {
    showcaseModal?.classList.add('opacity-0', 'pointer-events-none');
    showcaseModal?.classList.remove('opacity-100', 'pointer-events-auto');
    showcaseDialog?.classList.add('translate-y-full', 'sm:scale-95');
    showcaseDialog?.classList.remove('translate-y-0', 'sm:scale-100');
    document.body.style.overflow = '';
  }

  // Star System
  function updateStarUI(charId: string) {
    const isStarred = localStorage.getItem(`aetheria_starred_${charId}`) === 'true';
    const baseCount = activeCharacter?.chats || 1200;
    const currentCount = isStarred ? baseCount + 1 : baseCount;

    if (showcaseStarCount) {
      showcaseStarCount.textContent = currentCount >= 1000 ? (currentCount / 1000).toFixed(1) + 'k' : String(currentCount);
    }

    if (showcaseStarIcon) {
      if (isStarred) {
        showcaseStarIcon.classList.add('fill-amber-400', 'text-amber-400');
      } else {
        showcaseStarIcon.classList.remove('fill-amber-400');
        showcaseStarIcon.classList.add('fill-none', 'text-amber-400');
      }
    }
  }

  showcaseStarBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (!activeCharacter) return;
    const charId = activeCharacter.id;
    const isStarred = localStorage.getItem(`aetheria_starred_${charId}`) === 'true';

    if (isStarred) {
      localStorage.removeItem(`aetheria_starred_${charId}`);
      updateStarUI(charId);
      showShowcaseToast(`Removed star from ${activeCharacter.name}`);
    } else {
      localStorage.setItem(`aetheria_starred_${charId}`, 'true');
      updateStarUI(charId);
      showShowcaseToast(`⭐ Starred ${activeCharacter.name}! Added to favorites.`);
    }
  });

  // Share Link
  showcaseShareBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (!activeCharacter) return;
    const link = `${window.location.origin}/chat/${activeCharacter.isCustom ? 'custom?id=' + activeCharacter.id : activeCharacter.id}`;
    navigator.clipboard.writeText(link).then(() => {
      showShowcaseToast('📋 Character link copied to clipboard!');
    }).catch(() => {
      showShowcaseToast('Character URL: ' + link);
    });
  });

  // Event Listeners for opening and closing
  showcaseCloseBtn?.addEventListener('click', closeShowcase);

  showcaseModal?.addEventListener('click', (e) => {
    if (e.target === showcaseModal) closeShowcase();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeShowcase();
  });

  // Global Interceptor: Clicks on any character card or "View Profile & Story" button opens the Showcase
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const triggerBtn = target.closest('.open-chat-btn');
    const card = target.closest('.character-card');

    if (triggerBtn) {
      e.stopPropagation();
      e.preventDefault();
      const charId = triggerBtn.getAttribute('data-character-id');
      if (charId) openShowcase(charId);
      return;
    }

    if (card && !target.closest('button') && !target.closest('a')) {
      const charId = card.getAttribute('data-character-id');
      if (charId) openShowcase(charId);
    }
  });
</script>
