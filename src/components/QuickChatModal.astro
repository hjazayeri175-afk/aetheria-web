---
import { 
  X, 
  Sparkles, 
  Star, 
  MessageSquare, 
  Share2, 
  Download,
  ZoomIn,
  BookOpen, 
  Pencil, 
  ArrowRight, 
  Flag,
  Trash,
  Cpu,
  Code,
  ChevronLeft,
  ChevronRight,
  ChevronDown,
  ChevronUp,
  Copy, 
  Check
} from '@lucide/astro';
import { characters } from '../data/characters';
import { 
  decodeHtmlEntities, 
  sanitizeTitle, 
  formatRichDescription, 
  formatRichGreeting,
  cleanPublicDescription,
  estimateTokens,
  extractCardDefinition
} from '../utils/cardFormatter';
---

<!-- Character Showcase Modal (Chub.ai Modern Uncluttered Layout) -->
<div 
  id="character-showcase-modal" 
  class="fixed inset-0 z-50 flex items-end sm:items-center justify-center p-0 sm:p-4 bg-black/80 backdrop-blur-md transition-all duration-300 opacity-0 pointer-events-none"
  role="dialog"
  aria-modal="true"
  aria-labelledby="showcase-name"
>
  <!-- Modal Dialog Container (Full-Screen on Mobile, Centered Modal on Desktop) -->
  <div 
    id="showcase-modal-dialog"
    class="w-full h-[100dvh] sm:h-auto sm:max-h-[86vh] rounded-none sm:rounded-3xl border-0 sm:border border-white/[0.1] bg-[#090b16] flex flex-col overflow-hidden shadow-2xl shadow-purple-950/80 transform translate-y-full sm:translate-y-0 sm:scale-95 transition-all duration-300 ease-out sm:max-w-xl sm:mx-auto"
  >
    <!-- Modal Header -->
    <header class="px-4 py-3 sm:px-5 sm:py-3 border-b border-white/[0.08] bg-[#0c0f20]/95 flex items-center justify-between shrink-0">
      <div class="flex items-center gap-2">
        <span class="text-xs font-bold uppercase tracking-wider text-purple-400/90 flex items-center gap-1.5">
          <Sparkles class="w-3.5 h-3.5 text-purple-400" />
          <span>Character Profile</span>
        </span>
      </div>

      <div class="flex items-center gap-1 sm:gap-1.5">
        <!-- Interactive Star Button -->
        <button 
          type="button"
          id="showcase-star-btn"
          class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl bg-amber-500/10 hover:bg-amber-500/20 border border-amber-500/25 text-amber-300 text-xs font-semibold transition active:scale-95 cursor-pointer"
          title="Star this character"
        >
          <Star id="showcase-star-icon" class="w-3.5 h-3.5 fill-none text-amber-400 transition" />
          <span id="showcase-star-count">1.2k</span>
        </button>

        <!-- Share Button (Native Mobile Share + Fallback) -->
        <button 
          type="button"
          id="showcase-share-btn"
          class="p-2 rounded-xl text-slate-400 hover:text-white hover:bg-white/[0.06] transition cursor-pointer"
          title="Share character link"
        >
          <Share2 class="w-4 h-4" />
        </button>

        <!-- Export & Download Dropdown -->
        <div class="relative">
          <button 
            type="button"
            id="showcase-download-btn"
            class="p-2 rounded-xl text-slate-400 hover:text-cyan-300 hover:bg-cyan-500/10 transition cursor-pointer"
            title="Export & Download Character"
          >
            <Download class="w-4 h-4" />
          </button>
          
          <!-- Download Quick Menu Popover -->
          <div 
            id="showcase-download-menu"
            class="hidden absolute right-0 top-full mt-1.5 w-52 rounded-xl bg-[#0e1222] border border-white/10 shadow-2xl p-1.5 z-40 space-y-1 backdrop-blur-xl"
          >
            <button 
              type="button"
              id="download-json-btn"
              class="w-full flex items-center gap-2.5 px-3 py-2 rounded-lg text-xs font-semibold text-slate-200 hover:text-white hover:bg-white/[0.08] transition text-left cursor-pointer"
            >
              <Code class="w-4 h-4 text-purple-400 shrink-0" />
              <div>
                <div class="font-bold">Download Card (JSON)</div>
                <div class="text-[10px] text-slate-400 font-normal">Tavern V2 Spec</div>
              </div>
            </button>
            <button 
              type="button"
              id="download-png-btn"
              class="w-full flex items-center gap-2.5 px-3 py-2 rounded-lg text-xs font-semibold text-slate-200 hover:text-white hover:bg-white/[0.08] transition text-left cursor-pointer"
            >
              <Sparkles class="w-4 h-4 text-cyan-400 shrink-0" />
              <div>
                <div class="font-bold">Download Image (PNG)</div>
                <div class="text-[10px] text-slate-400 font-normal">Full-size avatar portrait</div>
              </div>
            </button>
          </div>
        </div>

        <!-- Edit Button (custom characters ONLY) -->
        <a 
          id="showcase-edit-btn"
          href="#"
          class="hidden p-2 rounded-xl text-slate-400 hover:text-purple-300 hover:bg-purple-500/10 transition cursor-pointer"
          title="Edit Custom Companion"
        >
          <Pencil class="w-4 h-4" />
        </a>

        <!-- Delete Button (custom characters ONLY) -->
        <button 
          type="button"
          id="showcase-delete-btn"
          class="hidden p-2 rounded-xl text-slate-400 hover:text-rose-400 hover:bg-rose-500/10 transition cursor-pointer"
          title="Delete Custom Companion"
        >
          <Trash class="w-4 h-4" />
        </button>

        <!-- Report Button (Site characters ONLY, hidden on custom) -->
        <button 
          type="button"
          id="showcase-report-btn"
          class="p-2 rounded-xl text-slate-400 hover:text-rose-400 hover:bg-white/[0.06] transition cursor-pointer"
          title="Report character issue"
        >
          <Flag class="w-4 h-4" />
        </button>

        <!-- Close Button -->
        <button 
          type="button" 
          id="showcase-close-btn"
          class="p-2 rounded-xl text-slate-400 hover:text-white hover:bg-white/[0.06] transition cursor-pointer ml-0.5"
          aria-label="Close"
        >
          <X class="w-4 h-4" />
        </button>
      </div>
    </header>

    <!-- Scrollable Showcase Body (Unified Single Scroll Area with Clean Clearance) -->
    <div id="showcase-body" class="flex-1 overflow-y-auto p-4 sm:p-5 space-y-4 custom-scrollbar overscroll-contain pb-6">
      
      <!-- Chub-Style Hero Profile Summary (Open & Breathable) -->
      <div class="space-y-2.5">
        <div class="flex gap-3.5 sm:gap-4 items-start">
          <!-- Portrait Avatar (Click to Zoom Lightbox) -->
          <div 
            id="showcase-avatar-wrapper"
            class="group relative shrink-0 w-20 h-24 sm:w-24 sm:h-28 rounded-2xl overflow-hidden ring-1 ring-white/10 shadow-lg bg-[#07080e] cursor-zoom-in"
            title="Click to enlarge image"
          >
            <img 
              id="showcase-avatar" 
              src="" 
              alt="Character Portrait" 
              class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-300"
            />
            <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 flex items-center justify-center transition-opacity pointer-events-none">
              <ZoomIn class="w-5 h-5 text-white/90 drop-shadow-md" />
            </div>
          </div>

          <!-- Character Identity & Stats -->
          <div class="flex-1 min-w-0">
            <div class="flex flex-wrap items-center gap-1.5 mb-0.5">
              <!-- SFW / NSFW Rating Badge -->
              <span id="showcase-nsfw-badge" class="px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-rose-500/20 text-rose-300 border border-rose-500/30">
                NSFW
              </span>
              <!-- Category Badge -->
              <span id="showcase-badge" class="px-2 py-0.5 rounded text-[10px] font-medium text-slate-300 bg-white/[0.05] border border-white/[0.08]">
                Roleplay
              </span>
              <!-- Author / Creator Attribution -->
              <span id="showcase-author" class="text-[11px] text-slate-400 truncate max-w-[140px] sm:max-w-none">
                By Community Creator
              </span>
            </div>

            <!-- Name -->
            <h2 id="showcase-name" class="text-lg sm:text-xl font-bold text-white tracking-tight leading-snug mt-1">
              Character Name
            </h2>

            <!-- Tagline / Title -->
            <p id="showcase-title" class="text-xs text-purple-300/80 font-normal line-clamp-1 mt-0.5">
              Character Title
            </p>

            <!-- Chub-Style Unified Stats Row -->
            <div class="flex items-center gap-2.5 text-[11px] text-slate-400 mt-2 pt-2 border-t border-white/[0.06]">
              <span class="inline-flex items-center gap-1 text-amber-300 font-semibold">
                <Star class="w-3 h-3 fill-amber-400 text-amber-400" />
                <span id="showcase-rating-val">5.0</span>
              </span>
              <span class="text-slate-600">•</span>
              <span class="inline-flex items-center gap-1">
                <MessageSquare class="w-3 h-3 text-cyan-400" />
                <span id="showcase-chats-count">1.2k</span>
                <span class="text-slate-500">chats</span>
              </span>
              <span class="text-slate-600">•</span>
              <span class="inline-flex items-center gap-1 font-mono text-purple-300">
                <Cpu class="w-3 h-3 text-purple-400" />
                <span id="showcase-tokens-count">~3,474</span>
                <span class="text-slate-500">tokens</span>
              </span>
            </div>
          </div>
        </div>

        <!-- Tags Row with Chub-style +N More Toggle -->
        <div id="showcase-tags-wrapper" class="pt-1">
          <div id="showcase-tags" class="flex flex-wrap items-center gap-1.5">
            <!-- Dynamic tags injected here -->
          </div>
        </div>
      </div>

      <!-- Tab Bar (Clean Text-Only Segmented Control - Standard Mobile UX) -->
      <div class="sticky top-0 z-20 -mx-4 px-4 sm:-mx-5 sm:px-5 py-2 bg-[#090b16]/95 backdrop-blur-md border-b border-white/[0.05]">
        <div class="grid grid-cols-3 gap-1 p-1 rounded-xl bg-[#0c0e1a] border border-white/[0.08]">
          <!-- Tab 1: Description -->
          <button 
            type="button"
            id="showcase-tab-desc"
            class="showcase-tab-btn w-full flex items-center justify-center py-2 px-1 rounded-lg text-xs font-semibold bg-purple-500/20 text-purple-200 border border-purple-500/30 transition cursor-pointer"
            data-tab="desc"
          >
            Description
          </button>

          <!-- Tab 2: Greetings -->
          <button 
            type="button"
            id="showcase-tab-greetings"
            class="showcase-tab-btn w-full flex items-center justify-center gap-1.5 py-2 px-1 rounded-lg text-xs font-medium text-slate-400 hover:text-slate-200 hover:bg-white/[0.03] transition cursor-pointer"
            data-tab="greetings"
          >
            <span>Greetings</span>
            <span id="showcase-greetings-count-badge" class="px-1.5 py-0.5 rounded-full text-[10px] font-mono font-bold bg-cyan-500/20 text-cyan-300 border border-cyan-500/30 shrink-0">
              1
            </span>
          </button>

          <!-- Tab 3: Definition -->
          <button 
            type="button"
            id="showcase-tab-definition"
            class="showcase-tab-btn w-full flex items-center justify-center py-2 px-1 rounded-lg text-xs font-medium text-slate-400 hover:text-slate-200 hover:bg-white/[0.03] transition cursor-pointer"
            data-tab="definition"
          >
            Definition
          </button>
        </div>
      </div>

      <!-- Tab Panels Container -->
      <div class="pt-1">
        
        <!-- Panel 1: Description (Natural Full Story & Lore - No Artificial Clamping) -->
        <div id="showcase-panel-desc" class="showcase-panel space-y-2">
          <div class="relative rounded-2xl bg-white/[0.02] border border-white/[0.06] p-3.5 sm:p-4">
            <div 
              id="showcase-description" 
              class="text-xs sm:text-sm text-slate-200 font-normal leading-relaxed card-rich-content break-words space-y-2"
            >
              Character backstory...
            </div>
          </div>
        </div>

        <!-- Panel 2: Greetings (Opening Scene with Alternate Switcher - Natural Full Display) -->
        <div id="showcase-panel-greetings" class="showcase-panel hidden space-y-2">
          <!-- Alternate Greetings Switcher Bar (Visible when >1 greeting) -->
          <div id="greeting-switcher" class="hidden items-center justify-between p-2.5 rounded-xl bg-purple-950/25 border border-purple-500/20">
            <div class="flex items-center gap-2">
              <span class="text-xs font-bold text-cyan-300">Scenario</span>
              <span id="greeting-index-label" class="text-xs text-slate-300 font-mono font-bold">(1 of 12)</span>
            </div>
            <div class="flex items-center gap-1.5">
              <button 
                type="button" 
                id="greeting-prev-btn" 
                class="p-1.5 rounded-lg bg-white/[0.06] hover:bg-white/[0.12] text-slate-300 hover:text-white transition disabled:opacity-30 disabled:pointer-events-none cursor-pointer"
                title="Previous Greeting"
              >
                <ChevronLeft class="w-4 h-4" />
              </button>
              <button 
                type="button" 
                id="greeting-next-btn" 
                class="p-1.5 rounded-lg bg-white/[0.06] hover:bg-white/[0.12] text-slate-300 hover:text-white transition disabled:opacity-30 disabled:pointer-events-none cursor-pointer"
                title="Next Greeting"
              >
                <ChevronRight class="w-4 h-4" />
              </button>
            </div>
          </div>

          <!-- Greeting Content Box -->
          <div class="relative rounded-2xl bg-white/[0.02] border border-white/[0.06] p-3.5 sm:p-4">
            <div 
              id="showcase-greeting" 
              class="text-xs sm:text-sm text-cyan-200 font-normal leading-relaxed card-rich-content break-words space-y-1.5"
            >
              "*Awaits your first message...*"
            </div>
          </div>
        </div>

        <!-- Panel 3: Definition (Technical Specs / Prompt Architecture) -->
        <div id="showcase-panel-definition" class="showcase-panel hidden space-y-3">
          <!-- Token Metrics Banner -->
          <div class="grid grid-cols-3 gap-2 p-2.5 rounded-xl bg-white/[0.02] border border-white/[0.06] text-center">
            <div class="p-1">
              <div class="text-[10px] text-slate-500 uppercase font-bold tracking-wider">Total Tokens</div>
              <div id="def-total-tokens" class="text-xs sm:text-sm font-mono font-bold text-white mt-0.5">~3,474</div>
            </div>
            <div class="p-1 border-x border-white/[0.06]">
              <div class="text-[10px] text-slate-500 uppercase font-bold tracking-wider">Permanent</div>
              <div id="def-perm-tokens" class="text-xs sm:text-sm font-mono font-bold text-purple-300 mt-0.5">~2,850</div>
            </div>
            <div class="p-1">
              <div class="text-[10px] text-slate-500 uppercase font-bold tracking-wider">Greeting</div>
              <div id="def-greeting-tokens" class="text-xs sm:text-sm font-mono font-bold text-cyan-300 mt-0.5">~624</div>
            </div>
          </div>

          <!-- Personality block -->
          <div id="def-personality-box" class="p-3 rounded-xl bg-[#060813] border border-white/[0.06] space-y-1">
            <div class="flex items-center justify-between text-[11px] font-bold text-purple-300">
              <span>Personality & Behavioral Directives</span>
              <span id="def-personality-token-label" class="text-[10px] font-mono text-slate-500"></span>
            </div>
            <pre id="def-personality-content" class="text-xs text-slate-300 whitespace-pre-wrap font-mono max-h-36 overflow-y-auto custom-scrollbar"></pre>
          </div>

          <!-- Scenario block -->
          <div id="def-scenario-box" class="p-3 rounded-xl bg-[#060813] border border-white/[0.06] space-y-1">
            <div class="flex items-center justify-between text-[11px] font-bold text-cyan-300">
              <span>Scenario & Context</span>
              <span id="def-scenario-token-label" class="text-[10px] font-mono text-slate-500"></span>
            </div>
            <pre id="def-scenario-content" class="text-xs text-slate-300 whitespace-pre-wrap font-mono max-h-36 overflow-y-auto custom-scrollbar"></pre>
          </div>

          <!-- System Prompt block -->
          <div id="def-system-box" class="p-3 rounded-xl bg-[#060813] border border-white/[0.06] space-y-1">
            <div class="flex items-center justify-between text-[11px] font-bold text-amber-300">
              <span>System Prompt & Roleplay Constraints</span>
              <span id="def-system-token-label" class="text-[10px] font-mono text-slate-500"></span>
            </div>
            <pre id="def-system-content" class="text-xs text-slate-300 whitespace-pre-wrap font-mono max-h-36 overflow-y-auto custom-scrollbar"></pre>
          </div>

          <!-- Example Dialogue block -->
          <div id="def-mes-example-box" class="p-3 rounded-xl bg-[#060813] border border-white/[0.06] space-y-1">
            <div class="flex items-center justify-between text-[11px] font-bold text-emerald-300">
              <span>Dialogue Examples (&lt;START&gt;)</span>
              <span id="def-mes-example-token-label" class="text-[10px] font-mono text-slate-500"></span>
            </div>
            <pre id="def-mes-example-content" class="text-xs text-slate-300 whitespace-pre-wrap font-mono max-h-36 overflow-y-auto custom-scrollbar"></pre>
          </div>

          <!-- Copy Prompt Action -->
          <div class="flex justify-end pt-1">
            <button 
              type="button" 
              id="def-copy-btn" 
              class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg bg-white/[0.05] hover:bg-white/[0.1] border border-white/[0.08] text-xs font-semibold text-slate-300 hover:text-white transition cursor-pointer"
            >
              <Copy id="def-copy-icon" class="w-3.5 h-3.5 text-purple-400" />
              <span id="def-copy-text">Copy Character Definition</span>
            </button>
          </div>
        </div>

      </div>

    </div>

    <!-- Action Footer: Full-Width Primary CTA (Clean & Uncluttered) -->
    <footer class="p-3.5 sm:p-4 border-t border-white/[0.08] bg-[#0c0f20]/95 shrink-0">
      <a 
        id="showcase-chat-btn"
        href="#"
        class="w-full flex items-center justify-center gap-2 py-3 px-5 rounded-xl bg-gradient-to-r from-purple-600 via-indigo-600 to-pink-600 hover:from-purple-500 hover:to-pink-500 text-white font-bold text-sm tracking-wide shadow-lg shadow-purple-900/40 hover:shadow-purple-900/60 active:scale-[0.98] transition duration-200 cursor-pointer"
      >
        <Sparkles class="w-4 h-4 text-purple-200 animate-pulse" />
        <span id="showcase-chat-btn-text">Start Roleplay</span>
        <ArrowRight class="w-4 h-4" />
      </a>
    </footer>

  </div>

  <!-- Full-Screen Avatar Lightbox Modal -->
  <div 
    id="showcase-avatar-lightbox" 
    class="fixed inset-0 z-[70] hidden items-center justify-center bg-black/95 backdrop-blur-md p-4 cursor-zoom-out select-none"
  >
    <button 
      type="button" 
      id="lightbox-close-btn" 
      class="absolute top-4 right-4 p-2.5 rounded-full bg-white/10 hover:bg-white/20 text-white transition z-10 cursor-pointer"
      aria-label="Close enlarged avatar"
    >
      <X class="w-6 h-6" />
    </button>
    <img 
      id="lightbox-image" 
      src="" 
      alt="Enlarged Character Avatar" 
      class="max-w-full max-h-[90vh] rounded-2xl object-contain shadow-2xl ring-1 ring-white/20"
    />
  </div>
</div>

<script>
  import { characters } from '../data/characters';
  import { 
    decodeHtmlEntities, 
    sanitizeTitle, 
    formatRichDescription, 
    formatRichGreeting,
    cleanPublicDescription,
    estimateTokens,
    extractCardDefinition
  } from '../utils/cardFormatter';

  // Elements
  const showcaseModal = document.getElementById('character-showcase-modal');
  const showcaseDialog = document.getElementById('showcase-modal-dialog');
  const showcaseBody = document.getElementById('showcase-body');
  const showcaseAvatar = document.getElementById('showcase-avatar') as HTMLImageElement;
  const showcaseBadge = document.getElementById('showcase-badge');
  const showcaseNsfwBadge = document.getElementById('showcase-nsfw-badge');
  const showcaseAuthor = document.getElementById('showcase-author');
  const showcaseName = document.getElementById('showcase-name');
  const showcaseTitle = document.getElementById('showcase-title');
  const showcaseTags = document.getElementById('showcase-tags');
  const showcaseTokensCount = document.getElementById('showcase-tokens-count');
  const showcaseChatsCount = document.getElementById('showcase-chats-count');
  const showcaseRatingVal = document.getElementById('showcase-rating-val');

  // Chub.ai Tabs & Panels
  const tabBtnDesc = document.getElementById('showcase-tab-desc');
  const tabBtnGreetings = document.getElementById('showcase-tab-greetings');
  const tabBtnDefinition = document.getElementById('showcase-tab-definition');
  const panelDesc = document.getElementById('showcase-panel-desc');
  const panelGreetings = document.getElementById('showcase-panel-greetings');
  const panelDefinition = document.getElementById('showcase-panel-definition');
  const greetingsCountBadge = document.getElementById('showcase-greetings-count-badge');

  // Content Panels
  const showcaseDescription = document.getElementById('showcase-description');
  const showcaseGreeting = document.getElementById('showcase-greeting');

  const greetingSwitcher = document.getElementById('greeting-switcher');
  const greetingIndexLabel = document.getElementById('greeting-index-label');
  const greetingPrevBtn = document.getElementById('greeting-prev-btn') as HTMLButtonElement;
  const greetingNextBtn = document.getElementById('greeting-next-btn') as HTMLButtonElement;

  // Definition Elements
  const defTotalTokens = document.getElementById('def-total-tokens');
  const defPermTokens = document.getElementById('def-perm-tokens');
  const defGreetingTokens = document.getElementById('def-greeting-tokens');
  const defPersonalityBox = document.getElementById('def-personality-box');
  const defPersonalityContent = document.getElementById('def-personality-content');
  const defPersonalityTokenLabel = document.getElementById('def-personality-token-label');
  const defScenarioBox = document.getElementById('def-scenario-box');
  const defScenarioContent = document.getElementById('def-scenario-content');
  const defScenarioTokenLabel = document.getElementById('def-scenario-token-label');
  const defSystemBox = document.getElementById('def-system-box');
  const defSystemContent = document.getElementById('def-system-content');
  const defSystemTokenLabel = document.getElementById('def-system-token-label');
  const defMesExampleBox = document.getElementById('def-mes-example-box');
  const defMesExampleContent = document.getElementById('def-mes-example-content');
  const defMesExampleTokenLabel = document.getElementById('def-mes-example-token-label');
  const defCopyBtn = document.getElementById('def-copy-btn');
  const defCopyText = document.getElementById('def-copy-text');

  // Action Buttons
  const showcaseStarBtn = document.getElementById('showcase-star-btn');
  const showcaseStarCount = document.getElementById('showcase-star-count');
  const showcaseStarIcon = document.getElementById('showcase-star-icon');
  const showcaseShareBtn = document.getElementById('showcase-share-btn');
  const showcaseDownloadBtn = document.getElementById('showcase-download-btn');
  const showcaseDownloadMenu = document.getElementById('showcase-download-menu');
  const downloadJsonBtn = document.getElementById('download-json-btn');
  const downloadPngBtn = document.getElementById('download-png-btn');
  const showcaseReportBtn = document.getElementById('showcase-report-btn');
  const showcaseCloseBtn = document.getElementById('showcase-close-btn');
  const showcaseStartBtn = document.getElementById('showcase-chat-btn') as HTMLAnchorElement;
  const showcaseStartBtnLabel = document.getElementById('showcase-chat-btn-text');
  const showcaseEditBtn = document.getElementById('showcase-edit-btn') as HTMLAnchorElement;
  const showcaseDeleteBtn = document.getElementById('showcase-delete-btn') as HTMLButtonElement;

  // Lightbox Elements
  const showcaseAvatarWrapper = document.getElementById('showcase-avatar-wrapper');
  const showcaseAvatarLightbox = document.getElementById('showcase-avatar-lightbox');
  const lightboxImage = document.getElementById('lightbox-image') as HTMLImageElement;
  const lightboxCloseBtn = document.getElementById('lightbox-close-btn');

  // Active State
  let activeCharacter: any = null;
  let currentTags: string[] = [];
  let isTagsExpanded = false;
  let currentGreetings: string[] = [];
  let currentGreetingIndex = 0;
  let activeTab: 'desc' | 'greetings' | 'definition' = 'desc';

  // Helper Toast for Showcase Interactions
  function showShowcaseToast(msg: string) {
    let toast = document.getElementById('showcase-toast');
    if (!toast) {
      toast = document.createElement('div');
      toast.id = 'showcase-toast';
      toast.className = 'fixed bottom-20 left-1/2 -translate-x-1/2 z-[60] px-4 py-2.5 rounded-xl bg-purple-950/90 border border-purple-500/40 text-purple-200 text-xs font-semibold shadow-2xl backdrop-blur-md pointer-events-none transition-all duration-300 opacity-0 translate-y-3';
      document.body.appendChild(toast);
    }
    toast.textContent = msg;
    toast.classList.remove('opacity-0', 'translate-y-3');
    toast.classList.add('opacity-100', 'translate-y-0');
    setTimeout(() => {
      toast?.classList.remove('opacity-100', 'translate-y-0');
      toast?.classList.add('opacity-0', 'translate-y-3');
    }, 2500);
  }

  // Safe Synchronous Clipboard Copy
  function copyTextToClipboard(text: string): boolean {
    let success = false;
    try {
      const textarea = document.createElement('textarea');
      textarea.value = text;
      textarea.setAttribute('readonly', '');
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0.001';
      document.body.appendChild(textarea);
      textarea.focus({ preventScroll: true });
      textarea.select();
      success = document.execCommand('copy');
      document.body.removeChild(textarea);
    } catch {
      success = false;
    }
    if (!success && navigator.clipboard && typeof navigator.clipboard.writeText === 'function') {
      navigator.clipboard.writeText(text).catch(() => {});
      return true;
    }
    return success;
  }

  // Tab Switcher
  function switchTab(tab: 'desc' | 'greetings' | 'definition') {
    activeTab = tab;

    [
      { btn: tabBtnDesc, panel: panelDesc, key: 'desc' },
      { btn: tabBtnGreetings, panel: panelGreetings, key: 'greetings' },
      { btn: tabBtnDefinition, panel: panelDefinition, key: 'definition' }
    ].forEach(({ btn, panel, key }) => {
      if (key === tab) {
        btn?.classList.remove('text-slate-400', 'hover:text-slate-200', 'hover:bg-white/[0.03]');
        btn?.classList.add('bg-purple-500/20', 'text-purple-200', 'border', 'border-purple-500/30', 'font-semibold');
        panel?.classList.remove('hidden');
      } else {
        btn?.classList.remove('bg-purple-500/20', 'text-purple-200', 'border', 'border-purple-500/30', 'font-semibold');
        btn?.classList.add('text-slate-400', 'hover:text-slate-200', 'hover:bg-white/[0.03]');
        panel?.classList.add('hidden');
      }
    });
  }

  tabBtnDesc?.addEventListener('click', () => switchTab('desc'));
  tabBtnGreetings?.addEventListener('click', () => switchTab('greetings'));
  tabBtnDefinition?.addEventListener('click', () => switchTab('definition'));

  // Tags Renderer with Chub-style +N Toggle
  function renderTags(expanded = false) {
    if (!showcaseTags) return;
    showcaseTags.innerHTML = '';
    isTagsExpanded = expanded;

    if (!currentTags || currentTags.length === 0) {
      const emptySpan = document.createElement('span');
      emptySpan.className = 'text-[11px] text-slate-500 italic';
      emptySpan.textContent = 'No tags';
      showcaseTags.appendChild(emptySpan);
      return;
    }

    const limit = 4;
    const shouldTruncate = currentTags.length > limit;
    const visibleTags = expanded || !shouldTruncate ? currentTags : currentTags.slice(0, limit);

    visibleTags.forEach(tag => {
      const cleanTag = tag.replace(/^#/, '');
      const pill = document.createElement('span');
      pill.className = 'px-2 py-0.5 rounded-md bg-white/[0.03] hover:bg-white/[0.06] border border-white/[0.05] text-[10.5px] font-medium text-slate-400';
      pill.textContent = `#${cleanTag}`;
      showcaseTags.appendChild(pill);
    });

    if (shouldTruncate) {
      const toggleBtn = document.createElement('button');
      toggleBtn.type = 'button';
      toggleBtn.className = 'px-2 py-0.5 rounded-md bg-purple-500/10 hover:bg-purple-500/20 border border-purple-500/20 text-[10.5px] font-semibold text-purple-300 transition cursor-pointer';
      toggleBtn.textContent = expanded ? 'Show less' : `+${currentTags.length - limit} more`;
      toggleBtn.addEventListener('click', (e) => {
        e.stopPropagation();
        renderTags(!isTagsExpanded);
      });
      showcaseTags.appendChild(toggleBtn);
    }
  }

  // Greeting Switcher Logic
  function updateGreetingUI() {
    if (!showcaseGreeting) return;

    if (currentGreetings.length <= 1) {
      greetingSwitcher?.classList.add('hidden');
      greetingSwitcher?.classList.remove('flex');
    } else {
      greetingSwitcher?.classList.remove('hidden');
      greetingSwitcher?.classList.add('flex');
      if (greetingIndexLabel) {
        greetingIndexLabel.textContent = `(${currentGreetingIndex + 1} of ${currentGreetings.length})`;
      }
      if (greetingPrevBtn) {
        greetingPrevBtn.disabled = currentGreetingIndex <= 0;
      }
      if (greetingNextBtn) {
        greetingNextBtn.disabled = currentGreetingIndex >= currentGreetings.length - 1;
      }
    }

    const activeGreetingText = currentGreetings[currentGreetingIndex] || '*Awaits your first message...*';
    showcaseGreeting.innerHTML = formatRichGreeting(activeGreetingText, activeCharacter?.name);
  }

  greetingPrevBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (currentGreetingIndex > 0) {
      currentGreetingIndex--;
      updateGreetingUI();
    }
  });

  greetingNextBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (currentGreetingIndex < currentGreetings.length - 1) {
      currentGreetingIndex++;
      updateGreetingUI();
    }
  });

  // Definition Tab UI Builder
  function updateDefinitionUI(char: any) {
    const def = extractCardDefinition(char);

    // Format tokens strictly in English digits for UI consistency
    const totalTokensFormatted = def.tokensTotal ? `~${def.tokensTotal.toLocaleString('en-US')}` : '~1,200';
    const permTokensFormatted = def.tokensPermanent ? `~${def.tokensPermanent.toLocaleString('en-US')}` : '~800';
    const greetingTokensFormatted = def.tokensGreeting ? `~${def.tokensGreeting.toLocaleString('en-US')}` : '~400';

    if (defTotalTokens) defTotalTokens.textContent = totalTokensFormatted;
    if (defPermTokens) defPermTokens.textContent = permTokensFormatted;
    if (defGreetingTokens) defGreetingTokens.textContent = greetingTokensFormatted;

    if (showcaseTokensCount) showcaseTokensCount.textContent = totalTokensFormatted;

    // Personality Block
    if (defPersonalityBox && defPersonalityContent) {
      if (def.personality) {
        defPersonalityBox.classList.remove('hidden');
        defPersonalityContent.textContent = def.personality;
        if (defPersonalityTokenLabel) {
          defPersonalityTokenLabel.textContent = `~${estimateTokens(def.personality).toLocaleString('en-US')} tokens`;
        }
      } else {
        defPersonalityBox.classList.add('hidden');
      }
    }

    // Scenario Block
    if (defScenarioBox && defScenarioContent) {
      if (def.scenario) {
        defScenarioBox.classList.remove('hidden');
        defScenarioContent.textContent = def.scenario;
        if (defScenarioTokenLabel) {
          defScenarioTokenLabel.textContent = `~${estimateTokens(def.scenario).toLocaleString('en-US')} tokens`;
        }
      } else {
        defScenarioBox.classList.add('hidden');
      }
    }

    // System Prompt Block
    if (defSystemBox && defSystemContent) {
      if (def.systemPrompt) {
        defSystemBox.classList.remove('hidden');
        defSystemContent.textContent = def.systemPrompt;
        if (defSystemTokenLabel) {
          defSystemTokenLabel.textContent = `~${estimateTokens(def.systemPrompt).toLocaleString('en-US')} tokens`;
        }
      } else {
        defSystemBox.classList.add('hidden');
      }
    }

    // Mes Example Block
    if (defMesExampleBox && defMesExampleContent) {
      if (def.mesExample) {
        defMesExampleBox.classList.remove('hidden');
        defMesExampleContent.textContent = def.mesExample;
        if (defMesExampleTokenLabel) {
          defMesExampleTokenLabel.textContent = `~${estimateTokens(def.mesExample).toLocaleString('en-US')} tokens`;
        }
      } else {
        defMesExampleBox.classList.add('hidden');
      }
    }
  }

  // Copy Definition Button
  defCopyBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (!activeCharacter) return;
    const def = extractCardDefinition(activeCharacter);
    const dump = [
      `# ${activeCharacter.name || 'Character'} - Definition`,
      def.personality ? `## Personality\n${def.personality}` : '',
      def.scenario ? `## Scenario\n${def.scenario}` : '',
      def.systemPrompt ? `## System Prompt\n${def.systemPrompt}` : '',
      def.mesExample ? `## Dialogue Examples\n${def.mesExample}` : '',
      def.rawDesc ? `## Raw Description\n${def.rawDesc}` : ''
    ].filter(Boolean).join('\n\n');

    const copied = copyTextToClipboard(dump);
    if (copied) {
      if (defCopyText) defCopyText.textContent = 'Copied to clipboard!';
      showShowcaseToast('📋 Character definition copied!');
      setTimeout(() => {
        if (defCopyText) defCopyText.textContent = 'Copy Character Definition';
      }, 2000);
    }
  });

  // Open Showcase Modal
  function openShowcase(characterId: string) {
    // 1. Search in pre-defined characters
    let char: any = characters.find(c => c.id === characterId);

    // 2. Search in custom characters
    if (!char) {
      try {
        const stored = localStorage.getItem('aetheria_custom_characters');
        if (stored) {
          const customChars = JSON.parse(stored);
          const custom = customChars.find((c: any) => c.id === characterId);
          if (custom) {
            char = {
              id: custom.id,
              name: custom.name,
              title: sanitizeTitle(custom.title || custom.tagline, 'Custom Companion'),
              category: custom.category || 'Custom',
              avatar: custom.avatarUrl || '/avatars/default.webp',
              tags: custom.tags || ['Custom', 'Roleplay'],
              description: custom.description || custom.lore || '',
              creatorNotes: custom.creator_notes || custom.creatorNotes || '',
              greeting: custom.greeting || custom.first_mes || '',
              alternateGreetings: custom.alternateGreetings || custom.alternate_greetings || [],
              personality: custom.personality || '',
              scenario: custom.scenario || '',
              systemPrompt: custom.systemPrompt || custom.system_prompt || '',
              mesExample: custom.mesExample || custom.mes_example || '',
              isCustom: true,
              chats: custom.chats || 100,
              rating: custom.rating || '5.0'
            };
          }
        }
      } catch (err) {
        console.error('Failed to parse custom characters:', err);
      }
    }

    if (!char) return;
    activeCharacter = char;

    // Reset to Description Tab
    switchTab('desc');

    // Populate Identity
    if (showcaseAvatar) {
      showcaseAvatar.src = char.avatar || '/avatars/default.webp';
      showcaseAvatar.alt = char.name;
    }
    if (showcaseName) showcaseName.textContent = char.name;
    if (showcaseTitle) showcaseTitle.textContent = sanitizeTitle(char.title, 'Companion');
    if (showcaseBadge) showcaseBadge.textContent = char.category || 'Roleplay';

    if (showcaseAuthor) {
      showcaseAuthor.textContent = char.isCustom ? 'By Community Creator' : 'By Aetheria Studio';
    }

    // NSFW / SFW Badge Detection
    const tagsList = char.tags || [];
    currentTags = Array.isArray(tagsList) ? tagsList : [String(tagsList)];
    const nsfwKeywords = ['nsfw', '18+', 'adult', 'erotica', 'smut', 'incest', 'lewd', 'hentai', 'explicit'];
    const hasNsfwTag = currentTags.some(t => typeof t === 'string' && nsfwKeywords.some(k => t.toLowerCase().includes(k)));

    if (showcaseNsfwBadge) {
      if (hasNsfwTag) {
        showcaseNsfwBadge.textContent = 'NSFW';
        showcaseNsfwBadge.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-rose-500/20 text-rose-300 border border-rose-500/30';
      } else {
        showcaseNsfwBadge.textContent = 'SFW';
        showcaseNsfwBadge.className = 'px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider bg-emerald-500/20 text-emerald-300 border border-emerald-500/30';
      }
    }

    // Render Tags with Truncation
    renderTags(false);

    // Populate Tab 1: Clean Public Description (Complete story, traits, scenario, and notes)
    if (showcaseDescription) {
      let rawMainDesc = char.description || '';
      const charScen = char.scenario || '';
      if (charScen && (!rawMainDesc || !rawMainDesc.includes(charScen.slice(0, 30)))) {
        rawMainDesc = rawMainDesc ? `${rawMainDesc}\n\n${charScen}` : charScen;
      }
      const publicText = cleanPublicDescription(rawMainDesc, char.creatorNotes || char.creator_notes);
      showcaseDescription.innerHTML = formatRichDescription(publicText, char.name);
    }

    // Populate Tab 2: Greetings & Alternates
    const rawAlt = char.alternateGreetings || char.alternate_greetings || [];
    const mainGreeting = char.greeting || char.first_mes || '';
    const allList = [mainGreeting, ...(Array.isArray(rawAlt) ? rawAlt : [])];
    currentGreetings = allList.filter((g, idx, arr) => g && typeof g === 'string' && arr.indexOf(g) === idx);
    if (currentGreetings.length === 0) currentGreetings = ['*Awaits your first message...*'];
    currentGreetingIndex = 0;
    if (greetingsCountBadge) greetingsCountBadge.textContent = String(currentGreetings.length);
    updateGreetingUI();

    // Populate Tab 3: Definition & Token Analysis
    updateDefinitionUI(char);

    // Update Star state
    updateStarUI(char.id);

    // Update Start Chat button
    if (showcaseStartBtn) {
      if (char.isCustom) {
        showcaseStartBtn.href = `/chat/custom?id=${encodeURIComponent(char.id)}`;
      } else {
        showcaseStartBtn.href = `/chat/${encodeURIComponent(char.id)}`;
      }
    }

    if (showcaseStartBtnLabel) {
      showcaseStartBtnLabel.textContent = 'Start Roleplay';
    }

    // Edit & Delete buttons in Header for custom characters ONLY
    if (showcaseEditBtn) {
      if (char.isCustom) {
        showcaseEditBtn.href = `/create?edit=${encodeURIComponent(char.id)}`;
        showcaseEditBtn.classList.remove('hidden');
        showcaseEditBtn.classList.add('inline-flex');
      } else {
        showcaseEditBtn.classList.add('hidden');
        showcaseEditBtn.classList.remove('inline-flex');
      }
    }

    if (showcaseDeleteBtn) {
      if (char.isCustom) {
        showcaseDeleteBtn.classList.remove('hidden');
        showcaseDeleteBtn.classList.add('inline-flex');
      } else {
        showcaseDeleteBtn.classList.add('hidden');
        showcaseDeleteBtn.classList.remove('inline-flex');
      }
    }

    // Report Flag Button (Shown ONLY for site-wide preset characters, hidden on custom)
    if (showcaseReportBtn) {
      if (char.isCustom) {
        showcaseReportBtn.classList.add('hidden');
        showcaseReportBtn.classList.remove('inline-flex');
      } else {
        showcaseReportBtn.classList.remove('hidden');
        showcaseReportBtn.classList.add('inline-flex');
      }
    }

    // Load full-resolution original lossless avatar and rich background from IndexedDB if available
    if (char.isCustom && typeof (window as any).AetheriaDB !== 'undefined') {
      (window as any).AetheriaDB.getCharacter(char.id).then((idbChar: any) => {
        if (idbChar) {
          if (idbChar.avatarUrl && showcaseAvatar) {
            showcaseAvatar.src = idbChar.avatarUrl;
          }
          if (idbChar.title) {
            const rawTitle = idbChar.title;
            if (/<[^>]+>/i.test(rawTitle) || rawTitle.length > 75) {
              if (!idbChar.description || !idbChar.description.includes(rawTitle.slice(0, 30))) {
                idbChar.description = rawTitle + '\n\n' + (idbChar.description || '');
              }
              idbChar.title = sanitizeTitle(rawTitle, 'Custom Companion');
              try {
                (window as any).AetheriaDB.saveCharacter(idbChar).catch(() => {});
              } catch {}
            }
            if (showcaseTitle) showcaseTitle.textContent = sanitizeTitle(idbChar.title, 'Custom Companion');
          }
          if (idbChar.description || idbChar.scenario || char.description || char.scenario) {
            if (showcaseDescription) {
              let fullDesc = idbChar.description || '';
              const idbScen = idbChar.scenario || char.scenario || '';
              if (idbScen && (!fullDesc || !fullDesc.includes(idbScen.slice(0, 30)))) {
                fullDesc = fullDesc ? `${fullDesc}\n\n${idbScen}` : idbScen;
              }
              if (!fullDesc) fullDesc = char.description || 'No detailed background provided.';
              const cleanText = cleanPublicDescription(fullDesc, idbChar.creator_notes || idbChar.creatorNotes || char.creatorNotes);
              showcaseDescription.innerHTML = formatRichDescription(cleanText, idbChar.name || char.name);
            }
          }
          if (idbChar.greeting || idbChar.first_mes) {
            const idbMain = idbChar.greeting || idbChar.first_mes || '';
            const idbAlts = idbChar.alternateGreetings || idbChar.alternate_greetings || [];
            currentGreetings = [idbMain, ...idbAlts].filter((g, i, a) => g && a.indexOf(g) === i);
            if (currentGreetings.length === 0) currentGreetings = ['*Awaits your first message...*'];
            currentGreetingIndex = 0;
            if (greetingsCountBadge) greetingsCountBadge.textContent = String(currentGreetings.length);
            updateGreetingUI();
          }
          // Re-update Definition tab with complete IDB character object
          updateDefinitionUI({ ...char, ...idbChar });
        }
      }).catch(() => {});
    }

    // Animate Modal Open
    showcaseModal?.classList.remove('opacity-0', 'pointer-events-none');
    showcaseModal?.classList.add('opacity-100', 'pointer-events-auto');
    showcaseDialog?.classList.remove('translate-y-full', 'sm:scale-95');
    showcaseDialog?.classList.add('translate-y-0', 'sm:scale-100');
    document.body.style.overflow = 'hidden';

    // Reset scroll position to top unconditionally
    if (showcaseBody) showcaseBody.scrollTop = 0;
    requestAnimationFrame(() => {
      if (showcaseBody) showcaseBody.scrollTop = 0;
    });
  }

  // Close Showcase Modal
  function closeShowcase() {
    showcaseModal?.classList.add('opacity-0', 'pointer-events-none');
    showcaseModal?.classList.remove('opacity-100', 'pointer-events-auto');
    showcaseDialog?.classList.add('translate-y-full', 'sm:scale-95');
    showcaseDialog?.classList.remove('translate-y-0', 'sm:scale-100');
    document.body.style.overflow = '';
    if (showcaseBody) showcaseBody.scrollTop = 0;
  }

  // Star System
  function updateStarUI(charId: string) {
    const isStarred = localStorage.getItem(`aetheria_starred_${charId}`) === 'true';
    const baseCount = activeCharacter?.chats || 1200;
    const currentCount = isStarred ? baseCount + 1 : baseCount;

    if (showcaseStarCount) {
      showcaseStarCount.textContent = currentCount >= 1000 ? (currentCount / 1000).toFixed(1) + 'k' : String(currentCount);
    }

    if (showcaseStarIcon) {
      if (isStarred) {
        showcaseStarIcon.classList.add('fill-amber-400', 'text-amber-400');
      } else {
        showcaseStarIcon.classList.remove('fill-amber-400');
        showcaseStarIcon.classList.add('fill-none', 'text-amber-400');
      }
    }
  }

  showcaseStarBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (!activeCharacter) return;
    const charId = activeCharacter.id;
    const isStarred = localStorage.getItem(`aetheria_starred_${charId}`) === 'true';

    if (isStarred) {
      localStorage.removeItem(`aetheria_starred_${charId}`);
      updateStarUI(charId);
      showShowcaseToast(`Removed star from ${activeCharacter.name}`);
    } else {
      localStorage.setItem(`aetheria_starred_${charId}`, 'true');
      updateStarUI(charId);
      showShowcaseToast(`⭐ Starred ${activeCharacter.name}! Added to favorites.`);
    }
  });

  // Delete Custom Character from Showcase Modal
  showcaseDeleteBtn?.addEventListener('click', async (e) => {
    e.stopPropagation();
    if (!activeCharacter || !activeCharacter.id) return;
    const targetName = activeCharacter.name || 'this character';
    const confirmed = typeof (window as any).showConfirmModal === 'function'
      ? await (window as any).showConfirmModal({
          title: 'Delete Character',
          message: `Are you sure you want to delete "${targetName}"?`,
          confirmText: 'Delete',
          cancelText: 'Cancel',
          danger: true
        })
      : confirm(`Are you sure you want to delete "${targetName}"?`);

    if (confirmed) {
      if (typeof (window as any).AetheriaDB !== 'undefined') {
        await (window as any).AetheriaDB.deleteCharacter(activeCharacter.id);
      }
      closeShowcase();
      const cardEl = document.querySelector(`[data-character-id="${activeCharacter.id}"]`);
      if (cardEl) {
        cardEl.remove();
        const sortSel = document.getElementById('sort-selector');
        sortSel?.dispatchEvent(new Event('change'));
      }
      showShowcaseToast(`🗑️ Deleted "${targetName}"`);
    }
  });

  // ================= SHARE LINK (NATIVE WEB SHARE + CLIPBOARD FALLBACK) =================
  showcaseShareBtn?.addEventListener('click', async (e) => {
    e.stopPropagation();
    if (!activeCharacter) return;
    const link = `${window.location.origin}/chat/${activeCharacter.isCustom ? 'custom?id=' + encodeURIComponent(activeCharacter.id) : encodeURIComponent(activeCharacter.id)}`;
    
    // 1. Native Web Share API on Mobile
    if (typeof navigator !== 'undefined' && navigator.share) {
      try {
        await navigator.share({
          title: `${activeCharacter.name} | Aetheria AI`,
          text: `Chat with ${activeCharacter.name} on Aetheria AI:`,
          url: link
        });
        showShowcaseToast('✓ Link shared!');
        return;
      } catch (err: any) {
        if (err && err.name === 'AbortError') return;
      }
    }

    // 2. Synchronous Clipboard Copy fallback
    const copied = copyTextToClipboard(link);
    if (copied) {
      showShowcaseToast('📋 Character link copied to clipboard!');
    } else {
      showShowcaseToast('Character URL: ' + link);
    }
  });

  // ================= EXPORT & DOWNLOAD (JSON & PNG) =================
  function toggleDownloadMenu(show?: boolean) {
    if (!showcaseDownloadMenu) return;
    const shouldShow = typeof show === 'boolean' ? show : showcaseDownloadMenu.classList.contains('hidden');
    if (shouldShow) {
      showcaseDownloadMenu.classList.remove('hidden');
    } else {
      showcaseDownloadMenu.classList.add('hidden');
    }
  }

  showcaseDownloadBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    toggleDownloadMenu();
  });

  // Download Tavern Card Spec V2 JSON
  function exportCharacterJson() {
    if (!activeCharacter) return;
    toggleDownloadMenu(false);

    const def = extractCardDefinition(activeCharacter);
    const cardData = {
      spec: 'chara_card_v2',
      spec_version: '2.0',
      data: {
        name: activeCharacter.name || 'Character',
        description: def.rawDesc || activeCharacter.description || '',
        personality: def.personality || activeCharacter.personality || '',
        scenario: def.scenario || activeCharacter.scenario || '',
        first_mes: activeCharacter.greeting || activeCharacter.first_mes || '',
        mes_example: def.mesExample || activeCharacter.mesExample || '',
        creator_notes: activeCharacter.creatorNotes || activeCharacter.creator_notes || 'Created on Aetheria AI.',
        system_prompt: def.systemPrompt || activeCharacter.systemPrompt || '',
        post_history_instructions: '',
        alternate_greetings: currentGreetings.length > 1 ? currentGreetings.slice(1) : (activeCharacter.alternateGreetings || []),
        tags: currentTags || [],
        creator: activeCharacter.author || (activeCharacter.isCustom ? 'Community Creator' : 'Aetheria Studio'),
        character_version: '2.0'
      }
    };

    const cleanFileName = (activeCharacter.name || 'character').toLowerCase().replace(/[^\p{L}\p{N}]+/gu, '-').replace(/^-+|-+$/g, '') || 'character';
    const blob = new Blob([JSON.stringify(cardData, null, 2)], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `${cleanFileName}-card.json`;
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
    showShowcaseToast(`💾 Exported "${cleanFileName}-card.json"!`);
  }

  // Download Full-Size Character Image
  async function exportCharacterAvatar() {
    if (!activeCharacter) return;
    toggleDownloadMenu(false);

    const cleanFileName = (activeCharacter.name || 'character').toLowerCase().replace(/[^\p{L}\p{N}]+/gu, '-').replace(/^-+|-+$/g, '') || 'character';
    const avatarSrc = showcaseAvatar?.src || activeCharacter.avatar || '/avatars/default.webp';

    if (avatarSrc.startsWith('data:')) {
      const a = document.createElement('a');
      a.href = avatarSrc;
      a.download = `${cleanFileName}-avatar.png`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      showShowcaseToast(`🖼️ Downloaded "${cleanFileName}-avatar.png"!`);
      return;
    }

    try {
      showShowcaseToast('Downloading image...');
      const resp = await fetch(avatarSrc);
      const blob = await resp.blob();
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = `${cleanFileName}-avatar.png`;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
      showShowcaseToast(`🖼️ Downloaded "${cleanFileName}-avatar.png"!`);
    } catch {
      window.open(avatarSrc, '_blank');
    }
  }

  downloadJsonBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    exportCharacterJson();
  });

  downloadPngBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    exportCharacterAvatar();
  });

  // ================= AVATAR LIGHTBOX (IMAGE ZOOM) =================
  function openAvatarLightbox() {
    if (!showcaseAvatar || !lightboxImage || !showcaseAvatarLightbox) return;
    lightboxImage.src = showcaseAvatar.src;
    lightboxImage.alt = showcaseAvatar.alt || 'Character Avatar';
    showcaseAvatarLightbox.classList.remove('hidden');
    showcaseAvatarLightbox.classList.add('flex');
  }

  function closeAvatarLightbox() {
    if (!showcaseAvatarLightbox) return;
    showcaseAvatarLightbox.classList.add('hidden');
    showcaseAvatarLightbox.classList.remove('flex');
  }

  showcaseAvatarWrapper?.addEventListener('click', (e) => {
    e.stopPropagation();
    openAvatarLightbox();
  });

  lightboxCloseBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    closeAvatarLightbox();
  });

  showcaseAvatarLightbox?.addEventListener('click', (e) => {
    if (e.target === showcaseAvatarLightbox || e.target === lightboxImage) {
      closeAvatarLightbox();
    }
  });

  // Close download menu on outside click
  document.addEventListener('click', () => {
    toggleDownloadMenu(false);
  });

  // Report Character Button
  showcaseReportBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    if (!activeCharacter) return;
    
    const reason = prompt(`Report "${activeCharacter.name}" for a safety, legal, or content issue:\n\nEnter details or reason for reporting:`);
    if (reason && reason.trim()) {
      showShowcaseToast('Submitting report...');
      fetch('/api/reports', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          targetType: 'character',
          targetId: activeCharacter.id,
          targetName: activeCharacter.name,
          category: 'legal',
          details: reason.trim(),
          snippet: `${activeCharacter.name} - ${activeCharacter.title}: ${(activeCharacter.description || '').slice(0, 300)}`,
          metadata: {
            isCustom: !!activeCharacter.isCustom,
            category: activeCharacter.category
          }
        })
      }).then(r => r.json()).then(data => {
        if (data.success) {
          showShowcaseToast('✓ Report received. Thank you for helping keep Aetheria safe!');
        } else {
          showShowcaseToast(data.error || 'Failed to submit report');
        }
      }).catch(() => {
        showShowcaseToast('Network error while reporting');
      });
    }
  });

  // Event Listeners for opening and closing
  showcaseCloseBtn?.addEventListener('click', () => {
    closeAvatarLightbox();
    toggleDownloadMenu(false);
    closeShowcase();
  });

  showcaseModal?.addEventListener('click', (e) => {
    if (e.target === showcaseModal) closeShowcase();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeShowcase();
  });

  // Global Interceptor: Clicks on any character card or "View Profile & Story" button opens the Showcase
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const triggerBtn = target.closest('.open-chat-btn');
    const card = target.closest('.character-card');

    if (triggerBtn) {
      e.stopPropagation();
      e.preventDefault();
      const charId = triggerBtn.getAttribute('data-character-id');
      if (charId) openShowcase(charId);
      return;
    }

    if (card && !target.closest('button') && !target.closest('a')) {
      const charId = card.getAttribute('data-character-id');
      if (charId) openShowcase(charId);
    }
  });
</script>
