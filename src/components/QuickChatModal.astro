---
import { characters } from '../data/characters';
import { 
  X, 
  Send, 
  Sparkles, 
  ShieldCheck, 
  KeyRound, 
  Bot, 
  User, 
  CornerDownLeft, 
  RotateCcw,
  CheckCircle2,
  Lock,
  ChevronDown
} from '@lucide/astro';
---

<!-- Section 5: Obsidian Quick Chat Preview Modal -->
<div 
  id="quick-chat-modal"
  class="fixed inset-0 z-50 flex items-end sm:items-center justify-center p-0 sm:p-4 bg-black/80 backdrop-blur-md transition-all duration-300 opacity-0 pointer-events-none"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-character-name"
>
  <!-- Modal Dialog Container -->
  <div 
    id="chat-modal-dialog"
    class="w-full max-h-[92vh] h-[85vh] sm:h-[680px] sm:max-h-[88vh] rounded-t-3xl sm:rounded-3xl border-t sm:border border-white/[0.12] bg-[#090b14] flex flex-col overflow-hidden shadow-2xl shadow-purple-950/80 transform translate-y-full sm:translate-y-0 sm:scale-95 transition-all duration-300 ease-out sm:max-w-xl sm:mx-auto"
  >
    <!-- Mobile Pull Drag Indicator -->
    <div class="w-12 h-1.5 rounded-full bg-white/20 mx-auto my-2 shrink-0 sm:hidden"></div>

    <!-- Modal Header -->
    <header class="px-4 py-3 sm:px-5 sm:py-3.5 border-b border-white/[0.08] bg-[#0c0f1d]/90 flex items-center justify-between shrink-0">
      <!-- Character Identity -->
      <div class="flex items-center gap-3 min-w-0">
        <div class="relative shrink-0">
          <img 
            id="modal-character-avatar"
            src="" 
            alt="Character Avatar" 
            class="w-10 h-10 sm:w-11 sm:h-11 rounded-full object-cover ring-2 ring-purple-500/40"
          />
          <span 
            id="modal-character-status"
            class="absolute bottom-0 right-0 w-3 h-3 rounded-full bg-emerald-400 ring-2 ring-[#0c0f1d]"
          ></span>
        </div>

        <div class="min-w-0">
          <div class="flex items-center gap-2">
            <h3 
              id="modal-character-name" 
              class="text-sm sm:text-base font-bold text-white truncate tracking-tight"
            >
              Character Name
            </h3>
            <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] font-semibold bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 shrink-0">
              <ShieldCheck class="w-3 h-3" />
              <span>SFW</span>
            </span>
          </div>
          <p 
            id="modal-character-title" 
            class="text-[11px] sm:text-xs text-purple-400/90 truncate font-medium"
          >
            Character Title
          </p>
        </div>
      </div>

      <!-- Header Actions -->
      <div class="flex items-center gap-1.5 sm:gap-2 shrink-0">
        <!-- BYOK Settings Toggle Button -->
        <button 
          type="button" 
          id="toggle-byok-btn"
          class="flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl bg-white/[0.05] hover:bg-white/[0.1] border border-white/[0.08] text-[11px] font-medium text-slate-300 hover:text-white transition cursor-pointer"
          title="Configure BYOK (Bring Your Own Key)"
        >
          <KeyRound class="w-3.5 h-3.5 text-purple-400" />
          <span class="hidden sm:inline">BYOK</span>
          <span id="byok-badge-dot" class="w-1.5 h-1.5 rounded-full bg-slate-500"></span>
        </button>

        <!-- Close Modal Button -->
        <button 
          type="button" 
          id="close-chat-modal-btn"
          class="p-2 rounded-xl bg-white/[0.05] hover:bg-white/[0.1] text-slate-400 hover:text-white transition cursor-pointer"
          aria-label="Close Chat"
        >
          <X class="w-4 h-4" />
        </button>
      </div>
    </header>

    <!-- BYOK Configuration Tray (Collapsible) -->
    <div 
      id="byok-tray" 
      class="hidden px-4 py-3 bg-[#0f1325] border-b border-purple-500/20 text-xs text-slate-300 transition-all duration-200"
    >
      <div class="flex items-center justify-between mb-2">
        <div class="flex items-center gap-1.5 text-purple-300 font-semibold text-[11px] uppercase tracking-wider">
          <Lock class="w-3.5 h-3.5" />
          <span>Client-Side BYOK Key (Stored in LocalStorage)</span>
        </div>
        <button type="button" id="close-byok-tray" class="text-slate-400 hover:text-white text-[11px] cursor-pointer">
          Close
        </button>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mb-2">
        <div>
          <label class="block text-[10px] text-slate-400 mb-1">Provider</label>
          <select 
            id="byok-provider-select" 
            class="w-full bg-[#080911] border border-white/10 rounded-lg px-2.5 py-1.5 text-xs text-slate-200 focus:outline-none focus:border-purple-500"
          >
            <option value="demo">Free Edge Simulation (No Key Needed)</option>
            <option value="groq">Groq Cloud (Fast & Free Tier)</option>
            <option value="openai">OpenAI (GPT-4o / GPT-4o-mini)</option>
            <option value="gemini">Google Gemini (Flash)</option>
            <option value="openrouter">OpenRouter (All Models)</option>
          </select>
        </div>

        <div>
          <label class="block text-[10px] text-slate-400 mb-1">API Key</label>
          <input 
            type="password" 
            id="byok-api-key-input" 
            placeholder="gsk_... or sk-..." 
            class="w-full bg-[#080911] border border-white/10 rounded-lg px-2.5 py-1.5 text-xs text-slate-200 focus:outline-none focus:border-purple-500 font-mono"
          />
        </div>
      </div>

      <div class="flex items-center justify-between pt-1">
        <p class="text-[10px] text-slate-400">
          Keys never touch our server. All calls are direct client-to-API.
        </p>
        <button 
          type="button" 
          id="save-byok-key-btn"
          class="px-3 py-1 rounded-lg bg-purple-600 hover:bg-purple-500 text-white font-semibold text-[11px] transition cursor-pointer"
        >
          Save Key
        </button>
      </div>
    </div>

    <!-- Messages Conversation Stream -->
    <div 
      id="chat-messages-container" 
      class="flex-1 overflow-y-auto p-4 space-y-3.5 scroll-smooth"
    >
      <!-- Character Greeting Card will be populated via JS -->
    </div>

    <!-- Typing Indicator -->
    <div 
      id="chat-typing-indicator" 
      class="hidden px-4 py-2 flex items-center gap-2.5 text-xs text-slate-400 shrink-0"
    >
      <div class="w-6 h-6 rounded-full overflow-hidden shrink-0 ring-1 ring-purple-500/30">
        <img id="typing-indicator-avatar" src="" alt="" class="w-full h-full object-cover" />
      </div>
      <div class="px-3 py-2 rounded-2xl rounded-tl-sm bg-white/[0.05] border border-white/[0.08] flex items-center gap-1.5">
        <span class="w-1.5 h-1.5 rounded-full bg-purple-400 animate-bounce"></span>
        <span class="w-1.5 h-1.5 rounded-full bg-purple-400 animate-bounce [animation-delay:0.2s]"></span>
        <span class="w-1.5 h-1.5 rounded-full bg-purple-400 animate-bounce [animation-delay:0.4s]"></span>
        <span id="typing-indicator-text" class="text-[11px] text-slate-400 ml-1.5 font-medium">typing...</span>
      </div>
    </div>

    <!-- Starter Prompts Row -->
    <div class="px-3 pt-2 pb-1 border-t border-white/[0.06] bg-[#080a14]/90 shrink-0">
      <div class="flex items-center gap-1.5 mb-1 text-[10px] text-slate-500 font-medium">
        <Sparkles class="w-3 h-3 text-purple-400" />
        <span>Suggested conversation starters:</span>
      </div>
      <div 
        id="starter-prompts-container" 
        class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-1"
      >
        <!-- Injected via JavaScript -->
      </div>
    </div>

    <!-- Chat Input Form -->
    <footer class="p-3 sm:p-4 bg-[#0a0d1a] border-t border-white/[0.08] shrink-0 pb-safe">
      <form id="chat-input-form" class="flex items-center gap-2">
        <div class="relative flex-1">
          <input 
            type="text" 
            id="chat-message-input"
            autocomplete="off"
            placeholder="Type your message..." 
            class="w-full bg-[#111424] hover:bg-[#14182b] focus:bg-[#14182b] border border-white/10 focus:border-purple-500/60 rounded-xl px-3.5 py-2.5 text-xs text-white placeholder-slate-500 focus:outline-none focus:ring-1 focus:ring-purple-500/50 transition-all"
          />
        </div>

        <button 
          type="submit" 
          id="chat-send-btn"
          class="shrink-0 p-2.5 rounded-xl bg-purple-600 hover:bg-purple-500 active:scale-95 text-white transition-all shadow-md shadow-purple-900/40 cursor-pointer"
          title="Send Message"
        >
          <Send class="w-4 h-4" />
        </button>
      </form>

      <!-- Bottom Micro Note -->
      <div class="flex items-center justify-between text-[10px] text-slate-500 mt-2 px-1">
        <div class="flex items-center gap-1">
          <CheckCircle2 class="w-3 h-3 text-emerald-400" />
          <span>SFW Roleplay • 100% Client-Side Privacy</span>
        </div>
        <span id="chat-mode-indicator" class="text-purple-400 font-mono">Edge Mode</span>
      </div>
    </footer>

  </div>
</div>

<script define:vars={{ characters }}>
  let currentCharacter = characters[0];
  let conversationHistory = [];

  const modal = document.getElementById('quick-chat-modal');
  const dialog = document.getElementById('chat-modal-dialog');
  const closeBtn = document.getElementById('close-chat-modal-btn');
  const avatarImg = document.getElementById('modal-character-avatar');
  const nameEl = document.getElementById('modal-character-name');
  const titleEl = document.getElementById('modal-character-title');
  const messagesContainer = document.getElementById('chat-messages-container');
  const starterContainer = document.getElementById('starter-prompts-container');
  const form = document.getElementById('chat-input-form');
  const input = document.getElementById('chat-message-input');
  const typingIndicator = document.getElementById('chat-typing-indicator');
  const typingAvatar = document.getElementById('typing-indicator-avatar');
  const typingText = document.getElementById('typing-indicator-text');
  
  // BYOK elements
  const toggleByokBtn = document.getElementById('toggle-byok-btn');
  const byokTray = document.getElementById('byok-tray');
  const closeByokTray = document.getElementById('close-byok-tray');
  const byokProviderSelect = document.getElementById('byok-provider-select');
  const byokKeyInput = document.getElementById('byok-api-key-input');
  const saveByokBtn = document.getElementById('save-byok-key-btn');
  const byokBadgeDot = document.getElementById('byok-badge-dot');
  const chatModeIndicator = document.getElementById('chat-mode-indicator');

  // Format character action text (*italic*) vs speech
  function formatMessageText(text) {
    if (!text) return '';
    // Replace *action* with italic styled span
    return text.replace(/\*([^*]+)\*/g, '<em class="text-purple-300/80 italic">$1</em>');
  }

  function checkByokStatus() {
    const savedKey = localStorage.getItem('aetheria_byok_key');
    const savedProvider = localStorage.getItem('aetheria_byok_provider') || 'demo';
    
    if (savedKey && savedProvider !== 'demo') {
      if (byokBadgeDot) byokBadgeDot.className = 'w-1.5 h-1.5 rounded-full bg-emerald-400';
      if (chatModeIndicator) chatModeIndicator.textContent = `BYOK (${savedProvider.toUpperCase()})`;
      if (byokKeyInput) byokKeyInput.value = savedKey;
      if (byokProviderSelect) byokProviderSelect.value = savedProvider;
    } else {
      if (byokBadgeDot) byokBadgeDot.className = 'w-1.5 h-1.5 rounded-full bg-slate-500';
      if (chatModeIndicator) chatModeIndicator.textContent = 'Edge Demo';
    }
  }

  function openModal(charId) {
    const found = characters.find(c => c.id === charId);
    if (found) {
      currentCharacter = found;
    }

    // Populate header
    if (avatarImg) avatarImg.src = currentCharacter.avatarUrl;
    if (typingAvatar) typingAvatar.src = currentCharacter.avatarUrl;
    if (nameEl) nameEl.textContent = currentCharacter.name;
    if (titleEl) titleEl.textContent = currentCharacter.title;
    if (input) input.placeholder = `Message ${currentCharacter.name}...`;

    // Clear previous messages and show initial greeting
    if (messagesContainer) {
      messagesContainer.innerHTML = '';
      
      // Welcome Intro Banner inside chat
      const introBanner = document.createElement('div');
      introBanner.className = 'text-center py-2 px-3 rounded-2xl bg-white/[0.02] border border-white/[0.05] text-[11px] text-slate-400 max-w-sm mx-auto mb-2';
      introBanner.innerHTML = `
        <div class="font-semibold text-slate-300">${currentCharacter.name}</div>
        <div class="text-[10px] text-purple-400/80 mt-0.5">${currentCharacter.description}</div>
      `;
      messagesContainer.appendChild(introBanner);

      // Character greeting bubble
      appendMessage('character', currentCharacter.greeting);
    }

    // Populate starter prompts
    if (starterContainer) {
      starterContainer.innerHTML = '';
      (currentCharacter.starterPrompts || []).forEach(prompt => {
        const btn = document.createElement('button');
        btn.type = 'button';
        btn.className = 'shrink-0 px-3 py-1 rounded-full bg-white/[0.04] hover:bg-purple-600/20 hover:text-purple-200 border border-white/[0.08] hover:border-purple-500/30 text-[11px] text-slate-300 transition cursor-pointer select-none';
        btn.textContent = prompt;
        btn.addEventListener('click', () => {
          sendUserMessage(prompt);
        });
        starterContainer.appendChild(btn);
      });
    }

    // Open modal animation
    if (modal && dialog) {
      modal.classList.remove('opacity-0', 'pointer-events-none');
      modal.classList.add('opacity-100');

      dialog.classList.remove('translate-y-full', 'sm:scale-95');
      dialog.classList.add('translate-y-0', 'sm:scale-100');
    }

    checkByokStatus();
    if (input) setTimeout(() => input.focus(), 250);
  }

  function closeModal() {
    if (modal && dialog) {
      dialog.classList.add('translate-y-full', 'sm:scale-95');
      dialog.classList.remove('translate-y-0', 'sm:scale-100');

      modal.classList.remove('opacity-100');
      modal.classList.add('opacity-0', 'pointer-events-none');
    }
  }

  function appendMessage(sender, text) {
    if (!messagesContainer) return;

    const msgRow = document.createElement('div');
    msgRow.className = `flex gap-2.5 items-end ${sender === 'user' ? 'justify-end' : 'justify-start'}`;

    if (sender === 'character') {
      msgRow.innerHTML = `
        <div class="w-7 h-7 rounded-full overflow-hidden shrink-0 ring-1 ring-purple-500/30 mb-0.5">
          <img src="${currentCharacter.avatarUrl}" alt="${currentCharacter.name}" class="w-full h-full object-cover" />
        </div>
        <div class="max-w-[82%] sm:max-w-[75%] px-3.5 py-2.5 rounded-2xl rounded-tl-sm bg-[#121627] border border-white/[0.08] text-xs text-slate-200 leading-relaxed shadow-sm">
          ${formatMessageText(text)}
        </div>
      `;
    } else {
      msgRow.innerHTML = `
        <div class="max-w-[82%] sm:max-w-[75%] px-3.5 py-2.5 rounded-2xl rounded-tr-sm bg-gradient-to-tr from-purple-700 to-indigo-600 text-xs text-white leading-relaxed shadow-md shadow-purple-950/40">
          ${text}
        </div>
      `;
    }

    messagesContainer.appendChild(msgRow);
    messagesContainer.scrollTop = messagesContainer.scrollHeight;
  }

  async function sendUserMessage(text) {
    if (!text || !text.trim()) return;
    const cleanText = text.trim();

    appendMessage('user', cleanText);
    if (input) input.value = '';

    // Show typing indicator
    if (typingIndicator && typingText) {
      typingText.textContent = `${currentCharacter.name} is typing...`;
      typingIndicator.classList.remove('hidden');
      if (messagesContainer) messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }

    // Check BYOK or Simulated edge response
    const savedKey = localStorage.getItem('aetheria_byok_key');
    const savedProvider = localStorage.getItem('aetheria_byok_provider');

    if (savedKey && savedProvider === 'groq') {
      try {
        const response = await fetch('https://api.groq.com/openai/v1/chat/completions', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Authorization': `Bearer ${savedKey}`
          },
          body: JSON.stringify({
            model: 'llama-3.3-70b-versatile',
            messages: [
              {
                role: 'system',
                content: `You are roleplaying as ${currentCharacter.name}, ${currentCharacter.title}. Persona lore: ${currentCharacter.description}. SFW dialogue, rich roleplay tone with *actions* in asterisks. Keep reply under 60 words.`
              },
              { role: 'user', content: cleanText }
            ],
            max_tokens: 120,
            temperature: 0.8
          })
        });

        const data = await response.json();
        const reply = data.choices?.[0]?.message?.content || pickFallbackReply();
        if (typingIndicator) typingIndicator.classList.add('hidden');
        appendMessage('character', reply);
        return;
      } catch (err) {
        console.warn('BYOK call failed, falling back to persona engine:', err);
      }
    }

    // Default fast edge persona engine
    setTimeout(() => {
      if (typingIndicator) typingIndicator.classList.add('hidden');
      const reply = pickFallbackReply();
      appendMessage('character', reply);
    }, 700 + Math.random() * 500);
  }

  function pickFallbackReply() {
    const list = currentCharacter.fallbackReplies || [];
    if (list.length === 0) {
      return `*A thoughtful pause.* I understand your curiosity. Let's delve further into this topic.`;
    }
    const idx = Math.floor(Math.random() * list.length);
    return list[idx];
  }

  // Event Listeners
  closeBtn?.addEventListener('click', closeModal);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  form?.addEventListener('submit', (e) => {
    e.preventDefault();
    if (input) sendUserMessage(input.value);
  });

  // BYOK Tray toggle
  toggleByokBtn?.addEventListener('click', () => {
    byokTray?.classList.toggle('hidden');
  });

  closeByokTray?.addEventListener('click', () => {
    byokTray?.classList.add('hidden');
  });

  saveByokBtn?.addEventListener('click', () => {
    const key = byokKeyInput?.value.trim() || '';
    const provider = byokProviderSelect?.value || 'demo';

    if (key) {
      localStorage.setItem('aetheria_byok_key', key);
      localStorage.setItem('aetheria_byok_provider', provider);
    } else {
      localStorage.removeItem('aetheria_byok_key');
      localStorage.setItem('aetheria_byok_provider', 'demo');
    }

    checkByokStatus();
    byokTray?.classList.add('hidden');
  });

  // Global event listener to open chat
  window.addEventListener('open-quick-chat', (e) => {
    const detail = e.detail;
    openModal(detail.characterId);
  });

  // Global event to open BYOK
  window.addEventListener('open-byok-modal', () => {
    openModal(currentCharacter.id);
    byokTray?.classList.remove('hidden');
  });

  // Catch clicks on card and button
  document.addEventListener('click', (e) => {
    const target = e.target;
    const triggerBtn = target.closest('.open-chat-btn');
    const card = target.closest('.character-card');

    if (triggerBtn) {
      e.stopPropagation();
      e.preventDefault();
      const charId = triggerBtn.getAttribute('data-character-id');
      if (charId) openModal(charId);
      return;
    }

    if (card && !target.closest('button') && !target.closest('a')) {
      const charId = card.getAttribute('data-character-id');
      if (charId) openModal(charId);
    }
  });

  // Escape key closes modal
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });
</script>
