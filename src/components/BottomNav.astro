---
import { Compass, Flame, Plus, MessageSquare, KeyRound, User } from '@lucide/astro';
---

<!-- Section 4: Mobile Floating Bottom Navigation Bar -->
<nav 
  id="mobile-bottom-nav" 
  class="sm:hidden fixed bottom-0 left-0 right-0 z-40 bg-[#070913]/92 backdrop-blur-2xl border-t border-white/[0.08] shadow-[0_-10px_35px_rgba(0,0,0,0.7)] transition-all duration-300"
  aria-label="Mobile Navigation"
>
  <div class="max-w-md mx-auto px-4 pt-1.5 pb-safe flex items-center justify-between relative">
    
    <!-- 1. Discover (Home) -->
    <button 
      type="button" 
      id="nav-btn-discover"
      class="nav-item group relative flex flex-col items-center justify-center py-1 px-2.5 text-purple-400 active:scale-95 transition-all cursor-pointer"
      data-target="all"
    >
      <Compass class="w-5 h-5 transition-transform duration-200 group-hover:scale-110" />
      <span class="text-[10px] font-semibold tracking-tight mt-1">Discover</span>
      <!-- Active Indicator Dot -->
      <span class="nav-indicator w-1 h-1 rounded-full bg-purple-400 shadow-sm shadow-purple-400 mt-0.5"></span>
    </button>

    <!-- 2. Trending -->
    <button 
      type="button" 
      id="nav-btn-trending"
      class="nav-item group relative flex flex-col items-center justify-center py-1 px-2.5 text-slate-400 hover:text-slate-200 active:scale-95 transition-all cursor-pointer"
      data-target="trending"
    >
      <Flame class="w-5 h-5 transition-transform duration-200 group-hover:scale-110 group-hover:text-amber-400" />
      <span class="text-[10px] font-medium tracking-tight mt-1">Trending</span>
      <span class="nav-indicator hidden w-1 h-1 rounded-full bg-amber-400 shadow-sm shadow-amber-400 mt-0.5"></span>
    </button>

    <!-- 3. Center Elevated Create Action -->
    <div class="relative flex flex-col items-center justify-center -translate-y-3">
      <a 
        href="/create" 
        id="nav-btn-create"
        class="group relative w-12 h-12 rounded-full p-[1.5px] bg-gradient-to-tr from-purple-600 via-indigo-500 to-cyan-400 shadow-lg shadow-purple-600/40 hover:shadow-purple-500/60 active:scale-90 transition-all duration-200 cursor-pointer flex items-center justify-center"
        title="Create New Character Studio"
      >
        <div class="w-full h-full rounded-full bg-[#0a0d18] flex items-center justify-center group-hover:bg-gradient-to-tr group-hover:from-purple-600 group-hover:to-cyan-500 transition-colors">
          <Plus class="w-6 h-6 text-white group-hover:rotate-90 transition-transform duration-300" />
        </div>
      </a>
      <span class="text-[9px] font-bold text-slate-300 mt-1 uppercase tracking-wider">Create</span>
    </div>

    <!-- 4. Chats -->
    <button 
      type="button" 
      id="nav-btn-chats"
      class="nav-item group relative flex flex-col items-center justify-center py-1 px-2.5 text-slate-400 hover:text-slate-200 active:scale-95 transition-all cursor-pointer"
    >
      <div class="relative">
        <MessageSquare class="w-5 h-5 transition-transform duration-200 group-hover:scale-110 group-hover:text-cyan-400" />
        <!-- Pulse Active Badge -->
        <span class="absolute -top-1 -right-1 w-2 h-2 rounded-full bg-cyan-400 ring-2 ring-[#070913] animate-pulse"></span>
      </div>
      <span class="text-[10px] font-medium tracking-tight mt-1">Chats</span>
      <span class="nav-indicator hidden w-1 h-1 rounded-full bg-cyan-400 shadow-sm shadow-cyan-400 mt-0.5"></span>
    </button>

    <!-- 5. Persona -->
    <a 
      href="/profile" 
      id="nav-btn-persona"
      class="nav-item group relative flex flex-col items-center justify-center py-1 px-2.5 text-slate-400 hover:text-slate-200 active:scale-95 transition-all cursor-pointer"
      title="User Persona & Identity"
    >
      <User class="w-5 h-5 transition-transform duration-200 group-hover:scale-110 group-hover:text-purple-300" />
      <span class="text-[10px] font-medium tracking-tight mt-1">Persona</span>
      <span class="nav-indicator hidden w-1 h-1 rounded-full bg-purple-400 shadow-sm shadow-purple-400 mt-0.5"></span>
    </a>

  </div>
</nav>

<!-- Create Character Prompt Toast / Dialog (Lightweight Feedback) -->
<div 
  id="create-character-toast" 
  class="fixed top-6 left-1/2 -translate-x-1/2 z-50 px-4 py-2.5 rounded-2xl bg-[#121626]/95 border border-purple-500/30 text-white text-xs font-medium shadow-2xl shadow-purple-950/80 backdrop-blur-xl flex items-center gap-2 pointer-events-none opacity-0 -translate-y-4 transition-all duration-300 max-w-[90vw]"
>
  <span class="w-2 h-2 rounded-full bg-purple-400 animate-ping"></span>
  <span>Character Creator Studio launching soon in Phase 2!</span>
</div>

<script>
  function setupBottomNav() {
    const discoverBtn = document.getElementById('nav-btn-discover');
    const trendingBtn = document.getElementById('nav-btn-trending');
    const createBtn = document.getElementById('nav-btn-create');
    const chatsBtn = document.getElementById('nav-btn-chats');
    const byokBtn = document.getElementById('nav-btn-byok');
    const toast = document.getElementById('create-character-toast');

    function setActive(btn: HTMLElement | null, colorClass: string = 'text-purple-400') {
      document.querySelectorAll('.nav-item').forEach(el => {
        el.className = 'nav-item group relative flex flex-col items-center justify-center py-1 px-2.5 text-slate-400 hover:text-slate-200 active:scale-95 transition-all cursor-pointer';
        const indicator = el.querySelector('.nav-indicator');
        if (indicator) indicator.classList.add('hidden');
      });

      if (btn) {
        btn.classList.remove('text-slate-400');
        btn.classList.add(colorClass);
        const indicator = btn.querySelector('.nav-indicator');
        if (indicator) indicator.classList.remove('hidden');
      }
    }

    // Discover: Scroll to top and reset category to All
    discoverBtn?.addEventListener('click', () => {
      setActive(discoverBtn, 'text-purple-400');
      window.scrollTo({ top: 0, behavior: 'smooth' });
      const allPill = document.querySelector<HTMLButtonElement>('[data-cat-btn="all"]');
      if (allPill) allPill.click();
    });

    // Trending: Select trending pill
    trendingBtn?.addEventListener('click', () => {
      setActive(trendingBtn, 'text-amber-400');
      const trendingPill = document.querySelector<HTMLButtonElement>('[data-cat-btn="trending"]');
      if (trendingPill) {
        trendingPill.click();
        const grid = document.querySelector('#characters-grid');
        if (grid) grid.scrollIntoView({ behavior: 'smooth' });
      }
    });

    // Create Toast
    createBtn?.addEventListener('click', () => {
      if (!toast) return;
      toast.classList.remove('opacity-0', '-translate-y-4', 'pointer-events-none');
      toast.classList.add('opacity-100', 'translate-y-0');

      setTimeout(() => {
        toast.classList.add('opacity-0', '-translate-y-4', 'pointer-events-none');
        toast.classList.remove('opacity-100', 'translate-y-0');
      }, 2600);
    });

    // Chats button: Open Quick Chat preview with default character
    chatsBtn?.addEventListener('click', () => {
      setActive(chatsBtn, 'text-cyan-400');
      window.dispatchEvent(new CustomEvent('open-quick-chat', {
        detail: { characterId: 'lyra-vance' }
      }));
    });

    // BYOK button: Trigger BYOK settings modal
    byokBtn?.addEventListener('click', () => {
      setActive(byokBtn, 'text-purple-300');
      window.dispatchEvent(new CustomEvent('open-byok-modal'));
    });
  }

  // Setup on page load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupBottomNav);
  } else {
    setupBottomNav();
  }
</script>
