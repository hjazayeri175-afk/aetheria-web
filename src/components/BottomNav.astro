---
import { Compass, Flame, Plus, MessageSquare, User } from '@lucide/astro';

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isHome = pathname === '/';
const isLibrary = pathname.startsWith('/library');
const isCreate = pathname.startsWith('/create');
const isProfile = pathname.startsWith('/profile');
---

<!-- Mobile Floating Bottom Navigation Bar -->
<nav 
  id="mobile-bottom-nav" 
  class="sm:hidden fixed bottom-0 left-0 right-0 z-40 bg-[#070913]/92 backdrop-blur-2xl border-t border-white/[0.08] shadow-[0_-10px_35px_rgba(0,0,0,0.7)] transition-all duration-300"
  aria-label="Mobile Navigation"
>
  <div class="max-w-md mx-auto px-4 pt-1.5 pb-safe flex items-center justify-between relative">
    
    <!-- 1. Discover (Home) -->
    <a 
      href="/" 
      id="nav-btn-discover"
      class={`nav-item group relative flex flex-col items-center justify-center py-1 px-2.5 active:scale-95 transition-all cursor-pointer ${
        isHome ? 'text-purple-400' : 'text-slate-400 hover:text-slate-200'
      }`}
      data-route="home"
    >
      <Compass class="w-5 h-5 transition-transform duration-200 group-hover:scale-110" />
      <span class="text-[10px] font-semibold tracking-tight mt-1">Discover</span>
      <span class={`nav-indicator w-1 h-1 rounded-full bg-purple-400 shadow-sm shadow-purple-400 mt-0.5 ${isHome ? '' : 'hidden'}`}></span>
    </a>

    <!-- 2. Trending -->
    <a 
      href="/?cat=trending" 
      id="nav-btn-trending"
      class="nav-item group relative flex flex-col items-center justify-center py-1 px-2.5 text-slate-400 hover:text-slate-200 active:scale-95 transition-all cursor-pointer"
      data-route="trending"
    >
      <Flame class="w-5 h-5 transition-transform duration-200 group-hover:scale-110 group-hover:text-amber-400" />
      <span class="text-[10px] font-medium tracking-tight mt-1">Trending</span>
      <span class="nav-indicator hidden w-1 h-1 rounded-full bg-amber-400 shadow-sm shadow-amber-400 mt-0.5"></span>
    </a>

    <!-- 3. Center Elevated Create Action -->
    <div class="relative flex flex-col items-center justify-center -translate-y-3">
      <a 
        href="/create" 
        id="nav-btn-create"
        class={`group relative w-12 h-12 rounded-full p-[1.5px] bg-gradient-to-tr from-purple-600 via-indigo-500 to-cyan-400 shadow-lg ${
          isCreate ? 'ring-2 ring-purple-400 shadow-purple-500/80 scale-105' : 'shadow-purple-600/40'
        } hover:shadow-purple-500/60 active:scale-90 transition-all duration-200 cursor-pointer flex items-center justify-center`}
        title="Create New Character Studio"
      >
        <div class="w-full h-full rounded-full bg-[#0a0d18] flex items-center justify-center group-hover:bg-gradient-to-tr group-hover:from-purple-600 group-hover:to-cyan-500 transition-colors">
          <Plus class="w-6 h-6 text-white group-hover:rotate-90 transition-transform duration-300" />
        </div>
      </a>
      <span class={`text-[9px] font-bold mt-1 uppercase tracking-wider ${isCreate ? 'text-purple-300' : 'text-slate-300'}`}>Create</span>
    </div>

    <!-- 4. Library / Chats -->
    <a 
      href="/library" 
      id="nav-btn-chats"
      class={`nav-item group relative flex flex-col items-center justify-center py-1 px-2.5 active:scale-95 transition-all cursor-pointer ${
        isLibrary ? 'text-cyan-400' : 'text-slate-400 hover:text-slate-200'
      }`}
      title="Conversation Library"
      data-route="library"
    >
      <div class="relative">
        <MessageSquare class="w-5 h-5 transition-transform duration-200 group-hover:scale-110 group-hover:text-cyan-400" />
      </div>
      <span class="text-[10px] font-medium tracking-tight mt-1">Library</span>
      <span class={`nav-indicator w-1 h-1 rounded-full bg-cyan-400 shadow-sm shadow-cyan-400 mt-0.5 ${isLibrary ? '' : 'hidden'}`}></span>
    </a>

    <!-- 5. Persona -->
    <a 
      href="/profile" 
      id="nav-btn-persona"
      class={`nav-item group relative flex flex-col items-center justify-center py-1 px-2.5 active:scale-95 transition-all cursor-pointer ${
        isProfile ? 'text-purple-300' : 'text-slate-400 hover:text-slate-200'
      }`}
      title="User Persona & Identity"
      data-route="profile"
    >
      <User class="w-5 h-5 transition-transform duration-200 group-hover:scale-110 group-hover:text-purple-300" />
      <span class="text-[10px] font-medium tracking-tight mt-1">Persona</span>
      <span class={`nav-indicator w-1 h-1 rounded-full bg-purple-400 shadow-sm shadow-purple-400 mt-0.5 ${isProfile ? '' : 'hidden'}`}></span>
    </a>

  </div>
</nav>

<script>
  function setupBottomNav() {
    const pathname = window.location.pathname.replace(/\/$/, '') || '/';
    const searchParams = new URLSearchParams(window.location.search);
    const cat = searchParams.get('cat');

    const discoverBtn = document.getElementById('nav-btn-discover');
    const trendingBtn = document.getElementById('nav-btn-trending');
    const chatsBtn = document.getElementById('nav-btn-chats');
    const personaBtn = document.getElementById('nav-btn-persona');

    function setActive(el: HTMLElement | null, colorClass: string = 'text-purple-400') {
      document.querySelectorAll('.nav-item').forEach(item => {
        item.classList.remove('text-purple-400', 'text-amber-400', 'text-cyan-400', 'text-purple-300');
        item.classList.add('text-slate-400');
        const ind = item.querySelector('.nav-indicator');
        if (ind) ind.classList.add('hidden');
      });

      if (el) {
        el.classList.remove('text-slate-400');
        el.classList.add(colorClass);
        const ind = el.querySelector('.nav-indicator');
        if (ind) ind.classList.remove('hidden');
      }
    }

    // Set correct active state on mount
    if (pathname === '/' || pathname === '') {
      if (cat === 'trending') {
        setActive(trendingBtn, 'text-amber-400');
      } else {
        setActive(discoverBtn, 'text-purple-400');
      }
    } else if (pathname.startsWith('/library')) {
      setActive(chatsBtn, 'text-cyan-400');
    } else if (pathname.startsWith('/profile')) {
      setActive(personaBtn, 'text-purple-300');
    }

    // Discover click handler:
    // If already on Home (/), smooth scroll to top and reset to 'all'
    discoverBtn?.addEventListener('click', (e) => {
      const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
      if (currentPath === '/') {
        e.preventDefault();
        setActive(discoverBtn, 'text-purple-400');
        window.scrollTo({ top: 0, behavior: 'smooth' });
        const allPill = document.querySelector<HTMLButtonElement>('[data-cat-btn="all"]');
        if (allPill) allPill.click();
      }
    });

    // Trending click handler:
    // If already on Home (/), activate trending pill and scroll into view
    trendingBtn?.addEventListener('click', (e) => {
      const currentPath = window.location.pathname.replace(/\/$/, '') || '/';
      if (currentPath === '/') {
        e.preventDefault();
        setActive(trendingBtn, 'text-amber-400');
        const trendingPill = document.querySelector<HTMLButtonElement>('[data-cat-btn="trending"]');
        if (trendingPill) {
          trendingPill.click();
          const grid = document.querySelector('#characters-grid');
          if (grid) grid.scrollIntoView({ behavior: 'smooth' });
        }
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupBottomNav);
  } else {
    setupBottomNav();
  }
</script>