---
import type { Character } from '../data/characters';
import { Flame, Star, MessageSquare, Sparkles } from '@lucide/astro';

interface Props {
  character: Character;
}

const { character } = Astro.props;
---

<div 
  class="character-card group relative flex flex-col rounded-2xl sm:rounded-3xl overflow-hidden bg-[#0c0e17] border border-white/[0.08] hover:border-purple-500/40 hover:shadow-2xl hover:shadow-purple-950/40 transition-all duration-300 transform hover:-translate-y-1 select-none cursor-pointer"
  data-character-id={character.id}
  data-category={character.category}
  data-name={character.name.toLowerCase()}
  data-tags={character.tags.join(' ').toLowerCase()}
  data-rating={character.rating}
  data-chats={character.chatsCount}
  data-has-lorebook={character.lorebook && character.lorebook.length > 0 ? "true" : "false"}
>
  <!-- Image Poster Container -->
  <div class="relative w-full aspect-[3/4] sm:aspect-[4/5] overflow-hidden bg-[#090b12]">
    <img 
      src={character.avatarUrl} 
      alt={character.name}
      loading="lazy"
      class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out"
    />

    <!-- Vignette / Contrast Gradients -->
    <div class="absolute inset-0 bg-gradient-to-t from-[#07080d] via-[#07080d]/60 to-transparent opacity-95 group-hover:opacity-90 transition-opacity"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-[#07080d]/70 via-transparent to-transparent"></div>

    <!-- Clean Top Corner: Only rating or subtle tag -->
    <div class="absolute top-2.5 sm:top-3 right-2.5 sm:right-3 flex items-center gap-1 z-10">
      <span class="px-2 py-0.5 rounded-full bg-black/60 backdrop-blur-md border border-white/10 text-[10px] font-semibold text-amber-300 shadow-sm flex items-center gap-1">
        <span>★</span>
        <span>{character.rating || '5.0'}</span>
      </span>
    </div>

    <!-- Quick Floating Chat Button (Appears on Hover / Direct Tap) -->
    <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-20 pointer-events-none sm:pointer-events-auto">
      <button 
        type="button"
        data-character-id={character.id}
        class="open-chat-btn inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-purple-600/90 hover:bg-purple-500 active:scale-95 text-white font-semibold text-xs backdrop-blur-md shadow-lg shadow-purple-900/50 transform translate-y-2 group-hover:translate-y-0 transition duration-300 cursor-pointer pointer-events-auto"
      >
        <MessageSquare class="w-3.5 h-3.5" />
        <span>View Profile & Story</span>
      </button>
    </div>

    <!-- Bottom Content Overlay Inside Poster -->
    <div class="absolute bottom-0 left-0 right-0 p-3 sm:p-4 z-10 flex flex-col justify-end">
      
      <!-- Tags (Desktop view) -->
      <div class="hidden sm:flex flex-wrap items-center gap-1 mb-2">
        {character.tags.slice(0, 2).map((tag) => (
          <span class="text-[10px] font-medium px-2 py-0.5 rounded-md bg-white/[0.08] text-slate-300 backdrop-blur-sm border border-white/[0.06]">
            {tag}
          </span>
        ))}
      </div>

      <!-- Character Name -->
      <h3 class="text-sm sm:text-base font-bold text-white tracking-tight group-hover:text-purple-300 transition-colors line-clamp-1">
        {character.name}
      </h3>

      <!-- Subtitle / Persona Role -->
      <p class="text-[11px] sm:text-xs text-purple-400/90 font-medium line-clamp-1 mt-0.5">
        {character.title}
      </p>

      <!-- Short Snippet (Desktop only) -->
      <p class="hidden sm:block text-[11px] text-slate-400 line-clamp-2 mt-1.5 leading-relaxed">
        {character.description}
      </p>

      <!-- Stats Bar (Mobile & Desktop) -->
      <div class="flex items-center justify-between pt-2.5 mt-2 border-t border-white/[0.08] text-[11px] text-slate-400">
        <div class="flex items-center gap-1 font-mono">
          <Flame class="w-3.5 h-3.5 text-amber-400" />
          <span>{character.chatsCount}</span>
        </div>

        <div class="flex items-center gap-1 font-mono text-purple-300">
          <Star class="w-3 h-3 text-amber-400 fill-amber-400" />
          <span>{character.rating}</span>
        </div>
      </div>

    </div>
  </div>
</div>
