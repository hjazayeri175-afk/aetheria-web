          <path d="M42,26 Q64,22 86,26" stroke="url(#hatBandGrad)" stroke-width="3" fill="none"/>
          <rect x="62" y="21" width="8" height="6" rx="1.5" fill="#facc15" stroke="#78350f" stroke-width="0.8"/>
        </g>
        <g class="animate-cat-tail origin-left" style="transform-origin: 34px 106px; filter: drop-shadow(0 3px 6px rgba(0,0,0,0.5));">
          <path d="M30,102 C20,116 36,128 58,126 C72,125 80,118 78,112 C76,106 66,108 58,114 C44,120 34,112 38,104 Z" fill="url(#witchHatGrad)"/>
          <circle cx="78" cy="112" r="2.5" fill="#ec4899"/>
        </g>
        <path d="M110,48 C122,66 120,90 106,108" fill="none" stroke="url(#hatBandGrad)" stroke-width="2.5" stroke-linecap="round" stroke-dasharray="8 6" style="filter: drop-shadow(0 0 6px #06b6d4);"/>
