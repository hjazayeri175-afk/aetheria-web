---
interface Props {
  src?: string;
  initial?: string;
  decoration?: string;
  glowColor?: string;
  assetUrl?: string;
  size?: number; // Size in px (e.g. 100, 56, 44)
  class?: string;
  id?: string;
}

const {
  src = '',
  initial = 'H',
  decoration = 'none',
  glowColor = '#06b6d4',
  assetUrl = '',
  size = 56,
  class: className = '',
  id = ''
} = Astro.props;

// Official Discord Animated WebP Assets Map
const DECORATION_ASSETS: Record<string, string> = {
  'starlight-tiara': '/decorations/starlight_tiara.webp',
  'lunar-wolf': '/decorations/wolf_morph.webp',
  'kitsune-flame': '/decorations/kitsune.webp',
  'seraphim-wings': '/decorations/angel.webp',
  'sakura-garland': '/decorations/sakura.webp',
  'hex-hat': '/decorations/witch_hat_midnight.webp',
  'cyber-oni': '/decorations/oni_mask.webp',
  'royal-dragon': '/decorations/dragons_smile.webp',
  'cat-ears': '/decorations/cat_ears.webp',
  'abyssal-blade': '/decorations/blade_storm.webp',
  'prism-crown': '/decorations/malefic_crown.webp',
  'cosmic-fire': '/decorations/fire.webp',
  'stardust-orbit': '/decorations/stardust.webp',
  // Backward compatibility aliases
  'glow': '/decorations/starlight_tiara.webp',
  'plasma-vortex': '/decorations/fire.webp',
  'dual-gradient': '/decorations/starlight_tiara.webp',
  'dynamic-sparkle': '/decorations/starlight_tiara.webp',
  'royal-crown': '/decorations/starlight_tiara.webp',
  'sakura-drift': '/decorations/sakura.webp',
  'solar-flare': '/decorations/kitsune.webp',
  'emerald-pulse': '/decorations/oni_mask.webp',
  'void-eclipse': '/decorations/blade_storm.webp',
  'cyber-spin': '/decorations/oni_mask.webp',
};

// Normalizing legacy decoration IDs
let normalizedDeco = decoration;
if (!normalizedDeco) normalizedDeco = 'none';

// Resolve image URL for decoration
let resolvedAssetUrl = assetUrl;
if (!resolvedAssetUrl && normalizedDeco !== 'none') {
  resolvedAssetUrl = DECORATION_ASSETS[normalizedDeco] || '';
}

// In Discord, the decoration overlay is 122% of avatar diameter centered exactly over the circle
const overlaySize = Math.round(size * 1.22);
const overlayOffset = Math.round((size - overlaySize) / 2);
---

<div 
  class={`relative inline-flex items-center justify-center shrink-0 select-none overflow-visible ${className}`}
  style={`width: ${size}px; height: ${size}px;`}
  id={id || undefined}
>
  <!-- 1. Clipped Circular Avatar Base -->
  <div class="w-full h-full rounded-full overflow-hidden relative z-10 flex items-center justify-center bg-gradient-to-tr from-purple-600 to-indigo-600 shadow-inner">
    {src ? (
      <img src={src} alt="Avatar" class="w-full h-full rounded-full object-cover" />
    ) : (
      <span class="text-white font-bold select-none" style={`font-size: ${Math.round(size * 0.42)}px;`}>
        {initial.charAt(0).toUpperCase()}
      </span>
    )}
  </div>

  <!-- 2. Discord-Grade Official Animated Overlay (122% scale centered over circle) -->
  {normalizedDeco !== 'none' && resolvedAssetUrl && (
    <div 
      class="absolute pointer-events-none z-20 flex items-center justify-center overflow-visible"
      style={`width: ${overlaySize}px; height: ${overlaySize}px; top: ${overlayOffset}px; left: ${overlayOffset}px;`}
    >
      <img 
        src={resolvedAssetUrl} 
        alt={normalizedDeco} 
        class="w-full h-full object-contain pointer-events-none select-none" 
        draggable="false" 
        loading="eager"
      />
    </div>
  )}
</div>
