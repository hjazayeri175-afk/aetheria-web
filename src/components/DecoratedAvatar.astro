---
export interface Props {
  src?: string;
  initial?: string;
  presetId?: string;
  decoration?: string;
  size?: number;
  class?: string;
  id?: string;
}

const {
  src = '',
  initial = 'H',
  presetId,
  decoration,
  size = 64,
  class: className = '',
  id = ''
} = Astro.props;

const activePreset = presetId || decoration || 'none';
const overlaySize = Math.round(size * 1.42);
const overlayOffset = Math.round((size - overlaySize) / 2);

const PRESET_APNG_MAP: Record<string, string> = {
  starlight_tiara: '/decorations/stardust.png',
  lunar_wolf: '/decorations/wolf_morph.png',
  hexs_hat: '/decorations/witch_hat_midnight.png',
  sakura_spirit: '/decorations/sakura.png',
  kitsune_foxfire: '/decorations/kitsune.png',
  imperial_dragon: '/decorations/dragons_smile.png',
  cyberpunk_glitch: '/decorations/glitch.png',
  cosmic_singularity: '/decorations/black_hole.png',
  storm_lightning: '/decorations/lightning.png',
  solar_supernova: '/decorations/fire.png',
  aurora_crown: '/decorations/crown.png',
  // Aliases for compatibility
  'starlight-tiara': '/decorations/stardust.png',
  'lunar-wolf': '/decorations/wolf_morph.png',
  'hex-hat': '/decorations/witch_hat_midnight.png',
  'sakura-garland': '/decorations/sakura.png',
  'kitsune-flame': '/decorations/kitsune.png',
  'solar-flare': '/decorations/fire.png',
  'cyber-glitch': '/decorations/glitch.png',
  'void-eclipse': '/decorations/black_hole.png',
  'royal-crown': '/decorations/crown.png',
  'cosmic-nebula': '/decorations/black_hole.png'
};

const apngUrl = PRESET_APNG_MAP[activePreset] || '';
---

<div
  id={id}
  class={`relative inline-flex items-center justify-center select-none overflow-visible shrink-0 ${className}`}
  style={`width: ${size}px; height: ${size}px; overflow: visible;`}
>
  <!-- 1. Circular Avatar Base: User's actual portrait or initial is ALWAYS rendered here -->
  <div class="w-full h-full rounded-full overflow-hidden relative z-10 flex items-center justify-center bg-gradient-to-tr from-purple-600 to-indigo-600 shadow-inner deco-tile-base border border-white/10">
    {src ? (
      <img src={src} alt="Avatar" class="w-full h-full rounded-full object-cover" />
    ) : (
      <span class="text-white font-bold select-none text-xl" style={`font-size: ${Math.round(size * 0.42)}px;`}>
        {initial.charAt(0).toUpperCase()}
      </span>
    )}
  </div>

  <!-- 2. Discord APNG Overlay (142% scale centered) -->
  {activePreset !== 'none' && apngUrl && (
    <img
      src={apngUrl}
      alt={activePreset}
      class="absolute pointer-events-none z-20 object-contain overflow-visible"
      style={`width: ${overlaySize}px; height: ${overlaySize}px; top: ${overlayOffset}px; left: ${overlayOffset}px; max-width: none; overflow: visible;`}
      loading="lazy"
    />
  )}
</div>
