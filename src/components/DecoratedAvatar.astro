---
interface Props {
  src?: string;
  initial?: string;
  decoration?: string;
  glowColor?: string;
  assetUrl?: string;
  size?: number; // Size in px (e.g. 100, 56, 44)
  class?: string;
  id?: string;
}

const {
  src = '',
  initial = 'H',
  decoration = 'none',
  glowColor = '#06b6d4',
  assetUrl = '',
  size = 56,
  class: className = '',
  id = ''
} = Astro.props;

// Normalizing legacy decoration IDs
let normalizedDeco = decoration;
if (decoration === 'glow' || decoration === 'plasma-vortex') normalizedDeco = 'cyber-spin';
else if (decoration === 'dual-gradient' || decoration === 'dynamic-sparkle' || decoration === 'royal-crown') normalizedDeco = 'starlight-tiara';
else if (decoration === 'sakura-drift') normalizedDeco = 'sakura-garland';
else if (decoration === 'solar-flare') normalizedDeco = 'kitsune-flame';
else if (decoration === 'emerald-pulse') normalizedDeco = 'cyber-oni';
else if (decoration === 'void-eclipse') normalizedDeco = 'abyssal-blade';
else if (!normalizedDeco) normalizedDeco = 'none';

const overlaySize = Math.round(size * 1.32);
---

<div 
  class={`relative inline-flex items-center justify-center shrink-0 select-none overflow-visible ${className}`}
  style={`width: ${size}px; height: ${size}px; --avatar-glow-color: ${glowColor}; --avatar-border-color: ${glowColor};`}
  id={id || undefined}
>
  <!-- 1. Clipped Circular Avatar Base -->
  <div class="w-full h-full rounded-full overflow-hidden relative z-10 flex items-center justify-center bg-gradient-to-tr from-purple-600 to-indigo-600 shadow-inner">
    {src ? (
      <img src={src} alt="Avatar" class="w-full h-full rounded-full object-cover" />
    ) : (
      <span class="text-white font-bold select-none" style={`font-size: ${Math.round(size * 0.42)}px;`}>
        {initial.charAt(0).toUpperCase()}
      </span>
    )}
  </div>

  <!-- 2. Discord-Style Oversized Decoration Overlay (132% scale, bleeds over & outside circle) -->
  <div 
    class="absolute pointer-events-none z-20 flex items-center justify-center overflow-visible"
    style={`width: ${overlaySize}px; height: ${overlaySize}px;`}
  >
    {assetUrl ? (
      <img src={assetUrl} alt="Avatar Decoration" class="w-full h-full object-contain pointer-events-none" />
    ) : normalizedDeco === 'lunar-wolf' ? (
      <svg viewBox="0 0 132 132" class="w-full h-full overflow-visible pointer-events-none">
        <defs>
          <linearGradient id="wolfFurGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#bae6fd"/>
            <stop offset="60%" stop-color="#60a5fa"/>
            <stop offset="100%" stop-color="#3b82f6"/>
          </linearGradient>
          <linearGradient id="wolfInnerEar" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#fbcfe8"/>
            <stop offset="100%" stop-color="#f472b6"/>
          </linearGradient>
          <linearGradient id="moonGrad" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#fef08a"/>
            <stop offset="100%" stop-color="#f59e0b"/>
          </linearGradient>
        </defs>
        <g class="animate-wolf-ear-left origin-bottom-right" style="transform-origin: 32px 36px;">
          <path d="M22,38 C16,24 20,8 28,4 C34,16 38,26 40,36 Z" fill="url(#wolfFurGrad)" filter="drop-shadow(0 2px 4px rgba(0,0,0,0.4))"/>
          <path d="M25,32 C22,22 24,14 28,10 C32,18 34,24 35,32 Z" fill="url(#wolfInnerEar)"/>
          <path d="M28,28 Q32,24 30,34 Q34,28 32,36" stroke="#ffffff" stroke-width="1.2" fill="none" stroke-linecap="round"/>
        </g>
        <g class="animate-wolf-ear-right origin-bottom-left" style="transform-origin: 100px 36px;">
          <path d="M110,38 C116,24 112,8 104,4 C98,16 94,26 92,36 Z" fill="url(#wolfFurGrad)" filter="drop-shadow(0 2px 4px rgba(0,0,0,0.4))"/>
          <path d="M107,32 C110,22 108,14 104,10 C100,18 98,24 97,32 Z" fill="url(#wolfInnerEar)"/>
          <path d="M104,28 Q100,24 102,34 Q98,28 100,36" stroke="#ffffff" stroke-width="1.2" fill="none" stroke-linecap="round"/>
        </g>
        <g class="animate-moon-float" style="filter: drop-shadow(0 0 6px #fde047);">
          <path d="M66,2 C69,6 69,12 65,15 C61,18 55,16 53,13 C57,14 62,13 63,9 C64,6 63,3 66,2 Z" fill="url(#moonGrad)"/>
          <circle cx="68" cy="8" r="1.5" fill="#ffffff" filter="drop-shadow(0 0 3px #ffffff)"/>
        </g>
        <g class="animate-wolf-tail origin-top-left" style="transform-origin: 30px 105px; filter: drop-shadow(0 4px 6px rgba(0,0,0,0.5));">
          <path d="M24,105 C18,118 36,128 54,128 C74,128 98,122 112,112 C104,116 88,120 70,120 C50,120 34,114 30,105 Z" fill="url(#wolfFurGrad)"/>
          <path d="M96,118 C104,114 112,112 116,108 C112,114 104,120 96,118 Z" fill="#ffffff" opacity="0.9"/>
          <path d="M60,124 Q70,120 80,122" stroke="#ffffff" stroke-width="1" fill="none" opacity="0.7"/>
        </g>
        <circle cx="20" cy="65" r="1.5" fill="#93c5fd" class="animate-pulse" filter="drop-shadow(0 0 3px #60a5fa)"/>
        <circle cx="114" cy="60" r="1.8" fill="#fbcfe8" class="animate-pulse" filter="drop-shadow(0 0 3px #f472b6)"/>
      </svg>
    ) : normalizedDeco === 'starlight-tiara' ? (
      <svg viewBox="0 0 132 132" class="w-full h-full overflow-visible pointer-events-none">
        <defs>
          <linearGradient id="tiaraGold" x1="0%" y1="0%" x2="100%" y2="100%">
            <stop offset="0%" stop-color="#fffbeb"/>
            <stop offset="30%" stop-color="#fde047"/>
            <stop offset="70%" stop-color="#eab308"/>
            <stop offset="100%" stop-color="#854d0e"/>
          </linearGradient>
          <linearGradient id="tiaraGem" x1="0%" y1="0%" x2="100%" y2="100%">
