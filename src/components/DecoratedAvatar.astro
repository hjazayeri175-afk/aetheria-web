        </defs>
        <ellipse cx="66" cy="20" rx="42" ry="12" fill="none" stroke="url(#tiaraGold)" stroke-width="2" opacity="0.85" filter="drop-shadow(0 0 8px #eab308)"/>
        <g class="animate-tiara-shimmer" style="filter: drop-shadow(0 2px 8px rgba(234,179,8,0.7));">
          <path d="M38,24 Q66,12 94,24 Q66,16 38,24 Z" fill="url(#tiaraGold)"/>
          <path d="M66,6 L69,16 L63,16 Z" fill="url(#tiaraGold)"/>
          <path d="M52,11 L55,18 L49,18 Z" fill="url(#tiaraGold)"/>
          <path d="M80,11 L83,18 L77,18 Z" fill="url(#tiaraGold)"/>
          <polygon points="66,7 69,11 66,15 63,11" fill="url(#tiaraGem)" filter="drop-shadow(0 0 4px #38bdf8)"/>
          <circle cx="52" cy="13" r="1.5" fill="#fbcfe8"/>
          <circle cx="80" cy="13" r="1.5" fill="#fbcfe8"/>
        </g>
        <g class="animate-starburst-spin origin-center" style="transform-origin: 66px 6px;">
          <path d="M66,0 Q66,6 72,6 Q66,6 66,12 Q66,6 60,6 Q66,6 66,0 Z" fill="#ffffff" filter="drop-shadow(0 0 6px #ffffff)"/>
        </g>
        <circle cx="28" cy="95" r="1.5" fill="#fde047" class="animate-ping"/>
        <circle cx="106" cy="85" r="2" fill="#ffffff" filter="drop-shadow(0 0 4px #ffffff)"/>
        <path d="M102,40 Q104,44 108,44 Q104,44 104,48 Q104,44 100,44 Q104,44 102,40 Z" fill="#fde047" filter="drop-shadow(0 0 4px #facc15)"/>
      </svg>
    ) : normalizedDeco === 'hex-hat' ? (
      <svg viewBox="0 0 132 132" class="w-full h-full overflow-visible pointer-events-none">
