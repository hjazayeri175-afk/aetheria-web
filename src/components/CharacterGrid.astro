---
import { characters } from '../data/characters';
import CharacterCard from './CharacterCard.astro';
import { 
  Sparkles, 
  SlidersHorizontal, 
  SearchX, 
  RotateCcw, 
  ArrowUpDown, 
  Tag, 
  BookOpen, 
  Flame, 
  Star 
} from '@lucide/astro';

const QUICK_TAGS = [
  { id: 'all', label: 'All Tags' },
  { id: 'lorebook', label: '📚 Lorebook' },
  { id: 'cyberpunk', label: '#Cyberpunk' },
  { id: 'fantasy', label: '#Fantasy' },
  { id: 'anime', label: '#Anime' },
  { id: 'mage', label: '#Mage' },
  { id: 'android', label: '#Android' },
  { id: 'noir', label: '#Noir' },
  { id: 'custom', label: '✨ Custom' },
];
---

<section class="w-full mt-4 sm:mt-6 space-y-4">
  <!-- Section Sub-Header & Controls Bar -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-3 border-b border-white/[0.06]">
    <div class="flex items-center gap-2.5">
      <div class="p-1.5 rounded-lg bg-purple-500/10 border border-purple-500/20 text-purple-400">
        <Sparkles class="w-4 h-4" />
      </div>
      <div>
        <h2 class="text-base sm:text-lg font-bold text-white tracking-tight">Explore Characters & Lore</h2>
        <p class="text-xs text-slate-400 hidden sm:block">Curated personalities, roleplay companions & interactive lore</p>
      </div>
    </div>

    <!-- Active Count & Sort Selector -->
    <div class="flex items-center justify-between sm:justify-end gap-2.5">
      <span id="character-counter" class="text-xs text-slate-400 font-mono bg-white/[0.04] px-2.5 py-1 rounded-full border border-white/[0.06]">
        {characters.length} Available
      </span>

      <!-- Sorting Selector -->
      <div class="flex items-center gap-1.5 bg-[#0a0d1a] border border-white/10 rounded-xl px-2.5 py-1">
        <ArrowUpDown class="w-3.5 h-3.5 text-purple-400 shrink-0" />
        <select 
          id="sort-selector" 
          class="bg-transparent text-xs text-slate-300 font-medium outline-none cursor-pointer pr-1"
        >
          <option value="popular" class="bg-[#0a0d1a] text-slate-200">Sort: Popular 🔥</option>
          <option value="rating" class="bg-[#0a0d1a] text-slate-200">Sort: Highest Rated ⭐</option>
          <option value="custom-first" class="bg-[#0a0d1a] text-slate-200">Sort: Custom First ✨</option>
          <option value="lorebook" class="bg-[#0a0d1a] text-slate-200">Sort: Lorebook Ready 📚</option>
          <option value="az" class="bg-[#0a0d1a] text-slate-200">Sort: Name (A-Z)</option>
        </select>
      </div>
    </div>
  </div>

  <!-- Tag Pills Scroll Bar -->
  <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar py-1">
    <span class="text-[11px] font-semibold text-slate-500 uppercase tracking-wider shrink-0 pr-1 flex items-center gap-1">
      <Tag class="w-3 h-3 text-slate-500" />
      <span>Tags:</span>
    </span>
    {QUICK_TAGS.map((tag, idx) => (
      <button
        type="button"
        data-quick-tag={tag.id}
        class={`quick-tag-btn shrink-0 px-2.5 py-1 rounded-lg text-[11px] font-medium transition cursor-pointer select-none ${
          idx === 0
            ? 'active-tag bg-purple-600/20 text-purple-300 border border-purple-500/40 shadow-sm'
            : 'bg-white/[0.03] text-slate-400 hover:text-white hover:bg-white/[0.06] border border-white/[0.06]'
        }`}
      >
        {tag.label}
      </button>
    ))}
  </div>

  <!-- Responsive Character Cards Grid -->
  <!-- Mobile: 2 cols | Tablet: 3 cols | Desktop: 4 cols -->
  <div 
    id="characters-grid"
    class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-5 lg:gap-6 transition-opacity duration-200"
  >
    {characters.map((character) => (
      <CharacterCard character={character} />
    ))}
  </div>

  <!-- Empty State (When no filter match) -->
  <div 
    id="empty-state" 
    class="hidden flex-col items-center justify-center py-16 px-4 text-center rounded-3xl border border-dashed border-white/10 bg-white/[0.01] my-6"
  >
    <div class="p-4 rounded-full bg-purple-500/10 border border-purple-500/20 text-purple-400 mb-4">
      <SearchX class="w-8 h-8" />
    </div>
    <h3 class="text-base font-bold text-white mb-1">No characters found</h3>
    <p class="text-xs text-slate-400 max-w-sm mb-4">
      We couldn't find any persona matching your search, category, or tag filter.
    </p>
    <button 
      id="reset-filter-btn"
      class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white/[0.05] hover:bg-white/[0.1] border border-white/10 text-xs font-semibold text-purple-300 transition cursor-pointer"
    >
      <RotateCcw class="w-3.5 h-3.5" />
      <span>Reset Filters</span>
    </button>
  </div>
</section>

<script>
  let activeCategory = 'all';
  let activeTag = 'all';
  let searchQuery = '';
  let activeSort = 'popular';

  const grid = document.getElementById('characters-grid');
  const emptyState = document.getElementById('empty-state');
  const counter = document.getElementById('character-counter');
  const resetBtn = document.getElementById('reset-filter-btn');
  const sortSelector = document.getElementById('sort-selector') as HTMLSelectElement | null;
  const tagButtons = document.querySelectorAll<HTMLButtonElement>('[data-quick-tag]');

  // Render custom characters from localStorage at top of grid
  function loadCustomCharacters() {
    try {
      const customList = JSON.parse(localStorage.getItem('aetheria_custom_characters') || '[]');
      if (customList.length === 0 || !grid) return;

      customList.forEach((char: any) => {
        if (document.querySelector(`[data-character-id="${char.id}"]`)) return;

        const card = document.createElement('div');
        card.className = 'character-card group relative flex flex-col rounded-2xl sm:rounded-3xl overflow-hidden bg-[#0c0e17] border border-purple-500/40 hover:border-purple-400 hover:shadow-2xl hover:shadow-purple-950/60 transition-all duration-300 transform hover:-translate-y-1 select-none cursor-pointer';
        card.setAttribute('data-character-id', char.id);
        card.setAttribute('data-category', char.category || 'custom');
        card.setAttribute('data-name', (char.name || '').toLowerCase());
        card.setAttribute('data-tags', (((char.tags || []).join(' ')) + ' custom roleplay').toLowerCase());
        card.setAttribute('data-rating', '5.0');
        card.setAttribute('data-chats', '1.2k');
        card.setAttribute('data-has-lorebook', (char.lorebook && char.lorebook.length > 0) ? 'true' : 'false');

        const tagsMarkup = (char.tags || ['Custom', 'User']).slice(0, 2).map((t: string) => `<span class="text-[10px] font-medium px-2 py-0.5 rounded-md bg-white/[0.08] text-slate-300 backdrop-blur-sm border border-white/[0.06]">${t}</span>`).join('');

        card.innerHTML = `
          <div class="relative w-full aspect-[3/4] sm:aspect-[4/5] overflow-hidden bg-[#090b12]">
            <img 
              src="${char.avatarUrl || '/avatars/asian_woman.webp'}" 
              alt="${char.name}"
              loading="lazy"
              decoding="async"
              class="w-full h-full object-cover object-center group-hover:scale-105 transition-transform duration-700 ease-out"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#07080d] via-[#07080d]/60 to-transparent opacity-95 group-hover:opacity-90 transition-opacity"></div>
            <div class="absolute inset-0 bg-gradient-to-b from-[#07080d]/70 via-transparent to-transparent"></div>

            <div class="absolute top-2.5 sm:top-3 left-2.5 sm:left-3 right-2.5 sm:right-3 flex items-center justify-between z-10">
              <div class="flex items-center gap-1.5 px-2 py-0.5 rounded-full bg-black/60 backdrop-blur-md border border-white/10 text-[10px] font-medium text-slate-200">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                <span>Online</span>
              </div>
              <div class="flex items-center gap-1">
                ${(char.lorebook && char.lorebook.length > 0) ? '<span class="px-2 py-0.5 rounded-full bg-cyan-500/20 backdrop-blur-md border border-cyan-500/30 text-[10px] font-semibold text-cyan-300 shadow-sm">📚 Lore</span>' : ''}
                <span class="px-2 py-0.5 rounded-full bg-gradient-to-r from-purple-600 to-indigo-600 border border-purple-400/40 text-[10px] font-bold text-white shadow-sm">
                  Custom
                </span>
              </div>
            </div>

            <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 z-20 pointer-events-none sm:pointer-events-auto">
              <a 
                href="/chat/custom?id=${encodeURIComponent(char.id)}"
                class="open-chat-btn inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-purple-600/90 hover:bg-purple-500 active:scale-95 text-white font-semibold text-xs backdrop-blur-md shadow-lg shadow-purple-900/50 transform translate-y-2 group-hover:translate-y-0 transition duration-300 cursor-pointer pointer-events-auto"
              >
                <span>Chat Now</span>
              </a>
            </div>

            <div class="absolute bottom-0 left-0 right-0 p-3 sm:p-4 z-10 flex flex-col justify-end">
              <div class="hidden sm:flex flex-wrap items-center gap-1 mb-2">
                ${tagsMarkup}
              </div>
              <h3 class="text-sm sm:text-base font-bold text-white tracking-tight group-hover:text-purple-300 transition-colors line-clamp-1">
                ${char.name}
              </h3>
              <p class="text-[11px] sm:text-xs text-purple-400/90 font-medium line-clamp-1 mt-0.5">
                ${char.title || 'Custom Character'}
              </p>
              <p class="hidden sm:block text-[11px] text-slate-400 line-clamp-2 mt-1.5 leading-relaxed">
                ${char.description || ''}
              </p>
              <div class="flex items-center justify-between pt-2.5 mt-2 border-t border-white/[0.08] text-[11px] text-slate-400">
                <span class="text-purple-300 font-medium text-[10px]">Custom Hero</span>
                <span class="text-amber-400 font-mono">★ 5.0</span>
              </div>
            </div>
          </div>
        `;

        card.addEventListener('click', (e) => {
          if (!(e.target as HTMLElement).closest('button') && !(e.target as HTMLElement).closest('a')) {
            window.location.href = `/chat/custom?id=${encodeURIComponent(char.id)}`;
          }
        });

        grid.prepend(card);
      });
    } catch {}
  }

  loadCustomCharacters();

  function sortCards() {
    if (!grid) return;
    const cards = Array.from(document.querySelectorAll<HTMLElement>('.character-card'));

    cards.sort((a, b) => {
      if (activeSort === 'rating') {
        const rA = parseFloat(a.getAttribute('data-rating') || '0');
        const rB = parseFloat(b.getAttribute('data-rating') || '0');
        return rB - rA;
      }
      if (activeSort === 'custom-first') {
        const isCA = a.getAttribute('data-category') === 'custom' ? 1 : 0;
        const isCB = b.getAttribute('data-category') === 'custom' ? 1 : 0;
        return isCB - isCA;
      }
      if (activeSort === 'lorebook') {
        const lA = a.getAttribute('data-has-lorebook') === 'true' ? 1 : 0;
        const lB = b.getAttribute('data-has-lorebook') === 'true' ? 1 : 0;
        return lB - lA;
      }
      if (activeSort === 'az') {
        const nA = a.getAttribute('data-name') || '';
        const nB = b.getAttribute('data-name') || '';
        return nA.localeCompare(nB);
      }
      // default: popular (chats count)
      const parseChats = (val: string) => {
        val = val.toLowerCase();
        if (val.includes('k')) return parseFloat(val) * 1000;
        if (val.includes('m')) return parseFloat(val) * 1000000;
        return parseFloat(val) || 0;
      };
      return parseChats(b.getAttribute('data-chats') || '0') - parseChats(a.getAttribute('data-chats') || '0');
    });

    cards.forEach(card => grid.appendChild(card));
  }

  function filterCards() {
    const cards = document.querySelectorAll<HTMLElement>('.character-card');
    let visibleCount = 0;

    cards.forEach((card) => {
      const cat = card.getAttribute('data-category') || '';
      const name = card.getAttribute('data-name') || '';
      const tags = card.getAttribute('data-tags') || '';
      const hasLore = card.getAttribute('data-has-lorebook') === 'true';

      const matchCategory = (activeCategory === 'all' || cat === activeCategory);
      
      let matchTag = true;
      if (activeTag === 'lorebook') matchTag = hasLore;
      else if (activeTag === 'custom') matchTag = (cat === 'custom' || tags.includes('custom'));
      else if (activeTag !== 'all') matchTag = (tags.includes(activeTag) || name.includes(activeTag) || cat.includes(activeTag));

      const matchSearch = (!searchQuery || name.includes(searchQuery) || tags.includes(searchQuery) || cat.includes(searchQuery));

      if (matchCategory && matchTag && matchSearch) {
        card.style.display = 'flex';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (counter) {
      counter.textContent = `${visibleCount} Available`;
    }

    if (visibleCount === 0) {
      grid?.classList.add('hidden');
      emptyState?.classList.remove('hidden');
      emptyState?.classList.add('flex');
    } else {
      grid?.classList.remove('hidden');
      emptyState?.classList.add('hidden');
      emptyState?.classList.remove('flex');
    }
  }

  // Quick Tags selection
  tagButtons.forEach(btn => {
    btn.addEventListener('click', () => {
      tagButtons.forEach(b => {
        b.classList.remove('active-tag', 'bg-purple-600/20', 'text-purple-300', 'border-purple-500/40', 'shadow-sm');
        b.classList.add('bg-white/[0.03]', 'text-slate-400', 'border-white/[0.06]');
      });

      btn.classList.add('active-tag', 'bg-purple-600/20', 'text-purple-300', 'border-purple-500/40', 'shadow-sm');
      btn.classList.remove('bg-white/[0.03]', 'text-slate-400', 'border-white/[0.06]');

      activeTag = btn.getAttribute('data-quick-tag') || 'all';
      filterCards();
    });
  });

  // Sort selector change
  sortSelector?.addEventListener('change', () => {
    activeSort = sortSelector.value;
    sortCards();
  });

  // Listen for category change from CategoryPills
  window.addEventListener('aetheria:category-change', (e: Event) => {
    const detail = (e as CustomEvent).detail;
    activeCategory = detail.category || 'all';
    filterCards();
  });

  // Listen for search input from Header
  const desktopSearch = document.getElementById('desktop-search') as HTMLInputElement | null;
  desktopSearch?.addEventListener('input', (e) => {
    searchQuery = (e.target as HTMLInputElement).value.trim().toLowerCase();
    filterCards();
  });

  resetBtn?.addEventListener('click', () => {
    activeCategory = 'all';
    activeTag = 'all';
    searchQuery = '';
    activeSort = 'popular';
    if (sortSelector) sortSelector.value = 'popular';
    if (desktopSearch) desktopSearch.value = '';
    
    // Reset tag pill
    const firstTag = document.querySelector<HTMLButtonElement>('[data-quick-tag="all"]');
    firstTag?.click();

    // Click 'all' category pill
    const allPill = document.querySelector<HTMLButtonElement>('[data-cat-btn="all"]');
    allPill?.click();

    sortCards();
    filterCards();
  });
</script>
